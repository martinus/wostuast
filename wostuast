.sidebar {
  width: var(--sidebar-w, 340px); flex-shrink: 0; display: flex;
  flex-direction: column; background: var(--panel);
}
/* Paths are long and no width chosen here is right for every repository, so
   both column edges are draggable. The alternative is a config option, which
   PLAN.md prefers to delete. */
.grip {
  flex-shrink: 0; width: var(--grip-w); cursor: col-resize;
  background: var(--edge);
  border: 0; padding: 0; transition: background .15s ease;
}
.grip:hover, .grip.dragging { background: var(--needs); }
body.dragging { cursor: col-resize; user-select: none; }
.sidebar-head {
  padding: 12px 16px 8px; font-family: var(--mono); font-size: 11px;
  color: var(--ink-faint); letter-spacing: .08em; text-transform: uppercase;
}
.rows { flex-grow: 1; overflow-y: auto; padding: 0 8px 8px; }
.row {
  margin-bottom: 6px; padding: 9px 12px 9px 11px; border-radius: 6px;
  cursor: pointer; display: flex; flex-direction: column; gap: 4px;
  border: 1px solid transparent; border-left: 4px solid var(--gone);
  transition: background .2s ease, border-color .2s ease;
}
.row.needs_you { border-left-color: var(--needs); background: var(--needs-soft); }
.row.working { border-left-color: var(--working); background: var(--working-soft); }
.row.done { border-left-color: var(--done); background: var(--done-soft); }
.row:hover { border-color: var(--edge-bright); border-left-width: 4px; }
/* The tint says what the session is doing, so the selection has to say
   something else: a ring and a brighter face.
   The face is a gradient layer rather than an inset shadow. A shadow fills
   inward from each edge by its spread, so `inset 0 0 0 40px` left a stripe of
   untinted row down the middle of anything taller than 80 px — and a row with
   a name, a branch and a reason on it is taller than that. A background layer
   covers whatever height the row turns out to be, and it sits over the state's
   own colour rather than replacing it. */
.row.chosen {
  outline: 1px solid var(--ink-faint); outline-offset: -1px;
  background-image: linear-gradient(var(--tint), var(--tint));
}
.row.chosen .name { color: var(--ink-bright); }
.row .line1 {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 13px; min-width: 0;
}
.row .name {
  color: var(--ink-bright); font-weight: 600; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; flex-grow: 1;
}
/* What Claude Code called the session. It goes under the worktree, not in
   front of it: it is a title for the conversation, not a place. */
.row .called {
  padding-left: 17px; font-size: 12px; color: var(--ink-mute);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.row .word { flex-shrink: 0; }
.row.needs_you .word { color: var(--needs); }
.row.working .word { color: var(--working); }
.row.done .word { color: var(--done); }
.row.ended .word, .row.dead .word { color: var(--ink-faint); }
/* History. A finished session is grey through and through: it kept the colour
   of the state it stopped in, which read as though something were still going
   on there. */
.row.ended, .row.dead { opacity: .72; }
.row.ended .name, .row.dead .name { color: var(--ink-mute); font-weight: 500; }
.row.ended .branch, .row.dead .branch,
.row.ended .said, .row.dead .said { color: var(--ink-faint); }
.row.ended .dirty, .row.dead .dirty,
.row.ended .clean, .row.dead .clean,
.row.ended .called, .row.dead .called { color: var(--gone); }
/* The line above each group of rows. The history one folds and so is a
   button; the other three only name what is under them. */
.histhead, .band {
  display: block; width: 100%; margin: 10px 0 6px; padding: 5px 12px;
  border: none; border-top: 1px solid var(--edge); border-radius: 0;
  background: none; text-align: left;
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  letter-spacing: .06em; text-transform: uppercase;
}
.histhead { cursor: pointer; }
.histhead:hover { color: var(--ink-soft); }
/* The one group that is about you says so in its own colour. */
.band.needs { color: var(--needs); }
/* The first head has nothing above it to be separated from. */
.rows > :first-child.band, .rows > :first-child.histhead { border-top: none; margin-top: 0; }
.row .line2 {
  display: flex; gap: 10px; font-size: 12px; color: var(--ink-soft);
  padding-left: 17px; min-width: 0;
}
.row .line2 .branch { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* The reason gives way; the age never does. "How long has this needed me?" is
   the question the sidebar exists to answer. */
.row .line3 {
  display: flex; gap: 6px; font-size: 12px; color: var(--ink-mute);
  padding-left: 17px; min-width: 0; white-space: nowrap;
}
.row .said { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.row .age { color: var(--ink-faint); flex-shrink: 0; margin-left: auto; }
.dirty { color: var(--needs); }
.clean { color: var(--working); }
.ahead { color: var(--ink-faint); }
.row.needs_you .dot { box-shadow: 0 0 0 3px var(--ring-near); animation: ring 2s ease-in-out infinite; }
@keyframes ring {
  0%, 100% { box-shadow: 0 0 0 3px var(--ring-near); }
  50% { box-shadow: 0 0 0 5px var(--ring-far); }
}

/* One switch for everything that moves. A reader whose system asks for less
   motion gets a page that only changes colour. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }
}
.hints {
  flex-shrink: 0; padding: 12px 16px; border-top: 1px solid var(--edge);
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint); line-height: 1.8;
}
.hints b { color: var(--ink-soft); font-weight: 500; }

/* main */
.main { flex-grow: 1; display: flex; flex-direction: column; min-width: 0; }
/* The Session tab: everything about the one that is open, and the only place
   it is named. There used to be a bar above every tab saying some of this,
   which said again what the chosen row already says and cost 56 pixels of
   every tab to do it. */
.sessionbody { flex-grow: 1; overflow-y: auto; padding: 20px 26px; }
.sessionbody .field { margin-bottom: 22px; max-width: 760px; }
.sessionbody dl {
  display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px;
  margin: 0; font-size: 13px;
}
.sessionbody dt {
  font-family: var(--narrow); font-size: 12px; letter-spacing: .04em;
  color: var(--ink-faint);
}
.sessionbody dd {
  margin: 0; font-family: var(--mono); color: var(--ink);
  overflow-wrap: anywhere;
}
.sessionbody dd.word.needs_you { color: var(--needs); }
.sessionbody dd.word.working { color: var(--working); }
.sessionbody dd.word.done { color: var(--done); }
/* The name, and the box that changes it. */
.sessionbody .rename { width: 100%; max-width: 480px; }
.sessionbody .counts { display: flex; flex-wrap: wrap; gap: 8px 22px; }
.sessionbody .counts span { font-family: var(--mono); font-size: 13px; }
.sessionbody .counts b { color: var(--ink-bright); font-weight: 600; }
/* What this session has done, newest last, the way it happened. */
.sessionlog {
  border: 1px solid var(--edge); border-radius: 6px; max-height: 42vh;
  overflow-y: auto; background: var(--panel);
}
.sessionlog div {
  display: flex; gap: 14px; padding: 5px 12px; font-size: 12.5px;
  border-bottom: 1px solid var(--edge);
}
.sessionlog div:last-child { border-bottom: 0; }
.sessionlog .at {
  font-family: var(--mono); color: var(--ink-faint); flex-shrink: 0;
}
.sessionlog .what {
  font-family: var(--narrow); color: var(--ink-soft); flex-shrink: 0;
  width: 130px;
}
.sessionlog .said {
  color: var(--ink-mute); overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap;
}
/* The page's one button shape. A full-strength `.verb` reaches the terminal —
   jump, send, submit a review — and there are only a few of those. `.quiet` is
   the same button a size down, for what only changes what is on screen: edit a
   comment, throw one away. Those were `.link`, which is text you have to find
   out is clickable. */
.verb {
  flex-shrink: 0; height: 26px; padding: 0 12px; border-radius: 5px;
  border: 1px solid var(--edge-bright); background: var(--raised);
  color: var(--ink-bright); font-family: var(--mono); font-size: 12px;
  cursor: pointer;
}
.verb:hover { border-color: var(--needs); color: var(--needs); }
.verb:active { background: var(--chosen); }
.verb.quiet {
  height: 22px; padding: 0 10px; font-size: 11px;
  background: none; border-color: var(--edge); color: var(--ink-mute);
}
/* Both of these stand under the transcript, and the transcript is the right
   half of a split tab -- so they start where it starts rather than running
   the whole width and under the map beside it. `--side-w` is on the root, set
   by the same drag that sizes the map, and 5 px is the grip between them.
   They are shown on the Transcript tab and nowhere else, so this is never
   measured against a column that is not there.

   By margin and not by moving them into the pane: the question bar holds
   picks that have not been submitted and the send box holds what you are
   typing, and a node that changes parents is a node that is rebuilt. */
.sendbar, .asking { margin-left: calc(var(--side-w, 268px) + var(--grip-w)); }
.sendbar {
  flex-shrink: 0; display: flex; gap: 8px; align-items: flex-end;
  padding: 10px 24px; border-top: 1px solid var(--edge); background: var(--panel);
}
/* `display` here would otherwise beat the browser's own rule for `hidden`,
   and the box would never go away. */
.sendbar[hidden] { display: none; }
.say {
  flex-grow: 1; padding: 6px 10px; border-radius: 5px;
  border: 1px solid var(--edge); background: var(--bg); color: var(--ink);
  font-family: var(--mono); font-size: 13px; line-height: 1.5; min-width: 0;
  /* It grows with what is typed, up to a point, and then it scrolls. A long
     line wraps rather than running off the side, because a prompt you cannot
     see the start of is worse than two lines. */
  resize: none; overflow-y: auto; max-height: 40vh; white-space: pre-wrap;
  word-wrap: break-word;
}
.say:focus { outline: none; border-color: var(--needs); }
.say::placeholder { color: var(--ink-faint); }

.ctx { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
.ctx .bar {
  width: 54px; height: 6px; border-radius: 3px; background: var(--raised);
  border: 1px solid var(--edge); overflow: hidden;
}
.ctx .fill { display: block; height: 100%; background: var(--working); }
/* A caveat beside a number, or when a window resets. It is the smallest
   thing in the panel because it is read once. */
.sessionbody .aside { margin-left: 10px; color: var(--ink-faint); font-size: 11px; }
.limitrow { display: flex; align-items: baseline; }
.limitbox {
  width: 96px; padding: 2px 8px; border-radius: 5px;
  border: 1px solid var(--edge); background: var(--bg); color: var(--ink);
  font-family: var(--mono); font-size: 12px;
}
.limitbox:focus { outline: none; border-color: var(--needs); }
.limitbox:disabled { opacity: .5; cursor: default; }
.ctx.warm .fill { background: var(--needs); }
.ctx.hot .fill { background: var(--hot); }
.tabs {
  height: 40px; flex-shrink: 0; display: flex; align-items: stretch; gap: 4px;
  padding: 0 24px; border-bottom: 1px solid var(--edge);
  font-family: var(--mono); font-size: 13px;
}
.tab {
  display: inline-flex; align-items: center; gap: 6px; padding: 0 12px;
  color: var(--ink-mute); border-bottom: 2px solid transparent;
  background: none; border-top: 0; border-left: 0; border-right: 0;
  font: inherit; cursor: pointer;
}
.tab[aria-selected="true"] { color: var(--ink-bright); border-bottom-color: var(--needs); }
.tab:disabled { color: var(--edge-bright); cursor: default; }
/* What holds the find box, the context bar and the live slot at the far end
   of the tab row. It used to be a `margin-left: auto` on the find box, and
   then a second rule to hand that `auto` to the live slot when the box was
   hidden -- which broke the moment anything was put between the two. A
   spacer belongs to none of them, so any of them can come and go. */
.tabfill { flex-grow: 1; }
.findhome { display: flex; align-items: center; }
/* `display` above would otherwise beat the browser's own rule for `hidden`,
   and the box would never go away -- the same line `.sendbar` carries, and
   the third time this shape has caught something here. */
.findhome[hidden] { display: none; }
.find {
  width: 240px; height: 26px; padding: 0 10px; border-radius: 5px;
  border: 1px solid var(--edge); background: var(--raised); color: var(--ink);
  font-family: var(--mono); font-size: 12px;
}
.find:focus { outline: none; border-color: var(--needs); }
.find::placeholder { color: var(--ink-faint); }
/* How full the chosen session's context window is, at the end of the tab row
   where it is in view on every tab. The Session tab says it too, in a panel
   you have to go to; this is the one fact in that panel you want to notice
   rather than look up. */
.ctxslot { margin-left: 12px; display: inline-flex; align-items: center;
  gap: 10px; }
.ctxslot[hidden] { display: none; }
/* An estimate, so it does not wear a state colour: the four this page spends
   are about what an agent is doing, and this is about what it has cost. */
.spent { color: var(--ink-mute); font-size: 12px; white-space: nowrap;
  cursor: help; }
.live { margin-left: 12px; display: inline-flex; align-items: center;
  color: var(--ink-faint); font-size: 12px; white-space: nowrap; }
mark { background: var(--mark); color: var(--bg); border-radius: 2px; padding: 0 1px; }
.nohits { color: var(--ink-mute); padding: 4px 0; }
.content { flex-grow: 1; overflow-y: auto; padding: 20px 24px; min-height: 0; }

/* transcript */
/* `flex-start`, not the default stretch. `.who` carries a name, a day, a time
   and a copy button -- 71 px of them -- and a stretched bubble is as tall as
   that whatever is in it. One line of text then sat 14 px below the top of a
   71 px box with 41 px under it, which reads as a block that is not centred
   and is really a block that is not the size of its contents. */
.turn { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 22px;
        position: relative; }
/* Only a block that has just arrived. It used to sit on `.turn`, so the whole
   history slid every time the tab was rebuilt — which is whenever anything
   about the transcript changes. `patchTranscript` is the one place a block is
   new; the reduced-motion switch above covers this like everything else. */
.fresh { animation: slide .15s ease-out; }
@keyframes slide { from { transform: translateY(4px); opacity: 0; } }
.who {
  width: 64px; flex-shrink: 0; padding-top: 2px; font-family: var(--mono);
  font-size: 11px; color: var(--ink-faint); text-align: right; line-height: 1.5;
}
.who.claude { color: var(--needs); }
/* The name is a link to this block. It reads as the name it always was; the
   browser's own "open in a new tab" is what it is there for. */
.who .self { color: inherit; text-decoration: none; }
.who .self:hover { text-decoration: underline; }
.who .day { color: var(--ink-faint); }
/* Copy the source of a reply. It is there when the pointer is on the turn,
   the way the `+` on a diff line is: a button beside every line of a
   transcript would be the loudest thing on the page. Keyboard focus shows it
   too, or it could not be reached without a mouse. */
.who .copy {
  margin-top: 5px; padding: 0; border: none; background: none; cursor: pointer;
  font-family: var(--mono); font-size: 10px; color: var(--ink-faint);
  opacity: 0; transition: opacity .1s ease;
}
.turn:hover .copy, .copy:focus { opacity: 1; }
.who .copy:hover { color: var(--needs); }
/* Where a link landed, for long enough to find with your eye. */
.turn.linked { outline: 2px solid var(--needs); outline-offset: 6px;
  border-radius: 4px; }
.bubble {
  flex-grow: 1; padding: 11px 15px; border-radius: 6px; background: var(--raised);
  border: 1px solid var(--edge); line-height: 1.5; min-width: 0;
  white-space: pre-wrap; word-wrap: break-word;
}
/* The question an agent is stopped on. It wears the needs-you colour,
   because it is the same news the amber row carries and reading the two as
   one thing is the point. */
.asking {
  flex-shrink: 0; max-height: 40vh; overflow-y: auto;
  padding: 12px 16px; border-top: 1px solid var(--edge);
  background: color-mix(in srgb, var(--needs) 8%, var(--raised));
}
.askone + .askone { margin-top: 14px; padding-top: 14px;
                    border-top: 1px solid var(--edge); }
.askhead {
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--needs); font-weight: 600;
}
.askwhat { margin: 3px 0 9px; color: var(--ink-bright); font-size: 14px; }
.askopts { display: flex; flex-direction: column; gap: 6px; }
/* Not `.verb`: a verb is a small control, and this is a paragraph you press.
   The number is what it types, and it is drawn because a button that types
   into your terminal should say what it types. */
.askopt {
  display: flex; gap: 10px; align-items: baseline; width: 100%;
  padding: 8px 10px; text-align: left; cursor: pointer;
  background: var(--sunken); color: var(--ink);
  border: 1px solid var(--edge); border-radius: 6px; font: inherit;
}
.askopt:hover:not(:disabled) {
  background: var(--raised); color: var(--ink-bright);
  border-color: var(--needs);
}
.askopt:disabled { opacity: .55; cursor: default; }
/* What you picked, and what submit will press. It wears the needs-you
   colour, like the row this question came from. */
.askopt.chosen {
  background: var(--raised); color: var(--ink-bright);
  border-color: var(--needs);
  box-shadow: inset 2px 0 0 var(--needs);
}
.askopt.chosen .asknum {
  background: var(--needs); border-color: var(--needs); color: var(--sunken);
}
.asksend { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
.asksays { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }
.asknum {
  flex-shrink: 0; min-width: 18px; text-align: center;
  font-family: var(--mono); font-size: 11px; color: var(--needs);
  border: 1px solid var(--edge); border-radius: 4px; padding: 1px 0;
}
.asktext { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.asklabel { font-size: 13px; font-weight: 600; }
.askwhy { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }
.asknote { margin-top: 8px; font-size: 11px; color: var(--ink-faint); }
/* A file of the reader's own that wostuast cannot use. Not an error of the
   program's, so it does not shout -- but it has to be visible, because the
   only other sign is links that never appear. */
.trouble {
  margin: 14px 0; padding: 10px 12px; border-radius: 6px;
  background: var(--cut-bg); color: var(--cut-ink);
  font-family: var(--mono); font-size: 12px; line-height: 1.6;
  word-break: break-word;
}
.troublehead { font-weight: 600; margin-bottom: 4px; }
/* Something the harness said: a background task finishing, a message from
   another session. It is real news and it is not a prompt, so it gets a quiet
   block rather than your rail and your tint. It was drawn as though you had
   typed it, which is part of what made a transcript read as a wall. */
.turn.aside .bubble {
  background: none; border-style: dashed; color: var(--ink-mute);
}
.turn.aside .who { color: var(--ink-faint); }
/* Your words against Claude's. A rail and a tint say where you spoke, and a
   rule above each one breaks a long transcript into rounds you can scan.
   Both used to be grey blocks told apart by one small word. */
.turn.mine { margin-top: 26px; }
.turn.mine::before {
  content: ""; position: absolute; left: 0; right: 0; margin-top: -14px;
  height: 1px; background: var(--edge);
}
.turn.mine:first-child { margin-top: 0; }
.turn.mine:first-child::before { display: none; }
.turn.mine .who { color: var(--mine); font-weight: 600; }
.turn.mine .bubble {
  background: var(--mine-soft); border-color: transparent;
  border-left: 3px solid var(--mine); border-radius: 0 6px 6px 0;
  color: var(--ink-bright);
}
.prose { flex-grow: 1; line-height: 1.55; min-width: 0; }
/* One of the reader's own autolinks. It sits inside an agent's words, so it
   is underlined rather than coloured: a colour here would compete with the
   four this page already spends on state. */
.ticket { color: inherit; text-decoration: underline dotted;
  text-underline-offset: 2px; }
.ticket:hover { color: var(--needs); text-decoration-style: solid; }
.prose > *:first-child { margin-top: 0; }
.prose > *:last-child { margin-bottom: 0; }
.prose h1, .prose h2, .prose h3 {
  font-size: 16px; font-weight: 600; color: var(--ink-bright); margin: 14px 0 8px;
}
.prose p { margin: 0 0 8px; }
.prose ul, .prose ol { margin: 0 0 8px; padding-left: 22px; }
.prose li { margin: 3px 0; }
.prose code {
  font-family: var(--mono); font-size: 12.5px; padding: 1px 5px;
  border-radius: 4px; background: var(--chosen); color: var(--needs-warm);
}
.prose pre {
  padding: 10px 14px; border-radius: 6px; background: var(--code);
  border: 1px solid var(--edge); overflow-x: auto; margin: 0 0 8px;
}
.prose pre code { background: none; padding: 0; color: var(--code-ink); font-size: 12.5px; }
.prose a { color: var(--needs); }
.prose blockquote {
  margin: 0 0 8px; padding-left: 12px; border-left: 2px solid var(--edge-bright);
  color: var(--ink-mute);
}
.prose table { border-collapse: collapse; margin: 0 0 8px; }
.prose th, .prose td { border: 1px solid var(--edge); padding: 4px 10px; text-align: left; }

/* A group of tool calls belongs to the words above it: the agent says what it
   is about to do, and then does it. Measured, the gaps used to be 16 px above
   and 16 px below -- exactly equal, so the group read as belonging to neither
   and, with the reply below it being the thing you next want to read, as
   belonging to the one after. 6 above and 22 below says which.
   The margins collapse against `.turn`'s own 22, so the numbers here are not
   the gaps: above is 22 + (-16) = 6, and below is max(5, 22) = 22.

   Margin collapse was chosen over the honest mechanism, on purpose. The
   honest one is a `.toolgroup` node around each run of calls and a `gap` on
   a flex column, which is one number and no arithmetic -- but blocks are
   appended flat, and `patchTranscript` appends a new one by index into
   `state.turns.nodes`, which is the only place a block is ever new and so is
   what the arriving-block animation rests on. Grouping changes both. If the
   numbers here need touching again, measure them in a browser rather than
   reading them off; and if they need touching a third time, the wrapper is
   the answer and this is what it costs. */
.turn.toolrow { margin-bottom: 5px; }
.turn:not(.toolrow) + .turn.toolrow { margin-top: -16px; }
.turn.toolrow + .turn:not(.toolrow) { margin-top: 22px; }
.tools { flex-grow: 1; display: flex; flex-direction: column; gap: 4px;
  font-family: var(--mono); font-size: 12px; color: var(--ink-mute); min-width: 0; }
.tool { display: flex; gap: 8px; align-items: baseline; cursor: pointer;
  background: none; border: 0; font: inherit; color: inherit; padding: 0;
  text-align: left; width: 100%; }
.tool .caret { color: var(--edge-bright); width: 10px; flex-shrink: 0; }
.tool .target { color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; }
.tool .plus { color: var(--working); }
.tool .minus { color: var(--cut-ink); }
.tool.failed .name { color: var(--cut-ink); }
.tool-result {
  margin: 2px 0 6px 18px; padding: 8px 12px; border-radius: 6px;
  background: var(--code); border: 1px solid var(--edge); color: var(--code-ink);
  font-family: var(--mono); font-size: 12px; line-height: 1.55;
  white-space: pre-wrap; word-wrap: break-word; max-height: 320px; overflow: auto;
}
.divider {
  display: flex; align-items: center; gap: 10px; margin: 14px 0;
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  letter-spacing: .06em; text-transform: uppercase;
}
.divider::before, .divider::after {
  content: ""; flex-grow: 1; height: 1px; background: var(--edge);
}
.thinking .bubble { background: none; border-style: dashed; color: var(--ink-mute); font-style: italic; }
body:not(.show-thinking) .thinking { display: none; }

/* files and diff: a list on the left, what it names on the right */
/* `relative` for the Transcript tab's "latest" button, which is the one
   thing on a split tab that stands over the pane rather than in it. */
.content.split { padding: 0; overflow: hidden; display: flex; position: relative; }
.side {
  width: var(--side-w, 268px); flex-shrink: 0; display: flex;
  flex-direction: column; min-height: 0;
}
/* The list of places to go sits under the box, so the slot is what it is
   measured from. */
.findslot { position: relative; }
/* As wide as a path, not as wide as the box it hangs under. The sidebar is
   268 px by default and a path is not, so every row was clipped to its last
   few letters -- which is the half you can already see in the tree. It runs
   out over the pane to the right, which is empty space while you are typing
   a name into the box. */
.goto {
  position: absolute; left: 10px; right: auto; top: 100%; z-index: 5;
  min-width: calc(100% - 20px); width: 560px; max-width: 70vw;
  max-height: 60vh; overflow-y: auto;
  background: var(--panel); border: 1px solid var(--edge);
  border-radius: 6px; box-shadow: 0 10px 24px var(--shadow);
}
.goto button {
  display: flex; align-items: center; gap: 5px; width: 100%;
  padding: 6px 12px; background: none; border: 0; color: var(--ink-mute);
  font: inherit; font-family: var(--narrow); font-size: 12.5px;
  text-align: left; cursor: pointer;
}
/* A long path is clipped at its start, because the end of it is the part you
   were looking for -- which is what `direction: rtl` buys. It costs a bidi
   trap: a leading dot is a neutral character, and in an RTL paragraph a
   neutral at the edge goes to the other end, so `.gitignore` drew as
   `gitignore.`. A file with a dot invented on it is a wrong answer that
   looks right. `unicode-bidi: plaintext` takes the paragraph's direction
   from the first strong character in it, which for a path is always
   left-to-right, while the box keeps clipping the start. */
.goto button .name { overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; direction: rtl; unicode-bidi: plaintext; }
.goto button .icon {
  width: 13px; height: 13px; flex-shrink: 0; color: var(--ink-faint);
  fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round;
}
.goto button:hover, .goto button.chosen {
  background: var(--raised); color: var(--ink-bright);
}
.goto .lit { color: var(--needs-warm); font-weight: 600; }
.goto .nohits { padding: 10px 12px; }
.findslot { flex-shrink: 0; display: flex; padding: 8px 10px;
  border-bottom: 1px solid var(--edge); }
.findslot .find { width: 100%; }
.filelist {
  flex-grow: 1; overflow-y: auto; padding: 8px 0;
  font-family: var(--narrow); font-size: 13px; letter-spacing: .01em;
}
.filelist button {
  display: block; width: 100%; padding: 7px 14px; text-align: left;
  background: none; border: 0; border-left: 2px solid transparent;
  font: inherit; color: var(--ink-soft); cursor: pointer;
}
/* The Files list is one height per row, which is what lets it build only the
   rows on screen and stand two spacers in for the rest. The Diff list is not:
   its rows carry a second line of counts. */
.filelist.fixed button {
  height: 28px; padding: 6px 14px; line-height: 16px;
  display: flex; align-items: center; gap: 5px;
}
.filelist.fixed .name { flex-grow: 1; min-width: 0; }
/* Beside every name, so a file and a folder are told apart without reading
   either. It sits on the text baseline, which is where the eye expects it. */
.filelist .icon {
  width: 13px; height: 13px; flex-shrink: 0; color: var(--ink-faint);
  fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round;
}
/* A folder carries the one colour on this page that means nothing else, so
   the shape of the tree is read before any of its names are. A file's icon
   stays quiet: there are far more of them, and they are not the shape. */
.filelist button.dir .icon { color: var(--folder); }
/* On the map a round's icon is a second target -- the row goes to that place
   in the transcript, the icon folds it away -- so it has to say so. Nothing
   else in this list has two, which is why this is the transcript's rule and
   not the list's. No `cursor` here: the row is a button and already sets
   one, so a second declaration would say nothing. The colour under the
   pointer is the part that separates the icon from the rest of the row. */
.filelist.transcript button.dir .icon:hover { color: var(--needs); }
.filelist button:hover .icon { color: inherit; }
.filelist button.dir:hover .icon { color: var(--folder); }
.filelist button.dir { color: var(--ink); }
.listnote {
  flex-shrink: 0; padding: 7px 14px; border-bottom: 1px solid var(--edge);
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.filelist button:hover { background: var(--raised); color: var(--ink-bright); }
.filelist button.chosen {
  background: var(--raised); border-left-color: var(--needs); color: var(--ink-bright);
}
.filelist .name {
  display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.filelist .counts { display: flex; gap: 8px; margin-top: 2px; font-size: 11px; }
.filelist .head {
  padding: 12px 14px 4px; font-size: 11px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-faint);
}
.filelist button.touched .name::after {
  content: "\25cf"; margin-left: 6px; color: var(--needs); font-size: 9px;
  vertical-align: middle;
}
/* At the right edge of a folder row, where a count sits on a diff row: it
   is what the folder has instead of contents. Quiet, because it is a fact
   about a build directory and not a warning about anything. */
.toobig {
  margin-left: auto; padding-left: 8px; flex-shrink: 0;
  font-family: var(--mono); font-size: 10px; color: var(--ink-faint);
}
.filelist .lit { color: var(--needs-warm); font-weight: 600; }
.filelist button.chosen .lit { color: var(--needs); }
/* No box. A file that is not Markdown is the whole page here, not a quotation
   inside a document that does not exist, and the border made a shell script
   look like one. It is drawn as diff rows, so it shares their ramp too. */
.code { color: var(--code-ink); }
/* Which line this was. Numbers are not the content, here or in a diff, so
   they are faint and they are not copied with it. */
.dline .ln { color: var(--ink-faint); user-select: none; }
/* Our colours, not the highlighter's: its stylesheets are not fetched. */
.hljs-comment, .hljs-quote { color: var(--syn-com); font-style: italic; }
.hljs-keyword, .hljs-literal, .hljs-selector-tag,
.hljs-doctag, .hljs-operator { color: var(--syn-key); }
.hljs-string, .hljs-regexp, .hljs-char, .hljs-symbol,
.hljs-bullet, .hljs-addition { color: var(--syn-str); }
.hljs-number { color: var(--syn-num); }
.hljs-title, .hljs-section, .hljs-name,
.hljs-built_in, .hljs-type, .hljs-class { color: var(--syn-fn); }
.hljs-meta, .hljs-comment .hljs-doctag { color: var(--syn-meta); }
.hljs-attr, .hljs-attribute, .hljs-property,
.hljs-variable, .hljs-template-variable { color: var(--syn-attr); }
.hljs-emphasis { font-style: italic; }
.hljs-strong { font-weight: 600; }
.hljs-deletion { color: var(--cut-ink); }
.plus { color: var(--working); }
.minus { color: var(--cut-ink); }
/* What a tab's body is: the column that scrolls. The diff sets its own
   padding, because its rows run to the edge. */
.filebody, .diffbody, .reviewbody, .turnbody {
  flex-grow: 1; overflow-y: auto; min-width: 0;
}
.turnbody { padding: 20px 24px; }
.turnbody > .empty { max-width: 52ch; }
/* Over the transcript, at its foot, and only while it would do something.
   It is a `.verb`, which already gives it the height, the padding, the
   border, the raised background, the type and the hover -- so what is left
   here is only what makes it float. It needs no `[hidden]` rule of its own
   the way `.sendbar` does: `.verb` sets no `display`, so nothing beats the
   browser's own rule for the attribute. */
.tofoot {
  position: absolute; right: 22px; bottom: 16px; z-index: 4;
  border-radius: 13px; box-shadow: 0 2px 8px var(--shadow);
}
/* The map of the conversation. Same rows as the file tree, because they are
   the same thing: a list on the left that names what is on the right. */
/* The row is a line: icon, then what it says. `.filelist button` is a block,
   because the Diff tab's rows carry a second line of counts under the name --
   so a row that is one line has to say so, the way `.fixed` does for the file
   tree. Without this the icon sat on a line of its own above the text. */
.filelist.transcript button {
  display: flex; align-items: center; gap: 5px;
}
.filelist.transcript .name { flex-grow: 1; min-width: 0; }
/* A round is yours, so it takes the one colour that means that. */
.filelist.transcript button.dir .icon { color: var(--mine); }
/* The padding is on the children of the scroller, so a branch added to
   `drawFiles` later cannot quietly lose its gutter, and so the header --
   which is not one of them -- keeps running to the pane's edges. */
/* Two children: a header that does not move, and the part that does. The
   header used to be `position: sticky` inside the scroller, which keeps it
   in view but not out of the scrollbar's way -- the bar ran the whole height
   of the pane, beside a line that never scrolls. */
.filebody { padding: 0; display: flex; flex-direction: column; overflow: hidden; }
.filescroll { flex-grow: 1; min-height: 0; overflow: auto; padding-top: 14px; }
.filescroll > * { padding: 0 26px 20px; }
.filebody > .empty { padding: 20px 26px; }
/* Shown as it is: a picture, a video, a sound. Given room and no more -- a
   screenshot wider than the pane would otherwise set the pane's width and
   take the sideways scrollbar with it. */
.media img, .media video {
  max-width: 100%; height: auto; border: 1px solid var(--edge);
  border-radius: 6px; background: var(--code);
}
.media audio { width: 100%; max-width: 420px; }
.reviewbody { padding: 16px 20px; }
/* The Diff tab's body has no padding of its own -- a diff's rows run to the
   edge -- so its empty state has to bring its own inset, or it sits against
   the left edge while the Review tab's sits properly in from it. A margin
   and not a padding: it is the block that has to move, and a padded box
   still starts at the edge. */
.diffbody > .empty { margin: 16px 20px; }
/* The small label look: the path above a file, and the names of the two
   boxes at the top of a review. */
.filebody .where, .fieldname {
  font-family: var(--narrow); font-size: 12px; letter-spacing: .04em;
  color: var(--ink-faint);
}
/* What the open file is: its path, what it holds, and the two controls for
   how it is drawn. It is outside the scroller, so it stays in view in both
   directions without being sticky in either. */
.filebody > .where {
  flex-shrink: 0; padding: 12px 26px; gap: 14px;
  display: flex; align-items: baseline; flex-wrap: wrap;
  background: var(--bg); border-bottom: 1px solid var(--edge);
}
.filebody .where .link { margin-top: 0; flex-shrink: 0; }
/* What is known about the file, after its name: the type, the size, when it
   last changed. `auto` pushes the controls to the far end. */
.filebody .where .whatis { color: var(--ink-mute); flex-shrink: 0; }
.filebody .where .reading { margin-left: auto; display: flex; gap: 10px;
  align-items: baseline; flex-shrink: 0; }
.filebody .where .reading .link[aria-pressed="true"] { color: var(--needs); }
.link:disabled { opacity: .5; cursor: default; }
/* One piece of the path. Text nodes separate them, so the whole line is still
   one string to select and copy. */
.crumbs { min-width: 0; word-break: break-all; }
.crumb { cursor: pointer; }
.crumb:hover { color: var(--needs); text-decoration: underline; }
.diffhead {
  position: sticky; top: 0; z-index: 1; padding: 9px 20px;
  background: var(--panel); border-bottom: 1px solid var(--edge);
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--ink-faint);
}
/* What this section is a diff of, under its name. Not uppercase and not
   letter-spaced: it is a sentence, and the heading above it is a label. */
.diffhead .about {
  display: block; margin-top: 3px; text-transform: none; letter-spacing: 0;
  font-size: 11.5px; color: var(--ink-mute);
}
.dfile { border-bottom: 1px solid var(--edge); }
.dfile > .name {
  display: flex; gap: 10px; align-items: baseline; width: 100%;
  padding: 9px 20px; background: var(--raised); border: 0; font: inherit;
  color: var(--ink-bright); text-align: left; cursor: pointer;
}
/* An untracked file's header is a label, not a toggle: there is nothing to
   fold, because every line in the file is shown. */
.dfile > div.name { cursor: default; }
.dfile .what {
  color: var(--ink-faint); font-size: 11px; letter-spacing: .06em;
  text-transform: uppercase; flex-shrink: 0;
}
.dfile .path {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: var(--narrow); font-size: 13px;
}
.dfile .why { margin-left: auto; flex-shrink: 0; color: var(--ink-faint); font-size: 11px; }
.hunk {
  padding: 6px 20px; background: var(--panel); color: var(--ink-mute);
  border-top: 1px solid var(--edge); white-space: pre; overflow-x: auto;
}
/* What makes a row a row of code. It belongs here and not on a tab's own
   container: it used to sit on `.diffbody`, so the moment the Files tab drew
   the same rows they came out in the proportional face, with the gutter's
   space padding no longer lining up. A component carries its own typography. */
.dlines {
  padding: 5px 0; overflow-x: auto; color: var(--code-ink);
  font-family: var(--mono); font-size: 12.5px; line-height: 21px;
  /* How wide a tab is drawn. The reader picks it; see `recallReading`. */
  tab-size: var(--tab-w, 4);
}
/* A windowed file's rows are a grid the scrollbar is read against, so the row
   height is a whole number of pixels (`CODE_H`) and nothing pads the block
   they sit in. See `fillCode`. */
.code.windowed .dlines { padding: 0; }
/* On the Files tab the rows give up their own scroller, so the long-line bar
   is at the bottom of the screen instead of under the last line of the file —
   which in a file of any length is somewhere nobody scrolls to. The pane
   scrolls both ways instead, and the place the reader had scrolled to then
   survives a window move for free.
   The Diff tab keeps the scroller here on purpose: it stacks many files in
   one pane, so a bar at the bottom of the screen would belong to whichever
   block happened to be under it. */
.filebody .dlines { overflow-x: visible; }
/* Wrapped: the line breaks instead of running off the side. On the root, like
   the theme, because it is about this browser and not about a tab — and
   `:not(.windowed)` is the exclusion itself rather than a promise made in
   three other places: a windowed file's rows are a grid the scrollbar is read
   against, and a wrapped row is not one row tall. */
:root[data-wrap="yes"] .filebody .code:not(.windowed) .dline {
  white-space: pre-wrap; min-width: 0; overflow-wrap: anywhere;
}
.dline { padding: 0 20px 0 0; white-space: pre; min-width: max-content; }
.dline { position: relative; }
.dline.context { color: var(--ink-mute); }

/* The review. The `+` sits over the first characters of the gutter and shows
   on hover, the way a pull request does it. `user-select: none` keeps it out
   of a copied diff, like the line numbers beside it.

   Not `.plus`: that is the green "+3" beside a changed file, and this block
   was written on top of it. Every count on the page went invisible — a file
   that had gained lines read as if it had only lost them. */
.addnote {
  position: absolute; left: 2px; top: 0; width: 18px; height: 18px;
  padding: 0; border: none; border-radius: 4px; cursor: pointer;
  background: var(--needs); color: var(--bg); font: inherit; font-size: 12px;
  line-height: 18px; opacity: 0; user-select: none; transition: opacity .1s ease;
}
.dline:hover .addnote, .addnote:focus { opacity: 1; }
.onFile .addnote, .onLine .addnote {
  position: static; opacity: 1; margin: 6px 0 6px 20px; }
/* Sticky, so a comment stays where it can be read when a wide diff is
   scrolled sideways. `pre` is the diff's business, not the note's. */
.onLine, .onFile { position: sticky; left: 0; white-space: normal; max-width: 680px; }
.comment {
  margin: 6px 20px; padding: 9px 12px; border-radius: 6px;
  background: var(--raised); border-left: 3px solid var(--mine);
  font-family: var(--sans); font-size: 13px; color: var(--ink);
}
.comment .note { white-space: pre-wrap; line-height: 1.5; }
/* What you can do to a comment, at the far end of it. The note is what you
   came to read; the buttons are not, so they get out of its way. A row of its
   own rather than `.buttons`, which the Review tab already owns two of. */
.acts { display: flex; gap: 8px; justify-content: flex-end; margin-top: 8px; }
/* The Review tab: the two boxes at the top, one block per place, and the
   message itself at the bottom. */
.about { margin-bottom: 20px; }
.field { display: block; margin-bottom: 12px; }
.fieldname { display: block; margin-bottom: 4px; }
.spot {
  margin-bottom: 18px; padding: 10px 12px; border-radius: 6px;
  background: var(--raised); border: 1px solid var(--edge);
}
/* The heading over the message, in the same voice as a diff's section head. */
.sofar {
  margin: 4px 0 8px; font-family: var(--narrow); font-size: 12px;
  letter-spacing: .04em; color: var(--ink-faint);
}
.spot .where { margin-bottom: 4px; }
.reviewbody .buttons { flex-wrap: wrap; margin: 14px 0 8px; }
.reviewbody .why { font-size: 11px; color: var(--ink-faint); }
.comment .quoted {
  margin-bottom: 6px; padding: 3px 8px; border-radius: 4px;
  background: var(--code); color: var(--ink-faint);
  font-family: var(--mono); font-size: 12px; white-space: pre-wrap;
}
.onFile > .where {
  margin: 6px 20px 0; font-family: var(--mono); font-size: 12px;
  color: var(--ink-mute);
}
.link {
  margin-top: 6px; padding: 0; border: none; background: none; cursor: pointer;
  color: var(--ink-faint); font-family: var(--mono); font-size: 11px;
}
.link:hover { color: var(--needs); }
.commentbox { margin: 6px 20px; max-width: 680px; }
/* Every box you type a review into looks the same: the one under a line, and
   the two at the top of the Review tab. */
.commentbox textarea, .field textarea {
  width: 100%; padding: 9px 12px; border-radius: 6px; resize: vertical;
  border: 1px solid var(--edge-bright); background: var(--raised);
  color: var(--ink); font-family: var(--sans); font-size: 13px; line-height: 1.5;
}
.commentbox textarea:focus, .field textarea:focus {
  outline: none; border-color: var(--needs);
}
.commentbox .buttons, .reviewbody .buttons {
  display: flex; gap: 12px; align-items: center; margin-top: 6px;
}
/* Under the field, at its right edge — where the eye is after reading back
   what it typed. */
.commentbox .buttons { justify-content: flex-end; }
.dline.added { background: var(--add-bg); color: var(--add-ink); }
.dline.removed { background: var(--cut-bg); color: var(--cut-ink); }
.note {
  padding: 14px 20px; font-family: var(--mono); font-size: 12px;
  line-height: 1.7; color: var(--ink-mute);
}
.note b { color: var(--ink-soft); font-weight: 500; }
.tab .badge {
  padding: 1px 6px; border-radius: 10px; background: var(--chosen);
  color: var(--ink-soft); font-size: 11px;
}

.empty { color: var(--ink-mute); max-width: 52ch; line-height: 1.6; }
.empty code { font-family: var(--mono); background: var(--chosen); padding: 2px 6px;
  border-radius: 4px; color: var(--needs-warm); }
.empty h2 { font-size: 16px; color: var(--ink-bright); margin: 0 0 10px; }

/* Two bars over the whole page, for the two things that stop it working.
   One goes when the stream comes back; the other goes when you reload,
   which is the only thing that fixes it.

   The class that says a bar is wanted is never the class the bar wears.
   `body.lost .lost` reads well and the rule above it, `.lost`, matched the
   body too -- so `classList.add("lost")` gave `body` `display: none` and the
   whole page went blank the moment the stream hiccupped. It came back when
   the stream did, or when the reader pressed F5, which is what made it look
   like a page that had simply stopped working. Nothing named here may be a
   word `body` also wears. */
.lost, .stale {
  display: none; padding: 6px 16px; background: var(--cut-bg);
  color: var(--cut-ink); font-family: var(--mono); font-size: 12px;
  border-bottom: 1px solid var(--edge);
}
body.offline .lost { display: block; }
body.outdated .stale { display: block; }

dialog.help {
  border: 1px solid var(--edge-bright); border-radius: 8px; background: var(--panel);
  color: var(--ink); padding: 18px 22px; font-family: var(--mono); font-size: 13px;
}
dialog.help::backdrop { background: var(--veil); }
dialog.help h2 { margin: 0 0 12px; font-size: 14px; color: var(--ink-bright); }
.field textarea {
  width: 100%; padding: 8px 10px; border-radius: 6px; resize: vertical;
  border: 1px solid var(--edge-bright); background: var(--raised);
  color: var(--ink); font-family: var(--sans); font-size: 13px; line-height: 1.5;
}
.field textarea:focus { outline: none; border-color: var(--needs); }
/* The message itself, not a description of it. It cannot be edited here: a
   comment is edited where the comment is, so there is one text and one place
   it comes from. */
.reviewtext {
  margin: 0; padding: 12px 14px; overflow: auto;
  border-radius: 6px; background: var(--code); color: var(--code-ink);
  font-family: var(--mono); font-size: 12px; line-height: 1.55;
  white-space: pre-wrap; word-break: break-word;
}
.rename {
  width: min(460px, 60vw); padding: 4px 8px; border-radius: 5px;
  border: 1px solid var(--needs); background: var(--raised); color: var(--ink);
  font-family: var(--sans); font-size: 13px;
}
.rename:focus { outline: none; }
.sidefoot:empty { display: none; }
.sidefoot {
  flex-shrink: 0; padding: 8px 10px; border-top: 1px solid var(--edge);
}
.verb.submit { width: auto; height: 30px; padding: 0 16px; }
.verb:disabled { opacity: .5; cursor: default; border-color: var(--edge); }
dialog.help dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 0; }
dialog.help dt { color: var(--needs); }
dialog.help dd { margin: 0; color: var(--ink-mute); }
</style>
</head>
<body>
<div class="app">
  <div class="lost">connection lost — reconnecting…</div>
  <div class="stale">wostuast was restarted, so this page is out of date and
    nothing it sends will go in. Reload it.</div>
  <div class="topbar">
    <div class="brand">wostuast</div>
    <div class="where" id="where">—</div>
    <div class="counts" id="counts"></div>
    <div class="bellslot">
      <button type="button" class="theme" id="bell"
              aria-expanded="false" title="what to be told about"></button>
      <div class="alerts" id="alerts" hidden>
        <div class="alertnote" id="alertnote"></div>
        <label class="alertone"><input type="checkbox" id="alertneeds">
          <span>an agent needs you</span></label>
        <label class="alertone"><input type="checkbox" id="alertdone">
          <span>an agent has finished</span></label>
      </div>
    </div>
    <button type="button" class="theme" id="theme" title="light, dark, or follow the system"></button>
  </div>
  <div class="body">
    <div class="sidebar">
      <div class="sidebar-head">Sessions</div>
      <div class="findslot">
        <input class="find" id="pick" type="search" placeholder="filter sessions  f"
               autocomplete="off" spellcheck="false">
      </div>
      <div class="rows" id="rows"></div>
      <div class="hints">
        <div><b>j k</b> move &nbsp; <b>n</b> next needs-you &nbsp; <b>f</b> filter &nbsp; <b>/</b> find</div>
        <div><b>1-5</b> tabs &nbsp; <b>t</b> thinking &nbsp; <b>c</b> colours &nbsp; <b>?</b> keys</div>
      </div>
    </div>
    <div class="grip" id="grip"></div>
    <div class="main">
      <div class="tabs" role="tablist">
        <button class="tab" role="tab" aria-selected="true" data-tab="transcript">1 Transcript</button>
        <button class="tab" role="tab" aria-selected="false" data-tab="files">2 Files</button>
        <button class="tab" role="tab" aria-selected="false" data-tab="diff">3 Diff<span
          class="badge" id="diffcount" hidden></span></button>
        <button class="tab" role="tab" aria-selected="false" data-tab="review">4 Review<span
          class="badge" id="reviewcount" hidden></span></button>
        <button class="tab" role="tab" aria-selected="false" data-tab="session">5 Session</button>
        <div class="tabfill"></div>
        <div class="findhome" id="findhome">
          <input class="find" id="find" type="search" placeholder="find in transcript  /"
                 autocomplete="off" spellcheck="false">
        </div>
        <div class="ctxslot" id="ctxslot" hidden></div>
        <div class="live" id="live"></div>
      </div>
      <div class="content" id="content"></div>
      <div class="asking" id="asking" hidden></div>
      <form class="sendbar" id="sendbar" hidden>
        <textarea class="say" id="say" rows="1" autocomplete="off"
                  spellcheck="false"
                  placeholder="type into the terminal  ·  s  ·  shift+enter for a new line"></textarea>
        <button class="verb" type="submit">send</button>
      </form>
    </div>
  </div>
</div>

<dialog class="help" id="help">
  <h2>Keys</h2>
  <dl>
    <dt>j / k</dt><dd>move down and up the list</dd>
    <dt>n</dt><dd>jump to the next session that needs you</dd>
    <dt>f</dt><dd>filter the session list</dd>
    <dt>r</dt><dd>the review you have written</dd>
    <dt>/</dt><dd>find in the transcript</dd>
    <dt>1 – 5</dt><dd>transcript, files, diff, review, session</dd>
    <dt>Enter</dt><dd>jump to that agent's tmux pane</dd>
    <dt>s</dt><dd>type into its terminal</dd>
    <dt>t</dt><dd>show or hide thinking</dd>
    <dt>c</dt><dd>colours: auto, light, dark</dd>
    <dt>?</dt><dd>this list</dd>
    <dt>Esc</dt><dd>close</dd>
  </dl>
</dialog>

<script>
"use strict";

const state = {
  sessions: [],
  chosen: null,
  tab: "transcript",
  find: "",
  pick: "",             // what the sidebar filter box holds
  history: false,       // whether the finished sessions are unfolded
  skew: 0,              // server clock minus ours
  // The reader's own autolinks, compiled once. Empty until `/api/links`
  // answers, and empty for ever on a machine with no `links.json`.
  links: [],
  // What is wrong with `links.json`, if anything. Shown on the Session tab.
  linkTrouble: [],
  // The last thing the daemon refused to do, on the one line the page keeps
  // for saying things. It stays there until something replaces it.
  trouble: "",
  // What the reader has picked for the question on screen, one index per
  // question, and which question they belong to. Not in the DOM: a pick made
  // for one question must never be submitted for the next.
  picked: { id: "", at: [] },
  // Where each session was left, by id. The choices only -- see `savePlace`.
  // Not `places`: `state.files.places` is the list of things to go to, and
  // one word for two ideas is how one of them gets shadowed.
  visits: new Map(),
  stream: null,
  // Everything the Files tab holds, and nothing another tab reads. A tab's
  // state arrives and leaves with the tab: the flat bag this came out of meant
  // fifteen more names in one scope every time a tab was added, and nothing
  // said which tab owned any of them. See `blankFiles`.
  files: null,          // set below, because it is built in one place
  turns: null,          // the Transcript tab's own; see `blankTurns`
  loose: null,          // an untracked file picked on the Diff tab
  looseFound: {},       // the whole answer for it, for `putMedia`
  goTo: false,          // and whether the pane still has to move to it
  looseText: null,      // null while it is being read
  looseBinary: false,
  diff: null,
  // What the Session tab shows: how many of each event, and the last few of
  // them. `at` moves when an answer arrives, which is what the tab redraws on.
  events: { counts: {}, events: [], at: 0 },
  diffOpen: new Map(),  // diff files the reader opened or shut by hand
  // The review being written. It lives in this browser and nowhere else
  // until it is sent. See PLAN.md section 4.9 and `blankReview`.
  review: null,         // set below, because it is built in one place
  writing: null,        // the anchor of the comment box that is open, if any
  pruned: false,        // whether the stored reviews have been swept once
  diffRaw: "",          // the last answer, as it arrived, to compare against
  diffAt: 0,            // bumped when that answer changes, so keys stay short
  poll: 0,
};

state.files = blankFiles();
state.turns = blankTurns();
state.review = blankReview();

const $ = (id) => document.getElementById(id);

// --- asking the daemon to do something --------------------------------------

// Everything else on this page reads. These two write, into a live terminal,
// so the daemon wants proof the request came from a page it served: a token it
// made at start and printed here. Any site can POST to a loopback port, but a
// header of its own is not something a cross-origin request may add without
// asking first, and the daemon never says yes.
const TOKEN = "__WOSTUAST_TOKEN__";

// Where one session's routes live. Three callers: the two that fetch, and
// `putMedia`, which wants an address for a `src` rather than an answer.
function apiUrl(id, what, query) {
  return "/api/session/" + encodeURIComponent(id) + "/" + what + (query || "");
}

async function tell(id, verb, body) {
  try {
    const answer = await fetch(apiUrl(id, verb), {
      method: "POST",
      headers: { "Content-Type": "application/json",
                 "X-Wostuast-Token": TOKEN },
      body: JSON.stringify(body || {}),
    });
    return await answer.json();
  } catch (error) {
    return { error: "the daemon did not answer" };   // it went away; say so
  }
}

// What came back, on the one line the page keeps for saying things.
// Naming a session. Claude Code names one from its first prompt and
// `/rename` changes that, but the name it hands the status line is the one the
// session started with — so a rename in the terminal does not reach this page
// until the session is started again. A name set here is ours and wins.
async function keepRename(box) {
  const id = state.chosen;
  const asked = box.value;
  box.blur();
  if (!id) return;
  const answer = await tell(id, "name", { name: asked });
  if (answer && answer.error) { said(answer); return; }
  // The rows are rebuilt from the names on the daemon's next pass, which is a
  // second away. This is so the header does not sit on the old one until then.
  const s = current();
  if (s) {
    s.name = (answer && answer.name) || "";
    s.label = s.name ? s.name + " \u00b7 " + s.place : s.place;
  }
  drawHeader();
  drawSessions();
  if (state.tab === "session") draw();
}

// --- the Session tab ---------------------------------------------------------
//
// Everything about the one session that is open, in the one place that is
// about it. It replaces a bar that stood over every tab and said the branch,
// the pane, the model and the state — which the chosen row says already, one
// column to the left, and which cost 56 pixels of every tab to repeat.

// The names a reader would recognise, for the counts. An event this does not
// know still shows, under the name Claude Code gave it.
const EVENT_WORDS = {
  UserPromptSubmit: "prompts", PreToolUse: "tool calls",
  PostToolUse: "results", PostToolUseFailure: "failures",
  PermissionRequest: "permission asks", Notification: "notifications",
  Stop: "turns ended", SubagentStop: "subagents", PreCompact: "compactions",
  SessionStart: "starts", SessionEnd: "ends",
};

function putFacts(pane, s) {
  const field = put(pane, "div", "field");
  const list = put(field, "dl");
  const row = (name, value, cls) => {
    if (value === "" || value === null || value === undefined) return;
    put(list, "dt", null, name);
    put(list, "dd", cls || null, String(value));
  };
  row("state", s.state_word, "word " + s.state);
  row("worktree", s.cwd);
  row("repository", s.repo);
  row("branch", s.branch || "not in a repository");
  if (s.ahead || s.behind) row("against upstream", "↑" + s.ahead + " ↓" + s.behind);
  row("changed files", s.dirty ? s.touched_files : "none");
  row("model", s.model);
  if (hasContext(s)) {
    put(list, "dt", null, "context used");
    putContext(put(list, "dd"), s.context_pct);
  }
  if (s.cost_usd !== null && s.cost_usd !== undefined) {
    put(list, "dt", null, "spent");
    const cell = put(list, "dd", null, money(s.cost_usd));
    put(cell, "span", "aside",
        "estimated at list price \u00b7 starts again after /clear");
  }
  // One row per rate-limit window the status line told us about. Each is
  // independently absent -- they appear only for a claude.ai Pro or Max
  // subscription, or behind a gateway, and only after the first API response,
  // and Claude Code drops a window once its reset has passed. So nothing here
  // is drawn as a nought: an empty map means nobody said, not nothing used.
  for (const [window, one] of Object.entries(s.limits || {})) {
    put(list, "dt", null, LIMIT_WORDS[window] || window);
    const cell = put(list, "dd");
    // Above 100 behind a spend limit you have gone past, which is exactly
    // when it must not be clamped away.
    putContext(cell, one.used_pct).lastChild.textContent =
      Math.round(one.used_pct) + "% used";
    if (one.resets_at) {
      put(cell, "span", "aside", "resets " + whenOf(one.resets_at));
    }
  }
  row("started", whenOf(s.since) + "  ·  " + ago(s.since) + " ago");
  row("session id", s.id);
  // The pane, and the one thing this page can do with it. `jump` used to sit
  // in the bar above every tab; it belongs beside the pane it is about.
  put(list, "dt", null, "tmux pane");
  const where = put(list, "dd");
  put(where, "span", null, s.pane || "not in tmux");
  if (s.pane) {
    const go = put(where, "button", "verb", "jump");
    go.type = "button";
    go.style.marginLeft = "12px";
    go.title = "put the cursor in that pane  ⏎";
    go.addEventListener("click", jumpToPane);
    // Escape, not Ctrl-C: see `tmux_interrupt`. It stops the turn and keeps
    // the work, where Ctrl-C into a prompt that has just gone idle is one
    // press away from ending the session.
    const stop = put(where, "button", "verb quiet", "stop");
    stop.type = "button";
    stop.style.marginLeft = "8px";
    stop.title = "press Escape in that pane: stops this turn, keeps the work";
    stop.addEventListener("click", async () => {
      said(await tell(s.id, "interrupt"));
      if (!state.trouble) note("pressed Escape");
    });
  }
}

// Whether the status line has told us how full the window is. It is the one
// number here that only the status line carries, so a session whose status
// line is not registered has none and nothing about it is drawn.
function hasContext(s) {
  return !!s && s.context_pct !== null && s.context_pct !== undefined;
}

// The bar, not a number: how full a context window is reads at a glance and
// does not at a count. Two places want it -- the Session tab, and the strip
// at the end of the tab row -- and they draw the same thing, so they build it
// the same way.
function putContext(parent, percent) {
  const pct = Math.round(percent);
  const ctx = put(parent, "span",
                  "ctx" + (pct >= 85 ? " hot" : pct >= 60 ? " warm" : ""));
  const bar = put(ctx, "span", "bar");
  put(bar, "span", "fill").style.width = Math.max(2, Math.min(100, pct)) + "%";
  put(ctx, "span", null, pct + "% ctx");
  return ctx;
}

// What a session may spend before wostuast stops it, and the box that sets
// it. The number is the reader's own -- only they know what an agent is worth
// -- so the daemon keeps it beside the names rather than working it out.
//
// It is the one thing on this page that makes wostuast type into a terminal
// with nobody watching, so the row says plainly what it will do, and says it
// again once it has: a reader who comes back to a stopped agent must be able
// to find out why from the page rather than from the pane.
function putLimit(pane, s) {
  const field = put(pane, "div", "field");
  put(field, "div", "fieldname", "stop at");
  const cell = put(field, "div", "limitrow");
  const box = put(cell, "input", "limitbox");
  box.type = "number";
  box.min = "0";
  box.step = "1";
  box.placeholder = "no limit";
  box.title = "Dollars. wostuast presses Escape in this pane once the spend"
    + " passes it, which stops the turn and keeps the work done so far."
    + " Empty or 0 means it never does.";
  box.value = s.spend_limit ? String(s.spend_limit) : "";
  box.addEventListener("change", () => setLimit(s.id, box.value));
  // Nothing to press, so nothing to offer. jump and stop are simply absent
  // for such a session; this box stays, disabled, because the panel is where
  // you go to find out what a session is and "you cannot stop this one from
  // here" is part of that. It used to accept a number and warn only once one
  // had been typed.
  if (!s.pane) box.disabled = true;
  // What it will actually do, which is not always what it was asked to do.
  // `over_limit` skips a session with no pane and one whose status line has
  // not sent a spend, so promising either reader that they are protected is
  // the worst thing this box could say.
  const blind = s.cost_usd === null || s.cost_usd === undefined;
  if (!s.pane) {
    put(cell, "span", "aside",
        "this session is not in tmux, so nothing can be pressed");
  } else if (s.limit_fired) {
    // Said here and not only in the log, because "why did my agent stop" is
    // asked in front of this panel. Raising the box is what lets it go again.
    put(cell, "span", "aside",
        "stopped " + ago(s.limit_fired) + " ago · raise it to go on");
  } else if (!s.spend_limit) {
    // Nothing promised, so nothing to warn about.
  } else if (blind) {
    put(cell, "span", "aside",
        "its status line does not send the spend, so this cannot fire");
  } else {
    put(cell, "span", "aside", "Escape into this pane when the spend passes it");
  }
}

async function setLimit(id, typed) {
  const asked = Number(typed);
  said(await tell(id, "limit",
                  { limit: typed.trim() === "" || !(asked > 0) ? 0 : asked }));
}

//: What each rate-limit window is called, in words. A name wostuast does not
//: know is shown as the status line spelled it, rather than left out.
const LIMIT_WORDS = {
  five_hour: "5-hour limit", seven_day: "weekly limit",
  spend_limit: "spend limit",
};

function putRename(pane, s) {
  const field = put(pane, "div", "field");
  put(field, "div", "fieldname", "name");
  const box = put(field, "input", "rename");
  box.type = "text";
  box.autocomplete = "off";
  box.spellcheck = false;
  box.placeholder = "a name for this session  ·  enter to keep";
  // What is already there, when it is a name someone chose. A name Claude
  // Code wrote is a starting point too, so it goes in as well.
  box.value = s.name || "";
  box.addEventListener("keydown", (press) => {
    if (press.key === "Enter") { press.preventDefault(); keepRename(box); }
    else if (press.key === "Escape") { press.preventDefault(); box.blur(); }
  });
}

function putTally(pane, counts) {
  const field = put(pane, "div", "field");
  put(field, "div", "fieldname", "what it has done");
  const box = put(field, "div", "counts");
  const names = Object.keys(counts).sort(
    (a, b) => counts[b] - counts[a] || a.localeCompare(b));
  if (!names.length) {
    put(box, "span", null, "nothing yet");
    return;
  }
  for (const name of names) {
    const one = put(box, "span");
    put(one, "b", null, String(counts[name]));
    put(one, "span", null, " " + (EVENT_WORDS[name] || name));
  }
}

function putLog(pane, events) {
  const field = put(pane, "div", "field");
  put(field, "div", "fieldname",
      "the last " + events.length + (events.length === 1 ? " event" : " events"));
  const box = put(field, "div", "sessionlog");
  if (!events.length) {
    put(box, "div", "note", "Nothing has arrived for this session yet.");
    return;
  }
  // Newest last, the way it happened, and scrolled to the end: the thing you
  // came to read is what it did most recently.
  for (const one of events) {
    const row = put(box, "div");
    put(row, "span", "at", clock(one.ts));
    put(row, "span", "what", EVENT_WORDS[one.name] || one.name);
    put(row, "span", "said", one.text || "");
  }
  requestAnimationFrame(() => { box.scrollTop = box.scrollHeight; });
}

function drawSession(box) {
  if (box.dataset.tab !== "session") {
    homeFind($("findhome"));   // it may be inside what is about to be cleared
    box.replaceChildren();
    box.dataset.tab = "session";
    box.dataset.nameKey = "";
    box.dataset.bodyKey = "";
    const body = put(box, "div", "sessionbody");
    // Two parts, because one of them is typed into. The name field is built
    // when the session changes and not again; everything else is rebuilt
    // whenever it moves. A poll that redrew the box being typed in would take
    // the name with it, which is the rule the review keeps for its comments.
    put(body, "div", "namefield");
    put(body, "div", "limitfield");
    put(body, "div", "rest");
  }
  const [name, limit, rest] = box.firstChild.children;
  const s = current();
  if (fresh(box, "nameKey", s ? s.id : "none")) {
    name.replaceChildren();
    if (s) putRename(name, s);
  }
  // The other box on this panel, and it is kept for the same reason: `rest`
  // is rebuilt on every four-second poll, and a rebuild under the hand takes
  // what is in it -- worse here than for the name, because the node is
  // removed rather than blurred, so `change` never fires and the number the
  // reader typed is not merely lost on screen, it is never stored.
  //
  // Unlike the name it has news of its own -- a limit that has fired -- so
  // its key carries that, and the redraw is skipped while the box has the
  // focus. `writingIn` is the same instinct: ask the DOM, not a flag.
  const limitKey = s ? JSON.stringify(
    [s.id, s.spend_limit, s.limit_fired, s.pane,
     s.cost_usd === null || s.cost_usd === undefined]) : "none";
  if (!limit.contains(document.activeElement)
      && fresh(box, "limitKey", limitKey)) {
    limit.replaceChildren();
    if (s) putLimit(limit, s);
  }
  if (!s) {
    if (!fresh(box, "bodyKey", "none")) return;
    rest.replaceChildren();
    drawEmpty(rest);
    return;
  }
  const key = JSON.stringify([s.id, s.state, s.branch, s.cwd, s.pane, s.model,
                              s.context_pct, s.dirty, s.touched_files, s.since,
                              state.events.at, state.linkTrouble]);
  if (!fresh(box, "bodyKey", key)) return;
  rest.replaceChildren();
  putFacts(rest, s);
  putLinkTrouble(rest);
  putTally(rest, state.events.counts);
  putLog(rest, state.events.events);
}

// What is wrong with `links.json`. It is the reader's own file and nothing
// else on the page can say so: the transcript just has no links in it, which
// is also what a machine with no such file looks like.
function putLinkTrouble(pane) {
  if (!state.linkTrouble.length) return;
  const box = put(pane, "div", "trouble");
  put(box, "div", "troublehead", "links.json");
  for (const why of state.linkTrouble) put(box, "div", null, why);
}

async function loadSession() {
  const want = state.chosen;
  if (!want) { draw(); return; }
  const body = await ask(want, "events");
  if (state.chosen !== want) return;   // the reader moved on while we waited
  if (body && !body.missing) {
    state.events = { counts: body.counts || {}, events: body.events || [],
                     at: state.events.at + 1 };
  }
  draw();
}

// What the daemon answered, on the one line the page keeps for saying
// things. A failure stays.
//
// It used to fade after four seconds, like everything else on this strip,
// and it is not like everything else: it is about a thing you tried and did
// not get. A reader whose page had gone stale saw "that did not come from
// this page" flash while they were looking at the terminal, and then a strip
// reading "live" over a page where nothing worked. It stays until the next
// message replaces it, or until something works.
function said(answer) {
  // A page from an earlier `serve` cannot do anything at all, and no strip
  // this small can carry that. The bar says it, and only a reload clears it.
  if (answer && answer.stale) document.body.classList.add("outdated");
  // Kept, not painted and forgotten: the stream writes "live" into this slot
  // on every push, which is about once a second while an agent works, so a
  // failure written straight in was wiped within a second. The thing the
  // reader most needed to read was the thing that lasted least. An answer
  // that worked clears it, which is the other half of "until something
  // replaces it".
  state.trouble = (answer && answer.error) || "";
  paintLive();
}

// The one line the page keeps for saying things, and the three things that
// want it: what the stream is doing, something you asked for and did not
// get, and a passing word that borrows the slot over both.
//
// One painter, because four writers raced for it.
function paintLive(borrowed) {
  $("live").textContent = borrowed || state.trouble || state.live || "";
}

// Our own word about what just happened -- "review sent", "pressed 2, 1".
// News, so it goes stale, so it fades; nothing was asked for and refused.
function note(text) {
  paintLive(text);
  setTimeout(() => {
    // Only when the slot still holds this line. Assigning unconditionally
    // would wipe whatever the stream has put there since.
    if ($("live").textContent === text) paintLive();
  }, 4000);
}

// --- dragging a column edge -------------------------------------------------

// Paths are long, screens differ, and the alternative to a handle is a config
// option, which this program prefers to delete. The width goes into a CSS
// variable rather than onto the element, so a column that is rebuilt keeps it,
// and into this browser's storage, so a reload does too.

function rememberWidth(name, px) {
  const root = document.documentElement;
  if (px) root.style.setProperty(name, px + "px");
  else root.style.removeProperty(name);
  try {
    if (px) localStorage.setItem("wostuast" + name, String(px));
    else localStorage.removeItem("wostuast" + name);
  } catch (error) {
    // A private window remembers nothing. The drag still works.
  }
}

function dragWidth(grip, name, least, most) {
  grip.title = "drag to resize, double-click to reset";
  // Each handle brings its own width back, so a third one is one call and
  // not two. The file column's is built when its tab first opens, which is
  // when it is wanted.
  let saved = "";
  try { saved = localStorage.getItem("wostuast" + name) || ""; } catch (e) { }
  if (saved) rememberWidth(name, Number(saved));
  let from = 0;
  let was = 0;
  const move = (at) => {
    rememberWidth(name,
                  Math.min(most, Math.max(least, was + at.clientX - from)));
  };
  const stop = () => {
    document.body.classList.remove("dragging");
    grip.classList.remove("dragging");
    window.removeEventListener("pointermove", move);
    window.removeEventListener("pointerup", stop);
  };
  grip.addEventListener("pointerdown", (at) => {
    from = at.clientX;
    was = grip.previousElementSibling.getBoundingClientRect().width;
    document.body.classList.add("dragging");
    grip.classList.add("dragging");
    window.addEventListener("pointermove", move);
    window.addEventListener("pointerup", stop);
    at.preventDefault();          // no text selection while dragging
  });
  grip.addEventListener("dblclick", () => rememberWidth(name, 0));
  return grip;
}

// --- the two scripts that come from the web --------------------------------

// Nothing else is fetched at runtime. Both are pinned: `integrity` is the hash
// of the exact bytes and `crossorigin` is what lets the browser check it. Any
// script on this page can POST to /send, which types into the user's terminal,
// so a script from someone else's server without a hash would be a way into
// it. A CDN that has been tampered with gets you the plain fallback, never
// other code.
//
// `marked` v12.0.2 renders the transcript. MIT, Christopher Jeffrey.
// https://github.com/markedjs/marked
const MARKED_SRC =
  "https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js";
const MARKED_HASH =
  "sha384-/TQbtLCAerC3jgaim+N78RZSDYV7ryeoBCVqTuzRrFec2akfBkHS7ACQ3PQhvMVi";
// `highlight.js` v11.9.0 paints code. BSD-3-Clause, Ivan Sagalaev.
const HLJS_SRC =
  "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js";
const HLJS_HASH =
  "sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp";

function fetchScript(src, hash) {
  return new Promise((settle) => {
    const tag = document.createElement("script");
    tag.src = src;
    tag.integrity = hash;
    tag.crossOrigin = "anonymous";
    // Offline, blocked, or bytes that do not match the hash all land here.
    tag.addEventListener("error", () => settle(false));
    tag.addEventListener("load", () => settle(true));
    document.head.appendChild(tag);
  });
}

// --- colours ----------------------------------------------------------------
// Three choices: follow the system, or pin one. The pinned one is remembered in
// this browser, so it survives a reload and never leaves the machine.

const THEME_ORDER = ["system", "light", "dark"];

function systemTheme() {
  return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
}

function themeChoice() {
  return document.documentElement.dataset.themeChoice || "system";
}

function applyTheme(choice) {
  document.documentElement.dataset.themeChoice = choice;
  document.documentElement.dataset.theme = choice === "system" ? systemTheme() : choice;
  try {
    if (choice === "system") localStorage.removeItem("wostuast-theme");
    else localStorage.setItem("wostuast-theme", choice);
  } catch (error) {
    // A browser that refuses storage still gets the colours, just not the memory.
  }
  const button = $("theme");
  if (button) button.textContent = { system: "auto", light: "light", dark: "dark" }[choice];
  redrawIcon();
}

function nextTheme() {
  applyTheme(THEME_ORDER[(THEME_ORDER.indexOf(themeChoice()) + 1) % THEME_ORDER.length]);
}

window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
  if (themeChoice() === "system") applyTheme("system");
});

// A folder and a page, drawn rather than fetched: no icon font, no image, and
// `currentColor` means each one is already the right colour in both themes
// and when its row is chosen. SVG needs its own namespace, which is the whole
// reason this is not `put`.
const ICONS = {
  dir: "M1 3.2a1 1 0 0 1 1-1h3.1l1.2 1.6H12a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H2a1"
       + " 1 0 0 1-1-1z",
  // The same folder with its front panel tipped forward. It is what says a
  // directory stands open, now that there is no triangle in front of it to
  // say so.
  //
  // Two subpaths, and the front one is closed. The first drawing left it
  // open on the right -- the lid stopped at x=12, the floor ran to x=13 and
  // ended in a curl, and nothing joined them -- so the folder read as one
  // with its right side sliced off. Nothing was clipped: the stroke sat
  // inside the box either way. A shape that is not closed looks cut whether
  // or not anything cut it.
  dirOpen: "M1 10.6V3.2a1 1 0 0 1 1-1h3.1l1.2 1.6H11a1 1 0 0 1 1 1v1.1"
           + "M3.5 6.6h8.4a.8 .8 0 0 1 .78 1l-1 3.9a.8 .8 0 0 1-.78 .6H1.6"
           + "a.8 .8 0 0 1-.78-1l1-3.9a.8 .8 0 0 1 .78-.6z",
  // The page ends at 13.4 and not at 13.5, because the stroke is 1.2 wide
  // and reaches 0.6 past the line. At 13.5 the last tenth of it fell outside
  // the box, and an `svg` clips to its viewport.
  file: "M3.5 1.5h4.7L11.5 5v8.4h-8zM8 1.7V5h3.3",
};

function putIcon(parent, kind) {
  const where = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(where, "svg");
  svg.setAttribute("class", "icon");
  svg.setAttribute("viewBox", "0 0 14 14");
  svg.setAttribute("aria-hidden", "true");
  const path = document.createElementNS(where, "path");
  path.setAttribute("d", ICONS[kind]);
  svg.appendChild(path);   // how it is drawn is CSS, on `.filelist .icon`
  parent.appendChild(svg);
  return svg;
}

// Everything below comes from an agent. It is never trusted as HTML.
function put(parent, tag, cls, text) {
  const node = document.createElement(tag);
  if (cls) node.className = cls;
  if (text !== undefined && text !== null) node.textContent = String(text);
  parent.appendChild(node);
  return node;
}

// A short age: `40s`, `4min`, `2h 15min`, `2d 6h`. Two units once the first
// one is coarse -- `2d` covers anything from two days to just short of three,
// which is not an answer to "when did this last do something". The second is
// left off when it is nought, so `2d` still means exactly two days.
function ago(when) {
  const seconds = Math.floor(Math.max(0, (Date.now() / 1000 + state.skew) - when));
  const two = (big, bigUnit, small, smallUnit) =>
    small ? big + bigUnit + " " + small + smallUnit : big + bigUnit;
  if (seconds < 60) return seconds + "s";
  if (seconds < 3600) return Math.floor(seconds / 60) + "min";
  if (seconds < 86400) {
    return two(Math.floor(seconds / 3600), "h",
               Math.floor(seconds % 3600 / 60), "min");
  }
  return two(Math.floor(seconds / 86400), "d",
             Math.floor(seconds % 86400 / 3600), "h");
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function clock(when) {
  if (!when) return "";
  const at = new Date(when * 1000);
  return String(at.getHours()).padStart(2, "0") + ":" +
         String(at.getMinutes()).padStart(2, "0");
}

// The day a moment fell on -- `21 Sep` -- or nothing at all when it is today.
// A transcript read the next morning is a column of bare times, and "15:48"
// is then a lie by omission. The day the daemon thinks it is, not the one
// this browser does: `state.skew` is the difference, and it is what every
// other age on this page is measured against.
function dayOf(when) {
  if (!when) return "";
  const at = new Date(when * 1000);
  const now = new Date((Date.now() / 1000 + state.skew) * 1000);
  if (at.toDateString() === now.toDateString()) return "";
  return at.getDate() + " " + MONTHS[at.getMonth()];
}

// --- the sidebar ------------------------------------------------------------

const ages = [];

// A session nobody can talk to any more. The daemon sorts these to the end;
// the page folds them away under "history".
function isGone(s) {
  return s.state === "ended" || s.state === "dead";
}

// The four groups the list is drawn in, most urgent first, and what each one
// is called above its rows.
//
// This means a row moves when a session changes state, which an older rule
// here forbade — sorting by state made the list churn for nothing. It is not
// for nothing now: a row arriving under "needs you" is the one thing this
// tool exists to tell you, and it only happens when a turn ends, begins, or
// stops on a question. Inside a group the daemon's order stands, which is by
// worktree, so nothing shuffles while a session works.
//
// Working sits above ready, and that is the order a reader asked for: an
// agent still going is something you may want to look in on, and one waiting
// at its prompt is something you have already finished with. Ready used to be
// second, on the reading that a session wanting a prompt is nearer to wanting
// you -- it is not, because nothing about it is waiting.
const BANDS = [
  ["needs", "needs you", (s) => s.state === "needs_you"],
  ["working", "working", (s) => s.state === "working"],
  ["ready", "ready", (s) => s.state === "done"],
  ["history", "history", isGone],
];

function bandOf(s) {
  for (const band of BANDS) if (band[2](s)) return band[0];
  return "ready";                    // a state nobody here knows is not urgent
}

// The rows the filter box leaves. A session is matched on everything the row
// shows: the worktree, the name Claude Code gave it, and the branch. `fuzzy`
// is the same matcher the Files tab uses, so "ofd" finds "oans/fastduck".
// The counts and the "N of M" line are about this: the filter is what they
// are narrowed by, not the fold.
function shownSessions() {
  if (!state.pick) return state.sessions;
  return state.sessions.filter((s) => fuzzy(
    [s.place, s.name, s.branch].filter(Boolean).join(" "), state.pick));
}

// What is actually in the list. `j` and `k` walk this, because a key must not
// move to a row that is not on screen. Typing in the filter box opens the
// history: a search that cannot see half the sessions gives a wrong answer
// that looks like a right one. So does the session you are reading, which is
// never hidden from the list it is chosen in.
function listedSessions() {
  const shown = shownSessions();
  if (state.history || state.pick) return shown;
  return shown.filter((s) => !isGone(s) || s.id === state.chosen);
}

// One empty row, built once and then only filled in. Every row has the same
// parts whether or not it has anything to put in them, so `fillRow` can reach
// them by position and nothing has to be created again later.
function newRow(id) {
  const row = document.createElement("div");
  row.dataset.id = id;
  row.addEventListener("click", () => choose(id));
  const one = put(row, "div", "line1");
  put(one, "span", "dot");
  put(one, "span", "name");
  put(one, "span", "word");
  put(row, "div", "called");
  put(row, "div", "line2");
  const three = put(row, "div", "line3");
  put(three, "span", "said");
  put(three, "span", "age");
  return row;
}

function fillRow(row, s) {
  const [one, called, two, three] = row.children;
  row.className = "row " + s.state + (s.id === state.chosen ? " chosen" : "");
  one.children[0].className = "dot " + s.state;
  one.children[1].textContent = s.place || s.label || s.id.slice(0, 8);
  one.children[2].textContent = s.state_word;
  called.textContent = s.name || "";
  called.hidden = !s.name;
  two.replaceChildren();
  if (s.branch) put(two, "span", "branch", s.branch);
  if (s.ahead) put(two, "span", "ahead", "↑" + s.ahead);
  if (s.behind) put(two, "span", "ahead", "↓" + s.behind);
  if (s.dirty) put(two, "span", "dirty", "● " + s.touched_files + " files");
  else if (s.branch) put(two, "span", "clean", "✓ clean");
  three.children[0].textContent = s.reason || s.last_event || "";
  three.children[1].textContent = ago(s.since);
  ages.push([three.children[1], s.since]);
}

// The line between what is running and what is over. It carries the count and
// folds the history away, because a week of finished sessions above the two
// you are working with is a list you stop reading.
function historyBar(many) {
  const bar = document.createElement("button");
  bar.type = "button";
  bar.className = "histhead";
  bar.addEventListener("click", () => {
    state.history = !state.history;
    try { localStorage.setItem("wostuast-history", state.history ? "open" : "shut"); }
    catch (error) { }
    drawSessions();
  });
  return bar;
}

function drawSessions() {
  const box = $("rows");
  // Only when they would come out different. The stream re-subscribes the
  // moment a session is first chosen, and the new stream opens with a full
  // push of its own, so every page load drew the whole sidebar twice.
  const shown = shownSessions();
  pruneReviews(state.sessions);
  drawCounts(shown);
  const listed = listedSessions();
  const past = shown.filter(isGone);
  if (!fresh(box, "drawn",
             JSON.stringify([listed, state.chosen, past.length, state.history]))) {
    return;
  }
  // A row that is still there is kept and filled in again. A dot can only
  // fade into its new colour if it is the same dot, and the needs-you ring
  // can only finish a cycle if its row outlives the change that started it —
  // and a state change is exactly when both of those used to be thrown away.
  // The bar is kept for the same reason; anything else that is not a row goes
  // first, because the loop below places things by position and a stray node
  // would shift every one of them.
  const had = new Map();
  let bar = null;
  for (const node of Array.from(box.children)) {
    if (node.dataset.id) had.set(node.dataset.id, node);
    else if (node.classList.contains("histhead")) bar = node;
    else node.remove();
  }
  ages.length = 0;
  let at = 0;
  const place = (node) => {
    if (box.children[at] !== node) box.insertBefore(node, box.children[at] || null);
    at += 1;
  };
  // One head per group that has anything under it, in the order of `BANDS`.
  // The heads are made fresh each time: they carry only a count, so there is
  // no animation in them to preserve, unlike a row.
  // Not `!past.length`: with nothing to fold the loop skips the bar, and a
  // bar left from the last draw then survived the removal below. A filter
  // that hid every finished session still showed "history · 2" over nothing.
  let barPlaced = false;
  for (const [name, title] of BANDS) {
    const mine = listed.filter((s) => bandOf(s) === name);
    if (name === "history") {
      if (!past.length) continue;
      bar = bar || historyBar();
      bar.textContent = (state.history ? "\u25be" : "\u25b8") +
        " history \u00b7 " + past.length;
      place(bar);
      barPlaced = true;
    } else if (mine.length) {
      const head = put(document.createDocumentFragment(), "div", "band " + name,
                       title + " \u00b7 " + mine.length);
      place(head);
    }
    for (const s of mine) {
      const row = had.get(s.id) || newRow(s.id);
      had.delete(s.id);
      fillRow(row, s);
      place(row);
    }
  }
  if (!barPlaced && bar) bar.remove();
  for (const gone of had.values()) gone.remove();
  if (!listed.length && state.sessions.length && !past.length) {
    put(box, "div", "nohits", "no session matches");
  }
}

// Only the ages change by themselves. Rebuilding the rows to advance them
// would restart the needs-you pulse every second, so it never finished a
// cycle, and would throw away the dot's colour transition as well.
function tickAges() {
  for (const [node, since] of ages) node.textContent = ago(since);
}

function drawCounts(shown) {
  const box = $("counts");
  box.replaceChildren();
  // The rows arrive already sorted by state, and each carries its own word, so
  // the order and the wording are the server's and are not restated here.
  const tally = new Map();
  for (const s of state.sessions) {
    const seen = tally.get(s.state) || { word: s.state_word, n: 0 };
    seen.n += 1;
    tally.set(s.state, seen);
  }
  let first = true;
  for (const [key, seen] of tally) {
    if (!first) put(box, "span", "sep", "|");
    first = false;
    put(box, "span", "dot " + key);
    put(box, "span", null, seen.n + " " + seen.word);
  }
  if (first) put(box, "span", null, "no sessions");
  const needs = (tally.get("needs_you") || { n: 0 }).n;
  const working = (tally.get("working") || { n: 0 }).n;
  document.title = needs
    ? "(" + needs + ") needs you · wostuast"
    : working ? working + " working · wostuast" : "wostuast";
  drawIcon(needs ? "needs_you" : working ? "working"
    : state.sessions.length ? "done" : "gone");
  const all = state.sessions.length;
  // Everything above is about every session, filter or no filter: "who needs
  // me" must not change because you typed in a box. Only this line narrows.
  $("where").textContent = (shown.length === all ? all : shown.length + " of " + all) +
    " session" + (all === 1 ? "" : "s");
  notifyAbout(state.sessions);
}

function current() {
  return state.sessions.find((s) => s.id === state.chosen) || null;
}

// The question an agent is waiting on: at the foot of the transcript, over
// the send box.
//
// It is not the bar `PLAN.md` took away, and that is the point. That one
// stood over every tab saying the branch, the pane, the model and the state,
// all of which the chosen row says one column to the left, and it cost 56
// pixels on every tab for ever. This stands in one place, for as long as one
// agent is stopped, and it is the last thing in the conversation because it
// *is* the last thing in the conversation — the transcript ends at its foot,
// which is where a question belongs and where your eye already is. Answering
// is sending, so it sits with the send box.
//
// The row still goes amber from any tab, which is what the row is for. This
// is the answer to "what is it asking", and that question is asked here.
//
// `asking` is cleared wherever the attention is, and exactly by its own
// `tool_use_id` when the answer lands — so answering in the terminal takes
// this away too, within a second.
function drawAsking() {
  const box = $("asking");
  const s = current();
  // `state.tab` and not the content box: this is chrome outside that box,
  // like the send box, and it is drawn after `showTab` has set the name.
  const ask = s && state.tab === "transcript" ? s.asking : null;
  box.hidden = !ask;
  if (!ask) {
    // And forget what was drawn, or the same question asked twice in a row
    // would match the key and leave an empty bar standing.
    box.dataset.ask = "";
    box.replaceChildren();
    return;
  }
  // The rows arrive about once a second while an agent works. Rebuilding
  // under a button the reader is about to press is how a click lands on the
  // wrong option, and a disabled button would come back enabled.
  if (!fresh(box, "ask", s.id + "\n" + ask.id)) return;
  // A pick belongs to the question it was made for. A different question
  // arriving takes the old picks with it rather than submitting them.
  if (state.picked.id !== ask.id) {
    state.picked = { id: ask.id, at: ask.questions.map(() => -1) };
  }
  box.replaceChildren();
  ask.questions.forEach((one, which) => {
    const block = put(box, "div", "askone");
    if (one.header) put(block, "div", "askhead", one.header);
    put(block, "p", "askwhat", one.question);
    const list = put(block, "div", "askopts");
    one.options.forEach((option, at) => {
      const button = put(list, "button", "askopt");
      button.type = "button";
      // The number it will press, shown. What reaches your terminal should
      // not be a thing you have to trust.
      put(button, "span", "asknum", String(at + 1));
      const text = put(button, "span", "asktext");
      put(text, "span", "asklabel", option.label);
      if (option.description) put(text, "span", "askwhy", option.description);
      // Picking types nothing. It marks, and it can be changed: a click that
      // went straight into a terminal was a click you could not take back,
      // on a page you may have opened on a phone in a pocket.
      button.addEventListener("click", () => {
        state.picked.at[which] = at;
        paintPicks(box, ask);
      });
    });
    if (one.many) {
      put(block, "div", "asknote", "This one takes more than one answer."
          + " Here you can pick one; finish it in the terminal.");
    }
  });
  const foot = put(box, "div", "asksend");
  const send = put(foot, "button", "verb");
  send.type = "button";
  send.addEventListener("click", () => submitAsk(s.id, ask, box));
  put(foot, "span", "asksays");
  paintPicks(box, ask);
}

// What is picked, and what pressing submit would do. Everything that changes
// when a reader clicks an option lives here, so picking never rebuilds the
// bar: a rebuild under the hand is how a click lands on the wrong option.
function paintPicks(box, ask) {
  const picked = state.picked.at;
  box.querySelectorAll(".askone").forEach((block, which) => {
    block.querySelectorAll(".askopt").forEach((button, at) => {
      button.classList.toggle("chosen", picked[which] === at);
    });
  });
  const ready = picked.every((at) => at >= 0);
  const send = box.querySelector(".asksend .verb");
  const says = box.querySelector(".asksays");
  // Reading the question is worth having wherever the session runs -- it is
  // the one thing this page exists to tell you. *Answering* it is keystrokes
  // into a tmux pane, and a session outside tmux has none, so the button is
  // refused rather than left to fail on the press. The Review tab's submit
  // has said this for as long as it has existed; this bar did not, and
  // offered "presses 1" to a terminal that could never be typed into.
  const s = current();
  const canType = !!(s && s.pane);
  send.disabled = !ready || !canType;
  send.textContent = "submit";
  // Said before it is pressed, not after. These are keystrokes into a live
  // terminal, and the reader is the one answerable for them.
  says.textContent = !canType
    ? "this session is not in tmux, so nothing can be pressed"
    : ready
    ? "presses " + picked.map((at) => at + 1).join(", then ")
    : (picked.length > 1 ? "pick an answer to each" : "pick an answer");
}

// Press the numbers in the agent's terminal, in the order it asked.
//
// `tmux_send` sends one line literally and then presses Enter, so each of
// these is a keystroke and not a paste: exactly what your own finger would
// do. It is the one road to a terminal this page has, the same one the send
// box uses, and it carries the same token.
//
// The question does not go away here. It goes away when the daemon sees the
// `PostToolUse` for this exact `tool_use_id`, which is the only thing that
// knows the answer landed — clearing it on the click would hide a question
// that a missed keystroke left standing.
async function submitAsk(id, ask, box) {
  const send = box.querySelector(".asksend .verb");
  send.disabled = true;
  const numbers = state.picked.at.map((at) => at + 1);
  for (const number of numbers) {
    const answer = await tell(id, "send", { text: String(number) });
    if (answer && answer.error) {
      said(answer);
      send.disabled = false;      // nothing landed, or only part of it did
      return;
    }
  }
  note("pressed " + numbers.join(", "));
}

// Show or hide what the agent was thinking, and say which.
//
// The key worked from the day it shipped and read as broken anyway: most
// transcripts hold no thinking at all, so pressing it changed nothing on
// screen and nothing said why. A key that does something invisible is a key
// that does nothing, as far as anyone pressing it can tell.
function toggleThinking() {
  const on = document.body.classList.toggle("show-thinking");
  const many = state.turns.blocks.filter(
    (one) => one && one.kind === "thinking").length;
  note(!many ? "nothing was thought aloud in this transcript"
             : (on ? "showing " : "hiding ") + many
               + (many === 1 ? " thought" : " thoughts"));
}

function drawHeader() {
  // All that is left of a bar that used to stand over every tab saying the
  // branch, the pane, the model and the state — which the chosen row already
  // says, one column to the left. The send box is what remains, and it
  // belongs to the transcript: there is nowhere else on this page you would
  // type to an agent.
  //
  // The open question is drawn from here rather than from four call sites,
  // so a fifth cannot forget it. It is the other thing that lives outside a
  // tab, and for the same reason: it belongs to the session, not to a tab.
  drawAsking();
  drawContext();
  const s = current();
  const was = $("sendbar").hidden;
  $("sendbar").hidden = !s || !s.pane || state.tab !== "transcript"
    || s.state === "ended" || s.state === "dead";
  // Only when it appears. `drawHeader` runs on every push from the daemon,
  // which is about once a second while an agent works, and `fitSay` reads a
  // layout it has just made dirty. What is in the box cannot change without
  // the reader typing, and that has its own listener.
  if (was && !$("sendbar").hidden) fitSay();
}

// How full the chosen session's window is, in the strip at the end of the tab
// row. It is drawn from `drawHeader`, so it arrives with everything else the
// push carries and no fifth call site can forget it.
//
// It is its own element and not `#live`: `paintLive` is the one writer of
// that slot and three things already want it -- what the stream is doing,
// something you asked for and did not get, and a passing word over both. A
// fourth would be the race that rule was written after.
function drawContext() {
  const slot = $("ctxslot");
  if (!slot) return;
  const s = current();
  const spent = s && s.cost_usd !== null && s.cost_usd !== undefined
    ? money(s.cost_usd) : "";
  slot.hidden = !hasContext(s) && !spent;
  if (slot.hidden) {
    slot.replaceChildren();
    slot.dataset.shows = "";
    return;
  }
  const shows = (hasContext(s) ? Math.round(s.context_pct) : "") + "\n" + spent;
  if (slot.dataset.shows === shows) return;  // a push a second, rarely moved
  slot.dataset.shows = shows;
  slot.replaceChildren();
  if (hasContext(s)) putContext(slot, s.context_pct);
  if (spent) {
    // Claude Code works this out on the client at list price and says so, and
    // it goes back to nought on `/clear`. The caveat is worth carrying and is
    // not worth the width of the strip, so it is on the number.
    // Not `money`: that is the function two lines up, and a `const` of the
    // same name here puts that call in the temporal dead zone -- a
    // ReferenceError on every draw, from a name that reads fine.
    const shown = put(slot, "span", "spent", spent);
    shown.title = "What this session has spent, as Claude Code estimates it:"
      + " list price, worked out in your terminal, and it may differ from"
      + " your bill. It starts again at zero after /clear.";
  }
}

// What a session has spent. Cents below ten dollars, because that is where
// the difference between one prompt and the next shows; whole dollars above
// it, because by then the cents are noise in a strip that has to stay short.
// The daemon's `money` says the same thing for its own status line.
function money(dollars) {
  return dollars < 10 ? "$" + dollars.toFixed(2)
                      : "$" + Math.round(dollars);
}

// --- the tab icon, drawn here so it follows the colours ---------------------

let iconWas = "";

// The icon is painted out of the palette, but it is only kept against the
// state it shows — so a theme change left a dark-theme dot on a light page.
function redrawIcon() {
  const was = iconWas;
  iconWas = "";
  if (was) drawIcon(was);
}

function drawIcon(state_) {
  if (state_ === iconWas) return;
  iconWas = state_;
  const size = 32;
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = size;
  const pen = canvas.getContext("2d");
  if (!pen) return;
  const shade = getComputedStyle(document.documentElement)
    .getPropertyValue("--" + (state_ === "needs_you" ? "needs"
      : state_ === "working" ? "working" : state_ === "done" ? "done" : "gone")).trim();
  pen.beginPath();
  pen.arc(size / 2, size / 2, size / 2 - 3, 0, Math.PI * 2);
  pen.fillStyle = shade || "#8b8f9e";
  pen.fill();
  let link = document.querySelector("link[rel='icon']");
  if (!link) {
    link = document.createElement("link");
    link.rel = "icon";
    document.head.appendChild(link);
  }
  link.href = canvas.toDataURL("image/png");
}

// --- telling you when an agent wants you ------------------------------------
//
// Two things are worth being told about, and they are not the same thing. An
// agent that needs you cannot go on without you; an agent that has finished
// is a turn you can read. The first is why this program exists, so it is on
// as soon as alerts are; the second is a choice, so it is off until asked
// for. One switch for both would mean taking the one you want with the one
// you do not.
//
// Both live in this browser, like the theme: they are about this screen, and
// `PLAN.md` rules out a config file for anything wostuast could work out or
// that is the same for everybody.

const waiting = new Set();

//: What each session was doing last time round, so "it has finished" can be
//: a change rather than a state. A session already finished when the page
//: opens is not news, and it has no entry here on the first pass.
const wasDoing = new Map();

const ALERTS_KEY = "wostuast-alerts";

//: The needs-you alert is on the moment alerts are: it is the one thing this
//: tool exists to tell you. The finished one is a choice.
const ALERTS_DEFAULT = { needs: true, done: false };

// Storage is not a place to trust blindly -- it survives across versions and
// anything at all can be in it -- so the shape is checked, like `recallReview`
// and `recallReading` do. The older single switch is read once, so a reader
// who had alerts on keeps them.
function alertsWanted() {
  let kept = null;
  try { kept = localStorage.getItem(ALERTS_KEY); } catch (error) {}
  if (kept) {
    try {
      const one = JSON.parse(kept);
      if (one && typeof one === "object") {
        return { needs: one.needs === true, done: one.done === true };
      }
    } catch (error) {
      // Not ours, or half-written. The defaults are better than nothing.
    }
  }
  let old = null;
  try { old = localStorage.getItem("wostuast-notify"); } catch (error) {}
  if (old === "yes") return { ...ALERTS_DEFAULT };
  if (old === "no") return { needs: false, done: false };
  // Nothing stored. If this browser has already allowed alerts then the
  // reader has said yes to being told things, and the needs-you one is what
  // they were saying yes to -- so it is on, which is the default the issue
  // asks for. Without permission nothing can arrive whatever this says, and
  // a switch that claims to be on while nothing happens is worse than off.
  if ("Notification" in window && Notification.permission === "granted") {
    return { ...ALERTS_DEFAULT };
  }
  return { needs: false, done: false };
}

function rememberAlerts(want) {
  try { localStorage.setItem(ALERTS_KEY, JSON.stringify(want)); } catch (error) {}
}

function alertsCan() {
  return "Notification" in window && Notification.permission === "granted";
}

function anyAlert() {
  const want = alertsWanted();
  return want.needs || want.done;
}

function drawBell() {
  const button = $("bell");
  if (!button) return;
  const can = "Notification" in window;
  button.disabled = !can;
  button.textContent = !can ? "no alerts"
    : alertsCan() && anyAlert() ? "alerts on" : "alerts off";
  const want = alertsWanted();
  $("alertneeds").checked = want.needs;
  $("alertdone").checked = want.done;
  $("alertnote").textContent = !can
    ? "This browser cannot show alerts."
    : Notification.permission === "denied"
      ? "This browser is blocking alerts for this page. Allow them in its"
        + " site settings and they will start."
      : Notification.permission === "granted"
        ? "Shown by your browser, once per session, while this page is open."
        : "Tick one and your browser will ask whether to allow alerts.";
}

// Ticking a box is what asks for permission, so nobody is asked before they
// have said what they want. A refusal leaves the box ticked and the note
// saying why nothing arrives -- unticking it silently would read as the page
// having lost the click.
async function setAlert(which, on) {
  const want = alertsWanted();
  want[which] = on;
  rememberAlerts(want);
  if (on && "Notification" in window && Notification.permission === "default") {
    await Notification.requestPermission();
  }
  drawBell();
}

function showAlerts(open) {
  $("alerts").hidden = !open;
  $("bell").setAttribute("aria-expanded", String(open));
}

function notifyAbout(sessions) {
  const want = alertsWanted();
  const on = alertsCan();
  const now = new Set(sessions.filter((s) => s.state === "needs_you").map((s) => s.id));
  for (const id of waiting) if (!now.has(id)) waiting.delete(id);

  // Read before anything is sent, and written on every pass whatever the
  // switches say. Two things rest on that. Ticking the box while an agent is
  // working still tells you when it stops, which is the turn you ticked it
  // for -- record only while the switch is on and that one alert goes
  // missing. And a session that reached "done" while nobody was listening is
  // then already at "done" rather than a change waiting to be announced, so
  // switching on does not bring an hour of news with it. `waiting` is the
  // same promise for the amber one.
  const before = new Map(wasDoing);
  wasDoing.clear();
  for (const session of sessions) wasDoing.set(session.id, session.state);
  const live = new Set(sessions.map((one) => one.id));
  for (const id of [...before.keys()]) if (!live.has(id)) before.delete(id);

  if (!on) {
    for (const id of now) waiting.add(id);   // do not shout about a backlog later
    return;
  }
  for (const session of sessions) {
    if (want.needs && session.state === "needs_you" && !waiting.has(session.id)) {
      waiting.add(session.id);
      tellAbout(session, session.label + " needs you",
                session.reason || "waiting for you");
    }
    // A change, not a state: "done" is where a session sits between turns,
    // so the news is the moment it got there. A session this page has not
    // seen before has no entry, which is why one already finished when you
    // opened the page says nothing.
    if (want.done && session.state === "done"
        && before.get(session.id) === "working") {
      tellAbout(session, session.label + " has finished", "ready for you");
    }
  }
}

function tellAbout(session, title, body) {
  try {
    const note = new Notification(title, {
      body: body,
      tag: "wostuast-" + session.id,
    });
    note.onclick = () => { window.focus(); choose(session.id); note.close(); };
  } catch (error) {
    // Some browsers refuse without a service worker. Nothing else breaks.
  }
}

// --- the transcript ---------------------------------------------------------

//: At most this many links in one block. A pattern that matches everything
//: would otherwise build a link per word, and every one of them is a DOM
//: node on a page that redraws.
//:
//: It lives here alone. The daemon carried the same name and the same number
//: and read it nowhere -- the page is the only side that makes a link -- so
//: the copy was not a second opinion, it was a second thing to forget.
//:
//: It was 40, which a file of release notes went straight past: the links
//: stopped halfway down and nothing said why. 500 costs 4 ms, measured in
//: this browser on the worst text there is -- a block of 5,000 words, every
//: one of them a match.
const LINKS_MAX = 500;

// The reader's own autolinks, from `links.json` by way of the daemon. It has
// already thrown out an entry that will not compile or whose url is not
// http(s); this compiles what is left, once, and drops anything that still
// will not take -- the two regular expression dialects are close but not the
// same, and a pattern Python accepts may not be one JavaScript does.
async function loadLinks() {
  let body = null;
  try {
    const answer = await fetch("/api/links");
    body = await answer.json();
  } catch (error) {
    return;                            // the daemon went away; try again later
  }
  const out = [];
  // What the daemon could not use, plus anything this side cannot compile.
  // "No links" and "your file is broken" are different answers, and the page
  // showed nothing either way -- so a file you wrote and got wrong looked
  // exactly like a file you never wrote.
  const trouble = [...((body && body.trouble) || [])];
  for (const one of (body && body.links) || []) {
    try {
      out.push({ re: new RegExp(one.match, "g"), url: String(one.url) });
    } catch (error) {
      // Python took this pattern and JavaScript will not. The two dialects
      // are close and not the same, so this one is only findable here.
      trouble.push("this browser cannot use the pattern `" + one.match + "`");
    }
  }
  state.links = out;
  state.linkTrouble = trouble;
  // Trouble goes on the Session tab, which may be what is on screen.
  if (out.length || trouble.length) draw();
}

// The address one match stands for. `$1` to `$9` are the groups and `$0` is
// the whole of it, which is the gitlens shape written the way a person who
// has used `sed` expects.
function ticketUrl(template, hit) {
  const built = template.replace(/\$([0-9])/g,
                                 (whole, n) => hit[Number(n)] || "");
  return /^https?:\/\//i.test(built) ? built : "";
}

// Turn what the reader's patterns match into links, in place.
//
// It walks text nodes, like `markHits`, so nothing an agent wrote is ever
// re-parsed as HTML -- and it skips code and anything already inside a link,
// because a ticket id in a command line is part of the command and a url is
// already where it points.
function linkTickets(root) {
  if (!state.links.length) return;
  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
  const found = [];
  while (walker.nextNode()) {
    const node = walker.currentNode;
    if (node.parentElement && node.parentElement.closest("code, pre, a")) continue;
    found.push(node);
  }
  let made = 0;
  for (const node of found) {
    if (made >= LINKS_MAX) return;
    const pieces = linkOne(node.nodeValue, LINKS_MAX - made);
    if (!pieces) continue;
    made += pieces.made;
    node.replaceWith(pieces.holder);
  }
}

// One text node, cut into text and links. Null when nothing matched, so the
// common case costs a scan and no DOM work at all.
function linkOne(text, room) {
  const holder = document.createDocumentFragment();
  let from = 0;
  let made = 0;
  while (from < text.length && made < room) {
    // The earliest match among every pattern, so two patterns that overlap
    // give the same answer whichever order they are written in.
    let best = null;
    for (const one of state.links) {
      one.re.lastIndex = from;
      const hit = one.re.exec(text);
      // A pattern that can match nothing would never move `from` on.
      if (hit && hit[0] && (!best || hit.index < best.hit.index)) {
        best = { one, hit };
      }
    }
    if (!best) break;
    const where = ticketUrl(best.one.url, best.hit);
    const at = best.hit.index;
    if (at > from) {
      holder.appendChild(document.createTextNode(text.slice(from, at)));
    }
    if (where) {
      const link = put(holder, "a", "ticket", best.hit[0]);
      link.href = where;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      made += 1;
    } else {
      holder.appendChild(document.createTextNode(best.hit[0]));
    }
    from = at + best.hit[0].length;
  }
  if (!made) return null;
  if (from < text.length) {
    holder.appendChild(document.createTextNode(text.slice(from)));
  }
  return { holder, made };
}

//: What may be a link on this page. A page an agent wrote is not a place to
//: follow a `javascript:` or a `data:` from.
const LINKABLE = /^(https?:|#)/i;

//: The same question for a link this page builds itself, which always goes
//: somewhere else -- `#` belongs to Markdown an agent wrote, not to a ticket.
const AWAY = /^https?:\/\//i;

// A link that leaves this page leaves it in a new tab, and takes nothing of
// this one with it. Both places that build one come through here.
function opensAway(link) {
  link.target = "_blank";
  link.rel = "noopener noreferrer";
}

function safeLinks(root) {
  for (const link of root.querySelectorAll("a")) {
    if (!LINKABLE.test(link.getAttribute("href") || "")) {
      link.removeAttribute("href");
    } else {
      opensAway(link);
    }
  }
}

// Walk the text of a node and put something else in place of what matches.
//
// One place, because this is the invariant the whole page rests on: it builds
// nodes and never markup, so nothing an agent wrote is ever parsed as HTML.
// It also collects the text nodes before touching any of them -- replacing
// one mid-walk leaves the walker pointing at a node that has left the
// document.
//
// `cut` is handed one text node's string and gives back a fragment to put in
// its place, or null to leave it alone. `skip` is a selector for text that is
// not prose: code, and a link that is already one.
function overText(root, cut, skip) {
  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
  const found = [];
  while (walker.nextNode()) {
    const node = walker.currentNode;
    if (skip && node.parentElement && node.parentElement.closest(skip)) continue;
    found.push(node);
  }
  for (const node of found) {
    const holder = cut(node.nodeValue);
    if (holder) node.replaceWith(holder);
  }
}

// What Markdown is allowed to produce. Anything else is replaced by its own
// text, so an agent that read a hostile file cannot put elements on this page.
const ALLOWED = new Set([
  "P", "BR", "HR", "STRONG", "EM", "DEL", "CODE", "PRE", "BLOCKQUOTE",
  "UL", "OL", "LI", "A", "H1", "H2", "H3", "H4", "H5", "H6",
  "TABLE", "THEAD", "TBODY", "TR", "TH", "TD", "SPAN", "DIV",
]);

function scrub(node) {
  for (const child of Array.from(node.children)) {
    if (!ALLOWED.has(child.tagName)) {
      child.replaceWith(document.createTextNode(child.textContent || ""));
      continue;
    }
    for (const name of Array.from(child.getAttributeNames())) {
      if (child.tagName === "A" && name === "href") continue;
      child.removeAttribute(name);
    }
    scrub(child);
  }
}

function escapeText(raw) {
  return String(raw)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

// `marked` is fetched, so it may be late and it may never come. The
// transcript is drawn either way: Markdown is written to be read as plain
// text, which is what it falls back to. It is asked for at once, not on first
// use, because the transcript is the tab the page opens on.
let markedAsked = null;

function markedReady() {
  if (!markedAsked) {
    markedAsked = fetchScript(MARKED_SRC, MARKED_HASH).then((came) => {
      if (!came || !window.marked) return false;
      // Raw HTML in an agent's text is shown, not obeyed. Turning it into
      // visible text here rather than escaping the whole source keeps code
      // fences correct: escaping first would have marked escape it a second
      // time inside a fence. It is registered the moment marked arrives and
      // before anything is parsed, so no text is ever parsed without it.
      marked.use({
        renderer: {
          html(token) {
            const raw = typeof token === "string" ? token
                                                  : (token && token.text) || "";
            return escapeText(raw);
          },
        },
      });
      return true;
    });
  }
  return markedAsked;
}

function markdown(parent, text) {
  const node = put(parent, "div", "prose");
  // Not here yet, or never coming. Markdown reads as text, which is the whole
  // point of it, so the transcript is never blank while the page waits.
  if (!window.marked) {
    node.textContent = text;
    return node;
  }
  // marked does not sanitize and passes raw HTML straight through, so the
  // result is scrubbed to an allowlist. Escaping the source instead would be
  // escaped a second time inside code fences, which is how `>` became `&gt;`.
  try {
    // Into a <template> first. Its contents belong to an inert document, so
    // no image is fetched and no handler runs. Assigning to innerHTML here
    // would already have fired an onerror before the scrub could remove it.
    const holder = document.createElement("template");
    holder.innerHTML = marked.parse(String(text), { breaks: false, gfm: true });
    scrub(holder.content);
    node.replaceChildren(holder.content);
  } catch (error) {
    node.textContent = text;   // assigning text already clears the children
  }
  safeLinks(node);
  // After the scrub, so a pattern can never put an element on this page: it
  // walks text nodes and builds one anchor at a time, with an href this side
  // has checked again.
  linkTickets(node);
  return node;
}

// --- painting code ----------------------------------------------------------

// 122 KB of highlighter inside the program would be more than half of it
// again, to paint code that reads perfectly well unpainted. So it is fetched,
// and every path through here works when it does not arrive.
// Files whose language the suffix does not give away. A name with no suffix
// at all — Makefile, Dockerfile — is looked up whole.
const BY_NAME = {
  "Makefile": "makefile", "makefile": "makefile", "GNUmakefile": "makefile",
  "Dockerfile": "dockerfile", "CMakeLists.txt": "cmake",
  ".bashrc": "bash", ".bash_profile": "bash", ".zshrc": "bash",
  ".profile": "bash", ".gitconfig": "ini", ".gitignore": "plaintext",
};
const BY_SUFFIX = {
  h: "c", hpp: "cpp", hh: "cpp", hxx: "cpp", cc: "cpp", cxx: "cpp",
  mk: "makefile", cmake: "cmake", sh: "bash", zsh: "bash",
  yml: "yaml", tsx: "typescript", jsx: "javascript", rs: "rust",
  toml: "ini", cfg: "ini", conf: "ini",
};

// Asked for when the first file that is not Markdown opens, never on load.
// Reading transcripts all day then reaches the network never. One promise, so
// a second file does not start a second download.
let hljsAsked = null;

function hljsReady() {
  if (!hljsAsked) {
    hljsAsked = fetchScript(HLJS_SRC, HLJS_HASH)
      .then((came) => (came && window.hljs) || null);
  }
  return hljsAsked;
}

// What a script says it is on its first line. `wostuast` itself is a Python
// program with no suffix, and so is most of what lives in a bin directory.
const BY_INTERPRETER = {
  python: "python", node: "javascript", bun: "javascript", deno: "typescript",
  sh: "bash", bash: "bash", zsh: "bash", dash: "bash", ksh: "bash",
  fish: "bash", perl: "perl", ruby: "ruby", php: "php", lua: "lua",
  Rscript: "r", awk: "awk", gawk: "awk", pwsh: "powershell", tclsh: "tcl",
};

function fromShebang(text) {
  const first = String(text || "").slice(0, 300).split("\n", 1)[0];
  if (!first.startsWith("#!")) return null;
  // The first word that names a program. `#!/usr/bin/env -S python3 -u` has
  // three words before its options, and only the third one is an interpreter.
  for (const word of first.slice(2).trim().split(/\s+/)) {
    if (word.startsWith("-")) continue;
    const name = word.slice(word.lastIndexOf("/") + 1);
    if (name === "env") continue;
    // `python3`, `python3.12`, `perl5` — the version is not part of the name.
    const known = BY_INTERPRETER[name] || BY_INTERPRETER[name.replace(/[\d.]+$/, "")];
    if (known) return known;
    return null;                   // it named something, and we do not know it
  }
  return null;
}

// Three questions, most certain first: the name, the first line, then what
// `file` made of the content back on the daemon. The order matters — `file`
// calls Rust and Go "C source", so anything that actually knows must win.
function languageOf(path, text, sniffed) {
  const base = path.slice(path.lastIndexOf("/") + 1);
  if (BY_NAME[base]) return BY_NAME[base];
  const dot = base.lastIndexOf(".");
  if (dot > 0) {
    const suffix = base.slice(dot + 1).toLowerCase();
    return BY_SUFFIX[suffix] || suffix;
  }
  return fromShebang(text) || sniffed || null;
}

// Only text and the highlighter's own spans survive. The page does not trust
// what an agent wrote, and it does not trust the highlighter more than that:
// this is the same inert <template> the Markdown path uses, with a narrower
// allowlist.
function paintedInto(holder, marked_up) {
  holder.innerHTML = marked_up;
  const walk = (node) => {
    for (const child of Array.from(node.children)) {
      // `hljs-title function_` is one span with two classes, so the whole
      // list is filtered rather than matched. A bare word is not allowed
      // through: `row` or `tab` would dress a span up as our own chrome.
      const classes = (child.getAttribute("class") || "").split(/\s+/)
        .filter((one) => /^(hljs-[\w-]+|[a-z][\w]*_)$/.test(one));
      if (child.tagName !== "SPAN" || !classes.length) {
        child.replaceWith(document.createTextNode(child.textContent || ""));
        continue;
      }
      for (const name of child.getAttributeNames()) child.removeAttribute(name);
      child.setAttribute("class", classes.join(" "));
      walk(child);
    }
  };
  walk(holder.content);
  return holder.content;
}

// The highlighted file, cut into one fragment per line.
//
// The highlighter is given the whole file, because a block comment or a
// multi-line string only makes sense whole — painting line by line gets those
// wrong. But the page shows one row per line, so the painted result has to be
// cut up afterwards. A span that crosses a newline is closed at the end of the
// line and opened again on the next, which is what `open` is for.
//
// It walks the scrubbed fragment, never a string of HTML: whatever the
// highlighter returned has already been through `paintedInto`.
function cutIntoLines(painted) {
  const lines = [document.createDocumentFragment()];
  const open = [];                       // the spans we are inside, outermost first
  let holder = lines[0];

  function nextLine() {
    const line = document.createDocumentFragment();
    lines.push(line);
    let at = line;
    for (const span of open) {           // the same nesting, reopened
      const copy = document.createElement("span");
      copy.className = span.className;
      at.appendChild(copy);
      at = copy;
    }
    return at;
  }

  function walk(node) {
    for (const child of node.childNodes) {
      if (child.nodeType === Node.TEXT_NODE) {
        const pieces = child.data.split("\n");
        holder.appendChild(document.createTextNode(pieces[0]));
        for (let i = 1; i < pieces.length; i += 1) {
          holder = nextLine();
          holder.appendChild(document.createTextNode(pieces[i]));
        }
        continue;
      }
      const copy = document.createElement("span");
      copy.className = child.className;
      holder.appendChild(copy);
      open.push(child);
      holder = copy;
      walk(child);
      open.pop();
      // Back out one level, on whichever line we have ended up on.
      holder = holder.parentNode;
    }
  }

  walk(painted);
  return lines;
}

// Paint a file that is drawn as rows. The text is on the page before this
// returns, so a slow or missing CDN costs the reader nothing but colour.
async function paintLines(box, path, text, sniffed) {
  const want = box.dataset.path;
  const lib = await hljsReady();
  if (!lib || !box.isConnected || box.dataset.path !== want) return;
  const language = languageOf(path, text, sniffed);
  if (!language || !lib.getLanguage(language)) return;
  let lines;
  try {
    const done = lib.highlight(text, { language, ignoreIllegals: true });
    lines = cutIntoLines(paintedInto(document.createElement("template"),
                                     done.value));
  } catch (error) {
    return;                     // a language that throws leaves the plain text
  }
  const rows = box.querySelectorAll(".dline > .dtext");
  // Only when the two agree. A highlighter that returned a different number of
  // lines than the file has would otherwise put the colour on the wrong ones.
  if (rows.length !== lines.length) return;
  rows.forEach((row, at) => row.replaceChildren(lines[at]));
}

// Onto the clipboard, with the old way behind it. A loopback origin counts
// as secure, so `navigator.clipboard` is usually there -- but it is refused
// often enough (a page that never had the focus, a browser that wants a
// permission) that the answer has to be checked rather than assumed. Neither
// path may throw: this runs from a click handler.
async function copyToClipboard(text) {
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }
  } catch (error) {
    // the old way, below
  }
  try {
    const holder = document.createElement("textarea");
    holder.value = text;
    holder.setAttribute("readonly", "");
    holder.style.position = "fixed";
    holder.style.top = "-1000px";
    document.body.appendChild(holder);
    holder.select();
    const done = document.execCommand("copy");
    holder.remove();
    return done;
  } catch (error) {
    return false;
  }
}

// A link to one reply: `#<session>/<seq>`.
//
// `seq` is a place in one reading of a transcript, not an identity -- a
// session resumed from another directory counts from nought again -- so a
// link is a good pointer and not a promise. Nothing moves when it no longer
// fits, and that is the whole of the failure.
function blockHref(index) {
  return "#" + encodeURIComponent(state.chosen || "") + "/" + index;
}

function placeInHash() {
  const raw = (location.hash || "").replace(/^#/, "");
  const cut = raw.lastIndexOf("/");
  if (cut < 1) return null;
  const seq = Number(raw.slice(cut + 1));
  if (!Number.isInteger(seq) || seq < 0) return null;
  try {
    return { id: decodeURIComponent(raw.slice(0, cut)), seq };
  } catch (error) {
    return null;              // a hash somebody typed by hand
  }
}

// Following a link: at startup, and whenever the hash changes. The session is
// chosen first, because a link may name one that is not on screen, and the
// block is asked for after that -- `choose` blanks everything the last
// session had, this included.
function goToLink() {
  const place = placeInHash();
  if (!place || !place.id) return;
  choose(place.id);           // does nothing when it is already the one shown
  state.turns.goTo = place.seq;
  showTab("transcript");
}

// The block a link asked for, once it has been drawn. It wins over the usual
// landing at the foot of the transcript, and it wins once: scrolling there
// again on every later draw would drag the reader back every second of a live
// session.
function landOnBlock(box) {
  if (state.turns.goTo === null) return false;
  const node = state.turns.nodes[state.turns.goTo];
  if (!node || node.parentNode !== box) return false;
  state.turns.goTo = null;
  node.scrollIntoView({ block: "center" });
  node.classList.add("linked");
  setTimeout(() => node.classList.remove("linked"), 2500);
  return true;
}

// One node per block, kept so that a change redraws that block and no other.
// Rebuilding the lot re-ran marked over the whole history on every update, and
// restarted the slide-in of every turn each time one line arrived.

function blockNode(block, index) {
  if (block.kind === "divider") {
    const node = document.createElement("div");
    node.className = "divider";
    node.textContent = block.text;
    return node;
  }
  if (block.kind === "tool") {
    const node = document.createElement("div");
    node.className = "turn toolrow";
    put(node, "div", "who");
    const tools = put(node, "div", "tools");
    drawTool(tools, block, index);
    return node;
  }
  const mine = block.kind === "prompt";
  // Something the harness said, not the reader and not the agent.
  const aside = block.kind === "note";
  const node = document.createElement("div");
  node.className = "turn" + (mine ? " mine" : "") + (aside ? " aside" : "")
    + (block.kind === "thinking" ? " thinking" : "");
  const who = put(node, "div", "who" + (mine || aside ? "" : " claude"));
  // The name is a link to this block, so the address bar holds one after a
  // click and the browser's own "open in a new tab" works on it. Nothing is
  // intercepted: a plain anchor is already all three of those things.
  const name = put(who, "a", "self",
                   mine ? "you" : aside ? "system" : "claude");
  name.href = blockHref(index);
  name.title = "link to this " + (mine ? "prompt"
                                       : aside ? "message" : "reply");
  if (block.ts) {
    const day = dayOf(block.ts);
    if (day) put(who, "div", "day", day);
    put(who, "div", null, clock(block.ts));
  }
  putCopy(who, block, mine);
  if (mine || aside || block.kind === "thinking") {
    linkTickets(put(node, "div", "bubble", block.text));
  } else {
    markdown(node, block.text);
  }
  return node;
}

// The Markdown an agent wrote, as it wrote it. The page shows it drawn; this
// is the source, which is what goes into a bug report or another prompt.
function putCopy(parent, block, mine) {
  if (!block.text) return null;
  const copy = put(parent, "button", "copy", "copy");
  copy.type = "button";
  copy.title = "copy this " + (mine ? "prompt" : "reply") + " as Markdown";
  copy.addEventListener("click", async () => {
    const done = await copyToClipboard(block.text);
    // The node may be redrawn out from under this; writing to a node that has
    // left the page is harmless, and there is nothing to put back.
    copy.textContent = done ? "copied" : "cannot";
    setTimeout(() => { copy.textContent = "copy"; }, 1400);
  });
  return copy;
}

function nearBottom(box) {
  return box.scrollHeight - box.scrollTop - box.clientHeight < 80;
}

// Wrap every occurrence of the search in <mark>. It walks text nodes, so a
// word split across a tag is missed and nothing an agent wrote is ever
// re-parsed as HTML.
function markHits(node, needle) {
  if (!needle) return;
  const cutter = new RegExp("(" + escapeRegex(needle) + ")", "ig");
  overText(node, (text) => {
    if (!text.toLowerCase().includes(needle)) return null;
    const parts = text.split(cutter);
    const holder = document.createDocumentFragment();
    for (let i = 0; i < parts.length; i += 1) {
      if (!parts[i]) continue;
      if (i % 2) put(holder, "mark", null, parts[i]);
      else holder.appendChild(document.createTextNode(parts[i]));
    }
    return holder;
  });
}

function escapeRegex(text) {
  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// One round of the conversation: what you typed, and what came back to it.
//
// Only prompts and the agent's own text. A tool call is not a round and there
// are hundreds of them -- 233 in one measured session -- and they are already
// in the transcript beside this. Thinking is hidden by default, so a row for
// one would point at nothing.
//
// A transcript can open with the agent talking: a session resumed, or one
// read from partway through. That is a round with no prompt of its own.
function rounds() {
  const out = [];
  let here = null;
  for (let at = 0; at < state.turns.blocks.length; at += 1) {
    const block = state.turns.blocks[at];
    if (!block) continue;
    if (block.kind === "prompt") {
      out.push(here = { seq: at, text: block.text, replies: [] });
    } else if (block.kind === "text") {   // a `note` is neither, by design
      if (!here) out.push(here = { seq: at, text: "", replies: [] });
      here.replies.push({ seq: at, text: block.text });
    }
  }
  return out;
}

//: How much of a line to hand the map. It is not where the preview ends --
//: `.filelist .name` clips with an ellipsis, at whatever width the column has
//: been dragged to -- it is only a bound on what is put in the DOM for a
//: reply that may be kilobytes long. It was 44, which is narrower than the
//: column at its default width, so every row ended in a "…" the column had
//: room for and the number did not.
//:
//: The number has to clear what the widest possible column can show, or it
//: is the clip again. Measured at `dragWidth`'s own cap of 700 px, where the
//: name box is 639 px: 49 of the widest glyphs and **176 of the narrowest**.
//: The list is a condensed sans, not a monospace, so the thin end is what
//: sets this -- a first guess of 120 from counting monospace characters
//: would have clipped a line of narrow letters on a wide column, which is
//: the bug this is fixing.
const GLIMPSE = 200;

// The first line with anything on it, short enough to read at a glance.
// Markdown's own marks are taken off the front: a reply that opens with a
// heading or a bullet would otherwise spend its first characters saying so.
function glimpse(text) {
  // Not `split("\n")`: an agent's reply is routinely several kilobytes and
  // this runs for every round and every reply. The first line with something
  // on it is all that can ever be used.
  const found = /^[ \t]*\S.*/m.exec(String(text || ""));
  const first = (found ? found[0] : "").trim()
    .replace(/^(#{1,6}|[-*>]|\d+\.)\s+/, "")
    .replace(/^\*\*(.*?)\*\*/, "$1")
    .replace(/^`(.*?)`/, "$1")
    .trim();
  return first.length > GLIMPSE ? first.slice(0, GLIMPSE - 1) + "…" : first;
}

// The rounds the find box leaves. A round stays when it matches or when one
// of its replies does; under it, the replies that match -- unless the round
// itself matched, in which case the whole of it is what you asked for.
function onlyMatching(all) {
  const has = (text) => String(text || "").toLowerCase().includes(state.find);
  const out = [];
  for (const one of all) {
    const mine = has(one.text);
    const replies = mine ? one.replies : one.replies.filter((r) => has(r.text));
    if (mine || replies.length) out.push({ ...one, replies });
  }
  return out;
}

// The left bar: a round is a folder, the replies to it are what is in it.
// Clicking either goes to that place in the transcript beside it.
//
// It is guarded like every other list on this page, because `patchTranscript`
// calls it on every pushed block -- once a second while an agent works, and
// most of those blocks are tool calls, which are not on this map at all. It
// was rebuilding six hundred rows to draw the same six hundred rows.
function drawTurnList(list, note) {
  const all = rounds();
  const found = state.find ? onlyMatching(all) : all;
  const replies = found.reduce((n, one) => n + one.replies.length, 0);
  const last = found[found.length - 1];
  const tail = last && last.replies.length
    ? last.replies[last.replies.length - 1].seq : -1;
  // `run` first, and it is not optional: a rewritten transcript counts from
  // nought again and can give a map of exactly the same shape -- a `/clear`
  // followed by one reply reads as one round with one reply, which is what
  // the old reading was too. The list then showed the conversation that had
  // just been thrown away. Inside one reading `seq` only grows, so the shape
  // and the last two seqs say the rest.
  if (!fresh(list, "turns", [state.turns.run, state.find, state.turns.at,
                             all.length, found.length, replies,
                             last ? last.seq : -1, tail,
                             // Or folding a round redraws nothing: the shape
                             // of the conversation has not changed, only what
                             // is shown of it. Sorted, so the key is what the
                             // set holds and not the order it was filled in:
                             // folding 1 then 2 and folding 2 then 1 are the
                             // same list, and a spurious redraw is a rebuild
                             // of every row.
                             [...state.turns.shut].sort().join(",")].join("\n"))) {
    return;
  }
  list.replaceChildren();
  if (!found.length) {
    put(list, "div", "nohits",
        state.find ? "Nothing here matches." : "Nothing said yet.");
  }
  for (const one of found) {
    putTurnRow(list, one.seq, glimpse(one.text) || "(no prompt)", true);
    if (state.turns.shut.has(one.seq)) continue;
    for (const reply of one.replies) {
      putTurnRow(list, reply.seq, glimpse(reply.text) || "(no text)", false);
    }
  }
  noteTurns(note, found, replies, all);
}

// A prompt is a folder and a reply is what is in it, so the depth is the one
// bit `mine` already carries.
//
// A round folds shut, and it folds from its icon. The row has two jobs and
// one of them must not be taken by the other: the whole row goes to that
// place in the transcript, which is what the map is for, and the icon alone
// folds -- `ICONS.dirOpen` is what says which way it is, and it is the
// triangle this list does not draw. Folding on any click would mean you could
// not read a round without closing it.
function putTurnRow(list, seq, text, mine) {
  const shut = mine && state.turns.shut.has(seq);
  const button = putListRow(list, { dir: mine, open: mine && !shut,
                                    depth: mine ? 0 : 1,
                                    chosen: seq === state.turns.at,
                                    title: text });
  if (mine) {
    // Said out loud, because a second target on a row nothing else on this
    // page has two of is not something a reader can be expected to find.
    button.setAttribute("aria-expanded", String(!shut));
    button.firstChild.setAttribute(
      "title", shut ? "open this round" : "fold this round away");
  }
  putName(button, text, []);
  button.addEventListener("click", (press) => {
    if (mine && press.target.closest(".icon")) {
      if (shut) state.turns.shut.delete(seq); else state.turns.shut.add(seq);
      redrawMap();
      return;
    }
    goToTurn(seq);
  });
}

// Go to one turn, and mark where you went. The list is the map; the mark is
// what answers a click on a row that was already on screen.
// Draw the map beside the transcript. Three places want it and each paired
// the list with a `.listnote` it fetched itself -- three chances for one of
// them to fetch a different one. `drawTranscript` is the fourth and does not
// come through here, because `split` hands it both nodes already.
function redrawMap(root) {
  const where = root || document;
  drawTurnList(where.querySelector(".filelist.transcript"),
               where.querySelector(".listnote"));
}

function goToTurn(seq) {
  state.turns.at = seq;
  state.turns.goTo = seq;
  const pane = document.querySelector(".turnbody");
  if (!pane || !landOnBlock(pane)) draw();
  else redrawMap();
}

// The way back to the end of a transcript you have scrolled up out of.
//
// A new block carries you along only while you are near the foot, which is
// right -- reading something further up should not be yanked away from. But
// once that has stopped, nothing on the page said how to start again, and on
// a long transcript the scrollbar is a thin sliver.
//
// Built once, by `split`, with the rest of the frame: it hangs off the
// content box rather than off the scroller, because the scroller's children
// are the blocks and `drawTranscript` replaces all of them.
function putToFoot(box) {
  const button = put(box, "button", "verb tofoot", "\u2193 latest");
  button.type = "button";
  button.title = "go to the end, and follow it again";
  button.addEventListener("click", () => {
    const pane = box.children[2];
    pane.scrollTop = pane.scrollHeight;
    button.hidden = true;        // it is the foot now; no need to measure
  });
  return button;
}

// Shown only when it would do something. **Both nodes are handed in.** This
// runs on every scroll event -- dozens of times in one gesture, and again on
// every pushed block -- and `box.querySelector(".tofoot")` is a pre-order
// walk that reaches the button only after crossing the whole transcript.
// On a long one that is on the order of a hundred thousand nodes visited,
// per scroll frame, to set one boolean. Every caller already holds both.
function showToFoot(button, pane) {
  if (button && pane) button.hidden = nearBottom(pane);
}

function drawTranscript(box) {
  const [list, pane, note] = split(box, "transcript", "turnbody");
  const foot = box.children[3];      // built by `split`; see `putToFoot`
  drawTurnList(list, note);
  // The whole transcript, always. The find box narrows the list beside it and
  // nothing else: you keep your place and the conversation around it, which
  // is what a transcript is for. It still marks what matched, because a hit
  // you scroll past unmarked is a hit you miss.
  //
  // No redraw key. The live path is `patchTranscript`, which appends; getting
  // here means a tab switch, a session, or a keystroke in the find box, and
  // every one of those really does want the blocks built again. A key here
  // would also leave the arriving block's `fresh` class on it for ever --
  // drawing a block again is not the block arriving again.
  //
  // Read before the pane is emptied: `replaceChildren` puts the scrollbar
  // back to nought, and the listener below would write that down as the
  // place the reader was.
  const place = state.turns.down;
  if (!pane.dataset.watched) {
    pane.dataset.watched = "1";
    pane.addEventListener("scroll", () => {
      state.turns.down = pane.scrollTop;
      showToFoot(foot, pane);
    });
  }
  pane.replaceChildren();
  state.turns.nodes = [];
  if (!state.turns.blocks.length) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, "Nothing in this transcript yet.");
  } else {
    for (let index = 0; index < state.turns.blocks.length; index += 1) {
      const block = state.turns.blocks[index];
      if (!block) continue;
      const node = blockNode(block, index);
      state.turns.nodes[index] = node;
      markHits(node, state.find);
      pane.appendChild(node);
    }
    // Where the reader was, or the foot of it. A transcript is read from the
    // bottom -- the last thing the agent said is the thing you came for --
    // so that is where a session with no kept place lands.
    if (!landOnBlock(pane)) pane.scrollTop = place || pane.scrollHeight;
  }
  showToFoot(foot, pane);
}

// How much of the conversation the list is showing. It is handed what the
// list already worked out: walking the blocks a second time for two totals
// doubled the cost of every push.
function noteTurns(note, found, replies, all) {
  note.replaceChildren();
  const every = all.reduce((n, one) => n + one.replies.length, 0);
  const what = (n) => n + (n === 1 ? " reply" : " replies");
  put(note, "span", null,
      found.length === all.length && replies === every
        ? found.length + (found.length === 1 ? " round · " : " rounds · ")
          + what(replies)
        : found.length + " of " + all.length + " rounds · "
          + replies + " of " + every + " replies");
}

// Redraw one block where it stands, without touching anything else.
function redrawBlock(index) {
  const node = blockNode(state.turns.blocks[index], index);
  // Only `drawTranscript` used to mark the hits, so expanding a tool result
  // during a search left that one block unhighlighted while every other
  // match kept its `<mark>`.
  markHits(node, state.find);
  const old = state.turns.nodes[index];
  state.turns.nodes[index] = node;
  if (old && old.parentNode) old.replaceWith(node);
  return node;
}

function patchTranscript(indexes) {
  const box = $("content");
  // `state.tab` is set the moment a tab is picked, but the box still holds the
  // tab before it until `load()` comes back. Asking the box, the way `draw()`
  // does, is the difference between appending a turn to the transcript and
  // appending it as a fourth column of the Files tab.
  if (state.tab !== "transcript" || box.dataset.tab !== "transcript") return;
  const pane = box.querySelector(".turnbody");
  const list = box.querySelector(".filelist.transcript");
  if (!pane || !list || !state.turns.nodes) return;
  // The list is a map of the whole conversation, so a new block changes it
  // whatever the find box holds. It is cheap: a row per prompt and reply.
  redrawMap(box);
  if (!state.turns.nodes.length) { drawTranscript(box); return; }
  const stick = nearBottom(pane);
  for (const index of indexes) {
    if (index < state.turns.nodes.length) {
      redrawBlock(index);
    } else {
      // Arriving, rather than being drawn again. This is the only place a
      // block is new: a full redraw builds the whole history, and a history
      // that slid in block by block would be a page having a fit.
      const node = blockNode(state.turns.blocks[index], index);
      node.classList.add("fresh");
      markHits(node, state.find);
      state.turns.nodes[index] = node;
      pane.appendChild(node);
    }
  }
  if (!landOnBlock(pane) && stick) pane.scrollTop = pane.scrollHeight;
  // A block arriving makes the transcript taller, so a reader who was at the
  // foot and is no longer carried there has somewhere to go back to.
  showToFoot(box.children[3], pane);
}

// Three places show how far a file moved. They say it the same way.
function putCounts(parent, one) {
  if (one.added) put(parent, "span", "plus", "+" + one.added);
  if (one.removed) put(parent, "span", "minus", "−" + one.removed);
  return parent;
}

function drawTool(parent, block, index) {
  const open = state.turns.open.has(index);
  const line = put(parent, "button", "tool" + (block.failed ? " failed" : ""));
  line.type = "button";
  put(line, "span", "caret", block.result ? (open ? "▾" : "▸") : " ");
  put(line, "span", "name", block.tool);
  if (block.target) put(line, "span", "target", block.target);
  putCounts(line, block);
  if (block.result && !open) {
    const head = block.result.split("\n")[0];
    if (head) put(line, "span", "target", head.slice(0, 60));
  }
  line.addEventListener("click", () => {
    if (!block.result) return;
    if (state.turns.open.has(index)) state.turns.open.delete(index); else state.turns.open.add(index);
    redrawBlock(index);        // this line only; the rest of the tab stays put
  });
  if (open && block.result) put(parent, "div", "tool-result", block.result);
}

// --- the Files tab ----------------------------------------------------------

// Both split tabs keep their two columns and rebuild a column only when what
// it shows has changed. The box used to be emptied on every poll, which threw
// away the reader's place in the document every time the agent touched some
// other file — and the keys that guarded against that lived in `state`, where
// nothing kept them in step with the DOM. The DOM remembers instead.
// One find box, moved to where it is used: above the file list on a tab that
// has one, and in the tab strip for the transcript. Two boxes would mean two
// values to keep in step, and `/` would have to guess which one it meant.
// It is only ever moved when its parent is wrong, so typing does not blur it.
function homeFind(where) {
  const box = $("find");
  if (box.parentNode !== where) where.appendChild(box);
}

function split(box, tab, bodyClass) {
  if (box.dataset.tab !== tab) {
    homeFind($("findhome"));   // it may be inside what is about to be cleared
    box.replaceChildren();
    box.dataset.tab = tab;
    box.dataset.listKey = "";
    box.dataset.bodyKey = "";
    const side = put(box, "div", "side");
    put(side, "div", "findslot");
    put(side, "div", "listnote");    // how many, or why there are none
    // Only the Files tab's list is windowed, and it is the only one whose
    // rows are all one height. A diff row carries a second line of counts, so
    // the arithmetic would not hold there — the tabs share the frame, not the
    // list. The window follows the scrollbar, which is the only thing that
    // moves it, so it is watched rather than redrawn from the top each time.
    const windowed = tab === "files";
    // The tab's own name as a second class, so a tab can style its list
    // without a class name of its own to keep in step with this one.
    const list = put(side, "div",
                     "filelist " + tab + (windowed ? " fixed" : ""));
    if (windowed) list.addEventListener("scroll", () => fillList(list));
    // Under the list and pinned there, for what must stay in reach however
    // far the list scrolls. The count strip above it is one clipped line.
    put(side, "div", "sidefoot");
    dragWidth(put(box, "div", "grip"), "--side-w", 150, 700);
    put(box, "div", bodyClass);
    // The Transcript tab's way back to the end, built here with the rest of
    // the frame. It cannot live inside the pane -- `drawTranscript` replaces
    // every child of that -- and building it in `drawTranscript` instead put
    // half of this box's positional contract in another function. It is a
    // branch here for the same reason `windowed` is: one tab wants it, and
    // the frame is where the tab's parts are built.
    if (tab === "transcript") putToFoot(box);
  }
  const side = box.firstChild;
  homeFind(side.firstChild);
  // By position, so that adding a part above does not silently renumber the
  // rest: findslot, count, list, foot.
  // And by position on this side too, not `box.lastChild`: the Transcript
  // tab's button is built above as `box.children[3]`, so the last child is
  // that button rather than the pane.
  return [side.children[2], box.children[2], side.children[1], side.children[3]];
}

// Is the open comment box inside this node? Both row tabs are rebuilt from an
// answer the poll replaces every couple of seconds, and a rebuild under an
// open box would take the text with it and move the code the comment is
// about.
//
// `state.writing` alone says only that a box is open somewhere. One opened on
// the Diff tab then froze the Files tab, which had no box on screen to close:
// the pane kept drawing a file the reader had already left, and only going
// back or reloading got it moving again. So the question is asked of the DOM,
// which knows where the box actually is.
function writingIn(node) {
  return state.writing !== null && node.querySelector(".commentbox") !== null;
}

// `redrawCode` clears `bodyKey`, which is how the box's own open and close get
// through this.
function holdingText(box) {
  return writingIn(box) && box.dataset.bodyKey;
}

function fresh(box, which, key) {
  if (box.dataset[which] === key) return false;
  box.dataset[which] = key;
  return true;
}

// --- finding a file by typing ----------------------------------------------

// Every row is the same height, so where you are in the list is arithmetic
// rather than a measurement, and only the rows on screen have to exist. Two
// spacers stand in for the rest and hold the scrollbar where it belongs.
// Ten thousand matches then cost the same as ten, and no answer has to be cut
// short to keep the tab quick.
const ROW_H = 28;
const ROWS_SHOWN = 80;      // a tall screenful, and some either side

// Which files are Markdown, and so get rendered rather than shown as they are.
const MARKDOWN = /\.(md|markdown)$/i;

// These lead the list. They say what the work is.
const PINNED = ["PLAN.md", "CLAUDE.md", "README.md"];

// The letters you type have to turn up in the name in that order, but they do
// not have to be next to each other: `tsfi` finds `tests/test_files.py`. This
// is what a file picker in an editor does, and typing three letters beats
// scrolling a list every time.
//
// The score decides the order. A run of letters counts for much more than the
// same letters scattered, the start of a path segment or a word counts extra,
// and so does the file's own name over the directories above it.
// `slack` is how many letters of the query may simply not be there. It is for
// file names, where one wrong character should not hide the file you meant. It
// is not for the session filter: that haystack is a short line of text, and
// forgiving a letter there matches half the list.
function fuzzy(text, query, slack = 0) {
  const lower = text.toLowerCase();
  const at = [];
  let score = 0;
  let from = 0;
  let run = 0;
  let missed = 0;
  const base = lower.lastIndexOf("/") + 1;
  for (const want of query) {
    const found = lower.indexOf(want, from);
    if (found < 0) {
      if (++missed > slack) return null;
      score -= 120;              // far more than any bonus below can give back
      run = 0;
      continue;
    }
    run = (found === from && at.length) ? run + 1 : 0;
    score += 10 + run * 14;
    const before = found ? lower[found - 1] : "/";
    if ("/-_. ".includes(before)) score += 10;
    if (found >= base) score += 6;
    score -= Math.min(found - from, 12);      // letters it had to step over
    at.push(found);
    from = found + 1;
  }
  return { score: score - lower.length / 50, at };
}

// What a path is matched against: the name, unless you typed a slash.
//
// Matching the whole path let the letters of "MetricsBuilder" land across four
// directory names and a filename — 71 characters apart, in
// `.../odin/agent/metrics/jmx/MBeanSubscriptionBuilder.java` — while the file
// actually wanted did not come back at all. Scattered over a long path, a
// subsequence means nothing. Scattered over a name, it means what you meant.
// A slash in the query says you are thinking about where the file is, and then
// the whole path is fair game.
//: How far apart the letters of a query may sit when it matches a directory
//: rather than a name. 71 characters for a 14-letter query was the nonsense;
//: `libcorrelation` sitting whole inside one directory name is the point.
const TIGHT = 2.5;

function findPath(path, query) {
  // "MetricsBuilder" has an `s` that `MetricBuilder.h` does not, and hiding
  // the file you meant over one character is worse than showing it a little
  // lower down. A short query gets no such forgiveness: there is nothing left
  // of "cfg" once a letter goes.
  const slack = query.length >= 5 ? 1 : 0;
  if (query.includes("/")) return fuzzy(path, query, slack);
  const cut = path.lastIndexOf("/") + 1;
  const named = fuzzy(path.slice(cut), query, slack);
  if (named) {
    // The name is what you were looking for, so it outranks any directory.
    return { score: named.score + 200,
             at: named.at.map((where) => where + cut) };
  }
  // Not in the name, so a directory may be what you meant — `libcorrelation`
  // names a folder, not a file. Only the directories are searched: the name
  // has just been rejected, and scanning it again for every one of fifty
  // thousand paths was most of a keystroke. Only when the letters sit close
  // together, too: spread across four directory names they mean nothing.
  if (!cut) return null;                 // nothing but a name to search
  const wide = fuzzy(path.slice(0, cut), query, slack);
  if (!wide) return null;
  const span = wide.at[wide.at.length - 1] - wide.at[0] + 1;
  return span <= query.length * TIGHT ? wide : null;
}

// --- the tree ---------------------------------------------------------------

// Every directory, with what it holds. One pass over the names, which arrive
// in name order, so each directory's children come out in order too. It is
// built when the names move and not again: a repository of fifty thousand
// files costs about forty milliseconds here, and nothing per draw.
function buildTree(names, skipped) {
  const dirs = new Map([["", { dirs: [], files: [] }]]);
  // Each missing level is made and linked into the one above it, once. A loop
  // that made the parent itself instead stopped on its own next turn, and
  // every directory but the deepest was left hanging off nothing.
  const folder = (path) => {
    let one = dirs.get(path);
    if (one) return one;
    dirs.set(path, one = { dirs: [], files: [] });
    const cut = path.lastIndexOf("/");
    folder(cut < 0 ? "" : path.slice(0, cut)).dirs.push(path);
    return one;
  };
  for (const path of names) {
    const cut = path.lastIndexOf("/");
    folder(cut < 0 ? "" : path.slice(0, cut)).files.push(path);
  }
  // A directory that was not walked holds no name, so nothing above would
  // make it -- and a folder the reader cannot see is the same silence as
  // one that says nothing. It is made here, empty, and the row says why.
  for (const path of skipped || []) folder(path);
  return dirs;
}

// Every directory a path sits under, innermost first. Two walks wanted the
// same index arithmetic, and the two awkward parts of it — the `> 0`, which
// keeps the root out, and stepping back from `at - 1` — are worth having once.
function* ancestors(path) {
  let at = path.lastIndexOf("/");
  while (at > 0) {
    yield path.slice(0, at);
    at = path.lastIndexOf("/", at - 1);
  }
}

// The directories holding something the agent touched, so a closed one can
// still say there is a change inside it.
function dirsWithChanges(changed) {
  const marked = new Set();
  for (const path of changed.keys()) {
    for (const above of ancestors(path)) {
      if (marked.has(above)) break;   // and so is everything above it
      marked.add(above);
    }
  }
  return marked;
}

// Which directories stand open. The ones holding a change open themselves,
// because a closed tree cannot answer what the agent just did, and that is
// the question this tool exists to answer. What the reader opens or closes
// wins over that, so the tree never fights the hand on it.
function openDirs() {
  const open = new Set(state.files.marked);
  for (const [path, wanted] of state.files.dirs) {
    if (wanted) open.add(path); else open.delete(path);
  }
  return open;
}

// One directory's files, in the order they are read: the named files first,
// then whatever changed with the newest first, then the rest by name. The
// three tiers live inside the tree rather than in a section above it, so no
// file is ever listed twice.
function dirFiles(files) {
  if (!files.length) return files;
  const named = files.filter((path) => PINNED.includes(path));
  const moved = files.filter((path) => !PINNED.includes(path) &&
                                       state.files.changed.has(path));
  if (!named.length && !moved.length) return files;
  named.sort((a, b) => PINNED.indexOf(a) - PINNED.indexOf(b));
  moved.sort((a, b) => state.files.changed.get(b) - state.files.changed.get(a));
  const lifted = new Set([...named, ...moved]);
  return named.concat(moved, files.filter((path) => !lifted.has(path)));
}

// The rows a tree shows, in the order they are drawn. Only what is open is
// walked, so a closed repository costs its top level and no more.
//
// A row carries where its name starts, not the name: fifty thousand rows are
// built to draw eighty, so the work of cutting one up belongs where it is
// drawn.
function treeRows(dirs, open) {
  const rows = [];
  const walk = (path, depth) => {
    const one = dirs.get(path);
    if (!one) return;
    const from = path ? path.length + 1 : 0;
    for (const child of one.dirs) {
      // A directory nobody walked cannot open: there is nothing behind it,
      // and a folder that opens onto nothing reads as a broken one.
      const shut = state.files.skipped.has(child);
      const wide = !shut && open.has(child);
      rows.push({ path: child, from, depth, dir: true, open: wide,
                  skipped: shut });
      if (wide) walk(child, depth + 1);
    }
    // Only a directory holding something named or changed needs its files put
    // in order; everywhere else they are already in the order they arrived,
    // and `state.files.marked` says which those are. It halves a fully opened tree.
    const files = (path && !state.files.marked.has(path))
      ? one.files : dirFiles(one.files);
    for (const file of files) rows.push({ path: file, from, depth });
  };
  walk("", 0);
  return rows;
}

// --- go to file --------------------------------------------------------------
//
// What you type opens a list under the box; picking one opens that file and
// shows it in the tree. The tree itself never moves, which is the point: it
// is the answer to "where does this sit", and filtering it away was hiding
// that answer as a way of asking for it.

const GOTO_SHOWN = 40;

// Which row the keys are on. It is the index into what was last drawn, so it
// goes back to the top whenever the query does.
let goToAt = 0;

function goToHits() {
  return pick(state.files.places).slice(0, GOTO_SHOWN);
}

// The list under the box, rebuilt as you type. It lives inside the find slot
// so that `split`'s children keep their positions, and `homeFind` keeps the
// input first because it only moves the box when its parent is wrong.
function drawGoTo(slot) {
  let popup = slot.querySelector(".goto");
  if (!state.find || state.tab !== "files") {
    if (popup) popup.remove();
    // And forget what was drawn, or typing the same query again would match
    // the key and draw nothing at all.
    slot.dataset.goto = "";
    return;
  }
  if (!fresh(slot, "goto", state.find + "\n" + state.files.tag)) return;
  const found = goToHits();
  goToAt = 0;
  if (popup) popup.remove();
  popup = put(slot, "div", "goto");
  if (!found.length) {
    put(popup, "div", "nohits", "no name matches");
    return;
  }
  found.forEach((hit, at) => {
    const row = put(popup, "button", at === goToAt ? "chosen" : "");
    row.type = "button";
    row.title = hit.one;
    putIcon(row, state.files.known.has(hit.one) ? "file" : "dir");
    putName(row, hit.one, hit.at);
    // `mousedown`, not `click`: the box loses focus first otherwise, and the
    // blur that follows would take the list away before the click landed.
    row.addEventListener("mousedown", (press) => {
      press.preventDefault();
      goTo(hit.one);
    });
  });
}

// Open what was picked, and show where it sits. A directory has nothing to
// read, so it is only revealed.
function goTo(path) {
  if (state.files.known.has(path)) chooseFile(path);
  revealInTree(path);          // clears the box, which closes this list
  $("find").blur();
}

// `j`/`k` belong to the sidebar, so this is the arrows and Enter only.
function goToKey(press) {
  const slot = $("find").parentNode;
  const popup = slot.querySelector(".goto");
  const rows = popup ? [...popup.querySelectorAll("button")] : [];
  if (!rows.length) return false;
  if (press.key === "ArrowDown" || press.key === "ArrowUp") {
    goToAt = (goToAt + (press.key === "ArrowDown" ? 1 : rows.length - 1))
      % rows.length;
    rows.forEach((row, at) => row.classList.toggle("chosen", at === goToAt));
    rows[goToAt].scrollIntoView({ block: "nearest" });
    return true;
  }
  if (press.key === "Enter") {
    goTo(rows[goToAt].title);
    return true;
  }
  return false;
}

// What the left column shows. Always the tree: typing opens a list under the
// box (see `drawGoTo`) rather than taking the tree apart. Hiding the tree was
// hiding the answer to "where does this file sit" as a way of asking it.
function listRows() {
  return treeRows(state.files.tree, openDirs());
}

// Everything whose path matches what is typed, in the order it came, each one
// with where the letters landed. `pathOf` says how to get a path out of an
// item, because a file list holds names and a diff holds files. Named `hits`
// because `matches` is the transcript's and `matching` is the tree's, and a
// third word for the same idea in one scope is how one of them gets shadowed.
//
// Every list on screen goes through here, so `findPath` is called in one place
// and the lists cannot come to disagree about what a query means. They did:
// two of them threw the matched letters away and called `findPath` a second
// time, per row, to get them back.
//
// The order is the caller's. A diff's order is git's and must not be
// shuffled; a file list wants the best match first, which is what `pick` adds.
function hits(items, pathOf) {
  const found = [];
  for (const one of items) {
    const hit = findPath(pathOf(one), state.find);
    if (hit) found.push({ one, at: hit.at, score: hit.score });
  }
  return found;
}

// The files a query finds, best match first. It is only ever called with one.
//
// It runs over every name the worktree holds, not over a slice of them. The
// first version searched the first five thousand of 52,799, so typing
// `libcorrelation` found 16 files and missed more than a thousand — a wrong
// answer that looked exactly like a right one.
function pick(names) {
  const found = hits(names, (name) => name);
  found.sort((a, b) => b.score - a.score);
  return found;
}

// The name, with the letters that matched picked out. Every piece is a text
// node, so a file name is never read as markup.
function putName(parent, text, at) {
  const node = put(parent, "span", "name");
  let done = 0;
  for (const index of at) {
    if (index > done) {
      node.appendChild(document.createTextNode(text.slice(done, index)));
    }
    put(node, "b", "lit", text[index]);
    done = index + 1;
  }
  if (done < text.length) {
    node.appendChild(document.createTextNode(text.slice(done)));
  }
  return node;
}

// One window of rows, built where the scrollbar stands. `list.found` holds
// what the list is showing: matching every name again on each scroll event
// would cost twenty milliseconds a frame in a large repository.
function fillList(list) {
  if (!list.found) return;        // a scroll before the first draw
  const found = list.found;
  // Clamped to the list as it is now. A scrollbar left deep in ten thousand
  // names, and then a query that matches one, would otherwise put the window
  // past the end and show nothing at all.
  const first = Math.min(Math.max(0, Math.floor(list.scrollTop / ROW_H) - 8),
                         Math.max(0, found.length - 1));
  const last = Math.min(found.length, first + ROWS_SHOWN);
  if (list.dataset.first === String(first) &&
      list.dataset.last === String(last)) return;
  list.dataset.first = String(first);
  list.dataset.last = String(last);
  list.replaceChildren();
  put(list, "div", "gap").style.height = first * ROW_H + "px";
  for (let at = first; at < last; at += 1) drawRow(list, found[at]);
  put(list, "div", "gap").style.height = (found.length - last) * ROW_H + "px";
}

// One row: a directory that opens, or a file that is read.
// One row of a list on the left: a button with an icon and a name, stepped
// in by its depth. The file tree and the transcript's map are the same row,
// and the step between levels is a number that must not be in two places.
//
// No triangle in front of a folder. It stood where nothing stood on a file
// row, so a folder's name sat 9 px right of a file's at the same depth -- and
// a file one level deeper then lined up exactly with the folder above it,
// which is the one thing a tree must never do. The open folder icon says what
// the triangle said.
function putListRow(list, { dir, open, chosen, touched, depth, title }) {
  const button = put(list, "button",
                     (dir ? "dir" : "") + (chosen ? " chosen" : "")
                     + (touched ? " touched" : "") + (open ? " open" : ""));
  button.type = "button";
  button.title = title;
  button.style.paddingLeft = (14 + depth * 13) + "px";   // the tree's step
  putIcon(button, dir ? (open ? "dirOpen" : "dir") : "file");
  return button;
}

function drawRow(list, row) {
  const dir = !!row.dir;
  const button = putListRow(list, {
    dir,
    open: !!row.open,
    chosen: row.path === state.files.at,
    touched: dir ? state.files.marked.has(row.path)
                 : state.files.changed.has(row.path),
    depth: row.depth,
    title: row.path,
  });
  // A row shows one segment of a path. The letters that matched were found
  // in the whole of it, so a letter found in a directory is picked out on
  // that directory's own row and nowhere else. Cutting the name and the
  // letters up happens here, for the eighty rows that are drawn, not for the
  // fifty thousand that are built.
  const name = row.path.slice(row.from);
  const at = [];
  for (const where of row.hit || []) {
    if (where >= row.from && where - row.from < name.length) {
      at.push(where - row.from);
    }
  }
  putName(button, name, at);
  if (row.skipped) {
    // Where the reader is looking, rather than in a strip at the foot: this
    // is a fact about this folder, and the question it answers -- "where is
    // the rest of it?" -- is asked here.
    put(button, "span", "toobig", "not listed");
    button.title = row.path + " holds more than " + state.files.ignoredMax
                 + " files, so it is left out. Opening one in it still works.";
  }
  button.addEventListener("click", () => {
    if (!dir) { chooseFile(row.path); return; }
    // A folder that was not walked has nothing to open, so the click does
    // the other thing a click on a folder does: it marks where you are.
    if (row.skipped) { state.files.at = row.path; draw(); return; }
    state.files.dirs.set(row.path, !row.open);
    draw();
  });
}

// What the list is showing, and why it is showing that much of it. It counts
// files, never the rows: a tree row can be a directory or a heading.
function noteList(note, found) {
  note.replaceChildren();
  // Rows are not files: typing leaves a tree, and a tree has directories in
  // it. Counting rows made one match in a big repository read "5 of 52799".
  const hits = found.reduce((n, row) => n + (row.dir ? 0 : 1), 0);
  if (state.files.failed) {
    // git failing and a worktree holding nothing look the same and mean
    // opposite things, so the strip says which one this is.
    put(note, "span", null, "git did not answer");
  } else if (state.files.cut) {
    put(note, "span", null, state.files.total + " files, more than one list"
        + " can answer for");
  } else {
    countNote(note, state.files.total);
  }
}

// "1 file" or "N files", in the one place that spells it.
function countNote(note, many) {
  put(note, "span", null, many + (many === 1 ? " file" : " files"));
}

// --- a file too long to draw whole ------------------------------------------
//
// Measured on a file of 76,000 short lines: 306,000 nodes and about a second
// to build them, and the colouring another second and a quarter on top. That
// is paid again every time the agent saves the file you are reading. Above
// CODE_WHOLE lines only the rows on screen are built, which is a screenful of
// work whatever the file's length, and the file is not coloured: the
// highlighter has to be given the whole file to be right about it, and cutting
// its answer into 76,000 line fragments costs more than the rows did.
//
// Below CODE_WHOLE nothing here runs. An ordinary file is drawn whole, so the
// browser's own find still sees all of it and a copy is the whole file. That
// is worth keeping, and it is why this starts at a length rather than always.
// Measured in a real browser, drawing whole and painting: 2,500 lines cost
// 144 ms, 5,000 cost 280 ms, 10,000 cost 774 ms and 40,000 cost 2.8 s — and
// that is paid again on every save of the file being read. Five thousand
// covers a hand-written source file, which is what a reader is looking at.
//
// A `let`, like `BIG_LINES`, and for the same reason: how much DOM is too
// much is the page's own business, and a test can say so without having to
// build a file of five thousand lines to ask the question.
let CODE_WHOLE = 5000;
const CODE_H = 21;          // one row, exactly. `.dlines` sets the same number
const CODE_SHOWN = 160;     // a tall screenful, and some either side

// A line with a comment under it is taller than a row, and a row's height is
// how the window knows where it is. There are never many, so they are kept one
// by one: measured once the block has been drawn, and guessed until then. A
// guess only moves the scrollbar a little, and it is replaced the first time
// the block is on screen.
const CODE_GUESS = 5 * CODE_H;

// The lines of this file that carry a comment, or a half-written one, with how
// tall each one makes its row. In line order, because both readers below walk
// them from the top.
function tallLines(code) {
  const anchors = new Set(state.review.comments.map((one) => one.anchor));
  if (state.writing !== null) anchors.add(state.writing);
  const tall = [];
  for (const anchor of anchors) {
    const [path, line] = anchor.split("\n");
    if (path !== code.path || line === "0") continue;
    const at = Number(line) - 1;                  // lines are counted from one
    tall.push([at, code.tall.get(at) || CODE_GUESS]);
  }
  return tall.sort((one, two) => one[0] - two[0]);
}

// How tall the first `n` lines are together.
function heightOf(tall, n) {
  let px = n * CODE_H;
  for (const [line, extra] of tall) {
    if (line >= n) break;
    px += extra;
  }
  return px;
}

// Which line stands `y` pixels down. The plain rows are arithmetic; only the
// few that carry a comment have to be counted one at a time.
function lineAt(tall, y) {
  let line = 0;
  let top = 0;
  for (const [where, extra] of tall) {
    const step = (where - line + 1) * CODE_H + extra;
    if (top + step > y) break;
    top += step;
    line = where + 1;
  }
  return line + Math.max(0, Math.floor((y - top) / CODE_H));
}

// One window of rows, built where the scrollbar stands. The two gaps stand in
// for the rows above and below it, so the scrollbar is the length of the whole
// file even though the file is not there.
function fillCode(pane, at = pane.scrollTop) {
  const code = pane.querySelector(".code.windowed");
  if (!code) return;                   // a short file, or another tab's body
  // The window stands still while a comment is being written in it, for the
  // reason the diff stands still: moving it would throw away what is being
  // typed. A box open on some other file or tab is none of its business. A
  // window that has not been drawn yet is drawn all the same — that is the
  // redraw the box itself asked for, the same trick `holdingText` plays.
  if (writingIn(code) && code.dataset.first) return;
  const all = code.lines;
  const tall = tallLines(code);
  // Where the code starts inside the pane, so that how far the reader has
  // scrolled can be read as a line number. The path and the note sit above it.
  const from = code.offsetTop - pane.offsetTop;
  const first = Math.min(
    Math.max(0, lineAt(tall, at - from) - 8),
    Math.max(0, all.length - 1));
  const last = Math.min(all.length, first + CODE_SHOWN);
  if (code.dataset.first === String(first) &&
      code.dataset.last === String(last)) return;
  code.dataset.first = String(first);
  code.dataset.last = String(last);
  // The pane is what scrolls sideways now, and the pane is not rebuilt, so
  // how far along the reader stood carries over on its own.
  code.replaceChildren();
  put(code, "div", "gap").style.height = heightOf(tall, first) + "px";
  fillDiffFile(code, asLines(code.path, all.slice(first, last), first + 1));
  put(code, "div", "gap").style.height =
    (heightOf(tall, all.length) - heightOf(tall, last)) + "px";
  measureTall(code, tall, first, last);
}

// What a comment block actually came out as, kept for the next window. The
// blocks are drawn in line order, so they line up with the lines that have
// one; if they do not, nothing is measured rather than something guessed at.
function measureTall(code, tall, first, last) {
  const blocks = code.querySelectorAll(".onLine");
  const shown = tall.filter(([line]) => line >= first && line < last);
  if (blocks.length !== shown.length) return;
  shown.forEach(([line], at) => code.tall.set(line, blocks[at].offsetHeight));
}

function drawFiles(box) {
  const [list, pane, note] = split(box, "files", "filebody");
  drawGoTo($("find").parentNode);

  // What the list draws is what decides whether it is drawn again: which
  // names there are, which file is open, which carry a dot, and which
  // directories stand open. The names come as `filesTag`, which is the
  // daemon's own hash of them, so this is exact rather than sampled.
  //
  // A pinned file does not move when it changes, so without the changed names
  // in here its dot never appeared — the whole reason this key exists. The
  // mtimes stay out: folding those in re-rendered the open document.
  if (fresh(box, "listKey", JSON.stringify(
      [state.find, state.files.path, state.files.at, state.files.failed,
       state.files.tag, [...state.files.skipped],
       [...state.files.changed.keys()].sort(), [...state.files.dirs]]))) {
    // Built here and not before: with a query typed this is a pass over every
    // name in the repository, and a poll that changes nothing wants none of
    // it.
    const found = listRows();
    list.found = found;
    // A different set of names starts at the top: the best match is the first
    // row, and that is the row you meant. A file being touched, or another
    // one being opened, is not a different set and does not move you.
    const asked = state.find + "\n" + state.files.tag;
    if (list.dataset.asked !== asked) {
      list.dataset.asked = asked;
      list.scrollTop = 0;
    }
    list.dataset.first = "";
    fillList(list);
    noteList(note, found);
  }
  goToInList(list);

  if (holdingText(box)) return;
  if (!fresh(box, "bodyKey", state.files.path + "\n" + state.files.mtime
                           + "\n" + state.files.asText)) return;
  // Where the reader will be. A line that was asked for wins over the place
  // they were in: they asked to be somewhere else.
  const wanted = state.files.goToLine;
  state.files.goToLine = 0;
  // Where the reader is in this file, whether they scrolled there a moment
  // ago or left it on their last visit to this session. `forgetFile` puts it
  // back to nought, which is what makes a different file open at its top.
  const place = wanted ? 0 : state.files.down;
  pane.replaceChildren();
  pane.dataset.file = String(state.files.path);
  if (!state.files.path) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, state.files.failed
      ? "git did not answer, so there is no list yet. It is tried again in a"
        + " few seconds."
      : state.files.names.length
      ? "Pick a file on the left, or type to find one."
      : "This worktree holds no file that git knows about.");
    return;
  }
  const isDoc = MARKDOWN.test(state.files.path) && !state.files.binary;
  // Split once. The header wants to know how long the file is and so does the
  // body, and two copies of that arithmetic are two copies that can drift —
  // the one that decides whether the wrap control does anything, and the one
  // that decides whether it could.
  const asCode = !state.files.binary && !(isDoc && !state.files.asText);
  const body = asCode ? state.files.text.replace(/\n$/, "") : "";
  const rows = asCode ? linesOf(body) : null;
  const windowed = !!rows && rows.length > CODE_WHOLE;
  const where = putWhere(pane, state.files.path);
  if (isDoc) putAsText(where);
  putAbout(where, rows, windowed);
  // Everything below the header, and the only thing that scrolls. It is built
  // with the file, so the listener a windowed file needs goes on with it.
  const view = put(pane, "div", "filescroll");
  // Where the reader is, written down as they move. One writer, and it is
  // the scrollbar: asking the DOM from `showTab` and again from `savePlace`
  // meant two writers with different fallbacks, and the second one wrote the
  // outgoing session's place over the place just restored for the new one.
  //
  // Whose scrollbar, though. This node is built for one session and outlives
  // the moment another is chosen -- leaving the Files tab does not rebuild
  // it -- so a scroll event still queued when `choose` runs arrives after
  // `usePlace` has put the new session's place back, and writes the old
  // session's number over it. Caught as a test that only failed under load,
  // which is what that ordering needs.
  const mine = state.chosen;
  view.addEventListener("scroll", () => {
    if (state.chosen !== mine) return;
    state.files.down = view.scrollTop;
    if (windowed) fillCode(view);
  });
  if (state.files.binary) {
    putMedia(view, state.files.path, state.files);
  } else if (isDoc && !state.files.asText) {
    markdown(view, state.files.text);
  } else {
    // One row per line, through the same renderer the diff uses, so a file
    // gets the numbers, the `+` and the comments the diff already had — and a
    // comment on line 42 lands on the same anchor whichever tab wrote it.
    //
    // The rows and the highlighter are given the very same text, so the two
    // can never disagree about how many lines there are. Both were worked out
    // above, because the header asks the same question.
    if (windowed) {
      // Only for a file that really is too long to draw. Said plainly,
      // because both of these are things the reader would otherwise go
      // looking for and not find.
      put(view, "div", "note", rows.length + " lines — too many to draw at"
          + " once. Only the ones on screen are here, so this file has no"
          + " colour and your browser's own find will not see the rest.");
    }
    const code = put(view, "div", "code" + (windowed ? " windowed" : ""));
    code.dataset.path = state.files.path;
    if (windowed) {
      code.lines = rows;
      code.path = state.files.path;
      code.tall = new Map();
      // Where the reader will be once `place` is put back, not where an
      // emptied pane says they are: the rows have to be there before the
      // scrollbar can reach them.
      fillCode(view, wanted ? lineTop(view, code, wanted) : place);
    } else {
      fillDiffFile(code, asLines(state.files.path, rows));
      paintLines(code, state.files.path, body, state.files.lang);
    }
  }
  // Said outright, rather than only when there is a place to go back to.
  // `view` is built with the file, so a different file already starts at
  // nought -- the pane used to be the scroller, it outlived the file in it,
  // and a `replaceChildren` does not reliably put its bar back.
  if (wanted) requestAnimationFrame(() => showLine(view, wanted));
  else requestAnimationFrame(() => {
    // A place waits for the file to be there. The first draw after a session
    // is chosen has no text yet, and setting the bar against nothing would
    // scroll to nought and then be written back as the place.
    if (place && view.scrollHeight <= view.clientHeight) return;
    view.scrollTop = place;
  });
}

// A file with no text in it. A picture, a video or a sound is shown as it is;
// anything else really has nothing to show, and says so.
//
// What kind of file this is comes from the daemon, in the same answer as the
// text: `found.shown` is the type it will be served as, or empty. The list
// lives there, with the route that has to enforce it. A copy of it here would
// be a second list in a second language, and a mismatch is silent either way
// round -- a picture that never arrives, or a file that is never offered.
//
// Everything it needs is an argument. The Files tab and an untracked file on
// the Diff tab are the same question, and a screenshot an agent has just
// taken is an untracked file.
function putMedia(parent, path, found) {
  if (!found.shown) {
    put(parent, "div", "note", "Binary file. There is nothing to show.");
    return;
  }
  if (found.oversize) {
    put(parent, "div", "note", sizeOf(found.size) + " — too big to show here.");
    return;
  }
  const kind = found.shown.split("/")[0];       // image, video or audio
  const box = put(parent, "div", "media");
  const node = document.createElement(kind === "image" ? "img" : kind);
  // The mtime is in the address, so a file the agent has just written is a
  // different address and is fetched again. This is the one answer the
  // daemon lets a browser keep, and that is why.
  node.src = apiUrl(state.chosen, "raw", "?path=" + encodeURIComponent(path)
                                         + "&at=" + found.mtime);
  if (kind === "image") node.alt = path;
  else node.controls = true;
  // A type the browser will not take, or a file that went away between the
  // listing and the fetch. Saying so beats a broken picture.
  node.addEventListener("error", () => {
    box.replaceChildren();
    put(box, "div", "note", "This one did not come back, or your browser"
        + " cannot show it.");
  });
  box.appendChild(node);
}

// How far down the pane a line stands. Only a windowed file can answer before
// it is drawn, because only there is a row's height a fixed number.
function lineTop(pane, code, line) {
  const from = code.offsetTop - pane.offsetTop;
  // Not `(line - 1) * CODE_H`: a commented line is taller than a row, and
  // `fillCode` lays the file out knowing that. With fifteen comments above it
  // the target landed 1600 px below a 760 px pane — off screen, in a jump
  // whose whole point is to put it on screen. `heightOf` is that layout.
  const above = heightOf(tallLines(code), line - 1);
  return Math.max(0, from + above - CODE_H * 3);
}

// Put a line on screen, whichever way the file is drawn. A windowed file is
// arithmetic; a file drawn whole has the row itself to scroll to.
function showLine(pane, line) {
  const code = pane.querySelector(".code");
  if (!code) return;
  if (code.classList.contains("windowed")) {
    pane.scrollTop = lineTop(pane, code, line);
    fillCode(pane);
    return;
  }
  const row = code.querySelectorAll(".dline")[line - 1];
  if (row) row.scrollIntoView({ block: "center" });
}


// An empty Files tab. One place, so that choosing a session, choosing a file
// and starting up cannot drift apart about what "nothing is open" means.
// The Transcript tab's whole state, so that choosing a session is one
// assignment rather than six that could forget the seventh -- which is the
// reason `blankFiles` exists, in a second place.
//
// The blocks are in here too. Nothing outside this tab reads them: the
// sidebar's counts come from the session rows, and the daemon pushes blocks
// at a browser without asking which tab it is on.
function blankTurns() {
  return {
    blocks: [],         // what the daemon has pushed, by seq
    nodes: [],          // the node drawn for each one, so one can be redrawn
    run: -1,            // which reading of this transcript those are from
    open: new Set(),    // tool blocks the reader expanded
    shut: new Set(),    // rounds the reader folded shut on the map
    goTo: null,         // a block a link asked for, until it is on screen
    at: null,           // the block the list marks: the last place you went
    down: 0,            // how far down the transcript you were
  };
}

function blankFiles() {
  return {
    names: [],          // every path in the worktree, in the order sent
    known: new Set(),   // the same paths, for asking whether one is still there
    places: [],         // the names and the directories, for "go to file"
    tree: new Map(),    // every directory, with what it holds
    marked: new Set(),  // the directories holding something that changed
    dirs: new Map(),    // the ones the reader opened or closed by hand
    changed: new Map(), // the ones git says the agent touched, and when
    total: 0,           // how many the worktree holds
    cut: false,         // more than the daemon will send
    failed: false,      // git did not answer; "no files" would lie
    // Ignored directories the daemon declined to walk, and the number it
    // declined them at. They hold nothing, so the tree is told their names
    // and the row says why it cannot be opened.
    skipped: new Set(),
    ignoredMax: 0,
    tag: "",            // the daemon's name for the listing we hold
    path: null,         // the file it shows
    // The row the list marks: the last place the reader went. Usually the
    // open file, and a directory when they asked for one by name or by
    // clicking a part of the path above the file. Marking only the open file
    // meant clicking a part of a path that was already on screen answered
    // with nothing at all.
    at: null,
    text: "",
    binary: false,
    // What the daemon will serve this one as, when the page may show it as
    // it is -- `image/png`, and so on -- and whether it is past the cap. The
    // list is the daemon's; see `putMedia`.
    shown: "",
    oversize: false,
    lang: "",           // what `file` made of it, when the name said nothing
    mtime: 0,           // which version of that text is loaded
    size: 0,            // its bytes on disk, which the decoded text does not say
    // Markdown reads as Markdown, which has no lines to comment on. This
    // turns it back into the rows every other file gets. It is remembered
    // across files, because a reader who wants to review one document
    // usually wants to review the next one too.
    asText: false,
    goTo: null,         // a path the list has been asked to move to
    goToLine: 0,        // and the line in it the body should show, if any
    // How far down the open file the reader was, kept across a tab switch
    // and across a visit to another session. Put back once, when there is
    // something under the scrollbar to put it back into.
    down: 0,
  };
}

// --- how a file is drawn -----------------------------------------------------
//
// Two choices the reader makes about reading, not about a session: how wide a
// tab is, and whether a long line wraps. They live in this browser, like the
// theme, because they are about this screen and these eyes. No config file:
// `PLAN.md` rules one out, and a control you can see beats a setting you
// cannot.

const TAB_WIDTHS = [2, 4, 8];
const READING_KEY = "wostuast-reading";

// Both live on the root element, which is then the only copy — the theme's
// pattern, and for the same reason: the cascade does the work, so neither
// control has to rebuild anything to be obeyed.
function readingNow() {
  const root = document.documentElement;
  const tab = Number(root.style.getPropertyValue("--tab-w"));
  return { tab: TAB_WIDTHS.includes(tab) ? tab : 4,
           wrap: root.dataset.wrap === "yes" };
}

function applyReading(next) {
  const root = document.documentElement;
  root.style.setProperty("--tab-w", String(next.tab));
  root.dataset.wrap = next.wrap ? "yes" : "no";
}

function keepReading(next) {
  applyReading(next);
  try { localStorage.setItem(READING_KEY, JSON.stringify(next)); }
  catch (error) { }              // it still applies; it just is not remembered
}

function recallReading() {
  let held = null;
  try { held = JSON.parse(localStorage.getItem(READING_KEY) || "null"); }
  catch (error) { held = null; } // a private window, or something else's key
  // Storage is not a place to trust blindly, the same rule a review keeps.
  // Whatever it did not answer for, the default stands — and the default is
  // applied either way, so the gutter and the label cannot disagree.
  const shape = held && typeof held === "object" ? held : {};
  applyReading({ tab: TAB_WIDTHS.includes(shape.tab) ? shape.tab : 4,
                 wrap: shape.wrap === true });
}

// How big a file is, in the units a person reads. Bytes on disk, which is not
// what the text length says once it has been decoded or cut.
function sizeOf(bytes) {
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + " KB";
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

// `21 Sep 07:20`, which is short enough to sit in a header and exact enough
// to tell two saves apart. The day is always in it: a file's mtime is read
// against other files' mtimes, not against the time of day.
function whenOf(seconds) {
  if (!seconds) return "";
  const at = new Date(seconds * 1000);
  return at.getDate() + " " + MONTHS[at.getMonth()] + " " + clock(seconds);
}

// The path of the open file, one clickable piece per part of it, and still
// one string to select and copy: the separators are text nodes and nothing in
// here is a block, so a selection across the whole line yields the path.
//
// Clicking a part is how you find where a file sits. `libcorrelation` is a
// directory somewhere in fifty thousand rows, and scrolling to it by hand is
// not something anyone does twice.
function putWhere(pane, path) {
  const where = put(pane, "div", "where");
  const crumbs = put(where, "span", "crumbs");
  let sofar = "";
  for (const part of path.split("/")) {
    if (sofar) crumbs.appendChild(document.createTextNode("/"));
    sofar = sofar ? sofar + "/" + part : part;
    const upto = sofar;
    const piece = put(crumbs, "span", "crumb", part);
    piece.title = "show " + upto + " in the list";
    piece.addEventListener("click", () => revealInTree(upto));
  }
  return where;
}

// What is known about the open file, and the two controls for how it is
// drawn. Everything here is already in hand: the type the page worked out to
// paint it, and the size and mtime the daemon took from the one stat it does
// anyway.
function putAbout(where, rows, windowed) {
  const facts = [];
  const lang = languageOf(state.files.path, state.files.text, state.files.lang);
  if (lang) facts.push(lang);
  if (state.files.size) facts.push(sizeOf(state.files.size));
  const when = whenOf(state.files.mtime);
  if (when) facts.push(when);
  if (facts.length) put(where, "span", "whatis", facts.join(" · "));
  // A binary file and a rendered document have no rows, so neither control
  // would do anything to what is on screen. A control that quietly does
  // nothing is worse than no control.
  if (!rows) return;

  const reading = readingNow();
  const box = put(where, "span", "reading");
  const tab = put(box, "button", "link", "tab " + reading.tab);
  tab.type = "button";
  tab.title = "how wide a tab is drawn";
  tab.addEventListener("click", () => {
    const now = readingNow();
    const at = TAB_WIDTHS.indexOf(now.tab);
    now.tab = TAB_WIDTHS[(at + 1) % TAB_WIDTHS.length];
    keepReading(now);
    // Only the label: `tab-size` reads `--tab-w` from the root, so the rows
    // redraw themselves. Rebuilding the pane here would re-highlight the
    // whole file for a number — and would take an open comment box with it,
    // because `redrawCode` clears the very key that guards one.
    tab.textContent = "tab " + now.tab;
  });
  const wrap = put(box, "button", "link", "wrap");
  wrap.type = "button";
  // A windowed file's rows are a grid the scrollbar is read against, and a
  // wrapped row is not one row tall. The CSS is what enforces that; this says
  // so, rather than letting the reader press something inert.
  wrap.disabled = windowed;
  wrap.title = windowed ? "a file drawn a window at a time cannot wrap"
                        : "break a long line instead of scrolling sideways";
  wrap.setAttribute("aria-pressed", String(reading.wrap && !windowed));
  wrap.addEventListener("click", () => {
    const now = readingNow();
    now.wrap = !now.wrap;
    keepReading(now);
    wrap.setAttribute("aria-pressed", String(now.wrap));
  });
}

// Open the tree down to a path, and ask the list to move to it. A filter hides
// most of the tree, and revealing something the filter has taken out would
// show nothing at all, so the box is cleared first.
function revealInTree(path, line = 0) {
  for (const above of ancestors(path)) state.files.dirs.set(above, true);
  state.files.dirs.set(path, true);   // a directory opens itself; a file has
                                      // no entry, and setting one is harmless
  state.files.goTo = path;
  state.files.at = path;              // and the list marks where you landed
  state.files.goToLine = line;
  // A document has no line to go to, so being asked for one is being asked
  // for the lines it is written in.
  if (line && MARKDOWN.test(path)) state.files.asText = true;
  if (state.find) {
    $("find").value = "";
    state.find = "";
  }
  draw();
}

// Put the window over the row that was asked for. It runs after the rows are
// built, because which row a path is depends on which directories stand open.
function goToInList(list) {
  const want = state.files.goTo;
  if (!want || !list.found) return;
  state.files.goTo = null;
  const at = list.found.findIndex((row) => row.path === want);
  if (at < 0) return;                 // the filter or a closed tree hid it
  // Three rows of air above it, so it does not sit against the top edge.
  list.scrollTop = Math.max(0, (at - 3) * ROW_H);
  fillList(list);
}

// Read this document as Markdown, or as the lines it is written in. A
// rendered document has no line to hang a comment on: the paragraph you want
// to remark on came from a line that is no longer there. This gives it back.
function putAsText(where) {
  const verb = put(where, "button", "link",
                   state.files.asText ? "read as Markdown" : "read as text");
  verb.type = "button";
  verb.title = state.files.asText
    ? "render this document"
    : "show the lines, so they can be commented on";
  verb.addEventListener("click", () => {
    state.files.asText = !state.files.asText;
    redrawCode();
  });
}

function forgetFile(path) {
  // A comment box belongs to the file it is on. Leaving the file takes the
  // box with it, so the flag goes too — it is what `putReview` would reopen.
  if (state.writing !== null) state.writing = null;
  state.files.path = path;
  state.files.at = path;
  state.files.down = 0;       // another file, so there is no place to go back to
  state.files.text = "";
  state.files.binary = false;
  state.files.shown = "";
  state.files.oversize = false;
  state.files.lang = "";
  state.files.mtime = 0;
  state.files.size = 0;
}

function chooseFile(path) {
  if (state.files.path === path) return;
  forgetFile(path);
  load();
}

// --- the Diff tab -----------------------------------------------------------

// A long file starts closed. Building ten thousand lines nobody asked to see
// makes the whole tab slow to open. How much DOM is too much is the page's
// own business, so the number lives here and is sent nowhere.
let BIG_LINES = 500;

function drawDiff(box) {
  const [list, pane, note, foot] = split(box, "diff", "diffbody");
  if (holdingText(box)) return;
  if (!fresh(box, "bodyKey", state.diffAt + "\n" + state.find)) return;
  const place = pane.scrollTop;
  list.replaceChildren();
  pane.replaceChildren();

  const report = state.diff || { sections: [], untracked: [] };
  // A file the agent has since committed is no longer untracked, so the pick
  // goes with it rather than pointing at a section that no longer names it.
  if (state.loose && !(report.untracked || []).includes(state.loose)) {
    state.loose = null;
  }
  let shown = 0;
  for (const section of report.sections) {
    const files = hits(section.files || [], (file) => file.path);
    if (!files.length) continue;
    shown += files.length;
    put(list, "div", "head", section.title).title = section.about || "";
    const head = put(pane, "div", "diffhead " + section.name, section.title);
    if (section.about) put(head, "span", "about", section.about);
    for (const { one, at } of files) {
      const node = drawDiffFile(pane, one, section.name === "committed");
      const button = put(list, "button");
      button.type = "button";
      button.title = one.path;
      putName(button, one.path, at);
      putCounts(put(button, "span", "counts"), one);
      button.addEventListener("click",
                              () => node.scrollIntoView({ block: "start" }));
    }
  }
  const loose = hits(report.untracked || [], (name) => name);
  if (loose.length) {
    put(list, "div", "head", "untracked");
    for (const { one: name, at } of loose) {
      const button = put(list, "button", state.loose === name ? "chosen" : "");
      button.type = "button";
      button.title = name;
      putName(button, name, at);
      button.addEventListener("click", () => chooseUntracked(name));
    }
  }
  let picked = null;
  if (state.loose) {
    picked = drawLooseFile(pane, state.loose);
  } else if (loose.length) {
    put(pane, "div", "note", loose.length + " untracked file" +
        (loose.length > 1 ? "s are" : " is") + " named on the left. git has no" +
        " diff for a file it does not track, so pick one to read it.");
  }
  // Two sections or one, and which is which, is the whole of what this tab
  // was unclear about. When there is no base the committed half is missing
  // altogether, and nothing used to say so -- the tab simply showed less.
  if (state.diff && !report.base && !report.failed) {
    put(pane, "div", "note", "No default branch to compare against, so this"
        + " tab shows only what is not committed. git had no origin/HEAD and"
        + " no main or master.");
  }
  if (report.failed) {
    put(pane, "div", "note", "git did not answer here, so this may not be the"
        + " whole diff. It is tried again in a few seconds.");
  } else if (!shown && !loose.length) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, state.find ? "No changed file matches."
      : report.base ? "Nothing has changed against " + report.base + "."
      : "Nothing has changed, and there is no branch to compare against.");
  }
  if (report.cut) {
    put(pane, "div", "note", "This diff is long, so the rest is left out.");
  }
  // Picking a file moves the pane to it; anything else leaves the reader
  // where they were. Restoring the old place whatever happened is what made a
  // click on an untracked name look like it had done nothing: the block was
  // built below the fold and the pane scrolled straight back up.
  //
  // `chooseUntracked` is the only thing that picks, so it is the only thing
  // that says to go, and it stays said until the file has arrived — the block
  // is drawn twice, and the second draw is what the reader ends up looking
  // at. Working that out again here from two other fields was a string of
  // state algebra explaining itself.
  if (state.goTo && picked) {
    if (state.looseText !== null) state.goTo = false;
    requestAnimationFrame(() => picked.scrollIntoView({ block: "start" }));
  } else if (place) {
    requestAnimationFrame(() => { pane.scrollTop = place; });
  }
  note.replaceChildren();
  countNote(note, shown + loose.length);
  drawDiffCount();
}

// git has no diff for an untracked file, so it was named and left
// unclickable — the one thing on the tab you could not open. Every line in it
// is new, which is what the file is, so it is shown as one added block.
function drawLooseFile(pane, path) {
  const node = put(pane, "div", "dfile");
  const head = put(node, "div", "name");
  put(head, "span", "what", "untracked");
  put(head, "span", "path", path);
  const body = put(node, "div", "dbody");
  if (state.looseText === null) {
    put(body, "div", "note", "reading…");
    return node;
  }
  if (state.looseBinary) {
    // The same answer the Files tab gives, from the same place: a screenshot
    // an agent has just taken is an untracked file, and it read as "nothing
    // to show" on one tab and showed as a picture on the other.
    putMedia(body, path, state.looseFound);
    return node;
  }
  const lines = state.looseText === "" ? []
    : state.looseText.replace(/\n$/, "").split("\n");
  putCounts(head, { added: lines.length, removed: 0 });
  if (!lines.length) {
    put(body, "div", "note", "This file is empty.");
    return node;
  }
  // One hunk, every line added, which is what the file is. It goes through
  // the one place that knows the shape of a diff row, so it is numbered and
  // lined up with every other block rather than being a third way to draw a
  // line that quietly drifts from the other two.
  // The path goes in it too: a review comment is anchored by the file it is
  // about, and without one every untracked file shared the anchor `undefined`
  // — a comment on line 3 of this one turned up on line 3 of the next.
  fillDiffFile(body, { path: path, hunks: [{
    header: "@@ -0,0 +1," + lines.length + " @@",
    lines: lines.map((text) => ({ kind: "added", text })),
  }] });
  putReview(put(node, "div", "onFile"), anchorOf(path, 0), "");
  return node;
}

async function chooseUntracked(path) {
  if (state.loose === path) return;
  state.loose = path;
  state.looseText = null;
  state.looseBinary = false;
  state.looseFound = {};
  state.goTo = true;            // until the block is on screen with the file
  state.diffAt += 1;            // the body key has to move for the redraw
  draw();
  const want = state.chosen;
  const body = await ask(want, "file", "?path=" + encodeURIComponent(path));
  if (state.chosen !== want || state.loose !== path) return;
  state.looseText = body ? (body.text || body.missing || "") : "";
  state.looseBinary = !!(body && body.binary);
  state.looseFound = body || {};   // what `putMedia` needs, if it is a picture
  state.diffAt += 1;
  draw();
}

function drawDiffFile(pane, one, atHead = false) {
  const node = put(pane, "div", "dfile");
  const head = put(node, "button", "name");
  head.type = "button";
  put(head, "span", "what", one.status);
  put(head, "span", "path", one.status === "renamed"
    ? one.old_path + " \u2192 " + one.path : one.path);
  putCounts(head, one);
  const body = put(node, "div", "dbody");
  putReview(put(node, "div", "onFile"), anchorOf(one.path, 0), "");
  if (one.binary) {
    put(body, "div", "note", "Binary file. There is nothing to show.");
    return node;
  }
  if (!one.hunks.length) {
    put(body, "div", "note", "The content did not change.");
    return node;
  }
  const size = one.hunks.reduce((sum, hunk) => sum + hunk.lines.length, 0);
  const why = put(head, "span", "why");
  // `drawDiff` rebuilds this pane whenever the agent saves anything, so what
  // the reader opened has to live outside the node, the way the transcript's
  // expanded tool rows do. `BIG_LINES` only decides a file nobody has touched.
  const chose = state.diffOpen.get(one.path);
  let open = chose === undefined ? size <= BIG_LINES : chose;
  const mark = () => { why.textContent = size + " lines" + (open ? "" : ", hidden"); };
  if (open) fillDiffFile(body, one, atHead);
  mark();
  head.addEventListener("click", () => {
    open = !open;
    state.diffOpen.set(one.path, open);
    if (open) fillDiffFile(body, one, atHead); else body.replaceChildren();
    mark();
  });
  return node;
}

// Where a hunk starts on each side. `@@ -12,7 +14,9 @@` says line 12 of the
// old file and line 14 of the new one. The numbers are worked out here rather
// than sent: they follow from the header, and a diff is already the biggest
// thing on the wire.
const HUNK_AT = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/;

// Every line of a file's diff with the numbers it carries on each side. A
// removed line has none on the new side and an added one has none on the old
// side. Two callers walk this — the drawing, and the check for whether a
// comment's line is still where it was — and a second copy of the arithmetic
// is a second copy that can drift.
function walkHunks(one, onHunk, onLine) {
  for (const hunk of one.hunks || []) {
    const where = onHunk ? onHunk(hunk) : null;
    // A file read as lines carries no `@@` header, and its first line is line
    // one — unless only a slice of it is being drawn, and then the slice says
    // which line it starts at. A diff hunk whose header will not parse is no
    // better off starting at zero than at one.
    const found = HUNK_AT.exec(hunk.header);
    let old = found ? Number(found[1]) : (hunk.from || 1);
    let now = found ? Number(found[2]) : (hunk.from || 1);
    for (const line of hunk.lines) {
      onLine(line, old, now, where);
      if (line.kind !== "added") old += 1;
      if (line.kind !== "removed") now += 1;
    }
  }
}

// `plain` is a line of a file being read rather than a line of a diff: no
// marker in front of it, one number rather than two, and no tint. The Files
// tab draws through here for it, so a file gets the numbers, the `+` and the
// comments the diff already had, and a comment on line 42 lands on the same
// anchor whichever tab it was written in.
const SIGN = { added: "+", removed: "\u2212", context: " " };

function fillDiffFile(body, one, atHead = false) {
  walkHunks(one, (hunk) => {
    if (hunk.header) put(body, "div", "hunk", hunk.header);
    return put(body, "div", "dlines");
  }, (line, old, now, lines) => {
      const row = put(lines, "div", "dline " + line.kind);
      // The numbers in one span, lined up with spaces. The row is already
      // `white-space: pre` in a monospace face, so they stay in column
      // without a flex box and three elements around every line — a diff of
      // twelve thousand lines is the difference between 24,000 nodes and
      // 84,000. A removed line has no number on the new side and an added one
      // has none on the old side, so that side is left blank.
      put(row, "span", "ln", line.kind === "plain"
          ? String(now).padStart(6) + "  "
          : (line.kind === "added" ? "" : String(old)).padStart(5) +
            (line.kind === "removed" ? "" : String(now)).padStart(6) + "  ");
      // The marker is its own span so that what follows it is exactly the
      // line, which is what the highlighter is given and what it paints.
      if (SIGN[line.kind]) put(row, "span", "sign", SIGN[line.kind]);
      put(row, "span", "dtext", line.text);
      const anchor = lineAnchor(one.path, line,
                                atHead ? inWorktree(one.path, now) : now);
      if (anchor === null) return;      // a line that is no longer in the file
      if (commentAt(anchor) || state.writing === anchor) {
        putReview(put(lines, "div", "onLine"), anchor, line.text);
      } else {
        putReview(row, anchor, line.text);
      }
  });
}

// The lines of a file. An empty file has none, where splitting a string that
// is empty gives one empty line.
function linesOf(text) {
  return text === "" ? [] : text.split("\n");
}

// A file, or a slice of one, in the shape `fillDiffFile` wants. `from` is the
// number of the first line, which is 1 unless only part of the file is drawn.
function asLines(path, lines, from = 1) {
  return { path, hunks: [{ header: "", from,
    lines: lines.map((one) => ({ kind: "plain", text: one })) }] };
}

// --- the review ---------------------------------------------------------------
//
// A comment is one note on one place: a line of the diff, or a file. The place
// is written down rather than pointed at, because the diff is rebuilt whenever
// the agent saves anything and a node does not survive that. See PLAN.md 4.9.

// What a comment is anchored to, as one string, so that finding it again is a
// lookup rather than a search with four fields in it. A removed line has a
// number only on the old side, an added line only on the new side.
function anchorOf(path, line) {
  return path + "\n" + line;
}

// The place a line of a drawn file or diff is: its number in the file as it is
// now. Line numbers start at one, so nought is the file itself.
//
// A removed line has no number in the file as it is now, and so has no place
// to be. It used to anchor to the old side, which meant the comment could not
// be drawn on the Files tab at all — every line there is a line of the file as
// it is — and once the diff moved past it, nowhere else either. It was still
// sent. A removed line is not offered a `+` now.
function lineAnchor(path, line, now) {
  if (line.kind === "removed" || !now) return null;
  return anchorOf(path, now);
}

// Where a line of HEAD stands in the worktree. The committed section is
// `base...HEAD`, so its new side is HEAD — not the file on disk — and a
// comment belongs to a line of the file as it is. Commenting on a committed
// line after fifty lines were prepended anchored fifty lines too high, and
// that is wrong at the moment of writing, not because the file moved later.
//
// The uncommitted section is exactly the map from HEAD to the worktree, so it
// is read rather than a second thing to keep in step. Nought means the line
// is not in the worktree at all, and then there is nowhere to put a comment.
function inWorktree(path, headLine) {
  const later = ((state.diff || {}).sections || [])
    .find((section) => section.name === "uncommitted");
  const one = ((later || {}).files || []).find((file) => file.path === path);
  if (!one) return headLine;          // nothing uncommitted: the same file
  let drift = 0;                      // how far the worktree has slid by here
  let found = null;
  walkHunks(one, null, (line, old, now) => {
    if (found !== null || line.kind === "added") return;   // no old-side number
    if (old > headLine) { found = headLine + drift; return; }
    if (old === headLine) { found = line.kind === "removed" ? 0 : now; return; }
    drift = now - old - (line.kind === "removed" ? 1 : 0);
  });
  // Past the last hunk, the whole file has slid by the same amount.
  return found === null ? headLine + drift : found;
}

// How a place reads: `path:112`, or just the path when it is the whole file.
function placeOf(anchor) {
  const [path, line] = anchor.split("\n");
  return line === "0" ? path : path + ":" + line;
}

function commentAt(anchor) {
  return state.review.comments.find((one) => one.anchor === anchor) || null;
}

// --- keeping a review ---------------------------------------------------------
//
// In this browser, and nowhere else. A review is yours until you submit it,
// and the daemon serves the same page to every browser, so a draft it held
// would be a draft everyone could read. A review written over ten minutes has
// to survive a reload; nothing else here does, and nothing else here needs to.

const REVIEW_KEY = "wostuast-review-";

function keepReview() {
  drawReviewCount();          // every change to a review comes through here
  if (!state.chosen) return;
  try {
    if (!anyReview()) {
      localStorage.removeItem(REVIEW_KEY + state.chosen);
      return;
    }
    localStorage.setItem(REVIEW_KEY + state.chosen, JSON.stringify(state.review));
  } catch (error) { }      // a private window, or the quota; the page goes on
}

function recallReview(id) {
  state.review = blankReview();
  let held = null;
  try { held = JSON.parse(localStorage.getItem(REVIEW_KEY + id) || "null"); }
  catch (error) { return; }
  if (!held || !Array.isArray(held.comments)) return;
  // What comes back was written by this page, but a browser's storage is not
  // a place to trust blindly: anything of the wrong shape is left out rather
  // than drawn.
  state.review.comments = held.comments.filter(
    (one) => one && typeof one.note === "string"
             && typeof one.anchor === "string"
             // `path \n line`, and nothing else. An anchor of another shape is
             // a draft from an older page, and drawing it would put a comment
             // on a line nobody chose.
             && /^[^\n]+\n\d+$/.test(one.anchor));
  for (const field of ["task", "overall"]) {
    if (typeof held[field] === "string") state.review[field] = held[field];
  }
}

// A review for a session the daemon no longer lists is a review nobody can
// send. Done once, when the first list arrives, because storage is per browser
// and the sessions outlive any one page.
function pruneReviews(sessions) {
  if (state.pruned || !sessions.length) return;
  state.pruned = true;
  const live = new Set(sessions.map((one) => one.id));
  try {
    for (const key of Object.keys(localStorage)) {
      if (key.startsWith(REVIEW_KEY) && !live.has(key.slice(REVIEW_KEY.length))) {
        localStorage.removeItem(key);
      }
    }
  } catch (error) { }
}

// An empty review. One place, so that starting one, throwing one away and
// choosing another session cannot drift apart about what "nothing" means.
function blankReview() {
  return {
    task: "",           // a short name for the whole thing: "cleanup"
    overall: "",        // what to do at each location, and with the result
    comments: [],       // one per place, in the order they were made
  };
}

// Is there anything here at all? A review with a task name and no comments is
// still a review someone started, and throwing it away silently would lose it.
function anyReview() {
  return !!(state.review.comments.length || state.review.task.trim()
            || state.review.overall.trim());
}

// The note the reader typed. An empty one deletes the comment, which is what
// clearing the box and saving means; there is no separate delete to remember.
function writeComment(anchor, quoted, note) {
  const text = note.trim();
  const had = commentAt(anchor);
  if (!text) {
    const at = state.review.comments.indexOf(had);
    if (had) state.review.comments.splice(at, 1);
  } else if (had) {
    had.note = text;
  } else {
    state.review.comments.push({ anchor, quoted, note: text });
  }
  state.writing = null;
  keepReview();
  redrawCode();
}

// The Files and Diff tabs are both rebuilt from an answer the poll replaces
// every couple of seconds, and `fresh` holds the rebuild to when that answer
// changes — so a comment added or removed has to say so itself. They share the
// one content box, so this redraws whichever is open.
function redrawCode() {
  const box = $("content");
  box.dataset.bodyKey = "";
  draw();
}

// One comment, under the line or the file it is about.
//
// `full` is the Review tab, which shows a comment away from the code: there is
// no line above it there, so it carries the quoted one itself, and it is the
// only place a comment can be thrown away outright. Everywhere else the line
// is right there and an empty save is the way to remove one.
function putComment(parent, one, full) {
  const node = put(parent, "div", "comment");
  if (full && one.quoted) put(node, "div", "quoted", one.quoted);
  put(node, "div", "note", one.note);
  const acts = put(node, "div", "acts");
  const edit = put(acts, "button", "verb quiet", "edit");
  edit.type = "button";
  edit.addEventListener("click", () => {
    state.writing = one.anchor;
    redrawCode();
  });
  if (full) {
    const drop = put(acts, "button", "verb quiet", "delete");
    drop.type = "button";
    drop.addEventListener("click",
                          () => writeComment(one.anchor, one.quoted, ""));
  }
  return node;
}

// The box. Save keeps what is in it, Cancel leaves the comment as it was, and
// an empty save removes it.
function putCommentBox(parent, anchor, quoted) {
  const form = put(parent, "div", "commentbox");
  const area = put(form, "textarea");
  area.value = (commentAt(anchor) || {}).note || "";
  area.placeholder = "what should the agent change here?";
  area.rows = 3;
  const row = put(form, "div", "buttons");
  const stop = put(row, "button", "verb quiet", "cancel");
  stop.type = "button";
  stop.addEventListener("click", () => { state.writing = null; redrawCode(); });
  const save = put(row, "button", "verb", "save");
  save.type = "button";
  save.addEventListener("click", () => writeComment(anchor, quoted, area.value));
  area.addEventListener("keydown", (press) => {
    if (press.key === "Escape") { state.writing = null; redrawCode(); }
  });
  requestAnimationFrame(() => { area.focus(); area.select(); });
  return form;
}

// The button that opens the box, and the comment or box that is already there.
// One function, because a line and a file header want exactly the same three
// things and differ only in where they hang them.
function putReview(parent, anchor, quoted, full) {
  const seen = commentAt(anchor);
  // One box per anchor, wherever the line first turns up. A file that is in
  // both sections has the same line twice, and the second box took the focus
  // from the first: keystrokes went to a box off screen, and saving the one
  // the reader could see passed an empty note — which means delete. The
  // comment was lost without a word.
  if (state.writing === anchor && !document.querySelector(".commentbox")) {
    return putCommentBox(parent, anchor, quoted);
  }
  if (seen) return putComment(parent, seen, full);
  const add = put(parent, "button", "addnote", "+");
  add.type = "button";
  add.title = "comment here";
  add.addEventListener("click", () => {
    state.writing = anchor;
    redrawCode();
  });
  return add;
}

// The comments in the order they will be read: by file, and inside a file the
// note about the whole thing first, then the lines from the top down. The
// order they were written in is the order the reader wandered through the
// diff, which is nobody else's order.
function reviewInOrder() {
  return state.review.comments.slice().sort((one, two) => {
    const [pathA, lineA] = one.anchor.split("\n");
    const [pathB, lineB] = two.anchor.split("\n");
    if (pathA !== pathB) return pathA < pathB ? -1 : 1;
    return Number(lineA) - Number(lineB);   // nought is the file, so it leads
  });
}

// The message the agent gets. It is a task, not a list of remarks: a heading
// it can read at a glance, what to do, what to hand back, and then one section
// per place with the line quoted under it.
//
// The line number is a hint and says so. The file moves while the review is
// being written, so the quoted line is the thing that is really being pointed
// at, and the agent is told to search for it when the number no longer fits.
// That replaces the marks this used to carry — "gone", "moved" — which said
// what the diff thought and were sent as if the reader had written them.
const REVIEW_HOW = [
  "When you are done, write one short entry per location: what you did, or"
  + " what you found.",
  "Locations are given as `path:line`, followed by the quoted source line. If"
  + " the line number does not match anymore, search for the quoted line. If a"
  + " comment is not clear, ask me before you change anything.",
];

function reviewText(comments = reviewInOrder()) {
  const task = state.review.task.trim();
  const parts = ["# Task: " + (task || "review")];
  if (state.review.overall.trim()) parts.push(state.review.overall.trim());
  parts.push(...REVIEW_HOW);
  for (const one of comments) {
    parts.push("## " + placeOf(one.anchor));
    if (one.quoted) parts.push("> " + one.quoted);
    parts.push(one.note);
  }
  return parts.join("\n\n") + "\n";
}

// --- the Review tab ---------------------------------------------------------
//
// Every comment in one place, which is where a review is read back and where
// it is sent from. The Diff tab used to carry a submit button and a modal;
// a review written across three files and two tabs had no home until it was
// already being sent.

function drawReview(box) {
  const [list, pane, note, foot] = split(box, "review", "reviewbody");
  if (holdingText(box)) return;
  if (!fresh(box, "bodyKey", reviewKey())) return;
  list.replaceChildren();
  pane.replaceChildren();

  const found = hits(reviewInOrder(), (one) => one.anchor.split("\n")[0]);
  const comments = found.map((hit) => hit.one);
  if (!anyReview()) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, "No review yet. Press the + beside any line of any"
        + " file, on this tab's neighbours, and it turns up here.");
    note.replaceChildren();
    foot.replaceChildren();
    return;
  }

  // What the whole thing is for. The task name becomes the heading the agent
  // reads first, so it is asked for separately rather than guessed at.
  const about = put(pane, "div", "about");
  const boxes = [
    putField(about, "task", "Task", state.review.task,
             "a short name: cleanup, security analysis", 1),
    putField(about, "overall", "What to do", state.review.overall,
             "what to do at each location, and what to do with the result", 3),
  ];

  for (const { one, at } of found) {
    const path = one.anchor.split("\n")[0];
    const where = placeOf(one.anchor);
    const node = put(pane, "div", "spot");
    const head = put(node, "div", "where");
    const go = put(head, "button", "crumb", where);
    go.type = "button";
    go.title = "open " + path;
    go.addEventListener("click", () => goToComment(one.anchor));
    // The same dispatch every other place uses: the box if it is being
    // written, the comment if it is not. A comment always exists here, so the
    // `+` branch cannot be reached.
    putReview(node, one.anchor, one.quoted, true);
    const button = put(list, "button");
    button.type = "button";
    button.title = path;
    putName(button, where, at);
    button.addEventListener("click",
                            () => node.scrollIntoView({ block: "start" }));
  }

  // The message itself, not a description of it. This is where a person reads
  // what is about to be pasted into their terminal, and part of it is text an
  // agent wrote, so send comes under it rather than beside it: read, then
  // send, in that order down the page. It cannot be edited here — one text,
  // and one place it comes from.
  // The whole review, never the filtered part of it. The find box narrows
  // what is on screen; it must not narrow what is sent. It did: with a filter
  // typed — one left over from finding a file, since the box is shared — the
  // preview showed one comment and the send took two, quoted source and all.
  // "One text, one place it comes from" is the rule this breaks.
  put(pane, "div", "sofar", "what the agent will be sent");
  const preview = put(pane, "pre", "reviewtext", reviewText());
  putSubmit(put(pane, "div", "buttons"));

  // The boxes are wired once the preview exists, so each keystroke writes to
  // the node this draw made rather than going looking for it.
  for (const area of boxes) {
    area.addEventListener("input", () => {
      state.review[area.dataset.which] = area.value;
      keepReview();
      preview.textContent = reviewText();
    });
  }

  note.replaceChildren();
  const all = state.review.comments.length;
  put(note, "span", null,
      comments.length === all
        ? all + (all === 1 ? " comment" : " comments")
        : comments.length + " of " + all + " comments");
}

// One of the two boxes at the top. They are the only editable things on the
// tab, so they share their shape.
function putField(parent, which, label, value, hint, rows) {
  const wrap = put(parent, "label", "field");
  put(wrap, "span", "fieldname", label);
  const area = put(wrap, "textarea");
  area.value = value;
  area.placeholder = hint;
  area.rows = rows;
  area.spellcheck = false;
  area.dataset.which = which;
  return area;
}

function putSubmit(foot) {
  const session = current();
  const send = put(foot, "button", "verb submit", "send to the agent");
  send.type = "button";
  send.disabled = !(session && session.pane) || !state.review.comments.length;
  send.addEventListener("click", submitReview);
  if (!state.review.comments.length) {
    put(foot, "div", "why", "nothing to send yet");
  } else if (send.disabled) {
    put(foot, "div", "why", "this session is not running in tmux, so there is"
        + " nowhere to send it");
  }
  // Starting over. Two presses, because there is no undo and a review is
  // half an hour of someone's reading. The first press only relabels the
  // button, in place: redrawing the whole tab to change one word would take
  // the reader's cursor and their place on the page with it.
  let armed = false;
  const drop = put(foot, "button", "verb quiet", "delete this review");
  drop.type = "button";
  drop.addEventListener("click", () => {
    if (!armed) {
      armed = true;
      drop.textContent = "really delete it?";
      return;
    }
    state.review = blankReview();
    state.writing = null;
    keepReview();
    redrawCode();
  });
}

// What this tab is drawn from — and only what can change *without* going
// through `redrawCode`, which clears the key itself. That is the session, and
// whether it still has a pane for the send button to be sent to.
//
// The two boxes are deliberately not in here. Keying on whether they held
// text meant the first character typed into an empty one flipped the key, so
// the next unrelated `draw()` — the find box has two — rebuilt the pane and
// took the box being typed in with it.
function reviewKey() {
  return [state.chosen, (current() || {}).pane || "", state.find].join("\n");
}

// Open the file a comment is about, on the tab that shows whole files.
function goToComment(anchor) {
  const [path, line] = anchor.split("\n");
  chooseFile(path);
  // Not just `goTo`: the file may sit under a closed directory or behind a
  // filter, and then the list has nothing to move to. `revealInTree` opens
  // the way, clears the box, and takes the line the comment is about — the
  // heading says `path:112`, so landing at the top of the file was telling
  // the reader where to go and then not going there.
  revealInTree(path, Number(line));
  showTab("files");
}

async function submitReview() {
  const id = state.chosen;
  const answer = await tell(id, "send", { text: reviewText() });
  if (!answer || answer.error) {
    said({ error: (answer && answer.error) || "it was not sent" });
    return;
  }
  // `tmux send-keys` takes long enough to press `j` in, and everything below
  // works on whatever is current: it wiped the new session's draft and
  // removed its key from storage. The review that was sent is the one to
  // clear, and where it lives when the reader has moved on is storage.
  if (state.chosen !== id) {
    try { localStorage.removeItem(REVIEW_KEY + id); } catch (error) { }
    note("review sent");
    return;
  }
  const session = current();
  state.review = blankReview();
  state.writing = null;
  keepReview();
  redrawCode();
  // Claude Code queues what arrives mid-turn, so a review sent to a working
  // agent is not lost — it is read when the turn ends. Say so, because from
  // here it looks like nothing happened.
  note(session && session.state === "working"
    ? "review sent; the agent is working, so it reads this when the turn ends"
    : "review sent");
}

// The tab says how many comments are waiting, the way the Diff tab says how
// much has changed. Without it a review written and left would be invisible.
function drawReviewCount() {
  const badge = $("reviewcount");
  const many = state.review.comments.length;
  badge.hidden = !many;
  badge.textContent = String(many);
}

function drawDiffCount() {
  const badge = $("diffcount");
  let added = 0;
  let removed = 0;
  for (const section of (state.diff ? state.diff.sections : [])) {
    for (const one of section.files) { added += one.added; removed += one.removed; }
  }
  badge.hidden = !(added || removed);
  badge.textContent = "+" + added + " \u2212" + removed;
}

// --- the tabs ---------------------------------------------------------------

// `finds` is what the find box is for on that tab, and a tab that does not
// use it says so with `null` -- the box then goes away rather than standing
// there inviting a query nothing will answer. The Session tab is about one
// session and has no list to narrow, and it was offering "find a file",
// which is a promise about a tab one over.
//
// It lives here for the same reason `draw`, `load` and `poll` do: a new tab
// is one entry. The placeholder used to be a ternary in `showTab` naming
// three tabs, so the two it did not name got whatever the last arm said.
const TABS = {
  transcript: { draw: drawTranscript, load: loadTranscript, poll: 0,
                splits: true, finds: "find a turn  /" },
  files: { draw: drawFiles, load: loadFiles, poll: 2000, splits: true,
           finds: "go to file  /" },
  diff: { draw: drawDiff, load: loadDiff, poll: 5000, splits: true,
          finds: "find a file  /" },
  // No `load`: a review is written in this browser, so there is nothing to
  // fetch. `load()` draws for a tab that says so, which is the half an empty
  // loader forgot — and then switching here left the page on the tab before.
  review: { draw: drawReview, load: null, poll: 0, splits: true,
            finds: "find a comment  /" },
  session: { draw: drawSession, load: loadSession, poll: 4000, finds: null },
};

// Which tab each number key picks. A key for a tab that is not built yet does
// nothing, because showTab only accepts a name TABS knows.
const TAB_KEYS = ["transcript", "files", "diff", "review", "session"];

function draw() {
  const box = $("content");
  box.className = "content" + (TABS[state.tab].splits ? " split" : "");
  // There is one find box and it lives wherever it is used, which on a split
  // tab is inside this content box. Any tab that rebuilds the box empties it,
  // so the box has to be taken home first or it is destroyed — and with it
  // every listener on it, and the next `$("find")` throws. That threw inside
  // `showTab` before it reached `load`, so the tab never loaded and every
  // switch after it threw too: broken until a reload.
  //
  // The box is in danger exactly when a tab is about to rebuild, and every
  // tab rebuilds on the same condition: the box says another tab owns it.
  // Asking the DOM means a new tab cannot forget to say so, and it does not
  // move on a redraw of the same tab, which would blur the box mid-word.
  // `split` takes it back for the tabs that keep it.
  if (!current() || box.dataset.tab !== state.tab) homeFind($("findhome"));
  if (!current()) {
    box.replaceChildren();
    box.dataset.tab = "";       // nothing is built, so the next tab rebuilds
    state.turns.nodes = [];
    drawEmpty(box);
    return;
  }
  TABS[state.tab].draw(box);  // showTab only ever sets a tab that is in here
}

function showTab(name) {
  if (!TABS[name]) return;
  state.tab = name;
  state.writing = null;       // the box was on the tab you are leaving

  drawHeader();               // the send box belongs to the transcript only
  for (const button of document.querySelectorAll(".tab")) {
    button.setAttribute("aria-selected", String(button.dataset.tab === name));
  }
  // A tab that does not use the box does not show one. `findhome` is where
  // the box lives when no split tab has claimed it, and hiding the home
  // rather than the box means `homeFind` has somewhere to put it either way.
  const finds = TABS[name].finds;
  $("findhome").hidden = !finds;
  if (finds) $("find").placeholder = finds;
  load();
  resubscribe();
}

function drawEmpty(box) {
  const empty = put(box, "div", "empty");
  put(empty, "h2", null, "No session selected");
  put(empty, "p", null,
      "Start a Claude Code session in tmux and it appears on the left.");
  const p = put(empty, "p", null, "If nothing ever appears, run ");
  put(p, "code", null, "wostuast doctor");
  p.appendChild(document.createTextNode(" to see what is missing."));
}

// --- talking to the daemon --------------------------------------------------

// What a session remembers between visits: what the reader chose, and never
// what the daemon sent. The listing, the file's text and the diff are fetched
// again -- by the time you come back they have moved, and they are also the
// big things, 52,799 names being 1.7 MB of it.
function savePlace(id) {
  if (!id) return;
  state.visits.set(id, {
    tab: state.tab,
    // The Transcript tab's choices and not its blocks: those are a cache the
    // daemon fills again, and `nodes` holds live DOM belonging to a page this
    // session has left. Spreading the whole bag kept both.
    turnAt: state.turns.at,
    turnDown: state.turns.down,
    // Which reading those `seq`s belong to. Without it, coming back to a
    // session looks exactly like its transcript having been rewritten.
    turnRun: state.turns.run,
    path: state.files.path,
    at: state.files.at,
    asText: state.files.asText,
    // Written down as the reader scrolls, so this is right whichever tab
    // they are on when they leave. Asking the DOM here instead meant a
    // second writer, and it wrote the outgoing session's place over the one
    // just restored for the new session.
    down: state.files.down,
    dirs: new Map(state.files.dirs),
    open: new Set(state.turns.open),
    shut: new Set(state.turns.shut),
    diffOpen: new Map(state.diffOpen),
    loose: state.loose,
  });
  // A session that has gone from the list will not be chosen again, so its
  // place is dead weight on a page that is meant to stay open for days.
  const live = new Set(state.sessions.map((one) => one.id));
  for (const kept of [...state.visits.keys()]) {
    if (kept !== id && !live.has(kept)) state.visits.delete(kept);
  }
}

// Put back onto a state that has just been blanked, so every field is one
// the blank already has. A session never visited has nothing here and keeps
// the blank.
function usePlace(id) {
  const kept = state.visits.get(id);
  if (!kept) return null;
  state.turns.at = kept.turnAt;
  state.turns.down = kept.turnDown;
  state.turns.run = kept.turnRun;
  state.files.path = kept.path;
  state.files.at = kept.at;
  state.files.asText = kept.asText;
  state.files.dirs = new Map(kept.dirs);
  state.files.down = kept.down;
  state.turns.open = new Set(kept.open);
  state.turns.shut = new Set(kept.shut);
  state.diffOpen = new Map(kept.diffOpen);
  state.loose = kept.loose;
  return kept;
}

function choose(id) {
  if (state.chosen === id) return;
  savePlace(state.chosen);
  state.chosen = id;
  // One assignment each, which is what the two bags are for: the transcript
  // and the worktree of the last session are not this one's, and a field
  // added to either must not need a line here to be forgotten from.
  state.turns = blankTurns();
  state.files = blankFiles();
  state.loose = null;
  state.looseFound = {};
  state.looseText = null;
  state.looseBinary = false;
  state.goTo = false;
  state.diff = null;
  state.events = { counts: {}, events: [], at: 0 };
  state.diffOpen.clear();
  recallReview(id);
  state.writing = null;
  drawReviewCount();
  state.diffRaw = "";
  state.diffAt += 1;
  drawDiffCount();          // the last session's counts are not this one's
  const back = usePlace(id);
  drawSessions();
  // The tab is part of where you were, so coming back to a session ends the
  // way every tab change ends -- `showTab` draws the header, loads the tab
  // and resubscribes, which was this function's own tail.
  showTab(back && TABS[back.tab] ? back.tab : state.tab);
}

// A tab that reads the worktree asks again while it is on screen. The
// transcript is pushed over SSE and needs none of this. A hidden page asks
// nothing at all: the timer is not set, and `visibilitychange` starts it again.
function repoll() {
  clearTimeout(state.poll);
  state.poll = 0;
  const wait = TABS[state.tab].poll;
  if (!wait || !state.chosen || document.visibilityState !== "visible") return;
  state.poll = setTimeout(load, wait);
}

async function ask(id, what, query, raw) {
  try {
    const answer = await fetch(apiUrl(id, what, query));
    return raw ? await answer.text() : await answer.json();
  } catch (error) {
    return null;                            // the daemon went away; try later
  }
}

async function load() {
  if (!state.chosen) { draw(); return; }
  try {
    const fetcher = TABS[state.tab].load;
    if (fetcher) await fetcher(); else draw();
  } finally {
    repoll();
  }
}

// `seq` is a place in one reading, not an identity. A transcript rewritten
// under its own name counts from nought again, so everything the reader
// chose by `seq` then points at a different block: the tool results they had
// expanded, the rounds they had folded shut, and the row the map marks. They
// are forgotten together, in one place, because there are three of them and
// a fourth would be added to two of them.
//
// This is why `run` is one of the things a session keeps: coming back to a
// session whose transcript has not been rewritten must keep your place, and
// `usePlace` putting the choices back without the reading they belong to
// would make every return look like a rewrite.
function forgetPlaces() {
  state.turns.open = new Set();
  state.turns.shut = new Set();
  state.turns.at = null;
  state.turns.goTo = null;
}

async function loadTranscript() {
  const want = state.chosen;
  const body = await ask(want, "transcript");
  if (state.chosen !== want) return;        // the reader moved on while we waited
  state.turns.blocks = (body && body.blocks) || [];
  const run = body && body.run !== undefined ? body.run : -1;
  // Only a reading replacing another one. `-1` is "none held yet", which is
  // every first load -- and `goTo` is set from the address bar before this
  // runs, so forgetting there would throw away the link the page opened on.
  if (state.turns.run !== -1 && run !== state.turns.run) forgetPlaces();
  state.turns.run = run;
  draw();
}

async function loadFiles() {
  const want = state.chosen;
  // Both are asked for on every poll. The listing used to come every other
  // one, because it carried every name in the repository each time; now it
  // carries them only when they have moved, so asking often is nearly free
  // and the changed-file dot turns up in about two seconds instead of six.
  const body = await ask(want, "files",
                         "?have=" + encodeURIComponent(state.files.tag));
  if (!body || state.chosen !== want) return;
  state.files.tag = body.tag || "";
  state.files.changed = new Map(Object.entries(body.changed || {}));
  state.files.total = body.total || 0;
  state.files.cut = !!body.cut;
  state.files.failed = !!body.failed;
  state.files.ignoredMax = body.ignored_max || 0;
  // The tag is a hash of the names, so a directory that has grown past the
  // budget -- or shrunk back under it -- moves this and nothing else. The
  // tree is built from both, so it has to be rebuilt for either.
  const left = (body.skipped || []).join("\0");
  const moved = left !== [...state.files.skipped].join("\0");
  if (moved) state.files.skipped = new Set(body.skipped || []);
  // No `names` means the tag we sent still stands, so the ones we hold do too.
  // NUL separates them: it is the only character a file name cannot hold, and
  // an empty listing splits to one empty string rather than to none.
  if (body.names !== undefined) {
    state.files.names = body.names ? body.names.split("\0") : [];
    state.files.known = new Set(state.files.names);   // built once, asked every poll
  }
  if (body.names !== undefined || moved) {
    state.files.tree = buildTree(state.files.names, state.files.skipped);
    // Everything the reader can go to, files and the directories holding
    // them, built here for the same reason the tree is: fifty thousand names
    // are not worth walking once per keystroke to add the folders back.
    state.files.places = state.files.names.concat(
      [...state.files.tree.keys()].filter(Boolean));
  }
  state.files.marked = dirsWithChanges(state.files.changed);
  if (!state.files.known.has(state.files.path)) {
    // The first file the reader will see, from the one place that decides
    // what that order is. It runs when the open file has gone, not per poll.
    const first = listRows().find((row) => !row.dir);
    forgetFile(first ? first.path : null);
  }

  if (state.files.path) {
    // The file is asked for by name, and the name can change while the answer
    // is on its way: pick another file quickly and the first one's text landed
    // under the second one's name, so the tab showed one file's content
    // labelled as another. The session is not the only thing that can move.
    const wanted = state.files.path;
    const body = await ask(want, "file", "?path=" + encodeURIComponent(wanted));
    if (!body || state.chosen !== want || state.files.path !== wanted) return;
    // Only a file whose mtime moved is drawn again, so the tab keeps your
    // place in a file the agent has not touched.
    if (body.mtime !== state.files.mtime) {
      state.files.text = body.text || body.missing || "";
      state.files.binary = !!body.binary;
      state.files.shown = body.shown || "";
      state.files.oversize = !!body.oversize;
      state.files.lang = body.language || "";
      state.files.mtime = body.mtime || 0;
      state.files.size = body.size || 0;
    }
  }
  draw();
}

async function loadDiff() {
  const want = state.chosen;
  // The text as it arrived is the comparison. Serialising the parsed answer
  // again to get a key copied the whole diff twice on every poll.
  const raw = await ask(want, "diff", "", true);
  if (raw === null || state.chosen !== want) return;
  if (raw !== state.diffRaw) {
    let body = null;
    try { body = JSON.parse(raw); } catch (error) { return; }
    // A session that has gone answers with an error, not a report. Drawing
    // that as if it were one is how the tab used to go blank and stay blank.
    if (!body.sections) return;
    state.diffRaw = raw;
    state.diff = body;
    state.diffAt += 1;
  }
  draw();
}

// Every block carries its place in the transcript, so a block that arrives
// twice lands in the same slot. Appending whatever arrived showed the whole
// history a second time after a reconnect, and could double a block that the
// first fetch and the first push both carried.
function mergeBlocks(blocks) {
  const moved = [];
  for (const block of blocks) {
    state.turns.blocks[block.seq] = block;
    moved.push(block.seq);
  }
  return moved;
}

function streamUrl() {
  return "/api/events" +
    (state.chosen ? "?watch=" + encodeURIComponent(state.chosen) : "");
}

function resubscribe() {
  const where = streamUrl();
  if (state.stream && state.streamUrl === where) return;
  if (state.stream) state.stream.close();
  state.streamUrl = where;
  const stream = new EventSource(where);
  state.stream = stream;

  stream.addEventListener("sessions", (message) => {
    document.body.classList.remove("offline");
    const body = JSON.parse(message.data);
    state.skew = body.now - Date.now() / 1000;
    // A link in the address bar chooses a session before this list exists,
    // and until it arrives `current()` is null and every tab draws its empty
    // state. This is the moment that session becomes a real one.
    const waiting = !!state.chosen && !current();
    state.sessions = body.sessions || [];
    if (!current() && state.sessions.length) {
      // Pick the first one for the reader. It has to go through choose(), or
      // the stream stays on watch="" and this session, the one actually on
      // screen, never receives a transcript update.
      const first = state.sessions[0].id;
      state.chosen = null;
      choose(first);
    } else if (waiting && current()) {
      draw();
    }
    drawSessions();
    drawHeader();
    state.live = "live";
    if (!state.find) paintLive();
  });

  stream.addEventListener("transcript", (message) => {
    const body = JSON.parse(message.data);
    if (body.id !== state.chosen) return;
    // A transcript can be rewritten under its own name, and then `seq` counts
    // from nought again. Patching by index would write the new blocks over the
    // head of the old ones and leave the old tail hanging below, so a new
    // reading replaces what is held rather than being merged into it.
    if (body.run !== undefined && body.run !== state.turns.run) {
      // The same `-1` guard `loadTranscript` carries, and for a sharper
      // reason: the first push can land before the first fetch has returned,
      // and then `run` is still -1 with nothing held. Replacing the blocks
      // there is right; forgetting the reader's place is not, and it threw
      // away a link the page had opened on whenever the machine was busy
      // enough to reverse those two.
      const held = state.turns.run !== -1;
      state.turns.run = body.run;
      state.turns.blocks = body.blocks || [];
      state.turns.nodes = [];
      if (held) forgetPlaces();
      draw();
      return;
    }
    patchTranscript(mergeBlocks(body.blocks || []));
  });

  stream.onopen = () => { document.body.classList.remove("offline"); };

  stream.onerror = () => {
    document.body.classList.add("offline");
    state.live = "reconnecting";
    if (!state.find) paintLive();
  };
}

// --- keys --------------------------------------------------------------------

function move(step) {
  const shown = listedSessions();
  if (!shown.length) return;
  const at = shown.findIndex((s) => s.id === state.chosen);
  const next = Math.min(shown.length - 1, Math.max(0, at + step));
  choose(shown[next].id);
  const row = document.querySelector(".row.chosen");
  if (row) row.scrollIntoView({ block: "nearest" });
}

// Over every session, not only the shown ones: this key is the answer to "who
// needs me", and a filter left in the box must not hide one of them.
function nextNeedsYou() {
  const waiting = state.sessions.filter((s) => s.state === "needs_you");
  if (!waiting.length) return;
  const at = waiting.findIndex((s) => s.id === state.chosen);
  choose(waiting[(at + 1) % waiting.length].id);
}

document.addEventListener("keydown", (press) => {
  const help = $("help");
  if (press.key === "Escape") {
    for (const box of document.querySelectorAll("dialog")) {
      if (box.open) box.close();
    }
    showAlerts(false);       // not a dialog, and it closes the same way
    return;
  }
  if (press.metaKey || press.ctrlKey || press.altKey) return;
  const tag = (press.target.tagName || "").toLowerCase();
  if (tag === "input" || tag === "textarea") return;   // typing, not commanding
  switch (press.key) {
    // Not on a tab that has no find box. This changes no behaviour -- a
    // browser will not focus an element it is not rendering, so the key was
    // already doing nothing there -- and it is here to say so rather than to
    // rest on that. There is no test, because there is nothing to perturb.
    case "/":
      if (!TABS[state.tab].finds) return;
      $("find").focus();
      break;
    case "f": $("pick").focus(); break;
    case "r": showTab("review"); break;
    case "Enter": jumpToPane(); break;
    case "s":
      if ($("sendbar").hidden) return;
      $("say").focus();
      break;
    case "j": move(1); break;
    case "k": move(-1); break;
    case "n": nextNeedsYou(); break;
    case "t": toggleThinking(); break;
    case "c": nextTheme(); break;
    case "?": help.open ? help.close() : help.showModal(); break;
    default: {
      // A tab per number key, in the order the tabs are drawn. The list is
      // the one in `TAB_KEYS`, so a new tab is an entry there and nothing
      // else: the keys used to be spelled out here and stopped at four, and
      // the fifth tab shipped with no key at all.
      const at = "123456789".indexOf(press.key);
      if (at < 0 || at >= TAB_KEYS.length) return;
      showTab(TAB_KEYS[at]);
