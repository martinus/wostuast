  branch: "M2.6 3a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0z"
          + "M2.6 11a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0z"
          + "M8.6 4a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0z"
