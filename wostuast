CLIENT_BACKLOG = 20

#: The live event log is moved aside as an archive when it passes this. No
#: archive is ever deleted: the history is what the log is for, and a year of
#: heavy use is a few hundred megabytes. See `archive_log`.
EVENTS_MAX_BYTES = 20 * 1024 * 1024

