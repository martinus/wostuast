QUIET_MAX = 12 * 3600


def state_dir() -> Path:
    """Where wostuast keeps its files. WOSTUAST_STATE overrides it, for tests."""
    override = os.environ.get("WOSTUAST_STATE")
    if override:
        return Path(override)
    base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
    return Path(base) / "wostuast"


def private_dir(path: Path) -> None:
    """Make the directory, and keep it to this user alone.

    The event log holds every prompt, every command an agent ran and every
    result it saw. On a shared machine the default 0o755 would let anyone read
    it. `mode=` applies only when the directory is created, so an existing one
    is corrected too.
    """
    try:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        path.chmod(0o700)
    except OSError:
        pass


def private_file(path: Path) -> None:
    """Keep a file we just wrote to this user alone."""
    try:
        path.chmod(0o600)
    except OSError:
        pass


def open_private(path: Path) -> Any:
    """Open a file for appending, and create it 0600 if it is not there.

    `open(path, "a")` creates at 0o666 & ~umask — 0644 under the usual one —
    and a `chmod` afterwards leaves a window in which the file is already on
    disk, already holding a prompt, and readable by anyone on the machine.
    That window does not close if the process dies inside it. The mode belongs
    at creation, which is what the `os.open` flags are for.
    """
    return os.fdopen(
        os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600),
        "a", encoding="utf-8")


def events_path() -> Path:
    return state_dir() / "events.jsonl"


def rotated_events_path() -> Path:
    """Where the log moves when it grows too big. It is still history."""
    return state_dir() / "events.1.jsonl"


def status_dir() -> Path:
    return state_dir() / "status"


def status_path(session_id: str) -> Path:
    """The status file of one session. The name is never trusted; see safe_name."""
    return status_dir() / f"{safe_name(session_id)}.json"


def names_path() -> Path:
    """The names the reader gave sessions, all of them in one file.

    Claude Code titles a session from its first prompt and `/rename` changes
    that, but the name it hands the status line is the one the session started
    with, so a rename in the terminal does not reach here until the session is
    started again. A name set on the page is kept by us and wins.
    """
    return state_dir() / "names.json"


def limits_path() -> Path:
    """Where the spend limits live. Beside the names, and for the same reason:
    both are what the reader told this program from the page."""
    return state_dir() / "limits.json"


def links_path() -> Path:
    """The reader's own autolinks: a ticket id in a transcript, turned into a
    link to wherever their tickets live.

    Yours, on your machine, across every session. It is not a settings file --
    `PLAN.md` rules those out -- it is a list of two-field entries, and the
    page works without it. `doctor` says what is wrong with a bad one.
    """
    return state_dir() / "links.json"


def log_path() -> Path:
    return state_dir() / "wostuast.log"


def settings_path() -> Path:
    """The Claude Code user settings file. CLAUDE_CONFIG_DIR overrides the dir."""
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    root = Path(base) if base else Path.home() / ".claude"
    return root / "settings.json"


def install_path() -> Path:
    return Path.home() / ".local" / "bin" / "wostuast"


def hook_command(target: Path) -> str:
    """The command install writes, doctor looks for, and uninstall removes."""
    import shlex

    return f"{shlex.quote(str(target))} hook"


def status_command(target: Path) -> str:
    """The same, for the status line."""
    import shlex

    return f"{shlex.quote(str(target))} status"


# --- log: a plain text log, so a broken hook leaves a trace ------------------


def log(message: str) -> None:
    """Append one line to the log file. Never raise."""
    try:
        path = log_path()
        private_dir(path.parent)
        rotate(path, LOG_MAX_BYTES, path.with_name(path.name + ".1"))
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        with open_private(path) as handle:
            handle.write(f"{stamp} {message}\n")
    except Exception:
        pass


def write_atomic(path: Path, text: str, private: bool = False,
                 mode: int | None = None, sync: bool = False) -> None:
    """Write the whole file or none of it, so a reader never sees half a file.

    The temporary name carries this process's pid and the writing thread. A
    fixed name would be shared by two writers, and one could rename the
    other's half-written file into place — or unlink it from under the other,
    which is how a `POST /name` beside another one raised `FileNotFoundError`
    into a browser's request. The status line runs on every redraw, so two
    processes is normal, and the daemon answers every browser in a thread of
    its own.

    `mode` keeps a file's own permissions: a new file takes the umask, which
    for `settings.json` meant 0600 came back 0644. `sync` puts the bytes and
    then the rename on the disk, which costs a wait — the status line writes on
    every redraw, so it is asked for rather than given.
    """
    if private:
        private_dir(path.parent)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    import threading

    temporary = path.with_name(
        f"{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    try:
        temporary.write_text(text, encoding="utf-8")
        if private:
            temporary.chmod(0o600)
        elif mode is not None:
            temporary.chmod(mode)
        if sync:
            with open(temporary, "rb") as handle:
                os.fsync(handle.fileno())
        temporary.replace(path)
        if sync:
            # The rename is on the disk only once the directory is. Without
            # this, a power loss right here can leave the file empty — and
            # `settings.json` is the one file Claude Code will not start
            # without. Not every filesystem allows the open; the write has
            # landed either way, so a refusal is not an error.
            try:
                folder = os.open(path.parent, os.O_RDONLY)
            except OSError:
                return
            try:
                os.fsync(folder)
            except OSError:
                pass
            finally:
                os.close(folder)
    finally:
        try:
            temporary.unlink()
        except OSError:
            pass


def rotate(path: Path, limit: int, backup: Path) -> None:
    """Move the file aside when it grows past the limit. Never raise."""
    try:
        if path.exists() and path.stat().st_size > limit:
            path.replace(backup)
    except OSError:
        pass


# --- event log: append only, one JSON object per line ------------------------


def still_the_file(handle: Any, target: Path) -> bool:
    """Is the handle we are holding still the file at that name?

    A `flock` is on an inode, not on a name. Between opening a file and
    getting its lock, another process can rename it away — and then the lock
    we were waiting for is a lock on something that is no longer the log.
    """
    try:
        ours = os.fstat(handle.fileno())
        there = os.stat(target)
    except OSError:
        return False
    return (ours.st_dev, ours.st_ino) == (there.st_dev, there.st_ino)


def append_event(record: dict[str, Any]) -> None:
    """Append one event. The caller has already added ts, pane and pid.

    Two hooks can reach the size limit at the same moment, and the lock alone
    does not order them: it is taken on the inode, so a hook that opened the
    log before another rotated it holds the *archive*, sees a file over the
    limit, and renames the fresh log on top of the archive — every event ever
    recorded, gone. Measured, before `still_the_file` was here to stop it. A
    hook that finds it is holding the wrong inode simply opens again.

    Surrogates are replaced rather than raising. `json.dumps` emits a lone
    surrogate happily and a UTF-8 encoder refuses it, so one in a tool response
    lost the whole event — and a `SessionStart` lost that way costs the session
    its cwd, pane and pid for good. (Naming the escape here in the usual way
    would put a real lone surrogate in this docstring, and Python 3.13 cannot
    write that into a bytecode cache. It broke CI on 3.13 alone.)
    """
    target = events_path()
    private_dir(target.parent)
    raw = json.dumps(record, ensure_ascii=False, default=str) + "\n"
    line = raw.encode("utf-8", "replace").decode("utf-8")
    for _ in range(3):        # a rotation under us; the next open finds it
        with open_private(target) as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            if not still_the_file(handle, target):
                continue      # someone rotated while we waited; open the new one
            if os.fstat(handle.fileno()).st_size > EVENTS_MAX_BYTES:
                os.replace(target, rotated_events_path())
                # The handle still points at the file we just renamed. Open the
                # fresh one, so this event lands there rather than in the
                # archive. It is created 0600, like every file we make.
                with open_private(target) as fresh:
                    fcntl.flock(fresh.fileno(), fcntl.LOCK_EX)
                    fresh.write(line)
                return
            handle.write(line)
            handle.flush()
            return


def count_events() -> int:
    """How many lines the log holds. It counts newlines, it does not parse."""
    total = 0
    for path in (rotated_events_path(), events_path()):
        try:
            with open(path, "rb") as handle:
                total += sum(chunk.count(b"\n") for chunk in iter(lambda: handle.read(1 << 20), b""))
        except OSError:
            continue
    return total


def read_events() -> Iterator[dict[str, Any]]:
    """Read the whole log from the start, oldest file first.

    The rotated file comes first because it holds the older half. Reading only
    the current file would lose the SessionStart of every session that began
    before the last rotation, and with it their cwd, pane and pid.
    """
    for path in (rotated_events_path(), events_path()):
        yield from read_event_file(path)


def json_objects(lines: Iterable[bytes]) -> Iterator[dict[str, Any]]:
    """Turn lines into the JSON objects among them, and skip the rest.

    `json.loads` takes bytes and decodes them itself, in C, which is quicker
    than decoding the file first. Broken UTF-8 raises UnicodeDecodeError, and
    that is a ValueError, so one clause covers a torn line and a bad byte
    alike. Every reader of a JSON-lines file goes through here.
    """
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            yield record


def read_event_file(target: Path) -> Iterator[dict[str, Any]]:
    """Read one log file from the start. A missing file is empty.

    It streams the file line by line rather than going through `Tail`, which
    reads the whole remainder at once: this one is used on a log that may be
    20 MB, and only needs a line at a time.
    """
    if not target.exists():
        return
    with open(target, "rb") as handle:
        yield from json_objects(handle)


# --- following files: read what is new, keep a half-written last line --------


@dataclass
class Tail:
    """Reads the new lines of a file that grows, and nothing twice.

    It remembers how far it has read and holds back a last line that has no
    newline yet, because a writer can be caught mid-line. It also remembers
    which file it was reading, by device and inode, so a file replaced under
    the same name starts again from the beginning instead of seeking past the
    end of a smaller one and going quiet for ever.
    """

    path: Path
    offset: int = 0
    partial: bytes = b""
    key: tuple[int, int] = (0, 0)
    #: True when the last read started over rather than carried on. A caller
    #: that accumulates what it reads has to hear about that: the event log
    #: does not care, because `Store.apply` drops an event it has seen, but a
    #: transcript reader that only appends will draw the whole file twice.
    restarted: bool = False

    def read_new(self) -> list[bytes]:
        self.restarted = False
        try:
            info = self.path.stat()
        except OSError:
            return []
        key = (info.st_dev, info.st_ino)
        if key != self.key:
            started = self.key != (0, 0)     # not the first look at this name
            self.key, self.offset, self.partial = key, 0, b""
            self.restarted = started
        elif info.st_size < self.offset:  # rewritten shorter, under the same name
            self.offset, self.partial = 0, b""
            self.restarted = True
        if info.st_size == self.offset:
            return []
        try:
            with open(self.path, "rb") as handle:
                handle.seek(self.offset)
                data = handle.read()
        except OSError:
            return []
        self.offset += len(data)
        head, newline, rest = (self.partial + data).rpartition(b"\n")
        self.partial = rest
        if not newline:
            return []
        return [line for line in head.split(b"\n") if line.strip()]


class EventFollower:
    """Follows the event log, both files of it.

    The hook rotates the log, not the daemon, so the file can be renamed under
    the follower at any moment, and a daemon can start when a rotation has
    already happened. One tail on each name covers both: the archive is read
    whole on the first look and is quiet after that, and a rotation simply
    looks like a new file under each name.

    A rotation makes the archive tail read events it has already delivered.
    That is safe because `Store.apply` ignores an event older than the session
    it belongs to has already seen.
    """

    def __init__(self) -> None:
        self.older = Tail(rotated_events_path())
        self.tail = Tail(events_path())

    def new_lines(self) -> list[bytes]:
        return self.older.read_new() + self.tail.read_new()

    def new_events(self) -> Iterator[dict[str, Any]]:
        yield from json_objects(self.new_lines())


# --- session model: the state machine of section 4.3 -------------------------


@dataclass
class GitFacts:
    """What git says about the directory an agent stands in."""

    repo: str = ""
    branch: str = ""
    ahead: int = 0
    behind: int = 0
    dirty: bool = False
    touched_files: int = 0
    #: git did not answer about a directory that is a repository. Empty facts
    #: read as a clean repository with no branch, which is a real state and
    #: not this one — and they used to be remembered as the answer.
    failed: bool = False


@dataclass
class Status:
    """The latest status line payload of a session, written by `wostuast status`."""

    ts: float = 0.0
    name: str = ""
    model: str = ""
    context_pct: float | None = None
    #: What this session has spent, in dollars. Claude Code works it out on
    #: the client at list price and says so: it may differ from the bill, and
    #: it goes back to nought on `/clear`. The page carries that caveat rather
    #: than dropping the number, because an estimate you can see beats a bill
    #: you cannot. `None` is "the status line did not say", which is not 0.
    cost_usd: float | None = None
    #: The claude.ai rate-limit windows, `{name: {used_pct, resets_at}}`.
    #: Present only for Pro and Max subscribers, or behind a gateway that sets
    #: a spend limit, and only after the first API response -- and Claude Code
    #: drops a window once its reset has passed. So an empty map means "not
    #: told", never "nothing used". `spend_limit` can read above 100.
    limits: dict[str, dict[str, float]] = field(default_factory=dict)
    agent: str = ""
    version: str = ""


@dataclass
class Session:
    """One Claude Code session, built from its events."""

    session_id: str
    cwd: str = ""
    #: Where this session started. `cwd` is the directory the agent is
    #: standing in, and Claude Code moves it the moment the agent changes
    #: directory -- so a row that said `repo/dir` renamed itself to
    #: `repo/src` mid-turn, and the one fact you cannot read anywhere else on
    #: the page moved under you. Stamped by `SessionStart`, because a resumed
    #: session really does start somewhere else, and otherwise only while
    #: nothing is known yet. Read through `place`, never on its own.
    home: str = ""
    pane: str = ""
    pid: int = 0
    transcript_path: str = ""
    state: str = "done"
    #: The moment this session last became what it is, which is what the list
    #: is ordered by. Moved in one place -- `Store.apply`, and `settle` for
    #: the two states nothing reports -- because a handler assigns the same
    #: state over and over and only a change is a change.
    state_since: float = 0.0
    last_ts: float = 0.0
    last_event: str = ""
    last_prompt: str = ""
    last_tool: str = ""
    reason: str = ""
    attention_since: float = 0.0
    # True once this session has sent a PermissionRequest. That event is
    # the same news as a permission Notification, up to twelve seconds
    # earlier, so once it arrives the Notification is only ever stale.
    asks_first: bool = False
    #: The last few things this session did, newest last, for the Session tab.
    #: Bounded, because a session that runs all day would otherwise keep every
    #: event it ever sent in memory.
    log: list[dict[str, Any]] = field(default_factory=list)
    #: How many of each event this session has sent. Not a `Counter`, so it
    #: serialises as it stands.
    counts: dict[str, int] = field(default_factory=dict)
    #: What the open permission dialog is about, as `tool_summary` says it.
    #: Empty when no dialog is open, or when the event did not name a tool.
    asked_about: str = ""
    #: The question the agent is waiting on, when it is waiting on one. See
    #: `read_ask`. It is cleared wherever the attention is, and precisely by
    #: its own `tool_use_id` when the answer lands.
    asking: dict[str, Any] | None = None
    end_reason: str = ""
    last_compaction: float = 0.0
    git: GitFacts = field(default_factory=GitFacts)
    status: Status = field(default_factory=Status)

    #: A name the reader gave this session on the page. It wins over the one
    #: Claude Code sent, which is the name the session started with.
    mine: str = ""

    @property
    def label(self) -> str:
        """What to call this session: its name, and where it is standing.

        Claude Code titles a session from its first prompt, so most sessions
        have a name whether or not anyone ran `/rename`. The name alone reads
        well but loses the worktree, which is the thing you need when several
        agents are running, so both are shown. A session with no name is just
        its place.
        """
        place = self.place
        name = self.mine or self.status.name
        if not name:
            return place
        return f"{clip(name, 40)} · {place}"

    @property
    def place(self) -> str:
        """Where this session is, in two levels, and it does not move.

        `home` and not `cwd`: see the field. One spelling, because the row,
        the label and the list's tiebreaker all ask the same question and a
        second spelling is how one of them starts answering it differently.
        """
        return path_label(self.home or self.cwd, self.git.repo)

    @property
    def since(self) -> float:
        """The moment a row's age counts from: the wait, or the last event."""
        return self.attention_since if self.state == "needs_you" else self.last_ts

    @property
    def settled(self) -> float:
        """The moment this session last became what it is. The list's order.

        Not `since`, which for a working session is the last event and so
        moves every few seconds: two busy agents would swap places while you
        read them. This one moves when a turn begins, ends, or stops on a
        question -- the same moments the row changes band, so the list moves
        once instead of twice.
        """
        return self.state_since or self.last_ts


def path_label(cwd: str, repo: str = "") -> str:
    """`repo/dirname` for a worktree, plain `dirname` when both are the same."""
    if not cwd:
        return "?"
    name = os.path.basename(cwd.rstrip("/")) or cwd
    if repo and repo != name:
        return f"{repo}/{name}"
    return name


def tool_target(tool_name: str, tool_input: Any, cwd: str = "") -> str:
    """What a call worked on: the path, the command, or the pattern.

    This is the general question. `tool_summary` is this with the tool's name
    in front, which is why the two cannot disagree.
    """
    data = tool_input if isinstance(tool_input, dict) else {}

    def short_path(value: Any) -> str:
        text = str(value or "")
        base = cwd.rstrip("/")
        return text[len(base) + 1 :] if base and text.startswith(base + "/") else text

    if tool_name in ("Read", "Write", "Edit", "MultiEdit", "NotebookEdit"):
        return short_path(
            data.get("file_path") or data.get("notebook_path") or data.get("path")
        )
    if tool_name == "Bash":
        return clip(str(data.get("command") or ""), 60)
    if tool_name in ("Grep", "Glob"):
        return clip(str(data.get("pattern") or ""), 60)
    if tool_name == "Task":
        return clip(str(data.get("description") or ""), 60)
    if tool_name == "AskUserQuestion":
        # The headers, which is what the dialog puts over each question. The
        # catch-all below clipped the JSON at 80 characters, so the one row
        # that exists to say what the agent wants read
        # `{"questions": [{"question": "Approve the pla…`.
        asked = data.get("questions")
        if not isinstance(asked, list):
            return ""
        heads = [str(one.get("header") or one.get("question") or "")
                 for one in asked if isinstance(one, dict)]
        return clip(", ".join(one for one in heads if one), 60)
    if not data:
        return ""
    return clip(json.dumps(data, ensure_ascii=False, default=str), 80)


#: The most of one question, and of one ask, that is kept. A question is
#: written to be read on a terminal, so these are generous; the cap is here
#: because this goes into every row, to every browser, on every push.
ASK_TEXT_MAX = 2000
ASK_MAX = 8


def read_ask(event: dict[str, Any]) -> dict[str, Any] | None:
    """The question an agent is waiting on, in the shape the page draws.

    `AskUserQuestion` is a tool, so the whole of it arrives in `tool_input`
    on `PreToolUse` -- every question, every option, every description --
    and again on `PermissionRequest` 90 milliseconds later. The event log
    keeps the payload whole, as it keeps every payload. This is the other
    half of that rule: what goes into a row, and so to every browser on
    every push, is only what is drawn, named field by field. A field we did
    not read cannot reach the page and cannot surprise it.

    None when the event is not an ask, or holds no question anybody could
    answer. The page shows nothing then, which is what it did before.
    """
    if str(event.get("tool_name") or "") != "AskUserQuestion":
        return None
    data = event.get("tool_input")
    asked = data.get("questions") if isinstance(data, dict) else None
    if not isinstance(asked, list):
        return None
    questions: list[dict[str, Any]] = []
    for one in asked[:ASK_MAX]:
        if not isinstance(one, dict):
            continue
        options = []
        for choice in (one.get("options") or [])[:ASK_MAX]:
            if not isinstance(choice, dict):
                continue
            options.append({
                "label": clip(str(choice.get("label") or ""), ASK_TEXT_MAX),
                "description": clip(str(choice.get("description") or ""),
                                    ASK_TEXT_MAX),
            })
        if not options:
            continue        # nothing to pick, so nothing to draw
        questions.append({
            "question": clip(str(one.get("question") or ""), ASK_TEXT_MAX),
            "header": clip(str(one.get("header") or ""), 80),
            "many": bool(one.get("multiSelect")),
            "options": options,
        })
    if not questions:
        return None
    # `PreToolUse` carries this and `PermissionRequest` does not, which is why
    # the ask is read from the first of the two: it is what says, exactly,
    # that this question and not another one has been answered.
    return {"id": str(event.get("tool_use_id") or ""), "questions": questions}


def tool_summary(tool_name: str, tool_input: Any, cwd: str = "") -> str:
    """One short line for a tool call: the tool, then what it worked on."""
    return f"{tool_name or 'tool'} {tool_target(tool_name, tool_input, cwd)}".strip()


def clip(text: str, width: int) -> str:
    """Cut text to width and mark the cut."""
    text = " ".join(text.split())
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


class Store:
    """Every session, and the rows the page shows. The one piece of state.

    The daemon keeps one and a single thread writes it; readers take `rows`,
    which is replaced whole and never edited in place, so they need no lock and
    can never see half of an update.
    """

    def __init__(self) -> None:
        self.sessions: dict[str, Session] = {}
        self.follower = EventFollower()
        self.rows: list[dict[str, Any]] = []
        self.git_read: dict[str, float] = {}
        self.git_wanted: set[str] = set()
        self.status_seen: dict[str, float] = {}
        self.liveness_checked = 0.0
        import threading

        # The names the reader gave. Written by whichever thread took the
        # rename and read by the one that folds, so it is replaced whole
        # rather than edited — the same trick `rows` plays, for the same
        # reason: a reader never sees half a change.
        #
        # A writer does need the lock, though. Two `POST /name` requests run
        # at once in one process, and both built the new map from the same
        # snapshot: one name was lost, and memory and the file disagreed
        # about which, so a restart silently swapped them.
        self.names: dict[str, str] = read_names()
        self.limits: dict[str, dict[str, float]] = read_limits()
        self.naming = threading.Lock()

    def get(self, session_id: str) -> Session:
        session = self.sessions.get(session_id)
        if session is None:
            session = Session(session_id=session_id)
            self.sessions[session_id] = session
        return session

    def apply(self, event: dict[str, Any]) -> Session | None:
        """Fold one event into its session. Returns the session it changed."""
        session_id = str(event.get("session_id") or "")
        if not session_id:
            return None
        session = self.get(session_id)
        name = str(event.get("hook_event_name") or "")
        ts = to_float(event.get("ts"))

        if ts and ts < session.last_ts:
            # Older than what this session has already folded. A rotation makes
            # the archive deliver events a second time, and replaying them here
            # would set the state back to what it was then.
            return session
        # Strictly newer, which is the one question that makes appending
        # safe. `apply` drops what is *older* than the session has seen, but
        # an event with the very same `ts` folds again, and a rotation
        # re-delivers the newest one — so a list that grew, or a number that
        # went up, would do it twice. Everything else here assigns, and this
        # is the rule that lets these two accumulate. Two events in one
        # instant cost this log the second of them, and nothing else.
        fresh = bool(ts) and ts > session.last_ts
        if ts > session.last_ts:
            session.last_ts = ts
        for key in ("cwd", "transcript_path"):
            value = event.get(key)
            if value:
                setattr(session, key, str(value))
        # A session starts once, and every event after that carries wherever
        # the agent has walked to since. `SessionStart` is the one event that
        # means "this is where I am starting", and a resume really does start
        # a session in another directory, so it is the one that may move this.
        if session.cwd and (not session.home or name == "SessionStart"):
            session.home = session.cwd
        pane = str(event.get("pane") or "")
        if pane and PANE_PATTERN.match(pane):
            session.pane = pane
        pid = to_int(event.get("pid"))
        if pid:
            session.pid = pid

        handler = _HANDLERS.get(name)
        was = session.state
        if handler is not None:
            handler(session, event, ts)
        elif name:
            session.last_event = name
        # Only a change. Every handler assigns a state whether or not it is a
        # new one -- `_on_pre_tool` writes "working" on every tool call -- and
        # moving this each time would put the list back to sorting by the last
        # event, which is what it must not do.
        if session.state != was:
            session.state_since = ts or session.last_ts

        if fresh and name:
            # After the handler, so the line is the one it wrote: the Session
            # tab says what the row says, in the order it happened.
            session.counts[name] = session.counts.get(name, 0) + 1
            session.log.append({"ts": ts, "name": name,
                                "text": session.last_event})
            if len(session.log) > SESSION_LOG_MAX:
                del session.log[:-SESSION_LOG_MAX]

        if session.cwd and touched_the_tree(name, event):
            self.git_wanted.add(session.cwd)
        return session

    def fold(self, events: Iterable[dict[str, Any]]) -> None:
        for event in events:
            self.apply(event)

    def follow(self) -> None:
        """Fold whatever has been appended since the last look."""
        self.fold(self.follower.new_events())

    def visible(self, now: float) -> list[Session]:
        """The sessions worth showing. A session too old to show is forgotten,
        not merely hidden: the daemon runs for days and everything hung off a
        session id, transcript readers included, would be kept with it."""
        for session_id, session in list(self.sessions.items()):
            if now - session.last_ts > SESSION_MAX_AGE:
                del self.sessions[session_id]
        return list(self.sessions.values())

    def refresh(
        self, now: float | None = None, alive: Callable[[int], bool] | None = None
    ) -> bool:
        """Bring everything up to date and rebuild the rows.

        Returns True when the rows changed, which is also the daemon's answer
        to "is there anything to tell the browsers about?".
        """
        moment = now if now is not None else time.time()
        self.follow()
        sessions = self.settle(moment, alive)
        self.reload_git(sessions, moment)
        rows = [row(session) for session in sort_sessions(sessions)]
        # The limits are the page's, not the session's, so they are put on
        # here rather than inside `row` -- the same shape as the names, which
        # `settle` reads onto `session.mine` one call above.
        for one in rows:
            kept = self.limits.get(one["id"])
            if kept:
                one["spend_limit"] = kept["limit"]
                one["limit_fired"] = kept["fired_at"]
        changed = rows != self.rows
        self.rows = rows
        return changed

    def settle(
        self, moment: float, alive: Callable[[int], bool] | None = None
    ) -> list[Session]:
        """The sessions worth showing, with their cheap facts brought up to date.

        `build_sessions` calls this too, so "which sessions are shown, and how
        fresh they are" is written down once. A new Store has never checked
        liveness, so the first call always does.
        """
        sessions = self.visible(moment)
        if moment - self.liveness_checked >= LIVENESS_INTERVAL:
            self.liveness_checked = moment
            for session in sessions:
                mark_dead(session, alive, moment)
        for session in sessions:
            self.reload_status(session)
            session.mine = self.names.get(session.session_id, "")
        return sessions

    def reload_git(self, sessions: Sequence[Session], moment: float) -> None:
        """Read git for the directories that asked, and for any we have never
        read. Both are held to one run per directory per GIT_MIN_INTERVAL,
        because git status on a large worktree is not cheap."""
        never_read = {s.cwd for s in sessions if s.cwd and s.cwd not in self.git_read}
        asked = self.git_wanted | never_read
        ready = {
            directory
            for directory in asked
            if moment - self.git_read.get(directory, 0.0) >= GIT_MIN_INTERVAL
        }
        # Keep the ones still inside the cool-down. Clearing them all dropped
        # the request instead of deferring it, so a write that landed just
        # after a git run left the row stale for good.
        self.git_wanted = asked - ready
        wanted = sorted(ready)
        if not wanted:
            return
        facts = git_facts_many(wanted)
        # The cool-down applies either way, so a worktree whose `status`
        # always passes its timeout is not asked every tick. But a failure is
        # neither written over what we knew nor left standing as the answer:
        # it goes back on the list, and is asked again when the cool-down is
        # up. It used to be recorded as read and assigned over the good facts,
        # so an idle session kept "no branch, clean" until a tool call.
        self.git_read.update(dict.fromkeys(facts, moment))
        self.git_wanted |= {
            directory for directory, one in facts.items() if one.failed}
        for session in sessions:
            one = facts.get(session.cwd)
            if one is not None and not one.failed:
                session.git = one

    def set_limit(self, session_id: str, limit: float) -> float:
        """Set what a session may spend, or take the limit away with nought.

        The map is replaced rather than edited, the trick `rename` plays and
        for the same reason: the thread folding events reads it and must never
        see a half-written one. Setting a limit clears `fired_at`, so raising
        it after a stop is how an agent is let go again -- otherwise the limit
        would fire on the next tick, for ever, and the session would be stuck.
        """
        with self.naming:
            limits = dict(self.limits)
            if limit > 0:
                limits[session_id] = {"limit": limit, "fired_at": 0.0}
            else:
                limits.pop(session_id, None)
            write_limits(limits)
            self.limits = limits
        return max(0.0, limit)

    def over_limit(self, now: float | None = None) -> list[str]:
        """The panes of sessions that have just gone past what they may spend.

        Read on the fold thread, which is the one that may write `fired_at`.
        Three guards, each of them a way this could be worse than no limit:

        * **Only a session that is working.** Stopping an idle one is a
          keystroke nobody asked for, and an Escape while a permission dialog
          is up declines it -- which is a decision, and not this one's to make.
        * **Once.** `fired_at` is stamped before the key goes out, so a
          session over its limit is not stopped again on every tick a second
          later. Raising the limit clears it.
        * **Only a spend the status line actually gave us.** `None` is "not
          told", and stopping an agent over a number nobody sent would be the
          worst of the three.
        """
        moment = now if now is not None else time.time()
        out: list[str] = []
        # The whole of it under the lock, reading and writing the same
        # snapshot. Deciding outside it and merging inside was a race with
        # `set_limit`: a raise that landed in between was overwritten with the
        # old number and a fresh `fired_at`, and the Escape went out anyway --
        # so the reader's release was undone at the moment they made it.
        with self.naming:
            limits = dict(self.limits)
            changed = False
            for session_id, one in limits.items():
                session = self.sessions.get(session_id)
                spent = None if session is None else session.status.cost_usd
                # Armed again once the spend is back under the limit. Without
                # this one stop disarms it for the rest of the session, and
                # `/clear` puts `cost.total_cost_usd` back to nought -- so the
                # agent could then run without bound behind a box still
                # showing a limit.
                if one["fired_at"] and spent is not None and spent < one["limit"]:
                    limits[session_id] = {"limit": one["limit"], "fired_at": 0.0}
                    changed = True
                    continue
                if one["fired_at"]:
                    continue
                if session is None or session.state != "working" or not session.pane:
                    continue
                if spent is None or spent < one["limit"]:
                    continue
                limits[session_id] = {"limit": one["limit"], "fired_at": moment}
                changed = True
                out.append(session.pane)
                session.last_event = f"stopped at its ${one['limit']:.2f} limit"
            if changed:
                write_limits(limits)
                self.limits = limits
        return out

    def rename(self, session_id: str, name: str) -> str:
        """Give a session a name, or take the name away when it is empty.

        Returns what the name now is. The map is replaced rather than edited
        so that the thread folding events never reads a half-written one.
        """
        clean = " ".join(name.split())[:NAME_MAX]
        with self.naming:
            names = dict(self.names)
            if clean:
                names[session_id] = clean
            else:
                names.pop(session_id, None)
            write_names(names)
            self.names = names
        session = self.sessions.get(session_id)
        if session is not None:
            session.mine = clean
        return clean

    def reload_status(self, session: Session) -> None:
        """Read the status file again, but only when it has been written."""
        try:
            mtime = status_path(session.session_id).stat().st_mtime
        except OSError:
            return
        if self.status_seen.get(session.session_id) == mtime:
            return
        self.status_seen[session.session_id] = mtime
        session.status = read_status(session.session_id)


def touched_the_tree(event_name: str, event: dict[str, Any]) -> bool:
    """True when this event suggests the working tree may have changed."""
    if event_name == "Stop":
        return True
    if event_name in ("PostToolUse", "PostToolUseFailure"):
        return str(event.get("tool_name") or "") in WRITING_TOOLS
    return False


def row(session: Session) -> dict[str, Any]:
    """One session as the page wants it: flat, small, and ready to compare.

    It is built by hand rather than from the dataclass, so that adding a field
    to `Session` never quietly sends something to the browser. Rows are
    compared with `!=` to decide what to push, so everything in here must be a
    plain value, and nothing in here may depend on the current time: a row that
    ages by itself would look changed every second and the page would be sent
    the whole list for ever. `since` is a moment, and the page counts from it.
    """
    facts = session.git
    return {
        "id": session.session_id,
        "label": session.label,
        # Apart, as well as together. The row puts the worktree first and in
        # front, because that is the one fact you cannot read anywhere else on
        # the page; the name Claude Code wrote from the first prompt is often
        # long and often vague, and it used to push the worktree off the end.
        "place": session.place,
        "state": session.state,
        "state_word": STATE_WORDS.get(session.state, session.state),
        "cwd": session.cwd,
        "pane": session.pane,
        "repo": facts.repo,
        "branch": facts.branch,
        "ahead": facts.ahead,
        "behind": facts.behind,
        "dirty": facts.dirty,
        "touched_files": facts.touched_files,
        "reason": session.reason,
        # The question the agent is waiting on, so the page can draw it over
        # whatever tab you are reading. It is here and not on a route of its
        # own because it must arrive with the amber, not a fetch later.
        "asking": session.asking,
        "last_event": session.last_event,
        "last_tool": session.last_tool,
        "last_prompt": session.last_prompt,
        "since": round(session.since, 3),
        "name": session.mine or session.status.name,
        # Whether that name is one the reader set here. The page shows the
        # box with it in, rather than making them type it again to change it.
        "mine": bool(session.mine),
        "model": session.status.model,
        "context_pct": session.status.context_pct,
        # What the session has spent, and how much of a rate-limit window it
        # has used. Both move only when a status line lands, so neither makes
        # a row differ by itself -- which is the rule this dict is built by.
        "cost_usd": session.status.cost_usd,
        "limits": session.status.limits,
        # What this session may spend, and whether that has already stopped
        # it. Filled in by `rows`, from the map the page POSTs to.
        "spend_limit": 0.0,
        "limit_fired": 0.0,
        "end_reason": session.end_reason,
        "has_transcript": bool(session.transcript_path),
    }


def _clear_attention(session: Session) -> None:
    """Forget that the agent was waiting. Every caller sets the state itself.

    The open question goes with it. A question you can still answer on a row
    that is no longer waiting is the same bug as a stale permission line, and
    this one has buttons on it.
    """
    session.attention_since = 0.0
    session.reason = ""
    session.asked_about = ""
    session.asking = None


def _on_session_start(session: Session, event: dict[str, Any], ts: float) -> None:
    # A session that has just started is waiting at its prompt, which is what
    # "ready" means. It used to say "starting" and settle to this after five
    # minutes — a word that was true for a moment and wrong for a day, because
    # `SessionStart` is often the only event a session ever sends.
    #
    # Every handler that sets a state clears the attention with it. This one
    # did not, so a session killed at its permission dialog and then resumed
    # came back reading "ready" with "permission: Bash rm -rf ~" under it, and
    # a wait that had started before the agent died. `source=compact` reaches
    # here mid-session and left the same.
    _clear_attention(session)
    session.state = "done"
    session.end_reason = ""
    source = str(event.get("source") or "")
    session.last_event = f"started ({source})" if source else "started"


def _on_prompt(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    session.state = "working"
    # Cut it here, once. Keeping the whole of a pasted prompt would put it in
    # every row, to be compared every tick and sent to the browser every time.
    session.last_prompt = clip(str(event.get("prompt") or ""), PROMPT_WIDTH)
    session.last_event = f"prompt: {session.last_prompt}"


def _on_pre_tool(session: Session, event: dict[str, Any], ts: float) -> None:
    """A call starting, or a result arriving. Both mean the agent is running.

    Whether either answers the open permission question depends on which it
    is, and that is the whole of this:

    **A call starting says the agent moved on**, so the question was answered
    — allowed, or denied, which fires no hook of its own and leaves this as
    the only sign. Nothing new starts while a dialog is up; that is what the
    dialog does.

    **A call finishing says only that that call finished.** Claude Code runs
    two tools at once now and then — measured over 233 calls on a real
    machine, one started while another was still open — and both `PreToolUse`
    events come before the dialog, so the other call can report back while it
    is still on screen. Clearing on that turned the row green while the agent
    sat blocked. That is the one thing this program exists to say, said
    backwards.

    `PermissionRequest` carries no `tool_use_id`, so a result cannot be paired
    to it exactly. It carries `tool_name` and `tool_input`, which is what
    `tool_summary` is made of, and that separates two Bash calls — which is
    what the measured overlap was. Two runs of the *same* command at the same
    moment still cannot be told apart. Nothing in the payload can.
    """
    summary = tool_summary(
        str(event.get("tool_name") or ""), event.get("tool_input"), session.cwd
    )
    starting = str(event.get("hook_event_name") or "") == "PreToolUse"
    if starting or not session.asked_about or session.asked_about == summary:
        # The state goes with the attention. A row that stays amber because
        # the dialog is still up must not also say it is working.
        _clear_attention(session)
        session.state = "working"
    # What happened is still the latest thing that happened, either way.
    session.last_tool = summary
    session.last_event = session.last_tool
    if starting:
        # After the clear above, or the ask would be wiped by its own call
        # starting. It is None for every tool but this one.
        session.asking = read_ask(event)
    elif (session.asking
          and str(event.get("tool_use_id") or "") == session.asking["id"]):
        # This exact question was answered. Not "a call finished": two calls
        # really do overlap, and the other one finishing is not an answer.
        session.asking = None


def _on_tool_failed(session: Session, event: dict[str, Any], ts: float) -> None:
    """The tool ran and failed, or was interrupted or timed out.

    It does not cover a denied permission. Saying No to the dialog fires no
    hook at all, which was measured against a real session: the log ends at the
    `Notification` and nothing follows it. So wostuast cannot see a denial, and
    a session that was denied keeps the waiting state it already had. That is
    not wrong, because the agent really is waiting for you to say what to do
    instead; only the reason it shows is older than it looks.
    """
    name = str(event.get("tool_name") or "")
    summary = tool_summary(name, event.get("tool_input"), session.cwd) if name else "tool"
    # A call finishing, so the same pairing `_on_pre_tool` does: a failure of
    # the other call is not an answer to the question this one is asking.
    if not session.asked_about or session.asked_about == summary:
        _clear_attention(session)
        session.state = "working"
    if event.get("is_interrupt"):
        session.last_event = f"{summary} interrupted"
    else:
        session.last_event = f"{summary} failed"


def _on_permission_request(session: Session, event: dict[str, Any], ts: float) -> None:
    """The permission dialog is on screen. This is the moment you are needed.

    `Notification` says the same thing, but only after you have been idle for
    six seconds, and it is checked on a six second timer, so it arrives up to
    twelve seconds late. For a tool whose first job is answering "who needs
    me?", that is too slow. This event fires as the dialog appears.
    """
    session.asks_first = True
    session.state = "needs_you"
    session.attention_since = ts
    name = str(event.get("tool_name") or "")
    summary = tool_summary(name, event.get("tool_input"), session.cwd) if name else ""
    session.asked_about = summary
    if name == "AskUserQuestion":
        # Not a permission. It is a question with answers written out, and a
        # row saying "permission" for it sent you looking for a dialog that
        # asks something else. The question itself is on the page.
        asked = tool_target(name, event.get("tool_input"), session.cwd)
        session.reason = f"asks: {asked}" if asked else "asks a question"
    else:
        session.reason = f"permission: {summary}" if summary else "permission"


def _on_notification(session: Session, event: dict[str, Any], ts: float) -> None:
    """What a notification means, and the two it is not allowed to mean.

    An idle prompt is not "needs you". The agent finished its turn and sits at
    its prompt, which `Stop` already said. Nothing here blocks it, so nothing
    you do clears it either, and a row that turned amber on this stayed amber
    for the rest of the day. It keeps the state it has and says why it is
    quiet.

    A permission notification is the same news as `PermissionRequest`, up to
    twelve seconds later. On a session that sends that event the notification
    can only be stale: by now the dialog is either still up, and the row
    already says so, or it was answered while this was on its way, and
    honouring it would raise the alarm again for a question that is gone.
    """
    kind = str(event.get("notification_type") or "")
    message = str(event.get("message") or "")
    if not kind:
        # Older Claude Code versions send no type, so the message is all there
        # is. Recognise the two that mean something and call the rest what
        # they are: anything else used to be taken for a permission prompt,
        # and `auth_success` — "Logged in as …" — turned the row amber with a
        # reason nothing could clear. No tool call and no prompt follows an
        # auth notification, so it sat there until someone typed.
        spoken = message.lower()
        if "waiting for your input" in spoken:
            kind = "idle_prompt"
        elif "needs your permission" in spoken:
            kind = "permission_prompt"
        else:
            kind = "other"
    if kind == "idle_prompt":
        # An open dialog is the better reason, and it outranks this one.
        if session.state != "needs_you":
            session.reason = "waiting for input"
        session.last_event = message or "waiting for input"
        return
    if kind == "permission_prompt" and session.asks_first:
        # Stale: the same news up to twelve seconds late, about a dialog that
        # is either still up — and the row says so — or already answered. Not
        # the state, and not the text either: it used to leave a permission
        # question as the only line under a row reading "ready".
        return
    session.last_event = message or kind
    if kind not in ATTENTION_NOTIFICATIONS:
        return
    if session.state != "needs_you":
        # Already waiting, so this is the same wait. Moving the clock made a
        # row that had waited a minute say it had waited none.
        session.attention_since = ts
    session.state = "needs_you"
    if session.last_tool:
        session.reason = f"permission: {session.last_tool}"
    else:
        session.reason = message or "permission"


def _on_stop(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    session.state = "done"
    session.last_event = "stopped"


def _on_subagent_stop(session: Session, event: dict[str, Any], ts: float) -> None:
    agent = str(event.get("agent_type") or "subagent")
    session.last_event = f"{agent} finished"


def _on_pre_compact(session: Session, event: dict[str, Any], ts: float) -> None:
    session.last_compaction = ts
    trigger = str(event.get("trigger") or "")
    session.last_event = f"context compacted ({trigger})" if trigger else "context compacted"


def _on_session_end(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    session.state = "ended"
    session.end_reason = str(event.get("reason") or "")
    session.last_event = f"ended ({session.end_reason})" if session.end_reason else "ended"


_HANDLERS: dict[str, Callable[[Session, dict[str, Any], float], None]] = {
    "SessionStart": _on_session_start,
    "UserPromptSubmit": _on_prompt,
    "PreToolUse": _on_pre_tool,
    "PostToolUse": _on_pre_tool,
    "PostToolUseFailure": _on_tool_failed,
    "PermissionRequest": _on_permission_request,
    "Notification": _on_notification,
    "Stop": _on_stop,
    "SubagentStop": _on_subagent_stop,
    "PreCompact": _on_pre_compact,
    "SessionEnd": _on_session_end,
}


def to_float(value: Any) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0


def opt_float(value: Any) -> float | None:
    """A number that may be absent. Missing stays missing, it does not become 0."""
    return None if value is None else to_float(value)


def to_int(value: Any) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


#: What the Claude Code process is called. `claude` is the usual name; a
#: development checkout runs under node, so its command line is checked too.
AGENT_NAMES = ("claude", "node", "bun", "deno")


def process_name(pid: int) -> str:
    """The command name of a process. Reads /proc; never runs a subprocess."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def process_args(pid: int) -> str:
    """The command line of a process, with its NUL separators turned to spaces."""
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
            "utf-8", "replace")
    except OSError:
        return ""


def parent_pid(pid: int) -> int:
    """The parent of a process, or 0. The name in /proc/<pid>/stat is wrapped in
    brackets and may hold spaces, so the fields are read after the last one."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return 0
    fields = stat.rpartition(")")[2].split()
    return to_int(fields[1]) if len(fields) > 1 else 0


def looks_like_claude(pid: int) -> bool:
    name = process_name(pid)
    if name == "claude":
        return True
    return name in AGENT_NAMES and "claude" in process_args(pid)


def agent_pid() -> int:
    """The Claude Code process that fired this hook, or 0 when we cannot tell.

    Claude Code runs a command hook through a shell, so our own parent is that
    shell and it dies as soon as we do. Taking it for the agent made every
    session show as killed seconds after it started. Walking up finds the
    process that owns the session instead.

    Where there is no /proc, this returns 0 and the session is simply never
    reported as killed. Saying nothing beats saying something wrong.
    """
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            return 0
        if looks_like_claude(pid):
            return pid
        pid = parent_pid(pid)
    return 0


def pid_alive(pid: int) -> bool:
    """True when that agent is still running.

    A pid on its own is not an identity. The numbers wrap, and a session that
    ended in the morning had its pid taken by something else by the evening, so
    `kill -0` said yes and the row sat there all day saying "done" for an agent
    that was gone. The process has to still look like the one we recorded.

    This only runs for a session that has a pid, and `agent_pid` returns one
    only where it could read /proc — so `looks_like_claude` can be trusted to
    answer here rather than to be silent.
    """
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False          # not ours, so not the agent we recorded
    except OSError:
        return False
    return looks_like_claude(pid)


def mark_dead(
    session: Session, alive: Callable[[int], bool] | None = None,
    now: float | None = None,
) -> None:
    """A session whose process is gone is dead, even without a SessionEnd.

    `alive` defaults to None, not to pid_alive, so that tests can replace the
    module's pid_alive. A default bound at import would not see the change.

    A session with no pid cannot be checked at all, so it is taken for gone
    once it has been quiet for QUIET_MAX. Without that it stayed in the list
    as though it were running until the log forgot it, a week later.
    """
    check = alive or pid_alive
    if session.state == "ended":
        return
    moment = time.time() if now is None else now
    if session.pid:
        if not check(session.pid):
            _bury(session, moment, "process gone")
        return
    if session.last_ts and moment - session.last_ts > QUIET_MAX:
        _bury(session, moment, "no sign of it")


def _bury(session: Session, moment: float, why: str) -> None:
    """Dead, and stamped with when. Nothing reports this state, so it is the
    one place outside `Store.apply` that `state_since` has to move."""
    if session.state != "dead":
        session.state_since = moment
    session.state = "dead"
    if not session.end_reason:
        session.end_reason = why


def build_sessions(
    events: Sequence[dict[str, Any]] | Iterator[dict[str, Any]] | None = None,
    now: float | None = None,
    alive: Callable[[int], bool] | None = None,
) -> list[Session]:
    """Replay the whole log once, for a command that runs and exits.

    The daemon does not use this: it keeps a Store and folds only what is new.
    Both go through the same Store, so "which sessions are shown, and in what
    order" is written down once.

    Git facts cost a subprocess, so they are left to add_git_facts, which only
    the commands that show them call.
    """
    store = Store()
    store.fold(events if events is not None else read_events())
    moment = now if now is not None else time.time()
    return sort_sessions(store.settle(moment, alive))


def sort_sessions(sessions: list[Session]) -> list[Session]:
    """Newest first, with the ended and the dead last.

    `settled` is the moment a session last became what it is, and it is the
    right number precisely because it is not the last event: sorting a
    working session by its last hook event would have two busy agents
    swapping places every few seconds while you read them. It moves when a
    turn begins, ends, or stops on a question -- which is when the row
    changes band anyway, so the list moves once rather than twice.

    This replaces sorting by worktree. That was chosen when the alternative
    was sorting by *state*, which put every row somewhere new on every tool
    call; a name does not move, so it did not churn. But a name is also not
    what anyone is looking for in a list of twenty: the session you touched
    last is, and it was somewhere in the middle under `a`.

    Sorting on `label` is still wrong, for the reason it always was: the name
    arrives from the status line a second after the session starts, and
    `/rename` changes it later. The worktree is the tiebreaker only.

    A session nobody can talk to any more still sinks to the bottom: it is
    dimmed, it is often the larger half of a long list, and it is never what
    you came to look at.
    """
    return sorted(
        sessions,
        key=lambda s: (
            s.state in GONE_STATES,
            -s.settled,
            s.place.lower(),
            s.session_id,
        ),
    )


# --- transcript: the session's own jsonl, turned into blocks -----------------


@dataclass
class Block:
    """One thing the Transcript tab shows, in the order it happened."""

    seq: int = -1               # its place in the transcript, and its identity
    #: prompt, text, thinking, tool, divider, note. A `note` is a `user`
    #: record the harness wrote -- a task finishing, another session's
    #: message -- so it is shown but never as something the reader typed.
    kind: str = "text"
    ts: float = 0.0
    text: str = ""              # prompt and assistant text, as Markdown
    tool: str = ""              # the tool's name
    target: str = ""            # the path, command or pattern it worked on
    added: int = 0              # lines an edit added
    removed: int = 0            # lines an edit removed
    result: str = ""            # the tool's output, shown when expanded
    failed: bool = False
    tool_use_id: str = ""


#: The tags Claude Code wraps its own `user` records in. A real sample, from
#: a real transcript -- typing `/reload-plugins` arrives as these:
#:
#:     <command-name>/reload-plugins</command-name>
#:     <command-message>reload-plugins</command-message>
#:     <command-args></command-args>
#:     <local-command-stdout>(no content)</local-command-stdout>
#:
#: and a resumed conversation opens with a `<local-command-caveat>`. One thing
#: the reader did, in four records, none of which they typed.
MACHINE_TAG = re.compile(
    r"<(command-name|command-message|command-args|local-command-stdout"
    r"|local-command-caveat|system-reminder)>.*?</\1>", re.S)
COMMAND_NAME = re.compile(r"<command-name>\s*(.*?)\s*</command-name>", re.S)
COMMAND_ARGS = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.S)
TASK_NOTE = re.compile(r"^<task-notification>\s*(.*?)\s*</task-notification>$",
                       re.S)

#: Claude Code's own wrapper round a message that arrived while the agent was
#: working -- which is every message this page sends to a busy agent, so it is
#: the shape a reader of this program meets most.
#:
#: A header names it, a footer explains it to the agent, and the words the
#: person typed are in between. Both lines went into the transcript as though
#: they had been typed, so a message sent from here came back wearing a
#: paragraph about how Claude Code queues messages.
#:
#: Read off a real transcript, header and footer verbatim. The footer is
#: matched by its first sentence only: it is the part that names what the
#: wrapper is, and matching all of it would turn a reworded tail into a
#: header on the page again.
QUEUED = re.compile(
    r"\A\s*The user sent a new message while you were working:\s*\n"
    r"(.*?)\n\s*This is how Claude Code surfaces messages the user sends"
    r" mid-turn\b.*\Z", re.S)

#: A `user` record the harness wrote and not the reader. It is shown, because
#: it is real news, but never as a prompt: nobody typed it.
NOTED = ("<task-notification>", "Another Claude session sent a message:")


def strip_reminder(text: str) -> str:
    """The inside of a `<system-reminder>`, when that is the whole record.

    The wrapper round a queued message is written inside one, and a reminder
    that holds nothing else is machine text either way -- so taking the tags
    off changes nothing about what is shown and lets one pattern read both
    shapes. A reminder beside other text is left alone here; `MACHINE_TAG`
    takes that one out in the usual way.
    """
    body = text.strip()
    if body.startswith("<system-reminder>") and body.endswith("</system-reminder>"):
        return body[len("<system-reminder>"):-len("</system-reminder>")].strip()
    return body


def read_user_text(text: str) -> tuple[str, str]:
    """What a `user` record really is: a prompt, a note, or nothing to show.

    Claude Code writes `user` records of its own, and they were drawn as
    though the reader had typed them -- four rows of tags for one
    `/reload-plugins`, and `(no content)` as a prompt.

    A record is only read as a command when there is nothing else on it. A
    prompt really can hold `<command-name>` in it: somebody asking about this
    very feature types one, and that is a prompt.

    A message sent to a busy agent comes back wrapped in a header and a
    footer, and inside a `<system-reminder>`. The words are the reader's own,
    so the wrapper comes off and the prompt is drawn like any other --
    **before** the reminder is stripped, or the message would go with it.
    """
    inside = QUEUED.search(strip_reminder(text))
    if inside:
        return "prompt", inside.group(1).strip()
    rest = MACHINE_TAG.sub("", text).strip()
    named = COMMAND_NAME.search(text)
    if named and not rest:
        # One line saying what was run, which is the whole of what happened.
        args = COMMAND_ARGS.search(text)
        said = args.group(1).strip() if args else ""
        return "prompt", (named.group(1) + (" " + said if said else "")).strip()
    if not rest:
        return "", ""                      # plumbing, and nothing else
    if rest.startswith(NOTED):
        note = TASK_NOTE.match(rest)
        return "note", (note.group(1) if note else rest)
    return "prompt", text


def parse_timestamp(value: Any) -> float:
    """The transcript stamps lines in ISO 8601 with a Z. Turn it into seconds."""
    text = str(value or "")
    if not text:
        return 0.0
    try:
        from datetime import datetime

        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


def edit_counts(tool_input: Any) -> tuple[int, int]:
    """How many lines an edit adds and removes, counted from its strings."""
    data = tool_input if isinstance(tool_input, dict) else {}
    edits = data.get("edits")
    if isinstance(edits, list):
        added = removed = 0
        for one in edits:
            more, fewer = edit_counts(one)
            added += more
            removed += fewer
        return added, removed

    def lines(key: str) -> int:
        text = data.get(key)
        return len(str(text).splitlines()) if text else 0

    if "new_string" in data or "old_string" in data:
        return lines("new_string"), lines("old_string")
    if "new_source" in data or "old_source" in data:   # NotebookEdit
        return lines("new_source"), lines("old_source")
    if "content" in data:
        return lines("content"), 0
    return 0, 0


def result_text(content: Any) -> str:
    """A tool result is usually a string, and sometimes a list of blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for piece in content:
            if isinstance(piece, dict) and piece.get("type") == "text":
                parts.append(str(piece.get("text") or ""))
            elif isinstance(piece, str):
                parts.append(piece)
        return "\n".join(parts)
    if content is None:
        return ""
    return json.dumps(content, ensure_ascii=False, default=str)


class Transcript:
    """Reads a session's transcript into blocks, and follows it as it grows.

    A tool result arrives after its call, in a later line, so the blocks are
    kept by `tool_use_id` and the result is attached when it turns up. That is
    also why parsing is incremental: the same block is edited in place rather
    than the file being read again.
    """

    def __init__(self, path: str, cwd: str = "", run: int = 0) -> None:
        self.tail = Tail(Path(path))
        self.cwd = cwd
        self.blocks: list[Block] = []
        self.by_tool_use: dict[str, Block] = {}
        #: Which reading of this session's transcript these blocks belong to.
        #: `seq` is only a position in one reading, so the page needs to know
        #: when it is looking at a different one.
        self.run = run
        #: The last run the watchers were told about. A transcript rewritten
        #: to nothing changes no block, so there is nothing to push — and the
        #: page would go on showing a conversation the file no longer holds.
        self.run_sent = -1

    def read_new(self) -> list[Block]:
        """Parse whatever has been appended. Returns every block that changed.

        A transcript can be rewritten under its own name — a `/clear`, a
        resume, any atomic rewrite — and then `Tail` starts over. What was
        held has to go with it: appending the re-read file to the blocks
        already there drew the whole transcript twice, and after a truncate
        the page went on showing text the file no longer held.
        """
        lines = self.tail.read_new()
        if self.tail.restarted:
            self.blocks.clear()
            self.by_tool_use.clear()
            self.run += 1
        touched: list[Block] = []
        for record in json_objects(lines):
            touched += self.add(record)
        return touched

    def keep(self, block: Block) -> Block:
        """Give a block its number and put it at the end."""
        block.seq = len(self.blocks)
        self.blocks.append(block)
        return block

    def add(self, record: dict[str, Any]) -> list[Block]:
        """One line of the transcript, folded into the blocks.

        A compaction is written as two records: a `system` one that marks the
        boundary, and a `user` one carrying the summary. Measured on 31
        transcripts across three machines, `summary` — which this used to be
        the only marker for — is not written at all any more; the branch stays
        for an older Claude Code that does write it.
        """
        kind = str(record.get("type") or "")
        if kind == "summary":
            # An older build. What it meant there was never settled — the
            # payload schema says a session that was compacted *or* resumed —
            # and no build in use writes one, so there is nothing to measure.
            return [self.keep(Block(kind="divider", text="context compacted"))]
        if kind == "system":
            if str(record.get("subtype") or "") != "compact_boundary":
                return []
            return [self.keep(Block(kind="divider", text="context compacted"))]
        if kind not in ("user", "assistant"):
            return []
        if record.get("isCompactSummary"):
            # The summary Claude Code writes to carry the conversation across
            # a compaction. It is a `user` record, so it was drawn as a
            # prompt — thirteen thousand characters of machine text sitting
            # in the transcript as though the reader had typed them. The
            # divider above says what happened; this is not a prompt.
            return []

        message = record.get("message")
        if not isinstance(message, dict):
            return []
        ts = parse_timestamp(record.get("timestamp"))
        content = message.get("content")

        if isinstance(content, str):
            if not content.strip():
                return []
            if kind == "user":
                mine, text = read_user_text(content)
                if not mine:
                    return []
                return [self.keep(Block(kind=mine, ts=ts, text=text))]
            return [self.keep(Block(kind="text", ts=ts, text=content))]
        if not isinstance(content, list):
            return []

        touched: list[Block] = []
        for piece in content:
            if not isinstance(piece, dict):
                continue
            block = self.add_piece(kind, piece, ts)
            if block is not None:
                touched.append(block)
        return touched

    def add_piece(self, role: str, piece: dict[str, Any], ts: float) -> Block | None:
        kind = str(piece.get("type") or "")
        if kind == "text":
            text = str(piece.get("text") or "")
            if not text.strip():
                return None
            if role == "user":
                # The same reading as a record whose content is one string:
                # Claude Code writes both shapes.
                mine, text = read_user_text(text)
                if not mine:
                    return None
                block = Block(kind=mine, ts=ts, text=text)
            else:
                block = Block(kind="text", ts=ts, text=text)
        elif kind == "thinking":
            text = str(piece.get("thinking") or "")
            if not text.strip():
                return None
            block = Block(kind="thinking", ts=ts, text=text)
        elif kind == "tool_use":
            name = str(piece.get("name") or "")
            tool_input = piece.get("input")
            # Section 4.6 asks for counts on an edit. A Write is one whole file
            # and its line count says nothing useful, so it does not get them.
            added, removed = edit_counts(tool_input) if name in COUNTED_TOOLS else (0, 0)
            block = Block(kind="tool", ts=ts, tool=name,
                          target=tool_target(name, tool_input, self.cwd),
                          added=added, removed=removed,
                          tool_use_id=str(piece.get("id") or ""))
            if block.tool_use_id:
                self.by_tool_use[block.tool_use_id] = block
        elif kind == "tool_result":
            held = self.by_tool_use.get(str(piece.get("tool_use_id") or ""))
            if held is None:
                return None
            held.result = result_text(piece.get("content"))
            held.failed = bool(piece.get("is_error"))
            return held          # an existing block changed; it is not a new one
        else:
            return None
        return self.keep(block)


# --- git facts: what git says about the agent's directory --------------------


def run(args: Sequence[str], cwd: str | None = None, timeout: float = RUN_TIMEOUT) -> str | None:
    """Run a command and return its stdout, unchanged. None on any failure.

    It does not strip: `tmux capture-pane` needs its blank lines kept.
    """
    import subprocess

    try:
        done = subprocess.run(
            list(args),
            cwd=cwd or None,
            capture_output=True,
            text=True,
            errors="replace",  # a pane or a diff may hold bytes that are not UTF-8
            timeout=timeout,
            check=False,
        )
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    return done.stdout


def parse_status_branch(header: str) -> tuple[str, int, int]:
    """Read the `## ` line of `git status --branch`: branch, ahead, behind.

    It looks like `## main...origin/main [ahead 2, behind 1]`. The upstream and
    the counts are left out when there are none. A fresh repository says
    `## No commits yet on main`, and a detached HEAD says `## HEAD (no
    branch)` — which is not a branch name, and went on the row as if it were.
    """
    text = header[3:] if header.startswith("## ") else header
    ahead = behind = 0
    if "[" in text:
        text, _, counts = text.partition(" [")
        for word, value in re.findall(r"(ahead|behind) (\d+)", counts):
            if word == "ahead":
                ahead = int(value)
            else:
                behind = int(value)
    text = text.partition("...")[0]
    if text.strip() == "HEAD (no branch)":
        return "", ahead, behind
    branch = text.rpartition(" ")[2] if text.startswith("No commits yet on ") else text
    return branch.strip(), ahead, behind


def repo_name(git_dir: str) -> str:
    """The name of the repository that owns a git directory.

    `--git-common-dir` points at the repository itself, which is named in one
    of three ways: `<repo>/.git` for a plain clone, `<repo>/.bare` or another
    dotted name for the bare layout worktrees are usually built on, and
    `<repo>.git` for a bare clone. A hidden name means the repository is the
    directory above; otherwise the name is the directory's own, without `.git`.
    """
    path = git_dir.strip().rstrip("/")
    if not path:
        return ""
    name = os.path.basename(path)
    if name.startswith("."):
        return os.path.basename(os.path.dirname(path))
    return re.sub(r"\.git$", "", name)


def git_facts(cwd: str, runner: Callable[..., str | None] = run) -> GitFacts:
    """Read the repository name, branch, ahead, behind and dirty state.

    Two git runs, not four: one gives both directories, the other gives the
    branch, the counts and the changed files at once. A git error gives empty
    facts, because a directory need not be a repository at all — except when
    the first call worked and the second did not, which can only be a failure,
    and `failed` says so. The two are otherwise the same answer: `status`
    fails outside a repository just as it does on a stalled disk.
    """
    facts = GitFacts()
    if not cwd or not os.path.isdir(cwd):
        return facts

    def git(*args: str) -> str | None:
        out = runner(["git", "-C", cwd, *args])
        return None if out is None else out.strip()

    # --git-common-dir points at the main repository, so a worktree keeps its
    # repository's name. --path-format needs git 2.31; older git falls back to
    # the top level, which for a worktree is the worktree itself.
    paths = git("rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel")
    if paths is None:
        paths = git("rev-parse", "--show-toplevel")
    if paths:
        facts.repo = repo_name(paths.splitlines()[0])

    status = git("status", "--porcelain", "--branch")
    if status is None:
        # `--show-toplevel` answered, so this is a repository and git was
        # asked about it and did not answer. The call has a two second
        # timeout, and `status` on a very large worktree can pass it.
        facts.failed = bool(paths)
        return facts
    lines = status.splitlines()
    if lines and lines[0].startswith("## "):
        facts.branch, facts.ahead, facts.behind = parse_status_branch(lines[0])
        lines = lines[1:]
    changed = [line for line in lines if line.strip()]
    facts.touched_files = len(changed)
    facts.dirty = bool(changed)
    return facts


def git_facts_many(directories: Sequence[str]) -> dict[str, GitFacts]:
    """Read several directories at once. git waits on disk, so ten worktrees
    cost about as long as one. It reads and returns; it assigns nothing, so
    only the thread that called it ever writes to a session."""
    from concurrent.futures import ThreadPoolExecutor

    wanted = sorted({directory for directory in directories if directory})
    if not wanted:
        return {}
    with ThreadPoolExecutor(max_workers=min(8, len(wanted))) as pool:
        return dict(zip(wanted, pool.map(git_facts, wanted)))


def add_git_facts(sessions: Sequence[Session]) -> None:
    """Fill in git facts for every session."""
    facts = git_facts_many([session.cwd for session in sessions])
    for session in sessions:
        session.git = facts.get(session.cwd, GitFacts())


# --- files and diffs: what the worktree holds --------------------------------

#: These come first in the Files tab, in this order. They say what the work is.
PINNED_FILES = ("PLAN.md", "CLAUDE.md", "README.md")

#: A file longer than this is cut.
FILE_MAX_BYTES = 512 * 1024

#: What the page may show as it is, and the type each one is served with.
#: Decided by the end of the name and by nothing else -- this list is the
#: whole of what `raw` will serve, so nothing here may be a document.
#:
#: SVG is not on it and will not be. It is text, so it already reads as code
#: on the Files tab; and serving one from this origin would put a page of the
#: agent's own writing on the origin that holds the token, with a script in it
#: able to read both.
SHOWN_AS = {
    ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif",
    ".bmp": "image/bmp", ".ico": "image/vnd.microsoft.icon",
    ".mp4": "video/mp4", ".webm": "video/webm", ".ogv": "video/ogg",
    ".mov": "video/quicktime",
    ".mp3": "audio/mpeg", ".wav": "audio/wav", ".ogg": "audio/ogg",
    ".flac": "audio/flac", ".m4a": "audio/mp4",
}

#: Bigger than this and the page is told to say so rather than being handed
#: it. The daemon reads a file whole, and a worktree can hold a gigabyte of
#: video.
SHOWN_MAX_BYTES = 25 * 1024 * 1024


def shown_as(wanted: str) -> str:
    """The type this name is served with, or empty for one we do not serve."""
    return SHOWN_AS.get(Path(wanted).suffix.lower(), "")

#: A ceiling on the whole listing, not on what the page searches. Sending the
#: first five thousand of 52,799 names made `libcorrelation` find 16 files and
#: miss more than a thousand, because the thousand were never sent. Past this
#: many the tab says it cannot answer rather than answering a fraction.
FILES_MAX = 200_000

#: What one wholly-ignored directory is worth, in names.
#:
#: git collapses such a directory into a single entry and walks no further,
#: which is what keeps `node_modules` from costing a quarter of a million
#: names. wostuast dropped that entry, so a generated directory -- the one
#: ignored place a reader does want to read -- had no way in at all.
#:
#: Walking it ourselves means keeping git's promise ourselves. A directory
#: whose contents do not fit in this many names is left out whole and named
#: instead, and the walk stops as soon as it knows that, so a build root of a
#: hundred thousand objects costs this many reads and not a hundred thousand.
#: The rule is recursive, which is what makes it useful: `_build_root_c2` is
#: left out, and the plan and the notes beside it are listed, because what is
#: left of the directory then fits.
#:
#: 2,000 because a generated directory somebody reads -- a plan, some notes, a
#: report -- is tens of files. `node_modules` and a build root are thousands,
#: and neither is a place to browse.
IGNORED_MAX = 2000

#: How long a listing nobody has asked about is kept. It holds every name in
#: a repository, so it does not sit there for the life of the daemon.
LISTING_KEPT = 300.0

#: How long a listing is served before git is asked again. The Files tab polls
#: every two seconds, a worktree may have several browsers on it, and a walk of
#: fifty thousand files costs about a second — so without this the daemon would
#: spend most of its time listing the same repository over and over.
LIST_FRESH = 3.0

#: Listing a repository is the one git call that does not fit in RUN_TIMEOUT.
#: `ls-files` and `status` over fifty thousand files take longer than two
#: seconds, and the timeout came back as an empty worktree. A shared timeout
#: is a shared limit, and these calls are not the same size as the others.
LIST_TIMEOUT = 20.0

#: A NUL byte in the first of a file says it is not text. Every editor guesses
#: this way, and every editor is sometimes wrong; being wrong here shows a
#: "binary file" note instead of a screen of control characters.
BINARY_SNIFF = 8000

#: A diff longer than this is cut. No page can show more, and parsing the rest
#: would cost more than it is worth.
DIFF_MAX_BYTES = 2 * 1024 * 1024

#: git diff takes longer than git status on a large repository. It runs in a
#: request thread, never in the tick, so waiting here holds up nothing else.
DIFF_TIMEOUT = 8.0

#: What a terminal puts around a paste. Inside these a program knows the text
#: arrived all at once and does not act on its newlines. See `tmux_send`.
PASTE_START = "\x1b[200~"
PASTE_END = "\x1b[201~"

#: What `tmux_send` takes out of anything on its way to a terminal: everything
#: below a space except tab and newline, the delete character, and the C1
#: block above it. C1 holds NEL (U+0085) and CSI (U+009B), controls a terminal
#: may act on and an agent may write; U+2028 and U+2029 are line breaks that
#: `"\n" in text` does not see, so they would have gone out unpasted. The rule
#: is "nothing below a space reaches a terminal", and these are below one.
CONTROL_CHARS = re.compile(
    r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029]")

#: The header a POST carries its token in. A cross-origin request cannot add a
#: header of its own without asking us first, and we never say yes — so a page
#: that has not read ours cannot even reach the code that checks it.
TOKEN_HEADER = "X-Wostuast-Token"

#: Where the token goes into the page, replaced as the page is served.
TOKEN_MARK = "__WOSTUAST_TOKEN__"

#: The most a POST body may be.
POST_MAX = 64 * 1024

#: The most a spend limit may be set to. Not a safety property -- it is a
#: sanity bound on a number typed into a box, so a stray keypress cannot store
#: something that reads as "no limit at all" while looking like one.
LIMIT_MAX = 10_000.0

#: The most text one `send` may type, **in bytes**. Longer is refused rather
#: than cut: what arrives in the terminal must be what the user wrote, or
#: nothing.
#:
#: Bytes and not characters, because that is what tmux counts. Measured
#: against tmux 3.4: `send-keys -t %0 -l -- <text>` takes 16,341 bytes of
#: text and refuses 16,342 with "command too long", and the same bisection
#: run with `ä` -- two bytes in UTF-8 -- stops at 8,170. The target's name
#: comes out of the same budget: by session name rather than pane id it was
#: 16,338. So a cap on `len()` would let 16,000 characters of Japanese
#: through as 48,000 bytes, and tmux would refuse the lot.
#:
#: 12,000 leaves room for the paste markers, for a longer pane name, and for
#: a tmux whose number is not this one. It was 4,000 characters, which is
#: less than one long paste: a reader hit it with 4,400.
SEND_MAX = 12000

#: How many untracked files the Diff tab names. git diff shows none of them,
#: so the tab says they are there rather than leaving a hole.
UNTRACKED_SHOWN = 50

@dataclass
class FileEntry:
    """One file the Files tab offers."""

    path: str = ""          # relative to the worktree root
    mtime: float = 0.0      # only read for a changed file; 0 for the rest
    changed: bool = False   # git says this one differs from the last commit


@dataclass
class Worktree:
    """A worktree's root, and the files in it."""

    root: str = ""
    files: list[FileEntry] = field(default_factory=list)
    total: int = 0          # before the list was cut to FILES_MAX
    cut: bool = False       # the worktree holds more names than FILES_MAX
    failed: bool = False    # git did not answer; "no files" would lie
    #: Ignored directories too big to list, so the tree can say so where they
    #: stand. A folder with nothing in it and no reason given reads as a bug.
    skipped: list[str] = field(default_factory=list)


@dataclass
class FileText:
    """One file's content, as the page gets it."""

    text: str = ""
    mtime: float = 0.0
    #: Bytes on disk, which is not what `len(text)` says once it is decoded
    #: or cut at `FILE_MAX_BYTES`. The stat that reads the mtime has it.
    size: int = 0
    binary: bool = False
    #: The type this file is shown as, when the page may show it as it is --
    #: `image/png`, `video/mp4`, and so on. Empty for everything else. The
    #: list lives here, beside the route that has to enforce it, and the page
    #: reads the answer: two lists in two languages would drift, and a
    #: mismatch is silent either way round.
    shown: str = ""
    #: On that list, but past `SHOWN_MAX_BYTES`. The page then says how big it
    #: is rather than asking for a file it would be refused.
    oversize: bool = False
    # What `file` made of it, when the name and the first line said nothing.
    # The page decides what to do with it; see `languageOf`.
    language: str = ""


def walk_ignored(root: str, top: str,
                 budget: int) -> tuple[list[str], list[str]]:
    """What is inside a wholly-ignored directory, and what was left out.

    `git ls-files --directory` hands over one entry for such a directory and
    does not look inside it. That is the right trade for `node_modules` and
    the wrong one for `.oa-implement`, which an agent writes into and a
    reader wants to read, so the walk is ours to do -- and so is the promise
    that it stays cheap.

    A directory is listed only when what it holds fits in `budget`, counting
    what is under it and not counting a folder already left out. Nothing is
    half-listed: a directory either comes back whole or comes back as its own
    name in `skipped`, which is the thing the tree draws. So a build root of
    a hundred thousand objects is one row, the files beside it are listed,
    and finding that out costs `budget` reads rather than a hundred thousand.

    A link to a directory is neither followed nor listed. Following it is a
    way round the budget and a way into a loop, and listing it would offer a
    name that is not a file; what is behind it is listed where it really
    lives, if git offers that place at all. A link to a file is a file.

    The budget is passed rather than read, so a test can set it to three
    files instead of building two thousand of them.
    """
    def below(here: str) -> tuple[list[str] | None, list[str]]:
        """This directory's files, or None when it does not fit."""
        names: list[str] = []
        skipped: list[str] = []
        try:
            with os.scandir(os.path.join(root, here)) as reading:
                for entry in reading:
                    where = f"{here}/{entry.name}"
                    if entry.is_dir(follow_symlinks=False):
                        found, left = below(where)
                        if found is None:
                            skipped.append(where)
                        else:
                            names.extend(found)
                            skipped.extend(left)
                    elif entry.is_dir():
                        continue    # a link to a directory: neither of those
                    else:
                        names.append(where)
                    if len(names) > budget:
                        # What was left out inside a directory that is itself
                        # left out is not news: the reader is told about the
                        # one row they can see.
                        return None, []
        except OSError:
            return [], []       # gone between git and us, or not ours to read
        return names, skipped

    top = top.rstrip("/")
    names, skipped = below(top)
    # The whole of it does not fit, so the whole of it is the one name the
    # reader is given -- a folder they can see, with nothing pretending to be
    # inside it.
    return ([], [top]) if names is None else (names, skipped)


def in_order(names: set[str]) -> list[str]:
    """The order the names are sent in: PLAN.md, CLAUDE.md and README.md
    first, because they say what the work is, then the rest by name.

    This order depends only on which files exist, and that is the point. The
    page holds these names between polls and asks for them again only when the
    tag they came with has moved. An order that also depended on which files
    had changed would move every time an agent saved anything, which is every
    few seconds, and the whole list — 1.7 MB of it in a large repository —
    would come down the wire again each time.

    Where a changed file sits in the list the reader sees is the page's
    business. It gets the changed names and their times, which is tens of
    entries, and lifts them to the top itself.

    One sort, then three names lifted. Sorting and then sorting again by a key
    function looks wasteful and is not: over fifty thousand files the second
    sort is nearly free, because the list is already in order, while building
    fifty thousand key tuples to do it costs twice what the whole job should.
    Measured: 45 ms that way, 89 ms with the first sort dropped, 35 ms like
    this.
    """
    head = [name for name in PINNED_FILES if name in names]
    return head + [name for name in sorted(names)
                   if name not in PINNED_FILES]


def worktree_root(cwd: str, runner: Callable[..., str | None] = run) -> str:
    """The top of the worktree this directory sits in, or "" if it is not in
    one.

    Everything else works from here, never from the agent's own directory.
    git reports a diff with paths relative to the root whatever directory it
    was run in, so a session standing in a subdirectory would otherwise get a
    file list and a diff that do not agree with each other.
    """
    if not cwd or not os.path.isdir(cwd):
        return ""
    top = runner(["git", "-C", cwd, "rev-parse", "--show-toplevel"])
    return top.strip() if top else ""


def git_answers(runner: Callable[..., str | None] = run) -> bool:
    """Whether git is answering at all.

    `run` gives None for a command that failed and for one that could not be
    run, so `rev-parse --show-toplevel` coming back empty means either "this
    is not a repository" — which is an answer — or "git did not answer",
    which is not. Nothing in the output tells them apart.

    `git --version` does: it cannot fail inside a working git, and it stalls
    on the same stalled machine. It is asked only when another call has
    already come back with nothing, so a repository never pays for it.
    """
    return runner(["git", "--version"]) is not None


def changed_files(
    cwd: str, runner: Callable[..., str | None] = run
) -> set[str] | None:
    """The files git says differ from the last commit, untracked ones included.
    None when git did not answer.

    `-z` gives one NUL-terminated record per file: two status letters, a
    space, then the name. A rename or a copy is followed by one more record
    holding the old name on its own, with no status in front of it — so which
    record is which has to be counted, not guessed at from its length. Both
    names are kept: the agent touched both ends of a rename.
    """
    out = runner(["git", "-C", cwd, "status", "--porcelain", "-z",
                  "--untracked-files=all"], timeout=LIST_TIMEOUT)
    if out is None:
        return None
    names = set()
    bare = False
    for record in out.split("\0"):
        if not record:
            continue
        if bare:
            names.add(record)           # the old name of the rename before it
            bare = False
            continue
        if len(record) > 3:
            names.add(record[3:])
        bare = "R" in record[:2] or "C" in record[:2]
    return names


def git_names(
    cwd: str, args: Sequence[str], runner: Callable[..., str | None] = run
) -> list[str] | None:
    """The names one `git ls-files` prints, or None when git did not answer.

    `-z` separates the names with a NUL, which is the only separator a file
    name cannot hold. The listing gets LIST_TIMEOUT: it is the one git call
    whose cost grows with the size of the repository.
    """
    out = runner(["git", "-C", cwd, "ls-files", "-z", *args],
                 timeout=LIST_TIMEOUT)
    if out is None:
        return None
    return [name for name in out.split("\0") if name]


def worktree_files(cwd: str, runner: Callable[..., str | None] = run,
                   root: str = "") -> Worktree:
    """Every file in a worktree, in the order the tab shows them.

    Three listings. What git tracks, the untracked files .gitignore does not
    cover, and the ignored files. `--directory` collapses a directory whose
    whole contents are ignored into one entry ending in a slash, so
    `node_modules` costs one name instead of a quarter of a million. Those
    entries are dropped here; naming a directory you cannot open helps nobody,
    and opening one is the tree's job. An ignored file that sits among tracked
    files — a generated header, `compile_commands.json` — is listed like any
    other, and that is the ignored file people look for.

    A listing git did not answer sets `failed`. The names it did answer are
    still returned: a short list with a warning beats no list at all. What
    must never happen is a failure that reads as an empty worktree, which is
    what a two second timeout over fifty thousand files used to look like.

    Only a changed file is stat'ed. A repository holds tens of thousands of
    files and tens of changed ones, and the modification time is only read to
    sort those few — asking the disk about every file, every poll, would cost
    far more than the answer is worth.
    """
    tree = Worktree()
    tree.root = root or worktree_root(cwd, runner)
    if not tree.root:
        # "No files" and "git did not answer" look the same here and mean
        # opposite things. Every other git call in this function sets
        # `failed`; this was the one door left open, and the page drew the
        # plain empty state over a worktree it simply could not read.
        tree.failed = not git_answers(runner)
        return tree
    parts = [
        git_names(tree.root, [], runner),
        git_names(tree.root, ["--others", "--exclude-standard"], runner),
        git_names(tree.root, ["--others", "--ignored", "--exclude-standard",
                              "--directory"], runner),
    ]
    touched = changed_files(tree.root, runner)
    tree.failed = touched is None or any(part is None for part in parts)
    names: set[str] = set()
    for part in parts:
        if part is not None:
            names.update(name for name in part if not name.endswith("/"))
    # The entries git collapsed. Each is a directory it declined to look
    # inside, and one of them is where the agent's own work is kept.
    skipped: list[str] = []
    for name in parts[2] or []:
        if name.endswith("/"):
            found, left = walk_ignored(tree.root, name, IGNORED_MAX)
            names.update(found)
            skipped.extend(left)
    tree.skipped = sorted(skipped)
    touched = touched or set()
    for name in in_order(names):
        entry = FileEntry(path=name, changed=name in touched)
        if entry.changed:
            try:
                entry.mtime = os.stat(os.path.join(tree.root, name)).st_mtime
            except OSError:
                continue    # listed but since deleted, or a link with no target
        tree.files.append(entry)
    tree.total = len(tree.files)
    if tree.total > FILES_MAX:
        del tree.files[FILES_MAX:]
        tree.cut = True
    return tree


def listing_tag(names: str) -> str:
    """A short name for one set of file names, given them already joined.

    The browser sends back the tag it already holds, and an answer that still
    has that tag carries no names at all. Names change when a file is added or
    removed, which is rare; which files have changed moves every few seconds,
    and that part is short.
    """
    import hashlib

    return hashlib.sha1(names.encode("utf-8", "replace")).hexdigest()[:16]


@dataclass
class Listing:
    """One worktree's file list, kept between requests."""

    tree: Worktree = field(default_factory=Worktree)
    tag: str = ""
    read_at: float = 0.0
    # Built with the listing, not per request. The names weigh 1.7 MB in a
    # large repository and joining them costs 6 ms, which a poll that is only
    # asking "have they moved?" should not pay.
    names: str = ""
    changed: dict[str, float] = field(default_factory=dict)


class Files:
    """The listings the daemon holds, one per worktree root.

    Asking git costs about a third of a second over fifty thousand files, the
    Files tab asks again every couple of seconds, and several browsers may be
    watching the same worktree. So one answer is kept and shared. A stale one
    is handed over at once and read again behind it, so only a worktree nobody
    has asked about yet makes anyone wait.

    The daemon owns one of these and never warms it in the tick. It does no
    file work until a browser asks, which is what keeps a worktree nobody is
    looking at free.
    """

    def __init__(self) -> None:
        import threading

        self.held: dict[str, Listing] = {}
        self.roots: dict[str, str] = {}     # a session's directory to its top
        self.langs: dict[str, str] = {}     # a file's bytes to what `file` said
        self.gates: dict[str, Any] = {}
        self.lock = threading.Lock()

    def root_of(self, cwd: str, runner: Callable[..., str | None]) -> str:
        """Where this directory's worktree starts, asked once.

        `git rev-parse` is cheap but it is still a process, and this ran on
        every poll of every browser for an answer that does not move.

        Only an answer is kept. git can fail for a moment — the call has a two
        second timeout, and a busy machine or a network filesystem can pass
        it — and an empty answer kept for ever meant one such moment left the
        worktree unreadable until the daemon was restarted. The same rule the
        listings keep: a git call that failed is not an answer.
        """
        with self.lock:
            known = self.roots.get(cwd)
        if known:
            return known
        found = worktree_root(cwd, runner)
        if found:
            with self.lock:
                self.roots[cwd] = found
        return found

    def language_of(
        self, target: Path, mtime: float, size: int,
        runner: Callable[..., str | None],
    ) -> str:
        """What `file` made of this one, asked once per version of it.

        The answer depends on the file's bytes and on nothing else, so asking
        again two seconds later is asking a question already answered. The
        open file is read on every poll of every browser, and this was the
        third process each of those paid for.

        The key carries the mtime and the size, which is the same cheap proxy
        for "the bytes changed" the rest of this program uses. An empty answer
        is kept as well, and that is most of the saving: `file` says
        `text/plain` for a suffix-less Python module, which is deliberately
        not in `BY_MIME`, so the common answer is no answer.
        """
        key = f"{target}\n{mtime}\n{size}"
        with self.lock:
            known = self.langs.get(key)
        if known is not None:
            return known
        found = sniff_language(target, runner)
        if found is None:
            # It did not answer. Asking again next poll costs a process; not
            # asking leaves the file grey until someone edits it.
            return ""
        with self.lock:
            # A reader moving through a worktree would otherwise keep every
            # file it opened. Nothing here is worth a second question, so the
            # oldest simply go.
            if len(self.langs) >= LANGS_KEPT:
                for old in list(self.langs)[:LANGS_KEPT // 2]:
                    self.langs.pop(old, None)
            self.langs[key] = found
        return found

    def gate(self, root: str) -> Any:
        """One lock per worktree, so two readers of one root do not both ask
        git while readers of other roots wait for neither."""
        import threading

        with self.lock:
            gate = self.gates.get(root)
            if gate is None:
                self.gates[root] = gate = threading.Lock()
            return gate

    def of(self, cwd: str, runner: Callable[..., str | None] = run) -> Listing:
        """The listing for the worktree this directory sits in."""
        root = self.root_of(cwd, runner)
        if not root:
            return Listing(tree=Worktree(failed=not git_answers(runner)))
        gate = self.gate(root)
        with gate:
            held = self.held.get(root)
            if held is None:
                return self.read(root, runner)   # nothing to show; this waits
            if time.time() - held.read_at <= LIST_FRESH:
                return held
        self.behind(root, runner, gate)          # something to show already
        return held

    def read(self, root: str, runner: Callable[..., str | None]) -> Listing:
        """Ask git. The caller holds this root's gate."""
        tree = worktree_files(root, runner, root=root)
        # NUL is the separator git uses, and the only one a file name cannot
        # hold.
        names = "\0".join(one.path for one in tree.files)
        fresh = Listing(
            tree=tree, names=names, tag=listing_tag(names),
            changed={one.path: one.mtime for one in tree.files if one.changed},
            read_at=time.time())
        with self.lock:
            self.held[root] = fresh
        return fresh

    def behind(self, root: str, runner: Callable[..., str | None],
               gate: Any) -> None:
        """Read it again in a thread of its own. The gate is what says one
        reader at a time, so nothing else has to say it."""
        import threading

        if not gate.acquire(blocking=False):
            return                      # someone is already reading this root

        def again() -> None:
            try:
                held = self.held.get(root)
                if held is None or time.time() - held.read_at > LIST_FRESH:
                    self.read(root, runner)
            except Exception as error:   # a bad read must not stop the daemon
                log(f"listing {root} failed: {error!r}")
            finally:
                gate.release()

        try:
            threading.Thread(target=again, daemon=True).start()
        except RuntimeError:            # no thread to be had; try again later
            gate.release()

    def forget(self, older_than: float) -> None:
        """Drop the listings nobody has asked for in a while. A listing holds
        every name in a repository, so they are not kept for ever."""
        cutoff = time.time() - older_than
        with self.lock:
            for root in list(self.held):
                if self.held[root].read_at < cutoff:
                    del self.held[root]
        # Only the names go. A gate is a lock and a root is a short string,
        # both bounded by how many worktrees this daemon has ever been asked
        # about, and dropping a gate a background reader still holds would
        # hand the next caller a different lock from the one in use.


def untracked_files(
    cwd: str, runner: Callable[..., str | None] = run
) -> list[str] | None:
    """The files git neither tracks nor ignores, in name order.

    `-z` separates the names with a NUL, which is the only separator a file
    name cannot hold. None when git did not answer: it used to come back as
    an empty list, and the Diff tab said nothing was untracked.
    """
    names = git_names(cwd, ["--others", "--exclude-standard"], runner)
    return None if names is None else sorted(names)


def is_listed(cwd: str, wanted: str, runner: Callable[..., str | None] = run) -> bool:
    """True when git offers this exact name: tracked, untracked, or ignored.
    It is the same question the listing answers, asked about one name so that
    reading a file does not cost a walk of the whole repository. An ignored
    file inside an ignored directory answers yes here although the listing
    collapses that directory to one entry; the guard decides what is safe to
    open, not what is worth showing.

    git reads what follows `--` as a pathspec, never as an option, and
    `:(literal)` in front of it turns off every other meaning a pathspec can
    carry. Without it a real file called `report[1].csv` is read as a
    character class and never found, while `*.py` matches files it was not
    asked about. With it the name means itself and nothing else, and the
    answer still has to come back spelled exactly as it was asked for.
    A pathspec that climbs out of the worktree makes git fail.
    """
    if not wanted:
        return False
    asked = ["--", ":(literal)" + wanted]
    out = runner(["git", "-C", cwd, "ls-files", "-z", "--cached", "--others",
                  "--exclude-standard", *asked])
    if wanted in (out or "").split("\0"):
        return True
    # The Files tab lists ignored files, so reading one has to be allowed.
    # It is the same question with the same three parts, asked second because
    # most files are not ignored and this walk is the more expensive one.
    out = runner(["git", "-C", cwd, "ls-files", "-z", "--others", "--ignored",
                  "--exclude-standard", *asked])
    return wanted in (out or "").split("\0")


#: What `file --mime-type` answers, and the highlighter's name for it.
#:
#: `text/x-c` is not here on purpose. libmagic uses it for anything C-shaped,
#: and it calls Rust and Go C source — measured, both of them. A file with no
#: suffix that is really C is rare; painting Rust as C is a confident lie, and
#: no paint beats a wrong one. The rest were checked against real files.
BY_MIME = {
    "text/x-script.python": "python",
    "text/x-python": "python",
    "text/x-shellscript": "bash",
    "text/x-perl": "perl",
    "text/x-ruby": "ruby",
    "text/x-php": "php",
    "text/x-lua": "lua",
    "text/x-awk": "awk",
    "text/x-c++": "cpp",
    "text/x-java": "java",
    "application/json": "json",
    "text/xml": "xml",
    "application/xml": "xml",
}


def sniff_language(
    path: Path, runner: Callable[..., str | None] = run
) -> str | None:
    """What `file` makes of a file whose name gives nothing away.

    Only asked when the name and the shebang both came up empty, so it costs a
    subprocess once, when a file is opened. `file` is the third and last
    command this program runs, after git and tmux, and a machine without it
    simply gets no answer — the page paints nothing, which is what it did
    before this existed.

    `None` is "it did not answer", and `""` is "it answered, and the answer is
    not one we paint". They look the same on the page and are not the same
    thing to remember: the first is worth asking again, the second never is.
    """
    answer = runner(["file", "-b", "--mime-type", "--", str(path)])
    if not answer:
        return None
    return BY_MIME.get(answer.strip().lower(), "")


def worktree_target(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None,
) -> Path | None:
    """The file a name from the page points at, or None.

    The name comes from the page, so it is input, not fact. It has to be a
    name git itself offers, and the file it points at has to stay inside the
    worktree once every link is followed. Those two checks together cover
    `..`, an absolute path and a symbolic link out of the tree, without having
    to guess at each of them. See PLAN.md section 4.4.1.

    Both readers come through here, so neither can be given one check and not
    the other.

    `held` is the daemon's `Files`, which remembers where the worktree starts
    — the one answer here that does not change between polls. **`is_listed` is
    not remembered** — it is the check that git still offers this name, and a
    cached yes would mean a file could still be read after it was taken out of
    the tree.
    """
    root = held.root_of(cwd, runner) if held else worktree_root(cwd, runner)
    if not root or not is_listed(root, wanted, runner):
        return None
    return inside(root, Path(root) / wanted)


def read_worktree_bytes(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None,
) -> tuple[bytes, str] | None:
    """One file's own bytes and the type it is served with, or None.

    Only a name on `SHOWN_AS` — a picture, a video, a sound. The type comes
    from the end of the name and from nothing else, so the daemon never serves
    a document from its own origin, whatever a file holds.
    """
    kind = shown_as(wanted)
    if not kind:
        return None
    target = worktree_target(cwd, wanted, runner, held)
    if target is None:
        return None
    try:
        if not target.is_file() or target.stat().st_size > SHOWN_MAX_BYTES:
            return None
        return target.read_bytes(), kind
    except OSError:
        return None


def read_worktree_file(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None,
) -> FileText | None:
    """One file's content, or None.

    `held` also remembers what `file` made of a name that gives nothing away;
    the checks on the name itself are `worktree_target`'s.
    """
    target = worktree_target(cwd, wanted, runner, held)
    if target is None:
        return None
    try:
        if not target.is_file():
            return None
        info = target.stat()
        found = FileText(mtime=info.st_mtime, size=info.st_size)
        found.shown = shown_as(wanted)
        if found.shown:
            # A picture, a video or a sound. Its text is not text, and the
            # page asks for its bytes on the other route -- so reading half a
            # megabyte off it here, every two seconds for as long as it is on
            # screen, would be for nothing.
            found.binary = True
            found.oversize = info.st_size > SHOWN_MAX_BYTES
            return found
        # One byte past the cap is enough to know the file runs past it.
        # Reading it whole first put a tracked video in memory every poll.
        with target.open("rb") as handle:
            raw = handle.read(FILE_MAX_BYTES + 1)
    except OSError:
        return None
    if b"\0" in raw[:BINARY_SNIFF]:
        found.binary = True
        return found
    found.text = raw[:FILE_MAX_BYTES].decode("utf-8", "replace")
    if len(raw) > FILE_MAX_BYTES:
        found.text += "\n\n… the rest of this file is not shown.\n"
    # Only when nothing cheaper can answer. A shebang is the page's to read,
    # and it is the common shape for a file with no suffix, so asking `file`
    # about one is a subprocess for an answer already in hand.
    if not Path(wanted).suffix and not raw.startswith(b"#!"):
        found.language = (
            held.language_of(target, found.mtime, len(raw), runner) if held
            else (sniff_language(target, runner) or ""))
    return found


@dataclass
class DiffLine:
    """One line of a hunk."""

    kind: str = "context"       # context, added or removed
    text: str = ""


@dataclass
class Hunk:
    """One `@@` block of a file's diff."""

    header: str = ""
    lines: list[DiffLine] = field(default_factory=list)


@dataclass
class DiffFile:
    """What happened to one file."""

    path: str = ""
    old_path: str = ""
    status: str = ""            # name_change fills it in when the file is done
    added: int = 0
    removed: int = 0
    binary: bool = False
    hunks: list[Hunk] = field(default_factory=list)


@dataclass
class DiffSection:
    """One half of the Diff tab: the branch's work, or what is not committed."""

    name: str = ""
    title: str = ""
    #: One line saying exactly what this section is a diff of, in words rather
    #: than in git's. The titles used to be `origin/main...HEAD` and "not
    #: committed yet", which is precise and only readable if you already know
    #: what three dots mean -- so nobody could tell whether the tab was showing
    #: the last commit, the branch, the worktree, or some of each.
    about: str = ""
    files: list[DiffFile] = field(default_factory=list)


@dataclass
class DiffReport:
    """Everything the Diff tab shows for one worktree."""

    base: str = ""
    sections: list[DiffSection] = field(default_factory=list)
    untracked: list[str] = field(default_factory=list)
    cut: bool = False
    failed: bool = False    # git did not answer; "nothing changed" would lie


#: What git writes after a backslash inside a quoted path. Anything else it
#: escapes as `\\ooo`, one octal byte at a time.
QUOTE_ESCAPES = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r",
                 "t": "\t", "v": "\v", '"': '"', "\\": "\\"}


def unquote_path(text: str) -> str:
    """Undo git's C-style quoting of a path, if it is quoted.

    `core.quotePath=false` only stops the quoting of bytes above 0x80. A path
    holding a quote, a backslash or a control character is quoted whatever
    that setting says, and then the whole thing, `a/` prefix and all, sits
    inside the quotes. Left alone, `we"ird.txt` came out of a diff as
    `"b/we\\"ird.txt"` — a name the Files tab never produces, so the same line
    had two different anchors in the two tabs and a plain edit was reported as
    a rename.
    """
    if len(text) < 2 or not text.startswith('"') or not text.endswith('"'):
        return text
    body = text[1:-1]
    out = bytearray()
    at = 0
    while at < len(body):
        if body[at] != "\\":
            out += body[at].encode("utf-8")
            at += 1
            continue
        at += 1
        if at >= len(body):
            break
        mark = body[at]
        digits = body[at:at + 3]
        # Three octal digits and nothing else. `int(s, 8)` reads "1_2" as ten
        # and takes leading spaces, neither of which git ever wrote.
        if len(digits) == 3 and all(one in "01234567" for one in digits):
            out.append(int(digits, 8))
            at += 3
            continue
        out += QUOTE_ESCAPES.get(mark, mark).encode("utf-8")
        at += 1
    # `run` reads git the same way, so a byte that is not UTF-8 looks the same
    # here as it does in a file listing.
    return out.decode("utf-8", "replace")


def diff_header_paths(line: str) -> tuple[str, str]:
    """The old and new path out of a `diff --git a/old b/new` line.

    A file name holding ` b/` makes this line ambiguous, which is why git also
    writes `---` and `+++` lines. Those are read when they come; this is what
    a file with no content change, such as a plain rename, is left with.

    Either side may be quoted, and a quoted side starts with `"b/` rather than
    `b/`, so that is looked for first.
    """
    rest = line[len("diff --git "):]
    at = rest.rfind(' "b/')
    if at == -1:
        at = rest.rfind(" b/")
    if at == -1:
        return "", rest
    return diff_side(rest[:at]), diff_side(rest[at + 1:])


def diff_side(text: str) -> str:
    """The path out of a `--- a/path` or `+++ b/path` line. /dev/null is none."""
    if text == "/dev/null":
        return ""
    text = unquote_path(text)
    return text[2:] if text[:2] in ("a/", "b/") else text


def parse_diff(text: str) -> list[DiffFile]:
    """Turn `git diff` output into files, hunks and lines.

    Which lines are headers depends on where they are. Inside a hunk the first
    character is the only thing that matters, because the line after it is a
    line of the file: removing `-- a comment` writes `--- a comment`, which
    read as a header renamed the file to "a comment" and swallowed the rest of
    the hunk. Only `diff --git` and `@@` can start something new, and neither
    can be mistaken for content — content always carries its own first
    character in front.

    Only what the page shows is read. The index line, the mode lines and
    `\\ No newline at end of file` are passed over.

    Split on `\\n` and nothing else. `str.splitlines()` also breaks on a form
    feed, a vertical tab, `\\x1c`-`\\x1e` and `\\u0085`, and git does not escape
    any of those inside diff content — it only quotes paths. One form feed in
    a source line made every line after it in the hunk count one too high, so
    the Diff tab showed wrong numbers, the Files tab disagreed with it, and a
    review comment anchored to a line nobody commented on.
    """
    files: list[DiffFile] = []
    current: DiffFile | None = None
    hunk: Hunk | None = None
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()       # the newline that ends the last line, not a line
    for line in lines:
        if line.startswith("diff --git "):
            old, new = diff_header_paths(line)
            current = DiffFile(path=new, old_path=old)
            hunk = None
            files.append(current)
        elif current is None:
            continue        # a preamble git only writes for a combined diff
        elif line.startswith("@@"):
            hunk = Hunk(header=line)
            current.hunks.append(hunk)
        elif hunk is not None:
            if line.startswith("+"):
                current.added += 1
                hunk.lines.append(DiffLine("added", line[1:]))
            elif line.startswith("-"):
                current.removed += 1
                hunk.lines.append(DiffLine("removed", line[1:]))
            elif line.startswith(" ") or not line:
                hunk.lines.append(DiffLine("context", line[1:]))
            # anything else is `\\ No newline at end of file`
        elif line.startswith("--- "):
            current.old_path = diff_side(line[4:])
        elif line.startswith("+++ "):
            current.path = diff_side(line[4:])   # empty means the file is gone
        elif line.startswith("rename from "):
            current.old_path = unquote_path(line[len("rename from "):])
        elif line.startswith("rename to "):
            current.path = unquote_path(line[len("rename to "):])
        elif line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            current.binary = True
    for one in files:
        name_change(one)
    return files


def name_change(one: DiffFile) -> None:
    """Say what happened to a file, from the paths the diff gave it."""
    if not one.old_path:
        one.status = "added"
    elif not one.path:
        one.status = "deleted"
        one.path = one.old_path
    elif one.old_path != one.path:
        one.status = "renamed"
    else:
        one.status = "modified"


def diff_base(cwd: str, runner: Callable[..., str | None] = run) -> str:
    """The commit a branch's own work is measured against.

    `origin/HEAD` is the answer when the remote has said which branch is its
    default. A worktree built on a bare clone often has never been told, so the
    usual names are tried in turn. Without any of them there is no base, and
    the tab then shows only what is not committed.

    Two git runs, never five: `for-each-ref` answers for every fallback name at
    once, and the order the answers are read in is ours, not git's.
    """
    head = runner(["git", "-C", cwd, "symbolic-ref", "--quiet", "--short",
                   "refs/remotes/origin/HEAD"])
    if head and head.strip():
        return head.strip()
    found = runner(["git", "-C", cwd, "for-each-ref", "--format=%(refname:short)",
                    *(f"refs/{where}/{name}"
                      for where in ("remotes/origin", "heads")
                      for name in ("main", "master"))])
    have = set((found or "").split())
    for name in ("origin/main", "origin/master", "main", "master"):
        if name in have:
            return name
    return ""


def git_diff(
    cwd: str, args: Sequence[str], runner: Callable[..., str | None] = run
) -> tuple[str | None, bool]:
    """Run one diff. Returns its text, and whether it had to be cut short.

    None is not the same as "": git failed, timed out, or was killed. An empty
    diff says nothing changed, and saying that when we do not know is worse
    than saying nothing — it is the answer a reader would act on.
    """
    out = runner(
        ["git", "-C", cwd, "-c", "core.quotePath=false",
         "diff", "--no-color", "--no-ext-diff", *args],
        timeout=DIFF_TIMEOUT,
    )
    if out is None:
        return None, False
    # In bytes, and back to the last newline. `run` hands back text, so the
    # cap used to count code points and let a CJK diff through at about four
    # times the size — while `FILE_MAX_BYTES` measures real bytes, so the two
    # caps disagreed about what they meant. And a cut that landed inside a
    # `diff --git` line parsed as a file that does not exist, reported as a
    # rename, at the bottom of the tab: `cut` says something was dropped, not
    # that the last entry is fiction.
    if len(out) * 4 <= DIFF_MAX_BYTES:     # too small to be over, whatever is in it
        return out, False
    raw = out.encode("utf-8")
    if len(raw) <= DIFF_MAX_BYTES:
        return out, False
    whole = raw[:DIFF_MAX_BYTES].rpartition(b"\n")[0]
    return (whole + b"\n" if whole else b"").decode("utf-8", "replace"), True


def worktree_diff(cwd: str, runner: Callable[..., str | None] = run) -> DiffReport:
    """What this worktree has changed, in two parts.

    Committed: `git diff <base>...HEAD`, the branch's own work. The three dots
    leave out whatever landed on the base after the branch started, so what is
    shown is what this agent did. Uncommitted: `git diff HEAD`, what it changed
    and has not committed. git shows no untracked file in either, so their
    names are listed on their own.
    """
    report = DiffReport()
    root = worktree_root(cwd, runner)
    if not root:
        return report

    def section(name: str, title: str, about: str, *args: str) -> None:
        text, cut = git_diff(root, args, runner)
        report.cut = report.cut or cut
        report.failed = report.failed or text is None
        report.sections.append(
            DiffSection(name=name, title=title, about=about,
                        files=parse_diff(text or "")))

    report.base = diff_base(root, runner)
    if report.base:
        section("committed", "committed on this branch",
                f"every commit this branch has that {report.base} has not"
                f" \u2014 and nothing that landed on {report.base} since",
                report.base + "...HEAD")
    section("uncommitted", "not committed yet",
            "what the files on disk hold that the last commit does not",
            "HEAD")
    loose = untracked_files(root, runner)
    report.failed = report.failed or loose is None
    report.untracked = (loose or [])[:UNTRACKED_SHOWN]
    return report


# --- status: the status line payload, which carries name and context ---------


def status_from_payload(payload: dict[str, Any], now: float | None = None) -> Status:
    """Pick the few fields wostuast shows out of the status line JSON."""
    def nested(key: str) -> dict[str, Any]:
        value = payload.get(key)
        return value if isinstance(value, dict) else {}

    # Named field by field, like `read_ask`: a status payload is large and
    # growing, and a field nobody has read must not reach the page.
    limits: dict[str, dict[str, float]] = {}
    for window, one in nested("rate_limits").items():
        if not isinstance(one, dict):
            continue
        used = opt_float(one.get("used_percentage"))
        if used is None:
            continue
        limits[str(window)] = {"used_pct": used,
                               "resets_at": to_float(one.get("resets_at"))}
    return Status(
        ts=now if now is not None else time.time(),
        name=str(payload.get("session_name") or ""),
        model=str(nested("model").get("display_name") or ""),
        context_pct=opt_float(nested("context_window").get("used_percentage")),
        cost_usd=opt_float(nested("cost").get("total_cost_usd")),
        limits=limits,
        agent=str(nested("agent").get("name") or ""),
        version=str(payload.get("version") or ""),
    )


def write_status(session_id: str, status: Status) -> None:
    """Overwrite the status file of a session. It holds the latest value only."""
    if not session_id:
        return
    write_atomic(status_path(session_id), json.dumps(asdict(status)), private=True)


#: How long a name may be. Longer than `label` shows, so nothing is lost by
#: being clipped on screen, and short enough that the file cannot be used as a
#: place to keep something else.
NAME_MAX = 120


#: A pattern longer than this is refused. It is not a safety property --
#: nothing bounds what a regular expression costs -- but a pattern that long
#: is a mistake, and refusing it is cheaper than explaining the slowness.
LINK_PATTERN_MAX = 200

def risky_pattern(pattern: str) -> bool:
    """A quantifier inside a group that is itself quantified: `(a+)+`.

    This is the shape that backtracks catastrophically, and it is the one
    shape worth spotting. It is a heuristic and says so: nothing here can
    prove a regular expression is quick, and the page is what pays.
    """
    for at, char in enumerate(pattern):
        if char != "(":
            continue
        depth, close = 0, -1
        for here in range(at, len(pattern)):
            if pattern[here] == "\\":
                continue
            if pattern[here] == "(":
                depth += 1
            elif pattern[here] == ")":
                depth -= 1
                if depth == 0:
                    close = here
                    break
        if close < 0 or close + 1 >= len(pattern):
            continue
        body = pattern[at + 1:close]
        if pattern[close + 1] in "*+{" and any(one in body for one in "*+{"):
            return True
    return False


def link_trouble(one: Any) -> str:
    """What is wrong with one autolink entry, or empty when nothing is.

    The page is handed only the entries that pass, so a broken one is a line
    in `doctor` rather than a link that quietly does nothing.
    """
    if not isinstance(one, dict):
        return "not an object with `match` and `url`"
    match = one.get("match")
    url = one.get("url")
    if not isinstance(match, str) or not match:
        return "`match` is missing or not text"
    if not isinstance(url, str) or not url:
        return "`url` is missing or not text"
    if len(match) > LINK_PATTERN_MAX:
        return f"`match` is longer than {LINK_PATTERN_MAX} characters"
    if not url.startswith(("http://", "https://")):
        return "`url` does not start with http:// or https://"
    try:
        re.compile(match)
    except re.error as trouble:
        return f"`match` is not a regular expression: {trouble}"
    if risky_pattern(match):
        return ("`match` has a quantifier inside a quantified group, which can"
                " be slow enough to freeze the page")
    return ""


#: The file `serve` leaves behind when there is none, so that finding out how
#: to write one is opening it rather than reading a README.
#:
#: The entry is real and it is deliberately inert: nobody's work has a ticket
#: called `EXAMPLE-1`, so it matches nothing and links nothing. JSON has no
#: comments, so an example that explains itself has to be a working entry --
#: a commented-out one is not valid JSON, and a broken one would be a line in
#: `doctor` saying the file is wrong.
EXAMPLE_LINKS = [
    {"match": "EXAMPLE-(\\d+)",
     "url": "https://tickets.example.com/browse/EXAMPLE-$1"},
]


def write_example_links() -> bool:
    """Leave an example `links.json` when there is none. True if one was made.

    Never over an existing file, whatever is in it -- a file somebody wrote
    and got wrong is theirs, and `doctor` says what is wrong with it. And
    never a reason to fail: this is a convenience, and `serve` starts with or
    without it.
    """
    path = links_path()
    try:
        if path.exists():
            return False
        write_atomic(path, json.dumps(EXAMPLE_LINKS, indent=2) + "\n",
                     private=True)
        return True
    except OSError:
        return False


def load_links() -> tuple[list[dict[str, str]], list[str]]:
    """The autolinks that are usable, and what is wrong with the rest.

    One reader, because "no links" and "your file is broken" are different
    answers and looked the same: the page showed nothing either way, and the
    only way to find out was to run `doctor` you had no reason to run. This
    is the scar git already left here, in a second place.

    A missing file is not trouble -- most people want no autolinks. Anything
    else that stops an entry being used is, and the caller says it out loud.

    `\\d` is the one people write, and it is not a JSON escape: JSON allows
    `\\" \\\\ \\/ \\b \\f \\n \\r \\t` and `\\uXXXX` and nothing else, so a regular
    expression needs its backslash doubled. The file stays plain JSON --
    repairing it would be guessing, and the next surprise would be worse --
    so the message has to be the thing that reaches the reader.
    """
    path = links_path()
    if not path.exists():
        return [], []
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        return [], [f"cannot read {path}: {error}"]
    except ValueError as error:
        return [], [f"{path} is not valid JSON: {error}."
                    " A backslash in a pattern has to be doubled: `\\\\d`, not"
                    " `\\d`."]
    if not isinstance(payload, list):
        return [], [f"{path} is not a list of links"]
    good: list[dict[str, str]] = []
    trouble: list[str] = []
    for at, one in enumerate(payload):
        why = link_trouble(one)
        if why:
            trouble.append(f"link {at + 1} in {path}: {why}")
        else:
            good.append({"match": one["match"], "url": one["url"]})
    return good, trouble


def read_links() -> list[dict[str, str]]:
    """Only the usable ones, for a caller with nowhere to put the trouble."""
    return load_links()[0]


def read_limits() -> dict[str, dict[str, float]]:
    """Every spend limit the reader has set, or an empty map.

    `{session_id: {"limit": 10.0, "fired_at": 0.0}}`. It sits beside
    `names.json` and is the same kind of thing: state this program keeps
    because the page told it to, not a file anybody hand-edits. `links.json`
    is the config file `PLAN.md` goal 4 allows one of, and this is not a
    second one -- nothing here is typed into an editor, and wostuast could not
    work the number out, because only you know what an agent is worth to you.
    """
    try:
        payload = json.loads(limits_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    out: dict[str, dict[str, float]] = {}
    for key, one in payload.items():
        if not isinstance(key, str) or not isinstance(one, dict):
            continue
        limit = to_float(one.get("limit"))
        if limit > 0:
            out[key] = {"limit": limit, "fired_at": to_float(one.get("fired_at"))}
    return out


def write_limits(limits: dict[str, dict[str, float]]) -> None:
    write_atomic(limits_path(), json.dumps(limits), private=True)


def read_names() -> dict[str, str]:
    """Every name the reader has given, or an empty map."""
    try:
        payload = json.loads(names_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    return {
        str(key): str(value)[:NAME_MAX]
        for key, value in payload.items()
        if isinstance(key, str) and isinstance(value, str) and value.strip()
    }


def write_names(names: dict[str, str]) -> None:
    """Keep them. The file is ours and nobody else reads it, so it is one map
    rather than a file per session: there is no hook writing it in parallel."""
    write_atomic(names_path(), json.dumps(names), private=True)


def read_status(session_id: str) -> Status:
    """Read the status file of a session. A missing file gives an empty status."""
    try:
        payload = json.loads(status_path(session_id).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return Status()
    if not isinstance(payload, dict):
        return Status()
    kept = payload.get("limits")
    return Status(
        ts=to_float(payload.get("ts")),
        name=str(payload.get("name") or ""),
        model=str(payload.get("model") or ""),
        context_pct=opt_float(payload.get("context_pct")),
        cost_usd=opt_float(payload.get("cost_usd")),
        # Our own file, but it outlives the version that wrote it, so the
        # shape is checked rather than trusted -- an older wostuast wrote no
        # `limits` at all and a newer one must read that file, not fall over.
        limits={str(name): {"used_pct": to_float(one.get("used_pct")),
                            "resets_at": to_float(one.get("resets_at"))}
                for name, one in (kept or {}).items() if isinstance(one, dict)},
        agent=str(payload.get("agent") or ""),
        version=str(payload.get("version") or ""),
    )


def inside(root: Path | str, path: Path | str) -> Path | None:
    """The resolved path, if it really sits inside the resolved root.

    Resolving first is the whole point: it follows every symbolic link and
    flattens every `..`, so one comparison answers a question that a pattern
    over the raw text can only guess at. This is the check PLAN.md section
    4.4.1 rule 4 asks for, and both callers share it so it cannot drift.
    """
    try:
        top = Path(root).resolve()
        target = Path(path).resolve()
    except OSError:
        return None
    return target if target.is_relative_to(top) else None


def safe_transcript(path: str) -> Path | None:
    """A transcript we are willing to open, or None.

    The path arrives in an event, so it is input, not fact. Anything able to
    write the log could otherwise name any file on the machine and the daemon
    would serve it. A transcript lives under the Claude config directory and
    ends in .jsonl; nothing else is opened. PLAN.md section 4.4.1.
    """
    if not path:
        return None
    target = inside(settings_path().parent, path)
    return target if target is not None and target.suffix == ".jsonl" else None


def safe_name(session_id: str) -> str:
    """A session id is a UUID, but never trust it as a file name."""
    return re.sub(r"[^A-Za-z0-9_.-]", "_", session_id)[:128] or "unknown"


def money(dollars: float) -> str:
    """What a session has spent, short enough for a status line.

    Cents below ten dollars, because that is where the difference between one
    prompt and the next shows; whole dollars above it, because by then the
    cents are noise. It is Claude Code's own estimate at list price either
    way -- see `Status.cost_usd`.
    """
    return f"${dollars:.2f}" if dollars < 10 else f"${dollars:.0f}"


def status_line(status: Status, cwd: str) -> str:
    """The one line wostuast prints as the status line."""
    parts = [status.name or path_label(cwd)]
    if status.agent:
        parts.append(status.agent)
    if status.model:
        parts.append(status.model)
    if status.context_pct is not None:
        parts.append(f"{status.context_pct:.0f}% ctx")
    if status.cost_usd is not None:
        parts.append(money(status.cost_usd))
    return " · ".join(parts)


def drop_old_status(now: float | None = None) -> None:
    """Remove status files of sessions that are long gone."""
    moment = now if now is not None else time.time()
    try:
        for entry in status_dir().glob("*.json"):
            if moment - entry.stat().st_mtime > SESSION_MAX_AGE:
                entry.unlink()
    except OSError:
        pass


# --- settings.json: add and remove our hooks without touching anything else --


def detect_indent(text: str) -> int | str:
    """Guess the indentation of a JSON file so we write it back the same way."""
    match = re.search(r"\n([ \t]+)\S", text)
    if not match:
        return 2
    lead = match.group(1)
    return "\t" if lead.startswith("\t") else len(lead)


def hook_entry(command: str) -> dict[str, Any]:
    return {"type": "command", "command": command}


def words_of(command: str) -> list[str]:
    """Split a command the way a shell would, and fall back to plain spaces."""
    import shlex

    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def is_ours(command: Any, verb: str) -> bool:
    """True when this command runs our program with this verb.

    It matches the shape, not the exact string: `wostuast status`,
    `~/.local/bin/wostuast status` and `wostuast status --then '...'` are all
    ours. Anything after the verb is ours too, which is what stops `install`
    offering to wrap a line it wrote itself: run twice, it used to suggest
    `wostuast status --then 'wostuast status --then ...'`.
    """
    if not isinstance(command, str):
        return False
    words = words_of(command)
    return len(words) >= 2 and words[1] == verb and os.path.basename(words[0]) == "wostuast"


def has_verb(group: Any, verb: str) -> bool:
    """True when this matcher group already runs our program with this verb."""
    if not isinstance(group, dict):
        return False
    return any(
        isinstance(entry, dict) and is_ours(entry.get("command"), verb)
        for entry in group.get("hooks") or []
    )


def add_hooks(settings: dict[str, Any], command: str) -> list[str]:
    """Add our hook entries. Returns one line per change."""
    changes: list[str] = []
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("settings.json has a 'hooks' key that is not an object")
    for event in HOOK_EVENTS:
        groups = hooks.setdefault(event, [])
        if not isinstance(groups, list):
            raise ValueError(f"settings.json has a '{event}' key that is not a list")
        if any(has_verb(group, "hook") for group in groups):
            continue
        group: dict[str, Any] = {"hooks": [hook_entry(command)]}
        if event in MATCHER_EVENTS:
            group = {"matcher": "*", **group}
        groups.append(group)
        changes.append(f"added hook {event}")
    return changes


def remove_hooks(settings: dict[str, Any]) -> list[str]:
    """Remove only the entries that run our program.

    A key we took nothing out of is left exactly as it was, empty list and all.
    A key we emptied is removed, so a machine that had no hooks before install
    has none after uninstall. The one case those two rules cannot tell apart is
    a key the user left empty that we then added to: it ends up removed rather
    than empty. Claude Code reads both as "no hooks for this event", so nothing
    is lost, and no entry of the user's is ever touched.
    """
    changes: list[str] = []
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return changes
    for event in list(hooks.keys()):
        groups = hooks.get(event)
        if not isinstance(groups, list):
            continue
        kept_groups = []
        removed_here = False
        for group in groups:
            entries = group.get("hooks") if isinstance(group, dict) else None
            if not isinstance(entries, list):
                kept_groups.append(group)
                continue
            kept = [
                entry
                for entry in entries
                if not (isinstance(entry, dict) and is_ours(entry.get("command"), "hook"))
            ]
            if len(kept) == len(entries):
                kept_groups.append(group)   # untouched, empty list and all
                continue
            changes.append(f"removed hook {event}")
            removed_here = True
            if kept:
                group["hooks"] = kept
                kept_groups.append(group)
            # A group we emptied goes: a machine with no hooks before install
            # has none after uninstall.
        # Only rewrite a key we actually took something out of. An empty list
        # the user put there is theirs, and deleting it would be a silent edit.
        if not removed_here:
            continue
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if changes and not hooks:
        settings.pop("hooks", None)
    return changes


def add_status_line(settings: dict[str, Any], command: str) -> list[str]:
    """Register our status line, but never overwrite one the user already has."""
    current = settings.get("statusLine")
    if isinstance(current, dict) and is_ours(current.get("command"), "status"):
        return []
    if current:
        yours = current.get("command") if isinstance(current, dict) else ""
        if not isinstance(yours, str) or not yours:
            return ["kept your status line; wostuast could not read it to suggest a line"]
        import shlex

        return [
            "kept your status line, because Claude Code allows only one.",
            "  To have both, change statusLine.command in your settings to:",
            f"    {command} --then {shlex.quote(yours)}",
            "  wostuast then reads the session name and context percent and runs",
            "  your line, so the terminal shows exactly what it shows today.",
            "  Without this, sessions have no name and no context percent.",
        ]
    settings["statusLine"] = {"type": "command", "command": command}
    return ["added status line"]


def remove_status_line(settings: dict[str, Any]) -> list[str]:
    """Remove the status line only when it is ours."""
    current = settings.get("statusLine")
    if isinstance(current, dict) and is_ours(current.get("command"), "status"):
        del settings["statusLine"]
        return ["removed status line"]
    return []


def load_settings(path: Path) -> tuple[dict[str, Any], int | str, bool]:
    """Read settings.json. Returns the data, its indentation and its last newline."""
    if not path.exists():
        return {}, 2, True
    text = path.read_text(encoding="utf-8")
    if not text.strip():
        return {}, 2, True
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError(f"{path} does not hold a JSON object")
    return data, detect_indent(text), text.endswith("\n")


def save_settings(path: Path, data: dict[str, Any], indent: int | str, newline: bool) -> None:
    """Write the user's settings back, as their own file.

    Their permissions are kept. This file can hold API keys and environment
    values, and `install` promises to touch nothing but our own hooks — it
    used to hand a 0600 file back at 0644.
    """
    import stat

    text = json.dumps(data, indent=indent, ensure_ascii=False)
    try:
        mode: int | None = stat.S_IMODE(path.stat().st_mode)
    except OSError:
        mode = None            # no settings file yet; the umask decides
    write_atomic(path, text + "\n" if newline else text, mode=mode, sync=True)


# --- output helpers ----------------------------------------------------------


def use_color() -> bool:
    """Colour only a real terminal, and never when NO_COLOR is set."""
    return not os.environ.get("NO_COLOR") and sys.stdout.isatty()


RESET = "\033[0m"


def paint(text: str, state: str, color: bool) -> str:
    if not color:
        return text
    return f"{STATE_COLORS.get(state, '')}{text}{RESET}"


def ago(seconds: float) -> str:
    """A short age: `40s`, `4min`, `2h 15min`, `2d 6h`.

    Two units once the first one is coarse. `2d` covers anything from two
    days to just short of three, which is not an answer to "when did this
    last do something"; `40s` needs no second unit at all. The second is left
    off when it is nought, so `2d` still means exactly two days.
    """
    seconds = int(max(0.0, seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}min"
    if seconds < 86400:
        return _two(seconds // 3600, "h", seconds % 3600 // 60, "min")
    return _two(seconds // 86400, "d", seconds % 86400 // 3600, "h")


def _two(big: int, big_unit: str, small: int, small_unit: str) -> str:
    return f"{big}{big_unit} {small}{small_unit}" if small else f"{big}{big_unit}"


def changes_column(facts: GitFacts) -> str:
    parts = []
    if facts.ahead:
        parts.append(f"↑{facts.ahead}")
    if facts.behind:
        parts.append(f"↓{facts.behind}")
    if facts.dirty:
        parts.append(f"●{facts.touched_files}")
    elif facts.branch:
        parts.append("✓")
    return " ".join(parts)


def table(rows: Sequence[tuple[str, Sequence[str]]], color: bool) -> str:
    """Left-align every column. The last one is not padded. Each row says its
    own state, which gives it its colour; an empty state means no colour.

    Control characters come out of the cells here, which is why this is the
    one place a row is turned into a line. The last column holds a
    `Notification` message or a summary of a tool input — text an agent wrote,
    and a hostile file or a prompt injection can steer it. One of those set
    the terminal's title and turned the rest of the output red, and the column
    widths went wrong besides, because `len` counts an escape sequence. The
    page is careful about exactly this text, and so is `tmux_send`.
    """
    if not rows:
        return ""
    rows = [(state, [CONTROL_CHARS.sub("", cell) for cell in cells])
            for state, cells in rows]
    widths = [0] * len(rows[0][1])
    for _, cells in rows:
        for index, cell in enumerate(cells[:-1]):
            widths[index] = max(widths[index], len(cell))
    lines = []
    for state, cells in rows:
        padded = [cell.ljust(widths[index]) for index, cell in enumerate(cells[:-1])]
        line = "  ".join([*padded, cells[-1]]).rstrip()
        lines.append(paint(line, state, color) if state else line)
    return "\n".join(lines)


# --- tmux: the three verbs, and nothing else ---------------------------------

# wostuast reads; the user types. These three are the only commands it runs,
# and only jump and send write anything at all. See PLAN.md section 4.5.
#
# `runner` is looked up when the verb is called, not when it is defined. A
# default of `run` is bound once, at import, and then no test of the route
# above these can put a fake tmux in its place — which is the only way to
# test the verbs without a terminal to type into.


def tmux_jump(pane: str, runner: Callable[..., str | None] | None = None,
              focus: str | None = None) -> bool:
    """Put the cursor in that pane: its window first, then the pane itself."""
    if not pane:
        return False
    runner = runner or run
    moved = runner(["tmux", "select-window", "-t", pane]) is not None
    runner(["tmux", "select-pane", "-t", pane])
    # Raising the terminal window is the window manager's job and every desk
    # does it differently, so the command is the user's own to set. It is
    # their environment, run the way they would write it.
    wanted = os.environ.get("WOSTUAST_FOCUS", "") if focus is None else focus
    if wanted:
        runner(["sh", "-c", wanted])
    return moved


def tmux_interrupt(pane: str,
                   runner: Callable[..., str | None] | None = None) -> bool:
    """Stop what an agent is doing, without ending it.

    **Escape, never Ctrl-C.** Claude Code's own documentation: Escape stops
    the current response or tool call mid-turn and "Claude keeps the work done
    so far"; Ctrl-C "interrupts a running operation" but "if nothing is
    running, the first press clears the prompt input and a second press exits
    Claude Code". A turn can end between deciding to stop a session and the
    key landing, so Ctrl-C on a limit is a race whose losing side is a session
    that quit. Escape on an idle prompt does nothing.

    It is a key name rather than literal text, so it is the shape of the
    `Enter` press `tmux_send` already makes -- not something that could go
    through `tmux_send`, which strips every byte below a space on purpose.
    Measured: `send-keys -t <pane> C-c` puts 0x03 into a raw-mode app as a
    keystroke it reads, not as a signal. Nothing here signals a process.
    """
    if not pane:
        return False
    runner = runner or run
    return runner(["tmux", "send-keys", "-t", pane, "Escape"]) is not None


def tmux_send(pane: str, text: str,
              runner: Callable[..., str | None] | None = None) -> bool:
    """Type text into a pane, then press Enter.

    `-l` sends the text literally, so nothing here escapes anything: an escape
    of our own would arrive as characters. `--` stops tmux reading a leading
    dash as an option of its own. Empty text is refused, because a bare Enter
    into an agent's prompt is a keystroke nobody asked for.

    A newline typed into a terminal *is* Enter, so a message of two lines
    would submit its first line and leave the second sitting on the prompt —
    measured against a real shell, which ran it. Text with a newline in it is
    therefore wrapped in the bracketed paste markers, which say "this arrived
    as a paste, do not act on it yet"; every program that accepts a multi-line
    prompt understands them. One line is sent exactly as it always was, so a
    program that does not understand the markers never sees them.

    Control characters are taken out first, and this is the one place that has
    to happen. A paste ends at `ESC [ 2 0 1 ~`, so text carrying those bytes
    would close the paste early and everything after it would arrive as
    keystrokes — with a newline among them, as Enter. The page composes a
    review out of lines an agent wrote, so that text is not only what a person
    typed, and an escape byte is invisible in a preview. Tab and newline stay;
    they are what a pasted message is made of.
    """
    text = CONTROL_CHARS.sub("", text)
    if not pane or not text.strip():
        return False
    runner = runner or run
    body = text
    if "\n" in text:
        body = PASTE_START + text + PASTE_END
    if runner(["tmux", "send-keys", "-t", pane, "-l", "--", body]) is None:
        return False
    return runner(["tmux", "send-keys", "-t", pane, "Enter"]) is not None


# --- the daemon: one page, a little JSON, and a stream of changes ------------


class Client:
    """One browser tab listening to the event stream."""

    def __init__(self, watching: str = "") -> None:
        import queue

        self.queue: Any = queue.Queue(maxsize=CLIENT_BACKLOG)
        self.full, self.empty = queue.Full, queue.Empty
        self.watching = watching

    def put(self, message: str) -> None:
        """Queue a message, and drop the oldest rather than block or grow."""
        try:
            self.queue.put_nowait(message)
        except self.full:
            try:
                self.queue.get_nowait()
                self.queue.put_nowait(message)
            except (self.empty, self.full):
                pass


class Hub:
    """The browsers that are listening. Separate from the Store, because a tab
    closing has nothing to do with what the agents are doing."""

    def __init__(self) -> None:
        import threading

        self.clients: set[Client] = set()
        self.lock = threading.Lock()

    def add(self, watching: str = "") -> Client:
        client = Client(watching)
        with self.lock:
            self.clients.add(client)
        return client

    def drop(self, client: Client) -> None:
        with self.lock:
            self.clients.discard(client)

    def watchers(self) -> set[str]:
        with self.lock:
            return {c.watching for c in self.clients if c.watching}

    def send(self, kind: str, data: Any, session_id: str = "") -> None:
        """Send to every client, or only to those watching one session."""
        body = json.dumps(data, ensure_ascii=False, default=str)
        message = f"event: {kind}\ndata: {body}\n\n"
        with self.lock:
            targets = [
                client
                for client in self.clients
                if not session_id or client.watching == session_id
            ]
        for client in targets:
            client.put(message)


class Daemon:
    """The Store, the browsers, and the one thread that writes to the Store."""

    def __init__(self) -> None:
        import threading

        import secrets

        self.store = Store()
        self.hub = Hub()
        self.files = Files()
        # Any site can send this daemon a POST; only a page that has read this
        # token can send one that acts. It is made here and printed into the
        # page, and it lives as long as the daemon does. See PLAN.md 4.4.1.
        self.token = secrets.token_urlsafe(32)
        self.transcripts: dict[str, Transcript] = {}
        self.lock = threading.Lock()
        self.stopping = threading.Event()
        self.started = time.time()

    def session(self, session_id: str) -> Session | None:
        return self.store.sessions.get(session_id)

    def transcript(self, session_id: str) -> Transcript | None:
        """The transcript reader for a session, made on first use."""
        session = self.session(session_id)
        if session is None:
            return None
        path = safe_transcript(session.transcript_path)
        if path is None:
            return None
        held = self.transcripts.get(session_id)
        if held is None or held.tail.path != path:
            # A session resumed from another directory writes under another
            # name, so this is a different reading of the same session and
            # `seq` starts again. Say so, or the page patches the new blocks
            # over the head of the old ones and leaves the old tail below.
            held = Transcript(str(path), session.cwd,
                              run=held.run + 1 if held else 0)
            self.transcripts[session_id] = held
        return held

    def read_transcript(
        self, session_id: str
    ) -> tuple[list[Block], int] | None:
        """Read whatever is new, tell the watchers, and hand back every block.

        Both the tick and a request for the tab come through here, under one
        lock. Two threads calling `read_new` at once moved the byte offset
        twice, which then looked like a shrinking file and re-read the whole
        transcript from the top. Reading in a request and not telling the
        watchers lost those blocks for every other tab.
        """
        with self.lock:
            reader = self.transcript(session_id)
            if reader is None:
                return None
            changed = reader.read_new()
            blocks = list(reader.blocks)
            run = reader.run
            fresh = run != reader.run_sent   # a reading nobody has been told of
            reader.run_sent = run
        if changed or fresh:
            self.hub.send("transcript",
                          {"id": session_id, "run": run,
                           "blocks": blocks_json(changed)},
                          session_id=session_id)
        return blocks, run

    def sessions_payload(self) -> dict[str, Any]:
        return {"now": time.time(), "sessions": self.store.rows}

    def tick(self) -> None:
        """One pass: fold new events, then tell the browsers what changed."""
        moved = self.store.refresh()
        # After the fold, so the spend being read is the one the newest status
        # line gave; before the push, so the row the browsers get already says
        # the session was stopped. It is the one thing this program does to a
        # terminal that nobody pressed a button for, so it is guarded three
        # ways in `over_limit` and it says so in the session's own log.
        stopped = self.store.over_limit()
        for pane in stopped:
            tmux_interrupt(pane)
        # A stop moves `fired_at` and the session's last event, and both are
        # in the row -- so the rows are built again before they go out, or the
        # browsers hear about it a tick late. Written as its own statement:
        # `moved or self.store.refresh()` short-circuits, so on a tick that
        # had already changed something the second read never ran at all.
        if stopped:
            moved = self.store.refresh() or moved
        if moved:
            self.hub.send("sessions", self.sessions_payload())
        for session_id in self.hub.watchers():
            self.read_transcript(session_id)
        self.forget_gone()
        self.files.forget(LISTING_KEPT)

    def forget_gone(self) -> None:
        """Drop the readers of sessions that are no longer shown.

        A reader holds every block of a transcript. Without this they pile up
        for as long as the daemon runs, one for every session ever selected.
        """
        with self.lock:
            for session_id in list(self.transcripts):
                if session_id not in self.store.sessions:
                    del self.transcripts[session_id]

    def run(self) -> None:
        while not self.stopping.is_set():
            try:
                self.tick()
            except Exception as error:  # a bad tick must not stop the daemon
                log(f"tick failed: {error!r}")
            self.stopping.wait(TICK)


def blocks_json(blocks: Sequence[Block]) -> list[dict[str, Any]]:
    """Blocks as the page wants them. Results are cut: the page shows a line."""
    return [dict(block.__dict__, result=clip_lines(block.result, 40))
            for block in blocks]


def clip_lines(text: str, limit: int) -> str:
    """Keep the first lines of a tool result, and say how many were dropped."""
    if not text:
        return ""
    lines = text.splitlines()
    if len(lines) <= limit:
        return text
    rest = len(lines) - limit
    return "\n".join(lines[:limit]) + f"\n… {rest} more line{'s' if rest > 1 else ''}"


class Serving:
    """Every route the daemon answers, and none of the HTTP plumbing.

    It subclasses nothing, so it lives out here at one indent rather than
    three hundred lines deep inside `make_server`. The plumbing is mixed in
    there, where `http.server` is imported: a bare interpreter starts in
    10.8 ms and one that has imported `http.server` in 49.5 ms, and the hook
    pays for every import on every tool call. Deferring that import is what
    matters; nesting the routes was only how it was first written.

    `make_server` puts the daemon on the subclass it builds, so each server
    has its own.
    """

    daemon: Daemon           # set on the subclass, in `make_server`

    def log_message(self, fmt: str, *args: Any) -> None:
        pass  # the access log goes nowhere; our own log has what matters

    def reply(self, code: int, body: bytes, kind: str,
              cache: str = "no-store") -> None:
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        # `raw` serves a worktree file, and the type it is given comes from
        # the end of its name. A browser that sniffed the bytes instead could
        # read a file called `a.png` as something else entirely, on the origin
        # that holds the token.
        self.send_header("X-Content-Type-Options", "nosniff")
        # No Access-Control-Allow-Origin, ever. Another site may send a
        # request here, but without this header it cannot read the answer.
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(body)

    def reply_json(self, data: Any, code: int = 200) -> None:
        body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
        self.reply(code, body, "application/json; charset=utf-8")

    def ours(self) -> bool:
        """True when this request really is for the loopback address.

        Binding to 127.0.0.1 keeps other machines out, and sending no
        Access-Control-Allow-Origin keeps another site from reading the
        answer. Neither stops a site pointing its own name at 127.0.0.1:
        the browser then treats us as that site's own origin and lets it
        read everything. The Host header is what gives that away.

        A request with no Host at all is refused. The empty string used to be
        in this list for a bare HTTP/1.0 client, which meant the check could
        be skipped by leaving the header out. Every browser sends it.
        """
        sent = self.headers.get("Host")
        if not sent:
            return False
        host = sent.rsplit(":", 1)[0].strip("[]")
        return host in ("localhost", "127.0.0.1", "::1")

    def origin_ours(self) -> bool:
        """The Origin, when a browser sent one, is a page of ours.

        A same-origin `fetch` sends none at all, which is why no Origin is
        allowed through. It fails closed on a header it cannot read:
        `Origin: http://[::1` is a `ValueError` out of `urlparse`, and that
        used to leave the thread with no status line sent and a traceback in
        the terminal running `serve`.
        """
        from urllib.parse import urlparse

        origin = (self.headers.get("Origin") or "").strip()
        if not origin:
            return True
        try:
            where = urlparse(origin).hostname
        except ValueError:
            return False
        return where in ("localhost", "127.0.0.1", "::1")

    def allowed(self) -> bool:
        """Whether a POST may act on the terminal.

        Two things beyond the Host header. The Origin, which a browser
        sets on a cross-origin POST and which has to be ours when it is
        there at all. And the token this daemon made at start and printed
        into the page, in a header of its own. A cross-origin `fetch` may
        send a plain POST with no questions asked, and the effect here is
        `tmux send-keys` into a live terminal, so neither check is spare.

        The token header fails closed too: one byte above 0x7f in it is a
        `TypeError` out of `compare_digest`, because headers arrive as
        latin-1.
        """
        import hmac

        if not self.origin_ours():
            return False
        sent = self.headers.get(TOKEN_HEADER) or ""
        if not sent.isascii():
            return False
        return hmac.compare_digest(sent, self.daemon.token)

    def stale_page(self) -> bool:
        """Whether a refused POST is a page from an earlier `serve`.

        The token is made fresh in `Daemon.__init__` and printed into the
        page, so restarting `serve` leaves every open page holding one this
        daemon has never heard of. The stream is a GET and reconnects, so
        the sidebar goes on moving and the page looks perfectly alive while
        every send, every jump and every answered question is refused -- in
        every session at once, because the token belongs to the daemon and
        not to a session. It cost a reader an afternoon, and `doctor` could
        not have told them: the page is the only thing that knows.

        This is only ever the *wording* of a refusal. `allowed()` has
        already said no and nothing here changes that. It is true when the
        request came from a page of ours and carried a token that is simply
        not this one; a cross-origin caller fails `origin_ours` and is told
        nothing it did not already know.
        """
        sent = self.headers.get(TOKEN_HEADER) or ""
        return bool(sent) and sent.isascii() and self.origin_ours()

    def asked(self) -> dict[str, Any]:
        """The JSON a POST carried, or an empty one.

        `too_big` is set beside it, because an empty body and a body that
        was refused for its size are not the same answer and the routes see
        only the empty one: `send` read it as "there is nothing to send".

        It is read before anything is checked, because a body left in the
        socket makes the next request on that connection nonsense. A body
        too large to read is not read — so that connection is closed instead
        of being kept alive: the refusal used to leave 70 KB of the caller's
        choosing in the socket, and the daemon answered the `GET` written in
        the middle of it. Three responses on one connection, the second one
        framed by whoever sent the first.
        """
        # Cleared first, not merely set below: with keep-alive one handler
        # object serves every request on a connection, so a flag left standing
        # would answer for the next one.
        self.too_big = False
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length > POST_MAX:
            self.close_connection = True
            # Said out loud, because the routes see only the empty body this
            # returns: `send` read it as "there is nothing to send", which is
            # the opposite of what happened.
            self.too_big = True
            return {}
        if length <= 0:
            return {}
        try:
            body = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}
        return body if isinstance(body, dict) else {}

    def guarded(self, route: Callable[[], None]) -> None:
        """Run a request with nothing outside the guard.

        The checks used to sit in front of the `try`, where a header they
        could not parse killed the thread with no status line sent and a
        traceback into the terminal running `serve`. They fail closed on
        their own now; this is what catches whatever nobody thought of.
        """
        try:
            route()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as error:
            log(f"request {self.path} failed: {error!r}")
            try:
                self.reply_json({"error": "something went wrong"}, 500)
            except OSError:
                pass

    def do_POST(self) -> None:  # noqa: N802 - the name http.server requires
        self.guarded(self.route_post)

    def route_post(self) -> None:
        from urllib.parse import urlparse

        body = self.asked()
        if not self.ours():
            self.reply_json({"error": "wostuast answers on localhost only"},
                            403)
            return
        if not self.allowed():
            if self.stale_page():
                self.reply_json(
                    {"error": "wostuast was restarted, so this page is out of"
                              " date. Reload it.", "stale": True}, 403)
            else:
                self.reply_json({"error": "that did not come from this page"},
                                403)
            return
        parts = urlparse(self.path).path.strip("/").split("/")
        if len(parts) == 4 and parts[:2] == ["api", "session"] and parts[2]:
            verb = POST_VERBS.get(parts[3])
            if verb is None:
                self.reply_json({"error": "no such thing"}, 404)
            else:
                verb(self, parts[2], body)
        else:
            self.reply_json({"error": "no such thing"}, 404)

    def in_tmux(self, session_id: str) -> Session | None:
        """The session, when it is one the verbs can reach at all."""
        session = self.known(session_id)
        if session is None:
            return None
        if not session.pane:
            self.reply_json({"id": session_id,
                             "error": "this session is not in tmux"}, 409)
            return None
        return session

    def jump(self, session_id: str, body: dict[str, Any]) -> None:
        session = self.in_tmux(session_id)
        if session is None:
            return
        # Like `send` below: an answer carrying no `error` clears the live
        # slot, so a jump into a pane tmux has since closed failed with
        # nothing at all on the page.
        if not tmux_jump(session.pane):
            self.reply_json({"id": session_id,
                             "error": "tmux would not go to that pane"}, 502)
            return
        self.reply_json({"id": session_id, "done": True})

    def name(self, session_id: str, body: dict[str, Any]) -> None:
        """Name a session, or take its name away with an empty one.

        It writes no terminal, so it needs no pane: a session that has ended
        can still be named, which is the point of naming one at all.
        """
        session = self.known(session_id)
        if session is None:
            return
        asked = body.get("name")
        given = self.daemon.store.rename(
            session_id, asked if isinstance(asked, str) else "")
        # Nothing is pushed from here. A rename is not an event, but the rows
        # are built from the names on every pass, so the next one differs and
        # goes out on its own. The answer carries the name so the page can
        # show it without waiting for that.
        self.reply_json({"id": session_id, "name": given, "done": True})

    def interrupt(self, session_id: str, body: dict[str, Any]) -> None:
        """Stop what the agent is doing. Escape, not Ctrl-C: see
        `tmux_interrupt` for why the other one can end a session."""
        session = self.in_tmux(session_id)
        if session is None:
            return
        if not tmux_interrupt(session.pane):
            self.reply_json({"id": session_id,
                             "error": "tmux would not take it"}, 502)
            return
        self.reply_json({"id": session_id, "done": True})

    def limit(self, session_id: str, body: dict[str, Any]) -> None:
        """Set what a session may spend before wostuast stops it.

        It writes no terminal itself, like `name` -- but unlike `name` it is
        what lets the daemon write one later, so it is the same POST with the
        same token and origin behind it. Nought takes the limit away.
        """
        session = self.known(session_id)
        if session is None:
            return
        asked = body.get("limit")
        if not isinstance(asked, (int, float)) or asked != asked or asked < 0:
            self.reply_json({"id": session_id,
                             "error": "a limit is a number of dollars,"
                                      " or nought for none"}, 400)
            return
        if asked > LIMIT_MAX:
            self.reply_json({"id": session_id,
                             "error": f"the most that can be set is"
                                      f" ${LIMIT_MAX:.0f}"}, 400)
            return
        given = self.daemon.store.set_limit(session_id, float(asked))
        self.reply_json({"id": session_id, "limit": given, "done": True})

    def send(self, session_id: str, body: dict[str, Any]) -> None:
        session = self.in_tmux(session_id)
        if session is None:
            return
        if self.too_big:
            self.reply_json({"id": session_id,
                             "error": "that message is too large to accept"},
                            413)
            return
        text = body.get("text")
        text = text if isinstance(text, str) else ""
        if not text.strip():
            self.reply_json({"id": session_id,
                             "error": "there is nothing to send"}, 400)
            return
        # Bytes, because that is what tmux counts. See `SEND_MAX`.
        size = len(text.encode("utf-8", "replace"))
        if size > SEND_MAX:
            self.reply_json({"id": session_id,
                             "error": f"that is {size} bytes, and the most"
                                      f" that can be typed is {SEND_MAX}"},
                            400)
            return
        if session.state in GONE_STATES:
            self.reply_json({"id": session_id,
                             "error": "this session is over"}, 409)
            return
        # "It did not work" and nothing else on the page is how this arrives
        # for a reader: `done: false` carries no `error`, so `said` clears the
        # slot and writes nothing into it. A refusal from tmux is something
        # you asked for and did not get, and it has to say so.
        #
        # And it must not say more than it knows. `tmux_send` runs two
        # commands: the text, then Enter. If the second one failed the text is
        # already sitting on the agent's prompt, and "nothing went in" would
        # send the reader back to type it a second time -- so the message says
        # to look, which is the only thing that settles it.
        if not tmux_send(session.pane, text):
            self.reply_json({"id": session_id,
                             "error": "tmux did not answer. Look at the pane"
                                      " before sending again: the text may be"
                                      " on the prompt, unsent."}, 502)
            return
        self.reply_json({"id": session_id, "done": True})

    def do_GET(self) -> None:  # noqa: N802 - the name http.server requires
        self.guarded(self.route_get)

    def route_get(self) -> None:
        from urllib.parse import parse_qs, urlparse

        if not self.ours():
            self.reply_json({"error": "wostuast answers on localhost only"}, 403)
            return
        url = urlparse(self.path)
        path = url.path
        query = parse_qs(url.query)
        parts = path.strip("/").split("/")
        if path == "/":
            page = PAGE.replace(TOKEN_MARK, self.daemon.token)
            self.reply(200, page.encode("utf-8"), "text/html; charset=utf-8")
        elif path == "/api/sessions":
            self.reply_json(self.daemon.sessions_payload())
        elif path == "/api/links":
            # The reader's own, not a session's, so it hangs off nothing. It
            # is read from disk here rather than held, because it changes
            # when a person edits a file and a reload should be enough.
            usable, trouble = load_links()
            self.reply_json({"links": usable, "trouble": trouble})
        elif path == "/api/events":
            self.stream(query.get("watch", [""])[0])
        elif len(parts) == 4 and parts[:2] == ["api", "session"] and parts[2]:
            verb = GET_VERBS.get(parts[3])
            if verb is None:
                self.reply_json({"error": "no such thing"}, 404)
            else:
                verb(self, parts[2], query)
        else:
            self.reply_json({"error": "no such thing"}, 404)

    def known(self, session_id: str) -> Session | None:
        """The session, or None with a 404 already sent."""
        session = self.daemon.session(session_id)
        if session is None:
            self.reply_json({"error": "no such session"}, 404)
        return session

    def transcript(self, session_id: str, query: dict[str, list[str]]) -> None:
        found = self.daemon.read_transcript(session_id)
        if found is None:
            self.reply_json({"id": session_id, "blocks": [],
                             "missing": "no transcript for this session"})
            return
        blocks, run = found
        self.reply_json({"id": session_id, "run": run,
                         "blocks": blocks_json(blocks)})

    def files(self, session_id: str, query: dict[str, list[str]]) -> None:
        session = self.known(session_id)
        if session is None:
            return
        held = self.daemon.files.of(session.cwd)
        tree = held.tree
        body = {
            "id": session_id, "root": tree.root, "total": tree.total,
            "cut": tree.cut, "failed": tree.failed, "tag": held.tag,
            # The ignored directories too big to walk, and the number that
            # decided it. Both every time: they are a few dozen bytes, and
            # they are not in the tag, which is a hash of the names.
            "skipped": tree.skipped, "ignored_max": IGNORED_MAX,
            # Name to modification time, for the few files that moved. The
            # page needs the time to put the newest change first.
            "changed": held.changed,
        }
        # The browser sends back the tag it already holds. Names change
        # when a file is added or removed, which is rare; which files have
        # changed moves every few seconds. So a poll costs a few hundred
        # bytes instead of the 1.7 MB that fifty thousand names weigh.
        if not held.tag or query.get("have", [""])[0] != held.tag:
            body["names"] = held.names
        self.reply_json(body)

    def file(self, session_id: str, query: dict[str, list[str]]) -> None:
        session = self.known(session_id)
        if session is None:
            return
        wanted = query.get("path", [""])[0]
        found = read_worktree_file(session.cwd, wanted,
                                   held=self.daemon.files)
        if found is None:
            self.reply_json({"id": session_id, "path": wanted,
                             "missing": "that file is not in this worktree"}, 404)
            return
        self.reply_json(dict(asdict(found), id=session_id, path=wanted))

    def raw(self, session_id: str, query: dict[str, list[str]]) -> None:
        """One file of the worktree as its own bytes, for the page to show.

        The same checks every read makes, and one this route needs and the
        others do not: the type is decided by the end of the name, from a
        fixed list, and nothing on that list is a document. A file served as
        `text/html` from here would be a page an agent wrote, on the origin
        that holds the token, able to read both.
        """
        session = self.known(session_id)
        if session is None:
            return
        wanted = query.get("path", [""])[0]
        found = read_worktree_bytes(session.cwd, wanted,
                                    held=self.daemon.files)
        if found is None:
            self.reply_json({"error": "not a file this page shows"}, 404)
            return
        raw, kind = found
        # Not the `no-store` every other answer carries. The address holds the
        # file's mtime, so a file the agent has written is a different address
        # -- and without this the browser fetched the whole thing again on
        # every tab switch, which is what the mtime was put there to avoid.
        self.reply(200, raw, kind, cache="private, max-age=300")

    def events(self, session_id: str, query: dict[str, list[str]]) -> None:
        """What this session has done, for the Session tab.

        The log is the daemon's own, folded as the events arrived — not the
        file read again. `events.jsonl` is twenty megabytes at its largest and
        holds every session; walking it per request, for one of them, to draw
        a panel nobody is looking at most of the time is not a trade worth
        making.
        """
        session = self.known(session_id)
        if session is None:
            return
        self.reply_json({"id": session_id, "counts": session.counts,
                         "events": session.log})

    def diff(self, session_id: str, query: dict[str, list[str]]) -> None:
        session = self.known(session_id)
        if session is None:
            return
        self.reply_json(dict(asdict(worktree_diff(session.cwd)), id=session_id))

    def stream(self, watching: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        client = self.daemon.hub.add(watching)
        try:
            first = json.dumps(self.daemon.sessions_payload(), default=str)
            self.wfile.write(f"event: sessions\ndata: {first}\n\n".encode("utf-8"))
            self.wfile.flush()
            while not self.daemon.stopping.is_set():
                try:
                    message = client.queue.get(timeout=15.0)
                except client.empty:
                    message = ": still here\n\n"  # a comment keeps it open
                self.wfile.write(message.encode("utf-8"))
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            self.daemon.hub.drop(client)


# The verbs a session route can end in.
GET_VERBS: dict[str, Any] = {
    "events": Serving.events,
    "transcript": Serving.transcript,
    "files": Serving.files,
    "file": Serving.file,
    "raw": Serving.raw,
    "diff": Serving.diff,
}

# Two of these write to a terminal, and they are the reason every POST carries
# a token. There will never be a third tmux verb without PLAN.md section 4.5
# saying so. `name` is not one: it writes a file of ours and touches no
# terminal, but it arrives the same way and is checked the same way.
POST_VERBS: dict[str, Any] = {
    "jump": Serving.jump,
    "send": Serving.send,
    "interrupt": Serving.interrupt,
    "name": Serving.name,
    "limit": Serving.limit,
}


def make_server(daemon: Daemon, port: int) -> Any:
    """Build the HTTP server. Every route is in `Serving`; what is here is the
    plumbing, and the import that must stay late."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(Serving, BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        # A `Content-Length` announced and never sent used to hold a thread
        # for ever. The event stream writes at least every fifteen seconds,
        # so it is never the one that runs out.
        timeout = 30
        server_version = f"wostuast/{VERSION}"
        daemon = None        # this server's own, set right below

    Handler.daemon = daemon
    server = ThreadingHTTPServer((BIND_HOST, port), Handler)
    server.daemon_threads = True
    return server


