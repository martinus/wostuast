def build_parser() -> argparse.ArgumentParser:
    import argparse

    parser = argparse.ArgumentParser(
        prog="wostuast",
        description="See what your coding agents are doing.",
    )
    parser.add_argument("--version", action="version", version=f"wostuast {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    commands = [
        ("install", cmd_install, "copy to ~/.local/bin and register the hooks"),
        ("uninstall", cmd_uninstall, "remove the hooks; keep the event log"),
        ("hook", cmd_hook, "the hook entry point; reads JSON from stdin"),
        ("status", cmd_status, "the status line entry point; reads JSON from stdin"),
        ("ls", cmd_ls, "list the sessions"),
        ("doctor", cmd_doctor, "check the setup"),
        ("serve", cmd_serve, "start the daemon (milestone 2)"),
    ]
    for name, handler, help_text in commands:
        sub = subparsers.add_parser(name, help=help_text, description=help_text)
        sub.set_defaults(handler=handler)
    return parser


#: The two verbs Claude Code calls itself. They skip argparse, because the hook
#: runs on every tool call and the status line runs on every redraw.
FAST_PATH = {"hook": cmd_hook, "status": cmd_status}


def main(argv: Sequence[str] | None = None) -> int:
    words = list(argv) if argv is not None else sys.argv[1:]
    if len(words) == 1 and words[0] in FAST_PATH:
        return FAST_PATH[words[0]](None)

    parser = build_parser()
    args = parser.parse_args(words)
    handler = getattr(args, "handler", None)
    if handler is None:
        parser.print_help()
        return 0
    return handler(args)


if __name__ == "__main__":
    sys.exit(main())
