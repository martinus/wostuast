   `scrollbar-color` then takes it from the system's idea of dark to this
   page's: the thumb is the same line colour as every other edge here, and
   the track is transparent so it shows whatever it is lying on -- the panel
   in the sidebar, the page in a pane. It is inherited, so this is the only
   place it is said. Both are needed: `scrollbar-color` is the exact hue, and
   `color-scheme` is what a browser that does not take it falls back to, and
   what the form controls read. */
:root { color-scheme: dark; scrollbar-color: var(--edge-bright) transparent; }
:root[data-theme="light"] { color-scheme: light; }

/* Derived from the palette above, so they follow it into either theme and
   cannot be left behind at an old hue. The search hit takes the amber the
   background wants rather than the one a dot wants: white on the light
   theme's --needs is 4.0:1, and --needs-warm is 5.58:1. */
:root {
  --ring-near: color-mix(in srgb, var(--needs) 25%, transparent);
  --ring-far: color-mix(in srgb, var(--needs) 10%, transparent);
  --mark: var(--needs-warm);
  --veil: rgba(0,0,0,.5);
  /* The band over a hunk: git's own blue-grey, the way a pull request does it. */
  --hunk-bg: color-mix(in srgb, var(--done) 12%, transparent);
}
:root[data-theme="light"] {
  --bg: var(--light-bg); --panel: #efeee9; --raised: #e7e6e0; --chosen: #dedcd4;
  --edge: #d8d6cd; --edge-bright: #c3c0b5;
  --ink: var(--light-ink); --ink-bright: #14151a; --ink-soft: #4c4f58;
  --ink-mute: #6a6d76; --ink-faint: #8b8e96;
  --needs: #a86c10; --needs-warm: #8a5709; --working: #2f7f52;
  --done: #2a6ea8; --gone: #8b8e96;
  --needs-soft: rgba(168,108,16,.22); --working-soft: rgba(47,127,82,.14);
  --done-soft: rgba(42,110,168,.13);
  --cut-bg: rgba(178,74,42,.12); --cut-ink: #8c3a1f;
  --add-line: #dcf2e1; --add-word: #a8dcb5;
  --cut-line: #fbe4e1; --cut-word: #f1b4ad;
  /* White, not the code ground: on #eceae3 the unchanged lines stood at a
     contrast of 4.29, under the 4.5 a page's body text needs, and the card
     read as a brown box darker than the page around it. */
  --sheet: #ffffff;
  --mine: #3c5a8c; --mine-soft: rgba(60,90,140,.09);
  --code: #eceae3; --code-ink: #33363d;
  --hot: #b2452a;
  --tint: rgba(0,0,0,.05);
  --shadow: rgba(0,0,0,.18);
  --veil: rgba(0,0,0,.3);
  --folder: #7a4f9c;
  --syn-key: #5b3fb0; --syn-str: #26694a; --syn-num: #1d6f74;
  --syn-com: #8b8e96; --syn-fn: #2a6ea8; --syn-meta: #6a6d76;
  --syn-attr: #7a3f8f;
}
/* Not a colour, so not in the palette above. The width of a drag handle,
   and the one number that says how far the right-hand half of a split tab
   starts from the left: `.grip` is that wide, and the send box and the
   question bar are indented by the column plus this. It was written out
   twice, which is two places to change and one of them to forget. */
:root { --grip-w: 5px; }

* { box-sizing: border-box; }
/* `hidden` hides, whatever else the element sets. A rule that sets
   `display` beats the browser's own rule for the attribute, and twelve
   controls each needed an `X[hidden]` of their own: one forgotten was a
   control that would not go away (the `.sendbar` scar, four times over).
   `test_hidden_is_one_rule` keeps it the only one. */
[hidden] { display: none !important; }
html, body { height: 100%; }
body {
  margin: 0; background: var(--bg); color: var(--ink);
  font-family: var(--sans); font-size: 14px; overflow: hidden;
}
.app { height: 100vh; display: flex; flex-direction: column; }

/* The name and the version, at the top of the session list and as tall as the
   tab row beside it, so the two rules under them are one line. There was a
   bar across the whole page for these and the counts; the reader asked for
   the room back. */
.brand { font-weight: 600; color: var(--needs); letter-spacing: .04em;
  text-decoration: none; }
/* The name is a link to the project (issue 333), in a tab of its own. It reads
   as the name it always was until the pointer is on it. */
.brand:hover { text-decoration: underline; }
.version { color: var(--ink-faint); font-size: 11px; white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis; }
/* Jump and the settings, as icons at the end of the tab row. */
.theme {
  flex-shrink: 0; align-self: center; margin-left: 6px; width: 26px;
  height: 26px; padding: 0; border-radius: 5px; display: inline-flex;
  align-items: center; justify-content: center;
  border: 1px solid var(--edge); background: none; color: var(--ink-mute);
  cursor: pointer;
}
.theme .icon, .setpop .icon, .choice .icon {
  width: 14px; height: 14px; fill: none; stroke: currentColor; flex: none;
  stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round;
}
.theme:hover { color: var(--ink-bright); border-color: var(--ink-faint); }
/* Jump is absent for a session with no pane, not disabled. */
/* Everything about this screen, in this browser, in one menu at the end of
   the tab row: colours, alerts, and how code is drawn. It was a bell, a
   colours button, a menu on the Review bar and two links over every file;
   the reader chose one menu from pictures. The slot is what the menu is
   measured from. */
.setslot { position: relative; margin-left: 6px; display: flex; align-self: center; }
.setslot .theme { margin-left: 0; position: relative; }
/* Alerts off, said on the button: the bell was an icon of its own, and off
   was the one thing it said at a glance. */
.setslot .offmark {
  position: absolute; right: -4px; bottom: -4px; width: 13px; height: 13px;
  border-radius: 50%; background: var(--bg); display: flex;
  align-items: center; justify-content: center;
}
.setslot .offmark .icon { width: 10px; height: 10px; stroke-width: 1.4; color: var(--ink-faint); }
.setpop {
  position: absolute; right: 0; top: calc(100% + 8px); z-index: 30;
  display: grid; grid-template-columns: max-content max-content;
  gap: 10px 16px; padding: 14px 16px;
  /* Each label on the first line of what it names: a button's word, the
     first alert's words. A padding that lined the label up with a button
     left it 5 px under the first checkbox. */
  align-items: baseline;
  background: var(--raised); border: 1px solid var(--edge-bright); border-radius: 8px;
  box-shadow: 0 6px 20px var(--shadow);
  /* The links make it tall; it scrolls rather than run off the screen. */
  max-height: calc(100vh - 70px); overflow-y: auto;
  /* One proportional face for the whole menu, which the reader asked for: a
     url in a fixed-width face made the menu as wide as the longest link. */
  font-family: var(--sans);
}
.setpop .verb { font-family: var(--sans); font-size: 12px; }
.setpop .setlabel {
  display: flex; align-items: baseline; gap: 7px;
  font-size: 12.5px; color: var(--ink-mute);
}
.setpop .setlabel .icon { align-self: center; }
.setpop .rule { align-self: center; grid-column: 1 / -1; border-top: 1px solid var(--edge); margin: 0 -16px; }
/* One control in parts, so it reads as a choice and not as actions. */
.choice { display: flex; }
/* Its words on a line box, not flex: a flex button takes its baseline from
   its first item, the icon, and the label beside it lined up 3 px low. */
.choice .verb {
  display: inline-block; line-height: 20px;
  border-radius: 0; margin-left: -1px;
}
.choice .verb .icon { vertical-align: middle; margin: -2px 6px 0 0; }
.choice .verb:first-child { border-radius: 5px 0 0 5px; margin-left: 0; }
.choice .verb:last-child { border-radius: 0 5px 5px 0; }
.choice .verb[aria-pressed="true"] {
  background: var(--chosen); color: var(--ink-bright); border-color: var(--edge-bright);
}
/* The colours, each in the colours it gives -- and so the same in either
   theme -- with a ring on the one chosen. Auto is both, cut corner to
   corner. */
.setpop .choice.colours { gap: 6px; }
.setpop .choice.colours .verb {
  height: 30px; line-height: 28px; padding: 0 12px; margin-left: 0; border-radius: 6px;
  border-color: var(--edge-bright);
}
/* As specific as the pressed look above, and later, so they win it. */
.setpop .choice.colours [data-value="light"] {
  background: var(--light-bg); color: var(--light-ink);
}
.setpop .choice.colours [data-value="dark"] {
  background: var(--dark-bg); color: var(--dark-ink);
}
.setpop .choice.colours [data-value="system"] {
  background: linear-gradient(135deg, var(--light-bg) 0 50%, var(--dark-bg) 50% 100%);
  color: var(--light-ink);
}
.setpop .choice.colours [data-value="system"] span {
  background: var(--light-bg); padding: 0 3px; border-radius: 3px;
}
.setpop .choice.colours .verb[aria-pressed="true"] {
  outline: 2px solid var(--needs); outline-offset: 1px;
}
.setpop .checks {
  display: flex; flex-direction: column; gap: 5px;
  font-family: var(--sans); font-size: 13px; color: var(--ink);
}
/* A line box too, for the baseline, as the buttons above. */
.setpop .checks label { cursor: pointer; }
.setpop .checks label > :is(input, .icon) { vertical-align: middle; margin: -2px 7px 0 0; }
.setpop .checks input { cursor: pointer; accent-color: var(--needs); }
.setpop .checks .needs .icon { color: var(--needs); }
.setpop .checks .done .icon { color: var(--working); }
.setpop .alertnote {
  font-family: var(--sans); font-size: 12px; color: var(--ink-faint);
  max-width: 30ch; line-height: 1.4;
}
/* The ticket links: a box a link, as wide as the column and never wider. A
   long url scrolls inside its own input, so the menu keeps its width. */
.setpop .linkedit { display: flex; flex-direction: column; gap: 8px; width: 330px; }
.setpop .linklist { display: flex; flex-direction: column; gap: 8px; }
.setpop .linklist:empty { display: none; }
.setpop .linkrow {
  display: grid; grid-template-columns: max-content minmax(0, 1fr) 22px;
  gap: 4px 8px; align-items: baseline; padding: 8px;
  border: 1px solid var(--edge); border-radius: 6px; background: var(--panel);
}
.setpop .linkword { font-size: 11.5px; color: var(--ink-faint); }
.setpop .linkrow input {
  font-family: var(--sans); font-size: 12.5px; color: var(--ink);
  background: var(--bg); border: 1px solid var(--edge); border-radius: 4px;
  padding: 3px 6px; min-width: 0; width: 100%; box-sizing: border-box;
}
.setpop .linkrow input:focus { outline: none; border-color: var(--needs); }
.setpop .linkrow[data-bad="match"] .linkmatch,
.setpop .linkrow[data-bad="url"] .linkurl { border-color: var(--hot); }
.setpop .linkdrop {
  grid-column: 3; grid-row: 1; align-self: center; padding: 0; border: none;
  background: none; color: var(--ink-faint); font-size: 15px; cursor: pointer;
}
.setpop .linkdrop:hover { color: var(--hot); }
.setpop .linksays {
  grid-column: 2 / 4; font-size: 11.5px; color: var(--ink-faint);
  line-height: 1.4; overflow-wrap: anywhere;
}
.setpop .linksays:empty { display: none; }
.setpop .linkrow:is([data-bad="match"], [data-bad="url"]) .linksays { color: var(--hot); }
.setpop .linksays a { color: var(--done); }
.setpop .linkadd { align-self: flex-start; border-style: dashed; }
/* Where all of it is kept, across both columns, so a person can open it. */
.setpop .where {
  grid-column: 1 / -1; display: flex; align-items: center; gap: 6px;
  font-size: 11.5px; color: var(--ink-faint); max-width: 470px;
}
.setpop .where .wherepath { color: var(--ink-soft); overflow-wrap: anywhere; }
.setpop .wherecopy {
  display: inline-flex; padding: 2px; border: none; background: none;
  color: var(--ink-faint); cursor: pointer;
}
.setpop .wherecopy:hover { color: var(--needs); }

/* body */
/* What the chosen row meets beside the list: the column every tab has (the
   map, a file tree, the comments). Its fade and the grip's opening end in
   this, so the row flows into what is there. */
.body { flex-grow: 1; display: flex; min-height: 0; --meet: var(--panel); }
/* The list wears the grip's colour, so the grip reads as the list's own
   edge and only the chosen row crosses it. */
.sidebar {
  width: var(--sidebar-w, 340px); flex-shrink: 0; display: flex;
  flex-direction: column; background: var(--edge);
}
/* Paths are long and no width chosen here is right for every repository, so
   both column edges are draggable. The alternative is a config option, which
   goal 4 in CLAUDE.md rules out. */
.grip {
  flex-shrink: 0; width: var(--grip-w); cursor: col-resize;
  background: var(--edge);
  border: 0; padding: 0; transition: background .15s ease;
}
/* Open where the chosen row meets it; `openGrip` says where that is. */
#grip {
  background: linear-gradient(var(--edge) var(--gap-top, 0px),
    var(--meet) var(--gap-top, 0px), var(--meet) var(--gap-bottom, 0px),
    var(--edge) var(--gap-bottom, 0px));
}
/* Where the chosen row meets the content, its outline turns into the
   content's edge with a round corner, and runs on down that edge (issue
   407): it stopped square at the end of the list, and the reader saw two
   lines that ended for no reason. A corner a quarter circle of `--flare`
   round, its middle 3 px into the list, so it starts on the row's own
   line and ends upright on the content's edge; the 6 px between two rows
   leave no room for a larger one. The ground inside the curve is the
   content's, so the row widens into it as a tab into its page. Each is a
   layer of the grip's own background: the list scrolls, and clips
   anything a row draws out of it. `openGrip` sets the row's hue
   (`--gap-hue`, issue 416) and which corners show: none where the list
   cuts the row off. */
#grip.open {
  /* The chosen row's own line, mixed as `.row.chosen` mixes it. */
  --gap-line: color-mix(in srgb, var(--gap-hue) 55%, transparent);
  --flare: 8px; --mid: calc(var(--grip-w) - var(--flare));
  --corner: var(--edge) calc(var(--flare) - 1.3px), var(--gap-line) calc(var(--flare) - 1px),
    var(--gap-line) calc(var(--flare) - .2px), var(--meet) var(--flare);
  --flare-top: none; --flare-bottom: none;
  --line-top: var(--gap-top); --line-bottom: var(--gap-bottom);
  background: var(--flare-top), var(--flare-bottom),
    linear-gradient(var(--gap-line) var(--line-top), transparent var(--line-top),
      transparent var(--line-bottom), var(--gap-line) var(--line-bottom)),
    linear-gradient(var(--edge) var(--gap-top),
      var(--meet) var(--gap-top), var(--meet) var(--gap-bottom),
      var(--edge) var(--gap-bottom));
  background-position: 0 calc(var(--gap-top) - var(--flare) + 1px),
    0 calc(var(--gap-bottom) - 1px), 100% 0, 0 0;
  background-size: 100% var(--flare), 100% var(--flare), 1px 100%, 100% 100%;
  background-repeat: no-repeat;
}
#grip.open.flaretop {
  --flare-top: radial-gradient(circle var(--flare) at var(--mid) 0, var(--corner));
  --line-top: calc(var(--gap-top) - var(--flare) + 1px);
}
#grip.open.flarebottom {
  --flare-bottom: radial-gradient(circle var(--flare) at var(--mid) 100%, var(--corner));
  --line-bottom: calc(var(--gap-bottom) + var(--flare) - 1px);
}
.grip:hover, .grip.dragging, #grip:hover, #grip.dragging { background: var(--needs); }
body.dragging { cursor: col-resize; user-select: none; }
.sidebar-head {
  height: 40px; flex-shrink: 0; display: flex; align-items: baseline;
  gap: 10px; padding: 12px 16px 0; margin-bottom: 8px;
  border-bottom: 1px solid var(--edge); font-family: var(--mono); font-size: 13px;
}
.rows { flex-grow: 1; overflow-y: auto; padding: 0 8px 8px; scrollbar-width: none; }
/* The bar only while the pointer is over the list. It stands between the
   chosen row and the content it belongs to, and cut the one from the other;
   the wheel and `j` `k` scroll the list without it. */
.rows:hover { scrollbar-width: thin; }
/* Every row runs through the list's padding to the line beside it, like a
   tab behind the one in front: as cards with four round corners they read
   as buttons. The padding gives the 8 px back, so the text keeps its place. */
.row {
  margin: 0 -8px 6px 4px; padding: 9px 20px 9px 11px;
  border-radius: 6px 0 0 6px;
  cursor: pointer; display: flex; flex-direction: column; gap: 4px;
  border: 1px solid transparent; border-left: 4px solid var(--gone);
  border-right: 0; --hue: var(--gone);
  transition: background .2s ease, border-color .2s ease;
}
.row.needs_you { --soft: var(--needs-soft); --hue: var(--needs); border-left-color: var(--needs); background: var(--needs-soft); }
.row.working { --soft: var(--working-soft); --hue: var(--working); border-left-color: var(--working); background: var(--working-soft); }
.row.done { --soft: var(--done-soft); --hue: var(--done); border-left-color: var(--done); background: var(--done-soft); }
.row:hover { border-color: var(--edge-bright); border-left-width: 4px; }
/* The chosen row is a tab of the content beside it, as in a browser: it
   runs through the list's padding to the line between the two, that line
   opens where they meet (`openGrip`), and its ground goes from the state's
   colour on the left to the content's own on the right, so the one flows
   into the other. A faint ring said which row was chosen before this, and a
   reader had to look for it. Its outline is the other rows' own: lines of
   2 px in the list's colour could not be seen on a list of that colour, and
   where they met the state's edge on the left they cut its corner. It
   stands in from the other rows by the grip's width, as it crosses the grip
   on the right, so its left edge is not one more in the column of theirs.
   Its fade ends in `--meet`.
   It is the strongest row in the list (issue 396): its state's colour at a
   third over `--meet`, held for half its width before the fade, a line
   round it in that colour and a wider edge. It faded from its tint into
   grey before, so it was the one row with less colour than the others, and
   the eye went to every row but the chosen one. A shadow could not say it:
   on the dark ground it did not show, and a shadow lifts a tab off what it
   belongs to. The colour is mixed into `--meet`, which is opaque, so it is
   the same on any ground under it. The edge is 2 px wider and the padding
   2 px narrower, so the text keeps its place. */
.row.chosen, .row.chosen:hover {
  background: linear-gradient(90deg,
    color-mix(in srgb, var(--hue) 34%, var(--meet)) 55%, var(--meet));
  border-color: color-mix(in srgb, var(--hue) 55%, transparent);
  border-left: 6px solid var(--hue); padding-left: 9px;
  margin-left: calc(4px + var(--grip-w));
}
.row .line1 {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 13px; min-width: 0;
}
/* The name in the face the lines under it wear. The fixed face made it
   half as wide again, and a name is read, not lined up; the age beside it
   keeps the fixed face, so its digits do not dance. */
.row .name {
  font-family: var(--sans); font-size: 14px;
  color: var(--ink); font-weight: 500; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; flex-grow: 1;
}
/* Bold and bright only where there is something to read (issue 390): a
   turn not read, a session that needs you, and the chosen one. Every name
   was bold, and the unread dot alone had to tell the rows apart. */
.row.unread .name, .row.needs_you:not(.snoozed) .name, .row.reminded .name,
.row.chosen .name { color: var(--ink-bright); font-weight: 600; }
/* Only a finished session carries a word; the colour says the rest. */
.row .word { flex-shrink: 0; color: var(--ink-faint); }
.row .word:empty { display: none; }
/* Unread (issue 373): a turn ended since the reader last had it on screen.
   A dot before the name, in the colour of a turn that is done, and the
   name bold (issue 390): the dot is what is seen from across a room. */
.row.unread .name::before {
  content: ""; display: inline-block; width: 8px; height: 8px;
  border-radius: 50%; background: var(--done); margin-right: 7px;
  vertical-align: 2px;
}
/* What a row offers on its hover (issue 389): small icons in the age's
   place -- "not now", "later" and "unread" -- so nothing pushes the name.
   As words they cut the name short, and "not now" broke over two lines at
   a narrow width. Not there at all until the hover: invisible, they still
   took their room. Taller than the line, so a margin gives the room back
   and the row does not grow on the hover. */
.row .line1 .act {
  display: inline-grid; place-items: center; width: 22px; height: 22px;
  margin: -3px 0; padding: 0; border: none; border-radius: 5px;
  background: none; color: var(--ink-soft); cursor: pointer; flex-shrink: 0;
}
.row .line1 .act .icon { width: 14px; height: 14px; color: inherit; stroke-width: 1.4; }
.row .line1 .act:hover { background: var(--chosen); color: var(--ink-bright); }
.row:not(:hover):not(:focus-within) .line1 .act { display: none; }
.row:is(:hover, :focus-within) .line1 .age.swap { display: none; }
/* "Unread" is the dot it leaves. */
.row .line1 .markunread .icon path { fill: var(--done); stroke: none; }
/* A reminder still to come shows a clock and its time in the age's place
   (issue 394): "at 09:55" alone did not say it was a reminder. One that
   has come says "reminder" as a pill, in the amber of a session that
   needs you. */
.row .line1 .age.when { display: inline-flex; align-items: center; gap: 4px; color: var(--needs); }
.row .line1 .age.when .icon { color: inherit; }
.row .line1 .word.pill {
  padding: 0 7px; border-radius: 9px; line-height: 18px; font-size: 12px;
  background: color-mix(in srgb, var(--needs) 22%, transparent); color: var(--needs-warm);
}
.row .line2 .repo, .row .line2 .worktree, .row .line2 .branch {
  display: inline-flex; align-items: center; gap: 4px; min-width: 0;
}
/* Repository and worktree share their line, and either gives way. */
.row .line2.where { gap: 14px; color: var(--ink-mute); }
.row .line2 .text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.row .icon {
  width: 12px; height: 12px; flex-shrink: 0; color: var(--ink-faint);
  fill: none; stroke: currentColor; stroke-width: 1.2;
  stroke-linejoin: round; stroke-linecap: round;
}
.row input.rowname {
  width: 100%; min-width: 0; padding: 0 4px; margin: -1px 0;
  font: inherit; color: var(--ink-bright); background: var(--raised);
  border: 1px solid var(--edge-bright); border-radius: 3px; outline: none;
}
/* History. A finished session is grey through and through: it kept the colour
   of the state it stopped in, which read as though something were still going
   on there. */
/* Not the chosen one (issue 427): see-through, its fade into the content
   ended on a grey mix of the list's ground, and its edge stood out where it
   meets the content, as no other chosen row's does. Chosen, it is a row
   like the others, in the grey of its state. */
.row.ended:not(.chosen), .row.dead:not(.chosen) { opacity: .72; }
.row.ended:not(.chosen) .name, .row.dead:not(.chosen) .name {
  color: var(--ink-mute); font-weight: 500;
}
.row.ended .branch, .row.dead .branch,
.row.ended .said, .row.dead .said { color: var(--ink-faint); }
.row.ended .dirty, .row.dead .dirty,
.row.ended .clean, .row.dead .clean { color: var(--gone); }
/* The line above each group of rows. The history one folds and so is a
   button; the other three only name what is under them. */
.histhead, .band {
  display: block; width: 100%; margin: 10px 0 6px; padding: 5px 12px;
  border: none; border-top: 1px solid var(--edge); border-radius: 0;
  background: none; text-align: left;
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  letter-spacing: .06em; text-transform: uppercase;
}
.histhead { cursor: pointer; }
.histhead:hover { color: var(--ink-soft); }
/* The one group that is about you says so in its own colour. */
.band.needs { color: var(--needs); }
/* The first head has nothing above it to be separated from. */
.rows > :first-child.band, .rows > :first-child.histhead { border-top: none; margin-top: 0; }
/* One line, whatever the branch is called: `nowrap` is what holds it. The
   branch is the one part that gives way, with an ellipsis, because only it
   has `min-width: 0` and a clip -- "✓ clean" used to shrink with it and
   break over two lines, under a branch cut short anyway. */
.row .line2 {
  display: flex; gap: 10px; font-size: 12px; color: var(--ink-soft);
  min-width: 0; white-space: nowrap;
}
/* A session outside a repository has no branch, and its line goes. */
.row .line2 .gitstate { display: flex; gap: 10px; margin-left: auto; }
/* What the agent is doing or asks, cut short with an ellipsis. The age is on
   the name's line, where the name gives way to it and it never does. */
.row .line3 {
  display: flex; gap: 6px; font-size: 12px; color: var(--ink-mute);
  min-width: 0; white-space: nowrap;
}
.row .said { overflow: hidden; text-overflow: ellipsis; min-width: 0; }
.row .age { color: var(--ink-faint); flex-shrink: 0; margin-left: auto; font-size: 12px; }
/* What the session started (issue 422): a line for each child that runs,
   under the row's own lines and in their size, then "3 subagents ran". The
   arrow is the working colour while it runs. One line each, cut short: a
   description can run to a paragraph. */
.row .kids { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.row .kid {
  display: flex; gap: 6px; font-size: 12px; color: var(--ink-mute);
  min-width: 0; white-space: nowrap;
}
.row .kid .kidmark { color: var(--ink-faint); flex-shrink: 0; }
.row .kid.running .kidmark { color: var(--working); }
.row .kid .kidwhat { color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; min-width: 0; flex-shrink: 1; }
.row .kid .kiddoing { overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 1 1 0; }
.row .kid.opens:hover .kidwhat { color: var(--ink); text-decoration: underline; }
.row .kid.chosen .kidwhat { color: var(--ink); font-weight: 600; }
.row .kidsran { margin-top: 0; align-self: flex-start; }
.dirty { color: var(--needs); }
/* What git has started and not finished, and its conflicts: the amber of
   waiting, in the narrow face's weight, so it is read before the counts. */
.row .gitstate .doing, .row .gitstate .conflict { color: var(--needs); font-weight: 600; }
/* A snoozed row (issue 355) stands with the ready ones, in their colour: it waits,
   but the reader said not now. Its control is a moon on the hover of a row
   that needs you, and a sun on a snoozed one. */
.clean { color: var(--working); }
.ahead { color: var(--ink-faint); }
/* The row has no dot: its edge and its tint say the state, and the group it
   stands in. The one thing the dot did that nothing else does is pulse for
   the session that needs you, the thing to see from across a room, so the
   row itself does that now. */
.row.needs_you { box-shadow: 0 0 0 3px var(--ring-near); animation: ring 2s ease-in-out infinite; }
@keyframes ring {
  0%, 100% { box-shadow: 0 0 0 3px var(--ring-near); }
  50% { box-shadow: 0 0 0 5px var(--ring-far); }
}
/* After the pulse, and as specific as the rule it undoes: a snoozed row is
   still `needs_you`, and with `.row.snoozed` alone it kept the amber ground
   and the pulse it had been put aside to lose. */
.row.needs_you.snoozed {
  --soft: var(--done-soft); --hue: var(--done); border-left-color: var(--done);
  background: var(--done-soft); box-shadow: none; animation: none;
}
/* A reminder that has come (issue 375): the amber of a session that needs
   you, on whatever state the session is in. */
.row.reminded {
  --soft: var(--needs-soft); --hue: var(--needs); border-left-color: var(--needs);
  background: var(--needs-soft);
}
/* "Later"'s choices (issue 394): a small menu under the row's first line,
   over the rows below rather than pushing them, in whole words. Four grey
   abbreviations in a line of their own were missed. */
.row { position: relative; }
.row .remindmenu {
  position: absolute; right: 12px; top: 30px; z-index: 5;
  display: flex; flex-direction: column; min-width: 150px; padding: 4px;
  background: var(--raised); border: 1px solid var(--edge-bright);
  border-radius: 8px; box-shadow: 0 8px 24px var(--shadow); cursor: default;
}
.row .remindmenu .menuhead { padding: 4px 10px 6px; font-size: 11px; color: var(--ink-faint); }
.row .remindmenu button {
  display: block; margin: 0; padding: 6px 10px; border: none; border-radius: 5px;
  background: none; text-align: left; font-family: var(--sans); font-size: 13px;
  line-height: 1.3; color: var(--ink); cursor: pointer;
}
.row .remindmenu button:hover { background: var(--chosen); color: var(--ink-bright); }
/* "Custom..." (issue 406): a day and a time, as Slack asks for them, and a
   button that says when. */
.row .remindmenu.custom { min-width: 210px; }
.row .remindmenu input, .row .remindmenu select {
  margin: 2px 6px 4px; padding: 5px 8px; border-radius: 5px;
  border: 1px solid var(--edge-bright); background: var(--bg); color: var(--ink);
  font-family: var(--sans); font-size: 13px;
}
.row .remindmenu input:focus, .row .remindmenu select:focus {
  outline: none; border-color: var(--needs);
}
.row .remindmenu .remindtime { font-family: var(--mono); }
.row .remindmenu .remindwhy { padding: 2px 10px; font-size: 12px; color: var(--needs); }
.row .remindmenu .remindwhy:empty { display: none; }
.row .remindmenu button.remindset {
  margin: 6px 6px 2px; text-align: center; background: var(--chosen);
  color: var(--ink-bright);
}
.row .remindmenu button.remindset:hover { color: var(--needs); }

/* The three views over the groups -- unread (issue 376), saved (377) and
   search (379) -- in one row of equal buttons (issue 391), each always
   there, so the list does not move when a count comes to nought. Three
   lines in three styles took a hundred pixels, and "search every session"
   read as a second filter box. Words in the reading face, the counts in
   the fixed one. Four since Commands became a view (issue 411), and always
   in one row, which the reader asked for over two rows of two. The four
   share the row equally (`flex: 1 1 0`), and what they hold gives way as the list
   narrows (`fitViews`): first the icons go, then the words, which stay in
   the button's title. Cut with an ellipsis, a word in a list 340 px wide
   was its first letter. */
/* It never gives way to a long list (issue 423): it clips what overflows
   it, and such a flex item may shrink below its content, so the column
   took the list's overflow out of it and cut its words in half. */
.views { display: flex; gap: 4px; margin: 0 6px 10px; overflow: hidden; flex-shrink: 0; }
.views.bare .feedlink .icon, .views.icons .feedlink .viewname { display: none; }
.feedlink {
  flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center;
  gap: 5px; padding: 5px 4px; border: none; border-radius: 6px;
  background: none; color: var(--ink-soft); cursor: pointer;
  font-family: var(--sans); font-size: 12.5px; white-space: nowrap;
}
.feedlink:hover { background: var(--raised); color: var(--ink-bright); }
.feedlink.open { background: var(--chosen); color: var(--ink-bright); }
.feedlink .icon {
  width: 13px; height: 13px; flex-shrink: 0; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
}
.feedlink .n {
  font-family: var(--mono); font-size: 10.5px; line-height: 16px; padding: 0 5px;
  border-radius: 8px; color: var(--done);
  background: color-mix(in srgb, var(--done) 22%, transparent);
}
.feedlink .n.none { background: none; color: var(--ink-faint); }
/* A view stands in the tab row (issue 392): its name where the tabs were,
   and none of the chosen session's model, context, spend or jump, which
   are not the view's. The live slot stays: what the page says about a
   press in the view is said there. */
body.infeed .tabs .tab, body.infeed #asking, body.infeed #sendbar,
body.infeed #resumebar, body.infeed .findhome, body.infeed #ctxslot,
body.infeed #modelpop, body.infeed #jump { display: none; }
.viewtitle { display: none; }
body.infeed .viewtitle {
  display: inline-flex; align-items: baseline; gap: 12px; align-self: center;
  padding: 0 16px; white-space: nowrap; font-family: var(--sans);
  font-size: 14px; font-weight: 600; color: var(--ink-bright);
}
.viewtitle .link {
  font-family: var(--mono); font-size: 11px; font-weight: 400; color: var(--ink-faint);
}
.content.feed { overflow: auto; padding: 16px 28px; }
/* An entry is a card that reads like its session's row (issue 393): its
   edge in the state's colour, and where it stands under its name, so the
   eye goes from the card to the row. A press on it opens it, as "open"
   does; what can be done to it shows on its hover, and is not there at
   all until then. */
.feedentry {
  --hue: var(--done); margin: 0 0 12px; padding: 12px 16px 6px;
  background: var(--panel); border: 1px solid var(--edge);
  border-left: 3px solid var(--hue); border-radius: 8px; cursor: pointer;
  min-width: 0; overflow-wrap: anywhere;
}
/* The cards as Google Keep lays out its notes (issue 404): as many columns
   as fit, and each card under the shortest one (`layoutCards`), so the
   newest stand along the top. One column of 90ch at the left left most of
   a wide screen empty. A path with no space in it ran out of the card:
   `overflow-wrap` breaks it, and a code block scrolls in its own box. */
.board { position: relative; }
.board > .feedentry { position: absolute; margin: 0; box-sizing: border-box; }
.feedentry:hover { border-color: var(--edge-bright); border-left-color: var(--hue); }
.feedentry.needs { --hue: var(--needs); }
.feedentry.working { --hue: var(--working); }
.feedentry.gone { --hue: var(--gone); }
.feedentry:not(:hover):not(:focus-within) .feedtop .link { display: none; }
.feedwhere {
  margin: 0 0 6px; font-family: var(--mono); font-size: 11.5px; color: var(--ink-faint);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.feedtop { display: flex; align-items: baseline; gap: 12px; margin-bottom: 2px; }
/* No margin on its links (issue 405): a `.link` carries one on top, and in
   a line aligned on the baseline it made the line 3 px taller on hover, so
   the card grew and every card under it moved down. */
.feedtop .link { margin-top: 0; }
.feedname { font-weight: 600; color: var(--ink-bright); }
.feedwhen { font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  flex-grow: 1; }
.feedwait, .feedmore { color: var(--ink-faint); font-size: 13px; }
/* Search (issue 379): the box at the top, a word for who said it. */
/* As specific as `.find`, which set the width of every find box. */
.content.feed .searchbox { width: 100%; max-width: 90ch; margin: 4px 0 14px; }
.feedwho { font-family: var(--mono); font-size: 11px; color: var(--ink-soft); }
/* Who said it, in the colours the transcript gives the two names. */
.feedwho.mine { color: var(--mine); font-weight: 600; }
.feedwho.claude { color: var(--needs); }
.feedwho.aside { color: var(--ink-faint); }
.feedentry .bubble.mine, .feedentry .bubble.aside { margin: 4px 0 8px; }
.searchtext { margin: 2px 0; color: var(--ink); line-height: 1.55; }
/* A hit, softer than the find box's (issue 395): in its solid colour, a
   page of results was a page of blocks, and the word in one was hard to
   read. */
.searchtext mark {
  background: color-mix(in srgb, var(--needs) 30%, transparent);
  color: var(--ink-bright);
}

/* One switch for everything that moves. A reader whose system asks for less
   motion gets a page that only changes colour. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }
}

/* main */
/* A grid, so that a split tab's map and its grip can run down beside the
   question bar and the send box, which stand under the transcript alone.
   The columns are the split tab's own: the map, the grip, the rest. A tab
   that is not split spans all three, and the tab bar always does.
   `.content` spans every row under the tabs and the two bars take the
   right-hand column of the last two, over it. A split tab hands those rows
   and columns to its own children with `subgrid` (see `.content.split`), so
   the transcript ends where the question bar starts and the map does not.
   The two bars are hidden on every other tab, and a row nothing is in is
   nought tall. */
.main {
  flex-grow: 1; min-width: 0; display: grid;
  grid-template-columns: var(--side-w, 268px) var(--grip-w) minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr) auto auto;
}
.main > .tabs, .main > .content { grid-column: 1 / -1; }
.main > .content { grid-row: 2 / -1; }
/* `relative` so they paint over the box they stand on. `.content.split` is
   positioned, for its "latest" button, and a positioned box paints over
   every sibling that is not -- so every click on an answer or into the
   send box went to the box under it. */
.main > .asking { grid-row: 3; grid-column: 3; position: relative; }
.main > .sendbar { grid-row: 4; grid-column: 3; position: relative; }
/* The page's one button shape. A full-strength `.verb` reaches the terminal —
   jump, send, submit a review — and there are only a few of those. `.quiet` is
   the same button a size down, for what only changes what is on screen: edit a
   comment, throw one away. Those were `.link`, which is text you have to find
   out is clickable. */
.verb {
  flex-shrink: 0; height: 26px; padding: 0 12px; border-radius: 5px;
  border: 1px solid var(--edge-bright); background: var(--raised);
  color: var(--ink-bright); font-family: var(--mono); font-size: 12px;
  cursor: pointer;
}
.verb:hover { border-color: var(--needs); color: var(--needs); }
.verb:active { background: var(--chosen); }
.verb.quiet {
  height: 22px; padding: 0 10px; font-size: 11px;
  background: none; border-color: var(--edge); color: var(--ink-mute);
}
/* Both of these stand under the transcript, and the transcript is the right
   half of a split tab -- so they start where it starts rather than running
   the whole width and under the map beside it. `.main`'s grid puts them in
   its third column, which is the transcript's, and the map and its grip run
   down beside them. They are shown on the Transcript tab and nowhere else.

   By the grid and not by moving them into the pane: the question bar holds
   picks that have not been submitted and the send box holds what you are
   typing, and a node that changes parents is a node that is rebuilt. They
   were indented by a margin before, which put them in the right place and
   left the grip stopping short above them. */
.sendbar {
  flex-shrink: 0; display: flex; gap: 8px; align-items: flex-end;
  padding: 10px 24px; border-top: 1px solid var(--edge); background: var(--panel);
}
/* The line that brings back a session that is over (issue 352), where the send
   box stands for one that is not: the words, then the command whole, in the
   face it is typed in, so it can be read before it is copied. */
.resumebar { align-items: center; }
.resumewords { flex: 1; min-width: 0; }
.resumesays { color: var(--ink-mute); font-size: 12.5px; margin-bottom: 4px; }
.resumeline {
  display: block; font-family: var(--mono); font-size: 12.5px;
  color: var(--ink-bright); overflow-x: auto; white-space: pre;
}
/* The commands a `/` can complete, over the transcript and above the box,
   where the eye already is. As wide as the box, so a description has room;
   it scrolls past a screenful rather than run under the tabs. */
.slash {
  position: absolute; left: 24px; right: 24px; bottom: calc(100% - 4px);
  z-index: 6; max-height: 40vh; overflow-y: auto; padding: 4px 0;
  background: var(--panel); border: 1px solid var(--edge);
  border-radius: 6px; box-shadow: 0 -10px 24px var(--shadow);
}
.slash button {
  display: flex; align-items: baseline; gap: 10px; width: 100%;
  padding: 5px 12px; background: none; border: 0; color: var(--ink-mute);
  font: inherit; font-size: 12.5px; text-align: left; cursor: pointer;
}
.slash button:hover, .slash button.chosen {
  background: var(--raised); color: var(--ink-bright);
}
.slash .name { font-family: var(--mono); color: var(--ink-bright); flex-shrink: 0; }
.slash .lit { color: var(--needs-warm); font-weight: 600; }
.slash .hint { font-family: var(--mono); color: var(--ink-faint); flex-shrink: 0; }
/* The description gives way first: the name is what is being chosen. */
.slash .about { flex: 1 1 auto; min-width: 0; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; color: var(--ink-soft); }
.slash .came { flex-shrink: 0; margin-left: auto; color: var(--ink-faint);
  font-size: 11.5px; }
.say {
  flex-grow: 1; padding: 6px 10px; border-radius: 5px;
  border: 1px solid var(--edge); background: var(--bg); color: var(--ink);
  font-family: var(--mono); font-size: 13px; line-height: 1.5; min-width: 0;
  /* It grows with what is typed, up to a point, and then it scrolls. A long
     line wraps rather than running off the side, because a prompt you cannot
     see the start of is worse than two lines. */
  resize: none; overflow-y: auto; max-height: 40vh; white-space: pre-wrap;
  word-wrap: break-word;
}
.say:focus { outline: none; border-color: var(--needs); }
/* The button beside a box is as tall as the box's first line, so the two
   stand level: it was 26 px beside a box of 32, bottoms aligned, and the
   tops read as a mistake. The box grows upward as lines are typed, and the
   button stays on its last line. One line is 18 + 12 of padding + 2 of
   border: 32, whether `fitSay` sized the box or it took its own height --
   the reason for a No does, and at `line-height: 1.5` it stood 1.5 px
   taller than its button. */
.say { line-height: 18px; min-height: 32px; }
.say + .verb { height: 32px; }
/* The send button, and over it the size of what is in the box (`sizeSay`),
   in the room a tall box leaves there. One column, so it widens to fit
   "2,400 lines" on one row: laid over the bar, a size wider than the button
   ran over the edge of the box, and broken into rows it read badly. */
.sendside { display: flex; flex-direction: column; align-items: flex-end;
  gap: 6px; flex-shrink: 0; }
.sendside > .verb { height: 32px; }
.saysize {
  display: flex; flex-direction: column; align-items: flex-end;
  font-family: var(--sans); font-size: 12px; line-height: 15px;
  color: var(--ink-faint); white-space: nowrap;
}
.say::placeholder { color: var(--ink-faint); }

.ctx { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
.ctx .bar {
  width: 54px; height: 6px; border-radius: 3px; background: var(--raised);
  border: 1px solid var(--edge); overflow: hidden;
}
.ctx .fill { display: block; height: 100%; background: var(--working); }
.ctx.warm .fill { background: var(--needs); }
.ctx.hot .fill { background: var(--hot); }
/* A query container (issue 397): how much room the tab row has depends on
   the sidebar's width as well as the window's, so the row asks itself. */
.tabs {
  height: 40px; flex-shrink: 0; display: flex; align-items: stretch; gap: 4px;
  padding: 0 24px; border-bottom: 1px solid var(--edge);
  font-family: var(--mono); font-size: 13px; container-type: inline-size;
}
/* A name on one line (issue 397): at 1024 px "1 Transcript" broke over two,
   and the row looked broken. */
.tab {
  display: inline-flex; align-items: center; gap: 6px; padding: 0 12px;
  color: var(--ink-mute); border-bottom: 2px solid transparent;
  background: none; border-top: 0; border-left: 0; border-right: 0;
  font: inherit; cursor: pointer; white-space: nowrap;
}
.tab .tabkey { color: var(--ink-faint); }
/* Short of room, the key's number goes first: the key still works, and the
   tab's title still names it. The tabs have no icons to fall back on, and
   the names alone fit the row of a window 1024 px wide. */
@container (max-width: 760px) {
  .tab .tabkey { display: none; }
  .tab { padding: 0 9px; }
}
/* Shorter still, the context bar and the spend step aside, so the names
   stay on one line and the buttons at the end stay on screen; the model
   stays, because it is a button. */
@container (max-width: 560px) {
  .ctxslot .ctx, .ctxslot .spent { display: none; }
}
.tab[aria-selected="true"] { color: var(--ink-bright); border-bottom-color: var(--needs); }
.tab:disabled { color: var(--edge-bright); cursor: default; }
/* What holds the find box, the context bar and the live slot at the far end
   of the tab row. It used to be a `margin-left: auto` on the find box, and
   then a second rule to hand that `auto` to the live slot when the box was
   hidden -- which broke the moment anything was put between the two. A
   spacer belongs to none of them, so any of them can come and go. */
.tabfill { flex-grow: 1; }
.findhome { display: flex; align-items: center; }
.find {
  width: 240px; height: 26px; padding: 0 10px; border-radius: 5px;
  border: 1px solid var(--edge); background: var(--raised); color: var(--ink);
  font-family: var(--mono); font-size: 12px;
}
.find:focus { outline: none; border-color: var(--needs); }
.find::placeholder { color: var(--ink-faint); }
/* How full the chosen session's context window is, at the end of the tab row
   where it is in view on every tab. */
.ctxslot { margin-left: 12px; display: inline-flex; align-items: center;
  gap: 10px; }
/* An estimate, so it does not wear a state colour: the four this page spends
   are about what an agent is doing, and this is about what it has cost. */
.spent { color: var(--ink-mute); font-size: 12px; white-space: nowrap;
  cursor: help; }
/* The model and its effort, a button that opens `#modelpop` (issues 337
   and 338). It reads as the words it always was until the pointer is on it. */
.ctxslot .model { color: var(--ink-mute); font-size: 12px; white-space: nowrap;
  padding: 2px 4px; margin: 0 -4px; border: 0; border-radius: 4px;
  background: none; font-family: inherit; cursor: pointer; }
.ctxslot .model:hover, .ctxslot .model[aria-expanded="true"] {
  color: var(--ink-bright); background: var(--raised); }
.ctxslot .model .effort { color: var(--ink-faint); }
.modelpop {
  position: fixed; z-index: 30; display: grid;
  grid-template-columns: max-content max-content; gap: 10px 14px;
  align-items: baseline; padding: 14px 16px; font-family: var(--sans);
  background: var(--raised); border: 1px solid var(--edge-bright);
  border-radius: 8px; box-shadow: 0 6px 20px var(--shadow);
}
.modelpop .setlabel { color: var(--ink-mute); font-size: 12px; }
.modelpop .choice .verb { font-family: inherit; }
/* The models used are full ids, and there may be several: they wrap. */
.modelpop .choice.usedmodels { display: flex; flex-wrap: wrap; max-width: 420px; }
.modelpop .modelnote { grid-column: 1 / -1; margin: 2px 0 0; max-width: 360px;
  color: var(--ink-faint); font-size: 12px; line-height: 1.45; }
.live { margin-left: 12px; display: inline-flex; align-items: center;
  color: var(--ink-faint); font-size: 12px; white-space: nowrap; }
mark { background: var(--mark); color: var(--bg); border-radius: 2px; padding: 0 1px; }
.nohits { color: var(--ink-mute); padding: 4px 0; }
.content { flex-grow: 1; overflow-y: auto; padding: 20px 24px; min-height: 0; }

/* transcript */
/* `flex-start`, not the default stretch. `.who` carries a name, a day, a time
   and a copy button -- 71 px of them -- and a stretched bubble is as tall as
   that whatever is in it. One line of text then sat 14 px below the top of a
   71 px box with 41 px under it, which reads as a block that is not centred
   and is really a block that is not the size of its contents. */
.turn { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 22px;
        position: relative; }
/* Only a block that has just arrived. It used to sit on `.turn`, so the whole
   history slid every time the tab was rebuilt — which is whenever anything
   about the transcript changes. `patchTranscript` is the one place a block is
   new; the reduced-motion switch above covers this like everything else. */
.fresh { animation: slide .15s ease-out; }
@keyframes slide { from { transform: translateY(4px); opacity: 0; } }
.who {
  width: 64px; flex-shrink: 0; padding-top: 2px; font-family: var(--mono);
  font-size: 11px; color: var(--ink-faint); text-align: right; line-height: 1.5;
}
.who.claude { color: var(--needs); }
/* The name is a link to this block. It reads as the name it always was; the
   browser's own "open in a new tab" is what it is there for. */
.who .self { color: inherit; text-decoration: none; }
.who .self:hover { text-decoration: underline; }
.who .day { color: var(--ink-faint); }
/* The copy button stands on the time's line, left of it, not on a line of its
   own under it. On its own line it made the column 55 px tall -- more than a
   line of text (22) or a prompt's bubble (45) -- so the column set the height
   of most turns, and the gap a reader saw was 32 px after a prompt and 59
   after a one-line reply, where 22 and 26 were meant. "copy" and a time fit
   the column's 64 px; "copied" hangs into the pane's gutter for a second. */
.who .stamp { display: flex; justify-content: flex-end; align-items: baseline;
  gap: 6px; }
.who .stamp .copy { order: -1; margin-top: 0; }
/* And whatever the column still has past the words -- the time under a
   line of text, a day under a prompt -- may hang 10 px into the gap below.
   10 and no more: the rule over the next prompt is 12 px down, and the next
   turn's name 25. A call coming next allows more; see `.turn.toolrow`. */
.turn:not(.toolrow) > .who { margin-bottom: -10px; }
/* Copy the source of a reply. It is there when the pointer is on the turn,
   the way the `+` on a diff line is: a button beside every line of a
   transcript would be the loudest thing on the page. Keyboard focus shows it
   too, or it could not be reached without a mouse. */
.who .copy {
  margin-top: 5px; padding: 0; border: none; background: none; cursor: pointer;
  font-family: var(--mono); font-size: 10px; color: var(--ink-faint);
  opacity: 0; transition: opacity .1s ease;
}
.turn:hover .copy, .copy:focus { opacity: 1; }
/* Saved for later (issue 377): a bookmark after the name, on the hover, and
   always once saved, filled. */
.who .save {
  /* Before the name: the column is right-aligned, so it moves nothing.
     After it, an invisible bookmark pushed "claude" out of line with the
     time; in the gap beside the words, it touched them. */
  margin-right: 4px; padding: 0; border: none; background: none;
  cursor: pointer; color: var(--ink-faint); opacity: 0; vertical-align: -1px;
}
.turn:hover .who .save, .who .save:focus, .who .save.on { opacity: 1; }
.who .save:hover, .who .save.on { color: var(--needs); }
.who .save .icon { width: 11px; height: 11px; fill: none; stroke: currentColor;
  stroke-width: 1.3; stroke-linejoin: round; }
.who .save.on .icon { fill: currentColor; }
.who .copy:hover { color: var(--needs); }
/* Where a link landed, for long enough to find with your eye. */
.turn.linked { outline: 2px solid var(--needs); outline-offset: 6px;
  border-radius: 4px; }
.bubble {
  flex-grow: 1; padding: 11px 15px; border-radius: 6px; background: var(--raised);
  border: 1px solid var(--edge); line-height: 1.5; min-width: 0;
  white-space: pre-wrap; word-wrap: break-word;
}
/* The question an agent is stopped on. It wears the needs-you colour,
   because it is the same news the amber row carries and reading the two as
   one thing is the point. */
.asking {
  flex-shrink: 0; max-height: 40vh; overflow-y: auto;
  padding: 12px 16px; border-top: 1px solid var(--edge);
  background: color-mix(in srgb, var(--needs) 8%, var(--raised));
}
.askone + .askone { margin-top: 14px; padding-top: 14px;
                    border-top: 1px solid var(--edge); }
.askhead {
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--needs); font-weight: 600;
}
.askwhat { margin: 3px 0 9px; color: var(--ink-bright); font-size: 14px; }
.askopts { display: flex; flex-direction: column; gap: 6px; }
/* Not `.verb`: a verb is a small control, and this is a paragraph you press.
   The number is what it types, and it is drawn because a button that types
   into your terminal should say what it types. */
.askopt {
  display: flex; gap: 10px; align-items: baseline; width: 100%;
  padding: 8px 10px; text-align: left; cursor: pointer;
  background: var(--sunken); color: var(--ink);
  border: 1px solid var(--edge); border-radius: 6px; font: inherit;
}
.askopt:hover:not(:disabled) {
  background: var(--raised); color: var(--ink-bright);
  border-color: var(--needs);
}
.askopt:disabled { opacity: .55; cursor: default; }
/* What you picked, and what submit will press. It wears the needs-you
   colour, like the row this question came from. */
.askopt.chosen {
  background: var(--raised); color: var(--ink-bright);
  border-color: var(--needs);
  box-shadow: inset 2px 0 0 var(--needs);
}
.askopt.chosen .asknum {
  background: var(--needs); border-color: var(--needs); color: var(--sunken);
}
.asksend { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
/* A permission request: each field of it, whole, in the preview's box. */
.permfield + .permfield { margin-top: 8px; }
.permsend { flex-wrap: wrap; align-items: flex-end; }
/* A request is read whole, so a long command wraps rather than running off
   the side: a preview keeps its layout, and this has none to keep. */
.permfield .askprevbody { white-space: pre-wrap; overflow-wrap: anywhere; }
/* At least as wide as its placeholder, when the row has room: the box is
   one row high, and a placeholder wider than the box wrapped onto a second
   row that did not show -- "(optional)" stood cut in half under the first.
   `--fits` is the placeholder's length, set where the placeholder is, so
   new words cannot outgrow it; `ch` is one character of this mono font, and
   24 px is the padding and the border. Wider than it fits, the box takes a
   row of its own rather than shrinking. */
.permsend .permwhy {
  flex: 1 1 260px; min-width: min(100%, calc(var(--fits, 0ch) + 24px));
}
.permsend .asksays { flex-basis: 100%; }
.asksays { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }
.asknum {
  flex-shrink: 0; min-width: 18px; text-align: center;
  font-family: var(--mono); font-size: 11px; color: var(--needs);
  border: 1px solid var(--edge); border-radius: 4px; padding: 1px 0;
}
.asktext { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.asklabel { font-size: 13px; font-weight: 600; }
.askwhy { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }
.asknote { margin-top: 8px; font-size: 11px; color: var(--ink-faint); }
/* The box Claude Code draws beside a question's options. It wears the code
   block's ground and ink, because it is usually code, and keeps every line
   and every space: a layout drawn in text is nothing without them, so it
   scrolls sideways rather than wrapping. Its height is capped, or one long
   sketch would push the submit out of the bar. */
.askbeside { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; }
.askbeside > .askopts { flex: 1 1 260px; min-width: 0; }
/* It wraps under the options where the two will not fit side by side. */
.askbeside > .askpreview { flex: 1 1 340px; min-width: 0; }
.askprevhead { margin-bottom: 4px; font-size: 11px; color: var(--ink-faint); }
.askprevbody {
  margin: 0; padding: 10px 14px; max-height: 16em; overflow: auto;
  border-radius: 6px; background: var(--code); border: 1px solid var(--edge);
  color: var(--code-ink); font-family: var(--mono); font-size: 12.5px;
  line-height: 1.5; white-space: pre;
}
.askprevbody.none { color: var(--ink-faint); font-style: italic; }
/* Something the harness said: a background task finishing, a message from
   another session. It is real news and it is not a prompt, so it gets a quiet
   block rather than your rail and your tint. It was drawn as though you had
   typed it, which is part of what made a transcript read as a wall. */
.turn.aside .bubble, .feedentry .bubble.aside {
  background: none; border-style: dashed; color: var(--ink-mute);
}
.turn.aside .who { color: var(--ink-faint); }
/* A plan is a document the agent asks to start on (issue 372): framed, so it
   reads as one thing and not as more of the reply above it. */
.turn.plan .prose { border: 1px solid var(--edge-bright); border-radius: 6px;
  padding: 4px 16px; }
/* Your words against Claude's. A rail and a tint say where you spoke, and a
   rule above each one breaks a long transcript into rounds you can scan.
   Both used to be grey blocks told apart by one small word. */
.turn.mine { margin-top: 26px; }
.turn.mine::before {
  content: ""; position: absolute; left: 0; right: 0; margin-top: -14px;
  height: 1px; background: var(--edge);
}
.turn.mine:first-child { margin-top: 0; }
.turn.mine:first-child::before { display: none; }
.turn.mine .who { color: var(--mine); font-weight: 600; }
/* A saved prompt's card wears it too (issue 403): out of its transcript,
   a prompt in an answer's face read as an answer. */
.turn.mine .bubble, .feedentry .bubble.mine {
  background: var(--mine-soft); border-color: transparent;
  border-left: 3px solid var(--mine); border-radius: 6px;
  color: var(--ink-bright);
}
/* A `!` command: the reader's rail, a terminal's face. The output keeps its
   columns and scrolls sideways rather than folding them. */
.turn.mine .bubble.shell, .feedentry .bubble.shell { font-family: var(--mono); font-size: 13px; }
.bubble.shell .command { font-weight: 600; }
.bubble.shell .output {
  margin: 6px 0 0; font: inherit; font-weight: 400; color: var(--ink-soft);
  white-space: pre; overflow-x: auto;
}
.prose { flex-grow: 1; line-height: 1.55; min-width: 0; }
/* A message too long to show whole (`foldedHead`): its first lines, fading
   out, and the bar under it. Open, the bar stays at the foot of the pane
   while any of the message is on screen, so it folds from anywhere in it --
   at the right, where it covers the end of a line and not its start. */
.foldbox { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; }
.folded {
  -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent);
  mask-image: linear-gradient(to bottom, black 50%, transparent);
}
.foldbar {
  align-self: flex-start; display: flex; align-items: center; gap: 6px;
  margin-top: 4px; padding: 3px 8px 3px 4px; border: 1px solid var(--edge);
  border-radius: 5px; background: var(--bg); cursor: pointer;
  font-family: var(--sans); font-size: 12px; color: var(--ink-mute);
}
.foldbar:hover { color: var(--needs); border-color: var(--edge-bright); }
.foldbar .icon {
  width: 12px; height: 12px; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round;
  transform: rotate(90deg);
}
.foldbar.open { position: sticky; bottom: 8px; align-self: flex-end; }
.foldbar.open .icon { transform: rotate(-90deg); }
/* One of the reader's own autolinks. It sits inside an agent's words, so it
   is underlined rather than coloured: a colour here would compete with the
   four this page already spends on state. */
.ticket { color: inherit; text-decoration: underline dotted;
  text-underline-offset: 2px; }
.ticket:hover { color: var(--needs); text-decoration-style: solid; }
.prose > *:first-child { margin-top: 0; }
.prose > *:last-child { margin-bottom: 0; }
.prose h1, .prose h2, .prose h3 {
  font-size: 16px; font-weight: 600; color: var(--ink-bright); margin: 14px 0 8px;
}
.prose p { margin: 0 0 8px; }
.prose ul, .prose ol { margin: 0 0 8px; padding-left: 22px; }
.prose li { margin: 3px 0; }
.prose li.task { list-style: none; }
.prose code {
  font-family: var(--mono); font-size: 12.5px; padding: 1px 5px;
  border-radius: 4px; background: var(--chosen); color: var(--needs-warm);
}
.prose pre {
  padding: 10px 14px; border-radius: 6px; background: var(--code);
  border: 1px solid var(--edge); overflow-x: auto; margin: 0 0 8px;
}
.prose pre code { background: none; padding: 0; color: var(--code-ink); font-size: 12.5px; }
/* A code block and the button that copies it. The box holds the margin, so
   the button stands at the block's corner and not in its scroll. It shows
   while the pointer is on the block, as a reply's copy does on its turn,
   and on keyboard focus, or it could not be reached without a mouse. */
.prose .codebox { position: relative; margin: 0 0 8px; }
.prose .codebox > pre { margin: 0; }
.copycode {
  position: absolute; top: 6px; right: 6px; width: 24px; height: 24px;
  display: flex; align-items: center; justify-content: center; padding: 0;
  border: 1px solid var(--edge); border-radius: 5px; background: var(--code);
  color: var(--ink-faint); cursor: pointer; opacity: 0; transition: opacity .1s ease;
}
.codebox:hover .copycode, .copycode:focus-visible { opacity: 1; }
.copycode:hover { color: var(--needs); border-color: var(--edge-bright); }
.copycode.done { color: var(--working); opacity: 1; }
/* Jump that went: the tick, in the working colour, ring and all. */
.theme.done, .theme.done:hover { color: var(--working); border-color: var(--working); }
.copycode .icon {
  width: 14px; height: 14px; fill: none; stroke: currentColor;
  stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round;
}
.prose a { color: var(--needs); }
.prose blockquote {
  margin: 0 0 8px; padding-left: 12px; border-left: 2px solid var(--edge-bright);
  color: var(--ink-mute);
}
.prose table { border-collapse: collapse; margin: 0 0 8px; }
.prose th, .prose td { border: 1px solid var(--edge); padding: 4px 10px; text-align: left; }
.prose [align="center"] { text-align: center; }
.prose [align="right"] { text-align: right; }

/* A group of tool calls belongs to the words above it: the agent says what it
   is about to do, and then does it. Measured, the gaps used to be 16 px above
   and 16 px below -- exactly equal, so the group read as belonging to neither
   and, with the reply below it being the thing you next want to read, as
   belonging to the one after. 6 above and 22 below says which.
   The margins collapse against `.turn`'s own 22, so the numbers here are not
   the gaps: above is 22 + (-16) = 6, and below is max(5, 22) = 22.

   Margin collapse was chosen over the honest mechanism, on purpose. The
   honest one is a `.toolgroup` node around each run of calls and a `gap` on
   a flex column, which is one number and no arithmetic -- but blocks are
   appended flat, and `patchTranscript` appends a new one by index into
   `state.turns.nodes`, which is the only place a block is ever new and so is
   what the arriving-block animation rests on. Grouping changes both. If the
   numbers here need touching again, measure them in a browser rather than
   reading them off. */
.turn.toolrow { margin-bottom: 5px; }
.turn:not(.toolrow) + .turn.toolrow { margin-top: -16px; }
.turn.toolrow + .turn:not(.toolrow) { margin-top: 22px; }
/* The 6 px above is from box to box, and the box of the words is not the
   words. `.who` holds a name, a time, a day when it was not today and the
   copy button: 55 px on one day and 71 across two when this was written,
   35 and 51 since the button moved onto the time's line. It is the taller
   part of any turn of one line, so it set the height: one line of text,
   then 39 px of nothing, then the calls -- more than the 22 below them, so
   the group read as the start of the reply after it. The measuring was box
   to box and said 6 the whole time.
   When calls come next, the column may run down beside them: their own
   `.who` is empty, so there is nothing there to collide with. Not all the
   way down. The shortest group is one call, 14 px, and the next turn's name
   starts 22 + 3 px after it, so 36 px of the column may hang past the box
   and no more. That covers one day's column over one line of text, and
   leaves a gap under a column that also carries a day.
   `z-index`, because the calls are later siblings and positioned: without
   it they cover the copy button, and a click on it goes to them. */
.turn:not(.toolrow):has(+ .turn.toolrow) > .who {
  margin-bottom: -36px; position: relative; z-index: 1;
}
.tools { flex-grow: 1; display: flex; flex-direction: column; gap: 4px;
  font-family: var(--mono); font-size: 12px; color: var(--ink-mute); min-width: 0; }
.tool { display: flex; gap: 8px; align-items: baseline; cursor: pointer;
  background: none; border: 0; font: inherit; color: inherit; padding: 0;
  text-align: left; width: 100%; }
.tool .caret { color: var(--edge-bright); width: 10px; flex-shrink: 0; }
.tool .target { color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; }
.tool .plus { color: var(--working); }
.tool .minus { color: var(--cut-ink); }
.tool.failed .name { color: var(--cut-ink); }
/* An edit's change under its call: the diff card, at the result's inset. */
.dfile.tooldiff { margin: 2px 0 6px 18px; }
.tooldiff .toolmore {
  padding: 4px 12px; border-top: 1px solid var(--edge); color: var(--ink-faint);
}
.tool-result {
  margin: 2px 0 6px 18px; padding: 8px 12px; border-radius: 6px;
  background: var(--code); border: 1px solid var(--edge); color: var(--code-ink);
  font-family: var(--mono); font-size: 12px; line-height: 1.55;
  white-space: pre-wrap; word-wrap: break-word; max-height: 320px; overflow: auto;
}
.divider {
  display: flex; align-items: center; gap: 10px; margin: 14px 0;
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  letter-spacing: .06em; text-transform: uppercase;
}
.divider::before, .divider::after {
  content: ""; flex-grow: 1; height: 1px; background: var(--edge);
}
/* The first block the reader has not seen (issue 374), as Slack marks the
   first new message: a word and a rule, in the colour of a turn that is
   done, which is the colour of the row's unread dot. */
.newline {
  display: flex; align-items: center; gap: 10px; margin: 0 0 18px;
  font-family: var(--mono); font-size: 11px; color: var(--done);
  letter-spacing: .06em; text-transform: uppercase;
}
.newline::after { content: ""; flex-grow: 1; height: 1px; background: var(--done); }

/* files and diff: a list on the left, what it names on the right */
/* `relative` for the Transcript tab's "latest" button, which is the one
   thing on a split tab that stands over the pane rather than in it.
   `subgrid` takes `.main`'s columns and rows: the map and the grip span
   every row, down beside the question bar and the send box, and the pane
   is the first row only, so it ends where they begin. */
.content.split {
  padding: 0; overflow: hidden; position: relative; display: grid;
  grid-template-columns: subgrid; grid-template-rows: subgrid;
}
.content.split > .side, .content.split > .grip { grid-row: 1 / -1; }
/* A split tab's list -- the map, a file tree -- stands apart from what it
   lists by its ground, not by a line, and it is what the chosen row meets. */
.content.split > .side { grid-column: 1; background: var(--meet); }
.content.split > .grip { grid-column: 2; }
.content.split > :nth-child(3) { grid-row: 1; grid-column: 3; min-height: 0; }
.side {
  width: var(--side-w, 268px); flex-shrink: 0; display: flex;
  flex-direction: column; min-height: 0;
}
/* The list of places to go sits under the box, so the slot is what it is
   measured from. */
.findslot { position: relative; }
/* As wide as a path, not as wide as the box it hangs under. The sidebar is
   268 px by default and a path is not, so every row was clipped to its last
   few letters -- which is the half you can already see in the tree. It runs
   out over the pane to the right, which is empty space while you are typing
   a name into the box. */
.goto {
  position: absolute; left: 10px; right: auto; top: 100%; z-index: 5;
  min-width: calc(100% - 20px); width: 560px; max-width: 70vw;
  max-height: 60vh; overflow-y: auto;
  background: var(--panel); border: 1px solid var(--edge);
  border-radius: 6px; box-shadow: 0 10px 24px var(--shadow);
}
.goto button {
  display: flex; align-items: center; gap: 5px; width: 100%;
  padding: 6px 12px; background: none; border: 0; color: var(--ink-mute);
  font: inherit; font-family: var(--narrow); font-size: 12.5px;
  text-align: left; cursor: pointer;
}
/* A long path is clipped at its start, because the end of it is the part you
   were looking for -- which is what `direction: rtl` buys. It costs a bidi
   trap: a leading dot is a neutral character, and in an RTL paragraph a
   neutral at the edge goes to the other end, so `.gitignore` drew as
   `gitignore.`. A file with a dot invented on it is a wrong answer that
   looks right. `unicode-bidi: plaintext` takes the paragraph's direction
   from the first strong character in it, which for a path is always
   left-to-right, while the box keeps clipping the start. */
.goto button .name { overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; direction: rtl; unicode-bidi: plaintext; }
.goto button .icon {
  width: 13px; height: 13px; flex-shrink: 0; color: var(--ink-faint);
  fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round;
}
.goto button:hover, .goto button.chosen {
  background: var(--raised); color: var(--ink-bright);
}
.goto .lit { color: var(--needs-warm); font-weight: 600; }
.goto .nohits { padding: 10px 12px; }
.findslot { flex-shrink: 0; display: flex; padding: 8px 10px;
  border-bottom: 1px solid var(--edge); }
.findslot .find { width: 100%; }
.filelist {
  flex-grow: 1; overflow-y: auto; padding: 8px 0;
  font-family: var(--narrow); font-size: 13px; letter-spacing: .01em;
}
.filelist button {
  display: block; width: 100%; padding: 7px 14px; text-align: left;
  background: none; border: 0; border-left: 2px solid transparent;
  font: inherit; color: var(--ink-soft); cursor: pointer;
}
/* A row that is one line: icon, then what it says, then anything at its
   end. `.filelist button` is a block, so each list whose rows are one line
   says so here -- the file tree, the Diff tab's tree, and the transcript's
   map. Without it the icon sat on a line of its own above the text, which
   is how the map first shipped. One rule, so a fourth list joins it rather
   than copying it. */
.filelist.fixed button, .filelist.diff button, .filelist.transcript button {
  display: flex; align-items: center; gap: 5px;
}
.filelist.fixed .name, .filelist.diff .name, .filelist.transcript .name {
  flex-grow: 1; min-width: 0;
}
/* The Files list is one height per row, which is what lets it build only the
   rows on screen and stand two spacers in for the rest. */
.filelist.fixed button { height: 28px; padding: 6px 14px; line-height: 16px; }
/* Beside every name, so a file and a folder are told apart without reading
   either. It sits on the text baseline, which is where the eye expects it. */
.filelist .icon {
  width: 13px; height: 13px; flex-shrink: 0; color: var(--ink-faint);
  fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round;
}
/* A folder carries the one colour on this page that means nothing else, so
   the shape of the tree is read before any of its names are. A file's icon
   stays quiet: there are far more of them, and they are not the shape. */
.filelist button.dir .icon { color: var(--folder); }
/* On the map a round's chevron is a second target -- the row goes to that
   place in the transcript, the chevron folds it away -- so it has to say so.
   Nothing else in this list has two, which is why this is the transcript's
   rule and not the list's. No `cursor` here: the row is a button and already
   sets one, so a second declaration would say nothing. The colour under the
   pointer is the part that separates it from the rest of the row. */

.filelist button:hover .icon { color: inherit; }
.filelist button.dir:hover .icon { color: var(--folder); }
.filelist button.dir { color: var(--ink); }
.listnote {
  flex-shrink: 0; padding: 7px 14px; border-bottom: 1px solid var(--edge);
  font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.filelist button:hover { background: var(--raised); color: var(--ink-bright); }
.filelist button.chosen {
  background: var(--raised); border-left-color: var(--needs); color: var(--ink-bright);
}
.filelist .name {
  display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.filelist .counts { display: flex; gap: 8px; margin-top: 2px; font-size: 11px; }
.filelist .head {
  padding: 12px 14px 4px; font-size: 11px; letter-spacing: .08em;
  text-transform: uppercase; color: var(--ink-faint);
}
.filelist button.touched .name::after {
  content: "\25cf"; margin-left: 6px; color: var(--needs); font-size: 9px;
  vertical-align: middle;
}
/* At the right edge of a folder row, where a count sits on a diff row: it
   is what the folder has instead of contents. Quiet, because it is a fact
   about a build directory and not a warning about anything. */
.toobig {
  margin-left: auto; padding-left: 8px; flex-shrink: 0;
  font-family: var(--mono); font-size: 10px; color: var(--ink-faint);
}
.filelist .lit { color: var(--needs-warm); font-weight: 600; }
.filelist button.chosen .lit { color: var(--needs); }
/* No box. A file that is not Markdown is the whole page here, not a quotation
   inside a document that does not exist, and the border made a shell script
   look like one. It is drawn as diff rows, so it shares their ramp too. */
.code { color: var(--code-ink); }
/* Which line this was. Numbers are not the content, here or in a diff, so
   they are faint and they are not copied with it. The gutter ends in a rule,
   as delta draws it -- a shadow and not a border, so it takes no width and a
   windowed file's grid is the grid it was. */
.dline .ln {
  color: var(--ink-faint); user-select: none;
  display: inline-block; margin-right: 6px; box-shadow: inset -1px 0 var(--edge);
}
/* Our colours, not the highlighter's: its stylesheets are not fetched. */
.hljs-comment, .hljs-quote { color: var(--syn-com); font-style: italic; }
.hljs-keyword, .hljs-literal, .hljs-selector-tag,
.hljs-doctag, .hljs-operator { color: var(--syn-key); }
.hljs-string, .hljs-regexp, .hljs-char, .hljs-symbol,
.hljs-bullet, .hljs-addition { color: var(--syn-str); }
.hljs-number { color: var(--syn-num); }
.hljs-title, .hljs-section, .hljs-name,
.hljs-built_in, .hljs-type, .hljs-class { color: var(--syn-fn); }
.hljs-meta, .hljs-comment .hljs-doctag { color: var(--syn-meta); }
.hljs-attr, .hljs-attribute, .hljs-property,
.hljs-variable, .hljs-template-variable { color: var(--syn-attr); }
.hljs-emphasis { font-style: italic; }
.hljs-strong { font-weight: 600; }
.hljs-deletion { color: var(--cut-ink); }
.plus { color: var(--working); }
.minus { color: var(--cut-ink); }
/* What a tab's body is: the column that scrolls. The diff sets its own
   padding, because its rows run to the edge. */
.filebody, .diffbody, .turnbody, .cmdbody {
  flex-grow: 1; overflow-y: auto; min-width: 0;
}
/* The Commands view (issues 367, 411). A row is a command's name, how often
   it was used at the right, and its description under it on one line. The
   pane is a skill to read, like a document on the Files tab. All of it in
   the reading face, the path too (issue 414): the name was in the fixed
   face it is typed in, and the reader asked for none. */
.filelist.commands { font-family: var(--sans); }
.filelist .cmdrow .name { font-weight: 500; }
.filelist .cmdrow .cmduses { float: right; margin-left: 8px; font-size: 11px; color: var(--ink-faint); }
.filelist .cmdrow .cmdabout {
  font-size: 12px; color: var(--ink-faint); margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cmdbody { padding: 18px 26px 24px; }
.cmdbody > .empty { max-width: 52ch; }
.cmdhead { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
.cmdtitle { flex: 1; min-width: 0; }
.cmdname { font-family: var(--sans); font-size: 17px; font-weight: 600; color: var(--ink-bright); }
.cmdhint { font-family: var(--sans); font-size: 13px; color: var(--ink-faint); margin-left: 10px; }
.cmdfile {
  font-family: var(--sans); font-size: 12px; color: var(--ink-faint);
  margin-bottom: 10px; overflow-wrap: anywhere;
}
.cmdsays { color: var(--ink-soft); margin: 0 0 14px; }
.turnbody { padding: 20px 24px; }
.turnbody > .empty { max-width: 52ch; }
/* Over the transcript, at its foot, and only while it would do something.
   It is a `.verb`, which already gives it the height, the padding, the
   border, the raised background, the type and the hover -- so what is left
   here is only what makes it float. */
/* A grid item in the pane's own cell, over the pane, at its foot. Not
   `position: absolute` against the box: the box runs down under the
   question bar and the send box, so its foot is behind them. An absolute
   child with a grid area is meant to be measured from that area, and
   Chromium measured it from the whole box -- the box is a subgrid. */
.tofoot {
  grid-row: 1; grid-column: 3; align-self: end; justify-self: center;
  margin: 0 0 16px; position: relative; z-index: 4;
  width: 32px; height: 32px; padding: 0; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px var(--shadow);
}
.tofoot .icon {
  width: 16px; height: 16px; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
}
/* The map of the conversation. Same rows as the file tree, because they are
   the same thing: a list on the left that names what is on the right. */
/* The map names what stands beside it, so it is set like it: the same face,
   size and line height as the transcript's text. It had the lists' condensed
   face at 13 px and 7 px above and below each row, 29 px a row, and read as
   a different page. 1 px keeps a hover from touching the text. The file
   lists keep the condensed face: a path wants the width. */
.filelist.transcript {
  font-family: var(--sans); font-size: 14px; letter-spacing: normal;
  line-height: 1.55;
}
.filelist.transcript button { padding-top: 1px; padding-bottom: 1px; }
/* A round is yours, so its person takes the one colour that means that.
   The chevron stays quiet, and turns down while the round is open. */
.filelist.transcript button.dir .icon { color: var(--mine); }
.filelist.transcript button.dir .icon.fold { color: var(--ink-faint); }
.filelist.transcript button.dir .icon.fold:hover { color: var(--needs); }
.filelist.transcript button[aria-expanded="true"] .fold { transform: rotate(90deg); }
/* The chevron and the gap after it are one tree step, 13 px, so the person
   stands exactly where a reply's robot does: the reply lines up under what
   it answers. The chevron's own box is blank on its right, so taking the
   gap back does not crowd the person. */
.filelist.transcript .fold { margin-right: -5px; }
/* The padding is on the children of the scroller, so a branch added to
   `drawFiles` later cannot quietly lose its gutter, and so the header --
   which is not one of them -- keeps running to the pane's edges. */
/* Two children: a header that does not move, and the part that does. The
   header used to be `position: sticky` inside the scroller, which keeps it
   in view but not out of the scrollbar's way -- the bar ran the whole height
   of the pane, beside a line that never scrolls. */
.filebody { padding: 0; display: flex; flex-direction: column; overflow: hidden; }
.filescroll { flex-grow: 1; min-height: 0; overflow: auto; padding-top: 14px; }
.filescroll > * { padding: 0 26px 20px; }
.filebody > .empty { padding: 20px 26px; }
/* Shown as it is: a picture, a video, a sound. Given room and no more -- a
   screenshot wider than the pane would otherwise set the pane's width and
   take the sideways scrollbar with it. */
.media img, .media video {
  max-width: 100%; height: auto; border: 1px solid var(--edge);
  border-radius: 6px; background: var(--code);
}
.media audio { width: 100%; max-width: 420px; }
/* The Diff tab's body has no padding of its own -- a diff's rows run to the
   edge -- so its empty state has to bring its own inset, or it sits against
   the left edge while the Files tab's sits properly in from it. A margin
   and not a padding: it is the block that has to move, and a padded box
   still starts at the edge. */
.diffscroll > .empty { margin: 16px 20px; }
/* Two children, like the Files tab's: the bar, which does not move, and the
   diff, which does. `relative` so a block's `offsetTop` is measured from the
   scroller -- `markDiffFile` reads it. */
.diffbody { display: flex; flex-direction: column; overflow: hidden; }
.diffscroll {
  flex-grow: 1; min-height: 0; overflow-y: auto; position: relative;
  padding-bottom: 24px;
}
.diffbar {
  flex-shrink: 0; display: flex; align-items: center; gap: 8px;
  padding: 8px 16px; background: var(--bg); border-bottom: 1px solid var(--edge);
}
/* The narrow face, as file names wear: branch names and commit subjects
   are long, and a picker that shows more of one is read, not opened. */
.pickof, .pickbase {
  min-width: 0; max-width: 52ch; height: 26px; padding: 0 8px;
  border-radius: 5px; border: 1px solid var(--edge-bright);
  background: var(--raised); color: var(--ink); font-family: var(--narrow);
  font-size: 13px; cursor: pointer;
}
.baseword { color: var(--ink-faint); font-family: var(--mono); font-size: 12px; }
.pickof:focus, .pickbase:focus { outline: none; border-color: var(--needs); }
/* What the branch's work is measured against: a name, short, and read
   whole -- so it does not shrink, and the commit picker, whose subject can
   be cut and still be known, takes what room is left. */
.pickbase { max-width: 36ch; flex-shrink: 0; }
.diffbar .stepat {
  flex-shrink: 0; font-family: var(--mono); font-size: 12px;
  color: var(--ink-mute); font-variant-numeric: tabular-nums;
}

/* The small label look: the path above a file. */
.filebody .where {
  font-family: var(--narrow); font-size: 12px; letter-spacing: .04em;
  color: var(--ink-faint);
}
/* What the open file is: its path, what it holds, and the two controls for
   how it is drawn. It is outside the scroller, so it stays in view in both
   directions without being sticky in either. */
.filebody > .where {
  flex-shrink: 0; padding: 12px 26px; gap: 14px;
  display: flex; align-items: baseline; flex-wrap: wrap;
  background: var(--bg); border-bottom: 1px solid var(--edge);
}
.filebody .where .link { margin-top: 0; flex-shrink: 0; }
/* What is known about the file, after its name: the type, the size, when it
   last changed. */
.filebody .where .whatis { color: var(--ink-mute); flex-shrink: 0; }
.link:disabled { opacity: .5; cursor: default; }
/* One piece of the path. Text nodes separate them, so the whole line is still
   one string to select and copy. */
.crumbs { min-width: 0; word-break: break-all; }
.crumb { cursor: pointer; }
.crumb:hover { color: var(--needs); text-decoration: underline; }
/* Not sticky: the file's own header is, and two sticky bars at the top of one
   scroller stand on each other. Which file you are in is the question a
   long diff asks; which half of it is answered once, where the half starts. */
.diffhead {
  padding: 14px 20px 4px;
  font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  color: var(--ink-faint);
}
/* What this section is a diff of, under its name. Not uppercase and not
   letter-spaced: it is a sentence, and the heading above it is a label. */
.diffhead .about {
  display: block; margin-top: 3px; text-transform: none; letter-spacing: 0;
  font-size: 11.5px; color: var(--ink-mute);
}
/* A commit's subject is somebody's sentence, not a label. */
.diffhead.commit {
  text-transform: none; letter-spacing: 0; font-size: 13.5px;
  color: var(--ink-bright);
}
/* The rest of the commit message, under its subject: as Markdown, in the
   face the transcript reads in, or as it was written, where lists and
   paragraphs are made of blank lines and dashes, so the lines are kept and
   the face is fixed (`putMessage`). */
.diffhead .message {
  margin: 10px 0 4px; overflow-wrap: anywhere; font-family: var(--sans);
  font-size: 13.5px; line-height: 1.55; letter-spacing: 0;
  text-transform: none; color: var(--ink-soft);
}
.diffhead .message .prose > :first-child { margin-top: 0; }
.diffhead .message .prose > :last-child { margin-bottom: 0; }
.diffhead .message.astext {
  white-space: pre-wrap; font-family: var(--mono); font-size: 12.5px;
}
/* Markdown or text, at the right end of the subject's line: the subject,
   its sha, room, and the control; the sentence and the message under them
   run the whole width. A grid, so the control can stand anywhere among the
   head's children and the subject stays its first. */
.diffhead.commit {
  display: grid; grid-template-columns: minmax(0, max-content) auto 1fr auto;
  align-items: baseline;
}
.diffhead.commit > :is(.about, .message) { grid-column: 1 / -1; }
.diffhead .readas { grid-column: 4; grid-row: 1; margin-left: 12px; }
/* On the Files tab it is the last thing on the path's line. */
.filebody .where .readas { margin-left: auto; }
.diffhead .sha {
  margin-left: 10px; font-family: var(--mono); text-transform: none;
  letter-spacing: 0; color: var(--ink-mute);
}
/* A card per file, as a pull request draws it: the edge is where one file
   stops and the next begins. `clip` and not `hidden`, because `hidden` makes
   a scroller of the card and the header inside it would stop being sticky
   against the pane. */
.dfile {
  margin: 10px 16px 0; border: 1px solid var(--edge); border-radius: 8px;
  overflow: clip; background: var(--sheet);
}
/* Sticky, so a file three screens long still says which file it is. */
.dfile > .name {
  position: sticky; top: 0; z-index: 2;
  display: flex; gap: 10px; align-items: baseline; width: 100%;
  padding: 9px 16px; background: var(--sheet); border: 0;
  border-bottom: 1px solid var(--edge); font: inherit;
  color: var(--ink-bright); text-align: left; cursor: pointer;
}
/* An untracked file's header is a label, not a toggle: there is nothing to
   fold, because every line in the file is shown. */
.dfile > div.name { cursor: default; }
.dfile .what {
  color: var(--ink-faint); font-size: 11px; letter-spacing: .06em;
  text-transform: uppercase; flex-shrink: 0;
}
.dfile .path {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: var(--narrow); font-size: 13px;
}
.dfile .why { margin-left: auto; flex-shrink: 0; color: var(--ink-faint); font-size: 11px; }
.hunk {
  padding: 4px 16px; background: var(--hunk-bg); color: var(--ink-faint);
  font-family: var(--mono); font-size: 12px; line-height: 20px;
  white-space: pre; overflow-x: auto;
}
.hunk .ctx { margin-left: 14px; color: var(--ink-soft); }
/* Where lines are hidden: the buttons that show them, then how many. */
.hunk { display: flex; align-items: center; }
.hunk .more { display: inline-flex; gap: 4px; margin-right: 12px; }
.hunk .grow {
  width: 24px; height: 18px; padding: 0; border-radius: 4px;
  border: 1px solid var(--edge-bright); background: var(--sheet);
  color: var(--ink-mute); font: inherit; line-height: 16px; cursor: pointer;
}
.hunk .grow:hover { border-color: var(--done); color: var(--done); }
.hunk .hidden { margin-left: auto; padding-left: 14px; color: var(--ink-mute); }
.hunk .link { margin: 0 0 0 10px; }
/* What makes a row a row of code. It belongs here and not on a tab's own
   container: it used to sit on `.diffbody`, so the moment the Files tab drew
   the same rows they came out in the proportional face, with the gutter's
   space padding no longer lining up. A component carries its own typography. */
.dlines {
  padding: 5px 0; overflow-x: auto; color: var(--code-ink);
  font-family: var(--mono); font-size: 12.5px; line-height: 21px;
  /* How wide a tab is drawn. The reader picks it; see `readingWanted`. */
  tab-size: var(--tab-w, 4);
}
/* A windowed file's rows are a grid the scrollbar is read against, so the row
   height is a whole number of pixels (`CODE_H`) and nothing pads the block
   they sit in. See `fillCode`. */
.code.windowed .dlines { padding: 0; }
/* On the Files tab the rows give up their own scroller, so the long-line bar
   is at the bottom of the screen instead of under the last line of the file —
   which in a file of any length is somewhere nobody scrolls to. The pane
   scrolls both ways instead, and the place the reader had scrolled to then
   survives a window move for free.
   The Diff tab keeps the scroller here on purpose: it stacks many files in
   one pane, so a bar at the bottom of the screen would belong to whichever
   block happened to be under it. */
.filebody .dlines { overflow-x: visible; }
.filebody .nowrap {
  display: none; margin-left: auto; flex-shrink: 0; color: var(--ink-faint);
}
:root[data-wrap="yes"] .filebody .nowrap { display: inline; }
/* Wrapped: the line breaks instead of running off the side. On the root, like
   the theme, because it is about this browser and not about a tab — and
   `:not(.windowed)` is the exclusion itself rather than a promise made in
   three other places: a windowed file's rows are a grid the scrollbar is read
   against, and a wrapped row is not one row tall. */
:root[data-wrap="yes"] :is(.filebody .code:not(.windowed), .dfile .dlines:not(.sides)) .dline {
  display: flex; white-space: pre-wrap; min-width: 0;
}
/* Wrapped, the text is the part that shrinks: the rest of a long line stands
   under the text, not under the line numbers. The same places: the Files
   tab, the one-column diff and an edit shown in the transcript. The
   side-by-side diff always wraps, in its own grid (`.half`). */
:root[data-wrap="yes"] :is(.filebody .code:not(.windowed), .dfile .dlines:not(.sides)) .dline :is(.ln, .sign) {
  flex: none;
}
:root[data-wrap="yes"] :is(.filebody .code:not(.windowed), .dfile .dlines:not(.sides)) .dline .dtext {
  flex: 1; min-width: 0; overflow-wrap: anywhere;
}
.dline { padding: 0 20px 0 0; white-space: pre; min-width: max-content; }
.dline { position: relative; }
/* The line's text is a box of its own, so a tab is measured from where the
   text starts. In one row with the numbers and the sign, a tab ran from the
   start of the row: a line indented by one tab stood one space in, after
   the `+`, and a second tab jumped to where the stops happened to fall. */
.dline .dtext { display: inline-block; vertical-align: top; }
/* One column is a grid of one track, as wide as the widest row: a row is
   `min-width: max-content`, and a block is only as wide as the pane, so
   scrolled sideways a short line's colour stopped at the pane's edge and
   only the long lines went on. Every row is now the track's width. */
.dlines:not(.sides) { display: grid; grid-template-columns: auto; }
.dline.context { color: var(--ink-mute); }
.dline .sign { color: var(--ink-faint); }
.dline.added .sign, .dline.added .ln, .half.added .ln { color: var(--working); }
.dline.removed .sign, .dline.removed .ln, .half.removed .ln { color: var(--hot); }
/* Which words changed, inside a line that did. */
.dline .wd { border-radius: 2px; }
.dline.added .wd, .half.added .wd { background: var(--add-word); }
.dline.removed .wd, .half.removed .wd { background: var(--cut-word); }
/* Two columns: the file as it was on the left, as it is on the right. The
   lines wrap rather than scroll, because two halves cannot share one
   sideways scrollbar and two bars would drift apart. */
.dlines.sides { overflow-x: hidden; }
.dline.pair {
  display: grid; grid-template-columns: 1fr 1fr; padding: 0;
  min-width: 0; white-space: pre-wrap;
}
.half {
  display: grid; grid-template-columns: max-content 1fr; min-width: 0;
  position: relative;
}
.half.was { box-shadow: inset -1px 0 var(--edge); }
.half .ln { min-width: 6ch; padding-right: 8px; text-align: right; margin-right: 8px; }
.half .dtext { min-width: 0; overflow-wrap: anywhere; padding-right: 12px; }
.half.context { color: var(--ink-mute); }
/* Nothing on this side: more came than went, or the other way round. Hatched,
   so it reads as "no line here" and not as a blank line. */
.half.none {
  background: repeating-linear-gradient(135deg, transparent 0 5px,
                                        var(--tint) 5px 7px);
}

/* The review. The `+` sits over the first characters of the gutter and shows
   on hover, the way a pull request does it. `user-select: none` keeps it out
   of a copied diff, like the line numbers beside it.

   Not `.plus`: that is the green "+3" beside a changed file, and this block
   was written on top of it. Every count on the page went invisible — a file
   that had gained lines read as if it had only lost them. */
.addnote {
  position: absolute; left: 2px; top: 0; width: 18px; height: 18px;
  padding: 0; border: none; border-radius: 4px; cursor: pointer;
  background: var(--needs); color: var(--bg); font: inherit; font-size: 12px;
  line-height: 18px; opacity: 0; user-select: none; transition: opacity .1s ease;
}
.dline:hover .addnote, .addnote:focus { opacity: 1; }
.onFile .addnote, .onLine .addnote {
  position: static; opacity: 1; margin: 6px 0 6px 20px; }
/* Sticky, so a comment stays where it can be read when a wide diff is
   scrolled sideways. `pre` is the diff's business, not the note's. */
.onLine, .onFile { position: sticky; left: 0; white-space: normal; max-width: 680px; }
/* A comment is one light line of the reader's own: who wrote it, the note,
   and what can be done to it, side by side. It had a blue bar down its left
   and a box round it, and on the old Review tab a box round that; the reader
   called it ugly, and chose this from pictures. The tint is the reader's
   colour, faint, as their prompts are in the transcript. */
.comment {
  margin: 4px 20px 6px 56px; padding: 7px 10px 7px 12px; border-radius: 6px;
  display: flex; align-items: flex-start; gap: 10px;
  background: color-mix(in srgb, var(--mine) 9%, var(--sheet));
  font-family: var(--sans); font-size: 14px; color: var(--ink);
}
/* The icon is drawn by `putIcon`, which sets no size of its own. */
.comment .icon {
  width: 14px; height: 14px; flex-shrink: 0; margin-top: 3px; fill: none;
  stroke: var(--mine); stroke-width: 1.2; stroke-linejoin: round;
}
.comment .words { flex-grow: 1; min-width: 0; }
/* Not `.note`: that is the page's quiet line in a pane, in the fixed face
   and padded, and a comment's words wore all of it -- the reader's words
   stood in the code's face with 14 px round them. */
.comment .says { white-space: pre-wrap; line-height: 1.5; }
/* What you can do to a comment, at the far end of it. The note is what you
   came to read; the buttons are not, so they are faint until the pointer is
   on the comment. */
.acts { display: flex; gap: 8px; flex-shrink: 0; opacity: .55; }
.comment:hover .acts, .acts:focus-within { opacity: 1; }
/* The send bar of the Review tab: a comment on the whole review, typed, and
   under it the review as the agent gets it after that comment, which cannot
   be edited here -- a comment is edited where it stands. It is the
   transcript's send bar in shape, and it is the only place a review is sent
   from: what goes is in view right beside the button, so it cannot be sent
   unread. */
.reviewbar .saycol {
  flex-grow: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px;
}
/* Short, and then they scroll: the diff is what is read here, and on a
   notebook the two boxes at the send box's 40vh took two fifths of the
   screen from it. Four lines of the comment, five of the message. */
.reviewbar .overall {
  font-family: var(--sans); font-size: 14px; max-height: calc(4 * 18px + 14px);
}
.reviewbar .reviewsay { font-size: 12px; max-height: calc(5 * 18px + 14px); }
/* The comments on the tab's list: who wrote it, the first line of the note,
   and under it the place, in the list's own face. */
.filelist.diff .head.said {
  display: flex; align-items: center; justify-content: space-between;
}
/* Not a row: `.filelist button` makes every button a full-width row. */
.filelist.diff .head.said .link {
  width: auto; margin: 0; padding: 0; border: 0; text-transform: none; letter-spacing: 0;
}
.filelist.diff button.said { flex-wrap: wrap; row-gap: 1px; }
.filelist.diff button.said .icon { stroke: var(--mine); }
.filelist.diff button.said .name { flex: 1 1 0; color: var(--ink); }
.filelist.diff button.said .where {
  flex-basis: 100%; padding-left: 19px; color: var(--ink-faint); font-size: 12px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.badge.notes {
  color: var(--mine); border-color: color-mix(in srgb, var(--mine) 45%, transparent);
  background: color-mix(in srgb, var(--mine) 10%, transparent);
}
.comment .quoted {
  margin-bottom: 6px; padding: 3px 8px; border-radius: 4px;
  background: var(--code); color: var(--ink-faint);
  font-family: var(--mono); font-size: 12px; white-space: pre-wrap;
}
.onFile > .where {
  margin: 6px 20px 0; font-family: var(--mono); font-size: 12px;
  color: var(--ink-mute);
}
.link {
  margin-top: 6px; padding: 0; border: none; background: none; cursor: pointer;
  color: var(--ink-faint); font-family: var(--mono); font-size: 11px;
}
.link:hover { color: var(--needs); }
.commentbox { margin: 6px 20px; max-width: 680px; }
/* The box a comment is written in, under its line. */
.commentbox textarea {
  width: 100%; padding: 9px 12px; border-radius: 6px; resize: vertical;
  border: 1px solid var(--edge-bright); background: var(--raised);
  color: var(--ink); font-family: var(--sans); font-size: 13px; line-height: 1.5;
}
.commentbox textarea:focus {
  outline: none; border-color: var(--needs);
}
.commentbox .buttons {
  display: flex; gap: 12px; align-items: center; margin-top: 6px;
}
/* Under the field, at its right edge — where the eye is after reading back
   what it typed. */
.commentbox .buttons { justify-content: flex-end; }
/* The tint says a line came or went; the text keeps the code's own colours,
   the way delta and a pull request draw it. Green and red text on green and
   red was one signal said twice, and it took the syntax colours away. */
.dline.added, .half.added { background: var(--add-line); }
.dline.removed, .half.removed { background: var(--cut-line); }
/* What happened to a file, in the colour of what happened. Modified is blue
   and not amber: amber on this page means an agent is waiting on you. */
.dfile .what.added, .filelist.diff button.added .icon,
.filelist.diff button.untracked .icon { color: var(--working); }
.dfile .what.deleted, .filelist.diff button.deleted .icon { color: var(--hot); }
.dfile .what.modified, .dfile .what.renamed, .dfile .what.typechange,
.filelist.diff button.modified .icon, .filelist.diff button.renamed .icon,
.filelist.diff button.typechange .icon {
  color: var(--done);
}
.filelist.diff button.deleted .name { text-decoration: line-through; }
/* The Diff tab's tree: a little tighter than a block row, the count at its end. */
.filelist.diff button { padding-top: 4px; padding-bottom: 4px; }
.filelist.diff .counts { margin: 0 0 0 8px; flex-shrink: 0; }
.note {
  padding: 14px 20px; font-family: var(--mono); font-size: 12px;
  line-height: 1.7; color: var(--ink-mute);
}
.note b { color: var(--ink-soft); font-weight: 500; }
.tab .badge {
  padding: 1px 6px; border-radius: 10px; background: var(--chosen);
  color: var(--ink-soft); font-size: 11px;
}

.empty { color: var(--ink-mute); max-width: 52ch; line-height: 1.6; }
.empty code { font-family: var(--mono); background: var(--chosen); padding: 2px 6px;
  border-radius: 4px; color: var(--needs-warm); }
.empty h2 { font-size: 16px; color: var(--ink-bright); margin: 0 0 10px; }

/* Two bars over the whole page, for the two things that stop it working.
   One goes when the stream comes back; the other goes when you reload,
   which is the only thing that fixes it.

   The class that says a bar is wanted is never the class the bar wears.
   `body.lost .lost` reads well and the rule above it, `.lost`, matched the
   body too -- so `classList.add("lost")` gave `body` `display: none` and the
   whole page went blank the moment the stream hiccupped. It came back when
   the stream did, or when the reader pressed F5, which is what made it look
   like a page that had simply stopped working. Nothing named here may be a
   word `body` also wears. */
.lost, .stale {
  display: none; padding: 6px 16px; background: var(--cut-bg);
  color: var(--cut-ink); font-family: var(--mono); font-size: 12px;
  border-bottom: 1px solid var(--edge);
}
body.offline .lost { display: block; }
body.outdated .stale { display: block; }

dialog.help {
  border: 1px solid var(--edge-bright); border-radius: 8px; background: var(--panel);
  color: var(--ink); padding: 18px 22px; font-family: var(--mono); font-size: 13px;
}
dialog.help::backdrop { background: var(--veil); }
dialog.help h2 { margin: 0 0 12px; font-size: 14px; color: var(--ink-bright); }
.sidefoot:empty { display: none; }
.sidefoot {
  flex-shrink: 0; padding: 8px 10px; border-top: 1px solid var(--edge);
}
.verb:disabled { opacity: .5; cursor: default; border-color: var(--edge); }
dialog.help dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; margin: 0; }
dialog.help dt { color: var(--needs); }
dialog.help dd { margin: 0; color: var(--ink-mute); }
</style>
</head>
<body>
<div class="app">
  <div class="lost">connection lost — reconnecting…</div>
  <div class="stale">wostuast was restarted, so this page is out of date and
    nothing it sends will go in. Reload it.</div>
  <div class="body">
    <div class="sidebar">
      <div class="sidebar-head"><a class="brand" href="https://github.com/martinus/wostuast"
        target="_blank" rel="noopener noreferrer" title="wostuast on GitHub">wostuast</a><span
        class="version" title="the day this copy was made, and the start of its SHA-256"
        >__WOSTUAST_VERSION__</span></div>
      <div class="findslot">
        <input class="find" id="pick" type="search" placeholder="filter sessions  f"
               autocomplete="off" spellcheck="false">
      </div>
      <div class="views">
        <button type="button" class="feedlink" id="feedlink"
          title="All unreads: the last answer of every unread session"></button>
        <button type="button" class="feedlink" id="savedlink"
          title="Saved: every answer you kept"></button>
        <button type="button" class="feedlink" id="searchlink"
          title="Search every session: what you typed and what each agent answered"></button>
        <button type="button" class="feedlink" id="cmdlink"
          title="Commands: the skills and commands of every project  ·  4"></button>
      </div>
      <div class="rows" id="rows"></div>
    </div>
    <div class="grip" id="grip"></div>
    <div class="main">
      <div class="tabs" role="tablist">
        <div class="viewtitle" id="viewtitle"></div>
        <button class="tab" role="tab" aria-selected="true" data-tab="transcript"
          title="Transcript  ·  1"><span class="tabkey">1</span>Transcript</button>
        <button class="tab" role="tab" aria-selected="false" data-tab="files"
          title="Files  ·  2"><span class="tabkey">2</span>Files</button>
        <button class="tab" role="tab" aria-selected="false" data-tab="diff"
          title="Review  ·  3"><span class="tabkey">3</span>Review<span
          class="badge" id="diffcount" hidden></span><span
          class="badge notes" id="reviewcount" hidden></span></button>
        <div class="tabfill"></div>
        <div class="findhome" id="findhome">
          <input class="find" id="find" type="search" placeholder="find in transcript  /"
                 autocomplete="off" spellcheck="false">
        </div>
        <div class="ctxslot" id="ctxslot" hidden></div>
        <div class="modelpop" id="modelpop" hidden></div>
        <div class="live" id="live"></div>
        <button type="button" class="theme" id="jump" hidden
                aria-label="jump to its tmux pane"></button>
        <div class="setslot">
          <button type="button" class="theme" id="settings"
                  aria-haspopup="true" aria-expanded="false"></button>
          <div class="setpop" id="setpop" hidden></div>
        </div>
      </div>
      <div class="content" id="content"></div>
      <div class="asking" id="asking" hidden></div>
      <form class="sendbar" id="sendbar" hidden>
        <textarea class="say" id="say" rows="1" autocomplete="off"
                  spellcheck="false"
                  placeholder="type into the terminal  ·  s  ·  shift+enter for a new line"></textarea>
        <div class="sendside">
          <div class="saysize" id="saysize" hidden></div>
          <button class="verb" type="submit">send</button>
        </div>
        <div class="slash" id="slash" role="listbox" hidden></div>
      </form>
      <div class="sendbar resumebar" id="resumebar" hidden></div>
      <form class="sendbar reviewbar" id="reviewbar" hidden>
        <div class="saycol">
          <textarea class="say overall" id="overall" rows="1" autocomplete="off"
                    spellcheck="false"
                    placeholder="a comment on the whole review, sent on top of it"></textarea>
          <textarea class="say reviewsay" id="reviewsay" rows="1" readonly
                    tabindex="-1"></textarea>
        </div>
        <button class="verb" type="submit" id="sendreview">Send</button>
