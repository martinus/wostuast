    </div>
  </div>
</div>

<dialog class="help" id="help">
  <h2>Keys</h2>
  <dl>
    <dt>f</dt><dd>filter the session list</dd>
    <dt>e</dt><dd>rename the chosen session</dd>
    <dt>b</dt><dd>back to the session before, and again to return</dd>
    <dt>z</dt><dd>snooze the session that needs you, or wake it</dd>
    <dt>u</dt><dd>mark the session unread, or read</dd>
    <dt>/</dt><dd>find in the transcript</dd>
    <dt>1 – 3</dt><dd>transcript, files, review</dd>
    <dt>4</dt><dd>commands, of every project</dd>
    <dt>Enter</dt><dd>jump to that agent's tmux pane</dd>
    <dt>s</dt><dd>jump to the send box</dd>
    <dt>c</dt><dd>colours: auto, light, dark</dd>
    <dt>?</dt><dd>this list</dd>
    <dt>Esc</dt><dd>close</dd>
  </dl>
</dialog>

<script>
"use strict";

const state = {
  sessions: [],
  chosen: null,
  // The session chosen before this one, which `b` goes back to (#354). Per
  // browser tab, as the chosen one is -- that one is in the address, this
  // one in the tab's own storage -- so a reload keeps both.
  before: (() => {
    try { return sessionStorage.getItem("wostuast-before") || ""; }
    catch (error) { return ""; }
  })(),
  tab: "transcript",
  find: "",
  pick: "",             // what the sidebar filter box holds
  history: false,       // whether the finished sessions are unfolded
  kidsOpen: new Set(),  // the rows whose ended subagents are unfolded (#422)
  skew: 0,              // server clock minus ours
  // The sessions whose `/clear` this page has seen, followed or not. A
  // session is followed into its new id once, when the link appears; a
  // reader who then goes back to read the old one is not sent on again.
  cleared: new Set(),
  // The turns saved for later (#377): the list when it was last asked for,
  // its keys for the transcript's "saved", and the count the pushes carry.
  saved: [],
  savedKeys: new Set(),
  savedCount: 0,
  // The reader's `settings.json` as this page last heard it: from the page
  // as it was served, then from every `settings` push. See `takeSettings`.
  settings: SETTINGS,
  // The reader's own autolinks, compiled once a change. `linksKey` says
  // which, for the redraw keys: a count stayed the same when a pattern
  // changed, and the rows kept their old links.
  links: [],
  linksKey: "[]",
  // What is wrong with `settings.json`, if anything. It stands in the live
  // slot behind everything else.
  linkTrouble: [],
  // The last thing the daemon refused to do, on the one line the page keeps
  // for saying things. It stays there until something replaces it.
  trouble: "",
  // What the reader has picked for the question on screen: for each question
  // the options picked, as indexes -- one for a single-choice question, any
  // number for a multiple-choice one -- and which ask they belong to. Not in
  // the DOM: a pick made for one question must never be submitted for the next.
  picked: { id: "", at: [] },
  // The asks whose keys went in, by id. Not in `picked`: that is one for the
  // whole page, and a look at another session with a question built it
  // again, so a look back found this question unanswered and submit came
  // back on for keys that had gone in. An id goes when its question does
  // (`forgetAnswered`).
  answered: new Set(),
  // A reason half written for a No, with the dialog it is for (`key`).
  declineWhy: { key: "", text: "" },
  // Where each session was left, by id. The choices only -- see `savePlace`.
  // Not `places`: `state.files.places` is the list of things to go to, and
  // one word for two ideas is how one of them gets shadowed.
  visits: new Map(),
  stream: null,
  // Everything the Files tab holds, and nothing another tab reads. A tab's
  // state arrives and leaves with the tab: the flat bag this came out of meant
  // fifteen more names in one scope every time a tab was added, and nothing
  // said which tab owned any of them. See `blankFiles`.
  files: null,          // set below, because it is built in one place
  turns: null,          // the Transcript tab's own; see `blankTurns`
  diffs: null,          // the Diff tab's own; see `blankDiff`
  diff: null,           // the daemon's last answer for it
  sides: "unified",     // one column or two; see `takeSides`
  // The files a comment is on that the diff does not show, read for their
  // lines: path to the daemon's answer, or `asking` while it is out.
  reviewFiles: new Map(),
  // The review being written. It lives in this browser and nowhere else
  // until it is sent. See `blankReview`.
  review: null,         // set below, because it is built in one place
  writing: null,        // the anchor of the comment box that is open, if any
  pruned: false,        // whether the stored reviews have been swept once
  // Every worktree's file names, by its top: a session in the same worktree,
  // or the same session again, asks with the tag held and is answered
  // without them. See `keepListing`.
  listings: new Map(),
  poll: 0,
  transcriptRetry: 0,   // the one timer asking again for a transcript that failed
};

state.files = blankFiles();
state.commands = blankCommands();
state.turns = blankTurns();
state.diffs = blankDiff();
state.review = blankReview();

const $ = (id) => document.getElementById(id);

// --- asking the daemon to do something --------------------------------------

// Everything else on this page reads. These two write, into a live terminal,
// so the daemon wants proof the request came from a page it served: a token it
// made at start and printed here. Any site can POST to a loopback port, but a
// header of its own is not something a cross-origin request may add without
// asking first, and the daemon never says yes.
const TOKEN = "__WOSTUAST_TOKEN__";

// Where one session's routes live. Three callers: the two that fetch, and
// `putMedia`, which wants an address for a `src` rather than an answer.
function apiUrl(id, what, query) {
  return "/api/session/" + encodeURIComponent(id) + "/" + what + (query || "");
}

async function tell(id, verb, body) {
  return post(apiUrl(id, verb), body);
}

async function post(where, body) {
  try {
    const answer = await fetch(where, {
      method: "POST",
      headers: { "Content-Type": "application/json",
                 "X-Wostuast-Token": TOKEN },
      body: JSON.stringify(body || {}),
    });
    return await answer.json();
  } catch (error) {
    return { error: "the daemon did not answer" };   // it went away; say so
  }
}

// What came back, on the one line the page keeps for saying things.
// Naming a session. Claude Code names one from its first prompt and
// `/rename` changes that, but the name it hands the status line is the one the
// session started with — so a rename in the terminal does not reach this page
// until the session is started again. A name set here is ours and wins.
async function keepRename(box, id) {
  const asked = box.value;
  box.blur();
  const answer = await tell(id, "name", { name: asked });
  if (answer && answer.error) { said(answer); return; }
  // Claude Code was not told (#351): the name is this page's alone, until
  // Claude Code's changes. The reader asked for one name in both places, so
  // the page says why there are two.
  if (answer && answer.name && answer.kept_here) {
    note("renamed on this page only: " + answer.kept_here);
  }
  // The rows are rebuilt from the names on the daemon's next pass, which is a
  // second away. This is so the header does not sit on the old one until then.
  const s = state.sessions.find((one) => one.id === id);
  if (s) {
    s.name = (answer && answer.name) || "";
    s.mine = Boolean(s.name);
    s.label = s.name ? s.name + " \u00b7 " + s.place : s.place;
  }
  drawHeader();
  drawSessions();
}

// --- the context bar and the live slot --------------------------------------

// Whether the status line has told us how full the window is. It is the one
// number here that only the status line carries, so a session whose status
// line is not registered has none and nothing about it is drawn.
function hasContext(s) {
  return !!s && s.context_pct !== null && s.context_pct !== undefined;
}

// The bar, not a number: how full a context window is reads at a glance and
// does not at a count.
function putContext(parent, percent) {
  const pct = Math.round(percent);
  const ctx = put(parent, "span",
                  "ctx" + (pct >= 85 ? " hot" : pct >= 60 ? " warm" : ""));
  const bar = put(ctx, "span", "bar");
  put(bar, "span", "fill").style.width = Math.max(2, Math.min(100, pct)) + "%";
  put(ctx, "span", null, pct + "% ctx");
  return ctx;
}

// What the daemon answered, on the one line the page keeps for saying
// things. A failure stays.
//
// It used to fade after four seconds, like everything else on this strip,
// and it is not like everything else: it is about a thing you tried and did
// not get. A reader whose page had gone stale saw "that did not come from
// this page" flash while they were looking at the terminal, and then a strip
// reading "live" over a page where nothing worked. It stays until the next
// message replaces it, or until something works.
function said(answer) {
  // A page from an earlier `serve` cannot do anything at all, and no strip
  // this small can carry that. The bar says it, and only a reload clears it.
  if (answer && answer.stale) document.body.classList.add("outdated");
  // Kept, not painted and forgotten: the stream writes "live" into this slot
  // on every push, which is about once a second while an agent works, so a
  // failure written straight in was wiped within a second. The thing the
  // reader most needed to read was the thing that lasted least. An answer
  // that worked clears it, which is the other half of "until something
  // replaces it".
  state.trouble = (answer && answer.error) || "";
  paintLive();
}

// The one line the page keeps for saying things, and the four things that
// want it: what the stream is doing, something you asked for and did not
// get, a `settings.json` that cannot be used, and a passing word that borrows
// the slot over all three.
//
// The file's trouble stands last, and in a few words, with the whole of it
// on a hover: nothing the reader does on the page mends it, so an answer
// that works must not clear it the way it clears `state.trouble`, and the
// daemon's sentence about bad JSON runs to 150 characters on a line that
// does not wrap.
//
// One painter, because four writers raced for it.
//
// A stream that is working says nothing. The slot read "live" on every page
// all day, which is the one thing a reader never needs told -- they can see
// the page moving -- and a word that is always there is a word nobody reads,
// so "reconnecting" in the same place went unseen too. `state.live` still
// holds "live"; it is only not painted.
function paintLive(borrowed) {
  const stream = state.live === "live" ? "" : state.live;
  const links = state.linkTrouble.length
    ? "settings.json has a problem · wostuast doctor" : "";
  const slot = $("live");
  slot.textContent = borrowed || state.trouble || stream || links;
  slot.title = links && slot.textContent === links
    ? state.linkTrouble.join("\n") : "";
}

// Our own word about what just happened -- "review sent", "pressed 2, 1".
// News, so it goes stale, so it fades; nothing was asked for and refused.
function note(text) {
  paintLive(text);
  setTimeout(() => {
    // Only when the slot still holds this line. Assigning unconditionally
    // would wipe whatever the stream has put there since.
    if ($("live").textContent === text) paintLive();
  }, 4000);
}

// --- dragging a column edge -------------------------------------------------

// Paths are long, screens differ, and the alternative to a handle is a config
// option, which this program prefers to delete. The width goes into a CSS
// variable rather than onto the element, so a column that is rebuilt keeps it,
// and into this browser's storage, so a reload does too.

// What this browser keeps for the page: "" when nothing is held, or when
// storage cannot be read -- a private window refuses it -- and never a throw.
// Each caller wrote its own `try` before (#298).
function stored(key) {
  try { return localStorage.getItem(key) || ""; } catch (error) { return ""; }
}

// Keep a value, or forget the key for an empty one. A refusal, a private
// window or the quota, changes nothing the reader can see, so it is dropped.
function store(key, value) {
  try {
    if (value) localStorage.setItem(key, value);
    else localStorage.removeItem(key);
  } catch (error) { }
}

function rememberWidth(name, px) {
  const root = document.documentElement;
  if (px) root.style.setProperty(name, px + "px");
  else root.style.removeProperty(name);
  store("wostuast" + name, px ? String(px) : "");   // a private window: the drag still works
}

function dragWidth(grip, name, least, most) {
  grip.title = "drag to resize, double-click to reset";
  // Each handle brings its own width back, so a third one is one call and
  // not two. The file column's is built when its tab first opens, which is
  // when it is wanted.
  const saved = stored("wostuast" + name);
  if (saved) rememberWidth(name, Number(saved));
  let from = 0;
  let was = 0;
  const move = (at) => {
    rememberWidth(name,
                  Math.min(most, Math.max(least, was + at.clientX - from)));
  };
  // A drag ends on every way a press can end, not on `pointerup` alone. A
  // right-click opens the context menu on Linux and macOS, and the menu took
  // the `pointerup`: the column then followed the mouse with no button held
  // until the next click. A touch the browser takes for a scroll ends in
  // `pointercancel`. So only the main button starts a drag, the grip
  // captures the pointer, and losing the capture ends it too.
  const ends = ["pointerup", "pointercancel", "lostpointercapture"];
  const stop = () => {
    document.body.classList.remove("dragging");
    grip.classList.remove("dragging");
    window.removeEventListener("pointermove", move);
    for (const end of ends) window.removeEventListener(end, stop);
  };
  grip.addEventListener("pointerdown", (at) => {
    if (at.button !== 0) return;
    from = at.clientX;
    was = grip.previousElementSibling.getBoundingClientRect().width;
    document.body.classList.add("dragging");
    grip.classList.add("dragging");
    window.addEventListener("pointermove", move);
    for (const end of ends) window.addEventListener(end, stop);
    try {
      grip.setPointerCapture(at.pointerId);
    } catch (error) {
      // A pointer that is already gone. `pointerup` still ends the drag.
    }
    at.preventDefault();          // no text selection while dragging
  });
  grip.addEventListener("dblclick", () => rememberWidth(name, 0));
  return grip;
}

// --- the two scripts that come from the web --------------------------------

// Nothing else is fetched at runtime. Both are pinned: `integrity` is the hash
// of the exact bytes and `crossorigin` is what lets the browser check it. Any
// script on this page can POST to /send, which types into the user's terminal,
// so a script from someone else's server without a hash would be a way into
// it. A CDN that has been tampered with gets you the plain fallback, never
// other code.
//
// `marked` v12.0.2 renders the transcript. MIT, Christopher Jeffrey.
// https://github.com/markedjs/marked
const MARKED_SRC =
  "https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js";
const MARKED_HASH =
  "sha384-/TQbtLCAerC3jgaim+N78RZSDYV7ryeoBCVqTuzRrFec2akfBkHS7ACQ3PQhvMVi";
// `highlight.js` v11.9.0 paints code. BSD-3-Clause, Ivan Sagalaev.
const HLJS_SRC =
  "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js";
const HLJS_HASH =
  "sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp";

function fetchScript(src, hash) {
  return new Promise((settle) => {
    const tag = document.createElement("script");
    tag.src = src;
    tag.integrity = hash;
    tag.crossOrigin = "anonymous";
    // Offline, blocked, or bytes that do not match the hash all land here.
    tag.addEventListener("error", () => settle(false));
    tag.addEventListener("load", () => settle(true));
    document.head.appendChild(tag);
  });
}

// --- the reader's settings ---------------------------------------------------
//
// Everything the settings menu sets, and the ticket links, are one file of
// the reader's, `settings.json`, which the daemon reads and writes. It was
// this browser's `localStorage`, and the reader asked for a file instead:
// one place, the same in every browser, and one they can read. A choice is
// made on this page at once and then sent; every page, this one too, then
// hears of it from the `settings` push and `takeSettings` applies it.

function setting(key) {
  return state.settings[key];
}

// Send one change. It is shown already, and the push that follows makes it
// so on every page. The answer carries no settings, only whether it worked
// and which links were refused: the settings come by the push alone, one
// line in the order the file was written. An answer on its own connection
// landed before an older push, and that push put the page back.
// One change at a time, each after the last has been answered. Two quick
// clicks sent two POSTs on two connections, and the first could land after
// the second: `settings.json` kept the older choice, the push then put it
// back on the page, and `test_the_two_switches_are_remembered_apart` went
// red under load.
let settingsSent = Promise.resolve();

async function keepSetting(change) {
  state.settings = { ...state.settings, ...change };
  const answer = settingsSent.then(() => post("/api/settings", change));
  settingsSent = answer.catch(() => null);
  said(await answer);
  return answer;
}

// Make the page what the file says. `first` is the page starting: nothing is
// drawn yet, so nothing is drawn again.
function takeSettings(body, first) {
  state.settings = body;
  const colours = setting("colours");
  showTheme(colours === "light" || colours === "dark" ? colours : "system");
  applyReading(readingWanted());
  takeSides(!first);
  takeLinks(!first);
  drawBell();
  paintSettings();
}

