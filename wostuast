def state_dir() -> Path:
    """Where wostuast keeps its files. WOSTUAST_STATE overrides it, for tests."""
    override = os.environ.get("WOSTUAST_STATE")
    if override:
        return Path(override)
    base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
    return Path(base) / "wostuast"


def state_dir_trouble() -> str:
    """Why the state directory cannot be written, or "" when it can.

    It makes the directory private on the way, the one way every command
    does. `doctor` made it with `mkdir` alone once, so on a new machine it
    stood at the umask, 0755, holding every prompt, until a hook ran.
    """
    directory = state_dir()
    private_dir(directory)
    probe = directory / ".probe"
    try:
        probe.write_text("", encoding="utf-8")
        probe.unlink()
    except OSError as error:
        return str(error)
    return ""


def private_dir(path: Path) -> None:
    """Make the directory, and keep it to this user alone.

    The event log holds every prompt, every command an agent ran and every
    result it saw. On a shared machine the default 0o755 would let anyone read
    it. `mode=` applies only when the directory is created, so an existing one
    is corrected too.
    """
    try:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        path.chmod(0o700)
    except OSError:
        pass


def open_private(path: Path) -> Any:
    """Open a file for appending, and create it 0600 if it is not there.

    `open(path, "a")` creates at 0o666 & ~umask — 0644 under the usual one —
    and a `chmod` afterwards leaves a window in which the file is already on
    disk, already holding a prompt, and readable by anyone on the machine.
    That window does not close if the process dies inside it. The mode belongs
    at creation, which is what the `os.open` flags are for.
    """
    return os.fdopen(
        os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600),
        "a", encoding="utf-8")


def events_path() -> Path:
    return state_dir() / "events.jsonl"


#: An archive of the event log. The number counts up from 1, so the oldest
#: has the lowest, and an `events.1.jsonl` from before archives were kept is
#: simply the first of them.
ARCHIVE_NAME = re.compile(r"\Aevents\.(\d+)\.jsonl\Z")


def archived_events_paths() -> list[Path] | None:
    """Every archive of the event log, oldest first, or None if the folder
    could not be listed.

    By number and not by name: as text, `events.10` sorts before `events.9`,
    and the tenth archive is where history would have started coming back in
    the wrong order.

    **A listing that failed is not an empty one.** It returned `[]` for any
    error, and a daemon short of descriptors (EMFILE) then read the live
    file as if no archive were waiting: the newest archive, just rotated,
    came on the next pass from its top, after the newer events -- a
    permission dialog already answered came back amber, with a No button on
    it. No folder yet is no archives. The hook's deadline is not a failed
    listing: it goes on out, so the hook stops as the deadline says.
    """
    folder = state_dir()
    try:
        names = os.listdir(folder)
    except FileNotFoundError:
        return []
    except TimeoutError:
        raise
    except OSError:
        return None
    numbered = sorted((int(found.group(1)), name) for name in names
                      if (found := ARCHIVE_NAME.match(name)))
    return [folder / name for _, name in numbered]


def file_key(info: os.stat_result) -> tuple[int, int]:
    """Which file this is, whatever it is called: its device and inode."""
    return (info.st_dev, info.st_ino)


def archive_number(path: Path) -> int:
    found = ARCHIVE_NAME.match(path.name)
    return int(found.group(1)) if found else 0


