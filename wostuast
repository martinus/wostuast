# --- log: a plain text log, so a broken hook leaves a trace ------------------


def log(message: str) -> None:
    """Append one line to the log file. Never raise."""
    try:
        path = log_path()
        private_dir(path.parent)
        rotate(path, LOG_MAX_BYTES, path.with_name(path.name + ".1"))
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        with open_private(path) as handle:
            handle.write(f"{stamp} {message}\n")
    except Exception:
        pass


def write_atomic(path: Path, text: str, private: bool = False,
                 mode: int | None = None, sync: bool = False) -> None:
    """Write the whole file or none of it, so a reader never sees half a file.

    The temporary name carries this process's pid and the writing thread. A
    fixed name would be shared by two writers, and one could rename the
    other's half-written file into place — or unlink it from under the other,
    which is how a `POST /name` beside another one raised `FileNotFoundError`
    into a browser's request. The status line runs on every redraw, so two
    processes is normal, and the daemon answers every browser in a thread of
    its own.

    `mode` keeps a file's own permissions: a new file takes the umask, which
    for `settings.json` meant 0600 came back 0644. **The temporary is made
    0600 and widened after**, never made at the umask and narrowed after:
    written first and chmodded second, it stood at 0644 holding the whole of
    `settings.json`, API keys and all, in a directory that is not private --
    and stayed that way if the process died in between. `open_private` is
    the same rule for an append. `sync` puts the bytes and
    then the rename on the disk, which costs a wait — the status line writes on
    every redraw, so it is asked for rather than given.
    """
    if private:
        private_dir(path.parent)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    import threading

    temporary = path.with_name(
        f"{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    try:
        # A stale temporary of this name, left by a writer that died, keeps
        # its own mode through `O_TRUNC`; gone first, the mode below holds.
        temporary.unlink(missing_ok=True)
        narrow = private or mode is not None
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                               0o600 if narrow else 0o666),
                       "w", encoding="utf-8") as handle:
            handle.write(text)
        if narrow:
            # Exact, whatever the umask took away at creation.
            temporary.chmod(0o600 if private else mode)
        if sync:
            with open(temporary, "rb") as handle:
                os.fsync(handle.fileno())
        temporary.replace(path)
        if sync:
            # The rename is on the disk only once the directory is. Without
            # this, a power loss right here can leave the file empty — and
            # `settings.json` is the one file Claude Code will not start
            # without. Not every filesystem allows the open; the write has
            # landed either way, so a refusal is not an error.
            try:
                folder = os.open(path.parent, os.O_RDONLY)
            except OSError:
                return
            try:
                os.fsync(folder)
            except OSError:
                pass
            finally:
                os.close(folder)
    finally:
        try:
            temporary.unlink()
        except OSError:
            pass


def rotate(path: Path, limit: int, backup: Path) -> None:
    """Move the file aside when it grows past the limit. Never raise."""
    try:
        if path.exists() and path.stat().st_size > limit:
            path.replace(backup)
    except OSError:
        pass


# --- event log: append only, one JSON object per line ------------------------


def still_the_file(handle: Any, target: Path) -> bool:
    """Is the handle we are holding still the file at that name?

    A `flock` is on an inode, not on a name. Between opening a file and
    getting its lock, another process can rename it away — and then the lock
    we were waiting for is a lock on something that is no longer the log.
    """
    try:
        ours = os.fstat(handle.fileno())
        there = os.stat(target)
    except OSError:
        return False
    return (ours.st_dev, ours.st_ino) == (there.st_dev, there.st_ino)


def append_event(record: dict[str, Any]) -> None:
    """Append one event. The caller has already added ts, pane and pid.

    Two hooks can reach the size limit at the same moment, and the lock alone
    does not order them: it is taken on the inode, so a hook that opened the
    log before another rotated it holds the *archive*, sees a file over the
    limit, and renames the fresh log on top of the archive — every event ever
    recorded, gone. Measured, before `still_the_file` was here to stop it. A
    hook that finds it is holding the wrong inode simply opens again.

    Surrogates are replaced rather than raising. `json.dumps` emits a lone
    surrogate happily and a UTF-8 encoder refuses it, so one in a tool response
    lost the whole event — and a `SessionStart` lost that way costs the session
    its cwd, pane and pid for good. (Naming the escape here in the usual way
    would put a real lone surrogate in this docstring, and Python 3.13 cannot
    write that into a bytecode cache. It broke CI on 3.13 alone.)
    """
    target = events_path()
    private_dir(target.parent)
    raw = json.dumps(record, ensure_ascii=False, default=str) + "\n"
    line = raw.encode("utf-8", "replace").decode("utf-8")
    for _ in range(3):        # a rotation under us; the next open finds it
        with open_private(target) as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            if not still_the_file(handle, target):
                continue      # someone rotated while we waited; open the new one
            if os.fstat(handle.fileno()).st_size > EVENTS_MAX_BYTES:
                archive_log(target)
                # The handle still points at the file we just renamed. Open the
                # fresh one, so this event lands there rather than in the
                # archive. It is created 0600, like every file we make.
                with open_private(target) as fresh:
                    fcntl.flock(fresh.fileno(), fcntl.LOCK_EX)
                    fresh.write(line)
                return
            handle.write(line)
            handle.flush()
            return


def archive_log(target: Path) -> None:
    """Move the live log to the next archive number, and never over one.

    The caller holds the log's lock, which is what keeps two hooks from
    archiving the same file. The name is still worked out from a listing and
    then used, and `os.replace` would silently put the log on top of anything
    that landed on that name in between -- the scar `still_the_file` was
    written for, when a rename over the one archive lost every event ever
    recorded. `os.link` refuses a name that is taken, so a taken name costs
    one more try and nothing else. A filesystem with no hard links is left
    to `os.replace` on a name that was free when it was listed.
    """
    archives = archived_events_paths()
    number = archive_number(archives[-1]) + 1 if archives else 1
    for _ in range(1000):
        archive = target.with_name(f"events.{number}.jsonl")
        try:
            os.link(target, archive)
        except FileExistsError:
            number += 1
            continue
        except OSError:
            if archive.exists():
                number += 1
                continue
            os.replace(target, archive)
            return
        os.unlink(target)
        return


def count_events() -> int:
    """How many lines the log holds. It counts newlines, it does not parse."""
    total = 0
    for path in event_files():
        try:
            with open(path, "rb") as handle:
                total += sum(chunk.count(b"\n") for chunk in iter(lambda: handle.read(1 << 20), b""))
        except OSError:
            continue
    return total


def read_events() -> Iterator[dict[str, Any]]:
    """Read the whole log from the start, oldest file first.

    The archives come first because they hold the older events. Reading only
    the current file would lose the SessionStart of every session that began
    before the last rotation, and with it their cwd, pane and pid.
    """
    for path in event_files():
        yield from read_event_file(path)


def json_objects(lines: Iterable[bytes]) -> Iterator[dict[str, Any]]:
    """Turn lines into the JSON objects among them, and skip the rest.

    `json.loads` takes bytes and decodes them itself, in C, which is quicker
    than decoding the file first. Broken UTF-8 raises UnicodeDecodeError, and
    that is a ValueError, so one clause covers a torn line and a bad byte
    alike. Every reader of a JSON-lines file goes through here.
    """
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            yield record


def read_event_file(target: Path) -> Iterator[dict[str, Any]]:
    """Read one log file from the start. A missing file is empty.

    It streams the file line by line: this one is used on a whole log, and
    only needs a line at a time.
    """
    if not target.exists():
        return
    with open(target, "rb") as handle:
        yield from json_objects(handle)


# --- following files: read what is new, keep a half-written last line --------


@dataclass
class Tail:
    """Reads the new lines of a file that grows, and nothing twice.

    It remembers how far it has read and holds back a last line that has no
    newline yet, because a writer can be caught mid-line. It also remembers
    which file it was reading, by device and inode, so a file replaced under
    the same name starts again from the beginning instead of seeking past the
    end of a smaller one and going quiet for ever.
    """

    path: Path
    offset: int = 0
    partial: bytes = b""
    key: tuple[int, int] = (0, 0)
    #: True when the last read started over rather than carried on. A caller
    #: that accumulates what it reads has to hear about that: the event log
    #: does not care, because `Store.apply` drops an event it has seen, but a
    #: transcript reader that only appends will draw the whole file twice.
    restarted: bool = False
    #: Every byte this tail has read, restarts included. It is what the start
    #: of `serve` reports, and a file read twice was parsed twice.
    consumed: int = 0

    def read_new(self) -> list[bytes]:
        """Every new line, as one list, for a caller that keeps them anyway."""
        return list(self.lines())

    def lines(self) -> Iterator[bytes]:
        """Every new line, read `TAIL_CHUNK` at a time.

        A piece holding no newline gives no line, and that is not the end:
        a line longer than a piece is carried in `partial` until one ends it.
        The end is the size the file had when this started, so a file that
        grows while it is read cannot keep the reader here -- what arrives
        later is the next call's. The file is asked about through the handle
        it is read from, so a file renamed between the two is never read
        with the other one's offset.
        """
        self.restarted = False
        try:
            handle = open(self.path, "rb")
        except OSError:
            return
        with handle:
            try:
                info = os.fstat(handle.fileno())
            except OSError:
                return
            key = (info.st_dev, info.st_ino)
            if key != self.key:
                started = self.key != (0, 0)     # not the first look at this name
                self.key, self.offset, self.partial = key, 0, b""
                self.restarted = started
            elif info.st_size < self.offset:  # rewritten shorter, under the same name
                self.offset, self.partial = 0, b""
                self.restarted = True
            end = info.st_size
            handle.seek(self.offset)
            while self.offset < end:
                try:
                    data = handle.read(min(TAIL_CHUNK, end - self.offset))
                except OSError:
                    return
                if not data:
                    return
                self.offset += len(data)
                self.consumed += len(data)
                head, newline, rest = (self.partial + data).rpartition(b"\n")
                self.partial = rest
                if newline:
                    for line in head.split(b"\n"):
                        if line.strip():
                            yield line


class EventFollower:
    """Follows the event log: every archive, then the live file.

    The hook rotates the log, not the daemon, so the live file can become an
    archive under the follower at any moment, and a daemon can start after
    any number of rotations. Each pass lists the archives -- one `listdir` --
    and reads the ones it has not finished, oldest first, then the live file.

    An archive is never written again once it has its name, so one read to
    its end is the last. The live file that has just become an archive is
    recognised by its inode and its tail is handed over with its place in
    it: a tail that only knew names read all 20 MB again on every rotation.
    When the rotation lands in the middle of a pass the hand-over is missed
    and the archive is read from the top; `Store.apply` ignores an event
    older than its session has seen, so a repeat is safe, and a loss is not.
    """

    def __init__(self) -> None:
        self.live = Tail(events_path())
        self.archives: dict[Path, Tail] = {}
        self.finished: set[Path] = set()
        #: What has been read, for the start of `serve` to say: the events,
        #: and the bytes of every archive already finished with.
        self.events = 0
        self.finished_bytes = 0

    def archive_tail(self, path: Path) -> Tail:
        """The tail for an archive: the live one, if this is the live file."""
        try:
            info = path.stat()
        except OSError:
            return Tail(path)
        if (info.st_dev, info.st_ino) == self.live.key:
            handed, self.live = self.live, Tail(events_path())
            handed.path = path
            return handed
        return Tail(path)

    def new_lines(self) -> Iterator[bytes]:
        for path in archived_events_paths():
            if path in self.finished:
                continue
            tail = self.archives.get(path)
            if tail is None:
                tail = self.archives[path] = self.archive_tail(path)
            yield from tail.lines()
            # Read to its end, and nothing will be added to it: the tail is
            # done with, and only how much it read is kept.
            self.finished.add(path)
            del self.archives[path]
            self.finished_bytes += tail.consumed
        yield from self.live.lines()

    def new_events(self) -> Iterator[dict[str, Any]]:
        for event in json_objects(self.new_lines()):
            self.events += 1
            yield event

    def files_read(self) -> tuple[int, int]:
        """How many files have been read from, and how many bytes."""
        size = (self.finished_bytes + self.live.consumed
                + sum(tail.consumed for tail in self.archives.values()))
        count = (len(self.finished) + len(self.archives)
                 + (1 if self.live.consumed else 0))
        return count, size


