// A button whose icon says what it does now: drawn again only when that
// changed, because a row is filled on every push.
function setIcon(button, kind) {
  if (!fresh(button, "icon", kind)) return;
  button.replaceChildren();
  putIcon(button, kind);
}

function putIcon(parent, kind) {
  const where = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(where, "svg");
  svg.setAttribute("class", "icon");
  svg.setAttribute("viewBox", "0 0 14 14");
  svg.setAttribute("aria-hidden", "true");
  const path = document.createElementNS(where, "path");
  path.setAttribute("d", ICONS[kind]);
  svg.appendChild(path);   // how it is drawn is CSS, on `.filelist .icon`
  parent.appendChild(svg);
  return svg;
}

// An Enter that ends an IME composition -- the key that picks the word in
// Japanese or Chinese -- is the input method's, not the reader's. Chromium
// says so in `isComposing`; Safari sends that Enter after the composition
// has ended, and says so only in the old `keyCode` 229. Taken as the
// reader's, it kept half a name, or sent half a message into a terminal.
function composing(press) {
  return press.isComposing || press.keyCode === 229;
}

// Ctrl+Enter (Cmd+Enter on a Mac) in a box presses its button, in every box
// that sends or keeps something, so the one key works wherever the reader
// is typing. It presses the button and nothing else, so whatever the button
// checks first is checked -- and a disabled button ignores `click()`, as a
// press on it does. `button` may be a function, for a box whose button is
// built after it.
function submitOnCtrlEnter(box, button) {
  box.addEventListener("keydown", (press) => {
    if (press.key !== "Enter" || !(press.ctrlKey || press.metaKey)) return;
    press.preventDefault();
    const target = typeof button === "function" ? button() : button;
    if (target) target.click();
  });
}

// Everything below comes from an agent. It is never trusted as HTML.
function put(parent, tag, cls, text) {
  const node = document.createElement(tag);
  // Never a submit: the send bar and the review bar are forms, and a button
  // inside one submits it unless it says otherwise. Every button made here
  // said so in a line of its own, 25 times (#298).
  if (tag === "button") node.type = "button";
  if (cls) node.className = cls;
  if (text !== undefined && text !== null) node.textContent = String(text);
  parent.appendChild(node);
  return node;
}

// A short age: `40s`, `4min`, `2h 15min`, `2d 6h`. Two units once the first
// one is coarse -- `2d` covers anything from two days to just short of three,
// which is not an answer to "when did this last do something". The second is
// left off when it is nought, so `2d` still means exactly two days.
function ago(when) {
  const seconds = Math.floor(Math.max(0, (Date.now() / 1000 + state.skew) - when));
  const two = (big, bigUnit, small, smallUnit) =>
    small ? big + bigUnit + " " + small + smallUnit : big + bigUnit;
  if (seconds < 60) return seconds + "s";
  if (seconds < 3600) return Math.floor(seconds / 60) + "min";
  if (seconds < 86400) {
    return two(Math.floor(seconds / 3600), "h",
               Math.floor(seconds % 3600 / 60), "min");
  }
  return two(Math.floor(seconds / 86400), "d",
             Math.floor(seconds % 86400 / 3600), "h");
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function clock(when) {
  if (!when) return "";
  const at = new Date(when * 1000);
  return String(at.getHours()).padStart(2, "0") + ":" +
         String(at.getMinutes()).padStart(2, "0");
}

// The day a moment fell on -- `21 Sep` -- or nothing at all when it is today.
// A transcript read the next morning is a column of bare times, and "15:48"
// is then a lie by omission. The day the daemon thinks it is, not the one
// this browser does: `state.skew` is the difference, and it is what every
// other age on this page is measured against.
function dayOf(when) {
  if (!when) return "";
  const at = new Date(when * 1000);
  const now = new Date((Date.now() / 1000 + state.skew) * 1000);
  if (at.toDateString() === now.toDateString()) return "";
  return at.getDate() + " " + MONTHS[at.getMonth()];
}

// --- the sidebar ------------------------------------------------------------

// A session nobody can talk to any more. The daemon sorts these to the end;
// the page folds them away under "history".
function isGone(s) {
  return s.state === "ended" || s.state === "dead";
}

// Why nothing can be typed into this session, or "" when something can: the
// daemon's own test (`cannot_type`, after `in_tmux`), from the row, so a
// control is off where the daemon would refuse it. Five controls each built
// a part of it: the review's send was offered into a session that was over,
// and an answer into an open dialog, and the daemon refused both (#287).
// `no` is a No, which is meant for the dialog. What is on its way already
// (`sending`) is each control's own, because a No's own press is not a wait.
function whyNotTyped(s, no) {
  if (!s || !s.pane) return "this session is not in tmux, so nothing can be pressed";
  if (isGone(s)) return "this session is over";
  if (!no && s.permission) {
    return "a permission dialog is open in the terminal: answer it there first";
  }
  return "";
}

// The four groups the list is drawn in, most urgent first, and what each one
// is called above its rows.
//
// This means a row moves when a session changes state, which an older rule
// here forbade — sorting by state made the list churn for nothing. It is not
// for nothing now: a row arriving under "needs you" is the one thing this
// tool exists to tell you, and it only happens when a turn ends, begins, or
// stops on a question. Inside a group the daemon's order stands, which is by
// worktree, so nothing shuffles while a session works.
//
// Working sits above ready, and that is the order a reader asked for: an
// agent still going is something you may want to look in on, and one waiting
// at its prompt is something you have already finished with. Ready used to be
// second, on the reading that a session wanting a prompt is nearer to wanting
// you -- it is not, because nothing about it is waiting.
const BANDS = [
  ["needs", "needs you", needsYou],
  ["working", "working", (s) => s.state === "working"],
  ["ready", "ready", (s) => s.state === "done"],
  ["history", "history", isGone],
];

// Whether a session needs you now: it waits, and the reader has not snoozed
// it (#355). Every answer to "who needs me" asks this one -- the group, the
// tab's title and icon, the alerts -- or a snoozed session would still shout
// from one of them.
function needsYou(s) {
  // A reminder that has come counts, whatever the session does; one that
  // has not come yet puts a waiting session aside, as a snooze does (#375).
  return reminderDue(s)
    || (s.state === "needs_you" && !s.snoozed && !reminderSet(s));
}

// --- reminders ----------------------------------------------------------------

// The daemon keeps the moment; the page decides when it has come, by the
// daemon's clock (`skew`), because a row must not change by itself (#375).
function serverNow() {
  return Date.now() / 1000 + state.skew;
}

function reminderDue(s) {
  return !!s.remind_at && s.remind_at <= serverNow();
}

function reminderSet(s) {
  return !!s.remind_at && s.remind_at > serverNow();
}

// What a reminder says on its row. One that has come says so in the word
// beside the name; one still to come says when in place of the age, which
// says little about a row put aside -- in the word, "until 20:23" took the
// room of the name.
function reminderWord(s) {
  return reminderDue(s) ? "reminder" : "";
}

// The time, after a clock that says it is a reminder (#394).
function reminderAt(s) {
  const day = dayOf(s.remind_at);
  return (day ? day + " " : "") + clock(s.remind_at);
}

// The choices, as Slack offers them, in whole words (#394, #406): a
// number of seconds from now, or a morning. "Custom..." comes after them.
const REMIND_IN = [["In 30 minutes", 30 * 60], ["In 1 hour", 3600],
                   ["In 3 hours", 3 * 3600], ["Tomorrow at 08:00", "tomorrow"],
                   ["Monday at 08:00", "monday"]];
// How far ahead a custom day may be. The daemon takes 31 days
// (`REMIND_MOST`), so the last evening of the 30th fits.
const REMIND_DAYS = 30;

function remindMoment(choice) {
  if (typeof choice === "number") return serverNow() + choice;
  const at = new Date(serverNow() * 1000);
  // Tomorrow, or the next Monday that is not today: on a Monday, "Monday"
  // is next week's, as Slack's "next week" is.
  at.setDate(at.getDate() + (choice === "tomorrow" ? 1 : (8 - at.getDay()) % 7 || 7));
  at.setHours(8, 0, 0, 0);
  return at.getTime() / 1000;
}

// A day as the reader reads it on this page: "Today", "Tomorrow", then
// "Wed 7 Oct" -- `dayOf`'s words, with the weekday a reminder needs.
const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

function dayName(at, ahead) {
  if (ahead < 2) return ahead ? "Tomorrow" : "Today";
  return WEEKDAYS[at.getDay()] + " " + at.getDate() + " " + MONTHS[at.getMonth()];
}

// A time as the reader types it, on a 24-hour clock: "22:10", "2210",
// "9:05", "9". [hour, minute], or null for anything else.
function readTime(text) {
  const found = /^\s*(\d{1,2})(?:[:.h]?(\d{2}))?\s*$/.exec(text);
  if (!found) return null;
  const hour = Number(found[1]);
  const minute = Number(found[2] || 0);
  return hour < 24 && minute < 60 ? [hour, minute] : null;
}

async function setReminder(id, at) {
  const answer = await tell(id, "remind", { at });
  if (!answer || answer.error) { said(answer || {}); return; }
  const s = state.sessions.find((one) => one.id === id);
  if (s) s.remind_at = answer.remind_at;
  redrawRows();
  drawSessions();
}

// The row's "later": a small menu of the choices until one is picked, or
// the pointer leaves the row.
function openReminders(row, id) {
  const menu = row.querySelector(".remindmenu");
  menu.replaceChildren();
  menu.classList.remove("custom");
  put(menu, "div", "menuhead", "Remind me");
  for (const [word, choice] of REMIND_IN) {
    const pick = put(menu, "button", "link", word);
    pick.addEventListener("click", (press) => {
      press.stopPropagation();
      menu.hidden = true;
      setReminder(id, remindMoment(choice));
    });
  }
  put(menu, "button", "link", "Custom…").addEventListener("click", (press) => {
    press.stopPropagation();
    customReminder(menu, id);
  });
  menu.hidden = false;
  // A custom day stays open when the pointer leaves: the date box's own
  // calendar is outside the row, and going to it closed the menu.
  row.addEventListener("mouseleave", () => {
    if (!menu.classList.contains("custom")) menu.hidden = true;
  }, { once: true });
}

// "Custom..." (#406): a day, today unless the reader picks another, and a
// time, the next full hour unless they type another. It stays open until
// it is set, Escape, or a press anywhere else. Neither is the browser's
// own date or time box: those write the day and the hour as the browser's
// language does, and the reader's said "10/05/2026" and "06:00 AM"; the
// page says "Wed 7 Oct" and "22:10" everywhere else.
function customReminder(menu, id) {
  menu.replaceChildren();
  menu.classList.add("custom");
  put(menu, "div", "menuhead", "Remind me on");
  const now = new Date(serverNow() * 1000);
  const next = new Date(now);
  next.setHours(next.getHours() + 1, 0, 0, 0);
  const day = put(menu, "select", "remindday");
  for (let ahead = 0; ahead <= REMIND_DAYS; ahead++) {
    const at = new Date(now);
    at.setDate(at.getDate() + ahead);
    const option = put(day, "option", "", dayName(at, ahead));
    option.value = String(ahead);
  }
  day.value = next.getDate() === now.getDate() ? "0" : "1";   // after 23:00, tomorrow
  const time = put(menu, "input", "remindtime");
  time.type = "text";
  time.inputMode = "numeric";
  time.spellcheck = false;
  time.placeholder = "22:10";
  time.value = String(next.getHours()).padStart(2, "0") + ":00";
  const why = put(menu, "div", "remindwhy");
  const set = put(menu, "button", "remindset", "Set reminder");
  const close = () => {
    menu.hidden = true;
    menu.classList.remove("custom");
    document.removeEventListener("pointerdown", outside, true);
  };
  const outside = (press) => { if (!menu.contains(press.target)) close(); };
  document.addEventListener("pointerdown", outside, true);
  const go = () => {
    const clockAt = readTime(time.value);
    if (!clockAt) { why.textContent = "Write the time as 22:10."; return; }
    const on = new Date(serverNow() * 1000);
    on.setDate(on.getDate() + Number(day.value));
    on.setHours(clockAt[0], clockAt[1], 0, 0);
    const at = on.getTime() / 1000;
    if (at <= serverNow()) { why.textContent = "That time has passed."; return; }
    close();
    setReminder(id, at);
  };
  set.addEventListener("click", (press) => { press.stopPropagation(); go(); });
  for (const box of [day, time]) {
    box.addEventListener("keydown", (press) => {
      if (press.key !== "Enter" && press.key !== "Escape") return;
      // Not the page's: Escape there leaves a view, and Enter opens a row.
      press.preventDefault();
      press.stopPropagation();
      if (press.key === "Enter") go(); else close();
    });
  }
  time.focus();
  time.select();
}

// A reminder that has come ends when the reader opens its session, as
// reading it ends an unread mark.
function endReminder(s) {
  if (s && reminderDue(s) && !state.ending) {
    state.ending = s.id;
    setReminder(s.id, 0).finally(() => { state.ending = null; });
  }
}

// The page's clock moves a row into "needs you" with no push: wake at the
// next reminder and draw again, which rings it (`notifyAbout`).
let reminderTimer = null;
function armReminders() {
  clearTimeout(reminderTimer);
  const next = state.sessions.filter(reminderSet).map((s) => s.remind_at);
  if (!next.length) return;
  const wait = Math.max(0, (Math.min(...next) - serverNow()) * 1000) + 50;
  reminderTimer = setTimeout(() => {
    redrawRows();
    drawSessions();
  }, Math.min(wait, 2 ** 31 - 1));
}

// Snooze the chosen session, or wake it: `z`, and the row's control. Only a
// session that needs you can be snoozed; the daemon says so for any other.
async function toggleSnooze(id) {
  const s = state.sessions.find((one) => one.id === id);
  if (!s) return;
  if (!s.snoozed && s.state !== "needs_you") {
    note("only a session that needs you can be snoozed");
    return;
  }
  const answer = await tell(id, "snooze", { snooze: !s.snoozed });
  if (answer && answer.error) { said(answer); return; }
  s.snoozed = !!(answer && answer.snoozed);
  redrawRows();
  drawSessions();
}

// A session is unread when a turn ended since the reader last had it on
// screen, or when they marked it so (#373). What is on screen, in a window
// the reader can see, is read -- except the one they marked unread while
// looking at it, until they choose another: "I looked, but I am not done
// with it" is the whole point of the mark.
async function setUnread(id, unread) {
  const s = state.sessions.find((one) => one.id === id);
  if (!s) return;
  const was = { unread: !!s.unread, kept: state.keptUnread };
  if (unread && id === state.chosen) state.keptUnread = id;
  if (!unread && state.keptUnread === id) state.keptUnread = null;
  state.seeing = id;
  s.unread = unread;
  redrawRows();
  drawSessions();
  const answer = await tell(id, "seen", { seen: !unread });
  if (state.seeing === id) state.seeing = null;
  // Found again: a push while the answer was out replaced the list, and
  // the row it drew was built before the mark. The next pass sends one
  // built after it, as it does for a name.
  const now = state.sessions.find((one) => one.id === id);
  if (!answer || answer.error) {
    // It did not land: the row says what the file holds, not what was
    // asked, or the dot stood for a mark nobody kept.
    if (now) now.unread = was.unread;
    state.keptUnread = was.kept;
    said(answer || { error: "the daemon did not answer" });
  } else if (now) {
    now.unread = !!answer.unread;
  }
  redrawRows();
  drawSessions();
}

function toggleUnread(id) {
  const s = state.sessions.find((one) => one.id === id);
  if (s) setUnread(id, !s.unread);
}

// The session on screen is read, while the window is in front of the
// reader. Asked on every push, on a choice and when the window comes back;
// `seeing` keeps a push that arrives before the answer from asking twice.
function markSeen() {
  const s = current();
  // The feed covers the session's tabs: what it shows is read from there.
  if (!s || state.feed || document.visibilityState !== "visible") return;
  endReminder(s);
  // Taken before it is read, and once: a turn that ends while the reader
  // watches is not news, and must not move the line (#374).
  if (state.turns.newSince === undefined) {
    state.turns.newSince = s.unread && s.seen_at > 0 ? s.seen_at : null;
    if (state.turns.newSince !== null) {
      const pane = $("content").querySelector(".turnbody");
      if (pane && state.tab === "transcript") {
        putNewLine(pane);
        landOnNew(pane);
      }
    }
  }
  if (!s.unread || state.keptUnread === s.id || state.seeing === s.id) return;
  setUnread(s.id, false);
}

// The line over the first block the reader has not seen (#374), as Slack
// draws one over the first message. Put again on every draw, so a redraw
// keeps it; the blocks' own nodes do not carry it, so redrawing one leaves
// it standing. Returns the line, or null when there is none to draw.
function putNewLine(pane) {
  const old = pane.querySelector(":scope > .newline");
  if (old) old.remove();
  const since = state.turns.newSince;
  if (since === undefined || since === null) return null;
  const blocks = state.turns.blocks;
  for (let at = 0; at < blocks.length; at += 1) {
    const block = blocks[at];
    if (!block || !(block.ts > since)) continue;
    // A block with no node here is passed over, not the end of the search:
    // the line goes over the first one there is.
    const node = state.turns.nodes[at];
    if (!node || node.parentNode !== pane) continue;
    const line = document.createElement("div");
    line.className = "newline";
    // Since when (#398): "new" alone did not say how much was missed.
    line.textContent = "new since " + (dayOf(since) ? dayOf(since) + ", " : "")
      + clock(since);
    pane.insertBefore(line, node);
    return line;
  }
  return null;
}

// Opening a session with something new lands on the line, not the foot,
// and once: landing again on every draw would drag the reader back up. A
// draw the reader has not scrolled since is still that landing: the
// transcript is drawn as text and again as Markdown, much taller, and the
// place kept from the first put the line far down the second.
function landOnNew(pane) {
  if (state.turns.goTo !== null) return false;
  if (state.turns.newLanded && state.turns.down !== state.turns.newDown) return false;
  const line = pane.querySelector(":scope > .newline");
  if (!line) return false;
  state.turns.newLanded = true;
  line.scrollIntoView({ block: "start" });
  state.turns.down = state.turns.newDown = nearBottom(pane) ? null : pane.scrollTop;
  return true;
}

// --- all unreads (#376) ------------------------------------------------------

// The last answer of every unread session, one under the other, newest
// first: coming back from a break is one scroll, not a click a session.
// The texts are asked for when the feed is drawn, one route a session, and
// kept while it is open; a row going out on every change does not carry
// them.

function unreadSessions() {
  return topSessions().filter((s) => s.unread)
    .sort((a, b) => (b.ended_at || 0) - (a.ended_at || 0));
}

// The three views over the list, in one row (#391): unread, saved (#377)
// and search (#379), each always there, with its count.
function drawFeedLink() {
  viewLink($("feedlink"), "inbox", "Unread", unreadSessions().length, "unread");
  viewLink($("savedlink"), "save", "Saved", state.savedCount || 0, "saved");
  viewLink($("searchlink"), "search", "Search", null, "search");
  viewLink($("cmdlink"), "slash", "Commands", null, "commands");
  fitViews();
  drawViewTitle();
  // A session read elsewhere leaves the feed while it is open.
  if (state.feed) drawFeed($("content"));
}

function openFeed(kind = "unread") {
  if (state.feed === kind) return;
  if (!state.feed) savePlace(state.chosen);
  state.feed = kind;
  $("content").dataset.tab = "";
  if (kind === "saved") askSaved();
  if (kind === "commands") loadCommands();
  state.feedText = new Map();
  document.body.classList.add("infeed");
  homeFind($("findhome"));
  draw();
  drawFeedLink();
}

// Back to the session the view stands over, by Escape or the title's link.
function leaveFeed() {
  if (state.chosen) { choose(state.chosen); return; }
  closeFeed();
  draw();
}

// The view's name in the tab row, in place of the tabs (#392); the heading
// it had inside the content said it a second time.
const VIEW_NAMES = { unread: "All unreads", saved: "Saved", search: "Search every session",
                     commands: "Commands" };

function drawViewTitle() {
  const title = $("viewtitle");
  if (!fresh(title, "text", String(state.feed))) return;
  title.replaceChildren();
  if (!state.feed) return;
  put(title, "span", "viewname", VIEW_NAMES[state.feed]);
  put(title, "button", "link", "esc  ·  back to the session")
    .addEventListener("click", leaveFeed);
}

// A view's entry as a card that reads like its session's row (#393): the
// state's colour on its edge, where it stands under its name, and a press
// anywhere on it opens it -- but not one on a button or a link, and not
// one that ends a selection, which is a reader copying a line.
function putCard(list, id, s, open) {
  const entry = put(list, "div", "feedentry");
  entry.dataset.id = id;
  const kind = !s || isGone(s) ? "gone" : needsYou(s) ? "needs"
    : s.state === "working" ? "working" : "";
  if (kind) entry.classList.add(kind);
  const top = put(entry, "div", "feedtop");
  put(top, "span", "feedname", s ? rowName(s) : "a session no longer listed");
  if (s) {
    const where = [s.repo, s.worktree, s.branch].filter(Boolean).join("  ·  ");
    if (where) put(entry, "div", "feedwhere", where);
  }
  if (open) {
    entry.addEventListener("click", (press) => {
      if (press.target.closest && press.target.closest("button, a, input")) return;
      if (String(window.getSelection() || "")) return;
      open();
    });
  }
  return [entry, top];
}

// The cards of a view as Google Keep lays out its notes (#404, #408): as
// many columns as fit, each card under the shortest column, so the newest
// stand along the top and read across. Placed by hand: CSS columns fill one
// column down before the next, so the newest were all at the left. The
// cards stay in their order in the page, so the keys and a reader of the
// page meet them newest first.
// 480, not 340 (#403): at 340 a card held a few words a line, and the
// reader could see too little of what was saved.
const CARD_MIN = 480;
const CARD_GAP = 12;

function putBoard(parent, cls) {
  const board = put(parent, "div", "board" + (cls ? " " + cls : ""));
  // A card grows when a code block is painted, and the board when the
  // window does. Laid out on the next frame: a layout inside the observer
  // changes what it observes, and the browser calls that a loop.
  let queued = false;
  board.watch = new ResizeObserver(() => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; layoutCards(board); });
  });
  board.watch.observe(board);
  return board;
}

function layoutCards(board) {
  const cards = [...board.children].filter((one) => one.classList.contains("feedentry"));
  const width = board.clientWidth;
  if (!cards.length || !width) { board.style.height = ""; return; }
  const columns = Math.max(1, Math.floor((width + CARD_GAP) / (CARD_MIN + CARD_GAP)));
  const each = (width - (columns - 1) * CARD_GAP) / columns;
  for (const card of cards) {
    card.style.width = each + "px";
    board.watch.observe(card);
  }
  // Every width first, then every height, then every place: one layout,
  // not one a card.
  const heights = cards.map((card) => card.offsetHeight);
  const tops = new Array(columns).fill(0);
  cards.forEach((card, n) => {
    const column = tops.indexOf(Math.min(...tops));
    card.style.left = column * (each + CARD_GAP) + "px";
    card.style.top = tops[column] + "px";
    tops[column] += heights[n] + CARD_GAP;
  });
  board.style.height = Math.max(...tops) - CARD_GAP + "px";
}

function closeFeed() {
  state.feed = false;
  document.body.classList.remove("infeed");
  $("content").dataset.tab = "";        // the tab is built again
  drawFeedLink();
}

async function askLast(id) {
  if (state.feedText.has(id)) return;
  state.feedText.set(id, null);           // asked, not answered
  const answer = await ask(id, "last");
  if (!state.feed) return;
  state.feedText.set(id, answer && !answer.error ? answer : { text: "", failed: true });
  $("content").dataset.feed = "";
  drawFeed($("content"));
}

function drawFeed(box) {
  if (state.feed === "saved") { drawSaved(box); return; }
  if (state.feed === "search") { drawSearch(box); return; }
  if (state.feed === "commands") { drawCommands(box); return; }
  const shown = unreadSessions();
  const key = JSON.stringify([shown.map((s) => [s.id, s.ended_at, rowName(s), s.state]),
                              [...state.feedText.entries()]]);
  if (box.dataset.tab === "feed" && !fresh(box, "feed", key)) return;
  if (box.dataset.tab !== "feed") fresh(box, "feed", key);
  box.className = "content feed";
  box.dataset.tab = "feed";
  box.replaceChildren();
  if (!shown.length) {
    put(box, "p", "empty", "Nothing unread. Every answer has been read.");
    return;
  }
  const board = putBoard(box);
  for (const s of shown) {
    askLast(s.id);
    const [entry, top] = putCard(board, s.id, s, () => choose(s.id));
    put(top, "span", "feedwhen",
        (dayOf(s.ended_at) ? dayOf(s.ended_at) + " " : "") + clock(s.ended_at));
    const open = put(top, "button", "link", "open");
    open.addEventListener("click", () => choose(s.id));
    const read = put(top, "button", "link", "mark read");
    read.addEventListener("click", () => setUnread(s.id, false));
    const found = state.feedText.get(s.id);
    if (!found) {
      put(entry, "p", "feedwait", found === null ? "reading…" : "");
    } else if (!found.text) {
      put(entry, "p", "feedwait", found.failed
        ? "Its last answer could not be read. Open it to read it."
        : "It said nothing at the end of its turn. Open it to read the rest.");
    } else {
      // The start of a long answer, as the transcript folds one: the feed
      // is for a glance, and "open" is the rest.
      const head = foldedHead(found.text);
      markdown(entry, head || found.text);
      if (head || found.cut) put(entry, "p", "feedmore", "… open it to read the rest");
    }
  }
  layoutCards(board);
}

// The saved turns of every session, newest first (#377): the start of
// each, its session and its moment, "open" to go there and "done" to take
// it off the list.
// How a saved card names who said it (#424): the transcript's names, in
// its colours.
const SAVED_FACES = {
  me: ["mine", "you"], shell: ["mine", "you"], system: ["aside", "system"],
  claude: ["claude", "claude"],
};

function drawSaved(box) {
  const saved = state.saved || [];
  const key = JSON.stringify([saved, state.sessions.map((s) => [s.id, rowName(s)])]);
  if (box.dataset.tab === "saved" && !fresh(box, "feed", key)) return;
  if (box.dataset.tab !== "saved") fresh(box, "feed", key);
  box.className = "content feed";
  box.dataset.tab = "saved";
  box.replaceChildren();
  if (!saved.length) {
    put(box, "p", "empty", "Nothing saved. The bookmark on an answer or a prompt keeps it here.");
    return;
  }
  const board = putBoard(box);
  for (const one of saved) {
    const s = state.sessions.find((x) => x.id === one.id);
    const go = s ? () => {
      choose(one.id);
      state.turns.goTo = one.seq;
      state.turns.goToTs = one.ts;
      showTab("transcript");
    } : null;
    const [entry, top] = putCard(board, one.id, s, go);
    // Who said it, as a search result says (#403): a prompt of the
    // reader's reads like an answer, once it is out of its transcript.
    const [whoClass, whoWord] = SAVED_FACES[one.who] || SAVED_FACES.claude;
    put(top, "span", "feedwho " + whoClass, whoWord);
    put(top, "span", "feedwhen",
        (dayOf(one.ts) ? dayOf(one.ts) + " " : "") + clock(one.ts));
    if (go) put(top, "button", "link", "open").addEventListener("click", go);
    const done = put(top, "button", "link", "done");
    done.addEventListener("click", async () => {
      const answer = await tell(one.id, "save", { seq: one.seq, ts: one.ts, save: false });
      if (!answer || answer.error) { said(answer || {}); return; }
      takeSaved(answer.saved);
    });
    const text = one.text + (one.text.length >= 300 ? " …" : "");
    // As the transcript draws it: a prompt in the reader's box, as typed;
    // a command in it too, in the fixed face; the harness's words in its
    // dashed box; an answer as Markdown.
    if (one.who === "me") put(entry, "div", "bubble mine", text);
    else if (one.who === "shell") put(put(entry, "div", "bubble mine shell"), "pre", "output", text);
    else if (one.who === "system") put(entry, "div", "bubble aside", text);
    else markdown(entry, text);
  }
  layoutCards(board);
}

// Search every session (#379): what the reader typed and what the agents
// answered, from the event log, newest first, with Slack's filters. The
// box is built once and kept while the view is open; only the results
// under it are drawn again, so typing never loses the focus.
const SEARCH_HINT = "words, and in:name  from:me  from:claude  after:2026-10-01  "
  + "before:2026-10-03  is:unread";

function drawSearch(box) {
  if (box.dataset.tab !== "search") {
    box.className = "content feed";
    box.dataset.tab = "search";
    box.replaceChildren();
    const field = put(box, "input", "find searchbox");
    field.type = "search";
    field.placeholder = SEARCH_HINT;
    field.spellcheck = false;
    field.value = state.searchQuery || "";
    let timer = null;
    field.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(() => runSearch(field.value), 250);
    });
    putBoard(box, "searchresults");
    field.focus();
  }
  drawResults(box.querySelector(".searchresults"));
}

async function runSearch(query) {
  state.searchQuery = query;
  const asked = query;
  let found = null;
  try {
    found = await (await fetch("/api/search?q=" + encodeURIComponent(query))).json();
  } catch (error) {
    found = { error: "the daemon did not answer" };
  }
  if (state.searchQuery !== asked || state.feed !== "search") return;  // typed on
  state.searchResults = found;
  drawResults($("content").querySelector(".searchresults"));
}

function drawResults(list) {
  if (!list) return;
  list.replaceChildren();
  list.style.height = "";
  const found = state.searchResults;
  if (!state.searchQuery || !found) return;
  if (found.error) { put(list, "p", "empty", found.error); return; }
  if (!found.results.length) { put(list, "p", "empty", "Nothing found."); return; }
  const words = state.searchQuery.split(/\s+/)
    // The daemon's rule (`parse_search`): a filter is a known word, a colon
    // and a value; anything else is a word, and marked.
    .filter((word) => word && !/^(in|from|before|after|is):\S/i.test(word));
  for (const one of found.results) {
    const s = state.sessions.find((x) => x.id === one.id);
    const go = s ? () => {
      choose(one.id);
      state.turns.goTo = 0;
      state.turns.goToNear = one.ts;
      showTab("transcript");
    } : null;
    const [entry, top] = putCard(list, one.id, s, go);
    put(top, "span", one.who === "me" ? "feedwho mine" : "feedwho claude",
        one.who === "me" ? "you" : "claude");
    put(top, "span", "feedwhen", (dayOf(one.ts) ? dayOf(one.ts) + " " : "") + clock(one.ts));
    if (go) put(top, "button", "link", "open").addEventListener("click", go);
    // Text, never Markdown: a piece cut from the middle of an answer is
    // not Markdown any more. So its signs go too (#395).
    const said = put(entry, "p", "searchtext", unmarked(one.text));
    for (const word of words) markHits(said, word.toLowerCase());
  }
  layoutCards(list);
}

// An excerpt without the Markdown signs that say how to draw it (#395):
// it is shown as text, so a fence, a bold and a code tick were noise. The
// words stay, and the hits are marked after, on what is shown.
function unmarked(text) {
  return text.replace(/```+|\*\*|`/g, "").replace(/ {2,}/g, " ");
}

// The four views in one row, always (#411): the fullest form of them that
// fits -- icon, word and count; then word and count; then icon and count
// -- measured, because how wide a word is depends on the reader's fonts.
// A word that does not fit is in the button's title.
const VIEW_FITS = ["", "bare", "icons"];

function fitViews() {
  const row = document.querySelector(".views");
  if (!row || !row.clientWidth) return;
  for (const fit of VIEW_FITS) {
    row.className = "views" + (fit ? " " + fit : "");
    if (row.scrollWidth <= row.clientWidth) return;
  }
}

function viewLink(button, icon, word, count, feed) {
  button.classList.toggle("open", state.feed === feed);
  if (!fresh(button, "text", String(count))) return;
  button.replaceChildren();
  putIcon(button, icon);
  put(button, "span", "viewname", word);
  if (count !== null) put(button, "span", count ? "n" : "n none", String(count));
}

function bandOf(s) {
  for (const band of BANDS) if (band[2](s)) return band[0];
  return "ready";                    // a state nobody here knows is not urgent
}

// The rows the filter box leaves. A session is matched on everything the row
// shows: the worktree, the name Claude Code gave it, and the branch. `fuzzy`
// is the same matcher the Files tab uses, so "ofd" finds "oans/fastduck".
// The counts and the "N of M" line are about this: the filter is what they
// are narrowed by, not the fold.
// The sessions another agent ran (#422): a `claude -p` from its Bash tool,
// whose parent is still in the list. Such a session is no row of its own,
// and nothing that counts sessions counts it: it is a line under its
// parent's row (`fillKids`). It came and went in a second as a row, and
// nothing said whose it was.
//
// Never one that may need the reader: one with a pane of its own, or
// waiting -- hidden, its dialog had no row, no title and no alert. Nor one
// still working under a parent that is over (killed, or a `/clear` it was
// linked across): its line stood under a folded history.
function childIds() {
  const byId = new Map(state.sessions.map((s) => [s.id, s]));
  return new Set(state.sessions.filter((s) => {
    const parent = s.started_by && byId.get(s.started_by);
    if (!parent || s.pane || s.state === "needs_you") return false;
    return !(isGone(parent) && s.state === "working");
  }).map((s) => s.id));
}

// The sessions that are rows: every one but the children.
function topSessions() {
  const children = childIds();
  return state.sessions.filter((s) => !children.has(s.id));
}

// Every row filled again on the next draw, whatever its signature says:
// for a change the rows' data does not show -- a closed rename box, the
// fold of a history or of subagents (#431).
function redrawRows() {
  $("rows").dataset.drawn = "";
  for (const row of $("rows").children) delete row.dataset.sig;
}

// A push of what changed, laid over the rows the page holds (#431): the
// rows that are new or differ, and the order of the ids whenever it moved
// -- a row that went is one the order no longer names. A row the push does
// not name is the same object as before.
function mergeSessions(held, body) {
  const byId = new Map(held.map((s) => [s.id, s]));
  for (const s of body.changed || []) byId.set(s.id, s);
  const order = body.order || held.map((s) => s.id);
  const placed = new Set(order);
  // A new row comes with an order; one that did not is put last, not lost.
  for (const s of body.changed || []) if (!placed.has(s.id)) order.push(s.id);
  return order.filter((id) => byId.has(id)).map((id) => byId.get(id));
}

function shownSessions() {
  if (!state.pick) return topSessions();
  return topSessions().filter((s) => fuzzy(
    [s.place, s.name, s.branch].filter(Boolean).join(" "), state.pick));
}

// What is actually in the list, in the order it is drawn. `j` and `k` walk
// this, because a key must not move to a row that is not on screen. Typing in
// the filter box opens the history: a search that cannot see half the
// sessions gives a wrong answer that looks like a right one. So does the
// session you are reading, which is never hidden from the list it is chosen
// in.
//
// The daemon sends its own order, `settled` newest first, and the list draws
// it in `BANDS` groups. The two differ as soon as a group holds two rows, and
// `j` walked the daemon's: from a needs-you row on top it jumped over the
// working row under it. So the groups are put in order here, once, and
// `drawSessions` and `move` both read this. The sort is stable, so inside a
// group the daemon's order stands.
function listedSessions() {
  const shown = shownSessions();
  const listed = state.history || state.pick ? shown
    : shown.filter((s) => !isGone(s) || s.id === state.chosen);
  const rank = (s) => BANDS.findIndex((band) => band[0] === bandOf(s));
  return listed.slice().sort((a, b) => rank(a) - rank(b));
}

// One empty row, built once and then only filled in. Every row has the same
// parts whether or not it has anything to put in them, so `fillRow` can reach
// them by position and nothing has to be created again later.
function newRow(id) {
  const row = document.createElement("div");
  row.dataset.id = id;
  // A ticket link in the row opens the ticket and nothing else: choosing
  // the session as well would change the page behind a tab the reader has
  // just gone to.
  const onLink = (press) => press.target.closest && press.target.closest("a");
  row.addEventListener("click", (press) => { if (!onLink(press)) choose(id); });
  const one = put(row, "div", "line1");
  const name = put(one, "span", "name");
  name.title = "double-click to rename";
  name.addEventListener("dblclick", (press) => {
    if (!onLink(press)) renameRow(row);
  });
  put(one, "span", "word");
  // What the hover offers, as icons in the age's place (#389).
  // "Not now", on a row that needs you, and "wake" on one snoozed (#355).
  const later = put(one, "button", "act snooze");
  later.addEventListener("click", (press) => {
    press.stopPropagation();           // not a choice of the row
    toggleSnooze(id);
  });
  // "later": remind me about it (#375), shown on the hover too.
  const later2 = put(one, "button", "act remindlater");
  later2.addEventListener("click", (press) => {
    press.stopPropagation();
    if (reminderSet(state.sessions.find((x) => x.id === id) || {})) {
      setReminder(id, 0);
    } else {
      openReminders(row, id);
    }
  });
  // "unread" on a row that is read, shown on its hover (#373).
  const unread = put(one, "button", "act markunread");
  unread.title = "mark it unread  ·  u";
  putIcon(unread, "dot");
  unread.addEventListener("click", (press) => {
    press.stopPropagation();
    setUnread(id, true);
  });
  put(one, "span", "age");
  const menu = put(row, "div", "remindmenu");
  menu.hidden = true;
  // A press on the menu between its choices is no choice of the row.
  menu.addEventListener("click", (press) => press.stopPropagation());
  put(row, "div", "line2 where");
  put(row, "div", "line2");
  const three = put(row, "div", "line3");
  put(three, "span", "said");
  put(row, "div", "kids").hidden = true;
  return row;
}

// What a session started (#422), oldest first: the sessions its agent ran
// from the Bash tool, and the subagents of its Agent tool, each as a line
// says it. Ended is over: a child at its prompt has done what it was run
// for, and a `claude -p` never waits on anybody.
function kidsOf(s) {
  const children = childIds();
  const sessions = state.sessions.filter((one) => children.has(one.id)
                                         && one.started_by === s.id).map((one) => ({
    id: one.id, session: true, what: rowName(one),
    doing: one.reason || one.last_event || "",
    started: one.started_at || one.since,
    ended: one.state === "working" || one.state === "needs_you" ? 0 : one.since,
  }));
  const agents = (s.subagents || []).map((one) => ({
    id: one.id, session: false, what: one.what || one.kind || "subagent",
    kind: one.kind, doing: one.doing, started: one.started, ended: one.ended,
  }));
  return sessions.concat(agents).sort((a, b) => a.started - b.started);
}

// The lines under a row: one for each child still running, then "3
// subagents ran", which unfolds the ones that ended. A child that ended is
// gone from sight, as the reader chose: they ended in seconds, and as rows
// they were most of what moved in the list. A child session is opened from
// its line; a subagent of the Agent tool has no transcript the page reads,
// and its line chooses the row it stands in.
function fillKids(box, s) {
  const kids = kidsOf(s);
  const open = state.kidsOpen.has(s.id);
  const chosen = kids.some((one) => one.id === state.chosen);
  if (fresh(box, "text", JSON.stringify([kids, open, chosen && state.chosen,
                                         s.agents_ran]))) {
    box.replaceChildren();
    const ran = kids.filter((one) => one.ended);
    for (const one of kids) if (!one.ended) putKid(box, one);
    // The one being read stays in sight when it ends: the chosen session is
    // never hidden from the list it is chosen in.
    if (!open) for (const one of ran) if (one.id === state.chosen) putKid(box, one);
    // Every one that ended, though the daemon keeps only the last few of
    // the Agent tool's: the count says how many there were.
    const many = (s.agents_ran || 0) + ran.filter((one) => one.session).length;
    if (many) {
      const fold = put(box, "button", "link kidsran",
                       (open ? "\u25be " : "\u25b8 ") + counted(many, "subagent ran", "subagents ran"));
      fold.title = open ? "hide them" : "show the ones that ran";
      fold.addEventListener("click", (press) => {
        press.stopPropagation();          // not a choice of the row
        if (state.kidsOpen.has(s.id)) state.kidsOpen.delete(s.id);
        else state.kidsOpen.add(s.id);
        redrawRows();
        drawSessions();
      });
      if (open) for (const one of ran) putKid(box, one);
    }
  }
  box.hidden = !box.children.length;
}

// One line: what it was asked to do, what it does now while it runs, and
// how long ago it started, or ended.
function putKid(box, one) {
  const line = put(box, "div", "kid" + (one.ended ? "" : " running")
    + (one.session ? " opens" : "") + (one.id === state.chosen ? " chosen" : ""));
  line.dataset.kid = one.id;
  put(line, "span", "kidmark", "\u21b3");
  put(line, "span", "kidwhat", one.what);
  if (!one.ended && one.doing) put(line, "span", "kiddoing", one.doing);
  const since = one.ended || one.started;
  const age = put(line, "span", "age", ago(since));
  age.dataset.since = since;
  if (one.session) {
    line.title = "open its transcript";
    line.addEventListener("click", (press) => {
      press.stopPropagation();
      choose(one.id);
    });
  } else {
    line.title = (one.kind || "a") + " subagent of this session";
  }
}

// A row says what nothing else on the page says: the name you know the
// session by, the repository and the branch, what git counts, and how long
// ago. The name is one you gave it, and until you do, its repository and
// worktree (`agent/richpalm`) -- never the title Claude Code writes from the
// first prompt, which `/rename` does not reach and which went stale beside
// the branch.
// Not the state: the row's edge, its tint and the group it stands in say it
// already, and a word at the top and "waiting for input" at the foot said it
// a third and a fourth time. The word stays in the history, where "ended"
// and "killed" share one group and one grey.
function fillRow(row, s) {
  const [one, , where, two, three, kids] = row.children;
  // A reminder not yet come puts a waiting row aside as a snooze does, and
  // one that has come wears the amber of a session that needs you (#375).
  row.className = "row " + s.state + (s.id === state.chosen ? " chosen" : "")
    + (s.snoozed || (reminderSet(s) && s.state === "needs_you") ? " snoozed" : "")
    + (s.unread ? " unread" : "") + (reminderDue(s) ? " reminded" : "");
  // Not while it is being renamed: the box is in there, and this runs on
  // every push.
  // Each part is written again only when what it says has changed. This
  // runs on every push, about once a second while an agent works, and a
  // ticket link rebuilt between the press and the release is a click that
  // never happens.
  const links = state.linksKey;
  const slot = one.children[0];
  if (!slot.querySelector("input")
      && fresh(slot, "text", JSON.stringify([rowName(s), links]))) {
    slot.textContent = rowName(s);
    linkTickets(slot);
  }
  one.children[1].textContent = isGone(s) ? s.state_word
    : reminderWord(s) || (s.snoozed ? "snoozed" : "");
  one.children[1].classList.toggle("pill", !isGone(s) && reminderDue(s));
  const later = one.children[2];
  // Only where a snooze can hold: a session that waits. A row a reminder
  // brought back is not one, and the daemon would refuse it (#375).
  later.hidden = !(s.state === "needs_you" && !reminderSet(s)) && !s.snoozed;
  setIcon(later, s.snoozed ? "sun" : "moon");
  later.title = s.snoozed ? "it needs you again  ·  z" : "it waits, but not now  ·  z";
  // On every row, the same four lines: the name, where it stands, the
  // branch and what git counts, and what it is doing. A row not renamed
  // says its repository twice, and a row that is always one shape is read
  // faster than one that saves a word.
  const fact = (line, cls, icon, text, title) => {
    const part = put(line, "span", cls);
    putIcon(part, icon);
    // The reader's ticket links, from `links.json`: a branch or a worktree
    // named after its ticket is the most common place for one.
    linkTickets(put(part, "span", "text", text));
    part.title = title;
  };
  if (fresh(where, "text", JSON.stringify([s.repo, s.remote, s.worktree,
                                           s.worktree_path, links]))) {
    where.replaceChildren();
    if (s.repo) fact(where, "repo", "repo", s.repo, s.remote || "no remote");
    if (s.worktree) fact(where, "worktree", "dir", s.worktree, s.worktree_path || "");
  }
  two.hidden = !s.branch;
  if (fresh(two, "text", JSON.stringify([s.branch, s.ahead, s.behind, s.dirty,
                                         s.touched_files, s.doing, s.conflicts,
                                         links]))) {
    two.replaceChildren();
    if (s.branch) fact(two, "branch", "branch", s.branch, s.branch);
    // What git counts, at the right edge, so the counts of every row stand
    // in one column however long each branch is.
    const counts = put(two, "span", "gitstate");
    // What git has started and not finished, first, in the amber of
    // something waiting: the diff, the branch and what is committed read
    // differently until it ends (#357).
    if (s.doing) {
      put(counts, "span", "doing", s.doing).title = "git is " + s.doing
        + " here, and has not finished: see the Review tab";
    }
    if (s.conflicts) {
      put(counts, "span", "conflict", counted(s.conflicts, "conflict", "conflicts"));
    }
    if (s.ahead) put(counts, "span", "ahead", "↑" + s.ahead);
    if (s.behind) put(counts, "span", "ahead", "↓" + s.behind);
    if (s.dirty) put(counts, "span", "dirty", "● " + s.touched_files + " files");
    else if (s.branch) put(counts, "span", "clean", "✓ clean");
  }
  // Only while the session is doing something or waiting on you. A ready
  // session's reason is the state again ("waiting for input", "stopped"),
  // and a finished one's is "ended (logout)" under the word "ended".
  const said = s.state === "done" || isGone(s)
    ? "" : (s.reason || s.last_event || "");
  three.children[0].textContent = said;
  three.hidden = !said;
  fillKids(kids, s);
  // Beside the name, at the right: "how long has this needed me?" is read
  // with the name, and a ready row has no fourth line to carry it.
  // On a row a reminder brought back too: "later" again, as Slack lets a
  // reminder be put off once more.
  const remind = one.children[3];
  remind.hidden = isGone(s);
  setIcon(remind, reminderSet(s) ? "clockOff" : "clock");
  remind.title = reminderSet(s) ? "cancel the reminder" : "remind me about it later";
  one.children[4].hidden = !!s.unread || needsYou(s) || s.snoozed;
  // The hover's icons stand in the age's place, on a row that offers any;
  // a reminder's time stays, because it says when the row comes back.
  const age = one.children[5];
  const offers = [later, remind, one.children[4]].some((act) => !act.hidden);
  age.classList.toggle("swap", offers && !reminderSet(s));
  age.classList.toggle("when", reminderSet(s));
  if (reminderSet(s)) {
    delete age.dataset.since;          // a clock, not an age
    if (fresh(age, "text", reminderAt(s))) {
      age.replaceChildren();
      putIcon(age, "clock");
      age.append(reminderAt(s));
    }
    age.title = "the reminder brings it back then";
  } else {
    delete age.dataset.text;
    age.textContent = ago(s.since);
    age.title = "";
    age.dataset.since = s.since;
  }
}

// The name Claude Code shows for the session, or the reader's from the page
// while that is the newer one: the daemon works out which (`title`, #351).
// Its place when it has none, which the next line says as well.
function rowName(s) {
  return s.name || s.place || s.id.slice(0, 8);
}

// Renaming where the name stands, by a double-click or `e` -- a name you
// change when you think of it is a name you have. Enter keeps it, an empty
// name gives the session back its repository and worktree, and Escape or a
// click elsewhere keeps the old one.
function renameRow(row) {
  const id = row.dataset.id;
  const s = state.sessions.find((one) => one.id === id);
  const slot = row.querySelector(".line1 .name");
  if (!s || !slot || slot.querySelector("input")) return;
  const box = document.createElement("input");
  box.className = "rowname";
  box.type = "text";
  box.autocomplete = "off";
  box.spellcheck = false;
  box.placeholder = "a name  \u00b7  enter to keep";
  // The daemon's `NAME_MAX`, and `test_a_row_is_renamed_where_it_stands`
  // holds the two in step. The daemon keeps no more than that, and a paste
  // over `POST_MAX` was a body it did not read, which `name` once took for
  // "take the name away" (#235). The box counts UTF-16 units and the daemon
  // characters, so a name of emoji stops sooner here, never later.
  box.maxLength = 120;
  box.setAttribute("aria-label", "a name for this session");
  box.value = rowName(s);
  slot.replaceChildren(box);
  delete slot.dataset.text;            // so `fillRow` writes the name again
  const close = () => {
    if (!box.isConnected) return;
    box.remove();
    redrawRows();      // fill the name in again
    drawSessions();
  };
  box.addEventListener("keydown", (press) => {
    if (composing(press)) return;
    if (press.key === "Enter") {
      press.preventDefault();
      // Enter on the name it came with is not a name chosen: kept, it would
      // stop following the worktree for good.
      if (s.mine || box.value !== rowName(s)) keepRename(box, id);
      close();
    } else if (press.key === "Escape") {
      press.preventDefault();
      close();
    }
  });
  // Later, not now: `drawSessions` moves a row that changed its place, a
  // moved node loses the focus, and it gives the focus straight back. Only a
  // focus that is still gone after that is the reader leaving.
  box.addEventListener("blur", () => setTimeout(() => {
    if (document.activeElement !== box) close();
  }, 0));
  box.addEventListener("click", (press) => press.stopPropagation());
  box.focus();
  box.select();
}

// The line between what is running and what is over. It carries the count and
// folds the history away, because a week of finished sessions above the two
// you are working with is a list you stop reading.
function historyBar(many) {
  const bar = document.createElement("button");
  bar.type = "button";
  bar.className = "histhead";
  bar.addEventListener("click", () => {
    state.history = !state.history;
    store("wostuast-history", state.history ? "open" : "shut");
    drawSessions();
  });
  return bar;
}

function drawSessions() {
  const box = $("rows");
  // Only when they would come out different. The stream re-subscribes the
  // moment a session is first chosen, and the new stream opens with a full
  // push of its own, so every page load drew the whole sidebar twice.
  const shown = shownSessions();
  pruneReviews(state.sessions);
  drawCounts();
  const listed = listedSessions();
  const past = shown.filter(isGone);
  const children = childIds();
  if (!fresh(box, "drawn",
             JSON.stringify([listed, state.chosen, past.length, state.history,
                             state.linksKey,
                             state.sessions.filter((s) => children.has(s.id))]))) {
    return;
  }
  // A row that is still there is kept and filled in again. A dot can only
  // fade into its new colour if it is the same dot, and the needs-you ring
  // can only finish a cycle if its row outlives the change that started it —
  // and a state change is exactly when both of those used to be thrown away.
  // The bar is kept for the same reason; anything else that is not a row goes
  // first, because the loop below places things by position and a stray node
  // would shift every one of them.
  // A row being renamed may move below, and a moved node loses the focus.
  const typing = box.contains(document.activeElement)
    && document.activeElement.tagName === "INPUT" ? document.activeElement : null;
  const caret = typing ? [typing.selectionStart, typing.selectionEnd] : null;
  const had = new Map();
  let bar = null;
  for (const node of Array.from(box.children)) {
    if (node.dataset.id) had.set(node.dataset.id, node);
    else if (node.classList.contains("histhead")) bar = node;
    else node.remove();
  }
  // The children of each row, once a draw, for the rows' signatures.
  const kidsBy = new Map();
  for (const s of state.sessions) {
    if (children.has(s.id)) kidsBy.set(s.started_by, (kidsBy.get(s.started_by) || []).concat(s));
  }
  let at = 0;
  const place = (node) => {
    if (box.children[at] !== node) box.insertBefore(node, box.children[at] || null);
    at += 1;
  };
  // One head per group that has anything under it, in the order of `BANDS`.
  // The heads are made fresh each time: they carry only a count, so there is
  // no animation in them to preserve, unlike a row.
  // Not `!past.length`: with nothing to fold the loop skips the bar, and a
  // bar left from the last draw then survived the removal below. A filter
  // that hid every finished session still showed "history · 2" over nothing.
  let barPlaced = false;
  for (const [name, title] of BANDS) {
    const mine = listed.filter((s) => bandOf(s) === name);
    if (name === "history") {
      if (!past.length) continue;
      bar = bar || historyBar();
      bar.textContent = (state.history ? "\u25be" : "\u25b8") +
        " history \u00b7 " + past.length;
      place(bar);
      barPlaced = true;
    } else if (mine.length) {
      const head = put(document.createDocumentFragment(), "div", "band " + name,
                       title + " \u00b7 " + mine.length);
      place(head);
    }
    for (const s of mine) {
      const row = had.get(s.id) || newRow(s.id);
      had.delete(s.id);
      // Only a row whose session, or what the page shows beside it, has
      // changed (#431): filling all 500 rows took 34 ms on every push, and
      // with the layout after it up to 125 ms. By its text, not by the
      // object: the page changes a session in place for a rename, a
      // reminder, a snooze and an unread mark.
      const sig = JSON.stringify([s, s.id === state.chosen, state.linksKey,
                                  reminderDue(s), reminderAt(s), reminderWord(s),
                                  state.kidsOpen.has(s.id), kidsBy.get(s.id) || null]);
      if (row.dataset.sig !== sig || row.querySelector(".name input")) {
        fillRow(row, s);
        row.dataset.sig = sig;
      }
      place(row);
    }
  }
  if (!barPlaced && bar) bar.remove();
  for (const gone of had.values()) gone.remove();
  if (typing && typing.isConnected && document.activeElement !== typing) {
    typing.focus();
    typing.setSelectionRange(caret[0], caret[1]);
  }
  if (!listed.length && state.sessions.length && !past.length) {
    put(box, "div", "nohits", "no session matches");
  }
  openGrip();
}

// The line between the list and the content opens where the chosen row
// meets it, so the row reads as a tab of what is beside it. The line is the
// grip, which stands outside the list that scrolls, so it is told where the
// row is: on every draw, scroll and change of size. Only the part of the row
// the list shows opens it, between the row's top and bottom lines.
function openGrip() {
  const grip = $("grip");
  const list = $("rows");
  const row = list.querySelector(".row.chosen");
  let top = 0;
  let bottom = 0;
  let corners = [false, false];
  if (row) {
    // The whole height: the row's border is see-through, and its ground
    // shows under it.
    const seen = list.getBoundingClientRect();
    const at = row.getBoundingClientRect();
    const from = grip.getBoundingClientRect().top;
    top = Math.max(at.top, seen.top) - from;
    bottom = Math.min(at.bottom, seen.bottom) - from;
    // A corner only where the row's own end is in view: where the list
    // cuts it off, there is no end to turn (#407).
    corners = [at.top >= seen.top, at.bottom <= seen.bottom];
    if (bottom <= top) top = bottom = 0;
  }
  grip.style.setProperty("--gap-top", top + "px");
  grip.style.setProperty("--gap-bottom", bottom + "px");
  grip.classList.toggle("open", bottom > top);
  grip.classList.toggle("flaretop", bottom > top && corners[0]);
  grip.classList.toggle("flarebottom", bottom > top && corners[1]);
  // The row's hue, which no transition touches (#416): its border fades
  // in over .2 s, and read at a choice it was all but transparent, so the
  // line stayed so until the next push drew it again.
  if (bottom > top) grip.style.setProperty("--gap-hue", getComputedStyle(row).getPropertyValue("--hue"));
  if (row !== gripRow) {
    if (gripRow) gripWatch.unobserve(gripRow);
    if (row) gripWatch.observe(row);
    gripRow = row;
  }
}
// A row grows when a line is added to it, and every row moves when the
// fonts arrive; neither is a draw.
const gripWatch = new ResizeObserver(() => openGrip());
let gripRow = null;

// Only the ages change by themselves. Rebuilding the rows to advance them
// would restart the needs-you pulse every second, so it never finished a
// cycle. Each age carries its moment (`data-since`), so a row a draw left
// alone (#431) still ticks.
function tickAges() {
  for (const node of $("rows").querySelectorAll(".age[data-since]")) {
    node.textContent = ago(Number(node.dataset.since));
  }
}

// The browser tab's title and icon, and the alerts: the answer to "who needs
// me" from another window. The page itself says it in the sidebar's groups,
// so the strip of counts that stood over it was gone -- the reader asked.
function drawCounts() {
  // Not a child (#422): a `claude -p` that ended a turn a second after it
  // started was an alert and an unread of its own.
  const rows = topSessions();
  const tally = new Map();
  for (const s of rows) {
    const seen = tally.get(s.state) || { word: s.state_word, n: 0 };
    seen.n += 1;
    tally.set(s.state, seen);
  }
  const needs = rows.filter(needsYou).length;
  const working = (tally.get("working") || { n: 0 }).n;
  document.title = tabTitle(rows);
  drawIcon(needs ? "needs_you" : working ? "working"
    : rows.length ? "done" : "gone");
  // About every session, filter or no filter: "who needs me" must not
  // change because you typed in a box.
  notifyAbout(rows);
  armReminders();
  drawFeedLink();
}

function current() {
  return state.sessions.find((s) => s.id === state.chosen) || null;
}

// The question an agent is waiting on: at the foot of the transcript, over
// the send box.
//
// It is not the header bar that was taken away, and that is the point. That one
// stood over every tab saying the branch, the pane, the model and the state,
// all of which the chosen row says one column to the left, and it cost 56
// pixels on every tab for ever. This stands in one place, for as long as one
// agent is stopped, and it is the last thing in the conversation because it
// *is* the last thing in the conversation — the transcript ends at its foot,
// which is where a question belongs and where your eye already is. Answering
// is sending, so it sits with the send box.
//
// The row still goes amber from any tab, which is what the row is for. This
// is the answer to "what is it asking", and that question is asked here.
//
// `asking` is cleared wherever the attention is, and exactly by its own
// `tool_use_id` when the answer lands — so answering in the terminal takes
// this away too, within a second.
function drawAsking() {
  const box = $("asking");
  const s = current();
  // `state.tab` and not the content box: this is chrome outside that box,
  // like the send box, and it is drawn after `showTab` has set the name.
  const here = !!s && state.tab === "transcript";
  const ask = here ? s.asking : null;
  // A permission dialog stands in the same place: it is the other thing an
  // agent waits on, and the two are never up at once -- a question is a
  // tool too, but it is not kept as a permission.
  const permission = here && !ask ? s.permission : null;
  box.hidden = !ask && !permission;
  if (!ask && !permission) {
    // And forget what was drawn, or the same question asked twice in a row
    // would match the key and leave an empty bar standing.
    box.dataset.ask = "";
    box.replaceChildren();
    return;
  }
  if (permission) {
    drawPermission(box, s, permission);
    return;
  }
  // The rows arrive about once a second while an agent works. Rebuilding
  // under a button the reader is about to press is how a click lands on the
  // wrong option. Painted, though, as `drawPermission` paints its No: submit
  // is held while something is on its way to the session, and that ends
  // with no click on the bar.
  if (!fresh(box, "ask", s.id + "\n" + ask.id)) {
    paintPicks(box, ask);
    return;
  }
  // A pick belongs to the question it was made for. A different question
  // arriving takes the old picks with it rather than submitting them. An ask
  // with no id matches the empty picks the page starts with, so the shape is
  // asked as well: `paintPicks` threw on a question with no list of picks,
  // and took `drawHeader` -- jump, the send box, the strip -- down with it.
  if (state.picked.id !== ask.id
      || state.picked.at.length !== ask.questions.length) {
    state.picked = { id: ask.id, at: ask.questions.map(() => []) };
  }
  box.replaceChildren();
  ask.questions.forEach((one, which) => {
    const block = put(box, "div", "askone");
    if (one.header) put(block, "div", "askhead", one.header);
    put(block, "p", "askwhat", one.question);
    if (one.many) put(block, "div", "asknote", "pick as many as apply");
    // Beside the options, as the dialog draws it: under them, the box stood
    // below the bar's fold, and a preview you have to scroll to is one you
    // choose without.
    const body = one.preview ? put(block, "div", "askbeside") : block;
    const list = put(body, "div", "askopts");
    one.options.forEach((option, at) => {
      const button = put(list, "button", "askopt");
      // The number it will press, shown. What reaches your terminal should
      // not be a thing you have to trust.
      put(button, "span", "asknum", String(at + 1));
      const text = put(button, "span", "asktext");
      put(text, "span", "asklabel", option.label);
      if (option.description) put(text, "span", "askwhy", option.description);
      // Picking types nothing. It marks, and it can be changed: a click that
      // went straight into a terminal was a click you could not take back,
      // on a page you may have opened on a phone in a pocket.
      // A multiple-choice question ticks and unticks, the way its own
      // dialog does; a single-choice one moves the one pick.
      button.addEventListener("click", () => {
        const now = state.picked.at[which];
        state.picked.at[which] = !one.many ? [at]
          : now.includes(at) ? now.filter((was) => was !== at) : now.concat(at);
        paintPicks(box, ask);
      });
    });
    // Claude Code draws this question beside a box, and the box shows the
    // preview of the option under its cursor -- a code sketch, a layout,
    // often the thing the choice is about. The options alone left the
    // reader choosing without it. Here the box follows the pick, which
    // types nothing, so clicking through the options is how to read them;
    // before a pick it shows the first, where the dialog's cursor starts.
    if (one.preview) {
      const pane = put(body, "div", "askpreview");
      put(pane, "div", "askprevhead");
      put(pane, "pre", "askprevbody");
    }
  });
  const foot = put(box, "div", "asksend");
  const send = put(foot, "button", "verb");
  send.addEventListener("click", () => submitAsk(s.id, ask, box));
  put(foot, "span", "asksays");
  paintPicks(box, ask);
}

// The permission dialog, whole, and the one answer this page gives it: No.
//
// **Never Yes.** A dialog carries no id, so nothing here can prove which one
// a press lands on; a wrong No is undone by saying what to do instead, and a
// wrong Yes is not. So the request is shown field by field -- `textContent`,
// every one, because an agent wrote them -- and approving is left to the
// terminal, which the first button opens.
//
// No is Escape, and the reason is typed after it only once the daemon has
// seen the dialog close (`decline`). The box keeps what is typed across the
// pushes, because it is only built again for another dialog.
function drawPermission(box, s, permission) {
  if (!fresh(box, "ask", s.id + "\npermission\n" + permission.key)) {
    paintDecline(box, s, permission);
    return;
  }
  box.replaceChildren();
  const block = put(box, "div", "askone");
  put(block, "div", "askhead", permission.plan ? "plan" : "permission");
  if (permission.plan) {
    // The plan itself is in the transcript, drawn as Markdown and whole;
    // here it was its source in a box, cut off (#372).
    const what = put(block, "p", "askwhat", "It asks to start on the plan above. ");
    const read = put(what, "button", "link", "read the plan");
    read.addEventListener("click", () => {
      const at = lastPlan(permission.call);
      const node = at === null ? null : state.turns.nodes[at];
      if (node) node.scrollIntoView({ block: "start" });
    });
  } else {
    put(block, "p", "askwhat", "May it use " + (permission.tool || "this tool") + "?");
  }
  if (permission.withheld) {
    put(block, "p", "asknote",
        "This request is too long to show here. Read it in the terminal.");
  }
  for (const [name, text] of permission.fields || []) {
    const field = put(block, "div", "permfield");
    put(field, "div", "askprevhead", name);
    put(field, "pre", "askprevbody", text);
  }
  // The send box is away while this is up, and this is where the reader
  // looks for it. The daemon refuses a send here too (`send`).
  if (s.pane) {
    put(block, "p", "asknote",
        "The send box is back when this dialog closes: its Enter would say Yes.");
  }
  const foot = put(box, "div", "asksend permsend");
  // Absent with no pane, like jump everywhere else: there is nothing to open.
  if (s.pane) {
    const open = put(foot, "button", "verb");
    open.textContent = "open the terminal";
    open.addEventListener("click", jumpToPane);
  }
  const why = put(foot, "textarea", "say permwhy");
  why.rows = 1;
  why.placeholder = "what it should do instead (optional)";
  why.style.setProperty("--fits", why.placeholder.length + "ch");
  // Kept for this dialog across a look at another tab, which builds the
  // bar again: half a reason lost that way is the question bar's scar.
  if (state.declineWhy.key === permission.key) why.value = state.declineWhy.text;
  // It grows with what is typed, as every other box here does: one row
  // high, a long reason wrapped onto rows nobody could see.
  why.addEventListener("input", () => {
    state.declineWhy = { key: permission.key, text: why.value };
    fitSay(why);
  });
  const no = put(foot, "button", "verb permno");
  no.textContent = "no";
  no.addEventListener("click", () => submitDecline(s.id, permission, box));
  submitOnCtrlEnter(why, no);
  put(foot, "span", "asksays");
  paintDecline(box, s, permission);
  fitSay(why);   // a reason kept from before, or a placeholder on a narrow bar
}

// The place of the plan a dialog asks about: the call's own block when the
// dialog knows its call, or else the last plan in the transcript.
function lastPlan(call) {
  const blocks = state.turns.blocks;
  for (let at = blocks.length - 1; at >= 0; at -= 1) {
    const block = blocks[at];
    if (block && block.kind === "plan"
        && (!call || block.tool_use_id === call)) return at;
  }
  return null;
}

// What pressing no would do, said before it is pressed.
function paintDecline(box, s, permission) {
  const no = box.querySelector(".permno");
  const why = box.querySelector(".permwhy");
  const says = box.querySelector(".permsend .asksays");
  if (!no || !why || !says) return;
  const cannot = whyNotTyped(s, true);
  // Without its call nothing can prove the dialog closed, so no reason is
  // typed -- and a box that takes one and then drops it is worse than none.
  const reasons = !cannot && !!permission.call;
  why.disabled = !reasons;
  // Off while something else is on its way to the session, as submit on a
  // question is: `submitDecline` refuses then, and a No that could be
  // pressed and did nothing, with no word why, read as a broken button.
  // Its own No is on its way too, and says what it does, not that it waits.
  const mine = no.dataset.busy === "1";
  const busy = sending.has(s.id) && !mine;
  no.disabled = !!cannot || mine || busy;
  // Said in both cases: a Yes given in the terminal fires no hook, so the
  // row stays amber while the approved call runs, and Escape then stops it.
  const already = " If you already answered in the terminal, Escape stops the agent.";
  says.textContent = cannot ? cannot
    : busy ? "waiting for what is on its way to this session"
    : !reasons
    ? "presses Escape. A reason cannot be typed for this one: send it after."
      + already
    : "presses Escape, then types your reason once the dialog has closed."
      + already;
}

async function submitDecline(id, permission, box) {
  const no = box.querySelector(".permno");
  const why = box.querySelector(".permwhy");
  // One thing typed into a session at a time: the send box and a No share
  // the guard, because a send landing between the Escape and the proof
  // would be typed into a dialog that may still be up.
  // Marked as its own before the guard is taken, which paints the bar: the
  // mark is what keeps the bar from saying it waits for this very No.
  if (!no || no.disabled) return;
  no.dataset.busy = "1";
  if (!startSending(id)) { no.dataset.busy = ""; return; }
  no.disabled = true;
  const reason = why && !why.disabled ? why.value : "";
  let answer;
  try {
    answer = await tell(id, "decline", { key: permission.key, reason });
  } finally {
    doneSending(id);
  }
  no.dataset.busy = "";
  if (!answer || !answer.done) {
    said(answer);
    no.disabled = false;
    return;
  }
  // Declined, and maybe the reason held back: that is said, and stays.
  said(answer);
  if (!answer.error) {
    if (why) why.value = "";
    state.declineWhy = { key: "", text: "" };
    note(answer.sent ? "declined, and your reason was typed" : "declined");
  }
}

// What is picked, and what pressing submit would do. Everything that changes
// when a reader clicks an option lives here, so picking never rebuilds the
// bar: a rebuild under the hand is how a click lands on the wrong option.
function paintPicks(box, ask) {
  const picked = state.picked.at;
  box.querySelectorAll(".askone").forEach((block, which) => {
    block.querySelectorAll(".askopt").forEach((button, at) => {
      const on = picked[which].includes(at);
      button.classList.toggle("chosen", on);
      if (ask.questions[which].many) button.setAttribute("aria-pressed", String(on));
    });
    const pane = block.querySelector(".askpreview");
    if (!pane) return;
    const at = picked[which].length ? picked[which][0] : 0;
    const option = ask.questions[which].options[at];
    // Only when it moved: this runs on every push now, and text set again
    // takes away what the reader has selected in it.
    setText(pane.querySelector(".askprevhead"),
            "preview of " + (at + 1) + ". " + option.label);
    const body = pane.querySelector(".askprevbody");
    // `textContent`, never markup: an agent wrote this.
    setText(body, previewText(option));
    body.classList.toggle("none", !option.preview);
  });
  const ready = picked.every((at) => at.length > 0);
  const send = box.querySelector(".asksend .verb");
  const says = box.querySelector(".asksays");
  // Reading the question is worth having wherever the session runs -- it is
  // the one thing this page exists to tell you. *Answering* it is keystrokes
  // into a tmux pane, and a session outside tmux has none, so the button is
  // refused rather than left to fail on the press. The review's send has
  // said this for as long as it has existed; this bar did not, and
  // offered "presses 1" to a terminal that could never be typed into.
  const s = current();
  const cannot = whyNotTyped(s);
  // Keys go by position, so a question the daemon could not keep whole --
  // an option left out moves every key after it -- is shown and not typed.
  const whole = ask.answerable !== false;
  // Held while its keys are on their way, and once they went in. A click on
  // an option, or a look at another tab, painted submit back on while the
  // first answer's keys were still going in `KEY_GAP` apart; a second
  // submit mixed its keys with them. After they went in, the question
  // stays until the `PostToolUse` says so, and a second set of keys would
  // land on whatever the agent does next. Asked by the ask's id, never of
  // `state.picked`, which a look at another question builds again.
  const busy = !!s && sending.has(s.id);
  const pressed = state.answered.has(ask.id);
  send.disabled = !ready || !!cannot || !whole || busy || pressed;
  send.textContent = "submit";
  // Said before it is pressed, not after. These are keystrokes into a live
  // terminal, and the reader is the one answerable for them.
  setText(says, cannot ? cannot
    : !whole ? "this question is too large to answer here; answer it in the terminal"
    : pressed ? "pressed. If the question stays, answer it in the terminal"
    : busy ? "waiting for what is on its way to this session"
    : ready
    ? "presses " + askKeys(ask, picked).map((keys) => keys.join(" ")).join(", then ")
    : (picked.length > 1 ? "pick an answer to each" : "pick an answer"));
}

// Text into a node only when it is not already there. Assigning the same
// words again replaces the text node, and a selection in it goes too.
function setText(node, text) {
  if (node.textContent !== text) node.textContent = text;
}

// What the preview box says for one option, in Claude Code's own words where
// it has some. Its box renders the preview as Markdown, so a sketch wrapped
// in one code fence shows there without the fence; here the fence comes off
// the same way, and anything else stands as written, with its lines and its
// indentation -- which is what a layout drawn in text needs.
function previewText(option) {
  if (option.withheld) {
    return "(preview cannot be shown in full \u2014 compare the option " +
      "labels and descriptions instead)";
  }
  if (!option.preview) return "No preview available";
  const fenced = /^\s*```[^\n]*\n([\s\S]*?)\n```\s*$/.exec(option.preview);
  return fenced ? fenced[1] : option.preview;
}

// The keys that answer a question, grouped by question, for saying before
// they are pressed. The daemon works out the same keys for itself from the
// picks (`ask_keys`) and presses those; this is the reader's preview of them,
// and `test_the_page_says_the_keys_the_daemon_presses` holds the two together.
//
// Claude Code's own dialog, measured: a single-choice question takes its
// digit, which answers and moves on -- but beside a preview the digit only
// moves the cursor, and Enter answers; a multiple-choice one takes a digit
// per option and then Tab; a review follows the last question and takes
// Enter -- except after one single-choice question, which has no review.
function askKeys(ask, picked) {
  const keys = ask.questions.map((one, which) => {
    const numbers = picked[which].map((at) => at + 1).sort((a, b) => a - b)
      .map(String);
    if (one.many) return numbers.concat("Tab");
    return one.preview ? numbers.concat("Enter") : numbers;
  });
  if (ask.questions.length > 1 || ask.questions[0].many) keys.push(["Enter"]);
  return keys;
}

// Answer in the agent's terminal.
//
// The page sends which options were picked and nothing else; the daemon
// works the keys out from the question it holds and presses them one at a
// time (`answer`, `ask_keys`, `tmux_keys`). It used to send each number
// through `send`, which presses Enter after it -- and in Claude Code's dialog
// a digit already answers a single-choice question and moves on, so that
// Enter answered the next question with whatever option was under the
// cursor, and a multiple-choice question was never submitted at all.
//
// The question does not go away here. It goes away when the daemon sees the
// `PostToolUse` for this exact `tool_use_id`, which is the only thing that
// knows the answer landed — clearing it on the click would hide a question
// that a missed keystroke left standing.
async function submitAsk(id, ask, box) {
  const send = box.querySelector(".asksend .verb");
  // One thing typed into a session at a time, as the send box and a No:
  // a message landing between the answer's keys is typed into the dialog.
  if (!send || send.disabled || !startSending(id)) return;
  const picks = state.picked.at.map((at) => at.map((one) => one + 1));
  let answer;
  try {
    answer = await tell(id, "answer", { ask: ask.id, picks });
  } finally {
    // Marked before the guard lets go, which paints the bar again: for a
    // moment in between, submit was on for keys that had gone in.
    if (answer && !answer.error) state.answered.add(ask.id);
    doneSending(id);
  }
  said(answer);              // an earlier refusal is no longer news
  if (answer && !answer.error) note("pressed " + (answer.keys || []).join(" "));
}

function drawHeader() {
  // All that is left of a bar that used to stand over every tab saying the
  // branch, the pane, the model and the state — which the chosen row already
  // says, one column to the left. The send box is what remains, and it
  // belongs to the transcript: there is nowhere else on this page you would
  // type to an agent.
  //
  // The open question is drawn from here rather than from four call sites,
  // so a fifth cannot forget it. It is the other thing that lives outside a
  // tab, and for the same reason: it belongs to the session, not to a tab.
  drawAsking();
  drawContext();
  const s = current();
  // Absent, not disabled, for a session with no pane: there is nothing to
  // jump to, and a button that cannot work is not offered.
  $("jump").hidden = !s || !s.pane;
  drawReviewBar();
  const was = $("sendbar").hidden;
  // And away while a permission dialog is up: its cursor starts on "1. Yes",
  // so the Enter after a message approves, and a digit picks an option. The
  // dialog's bar says so where the box stood; the daemon refuses it anyway.
  $("sendbar").hidden = state.tab !== "transcript" || !!whyNotTyped(s);
  drawResume(s);
  // Only when it appears. `drawHeader` runs on every push from the daemon,
  // which is about once a second while an agent works, and `fitSay` reads a
  // layout it has just made dirty. What is in the box cannot change without
  // the reader typing, and that has its own listener.
  if (was && !$("sendbar").hidden) fitSay();
}

// Where the send box stands for a session that can still be typed into: for
// one that is over, the line that brings it back, to copy (#352). After a
// reboot, or tmux gone, every session comes back with one paste. The page
// starts nothing and types nothing: the reader runs it, where they want it.
function drawResume(s) {
  const bar = $("resumebar");
  const line = state.tab === "transcript" && s && isGone(s) ? s.resume || "" : "";
  bar.hidden = !line;
  if (!fresh(bar, "line", line) || !line) return;
  bar.replaceChildren();
  const words = put(bar, "div", "resumewords");
  put(words, "div", "resumesays", "This session is over. To carry on with it, run:");
  put(words, "code", "resumeline", line);
  const copy = put(bar, "button", "verb", "copy");
  copy.title = "copy the command";
  copy.addEventListener("click", async () => {
    const done = await copyToClipboard(line);
    flashOutcome(copy, "copy", "copy the command", done,
                 done ? "copied" : "the browser would not copy it", ["copied", "cannot"]);
  });
}

// How full the chosen session's window is, in the strip at the end of the tab
// row. It is drawn from `drawHeader`, so it arrives with everything else the
// push carries and no fifth call site can forget it.
//
// It is its own element and not `#live`: `paintLive` is the one writer of
// that slot and three things already want it -- what the stream is doing,
// something you asked for and did not get, and a passing word over both. A
// fourth would be the race that rule was written after.
function drawContext() {
  const slot = $("ctxslot");
  if (!slot) return;
  const s = current();
  const spent = s && s.cost_usd !== null && s.cost_usd !== undefined
    ? money(s.cost_usd) : "";
  // Which model the session runs, left of the bar it fills. It changes
  // with `/model` mid-session, and it is what the percentage is a
  // percentage of, so it stands beside it. The status line sends it; without one there is nothing to say.
  const model = (s && s.model) || "";
  const effort = (s && s.effort) || "";
  slot.hidden = !hasContext(s) && !spent && !model;
  if (slot.hidden) {
    slot.replaceChildren();
    slot.dataset.shows = "";
    showModels(false);
    return;
  }
  const shows = [model, effort, hasContext(s) ? Math.round(s.context_pct) : "",
                 spent].join("\n");
  if (!fresh(slot, "shows", shows)) return;  // a push a second, rarely moved
  slot.replaceChildren();
  // The model and how hard it thinks (issue 337), as one button that opens
  // the menu to change them (issue 338): see `putModels`.
  if (model) {
    const button = put(slot, "button", "model", model);
    if (effort) put(button, "span", "effort", " · " + effort);
    button.title = "change the model or the effort";
    button.setAttribute("aria-haspopup", "true");
    button.setAttribute("aria-expanded", String(!$("modelpop").hidden));
    button.addEventListener("click", (press) => {
      press.stopPropagation();          // or the page's listener shuts it
      showModels($("modelpop").hidden);
    });
  }
  if (hasContext(s)) putContext(slot, s.context_pct);
  if (spent) {
    // Claude Code works this out on the client at list price and says so, and
    // it goes back to nought on `/clear`. The caveat is worth carrying and is
    // not worth the width of the strip, so it is on the number.
    // Not `money`: that is the function two lines up, and a `const` of the
    // same name here puts that call in the temporal dead zone -- a
    // ReferenceError on every draw, from a name that reads fine.
    const shown = put(slot, "span", "spent", spent);
    shown.title = "What this session has spent, as Claude Code estimates it:"
      + " list price, worked out in your terminal, and it may differ from"
      + " your bill. It starts again at zero after /clear.";
  }
}

// The models and the effort levels the menu offers, as `/model` and
// `/effort` take them. Measured on Claude Code 2.1.287: each of these went
// in typed, and `default` takes the choice out of Claude Code's settings
// again. Its own menu lists the same five models.
const MODELS = ["default", "opus", "fable", "sonnet", "haiku"];
// Only aliases here. A full id comes from the sessions (`model_id`).
const EFFORTS = ["low", "medium", "high", "xhigh", "max"];

// The menu under the model: a choice of model and of effort, each typed into
// the agent's pane as `/model <name>` or `/effort <level>` through `send`,
// the verb the send box uses (issue 338). **It says that the choice is the
// default for new sessions too**: measured on 2.1.287, a typed `/model` or
// `/effort` writes Claude Code's own settings file, and only its menu in the
// terminal offers "this session only". The reader chose this over opening
// that menu, knowing it.
function showModels(open) {
  const pop = $("modelpop");
  const button = document.querySelector("#ctxslot .model");
  if (open && button) putModels(pop, button);
  pop.hidden = !open || !button;
  if (button) button.setAttribute("aria-expanded", String(!pop.hidden));
  if (pop.hidden) return;
  // Under the button, and inside the window: it is wider than the button,
  // which stands near the right edge.
  const at = button.getBoundingClientRect();
  const most = window.innerWidth - pop.offsetWidth - 8;
  pop.style.left = Math.max(8, Math.min(Math.round(at.left), most)) + "px";
  pop.style.top = Math.round(at.bottom + 8) + "px";
}

function putModels(pop, button) {
  const s = current();
  pop.replaceChildren();
  const why = s ? whyNotTyped(s) : "no session is chosen";
  // An alias names the newest of a family as this Claude Code maps it, so
  // none is pressed: which one the session runs is the full id, below.
  put(pop, "span", "setlabel", "model");
  putChoice(pop, "models", MODELS.map((one) => [one, one]),
            (one) => pickModel("/model " + one));
  // The full ids of the models the sessions on this page ran, which the
  // daemon keeps for a week: an older one, such as claude-opus-5, which no
  // alias reaches -- measured, `/model claude-opus-5` gave "Opus 5". From
  // what was run, so nothing here is a list to keep up to date by hand.
  const used = [...new Set(state.sessions.map((one) => one.model_id)
                                          .filter(Boolean))].sort();
  if (used.length) {
    put(pop, "span", "setlabel", "used");
    const ids = putChoice(pop, "usedmodels", used.map((one) => [one, one]),
                          (one) => pickModel("/model " + one));
    paintChoice(ids, (s && s.model_id) || "");
  }
  // Only while the session says how hard it thinks: a model with no effort
  // -- Haiku -- has nothing here to set.
  if (s && s.effort) {
    put(pop, "span", "setlabel", "effort");
    const efforts = putChoice(pop, "efforts", EFFORTS.map((one) => [one, one]),
                              (one) => pickModel("/effort " + one));
    paintChoice(efforts, s.effort);
  }
  put(pop, "p", "modelnote", why
    ? "It cannot be changed from here: " + why + "."
    : "Typed into the session as /model or /effort. Claude Code also makes"
      + " it the default for new sessions.");
  for (const one of pop.querySelectorAll(".choice button")) one.disabled = !!why;
}

async function pickModel(text) {
  showModels(false);
  const id = state.chosen;
  if (!id || !startSending(id)) return;
  let answer;
  try {
    answer = await tell(id, "send", { text });
  } finally {
    doneSending(id);
  }
  said(answer);
  if (answer && answer.done) note("typed " + text);
}

// What a session has spent. Cents below ten dollars, because that is where
// the difference between one prompt and the next shows; whole dollars above
// it, because by then the cents are noise in a strip that has to stay short.
// The daemon's `money` says the same thing for its own status line.
function money(dollars) {
  return dollars < 10 ? "$" + dollars.toFixed(2)
                      : "$" + Math.round(dollars);
}

// --- the tab icon and the tab's title --------------------------------------
//
// The tab is what the reader sees from another tab, so it says who needs
// them in its words and what state the lot is in in its colour. It was a
// dot in the state's colour and the word "wostuast": the blue of "ready"
// sat beside the blue of Jira and Bitbucket, and the dot said nothing about
// what the tab was. The reader chose a terminal that is a robot's head --
// the agents live in terminals -- from pictures of eight.

// The title leads with what matters, because a tab cuts its end off: the
// names of the sessions that need you, or else how many work, or else how
// many are ready. By the name on the row, so the tab and the list agree.
function tabTitle(sessions) {
  const needs = sessions.filter(needsYou);
  if (needs.length) {
    const names = needs.slice(0, 2).map((s) => clip(rowName(s), 30));
    const more = needs.length > 2 ? " +" + (needs.length - 2) : "";
    return names.join(", ") + more
      + (needs.length === 1 ? " asks" : " need you") + " \u00b7 wostuast";
  }
  // What is unread comes next (#373): it is what to read when nothing waits.
  const unread = sessions.filter((s) => s.unread).length;
  const first = unread ? unread + " unread \u00b7 " : "";
  const working = sessions.filter((s) => s.state === "working").length;
  if (working) return first + working + " working \u00b7 wostuast";
  const ready = sessions.filter((s) => s.state === "done").length;
  return first + (ready ? ready + " ready \u00b7 wostuast" : "wostuast");
}

function clip(text, most) {
  return text.length > most ? text.slice(0, most - 1) + "\u2026" : text;
}

// The robot: a head with an antenna, one big eye and one small one -- a
// look that doubts a little -- and a wide, quiet smile. The whole of it is
// the state's colour: a line under it in that colour was too thin to see in
// a tab bar. The eyes and the mouth are cut out, so the tab shows through
// them in either bar. The reader chose it from pictures. 32 x 32, for a
// screen of twice the density; the browser draws it at 16.
function paintIcon(pen, colour) {
  const box = (x, y, w, h, r) => {
    pen.beginPath(); pen.moveTo(x + r, y); pen.arcTo(x + w, y, x + w, y + h, r);
    pen.arcTo(x + w, y + h, x, y + h, r); pen.arcTo(x, y + h, x, y, r);
    pen.arcTo(x, y, x + w, y, r); pen.closePath();
  };
  const disc = (x, y, r) => {
    pen.beginPath(); pen.arc(x, y, r, 0, Math.PI * 2); pen.fill();
  };
  pen.clearRect(0, 0, 32, 32);
  pen.fillStyle = pen.strokeStyle = colour;
  pen.lineWidth = 2.6; pen.lineCap = "round";
  pen.beginPath(); pen.moveTo(16, 8); pen.lineTo(16, 3); pen.stroke();
  disc(16, 3, 2.8);
  box(0.5, 8, 31, 23, 6); pen.fill();
  pen.save();
  pen.globalCompositeOperation = "destination-out";
  disc(10, 16.5, 4.6);
  disc(23, 17.5, 2.6);
  pen.lineWidth = 2.8;
  pen.beginPath(); pen.moveTo(9, 24.5);
  pen.quadraticCurveTo(16, 27.7, 23, 24.5); pen.stroke();
  pen.restore();
}

// Which bar the icon stands in. The browser's own light or dark, which is
// what this media query answers -- the page's theme may be the other one.
function tabBarIsDark() {
  return systemTheme() === "dark";
}

let iconWas = "";

function redrawIcon() {
  const was = iconWas.split(" ")[0];
  iconWas = "";
  if (was) drawIcon(was);
}

function drawIcon(state_) {
  const dark = tabBarIsDark();
  const key = state_ + " " + dark;
  if (key === iconWas) return;
  iconWas = key;
  const shown = state_ === "needs_you" ? "needs"
                : state_ === "working" ? "working" : "ready";
  const picture = iconPicture(shown);
  if (!picture) return;
  let link = document.querySelector("link[rel='icon']");
  if (!link) {
    link = document.createElement("link");
    link.rel = "icon";
    document.head.appendChild(link);
  }
  link.href = picture;
}

// The robot of the tab's icon as a picture: in the colour of `shown` --
// "needs", "working" or "ready" -- for the system's own light or dark.
// The tab's icon and an alert's are the one drawing. "" where a canvas
// cannot be had.
function iconPicture(shown) {
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = 32;
  const pen = canvas.getContext("2d");
  if (!pen) return "";
  const palette = getComputedStyle(document.documentElement);
  paintIcon(pen, palette.getPropertyValue(
    "--tab-" + shown + (tabBarIsDark() ? "-dark" : "-light")).trim());
  return canvas.toDataURL("image/png");
}

// --- telling you when an agent wants you ------------------------------------
//
// Two things are worth being told about, and they are not the same thing. An
// agent that needs you cannot go on without you; an agent that has finished
// is a turn you can read. The first is why this program exists, so it is on
// as soon as alerts are; the second is a choice, so it is off until asked
// for. One switch for both would mean taking the one you want with the one
// you do not.
//
// Both are in `settings.json`, as `alerts`, set from the settings menu.

const waiting = new Set();

//: What each session was doing last time round, so "it has finished" can be
//: a change rather than a state. A session already finished when the page
//: opens is not news, and it has no entry here on the first pass.
const wasDoing = new Map();

// What `settings.json` says, which the daemon has checked the shape of.
function alertsWanted() {
  const kept = setting("alerts");
  if (kept && typeof kept === "object") {
    return { needs: kept.needs === true, done: kept.done === true };
  }
  // Nothing kept. If this browser has already allowed alerts then the
  // reader has said yes to being told things, and the needs-you one is what
  // they were saying yes to -- so it is on, which is the default the issue
  // asks for. Without permission nothing can arrive whatever this says, and
  // a switch that claims to be on while nothing happens is worse than off.
  //
  // The needs-you alert is on the moment alerts are: it is the one thing this
  // tool exists to tell you. The finished one is a choice.
  return { needs: alertsCan(), done: false };
}

function alertsCan() {
  return "Notification" in window && Notification.permission === "granted";
}

function drawBell() {
  const button = $("settings");
  if (!button) return;
  const can = "Notification" in window;
  const want = alertsWanted();
  const on = alertsCan() && (want.needs || want.done);
  const word = !can ? "no alerts" : on ? "alerts on" : "alerts off";
  button.querySelector(".offmark").hidden = on;
  button.dataset.alerts = on ? "on" : "off";
  button.setAttribute("aria-label", "settings, " + word);
  button.title = "settings: colours, alerts, how code is drawn, ticket links"
    + "  \u00b7  " + word;
  $("alertneeds").checked = want.needs;
  $("alertdone").checked = want.done;
  $("alertnote").textContent = !can
    ? "This browser cannot show alerts."
    : Notification.permission === "denied"
      ? "This browser is blocking alerts for this page. Allow them in its"
        + " site settings and they will start."
      : Notification.permission === "granted"
        ? "Shown by your browser, once per session, while this page is open."
        : "Tick one and your browser will ask whether to allow alerts.";
}

// Ticking a box is what asks for permission, so nobody is asked before they
// have said what they want. A refusal leaves the box ticked and the note
// saying why nothing arrives -- unticking it silently would read as the page
// having lost the click.
async function setAlert(which, on) {
  const want = alertsWanted();
  want[which] = on;
  keepSetting({ alerts: want });
  if (on && "Notification" in window && Notification.permission === "default") {
    await Notification.requestPermission();
  }
  drawBell();
}

function showSettings(open) {
  // The link rows are the file's when the menu opens, and the reader's
  // while it is open: a push never rebuilds them. A rebuild took a red row,
  // a half-filled one and an empty new one, none of which is in any file;
  // three guards each covered one way a push could land, and missed others.
  if (open && $("setpop").hidden) putLinkRows();
  $("setpop").hidden = !open;
  $("settings").setAttribute("aria-expanded", String(open));
  if (open) {
    paintSettings();
    paintExamples();
  }
}

// The settings menu, built once: the colours, the two alerts, and how code
// is drawn -- the tab width and long lines (the Files tab and the Review
// tab, on the root, so nothing is rebuilt: a rebuild would take an open
// comment box with it), and the diff's columns, through `keepSides`, which
// refuses while a comment is being written. Then the ticket links, and
// where the file is that holds all of it. The alert boxes keep their ids,
// so `drawBell` and `setAlert` work as they did under the bell.
function putSettings() {
  const pop = $("setpop");
  const label = (text, icon) => {
    const one = put(pop, "span", "setlabel");
    putIcon(one, icon);
    put(one, "span", null, text);
  };
  const choice = (name, options, pick) => putChoice(
    pop, name, options, (value) => { pick(value); paintSettings(); });
  label("colours", "palette");
  choice("colours", [["system", "auto", "themeAuto"], ["light", "light", "sun"],
                     ["dark", "dark", "moon"]], applyTheme)
    .setAttribute("aria-label", "colours");
  label("alerts", "bell");
  const checks = put(pop, "div", "checks");
  for (const [id, word, icon, cls] of [
    ["alertneeds", "an agent needs you", "person", "needs"],
    ["alertdone", "an agent has finished", "check", "done"]]) {
    const one = put(checks, "label", cls);
    const box = put(one, "input");
    box.type = "checkbox";
    box.id = id;
    putIcon(one, icon);
    put(one, "span", null, word);
  }
  put(checks, "span", "alertnote").id = "alertnote";
  put(pop, "div", "rule");
  label("tab", "tabWidth");
  choice("tabwidth", TAB_WIDTHS.map((width) => [width, String(width)]),
         (tab) => { keepSetting({ tab_width: tab }); applyReading(readingWanted()); });
  label("lines", "wrap");
  choice("wrapping", [[false, "scroll", "scroll"], [true, "wrap", "wrap"]],
         (wrap) => {
           keepSetting({ long_lines: wrap ? "wrap" : "scroll" });
           applyReading(readingWanted());
         });
  label("diff", "twoColumns");
  choice("sides", [["unified", "one", "oneColumn"], ["split", "two", "twoColumns"]],
         keepSides);
  put(pop, "div", "rule");
  label("links", "link");
  const links = put(pop, "div", "linkedit");
  put(links, "div", "linklist").id = "linklist";
  const add = put(links, "button", "verb quiet linkadd", "+ add a link");
  add.addEventListener("click", () => {
    putLinkRow($("linklist"), { match: "", url: "", trouble: "" })
      .querySelector("input").focus();
  });
  put(pop, "div", "rule");
  const where = put(pop, "div", "where");
  putIcon(where, "file");
  const words = put(where, "span", null, "saved to ");
  put(words, "span", "wherepath").id = "settingspath";
  const copy = put(where, "button", "wherecopy");
  copy.title = "copy the path";
  copy.setAttribute("aria-label", "copy the path");
  putIcon(copy, "copy");
  copy.addEventListener("click", async () => {
    if (await copyToClipboard(setting("path") || "")) note("path copied");
  });
  const button = $("settings");
  putIcon(button, "sliders");
  putIcon(put(button, "span", "offmark"), "bellOff");
}

function paintSettings() {
  const pop = $("setpop");
  if (!pop || !pop.firstChild) return;
  const reading = readingWanted();
  const now = { colours: themeChoice(), tabwidth: String(reading.tab),
                wrapping: String(reading.wrap), sides: state.sides };
  for (const [name, value] of Object.entries(now)) {
    paintChoice(pop.querySelector("." + name), value);
  }
  $("settingspath").textContent = setting("path") || "";
}

// --- the ticket links, in the settings menu ---------------------------------
//
// One row a link: what to find, a regular expression, and where it links
// to, with `$1` for its first group. A row is saved when the reader leaves
// a box or presses Enter, as every other setting is saved the moment it is
// picked -- there is no save button. A row that cannot be used is red, says
// why, and is not saved; the rest are.

// The daemon's words name the file's keys; the menu names its boxes.
function linkWords(text) {
  return String(text).replace(/`match`/g, "\u201cfind\u201d")
    .replace(/`url`/g, "\u201clink to\u201d");
}

function putLinkRow(list, one) {
  const row = put(list, "div", "linkrow");
  put(row, "span", "linkword", "find");
  const match = put(row, "input", "linkmatch");
  const drop = put(row, "button", "linkdrop", "\u00d7");
  put(row, "span", "linkword", "link to");
  const url = put(row, "input", "linkurl");
  put(row, "span", "linksays");
  for (const [box, value, hint, word] of [
    [match, one.match, "PROJ-(\\d+)", "find: a regular expression"],
    [url, one.url, "https://tickets.example.com/browse/PROJ-$1",
     "link to: $1 is the first group"]]) {
    box.type = "text";
    box.value = value;
    box.placeholder = hint;
    box.spellcheck = false;
    box.autocomplete = "off";
    box.setAttribute("aria-label", word);
    // Leaving the box is the save; Enter leaves it.
    box.addEventListener("change", saveLinks);
    box.addEventListener("keydown", (press) => {
      if (press.key !== "Enter" || composing(press)) return;
      press.preventDefault();
      box.blur();
    });
  }
  drop.title = "remove this link";
  drop.setAttribute("aria-label", "remove this link");
  drop.addEventListener("click", () => {
    row.remove();
    saveLinks();
  });
  if (one.trouble) sayLink(row, linkWords(one.trouble), one.field || "match");
  return row;
}

// What a row says under its boxes: why it is not saved, or nothing, and
// then `paintExamples` writes what it links. `field` is the box the trouble
// is about, which wears the red; the daemon names it (`trouble_field`).
function sayLink(row, text, field) {
  row.dataset.said = text ? "yes" : "";
  row.dataset.bad = field || "";
  row.querySelector(".linksays").textContent = text;
}

// What only this side can tell: a row half filled in, and a pattern this
// browser will not compile. Everything else is the daemon's `link_trouble`,
// the one check there is, so a second copy cannot drift from it.
function linkProblem(match, url) {
  if (!match && !url) return { say: "", field: "", send: false };
  if (!match || !url) return { say: "fill in both to save it", field: "", send: false };
  try {
    new RegExp(match, "g");
  } catch (error) {
    // Chromium says "Invalid regular expression: /BUG-(\d+/g: Unterminated
    // group", the pattern again and the flags; the reason is the last part.
    const why = error.message.replace(/^Invalid regular expression: \/.*\/[a-z]*: /, "");
    return { say: "\u201cfind\u201d is not a regular expression: " + why
                  + " \u00b7 not saved", field: "match", send: false };
  }
  return { say: "", field: "", send: true };
}

async function saveLinks() {
  const sent = [];
  const rows = [];
  for (const row of $("linklist").querySelectorAll(".linkrow")) {
    const [match, url] = row.querySelectorAll("input");
    const problem = linkProblem(match.value, url.value);
    sayLink(row, problem.say, problem.field);
    if (!problem.send) continue;
    sent.push({ match: match.value, url: url.value });
    rows.push(row);
  }
  const answer = await keepSetting({ links: sent });
  for (const one of (answer && answer.refused) || []) {
    if (rows[one.at]) sayLink(rows[one.at], linkWords(one.trouble) + " \u00b7 not saved", one.field);
  }
  paintExamples();
}

// The rows, from the file, as the menu opens (`showSettings`).
function putLinkRows() {
  const list = $("linklist");
  list.replaceChildren();
  for (const one of Array.isArray(setting("links")) ? setting("links") : []) {
    putLinkRow(list, one);
  }
}

// Under each good row, the first thing on this page it links, and where to:
// what the pattern does, shown on what the reader is reading. Only while the
// menu is open, because it reads the text of the whole page.
function paintExamples() {
  const text = $("rows").textContent + "\n" + $("content").textContent;
  for (const row of $("linklist").querySelectorAll(".linkrow")) {
    if (row.dataset.said) continue;
    const [match, url] = [...row.querySelectorAll("input")].map((box) => box.value);
    const says = row.querySelector(".linksays");
    says.replaceChildren();
    if (!match || !url) continue;
    let hit = null;
    try { hit = nextMatch(new RegExp(match, "g"), text, 0); } catch (error) { }
    const where = hit ? ticketUrl(url, hit) : "";
    if (!where) {
      says.textContent = "nothing on this page matches yet";
      continue;
    }
    put(says, "span", null, hit[0] + " \u2192 ");
    const link = put(says, "a", null, where.replace(AWAY, ""));
    link.href = where;
    opensAway(link);
  }
}

// One control in parts, the part in force pressed: the settings menu's, and
// Markdown or text over a document and over a commit message. One builder,
// so they look and answer alike. `paintChoice` says which is in force.
function putChoice(parent, name, options, pick) {
  const group = put(parent, "span", "choice " + name);
  group.setAttribute("role", "group");
  for (const [value, word, icon, title] of options) {
    const button = put(group, "button", "verb quiet");
    button.dataset.value = String(value);
    if (title) button.title = title;
    if (icon) putIcon(button, icon);
    put(button, "span", null, word);
    button.addEventListener("click", () => pick(value));
  }
  return group;
}

function paintChoice(group, value) {
  for (const button of group.querySelectorAll("button")) {
    button.setAttribute("aria-pressed", String(button.dataset.value === String(value)));
  }
}

// Markdown or the text as it was written, at the right end of the line that
// names what is read: a document's path on the Files tab, a commit's subject
// on the Review tab. The reader asked for the two to look and feel the same.
function putReadAs(parent, asText, pick, textTitle) {
  const group = putChoice(parent, "readas", [
    [false, "Markdown", "markdown", "draw it as Markdown"],
    [true, "text", "plain", textTitle]], (value) => pick(value === true));
  group.setAttribute("aria-label", "read as");
  paintChoice(group, asText);
  return group;
}

function notifyAbout(sessions) {
  const want = alertsWanted();
  const on = alertsCan();
  const now = new Set(sessions.filter(needsYou).map((s) => s.id));
  for (const id of waiting) if (!now.has(id)) waiting.delete(id);

  // Read before anything is sent, and written on every pass whatever the
  // switches say. Two things rest on that. Ticking the box while an agent is
  // working still tells you when it stops, which is the turn you ticked it
  // for -- record only while the switch is on and that one alert goes
  // missing. And a session that reached "done" while nobody was listening is
  // then already at "done" rather than a change waiting to be announced, so
  // switching on does not bring an hour of news with it. `waiting` is the
  // same promise for the amber one.
  const before = new Map(wasDoing);
  wasDoing.clear();
  for (const session of sessions) wasDoing.set(session.id, session.state);
  const live = new Set(sessions.map((one) => one.id));
  for (const id of [...before.keys()]) if (!live.has(id)) before.delete(id);

  // Do not shout about a backlog later: an amber row that nobody was told
  // about -- alerts not allowed, or this one switched off -- is not news
  // when the switch comes on.
  if (!on || !want.needs) for (const id of now) waiting.add(id);
  if (!on) return;
  // Each alert names the session by `rowName`, as the row and the tab's
  // title do. `label` leads with the title Claude Code writes from the first
  // prompt, which `/rename` never reaches, so the alert named a session that
  // was not in the list.
  for (const session of sessions) {
    if (want.needs && needsYou(session) && !waiting.has(session.id)) {
      waiting.add(session.id);
      tellAbout(session, rowName(session) + " needs you", waitsFor(session),
                true);
    }
    // A change, not a state: "done" is where a session sits between turns,
    // so the news is the moment it got there. A session this page has not
    // seen before has no entry, which is why one already finished when you
    // opened the page says nothing.
    if (want.done && session.state === "done"
        && before.get(session.id) === "working") {
      tellAbout(session, rowName(session) + " has finished",
                session.prompt || "ready for you");
    }
  }
}

// What a session that needs you is waiting for, in the alert's words: the
// question it asks, from `asking` -- the row's `reason` names only its
// header -- or else the `reason`, the permission it wants and for what,
// with its secrets hidden already: an alert can stand on a locked screen.
function waitsFor(session) {
  if (reminderDue(session) && session.state !== "needs_you") {
    return "the reminder you set";
  }
  const asked = session.asking && session.asking.questions;
  const first = asked && asked[0] && asked[0].question;
  if (first) return clip(first, 200);
  return session.reason || "waiting for you";
}

// One alert (issue 330). It says what the session wants, and where the
// session stands -- the folder and the branch, the row's second line --
// and it wears the tab's robot in the colour of what it says. An alert
// that needs you stays until it is clicked or closed (`urgent`): it is
// what this program is for, and one that went away on its own while the
// reader was in another room said nothing to them. A click opens the
// session, as it always did.
function tellAbout(session, title, body, urgent = false) {
  const where = [session.place, session.branch].filter(Boolean).join(" · ");
  try {
    const note = new Notification(title, {
      body: where ? body + "\n" + where : body,
      icon: iconPicture(urgent ? "needs" : "ready"),
      tag: "wostuast-" + session.id,
      // One tag per session, so a second alert replaces the first -- and a
      // replacement makes no sound and shows no banner unless it says so.
      // An agent that stopped on a second question went unsaid.
      renotify: true,
      requireInteraction: urgent,
    });
    note.onclick = () => { window.focus(); choose(session.id); note.close(); };
  } catch (error) {
    // Some browsers refuse without a service worker. Nothing else breaks.
  }
}

// --- the transcript ---------------------------------------------------------

//: At most this many links in one block. A pattern that matches everything
//: would otherwise build a link per word, and every one of them is a DOM
//: node on a page that redraws.
//:
//: It lives here alone. The daemon carried the same name and the same number
//: and read it nowhere -- the page is the only side that makes a link -- so
//: the copy was not a second opinion, it was a second thing to forget.
//:
//: It was 40, which a file of release notes went straight past: the links
//: stopped halfway down and nothing said why. 500 costs 4 ms, measured in
//: this browser on the worst text there is -- a block of 5,000 words, every
//: one of them a match.
const LINKS_MAX = 500;

// The reader's own autolinks, from `settings.json` by way of the daemon. It
// has already marked an entry that will not compile or whose url is not
// http(s); this compiles what is left, once a change, and drops anything that
// still will not take -- the two regular expression dialects are close but
// not the same, and a pattern Python accepts may not be one JavaScript does.
function takeLinks(redraw) {
  const body = state.settings;
  const out = [];
  // What the daemon could not use, plus anything this side cannot compile.
  // "No links" and "your file is broken" are different answers, and the page
  // showed nothing either way -- so a file you wrote and got wrong looked
  // exactly like a file you never wrote.
  const trouble = [...((body && body.trouble) || [])];
  for (const one of (body && body.links) || []) {
    if (one.trouble) continue;         // said in `trouble` already
    try {
      out.push({ re: new RegExp(one.match, "g"), url: String(one.url) });
    } catch (error) {
      // Python took this pattern and JavaScript will not. The two dialects
      // are close and not the same, so this one is only findable here.
      trouble.push("this browser cannot use the pattern `" + one.match + "`");
    }
  }
  const key = JSON.stringify(out.map((one) => [one.re.source, one.url]));
  const changed = key !== state.linksKey;
  state.links = out;
  state.linksKey = key;
  // Said on the live slot, until the file is mended: see `paintLive`.
  state.linkTrouble = trouble;
  paintLive();
  // Everything that shows a ticket draws it again, and nothing else would:
  // a change to the links is not a push of the sessions.
  if (changed && redraw) {
    draw();
    drawSessions();
  }
}

// The address one match stands for. `$1` to `$9` are the groups and `$0` is
// the whole of it, which is the gitlens shape written the way a person who
// has used `sed` expects.
function ticketUrl(template, hit) {
  const built = template.replace(/\$([0-9])/g,
                                 (whole, n) => hit[Number(n)] || "");
  return /^https?:\/\//i.test(built) ? built : "";
}

// Turn what the reader's patterns match into links, in place.
//
// It walks text nodes, like `markHits`, so nothing an agent wrote is ever
// re-parsed as HTML -- and it skips code and anything already inside a link,
// because a ticket id in a command line is part of the command and a url is
// already where it points.
function linkTickets(root) {
  if (!state.links.length) return;
  let made = 0;
  // Through `overText`, the one walker over text: a second one here was a
  // second copy of the invariant the page rests on (#297).
  overText(root, (text) => {
    if (made >= LINKS_MAX) return null;
    const pieces = linkOne(text, LINKS_MAX - made);
    if (!pieces) return null;
    made += pieces.made;
    return pieces.holder;
  }, "code, pre, a");
}

// One text node, cut into text and links. Null when nothing matched, so the
// common case costs a scan and no DOM work at all.
function linkOne(text, room) {
  const holder = document.createDocumentFragment();
  let from = 0;
  let made = 0;
  // Each pattern's next match, kept while it is still ahead of `from`: a
  // search from further back that found nothing before it finds the same.
  const ahead = new Map();
  while (from < text.length && made < room) {
    // The earliest match among every pattern, so two patterns that overlap
    // give the same answer whichever order they are written in.
    let best = null;
    for (const one of state.links) {
      let hit = ahead.get(one);
      if (hit === undefined || (hit && hit.index < from)) {
        hit = nextMatch(one.re, text, from);
        ahead.set(one, hit);
      }
      if (hit && (!best || hit.index < best.hit.index)) {
        best = { one, hit };
      }
    }
    if (!best) break;
    const where = ticketUrl(best.one.url, best.hit);
    const at = best.hit.index;
    if (at > from) {
      holder.appendChild(document.createTextNode(text.slice(from, at)));
    }
    if (where) {
      const link = put(holder, "a", "ticket", best.hit[0]);
      link.href = where;
      opensAway(link);
      made += 1;
    } else {
      holder.appendChild(document.createTextNode(best.hit[0]));
    }
    from = at + best.hit[0].length;
  }
  if (!made) return null;
  if (from < text.length) {
    holder.appendChild(document.createTextNode(text.slice(from)));
  }
  return { holder, made };
}

// The first match of `re` at `from` or after it that is not empty.
//
// A pattern such as `(PROJ-)?\d*` matches nothing at every place that is not
// a ticket, and `exec` gives that empty match first. Taking it as "no match"
// made no links at all from such a pattern, and nothing said why. So an
// empty match moves the search on by one and asks again. This walks the
// text one place at a time, but only for a pattern that matches nothing
// there, and `linkOne` keeps each answer until it is passed.
function nextMatch(re, text, from) {
  re.lastIndex = from;
  let hit = re.exec(text);
  while (hit && !hit[0]) {
    if (hit.index >= text.length) return null;
    re.lastIndex = hit.index + 1;
    hit = re.exec(text);
  }
  return hit;
}

//: What may be a link on this page. A page an agent wrote is not a place to
//: follow a `javascript:` or a `data:` from.
const LINKABLE = /^https?:/i;

//: The same question for a link this page builds itself, which always goes
//: somewhere else.
const AWAY = /^https?:\/\//i;

// A link that leaves this page leaves it in a new tab, and takes nothing of
// this one with it. Both places that build one come through here. The name
// at the top of the list is the one link written in the HTML (#333), and it
// carries the same two attributes: `test_the_name_links_to_the_project`.
function opensAway(link) {
  link.target = "_blank";
  link.rel = "noopener noreferrer";
}

// A `#` link is its words and nothing more. The scrub takes every id off a
// heading, so it has nowhere to jump to in the text. As a link it opened a
// second copy of this page in a new tab, and `goToLink` read `#install` as
// the name of a session.
function safeLinks(root) {
  for (const link of root.querySelectorAll("a")) {
    const href = link.getAttribute("href") || "";
    if (LINKABLE.test(href)) {
      opensAway(link);
    } else if (href.startsWith("#")) {
      link.replaceWith(...link.childNodes);
    } else {
      link.removeAttribute("href");
    }
  }
}

// Walk the text of a node and put something else in place of what matches.
//
// One place, because this is the invariant the whole page rests on: it builds
// nodes and never markup, so nothing an agent wrote is ever parsed as HTML.
// It also collects the text nodes before touching any of them -- replacing
// one mid-walk leaves the walker pointing at a node that has left the
// document.
//
// `cut` is handed one text node's string and gives back a fragment to put in
// its place, or null to leave it alone. `skip` is a selector for text that is
// not prose: code, and a link that is already one.
function overText(root, cut, skip) {
  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
  const found = [];
  while (walker.nextNode()) {
    const node = walker.currentNode;
    if (skip && node.parentElement && node.parentElement.closest(skip)) continue;
    found.push(node);
  }
  for (const node of found) {
    const holder = cut(node.nodeValue);
    if (holder) node.replaceWith(holder);
  }
}

// What Markdown is allowed to produce. Anything else is replaced by its own
// text, so an agent that read a hostile file cannot put elements on this page.
const ALLOWED = new Set([
  "P", "BR", "HR", "STRONG", "EM", "DEL", "CODE", "PRE", "BLOCKQUOTE",
  "UL", "OL", "LI", "A", "H1", "H2", "H3", "H4", "H5", "H6",
  "TABLE", "THEAD", "TBODY", "TR", "TH", "TD", "SPAN", "DIV",
]);

//: The attributes that may stay, each with the one test its value must
//: pass. None of them holds free text. `start` is the number a list starts
//: at: steps split by a code fence are three lists, and without it they
//: read 1, 1, 1. Nine digits is the most CommonMark takes. `align` is a
//: table column's side, so a column of numbers stands to the right.
//: Maps and not objects: an attribute named `constructor` found the one
//: every object has, and kept itself.
const SIDES = ["left", "center", "right"];
const KEPT = new Map([
  // Where an `href` may go is for `safeLinks` to say.
  ["A", new Map([["href", () => true]])],
  ["OL", new Map([["start", (value) => /^[0-9]{1,9}$/.test(value)]])],
  ["TH", new Map([["align", (value) => SIDES.includes(value)]])],
  ["TD", new Map([["align", (value) => SIDES.includes(value)]])],
]);

// What an element that may not stay is shown as. Its own text, except for
// the two that have none: a task list's box is a mark, and a picture is
// its `alt`. Both become text, so neither can load or run anything.
function textFor(child) {
  if (child.tagName === "INPUT" && child.getAttribute("type") === "checkbox") {
    return child.hasAttribute("checked") ? "\u2611" : "\u2610";
  }
  if (child.tagName === "IMG") return child.getAttribute("alt") || "";
  return child.textContent || "";
}

function scrub(node) {
  for (const child of Array.from(node.children)) {
    if (!ALLOWED.has(child.tagName)) {
      // A task's box stands where the bullet stood, as it does on GitHub:
      // "• ☑ done" read as two marks for one item. The class is ours, put
      // on after the item's own attributes were taken, so an agent's
      // `class="task"` on an item with no box does not stay.
      if (child.tagName === "INPUT" && child.getAttribute("type") === "checkbox"
          && node.nodeType === Node.ELEMENT_NODE) {
        const item = node.closest("li");
        if (item) item.classList.add("task");
      }
      child.replaceWith(document.createTextNode(textFor(child)));
      continue;
    }
    const kept = KEPT.get(child.tagName);
    for (const name of Array.from(child.getAttributeNames())) {
      const test = kept && kept.get(name);
      if (test && test(child.getAttribute(name))) continue;
      child.removeAttribute(name);
    }
    // Written again from the number, so what stays is ours: "007" is 7.
    if (child.hasAttribute("start")) {
      child.setAttribute("start", String(Number(child.getAttribute("start"))));
    }
    scrub(child);
  }
}

function escapeText(raw) {
  return String(raw)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

// `marked` is fetched, so it may be late and it may never come. The
// transcript is drawn either way: Markdown is written to be read as plain
// text, which is what it falls back to. It is asked for at once, not on first
// use, because the transcript is the tab the page opens on.
let markedAsked = null;

function markedReady() {
  if (!markedAsked) {
    markedAsked = fetchScript(MARKED_SRC, MARKED_HASH).then((came) => {
      if (!came || !window.marked) return false;
      // Raw HTML in an agent's text is shown, not obeyed. Turning it into
      // visible text here rather than escaping the whole source keeps code
      // fences correct: escaping first would have marked escape it a second
      // time inside a fence. It is registered the moment marked arrives and
      // before anything is parsed, so no text is ever parsed without it.
      marked.use({
        renderer: {
          html(token) {
            const raw = typeof token === "string" ? token
                                                  : (token && token.text) || "";
            return escapeText(raw);
          },
        },
      });
      return true;
    });
  }
  return markedAsked;
}

function markdown(parent, text) {
  const node = put(parent, "div", "prose");
  // Not here yet, or never coming. Markdown reads as text, which is the whole
  // point of it, so the transcript is never blank while the page waits.
  if (!window.marked) {
    node.textContent = text;
    return node;
  }
  // marked does not sanitize and passes raw HTML straight through, so the
  // result is scrubbed to an allowlist. Escaping the source instead would be
  // escaped a second time inside code fences, which is how `>` became `&gt;`.
  try {
    // Into a <template> first. Its contents belong to an inert document, so
    // no image is fetched and no handler runs. Assigning to innerHTML here
    // would already have fired an onerror before the scrub could remove it.
    const holder = document.createElement("template");
    holder.innerHTML = marked.parse(String(text), { breaks: false, gfm: true });
    scrub(holder.content);
    node.replaceChildren(holder.content);
  } catch (error) {
    node.textContent = text;   // assigning text already clears the children
  }
  safeLinks(node);
  putCodeCopies(node);
  // After the scrub, so a pattern can never put an element on this page: it
  // walks text nodes and builds one anchor at a time, with an href this side
  // has checked again.
  linkTickets(node);
  return node;
}

// --- painting code ----------------------------------------------------------

// 122 KB of highlighter inside the program would be more than half of it
// again, to paint code that reads perfectly well unpainted. So it is fetched,
// and every path through here works when it does not arrive.
// Files whose language the suffix does not give away. A name with no suffix
// at all — Makefile, Dockerfile — is looked up whole.
const BY_NAME = {
  "Makefile": "makefile", "makefile": "makefile", "GNUmakefile": "makefile",
  "Dockerfile": "dockerfile", "CMakeLists.txt": "cmake",
  ".bashrc": "bash", ".bash_profile": "bash", ".zshrc": "bash",
  ".profile": "bash", ".gitconfig": "ini", ".gitignore": "plaintext",
};
const BY_SUFFIX = {
  h: "c", hpp: "cpp", hh: "cpp", hxx: "cpp", cc: "cpp", cxx: "cpp",
  mk: "makefile", cmake: "cmake", sh: "bash", zsh: "bash",
  yml: "yaml", tsx: "typescript", jsx: "javascript", rs: "rust",
  toml: "ini", cfg: "ini", conf: "ini",
};

// Asked for when the first file that is not Markdown opens, or the Diff tab
// first draws a diff -- never on load. Reading transcripts all day then
// reaches the network never. One promise, so
// a second file does not start a second download.
let hljsAsked = null;

function hljsReady() {
  if (!hljsAsked) {
    hljsAsked = fetchScript(HLJS_SRC, HLJS_HASH)
      .then((came) => (came && window.hljs) || null);
  }
  return hljsAsked;
}

// What a script says it is on its first line. `wostuast` itself is a Python
// program with no suffix, and so is most of what lives in a bin directory.
const BY_INTERPRETER = {
  python: "python", node: "javascript", bun: "javascript", deno: "typescript",
  sh: "bash", bash: "bash", zsh: "bash", dash: "bash", ksh: "bash",
  fish: "bash", perl: "perl", ruby: "ruby", php: "php", lua: "lua",
  Rscript: "r", awk: "awk", gawk: "awk", pwsh: "powershell", tclsh: "tcl",
};

function fromShebang(text) {
  const first = String(text || "").slice(0, 300).split("\n", 1)[0];
  if (!first.startsWith("#!")) return null;
  // The first word that names a program. `#!/usr/bin/env -S python3 -u` has
  // three words before its options, and only the third one is an interpreter.
  for (const word of first.slice(2).trim().split(/\s+/)) {
    if (word.startsWith("-")) continue;
    const name = word.slice(word.lastIndexOf("/") + 1);
    if (name === "env") continue;
    // `python3`, `python3.12`, `perl5` — the version is not part of the name.
    const known = BY_INTERPRETER[name] || BY_INTERPRETER[name.replace(/[\d.]+$/, "")];
    if (known) return known;
    return null;                   // it named something, and we do not know it
  }
  return null;
}

// Three questions, most certain first: the name, the first line, then what
// `file` made of the content back on the daemon. The order matters — `file`
// calls Rust and Go "C source", so anything that actually knows must win.
function languageOf(path, text, sniffed) {
  const base = path.slice(path.lastIndexOf("/") + 1);
  if (BY_NAME[base]) return BY_NAME[base];
  const dot = base.lastIndexOf(".");
  if (dot > 0) {
    const suffix = base.slice(dot + 1).toLowerCase();
    return BY_SUFFIX[suffix] || suffix;
  }
  return fromShebang(text) || sniffed || null;
}

// Only text and the highlighter's own spans survive. The page does not trust
// what an agent wrote, and it does not trust the highlighter more than that:
// this is the same inert <template> the Markdown path uses, with a narrower
// allowlist.
function paintedInto(holder, marked_up) {
  holder.innerHTML = marked_up;
  const walk = (node) => {
    for (const child of Array.from(node.children)) {
      // `hljs-title function_` is one span with two classes, so the whole
      // list is filtered rather than matched. A bare word is not allowed
      // through: `row` or `tab` would dress a span up as our own chrome.
      const classes = (child.getAttribute("class") || "").split(/\s+/)
        .filter((one) => /^(hljs-[\w-]+|[a-z][\w]*_)$/.test(one));
      if (child.tagName !== "SPAN" || !classes.length) {
        child.replaceWith(document.createTextNode(child.textContent || ""));
        continue;
      }
      for (const name of child.getAttributeNames()) child.removeAttribute(name);
      child.setAttribute("class", classes.join(" "));
      walk(child);
    }
  };
  walk(holder.content);
  return holder.content;
}

// The highlighted file, cut into one fragment per line.
//
// The highlighter is given the whole file, because a block comment or a
// multi-line string only makes sense whole — painting line by line gets those
// wrong. But the page shows one row per line, so the painted result has to be
// cut up afterwards. A span that crosses a newline is closed at the end of the
// line and opened again on the next, which is what `open` is for.
//
// It walks the scrubbed fragment, never a string of HTML: whatever the
// highlighter returned has already been through `paintedInto`.
function cutIntoLines(painted) {
  const lines = [document.createDocumentFragment()];
  const open = [];                       // the spans we are inside, outermost first
  let holder = lines[0];

  function nextLine() {
    const line = document.createDocumentFragment();
    lines.push(line);
    let at = line;
    for (const span of open) {           // the same nesting, reopened
      const copy = document.createElement("span");
      copy.className = span.className;
      at.appendChild(copy);
      at = copy;
    }
    return at;
  }

  function walk(node) {
    for (const child of node.childNodes) {
      if (child.nodeType === Node.TEXT_NODE) {
        const pieces = child.data.split("\n");
        holder.appendChild(document.createTextNode(pieces[0]));
        for (let i = 1; i < pieces.length; i += 1) {
          holder = nextLine();
          holder.appendChild(document.createTextNode(pieces[i]));
        }
        continue;
      }
      const copy = document.createElement("span");
      copy.className = child.className;
      holder.appendChild(copy);
      open.push(child);
      holder = copy;
      walk(child);
      open.pop();
      // Back out one level, on whichever line we have ended up on.
      holder = holder.parentNode;
    }
  }

  walk(painted);
  return lines;
}

// Paint a file that is drawn as rows. The text is on the page before this
// returns, so a slow or missing CDN costs the reader nothing but colour.
async function paintLines(box, path, text, sniffed) {
  const want = box.dataset.path;
  const lib = await hljsReady();
  if (!lib || !box.isConnected || box.dataset.path !== want) return;
  const language = languageOf(path, text, sniffed);
  if (!language || !lib.getLanguage(language)) return;
  const rows = box.querySelectorAll(".dline > .dtext");
  const lines = paintedLines(lib, language, text, rows.length);
  if (lines) rows.forEach((row, at) => row.replaceChildren(lines[at]));
}

// Some text, highlighted and cut into one fragment per line -- or null when
// the language throws, or when the answer does not have the `want` lines the
// caller is about to colour. Colour on the wrong lines is worse than none.
// The Files tab paints a whole file through here, the Diff tab one side of
// one hunk.
function paintedLines(lib, language, text, want) {
  if (tooDenseToPaint(text)) return null;
  let lines;
  try {
    // No CR goes in. The HTML parser in `paintedInto` reads CR LF and a
    // lone CR as a line break, so a Windows file had one more line than
    // rows and was never painted. Rows are cut on LF only, so no line moves.
    // A CR that ends a line goes: before an LF, or at the end of the text,
    // which is where a Windows file's last row and a hunk's last line stop.
    // A CR inside a line -- progress output in a log -- becomes a space,
    // which is how CSS draws it in the plain row: taken out, `a\rb` read
    // `ab` once coloured, and every word mark after it on the Diff tab stood
    // one place late.
    const clean = text.replace(/\r(?=\n|$)/g, "").replace(/\r/g, " ");
    const done = lib.highlight(clean, { language, ignoreIllegals: true });
    lines = cutIntoLines(paintedInto(document.createElement("template"),
                                     done.value));
  } catch (error) {
    return null;                // a language that throws leaves the plain text
  }
  return lines.length === want ? lines : null;
}

// Onto the clipboard, with the old way behind it. A loopback origin counts
// as secure, so `navigator.clipboard` is usually there -- but it is refused
// often enough (a page that never had the focus, a browser that wants a
// permission) that the answer has to be checked rather than assumed. Neither
// path may throw: this runs from a click handler.
async function copyToClipboard(text) {
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return true;
    }
  } catch (error) {
    // the old way, below
  }
  try {
    const holder = document.createElement("textarea");
    holder.value = text;
    holder.setAttribute("readonly", "");
    holder.style.position = "fixed";
    holder.style.top = "-1000px";
    document.body.appendChild(holder);
    holder.select();
    const done = document.execCommand("copy");
    holder.remove();
    return done;
  } catch (error) {
    return false;
  }
}

// A link to one reply: `#<session>/<seq>`.
//
// `seq` is a place in one reading of a transcript, not an identity -- a
// session resumed from another directory counts from nought again -- so a
// link is a good pointer and not a promise. Nothing moves when it no longer
// fits, and that is the whole of the failure.
function blockHref(index) {
  return "#" + encodeURIComponent(state.chosen || "") + "/" + index;
}

// `#<session>` alone is the session on screen, which `choose` writes so that
// a reload comes back to it; `seq` is then null.
function placeInHash() {
  const raw = (location.hash || "").replace(/^#/, "");
  const cut = raw.lastIndexOf("/");
  try {
    if (cut < 0) return raw ? { id: decodeURIComponent(raw), seq: null } : null;
    if (cut < 1) return null;
    // Digits and nothing else. `Number("")` is 0, so `#s1/` was a link to
    // the first block, and `Number` takes " 3", "1e2" and "0x10" too.
    const tail = raw.slice(cut + 1);
    if (!/^[0-9]+$/.test(tail)) return null;
    return { id: decodeURIComponent(raw.slice(0, cut)), seq: Number(tail) };
  } catch (error) {
    return null;              // a hash somebody typed by hand
  }
}

// Following a link: at startup, and whenever the hash changes. The session is
// chosen first, because a link may name one that is not on screen, and the
// block is asked for after that -- `choose` blanks everything the last
// session had, this included.
function goToLink() {
  const place = placeInHash();
  if (!place || !place.id) return;
  choose(place.id);           // does nothing when it is already the one shown
  if (place.seq === null) return;
  state.turns.goTo = place.seq;
  showTab("transcript");
}

// The block a link asked for, once it has been drawn. It wins over the usual
// landing at the foot of the transcript, and it wins once: scrolling there
// again on every later draw would drag the reader back every second of a live
// session.
function landOnBlock(box) {
  if (state.turns.goTo === null) return false;
  // A search result names a moment the hook stamped (#379), which is a
  // little after the transcript's own: the nearest block within a minute.
  if (state.turns.goToNear) {
    const blocks = state.turns.blocks;
    if (!state.turns.whole && !blocks.length) return false;   // not here yet
    let best = -1;
    for (let at = 0; at < blocks.length; at += 1) {
      const one = blocks[at];
      if (!one || !one.ts || Math.abs(one.ts - state.turns.goToNear) > 60) continue;
      if (best < 0 || Math.abs(one.ts - state.turns.goToNear)
                      < Math.abs(blocks[best].ts - state.turns.goToNear)) best = at;
    }
    state.turns.goToNear = null;
    state.turns.goTo = best < 0 ? null : best;
    if (state.turns.goTo === null) return false;
  }
  // A saved turn names its moment too (#377): a resumed session counts its
  // blocks from nought again, and the place may hold another block now.
  if (state.turns.goToTs) {
    const blocks = state.turns.blocks;
    const at = blocks.findIndex((one) => one && one.ts === state.turns.goToTs);
    if (at < 0 && !state.turns.whole) return false;   // not all here yet
    state.turns.goTo = at < 0 ? null : at;
    state.turns.goToTs = null;
    if (state.turns.goTo === null) return false;
  }
  const node = state.turns.nodes[state.turns.goTo];
  if (!node || node.parentNode !== box) return false;
  state.turns.goTo = null;
  node.scrollIntoView({ block: "center" });
  node.classList.add("linked");
  setTimeout(() => node.classList.remove("linked"), 2500);
  return true;
}

// One node per block, kept so that a change redraws that block and no other.
// Rebuilding the lot re-ran marked over the whole history on every update, and
// restarted the slide-in of every turn each time one line arrived.

function blockTurn(block, index) {
  if (block.kind === "divider") {
    const node = document.createElement("div");
    node.className = "divider";
    node.textContent = block.text;
    return node;
  }
  if (block.kind === "tool") {
    const node = document.createElement("div");
    node.className = "turn toolrow";
    put(node, "div", "who");
    const tools = put(node, "div", "tools");
    drawTool(tools, block, index);
    return node;
  }
  // A `!` command is the reader's too: they typed it. So is a slash command,
  // drawn the same way, because its answer is output in the fixed face.
  const shell = block.kind === "shell" || block.kind === "command";
  const mine = block.kind === "prompt" || shell;
  // Something the harness said, not the reader and not the agent.
  const aside = block.kind === "note";
  // The agent's plan, asking to start (#372): its words, as a document.
  const plan = block.kind === "plan";
  const node = document.createElement("div");
  node.className = "turn" + (mine ? " mine" : "") + (aside ? " aside" : "")
    + (plan ? " plan" : "");
  const who = put(node, "div", "who" + (mine || aside ? "" : " claude"));
  // The name is a link to this block, so the address bar holds one after a
  // click and the browser's own "open in a new tab" works on it. Nothing is
  // intercepted: a plain anchor is already all three of those things.
  const name = put(who, "a", "self",
                   mine ? "you" : aside ? "system" : plan ? "plan" : "claude");
  name.href = blockHref(index);
  name.title = "link to this " + (mine ? "prompt"
                                       : aside ? "message" : plan ? "plan" : "reply");
  // A bookmark beside the name, not a word beside "copy": the column is
  // 64 px, and the two words pushed "copy" out of it (#377). On every
  // block with a link (#424): a prompt the reader typed (#403), a `!` or
  // slash command with what it printed, and a message of the harness.
  putSave(who, block, index, shell ? "shell" : aside ? "system"
          : block.kind === "prompt" ? "me" : "claude");
  if (block.ts) {
    const day = dayOf(block.ts);
    if (day) put(who, "div", "day", day);
  }
  // The copy button shares the time's line: see `.who .stamp`.
  const stamp = block.ts ? put(who, "div", "stamp", clock(block.ts)) : who;
  putCopy(stamp, block, mine);
  // A message too long to show whole is drawn in a box of its own, with the
  // bar that opens and folds it under it: see `foldedHead`.
  const whole = String((shell ? block.result : block.text) || "");
  const head = foldedHead(whole);
  const open = !head || state.turns.open.has(index)
    || (!!state.find && whole.toLowerCase().includes(state.find));
  const drawn = open ? whole : head;
  const box = head ? put(node, "div", "foldbox") : node;
  let shown;
  if (shell) {
    shown = putShell(box, block, drawn);
  } else if (mine || aside) {
    shown = put(box, "div", "bubble", drawn);
    linkTickets(shown);
  } else {
    shown = markdown(box, drawn);
  }
  if (head) {
    if (!open) shown.classList.add("folded");
    putFoldBar(box, whole, index, open);
  }
  return node;
}

// A message too long to read in the transcript is drawn folded: its first
// lines, faded out, and a bar under it that opens it. A log pasted into a
// prompt ran to 140 KB (#329), and the transcript drew all of it -- fifty
// screens to scroll past to reach the answer under it. Lines and characters
// both: a log is many short lines, a minified file one long one.
const FOLD_LINES = 40;
const FOLD_CHARS = 6000;
// What a folded message shows: enough to tell which one it is.
const FOLD_SHOWN = 12;

// The start of a text too long to show whole, or null for one short enough.
// The lines are counted with `indexOf` and only up to `FOLD_LINES`, never by
// splitting the whole: a split of 140 KB on every redraw is what the fold
// is there to save.
function foldedHead(text) {
  let at = -1;
  let lines = 0;
  let cut = -1;
  while (lines < FOLD_LINES) {
    at = text.indexOf("\n", at + 1);
    if (at < 0) break;
    lines += 1;
    if (lines === FOLD_SHOWN) cut = at;
  }
  if (lines < FOLD_LINES && text.length <= FOLD_CHARS) return null;
  const head = cut >= 0 ? text.slice(0, cut) : text;
  return head.slice(0, FOLD_SHOWN * 100);
}

// A count read at a glance: "2.4k" for 2,401, "12k", "1.2M", and below a
// thousand the number. "2,401 lines" was too long for the reader, in the
// fold bar and over the send button.
function roughly(n) {
  if (n < 1000) return String(n);
  const [size, unit] = n < 1e6 ? [n / 1e3, "k"] : [n / 1e6, "M"];
  return String(size < 10 ? Math.round(size * 10) / 10 : Math.round(size)) + unit;
}

// How many lines a text has, without an array of them.
function lineCount(text) {
  let lines = 1;
  for (let at = text.indexOf("\n"); at >= 0; at = text.indexOf("\n", at + 1)) {
    lines += 1;
  }
  return lines;
}

// The bar under a long message. Folded, it says how much there is; open, it
// folds it again, and it stays at the foot of the pane while any of the
// message is on screen (`.foldbar.open`), so the reader can fold it from
// wherever they are in it, not only from its end, 2,000 lines down. It uses
// the set a tool call opens with, so a session keeps it as it keeps those.
function putFoldBar(box, whole, index, open) {
  const bar = put(box, "button", "foldbar" + (open ? " open" : ""));
  putIcon(bar, "chevron");
  put(bar, "span", null, open
    ? "fold"
    : "show all " + roughly(lineCount(whole)) + " lines · "
      + sizeOf(new TextEncoder().encode(whole).length));
  bar.title = open ? "fold this message again" : "show the whole message";
  bar.addEventListener("click", () => {
    if (open) state.turns.open.delete(index); else state.turns.open.add(index);
    const node = redrawBlock(index);
    // Folding from the bar at the foot of the pane would leave the reader
    // where the message's end was, far below what is left of it.
    if (open) node.scrollIntoView({ block: "nearest" });
  });
}

// A command the reader ran with `!`, and what it printed, in the fixed face,
// as a terminal shows them. Text and never markup: a program wrote the
// output, and `<draft>` in a branch name is a branch name.
function putShell(node, block, result = block.result) {
  const bubble = put(node, "div", "bubble shell");
  // A slash command wears its own `/`; a shell command gets the `!` typed.
  if (block.text) {
    put(bubble, "div", "command",
        (block.kind === "shell" ? "! " : "") + block.text);
  }
  if (result) put(bubble, "pre", "output", result);
  return bubble;
}

// A code block copies itself: what an agent puts in a fence is most often a
// command or a file to take somewhere else, and selecting it by hand takes
// the numbers of a list or the line above with it. The button stands in a
// box round the block, not in it: inside, it would scroll away with a long
// line, and its own text would be copied with the code. An icon and not the
// word, so a search for "copy" does not mark every block.
function putCodeCopies(node) {
  for (const pre of node.querySelectorAll("pre")) {
    const box = document.createElement("div");
    box.className = "codebox";
    pre.replaceWith(box);
    box.appendChild(pre);
    const copy = put(box, "button", "copycode");
    copy.title = "copy this block";
    copy.setAttribute("aria-label", "copy this block");
    putIcon(copy, "copy");
    copy.addEventListener("click", async () => {
      const done = await copyToClipboard(pre.textContent);
      flashOutcome(copy, "copy", "copy this block", done,
                   done ? "copied" : "the browser would not copy it");
    });
  }
}

// A button that did its job says so for a moment: a tick in the working
// colour, then its own icon and words again. One helper, so "it went" looks
// the same on every button that has nothing else to show for it -- a copy,
// and a jump, whose result is in another window. A press while it shows
// starts the moment again rather than ending it early. A button that is a
// word passes `words`, what it says when it went and when it did not, and
// `icon` is then the word it goes back to (`putCopy`, which had a timer of
// its own that a second press could cut short).
function flashOutcome(button, icon, title, done, saying, words) {
  const show = (what) => {
    button.replaceChildren();
    if (words) button.textContent = what;
    else putIcon(button, what);
  };
  show(words ? words[done ? 0 : 1] : done ? "check" : icon);
  button.title = saying;
  button.classList.toggle("done", done);
  clearTimeout(button.flashing);
  button.flashing = setTimeout(() => {
    show(icon);
    button.title = title;
    button.classList.remove("done");
  }, 1400);
}

// The Markdown an agent wrote, as it wrote it. The page shows it drawn; this
// is the source, which is what goes into a bug report or another prompt.
function putCopy(parent, block, mine) {
  if (!block.text) return null;
  const copy = put(parent, "button", "copy", "copy");
  copy.title = "copy this " + (mine ? "prompt" : "reply") + " as Markdown";
  const title = copy.title;
  copy.addEventListener("click", async () => {
    const done = await copyToClipboard(block.text);
    // The node may be redrawn out from under this; writing to a node that has
    // left the page is harmless, and there is nothing to put back.
    flashOutcome(copy, "copy", title, done, done ? "copied" : "could not copy",
                 ["copied", "cannot"]);
  });
  return copy;
}

// "save" on an answer, beside "copy" (#377): kept for later, in a list
// of every session's. A turn is its session and its moment.
function savedKey(id, ts) {
  return id + "\n" + ts;
}

function putSave(parent, block, index, whose) {
  // A turn is its moment too: a block with none could not be saved.
  if (!block.text || !block.ts || !state.chosen) return null;
  // A command is kept with what it printed, as the transcript shows it.
  const words = whose === "shell"
    ? [(block.kind === "shell" ? "! " : "") + block.text, block.result || ""]
      .filter(Boolean).join("\n")
    : block.text;
  const id = state.chosen;
  const key = savedKey(id, block.ts);
  const button = put(parent, "button", "save" + (state.savedKeys.has(key) ? " on" : ""));
  parent.insertBefore(button, parent.firstChild);   // before the name
  putIcon(button, "save");
  const say = () => {
    button.title = state.savedKeys.has(key) ? "saved: take it off the list"
                                             : "save it for later";
    button.setAttribute("aria-label", button.title);
  };
  say();
  button.addEventListener("click", async () => {
    const on = !state.savedKeys.has(key);
    const answer = await tell(id, "save", {
      seq: index, ts: block.ts, save: on, text: words.slice(0, 300), who: whose,
    });
    if (!answer || answer.error) { said(answer || {}); return; }
    takeSaved(answer.saved);
    button.classList.toggle("on", state.savedKeys.has(key));
    say();
  });
  return button;
}

// The list as the daemon holds it, and the keys the transcript asks.
function takeSaved(saved) {
  state.saved = saved || [];
  state.savedKeys = new Set(state.saved.map((one) => savedKey(one.id, one.ts)));
  state.savedCount = state.saved.length;
  drawFeedLink();
}

async function askSaved() {
  try {
    const answer = await (await fetch("/api/saved")).json();
    takeSaved(answer.saved);
  } catch (error) {
    // The daemon went away; the list stays as it was.
  }
}

function nearBottom(box) {
  return box.scrollHeight - box.scrollTop - box.clientHeight < 80;
}

// Wrap every occurrence of the search in <mark>. It walks text nodes, so a
// word split across a tag is missed and nothing an agent wrote is ever
// re-parsed as HTML.
function markHits(node, needle) {
  if (!needle) return;
  const cutter = new RegExp("(" + escapeRegex(needle) + ")", "ig");
  overText(node, (text) => {
    if (!text.toLowerCase().includes(needle)) return null;
    const parts = text.split(cutter);
    const holder = document.createDocumentFragment();
    for (let i = 0; i < parts.length; i += 1) {
      if (!parts[i]) continue;
      if (i % 2) put(holder, "mark", null, parts[i]);
      else holder.appendChild(document.createTextNode(parts[i]));
    }
    return holder;
  });
}

function escapeRegex(text) {
  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

// One round of the conversation: what you typed, and what came back to it.
//
// Only prompts and the agent's own text. A tool call is not a round and there
// are hundreds of them -- 233 in one measured session -- and they are already
// in the transcript beside this. Thinking is hidden by default, so a row for
// one would point at nothing.
//
// A transcript can open with the agent talking: a session resumed, or one
// read from partway through. That is a round with no prompt of its own.
function rounds() {
  const out = [];
  let here = null;
  for (let at = 0; at < state.turns.blocks.length; at += 1) {
    const block = state.turns.blocks[at];
    if (!block) continue;
    if (block.kind === "prompt") {
      out.push(here = { seq: at, text: block.text, replies: [] });
    } else if (block.kind === "shell") {      // typed too, with its `!`
      out.push(here = { seq: at, text: "! " + block.text, replies: [] });
    } else if (block.kind === "command" && block.text) {   // with its `/`
      out.push(here = { seq: at, text: block.text, replies: [] });
    } else if (block.kind === "text" || block.kind === "plan") {
      // A `note` is neither, by design. A plan is the agent's words.
      if (!here) out.push(here = { seq: at, text: "", replies: [] });
      here.replies.push({ seq: at, text: block.text });
    }
  }
  return out;
}

//: How much of a line to hand the map. It is not where the preview ends --
//: `.filelist .name` clips with an ellipsis, at whatever width the column has
//: been dragged to -- it is only a bound on what is put in the DOM for a
//: reply that may be kilobytes long. It was 44, which is narrower than the
//: column at its default width, so every row ended in a "…" the column had
//: room for and the number did not.
//:
//: The number has to clear what the widest possible column can show, or it
//: is the clip again. Measured at `dragWidth`'s own cap of 700 px, where the
//: name box is 639 px: 49 of the widest glyphs and **176 of the narrowest**.
//: The list was a condensed sans, not a monospace, so the thin end is what
//: sets this -- a first guess of 120 from counting monospace characters
//: would have clipped a line of narrow letters on a wide column, which is
//: the bug this is fixing. The map is set in the transcript's own face at
//: 14 px now: the same family, not condensed and a size up, so no glyph is
//: narrower than it was when this was measured, and 200 still clears.
const GLIMPSE = 200;

// The first line with anything on it, short enough to read at a glance.
// Markdown's own marks are taken off the front: a reply that opens with a
// heading or a bullet would otherwise spend its first characters saying so.
function glimpse(text) {
  // Not `split("\n")`: an agent's reply is routinely several kilobytes and
  // this runs for every round and every reply. The first line with something
  // on it is all that can ever be used.
  const found = /^[ \t]*\S.*/m.exec(String(text || ""));
  const first = (found ? found[0] : "").trim()
    .replace(/^(#{1,6}|[-*>]|\d+\.)\s+/, "")
    .replace(/^\*\*(.*?)\*\*/, "$1")
    .replace(/^`(.*?)`/, "$1")
    .trim();
  return clip(first, GLIMPSE);
}

// The rounds the find box leaves. A round stays when it matches or when one
// of its replies does; under it, the replies that match -- unless the round
// itself matched, in which case the whole of it is what you asked for.
function onlyMatching(all) {
  const has = (text) => String(text || "").toLowerCase().includes(state.find);
  const out = [];
  for (const one of all) {
    const mine = has(one.text);
    const replies = mine ? one.replies : one.replies.filter((r) => has(r.text));
    if (mine || replies.length) out.push({ ...one, replies });
  }
  return out;
}

// The left bar: a round is a folder, the replies to it are what is in it.
// Clicking either goes to that place in the transcript beside it.
//
// It is guarded like every other list on this page, because `patchTranscript`
// calls it on every pushed block -- once a second while an agent works, and
// most of those blocks are tool calls, which are not on this map at all. It
// was rebuilding six hundred rows to draw the same six hundred rows.
function drawTurnList(list, note) {
  const all = rounds();
  const found = state.find ? onlyMatching(all) : all;
  const replies = found.reduce((n, one) => n + one.replies.length, 0);
  const last = found[found.length - 1];
  const tail = last && last.replies.length
    ? last.replies[last.replies.length - 1].seq : -1;
  // `run` first, and it is not optional: a rewritten transcript counts from
  // nought again and can give a map of exactly the same shape -- a `/clear`
  // followed by one reply reads as one round with one reply, which is what
  // the old reading was too. The list then showed the conversation that had
  // just been thrown away. Inside one reading `seq` only grows, so the shape
  // and the last two seqs say the rest.
  if (!fresh(list, "turns", [state.turns.run, state.find, state.turns.at,
                             all.length, found.length, replies,
                             last ? last.seq : -1, tail,
                             // Or folding a round redraws nothing: the shape
                             // of the conversation has not changed, only what
                             // is shown of it. Sorted, so the key is what the
                             // set holds and not the order it was filled in:
                             // folding 1 then 2 and folding 2 then 1 are the
                             // same list, and a spurious redraw is a rebuild
                             // of every row.
                             [...state.turns.shut].sort().join(",")].join("\n"))) {
    return;
  }
  // Where the reader had the map, read before it is emptied: emptying it
  // puts the scrollbar back to the top, and every round that arrived threw
  // the map there. It is read from the end, like the transcript: at its
  // foot, or new to this session, it lands on the latest round.
  const mine = list.dataset.session === (state.chosen || "");
  const atFoot = !mine || nearBottom(list);
  const was = list.scrollTop;
  list.dataset.session = state.chosen || "";
  list.replaceChildren();
  if (!found.length) {
    put(list, "div", "nohits",
        state.find ? "Nothing here matches." : "Nothing said yet.");
  }
  for (const one of found) {
    putTurnRow(list, one.seq, glimpse(one.text) || "(no prompt)", true);
    if (state.turns.shut.has(one.seq)) continue;
    for (const reply of one.replies) {
      putTurnRow(list, reply.seq, glimpse(reply.text) || "(no text)", false);
    }
  }
  noteTurns(note, found, replies, all);
  list.scrollTop = atFoot ? list.scrollHeight : was;
}

// A prompt is a folder and a reply is what is in it, so the depth is the one
// bit `mine` already carries.
//
// A round folds shut, and it folds from its icon. The row has two jobs and
// one of them must not be taken by the other: the whole row goes to that
// place in the transcript, which is what the map is for, and the icon alone
// folds -- `ICONS.dirOpen` is what says which way it is, and it is the
// triangle this list does not draw. Folding on any click would mean you could
// not read a round without closing it.
function putTurnRow(list, seq, text, mine) {
  const shut = mine && state.turns.shut.has(seq);
  const button = putListRow(list, { dir: mine, open: mine && !shut,
                                    depth: mine ? 0 : 1,
                                    chosen: seq === state.turns.at,
                                    title: text,
                                    icon: mine ? "person" : "robot" });
  if (mine) {
    // Said out loud, because a second target on a row nothing else on this
    // page has two of is not something a reader can be expected to find.
    // The chevron hangs in front of the person, so a reply's robot, one
    // step in, stands under the person it answers.
    button.setAttribute("aria-expanded", String(!shut));
    const fold = putIcon(button, "chevron");
    fold.classList.add("fold");
    fold.setAttribute("title", shut ? "open this round" : "fold this round away");
    button.insertBefore(fold, button.firstChild);
  }
  putName(button, text, []);
  button.addEventListener("click", (press) => {
    if (mine && press.target.closest(".fold")) {
      if (shut) state.turns.shut.delete(seq); else state.turns.shut.add(seq);
      redrawMap();
      return;
    }
    goToTurn(seq);
  });
}

// Go to one turn, and mark where you went. The list is the map; the mark is
// what answers a click on a row that was already on screen.
// Draw the map beside the transcript. Three places want it and each paired
// the list with a `.listnote` it fetched itself -- three chances for one of
// them to fetch a different one. `drawTranscript` is the fourth and does not
// come through here, because `split` hands it both nodes already.
function redrawMap(root) {
  const where = root || document;
  drawTurnList(where.querySelector(".filelist.transcript"),
               where.querySelector(".listnote"));
}

function goToTurn(seq) {
  state.turns.at = seq;
  state.turns.goTo = seq;
  const pane = document.querySelector(".turnbody");
  if (!pane || !landOnBlock(pane)) draw();
  else redrawMap();
}

// The way back to the end of a transcript you have scrolled up out of.
//
// A new block carries you along only while you are near the foot, which is
// right -- reading something further up should not be yanked away from. But
// once that has stopped, nothing on the page said how to start again, and on
// a long transcript the scrollbar is a thin sliver.
//
// Built once, by `split`, with the rest of the frame: it hangs off the
// content box rather than off the scroller, because the scroller's children
// are the blocks and `drawTranscript` replaces all of them.
function putToFoot(box) {
  // Only the arrow, in the middle: the reader asked for it smaller, and a
  // word at the right edge stood over the replies' ends.
  const button = put(box, "button", "verb tofoot");
  putIcon(button, "down");
  button.title = "go to the latest, and follow it again";
  button.setAttribute("aria-label", "go to the latest");
  button.addEventListener("click", () => {
    const pane = box.children[2];
    pane.scrollTop = pane.scrollHeight;
    button.hidden = true;        // it is the foot now; no need to measure
  });
  return button;
}

// Shown only when it would do something. **Both nodes are handed in.** This
// runs on every scroll event -- dozens of times in one gesture, and again on
// every pushed block -- and `box.querySelector(".tofoot")` is a pre-order
// walk that reaches the button only after crossing the whole transcript.
// On a long one that is on the order of a hundred thousand nodes visited,
// per scroll frame, to set one boolean. Every caller already holds both.
function showToFoot(button, pane) {
  if (button && pane) button.hidden = nearBottom(pane);
}

function drawTranscript(box) {
  const [list, pane, note] = split(box, "transcript", "turnbody");
  const foot = box.children[3];      // built by `split`; see `putToFoot`
  drawTurnList(list, note);
  // The whole transcript, always. The find box narrows the list beside it and
  // nothing else: you keep your place and the conversation around it, which
  // is what a transcript is for. It still marks what matched, because a hit
  // you scroll past unmarked is a hit you miss.
  //
  // No redraw key. The live path is `patchTranscript`, which appends; getting
  // here means a tab switch, a session, or a keystroke in the find box, and
  // every one of those really does want the blocks built again. A key here
  // would also leave the arriving block's `fresh` class on it for ever --
  // drawing a block again is not the block arriving again.
  //
  // Read before the pane is emptied: `replaceChildren` puts the scrollbar
  // back to nought, and the listener below would write that down as the
  // place the reader was.
  const place = state.turns.down;
  // Whose blocks these are. `choose` does not rebuild the pane, which holds
  // the last session's until the new fetch lands, and a scroll in between --
  // one the browser fires itself when the send box goes and the pane grows --
  // was written into the new session's place. The `.filescroll` scar.
  //
  // An empty draw claims no session: it takes the last session's scrolled
  // blocks away, the scrollbar falls back to nought, and that scroll would
  // be written as the place of a session whose fetch has not come back.
  pane.dataset.session = state.turns.blocks.length ? state.chosen || "" : "";
  if (fresh(pane, "watched", "1")) {
    pane.addEventListener("scroll", () => {
      // At the foot is "no place kept", and not a number of pixels. The
      // transcript is drawn twice on a first load -- as text, and again as
      // Markdown once `marked` arrives, much taller -- and the second draw
      // put back the first one's foot, thousands of pixels short of its own.
      if (pane.dataset.session === (state.chosen || "")) {
        state.turns.down = nearBottom(pane) ? null : pane.scrollTop;
      }
      showToFoot(foot, pane);
    });
  }
  pane.replaceChildren();
  state.turns.nodes = [];
  if (!state.turns.blocks.length) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, state.turns.failed
      ? "The transcript could not be read. It is asked for again."
      : "Nothing in this transcript yet.");
  } else {
    for (let index = 0; index < state.turns.blocks.length; index += 1) {
      const block = state.turns.blocks[index];
      if (!block) continue;
      const node = blockTurn(block, index);
      state.turns.nodes[index] = node;
      markHits(node, state.find);
      pane.appendChild(node);
    }
    // Where the reader was, or the foot of it. A transcript is read from the
    // bottom -- the last thing the agent said is the thing you came for --
    // so that is where a session with no kept place lands.
    // `null` is "no place kept"; nought is the very top, and a place too.
    putNewLine(pane);
    if (!landOnBlock(pane) && !landOnNew(pane)) {
      pane.scrollTop = place ?? pane.scrollHeight;
    }
  }
  showToFoot(foot, pane);
}

// How much of the conversation the list is showing. It is handed what the
// list already worked out: walking the blocks a second time for two totals
// doubled the cost of every push.
function noteTurns(note, found, replies, all) {
  note.replaceChildren();
  const every = all.reduce((n, one) => n + one.replies.length, 0);
  const what = (n) => counted(n, "reply", "replies");
  put(note, "span", null,
      found.length === all.length && replies === every
        ? found.length + (found.length === 1 ? " round · " : " rounds · ")
          + what(replies)
        : found.length + " of " + all.length + " rounds · "
          + replies + " of " + every + " replies");
}

// Redraw one block where it stands, without touching anything else.
function redrawBlock(index) {
  const node = blockTurn(state.turns.blocks[index], index);
  // Only `drawTranscript` used to mark the hits, so expanding a tool result
  // during a search left that one block unhighlighted while every other
  // match kept its `<mark>`.
  markHits(node, state.find);
  const old = state.turns.nodes[index];
  state.turns.nodes[index] = node;
  if (old && old.parentNode) old.replaceWith(node);
  return node;
}

function patchTranscript(indexes) {
  const box = $("content");
  // `state.tab` is set the moment a tab is picked, but the box still holds the
  // tab before it until `load()` comes back. Asking the box, the way `draw()`
  // does, is the difference between appending a turn to the transcript and
  // appending it as a fourth column of the Files tab.
  if (state.tab !== "transcript" || box.dataset.tab !== "transcript") return;
  const pane = box.querySelector(".turnbody");
  const list = box.querySelector(".filelist.transcript");
  if (!pane || !list || !state.turns.nodes) return;
  // The list is a map of the whole conversation, so a new block changes it
  // whatever the find box holds. It is cheap: a row per prompt and reply.
  redrawMap(box);
  if (!state.turns.nodes.length) { drawTranscript(box); return; }
  const stick = nearBottom(pane);
  for (const index of indexes) {
    if (index < state.turns.nodes.length) {
      redrawBlock(index);
    } else {
      // Arriving, rather than being drawn again. This is the only place a
      // block is new: a full redraw builds the whole history, and a history
      // that slid in block by block would be a page having a fit.
      const node = blockTurn(state.turns.blocks[index], index);
      node.classList.add("fresh");
      markHits(node, state.find);
      state.turns.nodes[index] = node;
      pane.appendChild(node);
    }
  }
  // The first blocks after the reader's last look may come in a push of
  // their own, after the draw that found none.
  if (!pane.querySelector(":scope > .newline") && putNewLine(pane)) landOnNew(pane);
  if (!landOnBlock(pane) && stick) pane.scrollTop = pane.scrollHeight;
  // A block arriving makes the transcript taller, so a reader who was at the
  // foot and is no longer carried there has somewhere to go back to.
  showToFoot(box.children[3], pane);
}

// Three places show how far a file moved. They say it the same way.
function putCounts(parent, one) {
  if (one.added) put(parent, "span", "plus", "+" + one.added);
  if (one.removed) put(parent, "span", "minus", "−" + one.removed);
  return parent;
}

function drawTool(parent, block, index) {
  const open = state.turns.open.has(index);
  // An edit opens onto what it changed. Its result only says that it did
  // ("The file … has been updated successfully."), which the counts and the
  // change say better.
  const patch = block.patch && block.patch.length ? block.patch : null;
  const opens = !!(patch || block.result);
  const line = put(parent, "button", "tool" + (block.failed ? " failed" : ""));
  put(line, "span", "caret", opens ? (open ? "▾" : "▸") : " ");
  put(line, "span", "name", block.tool);
  if (block.target) put(line, "span", "target", block.target);
  putCounts(line, block);
  if (block.result && !open && !patch) {
    const head = block.result.split("\n")[0];
    if (head) put(line, "span", "target", head.slice(0, 60));
  }
  line.addEventListener("click", () => {
    if (!opens) return;
    if (state.turns.open.has(index)) state.turns.open.delete(index); else state.turns.open.add(index);
    redrawBlock(index);        // this line only; the rest of the tab stays put
  });
  if (open && patch) putToolDiff(parent, block);
  else if (open && block.result) put(parent, "div", "tool-result", block.result);
}

// What one edit changed, under the call that made it: the words that
// announced it and the lines are read together, and the Diff tab keeps its
// width. Drawn by `fillDiffFile`, so it looks and is painted like the Diff
// tab -- but `atEdit`: the numbers are the file's at the moment of the edit,
// so there is no `+` to anchor a review comment to and no more of the file
// to show, and it is one column whatever the Diff tab is set to.
function putToolDiff(parent, block) {
  const box = put(parent, "div", "dfile tooldiff");
  fillDiffFile(put(box, "div", "dbody"),
               { path: block.target, hunks: block.patch, tail: 0, atEdit: true });
  if (block.patch_more) {
    put(box, "div", "toolmore", "… " + counted(block.patch_more, "more line", "more lines")
        + " · the Diff tab has the whole change");
  }
}

// --- the Files tab ----------------------------------------------------------

// Both split tabs keep their two columns and rebuild a column only when what
// it shows has changed. The box used to be emptied on every poll, which threw
// away the reader's place in the document every time the agent touched some
// other file — and the keys that guarded against that lived in `state`, where
// nothing kept them in step with the DOM. The DOM remembers instead.
// One find box, moved to where it is used: above the file list on a tab that
// has one, and in the tab strip for the transcript. Two boxes would mean two
// values to keep in step, and `/` would have to guess which one it meant.
// It is only ever moved when its parent is wrong, so typing does not blur it.
function homeFind(where) {
  const box = $("find");
  if (box.parentNode !== where) where.appendChild(box);
}

function split(box, tab, bodyClass) {
  if (box.dataset.tab !== tab) {
    homeFind($("findhome"));   // it may be inside what is about to be cleared
    box.replaceChildren();
    box.dataset.tab = tab;
    box.dataset.listKey = "";
    box.dataset.bodyKey = "";
    const side = put(box, "div", "side");
    put(side, "div", "findslot");
    put(side, "div", "listnote");    // how many, or why there are none
    // Only the Files tab's list is windowed, and it is the only one whose
    // rows are all one height. A diff row carries a second line of counts, so
    // the arithmetic would not hold there — the tabs share the frame, not the
    // list. The window follows the scrollbar, which is the only thing that
    // moves it, so it is watched rather than redrawn from the top each time.
    const windowed = tab === "files";
    // The tab's own name as a second class, so a tab can style its list
    // without a class name of its own to keep in step with this one.
    const list = put(side, "div",
                     "filelist " + tab + (windowed ? " fixed" : ""));
    if (windowed) {
      list.addEventListener("scroll", () => fillList(list));
      // A list made taller fires no scroll, and the rows it uncovers are
      // then drawn only on the next scroll.
      new ResizeObserver(() => fillList(list)).observe(list);
    }
    // Under the list and pinned there, for what must stay in reach however
    // far the list scrolls. The count strip above it is one clipped line.
    put(side, "div", "sidefoot");
    dragWidth(put(box, "div", "grip"), "--side-w", 150, 700);
    put(box, "div", bodyClass);
    // The Transcript tab's way back to the end, built here with the rest of
    // the frame. It cannot live inside the pane -- `drawTranscript` replaces
    // every child of that -- and building it in `drawTranscript` instead put
    // half of this box's positional contract in another function. It is a
    // branch here for the same reason `windowed` is: one tab wants it, and
    // the frame is where the tab's parts are built.
    if (tab === "transcript") putToFoot(box);
  }
  const side = box.firstChild;
  homeFind(side.firstChild);
  // By position, so that adding a part above does not silently renumber the
  // rest: findslot, count, list, foot.
  // And by position on this side too, not `box.lastChild`: the Transcript
  // tab's button is built above as `box.children[3]`, so the last child is
  // that button rather than the pane.
  return [side.children[2], box.children[2], side.children[1], side.children[3]];
}

// Is the open comment box inside this node? Both row tabs are rebuilt from an
// answer the poll replaces every couple of seconds, and a rebuild under an
// open box would take the text with it and move the code the comment is
// about.
//
// `state.writing` alone says only that a box is open somewhere. One opened on
// the Diff tab then froze the Files tab, which had no box on screen to close:
// the pane kept drawing a file the reader had already left, and only going
// back or reloading got it moving again. So the question is asked of the DOM,
// which knows where the box actually is.
function writingIn(node) {
  return state.writing !== null && node.querySelector(".commentbox") !== null;
}

// `redrawCode` clears `bodyKey`, which is how the box's own open and close get
// through this.
function holdingText(box) {
  return writingIn(box) && box.dataset.bodyKey;
}

function fresh(box, which, key) {
  if (box.dataset[which] === key) return false;
  box.dataset[which] = key;
  return true;
}

// --- finding a file by typing ----------------------------------------------

// Every row is the same height, so where you are in the list is arithmetic
// rather than a measurement, and only the rows on screen have to exist. Two
// spacers stand in for the rest and hold the scrollbar where it belongs.
// Ten thousand matches then cost the same as ten, and no answer has to be cut
// short to keep the tab quick.
const ROW_H = 28;
// The fewest rows a window holds: a tall screenful, and some either side.
// A list taller than this gets as many rows as it can show, and eight more
// at each end (`fillList`). A fixed 80 was 2,240 px, and a portrait or 4K
// screen, or a browser zoomed out, showed empty space under the last row.
const ROWS_SHOWN = 80;

// Which files are Markdown, and so get rendered rather than shown as they are.
const MARKDOWN = /\.(md|markdown)$/i;

// These lead the list. They say what the work is.
const PINNED = ["PLAN.md", "CLAUDE.md", "README.md"];

// The letters you type have to turn up in the name in that order, but they do
// not have to be next to each other: `tsfi` finds `tests/test_files.py`. This
// is what a file picker in an editor does, and typing three letters beats
// scrolling a list every time.
//
// The score decides the order. A run of letters counts for much more than the
// same letters scattered, the start of a path segment or a word counts extra,
// and so does the file's own name over the directories above it.
// `slack` is how many letters of the query may simply not be there. It is for
// file names, where one wrong character should not hide the file you meant. It
// is not for the session filter: that haystack is a short line of text, and
// forgiving a letter there matches half the list.
function fuzzy(text, query, slack = 0) {
  const lower = text.toLowerCase();
  const at = [];
  let score = 0;
  let from = 0;
  let run = 0;
  let missed = 0;
  const base = lower.lastIndexOf("/") + 1;
  for (const want of query) {
    const found = lower.indexOf(want, from);
    if (found < 0) {
      if (++missed > slack) return null;
      score -= 120;              // far more than any bonus below can give back
      run = 0;
      continue;
    }
    run = (found === from && at.length) ? run + 1 : 0;
    score += 10 + run * 14;
    const before = found ? lower[found - 1] : "/";
    if ("/-_. ".includes(before)) score += 10;
    if (found >= base) score += 6;
    score -= Math.min(found - from, 12);      // letters it had to step over
    at.push(found);
    from = found + 1;
  }
  return { score: score - lower.length / 50,
           at: lower.length === text.length ? at : unlowered(text, at) };
}

// Where each place in `text.toLowerCase()` stands in `text`. The two are
// almost always the same length, and then a place is a place. Not always:
// "\u0130" lower-cases to two code units, and every letter `fuzzy` found
// after it was marked one place late -- `notes` lit "btes.". Each code point
// is lower-cased on its own here, which gives the same length as the whole:
// the one rule that reads its neighbours, a final sigma, keeps the length.
function unlowered(text, at) {
  const back = [];
  let where = 0;
  for (const one of text) {
    for (let unit = one.toLowerCase().length; unit > 0; unit -= 1) back.push(where);
    where += one.length;
  }
  return at.map((place) => back[place]);
}

// What a path is matched against: the name, unless you typed a slash.
//
// Matching the whole path let the letters of "MetricsBuilder" land across four
// directory names and a filename — 71 characters apart, in
// `.../odin/agent/metrics/jmx/MBeanSubscriptionBuilder.java` — while the file
// actually wanted did not come back at all. Scattered over a long path, a
// subsequence means nothing. Scattered over a name, it means what you meant.
// A slash in the query says you are thinking about where the file is, and then
// the whole path is fair game.
//: How far apart the letters of a query may sit when it matches a directory
//: rather than a name. 71 characters for a 14-letter query was the nonsense;
//: `libcorrelation` sitting whole inside one directory name is the point.
const TIGHT = 2.5;

function findPath(path, query) {
  // "MetricsBuilder" has an `s` that `MetricBuilder.h` does not, and hiding
  // the file you meant over one character is worse than showing it a little
  // lower down. A short query gets no such forgiveness: there is nothing left
  // of "cfg" once a letter goes.
  const slack = query.length >= 5 ? 1 : 0;
  if (query.includes("/")) return fuzzy(path, query, slack);
  const cut = path.lastIndexOf("/") + 1;
  const named = fuzzy(path.slice(cut), query, slack);
  if (named) {
    // The name is what you were looking for, so it outranks any directory.
    return { score: named.score + 200,
             at: named.at.map((where) => where + cut) };
  }
  // Not in the name, so a directory may be what you meant — `libcorrelation`
  // names a folder, not a file. Only the directories are searched: the name
  // has just been rejected, and scanning it again for every one of fifty
  // thousand paths was most of a keystroke. Only when the letters sit close
  // together, too: spread across four directory names they mean nothing.
  if (!cut) return null;                 // nothing but a name to search
  const wide = fuzzy(path.slice(0, cut), query, slack);
  if (!wide) return null;
  const span = wide.at[wide.at.length - 1] - wide.at[0] + 1;
  return span <= query.length * TIGHT ? wide : null;
}

// --- the tree ---------------------------------------------------------------

// Every directory, with what it holds. One pass over the names, which arrive
// in name order, so each directory's children come out in order too. It is
// built when the names move and not again: a repository of fifty thousand
// files costs about forty milliseconds here, and nothing per draw.
function buildTree(names, skipped) {
  const dirs = new Map([["", { dirs: [], files: [] }]]);
  // Each missing level is made and linked into the one above it, once. A loop
  // that made the parent itself instead stopped on its own next turn, and
  // every directory but the deepest was left hanging off nothing.
  const folder = (path) => {
    let one = dirs.get(path);
    if (one) return one;
    dirs.set(path, one = { dirs: [], files: [] });
    const cut = path.lastIndexOf("/");
    folder(cut < 0 ? "" : path.slice(0, cut)).dirs.push(path);
    return one;
  };
  for (const path of names) {
    const cut = path.lastIndexOf("/");
    folder(cut < 0 ? "" : path.slice(0, cut)).files.push(path);
  }
  // A directory that was not walked holds no name, so nothing above would
  // make it -- and a folder the reader cannot see is the same silence as
  // one that says nothing. It is made here, empty, and the row says why.
  for (const path of skipped || []) folder(path);
  return dirs;
}

// Every directory a path sits under, innermost first. Two walks wanted the
// same index arithmetic, and the two awkward parts of it — the `> 0`, which
// keeps the root out, and stepping back from `at - 1` — are worth having once.
function* ancestors(path) {
  let at = path.lastIndexOf("/");
  while (at > 0) {
    yield path.slice(0, at);
    at = path.lastIndexOf("/", at - 1);
  }
}

// The directories holding something the agent touched, so a closed one can
// still say there is a change inside it.
function dirsWithChanges(changed) {
  const marked = new Set();
  for (const path of changed.keys()) {
    for (const above of ancestors(path)) {
      if (marked.has(above)) break;   // and so is everything above it
      marked.add(above);
    }
  }
  return marked;
}

// Which directories stand open. The ones holding a change open themselves,
// because a closed tree cannot answer what the agent just did, and that is
// the question this tool exists to answer. What the reader opens or closes
// wins over that, so the tree never fights the hand on it.
function openDirs() {
  const open = new Set(state.files.marked);
  for (const [path, wanted] of state.files.dirs) {
    if (wanted) open.add(path); else open.delete(path);
  }
  return open;
}

// One directory's files, in the order they are read: the named files first,
// then whatever changed with the newest first, then the rest by name. The
// three tiers live inside the tree rather than in a section above it, so no
// file is ever listed twice.
function dirFiles(files) {
  if (!files.length) return files;
  const named = files.filter((path) => PINNED.includes(path));
  const moved = files.filter((path) => !PINNED.includes(path) &&
                                       state.files.changed.has(path));
  if (!named.length && !moved.length) return files;
  named.sort((a, b) => PINNED.indexOf(a) - PINNED.indexOf(b));
  moved.sort((a, b) => state.files.changed.get(b) - state.files.changed.get(a));
  const lifted = new Set([...named, ...moved]);
  return named.concat(moved, files.filter((path) => !lifted.has(path)));
}

// The rows a tree shows, in the order they are drawn. Only what is open is
// walked, so a closed repository costs its top level and no more.
//
// A row carries where its name starts, not the name: fifty thousand rows are
// built to draw eighty, so the work of cutting one up belongs where it is
// drawn.
function treeRows(dirs, open) {
  const rows = [];
  const walk = (path, depth) => {
    const one = dirs.get(path);
    if (!one) return;
    const from = path ? path.length + 1 : 0;
    for (const child of one.dirs) {
      // A directory nobody walked cannot open: there is nothing behind it,
      // and a folder that opens onto nothing reads as a broken one.
      const shut = state.files.skipped.has(child);
      const wide = !shut && open.has(child);
      rows.push({ path: child, from, depth, dir: true, open: wide,
                  skipped: shut });
      if (wide) walk(child, depth + 1);
    }
    // Only a directory holding something named or changed needs its files put
    // in order; everywhere else they are already in the order they arrived,
    // and `state.files.marked` says which those are. It halves a fully opened tree.
    const files = (path && !state.files.marked.has(path))
      ? one.files : dirFiles(one.files);
    for (const file of files) rows.push({ path: file, from, depth });
  };
  walk("", 0);
  return rows;
}

// --- go to file --------------------------------------------------------------
//
// What you type opens a list under the box; picking one opens that file and
// shows it in the tree. The tree itself never moves, which is the point: it
// is the answer to "where does this sit", and filtering it away was hiding
// that answer as a way of asking for it.

const GOTO_SHOWN = 40;

// Which row the keys are on. It is the index into what was last drawn, so it
// goes back to the top whenever the query does.
let goToAt = 0;

function goToHits() {
  return pick(state.files.places).slice(0, GOTO_SHOWN);
}

// The list under the box, rebuilt as you type. It lives inside the find slot
// so that `split`'s children keep their positions, and `homeFind` keeps the
// input first because it only moves the box when its parent is wrong.
function drawGoTo(slot) {
  let popup = slot.querySelector(".goto");
  if (!state.find || state.tab !== "files") {
    if (popup) popup.remove();
    // And forget what was drawn, or typing the same query again would match
    // the key and draw nothing at all.
    slot.dataset.goto = "";
    return;
  }
  if (!fresh(slot, "goto", state.find + "\n" + state.files.tag)) return;
  const found = goToHits();
  goToAt = 0;
  if (popup) popup.remove();
  popup = put(slot, "div", "goto");
  if (!found.length) {
    put(popup, "div", "nohits", "no name matches");
    return;
  }
  found.forEach((hit, at) => {
    const row = put(popup, "button", at === goToAt ? "chosen" : "");
    row.title = hit.one;
    putIcon(row, state.files.known.has(hit.one) ? "file" : "dir");
    putName(row, hit.one, hit.at);
    // `mousedown`, not `click`: the box loses focus first otherwise, and the
    // blur that follows would take the list away before the click landed.
    row.addEventListener("mousedown", (press) => {
      press.preventDefault();
      goTo(hit.one);
    });
  });
}

// Open what was picked, and show where it sits. A directory has nothing to
// read, so it is only revealed.
function goTo(path) {
  if (state.files.known.has(path)) chooseFile(path);
  revealInTree(path);          // clears the box, which closes this list
  $("find").blur();
}

// `j`/`k` belong to the sidebar, so this is the arrows and Enter only.
function goToKey(press) {
  const slot = $("find").parentNode;
  const popup = slot.querySelector(".goto");
  const rows = popup ? [...popup.querySelectorAll("button")] : [];
  if (!rows.length) return false;
  if (press.key === "ArrowDown" || press.key === "ArrowUp") {
    goToAt = (goToAt + (press.key === "ArrowDown" ? 1 : rows.length - 1))
      % rows.length;
    rows.forEach((row, at) => row.classList.toggle("chosen", at === goToAt));
    rows[goToAt].scrollIntoView({ block: "nearest" });
    return true;
  }
  if (press.key === "Enter") {
    goTo(rows[goToAt].title);
    return true;
  }
  return false;
}

// What the left column shows. Always the tree: typing opens a list under the
// box (see `drawGoTo`) rather than taking the tree apart. Hiding the tree was
// hiding the answer to "where does this file sit" as a way of asking it.
function listRows() {
  return treeRows(state.files.tree, openDirs());
}

// Everything whose path matches what is typed, in the order it came, each one
// with where the letters landed. `pathOf` says how to get a path out of an
// item, because a file list holds names and a diff holds files. Named `hits`
// because `matches` is the transcript's and `matching` is the tree's, and a
// third word for the same idea in one scope is how one of them gets shadowed.
//
// Every list on screen goes through here, so `findPath` is called in one place
// and the lists cannot come to disagree about what a query means. They did:
// two of them threw the matched letters away and called `findPath` a second
// time, per row, to get them back.
//
// The order is the caller's. A diff's order is git's and must not be
// shuffled; a file list wants the best match first, which is what `pick` adds.
function hits(items, pathOf) {
  const found = [];
  for (const one of items) {
    const hit = findPath(pathOf(one), state.find);
    if (hit) found.push({ one, at: hit.at, score: hit.score });
  }
  return found;
}

// The files a query finds, best match first. It is only ever called with one.
//
// It runs over every name the worktree holds, not over a slice of them. The
// first version searched the first five thousand of 52,799, so typing
// `libcorrelation` found 16 files and missed more than a thousand — a wrong
// answer that looked exactly like a right one.
function pick(names) {
  const found = hits(names, (name) => name);
  found.sort((a, b) => b.score - a.score);
  return found;
}

// The name, with the letters that matched picked out. Every piece is a text
// node, so a file name is never read as markup. A mark is a whole code
// point: `text[index]` is one UTF-16 unit, half of an emoji, and drew a
// broken character. Two places in one code point -- "\u0130" is two when
// lower-cased -- mark it once.
function putName(parent, text, at) {
  const node = put(parent, "span", "name");
  let done = 0;
  for (const index of at) {
    if (index < done || index >= text.length) continue;
    if (index > done) {
      node.appendChild(document.createTextNode(text.slice(done, index)));
    }
    const one = String.fromCodePoint(text.codePointAt(index));
    put(node, "b", "lit", one);
    done = index + one.length;
  }
  if (done < text.length) {
    node.appendChild(document.createTextNode(text.slice(done)));
  }
  return node;
}

// One window of rows, built where the scrollbar stands. `list.found` holds
// what the list is showing: matching every name again on each scroll event
// would cost twenty milliseconds a frame in a large repository.
function fillList(list) {
  if (!list.found) return;        // a scroll before the first draw
  const found = list.found;
  // Clamped to the list as it is now. A scrollbar left deep in ten thousand
  // names, and then a query that matches one, would otherwise put the window
  // past the end and show nothing at all.
  const first = Math.min(Math.max(0, Math.floor(list.scrollTop / ROW_H) - 8),
                         Math.max(0, found.length - 1));
  const many = Math.max(ROWS_SHOWN, Math.ceil(list.clientHeight / ROW_H) + 16);
  const last = Math.min(found.length, first + many);
  if (!fresh(list, "window", first + ":" + last)) return;
  list.replaceChildren();
  put(list, "div", "gap").style.height = first * ROW_H + "px";
  for (let at = first; at < last; at += 1) drawRow(list, found[at]);
  put(list, "div", "gap").style.height = (found.length - last) * ROW_H + "px";
}

// One row: a directory that opens, or a file that is read.
// One row of a list on the left: a button with an icon and a name, stepped
// in by its depth. The file tree and the transcript's map are the same row,
// and the step between levels is a number that must not be in two places.
//
// No triangle in front of a folder. It stood where nothing stood on a file
// row, so a folder's name sat 9 px right of a file's at the same depth -- and
// a file one level deeper then lined up exactly with the folder above it,
// which is the one thing a tree must never do. The open folder icon says what
// the triangle said.
function putListRow(list, { dir, open, chosen, touched, depth, title, icon }) {
  const button = put(list, "button",
                     (dir ? "dir" : "") + (chosen ? " chosen" : "")
                     + (touched ? " touched" : "") + (open ? " open" : ""));
  button.title = title;
  button.style.paddingLeft = (14 + depth * 13) + "px";   // the tree's step
  putIcon(button, icon || (dir ? (open ? "dirOpen" : "dir") : "file"));
  return button;
}

function drawRow(list, row) {
  const dir = !!row.dir;
  const button = putListRow(list, {
    dir,
    open: !!row.open,
    chosen: row.path === state.files.at,
    touched: dir ? state.files.marked.has(row.path)
                 : state.files.changed.has(row.path),
    depth: row.depth,
    title: row.path,
  });
  // A row shows one segment of a path. The letters that matched were found
  // in the whole of it, so a letter found in a directory is picked out on
  // that directory's own row and nowhere else. Cutting the name and the
  // letters up happens here, for the eighty rows that are drawn, not for the
  // fifty thousand that are built.
  const name = row.path.slice(row.from);
  const at = [];
  for (const where of row.hit || []) {
    if (where >= row.from && where - row.from < name.length) {
      at.push(where - row.from);
    }
  }
  putName(button, name, at);
  if (row.skipped) {
    // Where the reader is looking, rather than in a strip at the foot: this
    // is a fact about this folder, and the question it answers -- "where is
    // the rest of it?" -- is asked here.
    put(button, "span", "toobig", "not listed");
    // It promised "opening one in it still works", which nothing on the
    // page could do: no name in it is sent, so none can be found or kept.
    button.title = row.path + " holds more than " + state.files.ignoredMax
                 + " files, so it is left out.";
  }
  button.addEventListener("click", () => {
    if (!dir) { chooseFile(row.path); return; }
    // A folder that was not walked has nothing to open, so the click does
    // the other thing a click on a folder does: it marks where you are.
    if (row.skipped) { state.files.at = row.path; draw(); return; }
    state.files.dirs.set(row.path, !row.open);
    draw();
  });
}

// What the list is showing, and why it is showing that much of it. It counts
// files, never the rows: a tree row can be a directory or a heading.
function noteList(note, found) {
  note.replaceChildren();
  if (state.files.failed) {
    // git failing and a worktree holding nothing look the same and mean
    // opposite things, so the strip says which one this is.
    put(note, "span", null, "git did not answer");
  } else if (state.files.cut) {
    put(note, "span", null, state.files.total + " files, more than one list"
        + " can answer for");
  } else {
    countNote(note, state.files.total);
  }
}

// "1 file" or "N files", in the one place that spells it.
function countNote(note, many) {
  put(note, "span", null, counted(many, "file", "files"));
}

// A count and its noun: "1 reply", "3 replies". One spelling, which nine
// places wrote out for themselves, two of them with `> 1` (#298).
function counted(n, one, many) {
  return n + " " + (n === 1 ? one : many);
}

// --- a file too long to draw whole ------------------------------------------
//
// Measured on a file of 76,000 short lines: 306,000 nodes and about a second
// to build them, and the colouring another second and a quarter on top. That
// is paid again every time the agent saves the file you are reading. Above
// CODE_WHOLE lines only the rows on screen are built, which is a screenful of
// work whatever the file's length, and the file is not coloured: the
// highlighter has to be given the whole file to be right about it, and cutting
// its answer into 76,000 line fragments costs more than the rows did.
//
// Below CODE_WHOLE nothing here runs. An ordinary file is drawn whole, so the
// browser's own find still sees all of it and a copy is the whole file. That
// is worth keeping, and it is why this starts at a length rather than always.
// Measured in a real browser, drawing whole and painting: 2,500 lines cost
// 144 ms, 5,000 cost 280 ms, 10,000 cost 774 ms and 40,000 cost 2.8 s — and
// that is paid again on every save of the file being read. Five thousand
// covers a hand-written source file, which is what a reader is looking at.
//
// A `let`, like `BIG_LINES`, and for the same reason: how much DOM is too
// much is the page's own business, and a test can say so without having to
// build a file of five thousand lines to ask the question.
let CODE_WHOLE = 5000;

// A file of few lines can still be too much to colour: a minified bundle of
// 500 KB is one line, so CODE_WHOLE lets it through, and highlight.js took
// 1.2 to 4 s over it on the main thread -- the sidebar, the alerts and the
// stream all stopped -- again on each save of a watch build. What colouring
// costs follows the size of the highlighted answer, and code on long lines
// is dense: 90 KB of a bundle cost about as much as 290 KB of hand-written
// code in 5,000 lines. So a text over PAINT_MAX characters is not coloured
// when a line in it is longer than LONG_LINE -- and a hand-written file,
// whose lines are short, keeps its colour up to CODE_WHOLE lines, as before.
// A plain cap on the characters would have taken the colour from 10 of 25
// ordinary source files of 2,000 to 5,000 lines, measured in the standard
// library: the scar CODE_WHOLE already carries. `paintedLines` asks, so the
// Files tab, a diff and a slice all keep to it.
let PAINT_MAX = 100000;
const LONG_LINE = 1000;

function tooDenseToPaint(text) {
  if (text.length <= PAINT_MAX) return false;
  for (let from = 0; from < text.length;) {
    let end = text.indexOf("\n", from);
    if (end < 0) end = text.length;
    if (end - from > LONG_LINE) return true;
    from = end + 1;
  }
  return false;
}

const CODE_H = 21;          // one row, exactly. `.dlines` sets the same number
const CODE_SHOWN = 160;     // a tall screenful, and some either side

// A line with a comment under it is taller than a row, and a row's height is
// how the window knows where it is. There are never many, so they are kept one
// by one: measured once the block has been drawn, and guessed until then. A
// guess only moves the scrollbar a little, and it is replaced the first time
// the block is on screen.
const CODE_GUESS = 5 * CODE_H;

// The lines of this file that carry a comment, or a half-written one, with how
// tall each one makes its row. In line order, because both readers below walk
// them from the top.
function tallLines(code) {
  const anchors = new Set(state.review.comments.map((one) => one.anchor));
  if (state.writing !== null) anchors.add(state.writing);
  const tall = [];
  for (const anchor of anchors) {
    const [path, line] = anchor.split("\n");
    if (path !== code.path || line === "0") continue;
    const at = Number(line) - 1;                  // lines are counted from one
    tall.push([at, code.tall.get(at) || CODE_GUESS]);
  }
  return tall.sort((one, two) => one[0] - two[0]);
}

// How tall the first `n` lines are together.
function heightOf(tall, n) {
  let px = n * CODE_H;
  for (const [line, extra] of tall) {
    if (line >= n) break;
    px += extra;
  }
  return px;
}

// Which line stands `y` pixels down. The plain rows are arithmetic; only the
// few that carry a comment have to be counted one at a time.
//
// A `y` inside a comment's box is that comment's line. The box's pixels were
// counted as rows, so a reader scrolled into a comment taller than eight rows
// got a window that began past what was on screen, and saw nothing at all.
function lineAt(tall, y) {
  let line = 0;
  let top = 0;
  for (const [where, extra] of tall) {
    const rows = (where - line + 1) * CODE_H;
    if (top + rows > y) break;
    if (top + rows + extra > y) return where;
    top += rows + extra;
    line = where + 1;
  }
  return line + Math.max(0, Math.floor((y - top) / CODE_H));
}

// One window of rows, built where the scrollbar stands. The two gaps stand in
// for the rows above and below it, so the scrollbar is the length of the whole
// file even though the file is not there.
function fillCode(pane, at = pane.scrollTop) {
  const code = pane.querySelector(".code.windowed");
  if (!code) return;                   // a short file, or another tab's body
  // The window stands still while a comment is being written in it, for the
  // reason the diff stands still: moving it would throw away what is being
  // typed. A box open on some other file or tab is none of its business. A
  // window that has not been drawn yet is drawn all the same — that is the
  // redraw the box itself asked for, the same trick `holdingText` plays.
  if (writingIn(code) && code.dataset.window) return;
  const all = code.lines;
  const tall = tallLines(code);
  // Where the code starts inside the pane, so that how far the reader has
  // scrolled can be read as a line number. The path and the note sit above it.
  const from = code.offsetTop - pane.offsetTop;
  const first = Math.min(
    Math.max(0, lineAt(tall, at - from) - 8),
    Math.max(0, all.length - 1));
  const last = Math.min(all.length, first + CODE_SHOWN);
  if (!fresh(code, "window", first + ":" + last)) return;
  // The pane is what scrolls sideways now, and the pane is not rebuilt, so
  // how far along the reader stood carries over on its own.
  code.replaceChildren();
  put(code, "div", "gap").style.height = heightOf(tall, first) + "px";
  fillDiffFile(code, asLines(code.path, all.slice(first, last), first + 1));
  put(code, "div", "gap").style.height =
    (heightOf(tall, all.length) - heightOf(tall, last)) + "px";
  measureTall(code, tall, first, last);
}

// What a comment block actually came out as, kept for the next window. The
// blocks are drawn in line order, so they line up with the lines that have
// one; if they do not, nothing is measured rather than something guessed at.
function measureTall(code, tall, first, last) {
  const blocks = code.querySelectorAll(".onLine");
  const shown = tall.filter(([line]) => line >= first && line < last);
  if (blocks.length !== shown.length) return;
  shown.forEach(([line], at) => code.tall.set(line, blocks[at].offsetHeight));
}

function drawFiles(box) {
  const [list, pane, note] = split(box, "files", "filebody");
  drawGoTo($("find").parentNode);

  // What the list draws is what decides whether it is drawn again: which
  // names there are, which file is open, which carry a dot, and which
  // directories stand open. The names come as `filesTag`, which is the
  // daemon's own hash of them, so this is exact rather than sampled.
  //
  // A pinned file does not move when it changes, so without the changed names
  // in here its dot never appeared — the whole reason this key exists. The
  // mtimes stay out: folding those in re-rendered the open document.
  if (fresh(box, "listKey", JSON.stringify(
      [state.find, state.files.path, state.files.at, state.files.failed,
       state.files.tag, [...state.files.skipped],
       [...state.files.changed.keys()].sort(), [...state.files.dirs]]))) {
    // Built here and not before: with a query typed this is a pass over every
    // name in the repository, and a poll that changes nothing wants none of
    // it.
    const found = listRows();
    list.found = found;
    // A different set of names starts at the top: the best match is the first
    // row, and that is the row you meant. A file being touched, or another
    // one being opened, is not a different set and does not move you.
    const asked = state.find + "\n" + state.files.tag;
    if (fresh(list, "asked", asked)) list.scrollTop = 0;
    list.dataset.window = "";
    fillList(list);
    noteList(note, found);
  }
  goToInList(list);

  if (holdingText(box)) return;
  // The session is part of it. Two sessions in one worktree land on the
  // same file with the same mtime, and without it the second kept the
  // first one's `.filescroll` -- whose listener writes nothing once another
  // session is chosen, so its place was never kept and a windowed file
  // never filled.
  if (!fresh(box, "bodyKey", state.chosen + "\n" + state.files.path + "\n"
                           + state.files.mtime + "\n" + state.files.asText
                           + "\n" + state.files.read + "\n"
                           + (state.files.read ? "" : state.files.trouble))) {
    return;
  }
  // Where the scroller stands now, which the listener below may not have
  // written down yet: a browser reports a scroll a frame late, and a poll
  // that brought the file again rebuilt the pane in between -- so the place
  // put back was the one before, and the reader was sent back there. Only
  // from a file drawn for this session, and only for the same file: a pane
  // still reading stands at nought, and that is not a place.
  const shown = pane.querySelector(".filescroll");
  if (shown && shown.dataset.drawn === state.chosen
      && pane.dataset.file === String(state.files.path)) {
    state.files.down = shown.scrollTop;
  }
  pane.replaceChildren();
  pane.dataset.file = String(state.files.path);
  if (!state.files.path) {
    const empty = put(pane, "div", "empty");
    put(empty, "p", null, state.files.failed
      ? "git did not answer, so there is no list yet. It is tried again in a"
        + " few seconds."
      : state.files.names.length
      ? "Pick a file on the left, or type to find one."
      : "This worktree holds no file that git knows about.");
    return;
  }
  // Nothing read yet: the header says where the file is, and the body says
  // it is reading, or why it could not. Before the line asked for is taken
  // below -- it is for the text, which has not come yet.
  if (!state.files.read) {
    putWhere(pane, state.files.path);
    const empty = put(put(pane, "div", "filescroll"), "div", "empty");
    put(empty, "p", null, state.files.trouble
      ? "Could not read " + state.files.path + ": " + state.files.trouble
        + ". It is asked for again in a few seconds."
      : "reading…");
    return;
  }
  // Where the reader is in this file, whether they scrolled there a moment
  // ago or left it on their last visit to this session. `forgetFile` puts it
  // back to nought, which is what makes a different file open at its top.
  const place = state.files.down;
  const isDoc = MARKDOWN.test(state.files.path) && !state.files.binary;
  // Split once. The header wants to know how long the file is and so does the
  // body, and two copies of that arithmetic are two copies that can drift —
  // the one that says a file is too long to wrap, and the one that windows it.
  const asCode = !state.files.binary && !(isDoc && !state.files.asText);
  const body = asCode ? state.files.text.replace(/\n$/, "") : "";
  const rows = asCode ? linesOf(body) : null;
  const windowed = !!rows && rows.length > CODE_WHOLE;
  const plain = !!rows && !windowed && tooDenseToPaint(body);
  const where = putWhere(pane, state.files.path);
  putAbout(where, windowed);
  if (isDoc) putAsText(where);          // last, so it stands at the right end
  // Everything below the header, and the only thing that scrolls. It is built
  // with the file, so the listener a windowed file needs goes on with it.
  const view = put(pane, "div", "filescroll");
  // Where the reader is, written down as they move. One writer, and it is
  // the scrollbar: asking the DOM from `showTab` and again from `savePlace`
  // meant two writers with different fallbacks, and the second one wrote the
  // outgoing session's place over the place just restored for the new one.
  //
  // Whose scrollbar, though. This node is built for one session and outlives
  // the moment another is chosen -- leaving the Files tab does not rebuild
  // it -- so a scroll event still queued when `choose` runs arrives after
  // `usePlace` has put the new session's place back, and writes the old
  // session's number over it. Caught as a test that only failed under load,
  // which is what that ordering needs.
  const mine = state.chosen;
  view.dataset.drawn = mine;
  view.addEventListener("scroll", () => {
    if (state.chosen !== mine) return;
    state.files.down = view.scrollTop;
    if (windowed) fillCode(view);
  });
  if (state.files.binary) {
    putMedia(view, state.files.path, state.files);
  } else if (isDoc && !state.files.asText) {
    markdown(view, state.files.text);
  } else {
    // One row per line, through the same renderer the diff uses, so a file
    // gets the numbers, the `+` and the comments the diff already had — and a
    // comment on line 42 lands on the same anchor whichever tab wrote it.
    //
    // The rows and the highlighter are given the very same text, so the two
    // can never disagree about how many lines there are. Both were worked out
    // above, because the header asks the same question.
    if (windowed) {
      // Only for a file that really is too long to draw. Said plainly,
      // because both of these are things the reader would otherwise go
      // looking for and not find.
      put(view, "div", "note", rows.length + " lines — too many to draw at"
          + " once. Only the ones on screen are here, so this file has no"
          + " colour and your browser's own find will not see the rest.");
    }
    if (plain) {
      put(view, "div", "note", "Lines of more than "
          + LONG_LINE.toLocaleString("en") + " characters are too slow to"
          + " colour. Colouring them would stop this page each time the file"
          + " changes, so this file has no colour.");
    }
    const code = put(view, "div", "code" + (windowed ? " windowed" : ""));
    code.dataset.path = state.files.path;
    if (windowed) {
      code.lines = rows;
      code.path = state.files.path;
      code.tall = new Map();
      // Where the reader will be once `place` is put back, not where an
      // emptied pane says they are: the rows have to be there before the
      // scrollbar can reach them.
      fillCode(view, place);
    } else {
      fillDiffFile(code, asLines(state.files.path, rows));
      paintLines(code, state.files.path, body, state.files.lang);
    }
  }
  // Said outright, rather than only when there is a place to go back to.
  // `view` is built with the file, so a different file already starts at
  // nought -- the pane used to be the scroller, it outlived the file in it,
  // and a `replaceChildren` does not reliably put its bar back.
  requestAnimationFrame(() => {
    // A place waits for the file to be there. The first draw after a session
    // is chosen has no text yet, and setting the bar against nothing would
    // scroll to nought and then be written back as the place.
    if (place && view.scrollHeight <= view.clientHeight) return;
    view.scrollTop = place;
  });
}

// A file with no text in it. A picture, a video or a sound is shown as it is;
// anything else really has nothing to show, and says so.
//
// What kind of file this is comes from the daemon, in the same answer as the
// text: `found.shown` is the type it will be served as, or empty. The list
// lives there, with the route that has to enforce it. A copy of it here would
// be a second list in a second language, and a mismatch is silent either way
// round -- a picture that never arrives, or a file that is never offered.
//
// Everything it needs is an argument. The Files tab and an untracked file on
// the Diff tab are the same question, and a screenshot an agent has just
// taken is an untracked file.
function putMedia(parent, path, found) {
  if (!found.shown) {
    put(parent, "div", "note", "Binary file. There is nothing to show.");
    return;
  }
  if (found.oversize) {
    put(parent, "div", "note", sizeOf(found.size) + " — too big to show here.");
    return;
  }
  const kind = found.shown.split("/")[0];       // image, video or audio
  const box = put(parent, "div", "media");
  const node = document.createElement(kind === "image" ? "img" : kind);
  // The mtime is in the address, so a file the agent has just written is a
  // different address and is fetched again. This is the one answer the
  // daemon lets a browser keep, and that is why.
  node.src = apiUrl(state.chosen, "raw", "?path=" + encodeURIComponent(path)
                                         + "&at=" + found.mtime);
  if (kind === "image") node.alt = path;
  else node.controls = true;
  // A type the browser will not take, or a file that went away between the
  // listing and the fetch. Saying so beats a broken picture.
  node.addEventListener("error", () => {
    box.replaceChildren();
    put(box, "div", "note", "This one did not come back, or your browser"
        + " cannot show it.");
  });
  box.appendChild(node);
}



// An empty Files tab. One place, so that choosing a session, choosing a file
// and starting up cannot drift apart about what "nothing is open" means.
// The Transcript tab's whole state, so that choosing a session is one
// assignment rather than six that could forget the seventh -- which is the
// reason `blankFiles` exists, in a second place.
//
// The blocks are in here too. Nothing outside this tab reads them: the
// sidebar's counts come from the session rows, and the daemon pushes blocks
// at a browser without asking which tab it is on.
function blankTurns() {
  return {
    blocks: [],         // what the daemon has pushed, by seq
    nodes: [],          // the node drawn for each one, so one can be redrawn
    run: -1,            // which reading of this transcript those are from
    open: new Set(),    // blocks the reader opened: a tool, a long message
    shut: new Set(),    // rounds the reader folded shut on the map
    goTo: null,         // a block a link asked for, until it is on screen
    goToTs: null,       // and its moment, for a saved turn (#377)
    goToNear: null,     // or about when, for a search result (#379)
    at: null,           // the block the list marks: the last place you went
    down: null,         // how far down the transcript you were; null is none
    early: null,        // pushes that land while a fetch is on its way
    told: null,         // how long the stream said the transcript is, meanwhile
    failed: false,      // the last fetch failed; "nothing yet" would lie
    version: 0,         // the daemon's count of changes read, as far as held
    whole: false,       // blocks are a fetch and every push since, no gap
    // Whether a fetch has answered for this session yet, with blocks, with
    // none, or with a failure. A session with no transcript is answered
    // with no `run`, so nothing else tells "empty" from "not asked yet" --
    // and the tests wait on it before they read the tab.
    landed: false,
    // When the reader last had this session on screen, taken once, before
    // it is read (#374): the "new" line stands over the first block after
    // it. `undefined` is not taken yet, null is no line.
    newSince: undefined,
    newLanded: false,   // the line was scrolled to, once
    newDown: null,      // where that left the pane, to tell a scroll since
  };
}

// Everything the Diff tab holds for one session. A choice here is one the
// session keeps (`KEPT`); the rest is what the daemon sent, or what a read
// is doing. The fields were flat on `state`, and `choose` reset them in
// eighteen lines that a new one had to join (#300).
function blankDiff() {
  return {
    // What the tab shows: "" for all changes, "uncommitted", or one
    // commit's sha.
    of: "",
    gone: false,        // the commit picked went away; the tab says so
    shut: new Set(),    // folders in the tab's tree the reader shut
    open: new Map(),    // files the reader opened or shut by hand
    // Lines the reader asked to see between the changes, as `[from, to]`
    // runs by `moreKey`, and the whole files fetched to show them. See
    // `withMore`.
    more: new Map(),
    whole: new Map(),
    tag: "",            // the tag of the answer held, sent back as `have`
    loose: null,        // an untracked file picked
    found: null,        // the daemon's answer for it; null while it is read
    asking: null,       // the path a read is out for, so a poll asks once
    trouble: "",        // why it is not read yet, when a read failed
    goTo: false,        // whether the pane still has to move to it
  };
}

function blankFiles() {
  return {
    names: [],          // every path in the worktree, in the order sent
    known: new Set(),   // the same paths, for asking whether one is still there
    places: [],         // the names and the directories, for "go to file"
    tree: new Map(),    // every directory, with what it holds
    marked: new Set(),  // the directories holding something that changed
    dirs: new Map(),    // the ones the reader opened or closed by hand
    changed: new Map(), // the ones git says the agent touched, and when
    total: 0,           // how many the worktree holds
    cut: false,         // more than the daemon will send
    failed: false,      // git did not answer; "no files" would lie
    // Ignored directories the daemon declined to walk, and the number it
    // declined them at. They hold nothing, so the tree is told their names
    // and the row says why it cannot be opened.
    skipped: new Set(),
    ignoredMax: 0,
    tag: "",            // the daemon's name for the listing we hold
    path: null,         // the file it shows
    // The row the list marks: the last place the reader went. Usually the
    // open file, and a directory when they asked for one by name or by
    // clicking a part of the path above the file. Marking only the open file
    // meant clicking a part of a path that was already on screen answered
    // with nothing at all.
    at: null,
    text: "",
    binary: false,
    // What the daemon will serve this one as, when the page may show it as
    // it is -- `image/png`, and so on -- and whether it is past the cap. The
    // list is the daemon's; see `putMedia`.
    shown: "",
    oversize: false,
    lang: "",           // what `file` made of it, when the name said nothing
    mtime: 0,           // which version of that text is loaded
    stamp: "",          // the daemon's name for that version, sent back (#292)
    size: 0,            // its bytes on disk, which the decoded text does not say
    // Whether any answer for this file has landed. Not `mtime`, which a
    // file can really have as nought. Until one lands the pane says it is
    // reading, or why it could not -- `trouble` -- and never draws the empty
    // text above as the file: that read as a file with nothing in it.
    read: false,
    trouble: "",
    // Markdown reads as Markdown, which has no lines to comment on. This
    // turns it back into the rows every other file gets. It is remembered
    // across files, because a reader who wants to review one document
    // usually wants to review the next one too.
    asText: false,
    goTo: null,         // a path the list has been asked to move to
    // How far down the open file the reader was, kept across a tab switch
    // and across a visit to another session. Put back once, when there is
    // something under the scrollbar to put it back into.
    down: 0,
  };
}

// --- how a file is drawn -----------------------------------------------------
//
// Two choices the reader makes about reading, not about a session: how wide a
// tab is, and whether a long line wraps. In `settings.json`, like the theme,
// as `tab_width` and `long_lines`.

const TAB_WIDTHS = [2, 4, 8];

// Both live on the root element, the theme's pattern, and for the same
// reason: the cascade does the work, so neither control has to rebuild
// anything to be obeyed. What they are is the settings' to say
// (`readingWanted`); the root was read back as a second copy of it (#299).
function applyReading(next) {
  const root = document.documentElement;
  root.style.setProperty("--tab-w", String(next.tab));
  root.dataset.wrap = next.wrap ? "yes" : "no";
}

// What the file says. Whatever it did not answer for, the default stands --
// and the default is applied either way, so the gutter and the label cannot
// disagree.
function readingWanted() {
  const tab = setting("tab_width");
  return { tab: TAB_WIDTHS.includes(tab) ? tab : 4,
           wrap: setting("long_lines") === "wrap" };
}

// How big a file is, in the units a person reads. Bytes on disk, which is not
// what the text length says once it has been decoded or cut.
function sizeOf(bytes) {
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + " KB";
  return (bytes / (1024 * 1024)).toFixed(1) + " MB";
}

// `21 Sep 07:20`, which is short enough to sit in a header and exact enough
// to tell two saves apart. The day is always in it: a file's mtime is read
// against other files' mtimes, not against the time of day.
function whenOf(seconds) {
  if (!seconds) return "";
  const at = new Date(seconds * 1000);
  return at.getDate() + " " + MONTHS[at.getMonth()] + " " + clock(seconds);
}

// The path of the open file, one clickable piece per part of it, and still
// one string to select and copy: the separators are text nodes and nothing in
// here is a block, so a selection across the whole line yields the path.
//
// Clicking a part is how you find where a file sits. `libcorrelation` is a
// directory somewhere in fifty thousand rows, and scrolling to it by hand is
// not something anyone does twice.
function putWhere(pane, path) {
  const where = put(pane, "div", "where");
  const crumbs = put(where, "span", "crumbs");
  let sofar = "";
  for (const part of path.split("/")) {
    if (sofar) crumbs.appendChild(document.createTextNode("/"));
    sofar = sofar ? sofar + "/" + part : part;
    const upto = sofar;
    const piece = put(crumbs, "span", "crumb", part);
    piece.title = "show " + upto + " in the list";
    piece.addEventListener("click", () => revealInTree(upto));
  }
  return where;
}

// What is known about the open file, and the two controls for how it is
// drawn. Everything here is already in hand: the type the page worked out to
// paint it, and the size and mtime the daemon took from the one stat it does
// anyway.
function putAbout(where, windowed) {
  const facts = [];
  const lang = languageOf(state.files.path, state.files.text, state.files.lang);
  if (lang) facts.push(lang);
  if (state.files.size) facts.push(sizeOf(state.files.size));
  const when = whenOf(state.files.mtime);
  if (when) facts.push(when);
  if (facts.length) put(where, "span", "whatis", facts.join(" · "));
  // How a file is drawn -- the tab width and long lines -- is the settings
  // menu's now, one place for the Files and the Review tabs. A windowed file
  // cannot wrap, and says so while wrap is on: its rows are a grid the
  // scrollbar is read against. The CSS shows the note, so turning wrap on or
  // off rebuilds nothing.
  if (windowed) put(where, "span", "nowrap", "too long to wrap");
}

// Open the tree down to a path, and ask the list to move to it. A filter hides
// most of the tree, and revealing something the filter has taken out would
// show nothing at all, so the box is cleared first.
function revealInTree(path) {
  for (const above of ancestors(path)) state.files.dirs.set(above, true);
  state.files.dirs.set(path, true);   // a directory opens itself; a file has
                                      // no entry, and setting one is harmless
  state.files.goTo = path;
  state.files.at = path;              // and the list marks where you landed
  if (state.find) {
    $("find").value = "";
    state.find = "";
  }
  draw();
}

// Put the window over the row that was asked for. It runs after the rows are
// built, because which row a path is depends on which directories stand open.
function goToInList(list) {
  const want = state.files.goTo;
  if (!want || !list.found) return;
  state.files.goTo = null;
  const at = list.found.findIndex((row) => row.path === want);
  if (at < 0) return;                 // the filter or a closed tree hid it
  // Three rows of air above it, so it does not sit against the top edge.
  list.scrollTop = Math.max(0, (at - 3) * ROW_H);
  fillList(list);
}

// Read this document as Markdown, or as the lines it is written in. A
// rendered document has no line to hang a comment on: the paragraph you want
// to remark on came from a line that is no longer there. This gives it back.
function putAsText(where) {
  putReadAs(where, state.files.asText, (asText) => {
    if (asText === state.files.asText) return;
    state.files.asText = asText;
    redrawCode();
  }, "show the lines, so they can be commented on");
}

function forgetFile(path) {
  // A comment box belongs to the file it is on. Leaving the file takes the
  // box with it, so the flag goes too — it is what `putReview` would reopen.
  if (state.writing !== null) state.writing = null;
  state.files.path = path;
  state.files.at = path;
  state.files.down = 0;       // another file, so there is no place to go back to
  state.files.text = "";
  state.files.binary = false;
  state.files.shown = "";
  state.files.oversize = false;
  state.files.lang = "";
  state.files.mtime = 0;
  state.files.size = 0;
  state.files.stamp = "";
  state.files.read = false;
  state.files.trouble = "";
}

function chooseFile(path) {
  if (state.files.path === path) return;
  forgetFile(path);
  load();
}

// --- the Diff tab -----------------------------------------------------------

// A long file starts closed. Building ten thousand lines nobody asked to see
// makes the whole tab slow to open. How much DOM is too much is the page's
// own business, so the number lives here and is sent nowhere.
let BIG_LINES = 500;

// One column, or the old file beside the new one. It is about this screen
// and not about a session -- a narrow window wants one column whatever it
// shows -- so it is in `settings.json`, like the theme, as `diff_columns`.
// Unlike the tab width it cannot be a rule in the cascade: a row beside a
// row is a different row, so a change rebuilds the diff.
//
// A change from the file waits while a comment is being written, as the
// reader's own does (`busyWriting`): a rebuild takes the open box with it.
function takeSides(redraw) {
  const want = setting("diff_columns") === "two" ? "split" : "unified";
  if (state.sides === want) return;
  if (redraw && writingIn($("content"))) return;
  state.sides = want;
  if (redraw) draw();
}

// Both of these rebuild the diff, and a rebuild under an open comment box
// takes what is in it -- so they wait, and say why, rather than quietly
// doing nothing until the box closes.
function busyWriting() {
  if (!writingIn($("content"))) return false;
  note("Save or cancel the comment first.");
  return true;
}

function keepSides(next) {
  if (state.sides === next || busyWriting()) return;
  state.sides = next;
  keepSetting({ diff_columns: next === "split" ? "two" : "one" });
  draw();                           // `sides` is in the body's redraw key
}

// What a worktree's branch is measured against, picked by the reader. The
// daemon finds the branch it was cut from (`pick_base`), which is right for
// a backport as much as for a feature; the pick is for when it is not. Kept
// in this browser per worktree -- it is about that checkout, not about a
// session, and not a config file -- and sent as `?base=`, where the daemon
// uses it only if git lists that name. Empty is "what the daemon found".
const BASE_KEY = "wostuast-base\n";

// The worktree's top, as git gave it; `cwd` moves with every `cd` the agent
// makes, and a pick keyed on it looked as if it had never been made.
function baseHome(s) {
  return s ? s.root || s.cwd || "" : "";
}

function recallBase() {
  const home = baseHome(current());
  if (!home) return "";
  return stored(BASE_KEY + home);
}

function keepBase(name) {
  const home = baseHome(current());
  if (!home || name === recallBase() || busyWriting()) {
    draw();                         // puts the picker back to what is shown
    return;
  }
  store(BASE_KEY + home, name);
  // Another base is another list of commits, so a picked one may not be on
  // it. What the reader revealed (`state.diffs.more`) stays: it is lines of
  // HEAD and of the disk, which no base moves, and a whole file kept for
  // the old hunks is dropped by `withMore` when they change.
  state.diffs.of = "";
  state.diffs.gone = false;
  state.diffs.tag = "";
  loadDiff();
}

// What the tab shows: everything, what is not committed, or one commit. The
// answer is the daemon's, so this asks again rather than cutting up what it
// has -- one commit is not a slice of the branch's diff.
function pickDiff(of) {
  if (state.diffs.of === of || busyWriting()) {
    draw();                         // puts the picker back to what is shown
    return;
  }
  state.diffs.of = of;
  state.diffs.gone = false;
  state.diffs.loose = null;               // a commit has no untracked files
  state.diffs.tag = "";
  loadDiff();
}

// The bar over the diff. Built once with the pane, so a poll never rebuilds
// the picker under the hand: a `select` that is refilled closes if it is open.
function putDiffBar(pane) {
  const bar = put(pane, "div", "diffbar");
  const pick = put(bar, "select", "pickof");
  pick.title = "what this tab shows";
  pick.addEventListener("change", () => pickDiff(pick.value));
  // The word stands outside the picker, so the picker holds only names and
  // has their room: "against main" was cut to "against ma".
  put(bar, "span", "baseword", "against");
  const base = put(bar, "select", "pickbase");
  base.title = "what this branch's work is measured against";
  base.addEventListener("change", () => keepBase(base.value));
  const step = (word, title, by) => {
    const button = put(bar, "button", "verb quiet step", word);
    button.title = title;
    button.addEventListener("click", () => stepCommit(by));
  };
  step("\u2039 older", "the commit before this one", 1);
  // Which commit of how many, oldest first, so the first commit of a branch
  // is 1: stepping through a review, "5 / 9" says how far there is to go.
  put(bar, "span", "stepat");
  step("newer \u203a", "the commit after this one", -1);
  const scroll = put(pane, "div", "diffscroll");
  // Which file is under the top of the pane, marked in the tree, the way a
  // long pull request keeps its place in the list beside it. Once a frame at
  // most: a scroll gesture fires dozens of events.
  let queued = false;
  scroll.addEventListener("scroll", () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; markDiffFile(); });
  });
}


function commitsOf(report) {
  return (report && report.commits) || [];
}

// Where the picked commit stands in the list, newest first; -1 for none.
function commitAt(commits) {
  return commits.findIndex((one) => one.sha === state.diffs.of);
}

function stepCommit(by) {
  const commits = commitsOf(state.diff);
  const at = commitAt(commits);
  const next = commits[at + by];
  if (at >= 0 && next) pickDiff(next.sha);
}

function fillDiffBar(bar) {
  const report = state.diff || {};
  const commits = commitsOf(report);
  const pick = bar.querySelector(".pickof");
  const key = state.diffs.of + "\n" + (report.recent ? "recent" : "") + "\n"
    + commits.map((one) => one.sha + one.subject).join("\n");
  if (fresh(bar, "key", key)) {
    pick.replaceChildren();
    const option = (parent, value, text) => {
      const one = put(parent, "option", null, text);
      one.value = value;
      return one;
    };
    // How many commits "all changes" holds, which is the branch's own and
    // not the last few on the default branch: those are no part of it.
    const own = report.recent ? 0 : commits.length;
    option(pick, "", "all changes"
           + (own ? " (" + counted(own, "commit", "commits") + ")" : ""));
    option(pick, "uncommitted", "not committed yet");
    if (commits.length) {
      const group = put(pick, "optgroup");
      // On the default branch itself there is no work of the branch's own,
      // and the last few commits are what the session did.
      group.label = report.recent ? "recent commits" : "commits on this branch";
      for (const one of commits) {
        option(group, one.sha, one.short + "  " + one.subject);
      }
    }
    // Picked before the list that names it has arrived.
    if (![...pick.options].some((one) => one.value === state.diffs.of)) {
      option(pick, state.diffs.of, state.diffs.of.slice(0, 7));
    }
  }
  pick.value = state.diffs.of;
  // The same guard as the commit picker: a `select` refilled under the hand
  // closes if it is open, and the tab polls.
  const base = bar.querySelector(".pickbase");
  const offered = report.bases || [];
  const wanted = recallBase();
  if (fresh(bar, "baseKey", [report.base_auto || "", wanted, ...offered].join("\n"))) {
    base.replaceChildren();
    const option = (value, text) => {
      const one = put(base, "option", null, text);
      one.value = value;
    };
    option("", report.base_auto ? report.base_auto + " (found)"
                                : "no branch to compare against");
    for (const name of offered) {
      if (name !== report.base_auto) option(name, name);
    }
    // Picked, and not on the list any more: said, rather than silently
    // shown as the one found.
    if (wanted && !offered.includes(wanted)) option(wanted, wanted + " (gone)");
  }
  base.value = wanted;
  base.hidden = !offered.length && !wanted;
  bar.querySelector(".baseword").hidden = base.hidden;
  const at = commitAt(commits);
  const [older, newer] = bar.querySelectorAll(".step");
  older.disabled = at < 0 || at + 1 >= commits.length;
  newer.disabled = at <= 0;
  const where = bar.querySelector(".stepat");
  where.hidden = at < 0;
  where.textContent = at < 0 ? "" : (commits.length - at) + " / " + commits.length;
  where.title = at < 0 ? "" : "commit " + (commits.length - at) + " of the "
    + commits.length + (report.recent ? " last ones" : " on this branch")
    + ", oldest first";
}

// A commit message is wrapped by hand at about 72 columns, and drawn as it
// stood it broke there whatever the width of the window -- lines cut short.
// A paragraph's lines are joined, so the window wraps them; a line that
// starts a list item, is indented, or is a trailer (`Refs: OA-1`) keeps its
// own line, because there the break is the meaning.
function reflow(text) {
  return String(text).split(/\n{2,}/).map((para) => {
    const out = [];
    for (const line of para.split("\n")) {
      const own = /^(\s|[-*+]\s|\d+[.)]\s|[A-Za-z][\w-]*: )/.test(line);
      if (out.length && !own) out[out.length - 1] += " " + line.trim();
      else out.push(line);
    }
    return out.join("\n");
  }).join("\n\n");
}

// A commit message is Markdown more often than not -- an agent writes it --
// and read as Markdown by default; the reader can see it as the text it was
// written as, and this browser keeps which (`MESSAGE_KEY`). Either way it
// goes through `reflow` first, and a line `reflow` keeps is a hard break in
// Markdown too: a trailer or an indented line keeps its own line in both.
// The toggle fills the message again and nothing else, so it never takes a
// comment half written with a rebuild.
const MESSAGE_KEY = "wostuast-message-as";

function messageAsText() {
  return stored(MESSAGE_KEY) === "text";
}

function putMessage(head, body) {
  const box = put(head, "div", "message");
  // In the subject's line, at its right end: `.diffhead.commit` is a grid
  // that puts it there, wherever it stands among the head's children.
  const toggle = putReadAs(head, messageAsText(), (asText) => {
    if (asText === messageAsText()) return;
    store(MESSAGE_KEY, asText ? "text" : "markdown");
    fill();
  }, "show the message as it was written");
  const fill = () => {
    // Without `marked` there is no Markdown to draw, and the text as written
    // is the fallback, lines and all -- not Markdown source run together.
    toggle.hidden = !window.marked;
    const asText = messageAsText() || !window.marked;
    box.classList.toggle("astext", asText);
    paintChoice(toggle, asText);
    const text = reflow(body);
    box.replaceChildren();
    if (asText) box.textContent = text;
    else markdown(box, text.split(/\n{2,}/).map(
      (para) => para.split("\n").join("  \n")).join("\n\n"));
    linkTickets(box);
  };
  fill();
}

// A diff's files in the order its tree reads: at each level the folders
// first, then the files, each by name. The pane follows the tree, so the
// list and the blocks beside it read the same way down.
function treeOrder(found, pathOf) {
  const parts = found.map((hit) => [pathOf(hit).split("/"), hit]);
  parts.sort(([a], [b]) => {
    for (let at = 0; at < Math.min(a.length, b.length); at += 1) {
      if (a[at] === b[at]) continue;
      const aDir = at < a.length - 1;
      const bDir = at < b.length - 1;
      if (aDir !== bDir) return aDir ? -1 : 1;
      const one = a[at].toLowerCase();
      const two = b[at].toLowerCase();
      if (one !== two) return one < two ? -1 : 1;
      return a[at] < b[at] ? -1 : 1;
    }
    return a.length - b.length;
  });
  return parts.map(([, hit]) => hit);
}

// A section's files as a tree. A folder that holds nothing but one other
// folder is one row -- `native/shared/src` -- because three rows to reach one
// file is three rows of nothing. Folders stand open unless the reader shut
// one, and all of them stand open while the find box has a query in it: a
// match inside a shut folder is a match nobody sees.
function putDiffTree(list, section, found, pathOf, fill) {
  const root = { dirs: new Map(), files: [] };
  for (const hit of found) {
    let at = root;
    for (const part of pathOf(hit).split("/").slice(0, -1)) {
      if (!at.dirs.has(part)) at.dirs.set(part, { dirs: new Map(), files: [] });
      at = at.dirs.get(part);
    }
    at.files.push(hit);
  }
  const walk = (dir, path, depth) => {
    for (const [first, inner] of dir.dirs) {
      let name = first;
      let one = inner;
      while (!one.files.length && one.dirs.size === 1) {
        const [[next, deeper]] = one.dirs;
        name += "/" + next;
        one = deeper;
      }
      const full = path ? path + "/" + name : name;
      const key = section + "\n" + full;
      const open = !!state.find || !state.diffs.shut.has(key);
      const row = putListRow(list, { dir: true, open, depth, title: full });
      put(row, "span", "name", name);
      row.setAttribute("aria-expanded", String(open));
      row.addEventListener("click", () => {
        if (state.diffs.shut.has(key)) state.diffs.shut.delete(key);
        else state.diffs.shut.add(key);
        drawDiffList(list);           // from the last draw's `diffShown`
      });
      if (open) walk(one, full, depth + 1);
    }
    for (const hit of dir.files) {
      const path = pathOf(hit);
      const cut = path.lastIndexOf("/") + 1;
      const row = putListRow(list, { depth, title: path });
      row.dataset.key = section + "\n" + path;
      // The letters that matched were found in the whole path, so only the
      // ones inside the name are picked out here.
      putName(row, path.slice(cut),
              hit.at.filter((where) => where >= cut).map((where) => where - cut));
      fill(row, hit);
    }
  };
  walk(root, "", 0);
}

// What the tab shows: each section's files that the find box lets through,
// in the tree's order, the untracked names the same way, and the commit when
// one is picked. Worked out once a draw -- the list and the pane both read
// it, and two copies of the arithmetic would be two orders that can drift.
function diffShown(report) {
  const sections = [];
  for (const section of report.sections) {
    const files = treeOrder(hits(section.files || [], (file) => file.path),
                            (hit) => hit.one.path);
    if (files.length) sections.push({ section, files });
  }
  const loose = treeOrder(hits(report.untracked || [], (name) => name),
                          (hit) => hit.one);
  return { sections, loose, commit: commitShown(report) };
}

// The list on the left, on its own: folding a folder redraws the tree from
// what the last draw worked out, and leaves the diff beside it where it was.
function drawDiffList(list, shown = list.shown) {
  list.shown = shown;
  const top = list.scrollTop;
  list.replaceChildren();
  for (const { section, files } of shown.sections) {
    // A commit's subject is a sentence somebody wrote, and the list's heads
    // are labels in capitals; the pane beside it carries the sentence.
    put(list, "div", "head",
        shown.commit ? "commit " + shown.commit.short : section.title)
      .title = section.about || "";
    putDiffTree(list, section.name, files, (hit) => hit.one.path, (row, hit) => {
      const one = hit.one;
      // The colour of the icon says what happened, and the title is the
      // path, as on every other list here.
      row.classList.add(one.status);
      if (one.status === "renamed") {
        row.title = one.old_path + " \u2192 " + one.path;
      } else if (one.status === "typechange") {
        row.title = one.path + " \u2014 was a " + one.old_kind
          + ", now a " + one.new_kind;
      }
      putCounts(put(row, "span", "counts"), one);
      row.addEventListener("click", () => goToDiffFile(row.dataset.key));
    });
  }
  if (shown.loose.length) {
    put(list, "div", "head", "untracked");
    putDiffTree(list, "untracked", shown.loose, (hit) => hit.one, (row, hit) => {
      row.classList.add("untracked");
      row.addEventListener("click", () => chooseUntracked(hit.one));
    });
  }
  putCommentList(list);
  list.scrollTop = top;
  // In the next frame, when the pane beside it is built and laid out once:
  // asking where its blocks stand now would lay out the whole diff twice.
  list.marked = undefined;
  requestAnimationFrame(markDiffFile);
}

function goToDiffFile(key) {
  const scroll = document.querySelector(".diffscroll");
  const node = scroll && scroll.blocks && scroll.blocks.get(key);
  if (!node) return;
  scroll.picked = key;
  node.scrollIntoView({ block: "start" });
  markDiffFile();
}

// The file under the top of the pane, marked in the list. Asked of the DOM:
// the blocks are where they are, whatever state thinks.
function markDiffFile() {
  const scroll = document.querySelector(".diffscroll");
  const list = document.querySelector(".filelist.diff");
  if (!scroll || !list || !scroll.blocks) return;
  let here = null;
  for (const [key, node] of scroll.blocks) {
    if (node.offsetTop > scroll.scrollTop + 8) break;
    here = key;
  }
  // The file clicked in the list wins while it is on screen. The last file
  // of a diff cannot scroll to the top of the pane -- there is nothing under
  // it to scroll -- so the file above it kept the mark, and the click read
  // as a click on the wrong row.
  const picked = scroll.blocks.get(scroll.picked);
  if (picked && picked.offsetTop < scroll.scrollTop + scroll.clientHeight
      && picked.offsetTop + picked.offsetHeight > scroll.scrollTop) {
    here = scroll.picked;
  } else {
    scroll.picked = null;
  }
  // Most scroll frames stay inside one file, and then nothing moves.
  if (list.marked === here) return;
  list.marked = here;
  for (const row of list.querySelectorAll("button[data-key]")) {
    row.classList.toggle("chosen", row.dataset.key === here);
  }
}

function commitShown(report) {
  return commitsOf(report).find((one) => one.sha === report.of) || null;
}

// Everything the Diff tab's body is drawn from, as one string: it is drawn
// again when, and only when, one of them moved. A counter bumped by hand at
// seven places stood for this, and a change that forgot the bump was a
// change that never drew (#301). The answer is its tag, which is a hash of
// all of it.
function diffKey() {
  const d = state.diffs;
  const runs = (map, word) => [...map].map(([key, one]) => key + "=" + word(one));
  const s = current();
  return JSON.stringify([
    state.chosen, s && s.doing, s && s.conflicts, d.tag, d.of, d.gone, d.loose, d.trouble,
    d.found ? d.found.stamp || "read" : "", state.find, state.sides,
    runs(d.open, String), runs(d.more, (ranges) => ranges.join(";")),
    runs(d.whole, (held) => held.asking ? "?" : held.file ? "+" : "-"),
  ]);
}

function drawDiff(box) {
  const [list, pane, note, foot] = split(box, "diff", "diffbody");
  if (!pane.firstChild) putDiffBar(pane);
  const [bar, scroll] = pane.children;
  fillDiffBar(bar);
  if (holdingText(box)) return;
  // `redrawCode` empties the key to say "all of it again" -- a comment was
  // written, and its rows have to be drawn with it. Anything else that gets
  // past `fresh` is a new answer, and a file whose own diff is the same as
  // before keeps the block it has (`blockSig`).
  const again = !box.dataset.bodyKey;
  if (!fresh(box, "bodyKey", diffKey())) return;
  const report = state.diff || { sections: [], untracked: [] };
  // A file the agent has since committed is no longer untracked, so the pick
  // goes with it rather than pointing at a section that no longer names it.
  if (state.diffs.loose && !(report.untracked || []).includes(state.diffs.loose)) {
    state.diffs.loose = null;
  }
  const found = diffShown(report);
  // Both places are read before either column is rebuilt, while nothing on
  // the page needs laying out again to answer.
  const place = scroll.scrollTop;
  // Another commit, or another half, is another diff, and it is read from
  // its top. Only a redraw of the same one keeps the reader's place: stepping
  // to the next commit left the pane where the last one had been read to.
  // And another session's diff is another diff: all changes are "" in every
  // session, so the next one opened where the last was read to.
  const of = state.chosen + "\n" + (report.of || "");
  const same = !fresh(scroll, "of", of);
  drawDiffList(list, found);
  // The agent saves one file and the answer changes, and every file was
  // built again from nothing: as plain text, then painted a file at a time
  // behind the highlighter and a timer. The file being read lost its colour
  // and its word marks and got them back, and the reader saw it jump. So
  // the pane is built into `next`, a file that has not changed takes its
  // old block, and `settle` puts the pane right around the blocks it keeps
  // -- never moving one, which would drop its sideways scroll.
  const had = again ? new Map() : scroll.drawn || new Map();
  // Nothing is kept when all of it is drawn again, and nothing of the old
  // pane may stand in `document` while the new one is built.
  if (again) scroll.replaceChildren();
  const reading = again || !same ? null : readerAt(scroll);
  const next = document.createDocumentFragment();
  const order = [];
  const kept = new Map();
  scroll.drawn = new Map();
  // Every block by the key its row in the list carries, in the order they
  // stand, which is what `markDiffFile` walks.
  scroll.blocks = new Map();

  // git has started something here and not finished it: the branch, what
  // is committed and what is not all read differently until it ends (#357).
  const here = current();
  if (here && (here.doing || here.conflicts)) {
    put(next, "div", "note", "git is " + (here.doing || "stopped on a conflict")
        + " in this worktree" + (here.conflicts
          ? ", with " + counted(here.conflicts, "file", "files") + " in conflict" : "")
        + ". Until it finishes, the branch and its changes read differently.");
  }
  if (state.diffs.gone) {
    put(next, "div", "note", "The commit you picked is no longer on this"
        + " branch. It was probably amended or rebased away, so this shows"
        + " all changes.");
  }
  let shown = 0;
  const one = found.commit;
  for (const { section, files } of found.sections) {
    shown += files.length;
    const head = put(next, "div", "diffhead " + section.name, section.title);
    if (one) put(head, "span", "sha", one.short);
    if (section.about) {
      put(head, "span", "about", section.about
          + (one && one.when ? ", " + ago(one.when) + " ago" : ""));
    }
    // The whole message, not only its subject: the why of a commit is in
    // the body, and a subject alone is the one line that says least.
    if (one && report.body) putMessage(head, report.body);
    // The reader's ticket links, in the subject and the message alike.
    linkTickets(head);
    // `at_commit`: the new side is a commit and not the file on disk, so a
    // comment's line is carried through to where it stands now. The daemon
    // says so, because it is the one that knows what each half is a diff of.
    for (const { one: file } of files) {
      const key = section.name + "\n" + file.path;
      const sig = blockSig(section, file);
      const old = had.get(key);
      let node;
      if (old && old.sig === sig) {
        node = old.node;
        // A stand-in where it goes, so the order is the one built.
        kept.set(next.appendChild(document.createComment("")), node);
      } else {
        node = drawDiffFile(next, file, section.at_commit, section.name);
      }
      scroll.blocks.set(key, node);
      scroll.drawn.set(key, { node, sig });
    }
  }
  const loose = found.loose;
  let picked = null;
  if (state.diffs.loose) {
    picked = drawLooseFile(next, state.diffs.loose);
    scroll.blocks.set("untracked\n" + state.diffs.loose, picked);
  } else if (loose.length) {
    put(next, "div", "note", loose.length + " untracked file" +
        (loose.length > 1 ? "s are" : " is") + " named on the left. git has no" +
        " diff for a file it does not track, so pick one to read it.");
  }
  // Two sections or one, and which is which, is the whole of what this tab
  // was unclear about. When there is no base the committed half is missing
  // altogether, and nothing used to say so -- the tab simply showed less.
  if (state.diff && !report.base && !report.failed && !report.of) {
    put(next, "div", "note", "No default branch to compare against, so this"
        + " tab shows only what is not committed. git had no origin/HEAD and"
        + " no main or master.");
  }
  // An orphan branch, or a shallow clone: git says HEAD and the base share
  // no commit, so there is no committed half. It used to read as git not
  // answering, on every poll, for ever.
  if (state.diff && report.unrelated && !report.of) {
    put(next, "div", "note", "This branch has no commit in common with "
        + report.base + ", so this tab shows only what is not committed. It"
        + " may be an orphan branch, or a shallow clone that does not reach"
        + " back to where the branch began.");
  }
  if (report.failed) {
    put(next, "div", "note", "git did not answer here, so this may not be the"
        + " whole diff. It is tried again in a few seconds.");
  } else if (!shown && !loose.length) {
    const empty = put(next, "div", "empty");
    put(empty, "p", null, state.find ? "No changed file matches."
      : report.of === "uncommitted" ? "Nothing is waiting to be committed."
      : report.of ? "This commit changes no file."
      : report.unrelated ? "Nothing is waiting to be committed."
      : report.base ? "Nothing has changed against " + report.base + "."
      : "Nothing has changed, and there is no branch to compare against.");
  }
  if (report.cut) {
    put(next, "div", "note", "This diff is long, so the rest is left out.");
  }
  settle(scroll, [...next.childNodes].map((node) => kept.get(node) || node));
  drawDiffList(list);
  // Picking a file moves the pane to it; anything else leaves the reader
  // where they were. Restoring the old place whatever happened is what made a
  // click on an untracked name look like it had done nothing: the block was
  // built below the fold and the pane scrolled straight back up.
  //
  // `chooseUntracked` is the only thing that picks, so it is the only thing
  // that says to go, and it stays said until the file has arrived — the block
  // is drawn twice, and the second draw is what the reader ends up looking
  // at. Working that out again here from two other fields was a string of
  // state algebra explaining itself.
  if (state.diffs.goTo && picked) {
    if (state.diffs.found) state.diffs.goTo = false;
    requestAnimationFrame(() => picked.scrollIntoView({ block: "start" }));
  } else if (!same) {
    // Said, not left to the emptying: a pane refilled in the same task keeps
    // its offset, and the next commit opened 2,000 px down.
    scroll.scrollTop = 0;
  } else if (reading && reading.node.isConnected) {
    // The block the reader was in stayed: it stays where it stood on the
    // screen, though a file above it grew or went.
    scroll.scrollTop += reading.node.getBoundingClientRect().top - reading.top;
  } else if (place) {
    requestAnimationFrame(() => { scroll.scrollTop = place; });
  }
  putElsewhere(scroll, report);
  note.replaceChildren();
  countNote(note, shown + loose.length);
  drawDiffCount();
}

// What a file's block is drawn from, besides what every block shares: when
// this is the same as before, the block that stands is the block it would
// draw. Comments are not in it: writing one goes through `redrawCode`, which
// draws all of it again. **A block of a commit puts its comments where the
// line is on disk**, which is read off the diff after it (`laterFile`,
// `inWorktree`): the agent added lines above a committed one and the kept
// block anchored a comment to the line that stood there before.
function blockSig(section, file) {
  const key = moreKey(section.name, file.path);
  const whole = state.diffs.whole.get(key);
  return JSON.stringify([
    state.chosen, state.diffs.of, state.sides, section.at_commit, file,
    state.diffs.open.get(key), BIG_LINES, state.diffs.more.get(key) || null,
    section.at_commit ? laterFile(file.path) : null,
    whole ? (whole.asking ? "?" : whole.file ? "+" : "-") : "",
  ]);
}

// The block at the top of the pane, and where it stands on the screen.
function readerAt(scroll) {
  const top = scroll.getBoundingClientRect().top;
  for (const { node } of (scroll.drawn || new Map()).values()) {
    const box = node.getBoundingClientRect();
    if (box.bottom > top) return { node, top: box.top };
  }
  return null;
}

// Make the pane hold `nodes`, in that order, by taking out what is not
// among them and putting in what is new. A node already in its place is
// never touched: taking it out and putting it back drops its sideways scroll
// and lays it out again.
function settle(pane, nodes) {
  const wanted = new Set(nodes);
  for (const child of [...pane.childNodes]) {
    if (!wanted.has(child)) child.remove();
  }
  let at = pane.firstChild;
  for (const node of nodes) {
    if (node === at) at = at.nextSibling;
    else pane.insertBefore(node, at);
  }
}

// git has no diff for an untracked file, so it was named and left
// unclickable — the one thing on the tab you could not open. Every line in it
// is new, which is what the file is, so it is shown as one added block.
function drawLooseFile(pane, path) {
  const node = put(pane, "div", "dfile");
  const head = put(node, "div", "name");
  put(head, "span", "what", "untracked");
  put(head, "span", "path", path);
  const body = put(node, "div", "dbody");
  if (!state.diffs.found) {
    put(body, "div", "note", state.diffs.trouble || "reading…");
    return node;
  }
  if (state.diffs.found.binary) {
    // The same answer the Files tab gives, from the same place: a screenshot
    // an agent has just taken is an untracked file, and it read as "nothing
    // to show" on one tab and showed as a picture on the other.
    putMedia(body, path, state.diffs.found);
    return node;
  }
  const text = state.diffs.found.text || "";
  const lines = text === "" ? [] : text.replace(/\n$/, "").split("\n");
  putCounts(head, { added: lines.length, removed: 0 });
  if (!lines.length) {
    put(body, "div", "note", "This file is empty.");
    return node;
  }
  // One hunk, every line added, which is what the file is. It goes through
  // the one place that knows the shape of a diff row, so it is numbered and
  // lined up with every other block rather than being a third way to draw a
  // line that quietly drifts from the other two.
  // The path goes in it too: a review comment is anchored by the file it is
  // about, and without one every untracked file shared the anchor `undefined`
  // — a comment on line 3 of this one turned up on line 3 of the next.
  fillDiffFile(body, { path: path, hunks: [{
    header: "@@ -0,0 +1," + lines.length + " @@",
    lines: lines.map((text) => ({ kind: "added", text })),
  }] });
  putReview(put(node, "div", "onFile"), anchorOf(path, 0), "");
  return node;
}

async function chooseUntracked(path) {
  if (state.diffs.loose === path || busyWriting()) return;
  state.diffs.loose = path;
  state.diffs.found = null;
  state.diffs.trouble = "";
  state.diffs.goTo = true;            // until the block is on screen with the file
  draw();
  await readLoose(path);
}

// Read the untracked file picked. Only an answer with text in it is the
// file: a fetch that failed was drawn as "This file is empty.", and a
// `missing` answer -- which a timed-out `is_listed` gives too -- as the
// file's one added line, with a `+` on it. Both were kept, and a click on
// the name did nothing, so the failure stayed on screen as the content.
// Now the text stays unread, the block says so, and the next poll asks
// again; a file that really went leaves `untracked` and is let go.
// The `file` route's answer, read one way: `{file}` for the file, or for a
// `same` when `have` -- the `stamp` of the version shown -- still stands, and
// `{why}` for anything else. A `missing` answer, which a timed-out
// `is_listed` gives too, is not the file's text: three readers each decided
// that for themselves, and each took it for the text once (#292).
async function askFile(id, path, have) {
  const body = await ask(id, "file", "?path=" + encodeURIComponent(path)
                         + (have ? "&have=" + encodeURIComponent(have) : ""));
  if (!body) return { why: "the daemon did not answer" };
  if (body.missing || body.error) return { why: body.missing || body.error };
  if (!body.same && body.text === undefined && !body.binary) {
    return { why: "the daemon did not send the file" };
  }
  return { file: body };
}

async function readLoose(path) {
  const want = state.chosen;
  state.diffs.asking = path;
  const got = await askFile(want, path);
  if (state.chosen !== want || state.diffs.loose !== path) return;
  state.diffs.asking = null;
  const body = got.file;
  if (!body) {
    state.diffs.trouble = "This file could not be read. It is asked for again.";
  } else {
    state.diffs.trouble = "";
    state.diffs.found = body;   // its text, or what `putMedia` needs for a picture
  }
  draw();
}

// What happened to a file, in the header's words. A type change is one
// entry for both halves (`join_type_change`), and says what the path was
// and what it is: "file \u2192 link". The CSS writes it in capitals.
function statusWord(one) {
  return one.status === "typechange"
    ? one.old_kind + " \u2192 " + one.new_kind : one.status;
}

function drawDiffFile(pane, one, atHead = false, section = "") {
  const node = put(pane, "div", "dfile");
  const head = put(node, "button", "name");
  put(head, "span", "what " + one.status, statusWord(one));
  put(head, "span", "path", one.status === "renamed"
    ? one.old_path + " \u2192 " + one.path : one.path);
  putCounts(head, one);
  const body = put(node, "div", "dbody");
  putReview(put(node, "div", "onFile"),
            anchorOf(atHead ? pathNow(one.path) : one.path, 0), "");
  if (one.binary) {
    put(body, "div", "note", "Binary file. There is nothing to show.");
    return node;
  }
  // A file with no lines has no hunk either way: new and empty, gone and
  // empty, or only its mode changed. Only the last is "did not change".
  if (!one.hunks.length) {
    put(body, "div", "note", one.status === "added" ? "A new, empty file."
        : one.status === "deleted" ? "The file was empty."
        : "The content did not change.");
    return node;
  }
  const size = one.hunks.reduce((sum, hunk) => sum + hunk.lines.length, 0);
  const why = put(head, "span", "why");
  // `drawDiff` rebuilds a file whose diff changed, and all of them after a
  // comment, so what the reader opened has to live outside the node, the way
  // the transcript's expanded tool rows do. `BIG_LINES` only decides a file nobody has touched.
  // By what is shown, the half and the path, as `moreKey` is: by the path
  // alone, opening a long file in one half opened it in the other on the
  // next save, and the choice followed the reader to every commit picked.
  const openKey = moreKey(section, one.path);
  const chose = state.diffs.open.get(openKey);
  let open = chose === undefined ? size <= BIG_LINES : chose;
  const mark = () => { why.textContent = size + " lines" + (open ? "" : ", hidden"); };
  // With whatever the reader asked to see between the changes.
  const fill = () => fillDiffFile(body, withMore(one, section), atHead);
  if (open) fill();
  mark();
  head.addEventListener("click", () => {
    open = !open;
    state.diffs.open.set(openKey, open);
    if (open) fill(); else body.replaceChildren();
    mark();
  });
  return node;
}

// Where a hunk starts on each side. `@@ -12,7 +14,9 @@` says line 12 of the
// old file and line 14 of the new one. The numbers are worked out here rather
// than sent: they follow from the header, and a diff is already the biggest
// thing on the wire.
const HUNK_AT = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/;

// Every line of a file's diff with the numbers it carries on each side. A
// removed line has none on the new side and an added one has none on the old
// side. Two callers walk this — the drawing, and the check for whether a
// comment's line is still where it was — and a second copy of the arithmetic
// is a second copy that can drift.
function walkHunks(one, onHunk, onLine) {
  for (const hunk of one.hunks || []) {
    const where = onHunk ? onHunk(hunk) : null;
    // A file read as lines carries no `@@` header, and its first line is line
    // one — unless only a slice of it is being drawn, and then the slice says
    // which line it starts at. A diff hunk whose header will not parse is no
    // better off starting at zero than at one.
    const found = HUNK_AT.exec(hunk.header);
    let old = found ? Number(found[1]) : (hunk.from || 1);
    let now = found ? Number(found[2]) : (hunk.from || 1);
    for (const line of hunk.lines) {
      onLine(line, old, now, where);
      if (line.kind !== "added") old += 1;
      if (line.kind !== "removed") now += 1;
    }
  }
}

// `plain` is a line of a file being read rather than a line of a diff: no
// marker in front of it, one number rather than two, and no tint. The Files
// tab draws through here for it, so a file gets the numbers, the `+` and the
// comments the diff already had, and a comment on line 42 lands on the same
// anchor whichever tab it was written in.
const SIGN = { added: "+", removed: "\u2212", context: " " };

// A hunk's header is git's `@@ -33,7 +34,7 @@` and then, often, the line the
// hunk sits inside -- `void usage() {`. The numbers are git's shorthand and
// the rows already carry them, so they stand back; the function is what a
// reader looks for, so it stands forward.
function putHunkHead(body, hunk, file) {
  const head = put(body, "div", "hunk");
  // Lines hidden above this change, and a way to show them. A file drawn
  // other than by `withMore` -- an untracked one, a file being read -- has
  // no `gapFrom`, and nothing is hidden in it.
  const found = /^(@@ [^@]* @@)(.*)$/.exec(hunk.header);
  put(head, "span", "at", found ? found[1] : hunk.header);
  if (found && found[2].trim()) put(head, "span", "ctx", found[2].trim());
  if (hunk.gapFrom !== undefined && hunk.gapTo >= hunk.gapFrom) {
    putMore(head, file, hunk.gapFrom, hunk.gapTo,
            { up: true, down: hunk.gapFrom > 1 });
  }
}

function fillDiffFile(body, one, atHead = false) {
  // A file being read is all `plain` lines, drawn one column and painted by
  // the Files tab itself. It goes straight through: this runs on every
  // window move of a long file, and the pairing below is for a diff.
  const reading = (one.hunks || []).every((hunk) => hunk.lines.every(
    (line) => line.kind === "plain"));
  if (reading) {
    walkHunks(one, () => put(body, "div", "dlines"), (line, old, now, lines) =>
      unifiedRow(lines, one, { line, old, now }, atHead, null));
    return;
  }
  // Walked first and drawn second: a row beside a row needs the whole run of
  // removed and added lines before it can pair them, and so does marking
  // which words changed.
  const hunks = [];
  walkHunks(one, (hunk) => {
    const held = { hunk, rows: [] };
    hunks.push(held);
    return held;
  }, (line, old, now, held) => held.rows.push({ line, old, now }));
  const sides = state.sides === "split" && !one.atEdit;
  // What each side of each hunk says, in order, with the node that shows each
  // line -- or none, for a line the reader sees on the other side only -- and
  // the words to mark in it. It is what the highlighter is handed; see
  // `paintDiff`.
  const painting = [];
  for (const hunk of hunks) {
    if (hunk.hunk.header) putHunkHead(body, hunk.hunk, one);
    const lines = put(body, "div", sides ? "dlines sides" : "dlines");
    const side = { was: [], now: [] };
    painting.push(side);
    const pairs = pairsOf(hunk.rows);
    if (sides) {
      for (const [left, right, words] of pairs) {
        pairRow(lines, one, left, right, atHead, words, side);
      }
      continue;
    }
    // One column keeps git's order -- a run's removed lines, then its added
    // ones -- and takes only the words from the pairs. Drawn pair by pair,
    // the old and new lines alternated, which no diff reader draws.
    const marks = new Map();
    for (const [left, right, words] of pairs) {
      if (left === right) continue;
      if (left) marks.set(left, words[0]);
      if (right) marks.set(right, words[1]);
    }
    for (const row of hunk.rows) {
      unifiedRow(lines, one, row, atHead, marks.get(row) || null, side);
    }
  }
  // The lines after the last change, when there are any or might be.
  if (one.tail === null || one.tail > 0) {
    putMore(put(body, "div", "hunk tail"), one, one.after,
            one.tail === null ? null : one.after + one.tail - 1,
            { up: false, down: true });
  }
  paintDiff(body, one.path, painting);
}

// A hunk's rows as the pairs two columns show: a line that did not change is
// the same row on both sides, and a run of change pairs its removed lines
// with its added ones in order, with the words that changed in each. A run
// with more of one than the other has pairs with nothing on one side.
//
// One column walks the same pairs, so the two layouts cannot disagree about
// which words changed.
function pairsOf(rows) {
  const pairs = [];
  let at = 0;
  while (at < rows.length) {
    if (rows[at].line.kind === "context") {
      pairs.push([rows[at], rows[at], [null, null]]);
      at += 1;
      continue;
    }
    const cut = [];
    const add = [];
    for (; at < rows.length && rows[at].line.kind !== "context"; at += 1) {
      (rows[at].line.kind === "removed" ? cut : add).push(rows[at]);
    }
    for (let pair = 0; pair < Math.max(cut.length, add.length); pair += 1) {
      const left = cut[pair] || null;
      const right = add[pair] || null;
      const words = left && right
        ? wordDiff(left.line.text, right.line.text) : null;
      pairs.push([left, right, words || [null, null]]);
    }
  }
  return pairs;
}

// The line a cell shows, kept for the painter: in the side it belongs to,
// or in both for a line one column shows once.
function paints(side, row, cell, words) {
  if (row.line.kind !== "added") {
    side.was.push({ text: row.line.text, words,
                    cell: row.line.kind === "removed" ? cell : null });
  }
  if (row.line.kind !== "removed") {
    side.now.push({ text: row.line.text, words, cell });
  }
}

// One row of one column: the numbers, the marker, the line, and the `+` a
// comment starts from. The shape every test of the Files tab reads, and the
// diff's own shape until the reader asks for two columns.
function unifiedRow(lines, one, row, atHead, words, side) {
  const { line, old, now } = row;
  const node = put(lines, "div", "dline " + line.kind);
  // The numbers in one span, lined up with spaces. The row is already
  // `white-space: pre` in a monospace face, so they stay in column
  // without a flex box and three elements around every line — a diff of
  // twelve thousand lines is the difference between 24,000 nodes and
  // 84,000. A removed line has no number on the new side and an added one
  // has none on the old side, so that side is left blank.
  put(node, "span", "ln", line.kind === "plain"
      ? String(now).padStart(6) + "  "
      : (line.kind === "added" ? "" : String(old)).padStart(5) +
        (line.kind === "removed" ? "" : String(now)).padStart(6) + "  ");
  // The marker is its own span so that what follows it is exactly the
  // line, which is what the highlighter is given and what it paints.
  if (SIGN[line.kind]) put(node, "span", "sign", SIGN[line.kind]);
  const cell = put(node, "span", "dtext", line.text);
  markWords(cell, words);
  if (side) paints(side, row, cell, words);
  putLineReview(lines, node, one, line, now, atHead);
}

// One row of two columns: the old file on the left and the new one on the
// right, a changed line beside what it became. A side with no line -- more
// was added than removed -- is left empty rather than closed up, so the two
// columns stay level all the way down.
function pairRow(lines, one, left, right, atHead, words, side) {
  const kind = !left ? "added" : !right ? "removed"
    : left === right ? "context" : "changed";
  const row = put(lines, "div", "dline pair " + kind);
  const half = (name, held, sideWords) => {
    const cell = put(row, "span", "half " + name + " "
                     + (held ? held.line.kind : "none"));
    put(cell, "span", "ln", held ? String(name === "was" ? held.old : held.now)
                                 : "");
    const text = put(cell, "span", "dtext", held ? held.line.text : "");
    markWords(text, sideWords);
    return [cell, text];
  };
  const [, was] = half("was", left, words[0]);
  const [cell, now] = half("now", right, words[1]);
  if (left) side.was.push({ text: left.line.text, cell: was, words: words[0] });
  if (right) side.now.push({ text: right.line.text, cell: now, words: words[1] });
  // The `+` goes on the new side: a comment is about the file as it is.
  if (right) putLineReview(lines, cell, one, right.line, right.now, atHead);
}

// A comment under its line, or the `+` that starts one. A line that is no
// longer in the file gets neither.
function putLineReview(lines, where, one, line, now, atHead) {
  if (one.atEdit) return;      // an edit in the transcript: see `putToolDiff`
  const anchor = diffLineAnchor(one.path, line, now, atHead);
  if (anchor === null) return;
  // A slice under "commented elsewhere" reaches a line the diff above
  // draws too: its comment stood twice, and "edit" on the lower copy
  // opened the box on the upper one. One place per anchor.
  if (one.drawn && one.drawn.has(anchor)) return;
  if (commentAt(anchor) || state.writing === anchor) {
    putReview(put(lines, "div", "onLine"), anchor, line.text);
  } else {
    putReview(where, anchor, line.text);
  }
}

// Which words of a changed line changed, on each side, as `[from, to)` runs
// of characters -- or null when the two lines have too little in common for
// that to mean anything. A rewritten line lit from end to end says nothing
// the tint behind it does not already say.
//
// A word is a run of letters and digits, a run of spaces, or one other
// character, and the answer is their longest common run: the textbook table,
// which is fine for a line and would not be for a file. What the two lines
// share at either end is taken off first, so the table is the size of the
// change and not of the line -- most edits are a word or two in the middle.
// Past `WORDS_MAX` characters it is not asked at all.
const WORDS_MAX = 400;
// `u`, or an emoji is two halves of a pair, and a mark on one half draws
// two broken glyphs.
const WORD = /\w+|\s+|[^\w\s]/gu;

function wordDiff(was, now) {
  if (was.length > WORDS_MAX || now.length > WORDS_MAX || was === now) return null;
  const a = was.match(WORD) || [];
  const b = now.match(WORD) || [];
  let head = 0;
  while (head < a.length && head < b.length && a[head] === b[head]) head += 1;
  let tail = 0;
  while (tail < a.length - head && tail < b.length - head
         && a[a.length - 1 - tail] === b[b.length - 1 - tail]) tail += 1;
  const count = (words) => words.reduce(
    (sum, word) => sum + (word.trim() ? word.length : 0), 0);
  let same = count(a.slice(0, head)) + count(a.slice(a.length - tail));
  const x0 = a.slice(0, head).join("").length;
  const y0 = b.slice(0, head).join("").length;
  const midA = a.slice(head, a.length - tail);
  const midB = b.slice(head, b.length - tail);
  const table = [];
  for (let i = 0; i <= midA.length; i += 1) table.push(new Uint16Array(midB.length + 1));
  for (let i = midA.length - 1; i >= 0; i -= 1) {
    for (let j = midB.length - 1; j >= 0; j -= 1) {
      table[i][j] = midA[i] === midB[j] ? table[i + 1][j + 1] + 1
        : Math.max(table[i + 1][j], table[i][j + 1]);
    }
  }
  const cut = [];
  const add = [];
  let i = 0;
  let j = 0;
  let x = x0;                       // where we are in each line, in characters
  let y = y0;
  while (i < midA.length || j < midB.length) {
    if (i < midA.length && j < midB.length && midA[i] === midB[j]) {
      if (midA[i].trim()) same += midA[i].length;
      x += midA[i].length;
      y += midB[j].length;
      i += 1;
      j += 1;
    } else if (j >= midB.length
               || (i < midA.length && table[i + 1][j] >= table[i][j + 1])) {
      cut.push([x, x += midA[i].length]);
      i += 1;
    } else {
      add.push([y, y += midB[j].length]);
      j += 1;
    }
  }
  const longest = Math.max(was.replace(/\s/g, "").length,
                           now.replace(/\s/g, "").length);
  if (!longest || same < longest * 0.4) return null;
  return [closeGaps(was, cut), closeGaps(now, add)];
}

// Two changed words with nothing or only a space between them are one
// change: lit apart they read as two, with an unlit gap that changed nothing.
function closeGaps(text, runs) {
  const out = [];
  for (const run of runs) {
    const last = out[out.length - 1];
    if (last && !text.slice(last[1], run[0]).trim()) last[1] = run[1];
    else out.push(run.slice());
  }
  return out;
}

// Wraps the characters in `runs` in `.wd`, across whatever spans are already
// in the cell. Run once on the plain text, and again after the highlighter
// has replaced it -- the runs travel with the line to `paintDiff`.
function markWords(cell, runs) {
  if (!runs || !runs.length) return;
  let at = 0;                      // characters before this text node
  let next = 0;                    // the first run not yet finished
  overText(cell, (data) => {
    const start = at;
    const end = at += data.length;
    const pieces = [];
    let done = start;
    while (next < runs.length && runs[next][0] < end) {
      const from = Math.max(runs[next][0], done);
      const to = Math.min(runs[next][1], end);
      if (from > done) pieces.push([done, from, false]);
      if (to > from) pieces.push([from, to, true]);
      done = Math.max(done, to);
      if (runs[next][1] <= end) next += 1; else break;
    }
    if (!pieces.some((piece) => piece[2])) return null;
    if (done < end) pieces.push([done, end, false]);
    const made = document.createDocumentFragment();
    for (const [from, to, lit] of pieces) {
      const words = document.createTextNode(data.slice(from - start, to - start));
      if (lit) put(made, "span", "wd").appendChild(words);
      else made.appendChild(words);
    }
    return made;
  });
}

// Colour for a diff, one side of one hunk at a time. The highlighter wants
// text that makes sense in order, and each side of a hunk is exactly that:
// the file as it was, or as it is, over those lines. Painting row by row
// would get every multi-line string and comment wrong. The text is on the
// page before this starts, so a missing highlighter costs colour and nothing
// else.
//
// A file longer than `CODE_WHOLE` lines is left unpainted, as it is on the
// Files tab and for the same measured reason. Each file waits its turn
// behind a timer, so a diff of many files hands the browser back between
// them rather than painting all of them in one block.
async function paintDiff(body, path, painting) {
  const lib = await hljsReady();
  const size = painting.reduce(
    (sum, hunk) => sum + Math.max(hunk.was.length, hunk.now.length), 0);
  if (!lib || size > CODE_WHOLE) return;
  await new Promise((go) => setTimeout(go));
  if (!body.isConnected) return;
  const first = (painting[0] && painting[0].now[0]) || { text: "" };
  const language = languageOf(path, first.text, null);
  if (!language || !lib.getLanguage(language)) return;
  for (const hunk of painting) {
    for (const side of [hunk.was, hunk.now]) {
      if (!side.some((one) => one.cell)) continue;
      const lines = paintedLines(lib, language,
                                 side.map((one) => one.text).join("\n"),
                                 side.length);
      if (!lines) continue;
      side.forEach((one, at) => {
        if (!one.cell || !one.cell.isConnected) return;
        one.cell.replaceChildren(lines[at]);
        markWords(one.cell, one.words);
      });
    }
  }
}

// The lines of a file. An empty file has none, where splitting a string that
// is empty gives one empty line.
function linesOf(text) {
  return text === "" ? [] : text.split("\n");
}

// A file, or a slice of one, in the shape `fillDiffFile` wants. `from` is the
// number of the first line, which is 1 unless only part of the file is drawn.
function asLines(path, lines, from = 1) {
  return { path, hunks: [{ header: "", from,
    lines: lines.map((one) => ({ kind: "plain", text: one })) }] };
}

// --- more of a file, between its changes -------------------------------------
//
// git shows three lines either side of a change and hides the rest. A band
// stands where lines are hidden, says how many, and shows them twenty at a
// time from either end -- or all of them, on a shift-click or on "show all".
// The lines come from the same diff with the whole file as context
// (`whole` on the daemon), so they are the lines of the side the half shows:
// HEAD for the branch's work, the commit for one commit, the disk for what is
// not committed.

const MORE_STEP = 20;

// What the reader asked to see, and what arrived for it, by what is shown,
// the half and the file: one commit's line 40 is not another's.
function moreKey(section, path) {
  return state.diffs.of + "\n" + section + "\n" + path;
}

// A file's hunks as text, to tell whether the whole file that arrived still
// belongs to the diff on screen. The agent saves; a stale whole file would
// put yesterday's lines between today's changes.
function hunkSig(one) {
  return JSON.stringify(one.hunks);
}

function isShown(ranges, line) {
  return !!ranges && ranges.some(([from, to]) => from <= line && line <= to);
}

// The file as it is drawn: git's hunks, or -- once the reader has asked for
// more and the whole file has arrived -- its lines with the asked-for ones
// between them. Each hunk says which lines stand hidden above it
// (`gapFrom`..`gapTo`, new-side numbers) and the file says how many are
// hidden below its last change: `tail`, which is null when nobody knows yet.
function withMore(one, section) {
  const key = moreKey(section, one.path);
  const more = state.diffs.more.get(key);
  let whole = state.diffs.whole.get(key);
  if (whole && !whole.asking && whole.sig !== hunkSig(one)) {
    state.diffs.whole.delete(key);
    whole = undefined;
  }
  if (!whole && more && more.length) fetchWhole(one, section);  // draws again
  const usable = whole && whole.file;
  // Every row with its numbers, and null where rows are hidden.
  const rows = [];
  // What git named at the top of each of its hunks -- the function a hunk
  // sits in -- by the new-side line the hunk starts at.
  const named = new Map();
  for (const hunk of one.hunks) {
    const found = HUNK_AT.exec(hunk.header);
    if (found) named.set(Number(found[2]), hunk.header.slice(found[0].length));
  }
  if (usable) {
    const shown = new Set();
    walkHunks(one, null, (line, old, now) => {
      if (line.kind !== "removed") shown.add(now);
    });
    walkHunks(usable, null, (line, old, now) => {
      rows.push(line.kind !== "context" || shown.has(now) || isShown(more, now)
        ? { line, old, now } : null);
    });
  } else {
    walkHunks(one, () => rows.push(null),
              (line, old, now) => rows.push({ line, old, now }));
  }
  const groups = [];
  let group = null;
  let after = 1;             // the new-side line a hidden run would start at
  for (const row of rows) {
    if (!row) { group = null; continue; }
    if (!group) groups.push(group = { rows: [], gapFrom: after, gapTo: row.now - 1 });
    group.rows.push(row);
    after = row.now + (row.line.kind === "removed" ? 0 : 1);
  }
  const hunks = groups.map(({ rows: held, gapFrom, gapTo }) => {
    const first = held[0];
    const olds = held.filter((row) => row.line.kind !== "added").length;
    const news = held.filter((row) => row.line.kind !== "removed").length;
    const name = held.map((row) => named.get(row.now))
      .find((text) => text !== undefined) || "";
    return { header: "@@ -" + first.old + "," + olds + " +" + first.now + ","
               + news + " @@" + name,
             lines: held.map((row) => row.line), gapFrom, gapTo };
  });
  let tail = null;
  if (usable) {
    let last = 0;
    walkHunks(usable, null, (line, old, now) => {
      if (line.kind !== "removed") last = now;
    });
    tail = Math.max(0, last - after + 1);
  } else if (one.status !== "modified" && one.status !== "renamed") {
    tail = 0;                // an added or deleted file is all there
  } else {
    // git shows three lines after a change when the file has them, so fewer
    // means the file ended. Exactly three may be the end or may not be.
    const lines = (one.hunks[one.hunks.length - 1] || { lines: [] }).lines;
    let trailing = 0;
    for (let at = lines.length - 1; at >= 0 && lines[at].kind === "context"; at -= 1) {
      trailing += 1;
    }
    tail = trailing < DIFF_CONTEXT ? 0 : null;
  }
  return Object.assign({}, one, { hunks, tail, after, section });
}

// Three lines, which is what the daemon asks git for (`DIFF_CONTEXT`).
const DIFF_CONTEXT = 3;

// The whole file for one half, once, and a draw when it lands. A failure is
// kept too, so a git that does not answer is not asked again on every draw;
// the diff moving on clears it with everything else.
async function fetchWhole(one, section) {
  const key = moreKey(section, one.path);
  const held = { sig: hunkSig(one), file: null, asking: true };
  state.diffs.whole.set(key, held);
  const want = state.chosen;
  const body = await ask(want, "whole", "?" + new URLSearchParams({
    section, path: one.path, old: one.old_path || "", of: state.diffs.of,
    // The base this diff was drawn against, not the pick: with nothing
    // picked the daemon would find one again, and a different answer would
    // be a whole file against another base, drawn between these hunks.
    base: (state.diff && state.diff.base) || "" }));
  if (state.chosen !== want || state.diffs.whole.get(key) !== held) return;
  held.asking = false;
  held.file = body && !body.cut && !body.failed ? body.file : null;
  if (!held.file) {
    note(body && body.cut ? "This file is too long to show whole."
         : "git did not answer, so those lines stay hidden.");
  }
  draw();
}

// Show the lines `from`..`to` (new-side numbers; `to` may be Infinity) of a
// file drawn by `withMore`. A choice, so it is kept by `savePlace`.
function revealLines(file, from, to) {
  if (busyWriting()) return;
  const key = moreKey(file.section, file.path);
  // A whole file that failed, or came back cut, is kept so a draw does not
  // ask git again -- but a click is the reader asking. Kept through it,
  // every later click added a range, drew, and showed and said nothing.
  const whole = state.diffs.whole.get(key);
  if (whole && !whole.asking && !whole.file) state.diffs.whole.delete(key);
  const ranges = state.diffs.more.get(key) || [];
  ranges.push([from, to]);
  state.diffs.more.set(key, ranges);
  draw();
}

// The buttons on a band. `up` shows the lines just above the change below,
// `down` the lines just under the change above; a run of twenty or fewer is
// one button. `to` is null when the run's end is not known -- the lines
// after the last change, before the whole file has arrived.
function putMore(band, file, from, to, { up, down }) {
  const count = to === null ? null : to - from + 1;
  // The buttons lead the band, where the eye starts; the count ends it.
  const tools = put(band, "span", "more");
  band.prepend(tools);
  const all = (event) => event.shiftKey ? [from, to === null ? Infinity : to] : null;
  const button = (word, title, range) => {
    const one = put(tools, "button", "grow", word);
    one.title = title + (count !== null && count > MORE_STEP
      ? " (shift-click for all " + count + ")" : "");
    one.addEventListener("click", (event) =>
      revealLines(file, ...(all(event) || range)));
  };
  if (count !== null && count <= MORE_STEP) {
    button("↕", "show the " + counted(count, "hidden line", "hidden lines"),
           [from, to]);
  } else {
    if (down) {
      button("↓", "show " + MORE_STEP + " more lines after the change above",
             [from, from + MORE_STEP - 1]);
    }
    if (up) {
      button("↑", "show " + MORE_STEP + " more lines before the change below",
             [to - MORE_STEP + 1, to]);
    }
  }
  put(band, "span", "hidden", count === null ? "more of the file below"
      : counted(count, "line hidden", "lines hidden"));
  if (count !== null && count > MORE_STEP) {
    const every = put(band, "button", "link", "show all");
    every.addEventListener("click", () => revealLines(file, from, to));
  }
}

// --- the review ---------------------------------------------------------------
//
// A comment is one note on one place: a line of the diff, or a file. The place
// is written down rather than pointed at, because the diff is rebuilt whenever
// the agent saves anything and a node does not survive that.

// What a comment is anchored to, as one string, so that finding it again is a
// lookup rather than a search with four fields in it. A removed line has a
// number only on the old side, an added line only on the new side.
function anchorOf(path, line) {
  return path + "\n" + line;
}

// The place a line of a drawn file or diff is: its number in the file as it is
// now. Line numbers start at one, so nought is the file itself.
//
// A removed line has no number in the file as it is now, and so has no place
// to be. It used to anchor to the old side, which meant the comment could not
// be drawn on the Files tab at all — every line there is a line of the file as
// it is — and once the diff moved past it, nowhere else either. It was still
// sent. A removed line is not offered a `+` now.
function lineAnchor(path, line, now) {
  if (line.kind === "removed" || !now) return null;
  return anchorOf(path, now);
}

// Where a line of HEAD stands in the worktree. The committed section is
// `base...HEAD`, so its new side is HEAD — not the file on disk — and a
// comment belongs to a line of the file as it is. Commenting on a committed
// line after fifty lines were prepended anchored fifty lines too high, and
// that is wrong at the moment of writing, not because the file moved later.
//
// The uncommitted section is exactly the map from HEAD to the worktree, so it
// is read rather than a second thing to keep in step. Nought means the line
// is not in the worktree at all, and then there is nowhere to put a comment.
//
// One commit on its own is the same question one step further back: its new
// side is that commit, and the daemon sends `since`, the diff from it to the
// disk for the files it touched. A file not in that is unchanged since.
//
// It answers the path too. A file the agent moved and did not commit is
// listed there under its new name, with the old one as `old_path` -- which
// is the name on HEAD's side, and so the one to match. Matched on `path`,
// a comment kept a name that is not on disk, and the same line had a
// second anchor in the other half.
function inWorktree(path, headLine) {
  const one = laterFile(path);
  if (!one) return [path, headLine];  // nothing uncommitted: the same file
  let drift = 0;                      // how far the worktree has slid by here
  let found = null;
  walkHunks(one, null, (line, old, now) => {
    if (found !== null || line.kind === "added") return;   // no old-side number
    if (old > headLine) { found = headLine + drift; return; }
    if (old === headLine) { found = line.kind === "removed" ? 0 : now; return; }
    drift = now - old - (line.kind === "removed" ? 1 : 0);
  });
  // Past the last hunk, the whole file has slid by the same amount.
  return [one.path, found === null ? headLine + drift : found];
}

// A file of HEAD, or of the commit shown, in the diff from it to the disk.
function laterFile(path) {
  const report = state.diff || {};
  const later = report.of && report.of !== "uncommitted"
    ? { files: report.since || [] }
    : (report.sections || []).find((section) => section.name === "uncommitted");
  return ((later || {}).files || []).find((file) => file.old_path === path) || null;
}

// The name a file of HEAD has on disk, for a comment on the whole file.
function pathNow(path) {
  const one = laterFile(path);
  return one ? one.path : path;
}

// The anchor of a line of a drawn diff. `atHead` is a half whose new side
// is a commit and not the disk, carried through by `inWorktree`.
function diffLineAnchor(path, line, now, atHead) {
  const [where, at] = atHead ? inWorktree(path, now) : [path, now];
  return lineAnchor(where, line, at);
}

// How a place reads: `path:112`, or just the path when it is the whole file.
function placeOf(anchor) {
  const [path, line] = anchor.split("\n");
  return line === "0" ? path : path + ":" + line;
}

function commentAt(anchor) {
  return state.review.comments.find((one) => one.anchor === anchor) || null;
}

// --- keeping a review ---------------------------------------------------------
//
// In this browser, and nowhere else. A review is yours until you submit it,
// and the daemon serves the same page to every browser, so a draft it held
// would be a draft everyone could read. A review written over ten minutes has
// to survive a reload; nothing else here does, and nothing else here needs to.

const REVIEW_KEY = "wostuast-review-";

function keepReview() {
  drawReviewCount();          // every change to a review comes through here
  if (!state.chosen) return;
  store(REVIEW_KEY + state.chosen, anyReview() ? JSON.stringify(state.review) : "");
}

// Another window of this browser kept, or sent, this session's review. Each
// window holds the draft in memory, and nothing told one about the other: a
// review sent from one came back on the other's next keystroke, which wrote
// its stale copy -- sent comments and all -- over the storage the first had
// just cleared, ready to be sent a second time. So a change there is taken
// up here. The tab is drawn again only when nothing is being typed into it,
// because a rebuild under the hand takes what is typed.
window.addEventListener("storage", (event) => {
  if (!state.chosen || event.key !== REVIEW_KEY + state.chosen) return;
  recallReview(state.chosen);
  drawReviewCount();
  // Nor while a box is open with the focus elsewhere: it was built again
  // from the stored note, and what was typed in it was lost. Closing it
  // draws the tab, and takes this up then.
  const typing = document.activeElement
    && document.activeElement.matches("textarea, input");
  if (state.tab === "diff" && !typing && !writingIn($("content"))) redrawCode();
});

function recallReview(id) {
  state.review = blankReview();
  let held = null;
  try { held = JSON.parse(stored(REVIEW_KEY + id) || "null"); }
  catch (error) { return; }
  if (!held || !Array.isArray(held.comments)) return;
  // What comes back was written by this page, but a browser's storage is not
  // a place to trust blindly: anything of the wrong shape is left out rather
  // than drawn.
  state.review.comments = held.comments.filter(
    (one) => one && typeof one.note === "string"
             && typeof one.anchor === "string"
             // `path \n line`, and nothing else. An anchor of another shape is
             // a draft from an older page, and drawing it would put a comment
             // on a line nobody chose.
             && /^[^\n]+\n\d+$/.test(one.anchor));
  if (typeof held.overall === "string") state.review.overall = held.overall;
}

// A review for a session the daemon no longer lists is a review nobody can
// send. Done once, when the first list arrives, because storage is per browser
// and the sessions outlive any one page.
function pruneReviews(sessions) {
  if (state.pruned || !sessions.length) return;
  state.pruned = true;
  const live = new Set(sessions.map((one) => one.id));
  try {
    for (const key of Object.keys(localStorage)) {
      if (key.startsWith(REVIEW_KEY) && !live.has(key.slice(REVIEW_KEY.length))) {
        localStorage.removeItem(key);
      }
    }
  } catch (error) { }
}

// An empty review. One place, so that starting one, throwing one away and
// choosing another session cannot drift apart about what "nothing" means.
function blankReview() {
  return {
    overall: "",        // what to do at each location, and with the result
    comments: [],       // one per place, in the order they were made
  };
}

// Is there anything here at all? A review with only "what to do" and no
// comments is still one someone started, and throwing it away silently would
// lose it.
function anyReview() {
  return !!(state.review.comments.length || state.review.overall.trim());
}

// The note the reader typed. An empty one deletes the comment, which is what
// clearing the box and saving means; there is no separate delete to remember.
function writeComment(anchor, quoted, note) {
  const text = note.trim();
  const had = commentAt(anchor);
  if (!text) {
    const at = state.review.comments.indexOf(had);
    if (had) state.review.comments.splice(at, 1);
  } else if (had) {
    had.note = text;
  } else {
    state.review.comments.push({ anchor, quoted, note: text });
  }
  state.writing = null;
  keepReview();
  redrawCode();
}

// The Files and Diff tabs are both rebuilt from an answer the poll replaces
// every couple of seconds, and `fresh` holds the rebuild to when that answer
// changes — so a comment added or removed has to say so itself. They share the
// one content box, so this redraws whichever is open.
function redrawCode() {
  const box = $("content");
  box.dataset.bodyKey = "";
  draw();
}

// One comment, under the line or the file it is about.
//
// `full` is a comment shown away from its line -- under "commented
// elsewhere", where the line is no longer in the file -- so it carries the
// quoted one itself. Every comment can be thrown away where it stands.
function putComment(parent, one, full) {
  const node = put(parent, "div", "comment");
  // Which comment this is, so "in diff" can find the node it drew.
  node.dataset.anchor = one.anchor;
  putIcon(node, "person");
  const words = put(node, "div", "words");
  if (full && one.quoted) put(words, "div", "quoted", one.quoted);
  put(words, "div", "says", one.note);
  const acts = put(node, "div", "acts");
  // Both rebuild the tab, so both wait while a box is open, as a pick
  // does (`busyWriting`): the box took what was typed in it with it.
  const edit = put(acts, "button", "verb quiet", "edit");
  edit.addEventListener("click", () => {
    if (busyWriting()) return;
    state.writing = one.anchor;
    redrawCode();
  });
  const drop = put(acts, "button", "verb quiet", "delete");
  drop.addEventListener("click", () => {
    if (!busyWriting()) writeComment(one.anchor, one.quoted, "");
  });
  return node;
}

// The box. Save keeps what is in it, Cancel leaves the comment as it was, and
// an empty save removes it.
function putCommentBox(parent, anchor, quoted) {
  const form = put(parent, "div", "commentbox");
  const area = put(form, "textarea");
  area.value = (commentAt(anchor) || {}).note || "";
  area.placeholder = "what should the agent change here?";
  area.rows = 3;
  const row = put(form, "div", "buttons");
  const stop = put(row, "button", "verb quiet", "cancel");
  stop.addEventListener("click", () => { state.writing = null; redrawCode(); });
  const save = put(row, "button", "verb", "save");
  save.addEventListener("click", () => writeComment(anchor, quoted, area.value));
  submitOnCtrlEnter(area, save);
  area.addEventListener("keydown", (press) => {
    if (press.key === "Escape") { state.writing = null; redrawCode(); }
  });
  requestAnimationFrame(() => { area.focus(); area.select(); });
  return form;
}

// The button that opens the box, and the comment or box that is already there.
// One function, because a line and a file header want exactly the same three
// things and differ only in where they hang them.
function putReview(parent, anchor, quoted, full) {
  const seen = commentAt(anchor);
  // One box per anchor, wherever the line first turns up. A file that is in
  // both sections has the same line twice, and the second box took the focus
  // from the first: keystrokes went to a box off screen, and saving the one
  // the reader could see passed an empty note — which means delete. The
  // comment was lost without a word.
  // And wherever it is being built: `drawDiff` builds the pane apart from
  // the page and puts it in after, so the first box is not in `document` yet.
  const building = parent.getRootNode();
  if (state.writing === anchor && !document.querySelector(".commentbox")
      && !(building !== document && building.querySelector(".commentbox"))) {
    return putCommentBox(parent, anchor, quoted);
  }
  if (seen) return putComment(parent, seen, full);
  const add = put(parent, "button", "addnote", "+");
  add.title = "comment here";
  add.addEventListener("click", () => {
    if (busyWriting()) return;      // a box elsewhere: see `putComment`
    state.writing = anchor;
    redrawCode();
  });
  return add;
}

// The comments in the order they will be read: by file, and inside a file the
// note about the whole thing first, then the lines from the top down. The
// order they were written in is the order the reader wandered through the
// diff, which is nobody else's order.
function reviewInOrder() {
  return state.review.comments.slice().sort((one, two) => {
    const [pathA, lineA] = one.anchor.split("\n");
    const [pathB, lineB] = two.anchor.split("\n");
    if (pathA !== pathB) return pathA < pathB ? -1 : 1;
    return Number(lineA) - Number(lineB);   // nought is the file, so it leads
  });
}

// The message the agent gets. It is a task, not a list of remarks: the
// reader's word on the whole review, what to hand back, and then one section
// per place with the line quoted under it. It has no heading: a box for
// naming the task was one the reader never filled, and "# Review" over the
// rest was a line the reader asked to be rid of.
//
// The line number is a hint and says so. The file moves while the review is
// being written, so the quoted line is the thing that is really being pointed
// at, and the agent is told to search for it when the number no longer fits.
// That replaces the marks this used to carry — "gone", "moved" — which said
// what the diff thought and were sent as if the reader had written them.
const REVIEW_HOW = [
  "When you are done, write one short entry per location: what you did, or"
  + " what you found.",
  "Locations are given as `path:line`, followed by the quoted source line. If"
  + " the line number does not match anymore, search for the quoted line. If a"
  + " comment is not clear, ask me before you change anything.",
];

function reviewText(withOverall = true) {
  const parts = [];
  if (withOverall && state.review.overall.trim()) parts.push(state.review.overall.trim());
  parts.push(...REVIEW_HOW);
  for (const one of reviewInOrder()) {
    parts.push("## " + placeOf(one.anchor));
    if (one.quoted) parts.push("> " + one.quoted);
    parts.push(one.note);
  }
  return parts.join("\n\n") + "\n";
}

// --- the review on the Review tab ------------------------------------------
//
// The Diff tab is where a review is written, read back and sent, and its
// label says Review. There was a tab of its own for the last two, and the
// reader used it only to press send: the comments already stand in the diff
// where they were written. What that tab held is here: the comments listed
// in the tree, the ones no diff shows at the foot of the pane, and the send
// bar under it.

// The comments, in the tree under the files, as the transcript's map lists
// its rounds: who wrote it, the note's first line, and where. A click goes
// to it in the pane.
function putCommentList(list) {
  if (!state.review.comments.length) return;
  const head = put(list, "div", "head said");
  put(head, "span", null, "comments");
  putDropReview(head);
  const found = hits(reviewInOrder(), (one) => one.anchor.split("\n")[0]);
  // Found by the path, which is the `where` under the note: the letters of
  // the note are not what matched, so none are picked out.
  for (const { one } of found) {
    const row = putListRow(list, { depth: 0, title: one.note, icon: "person" });
    row.classList.add("said");
    putName(row, glimpse(one.note), []);
    put(row, "span", "where", placeOf(one.anchor));
    row.addEventListener("click", () => goToComment(one.anchor));
  }
}

// Starting over. Two presses, because there is no undo and a review is half
// an hour of someone's reading. The first press only relabels the button, in
// place: redrawing to change one word would take the reader's place with it.
function putDropReview(parent) {
  let armed = false;
  const drop = put(parent, "button", "link", "delete review");
  drop.addEventListener("click", () => {
    if (!armed) {
      armed = true;
      drop.textContent = "really delete it?";
      return;
    }
    state.review = blankReview();
    state.writing = null;
    keepReview();
    redrawCode();
  });
}

// A comment in the pane. One on a file shut for its size, or by hand, is in
// the diff and not drawn, so the file is opened first; one being edited is
// its box. A file the find box has taken out is not in the pane at all, and
// its comment is not in the list either.
function goToComment(anchor) {
  const scroll = document.querySelector(".diffscroll");
  if (!scroll) return;
  const find = () => state.writing === anchor
    ? scroll.querySelector(".commentbox")
    : scroll.querySelector('.comment[data-anchor="' + CSS.escape(anchor) + '"]');
  let at = find();
  if (!at) {
    const path = anchor.split("\n")[0];
    // By the name on disk: a file moved and not committed has its old name
    // in the committed half, and the comment is drawn there (`pathNow`).
    const keys = [...(scroll.blocks || new Map()).keys()].filter((key) => {
      const name = key.slice(key.indexOf("\n") + 1);
      return !key.startsWith("untracked\n")
        && (name === path || pathNow(name) === path);
    });
    if (!keys.length) return;
    for (const key of keys) state.diffs.open.set(state.diffs.of + "\n" + key, true);
    draw();
    at = find() || scroll.blocks.get(keys[0]);
    // `drawDiff` puts the reader's place back a frame from now. Scrolled
    // now, the pane went back there, and only a second click went to the
    // comment. Frames run in the order they were asked for, so this one
    // comes after.
    if (at) requestAnimationFrame(() => at.scrollIntoView({ block: "center" }));
    return;
  }
  if (at) at.scrollIntoView({ block: "center" });
}

// The places the diff draws a comment on, worked out from the diff and never
// asked of the pane. The pane leaves out more than the diff does: a comment
// being written is a box with no anchor on it, a file shut for its size has
// no lines drawn, and the find box takes files out. Asked of the pane, each
// of those moved a comment to "commented elsewhere" -- and one being edited
// stood there a second time, beside its own box.
function diffAnchors(report) {
  const anchors = new Set();
  for (const section of report.sections) {
    for (const one of section.files || []) {
      anchors.add(anchorOf(section.at_commit ? pathNow(one.path) : one.path, 0));
      walkHunks(withMore(one, section.name), null, (line, old, now) => {
        const anchor = diffLineAnchor(one.path, line, now, section.at_commit);
        if (anchor) anchors.add(anchor);
      });
    }
  }
  // The untracked file picked is drawn whole, once it is read.
  if (state.diffs.loose && state.diffs.found && !state.diffs.found.binary) {
    anchors.add(anchorOf(state.diffs.loose, 0));
    const count = linesOf((state.diffs.found.text || "").replace(/\n$/, "")).length;
    for (let line = 1; line <= count; line += 1) {
      anchors.add(anchorOf(state.diffs.loose, line));
    }
  }
  return anchors;
}

// The comments the diff does not draw: on a file it does not show, or on a
// line of one it does not reach -- a comment written on the Files tab, or
// one on a commit other than the one picked. The message sends every
// comment, so every comment has to be somewhere on this tab. They stand in a
// box of their own at the foot of the pane, so that the lines arriving fill
// that box again and not the whole diff.
function putElsewhere(scroll, report) {
  const holder = put(scroll, "div", "offdiff");
  holder.drawn = diffAnchors(report);
  fillElsewhere(holder);
}

// Each file stands with its lines round each comment, as the file is on
// disk, which is what a comment's line counts; until those are read, or
// where a line is no longer there, the comment stands with the line it
// quoted.
function fillElsewhere(holder) {
  holder.replaceChildren();
  const byPath = new Map();
  for (const one of reviewInOrder()) {
    if (holder.drawn.has(one.anchor)) continue;
    const path = one.anchor.split("\n")[0];
    if (!byPath.has(path)) byPath.set(path, []);
    byPath.get(path).push(one);
  }
  if (!byPath.size) return;
  const head = put(holder, "div", "diffhead elsewhere", "commented elsewhere");
  put(head, "span", "about", "comments on lines this diff does not show");
  const want = [];
  for (const [path, comments] of byPath) {
    const node = put(holder, "div", "dfile");
    const name = put(node, "div", "name");
    put(name, "span", "what", "file");
    put(name, "span", "path", path);
    const body = put(node, "div", "dbody");
    const read = state.reviewFiles.get(path);
    if (!read) want.push(path);
    const lines = read && typeof read.text === "string"
      ? linesOf(read.text.replace(/\n$/, "")) : [];
    const runs = [];
    const loose = [];
    for (const one of comments) {
      const at = Number(one.anchor.split("\n")[1]);
      if (!at || at > lines.length) { loose.push(one); continue; }
      // Two lines before a commented line and one after; runs that meet
      // are one run.
      const from = Math.max(1, at - 2);
      const to = Math.min(lines.length, at + 1);
      const last = runs[runs.length - 1];
      if (last && from <= last[1] + 1) last[1] = Math.max(last[1], to);
      else runs.push([from, to]);
    }
    runs.sort((a, b) => a[0] - b[0]);
    if (runs.length) {
      fillDiffFile(body, { path, drawn: holder.drawn, hunks: runs.map(
        ([from, to]) => asLines(path, lines.slice(from - 1, to), from).hunks[0]) });
      paintSlices(body, path, read, lines);
    }
    for (const one of loose) {
      putReview(put(body, "div", Number(one.anchor.split("\n")[1]) ? "onLine" : "onFile"),
                one.anchor, one.quoted, true);
    }
  }
  if (want.length) readElsewhere(want);
}

// The lines of the files `fillElsewhere` shows. An answer is kept until the
// diff lists the file, which is when it may have changed (`forgetChanged`);
// a read that failed is not kept, so the next draw asks again, and only an
// answer that came fills the box again. The map is taken before the wait: a
// new session has a new one, and an answer for the old is not written in it.
async function readElsewhere(paths) {
  const id = state.chosen;
  const files = state.reviewFiles;
  for (const path of paths) files.set(path, { asking: true });
  const answers = await Promise.all(paths.map((path) => askFile(id, path)));
  let came = false;
  // A 404 is JSON too: `missing`, which a timed-out `is_listed` also
  // says. Kept, it stood as a file with no lines until another session.
  paths.forEach((path, at) => {
    const got = answers[at].file;
    if (got) { files.set(path, got); came = true; }
    else files.delete(path);
  });
  const holder = document.querySelector(".diffscroll > .offdiff");
  if (came && files === state.reviewFiles && state.chosen === id && holder) {
    fillElsewhere(holder);
  }
}

// A file the diff lists is one that changed, so what was read of it may be
// out of date. The others cannot have moved without the diff listing them,
// and a poll that forgot them all read every one again every five seconds.
function forgetChanged(report) {
  const listed = new Set(report.untracked || []);
  for (const section of report.sections) {
    for (const one of section.files || []) listed.add(one.path);
  }
  for (const one of report.since || []) listed.add(one.path);
  for (const path of listed) state.reviewFiles.delete(path);
}

// Colour for the lines of a file shown in part. The whole file is painted,
// because a comment or a string that began above the part colours what is in
// it -- once for each time it is read, not on every draw -- and each row
// takes a copy of its own line.
async function paintSlices(body, path, read, lines) {
  const lib = await hljsReady();
  if (!lib || !body.isConnected) return;
  if (read.painted === undefined) {
    const language = languageOf(path, read.text, read.language || null);
    read.painted = language && lib.getLanguage(language) && lines.length <= CODE_WHOLE
      ? paintedLines(lib, language, lines.join("\n"), lines.length) : null;
  }
  if (!read.painted) return;
  for (const row of body.querySelectorAll(".dline")) {
    const at = Number(row.querySelector(".ln").textContent);
    const cell = row.querySelector(".dtext");
    const line = read.painted[at - 1];
    if (line && cell) cell.replaceChildren(line.cloneNode(true));
  }
}

// The send bar: on the Review tab, and only while there is a review. The
// comment on the whole review is kept while it is being typed in, and the
// rest is the message as it goes, after that comment.
function drawReviewBar() {
  const bar = $("reviewbar");
  const was = bar.hidden;
  // Kept while its box has the focus: emptying the one comment on the whole
  // review is not leaving it, and the bar went with the caret still in it.
  bar.hidden = state.tab !== "diff"
    || (!anyReview() && document.activeElement !== $("overall"));
  if (bar.hidden) return;
  const over = $("overall");
  if (document.activeElement !== over) over.value = state.review.overall;
  const said = $("reviewsay");
  const text = reviewText(false).trimEnd();
  const moved = said.value !== text;
  if (moved) said.value = text;
  const s = current();
  const why = whyNotTyped(s)
    || (!state.review.comments.length ? "nothing to send yet: comment on a line first"
    : "");
  const send = $("sendreview");
  send.disabled = !!why;
  send.title = why || "type the whole review into the agent's pane";
  if (was || moved) { fitSay($("overall")); fitSay($("reviewsay")); }
}

$("overall").addEventListener("input", () => {
  state.review.overall = $("overall").value;
  keepReview();
  fitSay($("overall"));
});
$("overall").addEventListener("keydown", (press) => {
  if (press.key === "Escape") $("overall").blur();
});
submitOnCtrlEnter($("overall"), $("sendreview"));
$("reviewbar").addEventListener("submit", (event) => {
  event.preventDefault();
  submitReview();
});

// The sessions a send is on its way to. `tmux send-keys` takes long enough to
// press twice in: a double-click on the review's send, or a second Enter in
// the send box, typed the whole text into the pane a second time -- and on
// two HTTP threads the text and the Enter of each can interleave into one
// prompt. The question's submit and a No go through it too, and the daemon
// holds the same rule for every tab at once (`claim`).
const sending = new Set();

// Take a session for one send: false when one is already on its way. The
// question's submit is held while anything is on its way to its session,
// and nothing else paints it when that starts or ends: an agent waiting on
// a question pushes nothing.
function startSending(id) {
  if (sending.has(id)) return false;
  sending.add(id);
  drawAsking();
  return true;
}

function doneSending(id) {
  sending.delete(id);
  drawAsking();
}

// What is left of a review once `sent` has gone: a comment saved or
// changed while it was on its way, and a word on the whole typed then.
function unsent(review, sent) {
  const went = new Set(sent.comments.map((one) => one.anchor + "\n" + one.note));
  const overall = typeof review.overall === "string" ? review.overall : "";
  return {
    overall: overall === sent.overall ? "" : overall,
    comments: review.comments.filter(
      (one) => !went.has(one.anchor + "\n" + one.note)),
  };
}

async function submitReview() {
  const id = state.chosen;
  // A box with text in it is a comment not yet in the review. Send closed
  // it, and what was typed went nowhere and nothing said so.
  if (busyWriting()) return;
  if (!startSending(id)) return;
  // A copy: an edit changes a comment in place.
  const sent = { overall: state.review.overall,
                 comments: state.review.comments.map((one) => ({ ...one })) };
  let answer;
  try {
    answer = await tell(id, "send", { text: reviewText() });
  } finally {
    doneSending(id);
  }
  if (!answer || answer.error) {
    said({ error: (answer && answer.error) || "it was not sent" });
    return;
  }
  // It worked, so an earlier refusal is no longer news. Without this the
  // note faded and the old "that is too many bytes" came back over a review
  // that had gone through.
  said(answer);
  // `tmux send-keys` takes long enough to press `j` in, and everything below
  // works on whatever is current: it wiped the new session's draft and
  // removed its key from storage. The review that was sent is the one to
  // clear, and where it lives when the reader has moved on is storage.
  //
  // And only what was sent: `send-keys` takes a moment, and a comment
  // saved in it was cleared with the rest, never sent.
  if (state.chosen !== id) {
    let held = null;
    try { held = JSON.parse(stored(REVIEW_KEY + id) || "null"); } catch (error) { }
    const left = held && Array.isArray(held.comments) ? unsent(held, sent) : null;
    store(REVIEW_KEY + id, left && (left.comments.length || left.overall.trim())
          ? JSON.stringify(left) : "");
    note("review sent");
    return;
  }
  const session = current();
  state.review = unsent(state.review, sent);
  // Ctrl+Enter sends with the focus still in the whole-review box, and
  // `drawReviewBar` leaves a box with the focus alone. The sent words stayed
  // in it, and what was typed next went into the state after them. So the
  // box takes what is left, and lets go of the focus when nothing is, or
  // the bar would stay up for an empty review.
  const over = $("overall");
  if (over.value !== state.review.overall) over.value = state.review.overall;
  if (!anyReview() && document.activeElement === over) over.blur();
  keepReview();
  // A box opened while it went is left alone, as a poll leaves it; closing
  // it draws the tab without what was sent.
  if (!writingIn($("content"))) redrawCode();
  // Claude Code queues what arrives mid-turn, so a review sent to a working
  // agent is not lost — it is read when the turn ends. Say so, because from
  // here it looks like nothing happened.
  note(session && session.state === "working"
    ? "review sent; the agent is working, so it reads this when the turn ends"
    : "review sent");
}

// The tab says how many comments are waiting, the way the Diff tab says how
// much has changed. Without it a review written and left would be invisible.
function drawReviewCount() {
  const badge = $("reviewcount");
  const many = state.review.comments.length;
  badge.hidden = !many;
  badge.textContent = counted(many, "comment", "comments");
  drawReviewBar();
}

function drawDiffCount() {
  const badge = $("diffcount");
  let added = 0;
  let removed = 0;
  for (const section of (state.diff ? state.diff.sections : [])) {
    for (const one of section.files) { added += one.added; removed += one.removed; }
  }
  badge.hidden = !(added || removed);
  badge.textContent = "+" + added + " \u2212" + removed;
}

// --- the Commands view --------------------------------------------------------

// The skills and commands your sessions can run, to read and to use again
// (#367). A view, not a tab (#411): a tab belongs to the chosen session,
// and most commands belong to no session -- yours in `~/.claude`, and the
// built-ins -- while a project's belong to every session in it. So it lists
// yours and the built-ins once, then each project's under its name, asked
// of one session in each. A command's text is asked for by its name, never
// by its path: `~/.claude` is outside every worktree, and a path from the
// page is input. "use" puts the command in a send box and types nothing;
// the reader adds what it needs and sends.
function blankCommands() {
  return {
    list: null,     // every session's answer, put together; null until then
    picked: "",     // the key of the one chosen (`commandKey`)
    read: null,     // the chosen one's text, or `{ error }`
  };
}

// A project's command is that project's: two projects may each have a
// `/deploy`, and they are two commands.
function commandKey(one) {
  return one.came === "project" ? one.via + "/" + one.name : one.name;
}

function commandOf(key) {
  return (state.commands.list || []).find((one) => commandKey(one) === key) || null;
}

// One session for each worktree on the list, the newest: a project's
// commands are the files under its `.claude`, the same for every session
// standing in it.
function projectSessions() {
  const one = new Map();
  for (const s of state.sessions) {
    if (isGone(s)) continue;
    const where = s.root || s.cwd;
    if (where && !one.has(where)) one.set(where, s);
  }
  return [...one.values()];
}

function projectName(s) {
  const named = projectSessions().filter((other) => other.repo === s.repo);
  return !s.repo ? s.worktree
    : named.length > 1 ? s.repo + "  ·  " + s.worktree : s.repo;
}

async function loadCommands() {
  const asked = projectSessions();
  const answers = await Promise.all(asked.map((s) => ask(s.id, "commands")));
  if (state.feed !== "commands") return;
  const list = [];
  const seen = new Set();
  asked.forEach((s, n) => {
    for (const one of (answers[n] && answers[n].commands) || []) {
      const entry = Object.assign({}, one, { via: s.id, project: projectName(s) });
      if (one.came === "project") list.push(entry);
      else if (!seen.has(one.name)) { seen.add(one.name); list.push(entry); }
    }
  });
  state.commands.list = list;
  draw();
  if (state.commands.picked && !state.commands.read) readCommand();
}

async function readCommand() {
  const key = state.commands.picked;
  const one = commandOf(key);
  // A built-in has no file: the list says all there is to say of it.
  if (!one || !one.file) return;
  const body = await ask(one.via, "command", "?name=" + encodeURIComponent(one.name));
  // The reader may have chosen another command while this was on its way:
  // it answers a question nobody asks now.
  if (state.commands.picked !== key) return;
  state.commands.read = body || { error: "no answer" };
}

async function pickCommand(key) {
  state.commands.picked = key;
  state.commands.read = null;
  draw();
  await readCommand();
  draw();
}

// The view, or back to the session it stands over: its button and `4`.
function toggleCommands() {
  if (state.feed === "commands") { if (state.chosen) choose(state.chosen); }
  else openFeed("commands");
}

// Where "use" types: the chosen session, unless the command is a project's
// it cannot see -- then the session the view asked for it.
function useTarget(one) {
  const chosen = current();
  if (one.came !== "project" || !chosen) return one.via;
  const mine = (chosen.root || chosen.cwd) === ((sessionById(one.via) || {}).root
                                                || (sessionById(one.via) || {}).cwd);
  return mine ? chosen.id : one.via;
}

function sessionById(id) {
  return state.sessions.find((s) => s.id === id) || null;
}

// "use": the command into that session's send box on the Transcript tab,
// the cursor after it, as the `/` list puts one (`putCommand`). A session
// nothing can be typed into says why, and the view stays.
function useCommand(key) {
  const one = commandOf(key);
  if (!one) return;
  const target = useTarget(one);
  const why = whyNotTyped(sessionById(target));
  if (why) {
    note(why);
    return;
  }
  choose(target);
  showTab("transcript");
  putCommand($("say"), 0, one.name);
}

// Yours and the built-ins first, then each project under its name.
const COMMAND_GROUPS = [["yours", "yours, in every project"],
                        ["plugin", "from your plugins"],
                        ["used", "built in, or no longer on disk"]];

function drawCommands(box) {
  box.className = "content split";
  const [list, pane, note] = split(box, "commands", "cmdbody");
  $("find").placeholder = "find a command  /";
  const held = state.commands;
  const all = held.list || [];
  const found = state.find ? hits(all, (one) => one.name)
                           : all.map((one) => ({ one, at: [] }));
  const key = JSON.stringify([!held.list, state.find, held.picked,
                              found.map((hit) => [commandKey(hit.one), hit.one.uses, hit.at])]);
  if (fresh(list, "commands", key)) {
    list.replaceChildren();
    note.textContent = !held.list ? "reading…"
      : state.find ? counted(found.length, "command", "commands") + " of " + all.length
      : counted(all.length, "command", "commands");
    const groups = COMMAND_GROUPS.map(([came, words]) =>
      [words, found.filter((hit) => hit.one.came === came)]);
    const projects = [...new Set(found.filter((hit) => hit.one.came === "project")
                                      .map((hit) => hit.one.project))];
    for (const project of projects) {
      groups.push([project, found.filter((hit) => hit.one.came === "project"
                                                  && hit.one.project === project)]);
    }
    for (const [words, these] of groups) {
      if (!these.length) continue;
      put(list, "div", "head", words);
      for (const { one, at } of these) {
        const name = commandKey(one);
        const row = put(list, "button", "cmdrow" + (name === held.picked ? " chosen" : ""));
        row.title = one.about || "/" + one.name;
        if (one.uses) put(row, "span", "cmduses", counted(one.uses, "use", "uses"));
        putName(row, "/" + one.name, at.map((where) => where + 1));
        if (one.about) put(row, "div", "cmdabout", one.about);
        row.addEventListener("click", () => pickCommand(name));
      }
    }
    if (held.list && !found.length) {
      put(list, "div", "nohits", state.find ? "Nothing here matches."
                                            : "No session has any commands.");
    }
  }
  drawCommand(pane);
}

// The chosen command: its name and what it takes, "use", where its file is,
// and what it says, as Markdown -- a skill is a page written to be read.
// What the list knows comes from the list; only the text is asked for.
// Drawn again only when one of those moved, so a poll does not lose the
// reader's place in a long skill.
function drawCommand(pane) {
  const held = state.commands;
  const one = commandOf(held.picked);
  const name = one ? one.name : held.picked.split("/").pop();
  const read = held.read;
  if (!fresh(pane, "command", JSON.stringify([held.picked, !!held.list, one, read]))) return;
  pane.replaceChildren();
  if (!held.picked) {
    const empty = put(pane, "div", "empty");
    put(empty, "h2", null, "Choose a command");
    put(empty, "p", null, "What it says is shown here, and “use” puts it"
        + " into the send box for you to finish and send.");
    return;
  }
  const head = put(pane, "div", "cmdhead");
  const title = put(head, "div", "cmdtitle");
  put(title, "span", "cmdname", "/" + name);
  if (one && one.hint) put(title, "span", "cmdhint", one.hint);
  const use = put(head, "button", "verb", "use");
  const target = one ? sessionById(useTarget(one)) : null;
  use.title = "put it into the send box of " + (target ? rowName(target) : "the session");
  use.addEventListener("click", () => useCommand(held.picked));
  if (held.list && !one) {
    put(pane, "div", "note", "No session can run it any more.");
    return;
  }
  if (one && one.file) put(pane, "div", "cmdfile", one.file);
  if (one && one.about) put(pane, "p", "cmdsays", one.about);
  if (one && !one.file) {
    put(pane, "div", "note", "Built into Claude Code, or its file has gone: no"
        + " file says what it does. Used " + counted(one.uses, "time", "times") + ".");
  } else if (!read) {
    put(pane, "div", "note", "reading…");
  } else if (read.error) {
    put(pane, "div", "note", "Its file cannot be read now.");
  } else {
    linkTickets(markdown(pane, read.text));
    if (read.cut) put(pane, "div", "note", "Cut here: the file goes on.");
  }
}

// --- the tabs ---------------------------------------------------------------

// `finds` is what the find box is for on that tab, and a tab that does not
// use it says so with `null` -- the box then goes away rather than standing
// there inviting a query nothing will answer. The Session tab is about one
// session and has no list to narrow, and it was offering "find a file",
// which is a promise about a tab one over.
//
// It lives here for the same reason `draw`, `load` and `poll` do: a new tab
// is one entry. The placeholder used to be a ternary in `showTab` naming
// three tabs, so the two it did not name got whatever the last arm said.
const TABS = {
  transcript: { draw: drawTranscript, load: loadTranscript, poll: 0,
                finds: "find a turn  /" },
  files: { draw: drawFiles, load: loadFiles, poll: 2000,
           finds: "go to file  /" },
  diff: { draw: drawDiff, load: loadDiff, poll: 5000,
          finds: "find a file  /" },
};

// Which tab each number key picks: the order of `TABS`, so a new tab is one
// entry there and nothing else.
const TAB_KEYS = Object.keys(TABS);

function draw() {
  const box = $("content");
  if (state.feed) { drawFeed(box); return; }
  box.className = "content split";
  if (!current()) {
    // The find box lives inside this box, so it goes home before the box is
    // emptied, or it is destroyed with every listener on it and the next
    // `$("find")` throws. A tab's own rebuild does the same in `split`.
    homeFind($("findhome"));
    box.replaceChildren();
    box.dataset.tab = "";       // nothing is built, so the next tab rebuilds
    state.turns.nodes = [];
    drawEmpty(box);
    return;
  }
  TABS[state.tab].draw(box);  // showTab only ever sets a tab that is in here
}

function showTab(name) {
  if (!TABS[name]) return;
  // The box was on the tab you are leaving. A click on the tab on screen,
  // or its key, leaves nothing: the box stayed, the flag went, and the
  // next poll or pick rebuilt the diff and took what was typed.
  if (name !== state.tab) state.writing = null;
  state.tab = name;

  drawHeader();               // the send box belongs to the transcript only
  for (const button of document.querySelectorAll(".tab")) {
    button.setAttribute("aria-selected", String(button.dataset.tab === name));
  }
  $("find").placeholder = TABS[name].finds;
  load();
  resubscribe();
}

function drawEmpty(box) {
  const empty = put(box, "div", "empty");
  put(empty, "h2", null, "No session selected");
  put(empty, "p", null,
      "Start a Claude Code session in tmux and it appears on the left.");
  const p = put(empty, "p", null, "If nothing ever appears, run ");
  put(p, "code", null, "wostuast doctor");
  p.appendChild(document.createTextNode(" to see what is missing."));
}

// --- talking to the daemon --------------------------------------------------

// What a session remembers between visits: what the reader chose, and never
// what the daemon sent. The listing, the file's text and the diff are fetched
// again -- by the time you come back they have moved, and they are also the
// big things, 52,799 names being 1.7 MB of it.
// What a session keeps, each with how it is copied: as it is, or a Set or a
// Map of its own, so the place and the page share nothing. One table for
// `savePlace` and `usePlace`, which named every field twice and were kept
// in step by a test alone (#300).
//
// The Transcript tab's choices and not its blocks: those are a cache the
// daemon fills again, and `nodes` holds live DOM belonging to a page this
// session has left. `turns.run` says which reading those `seq`s belong to;
// without it, coming back to a session looks exactly like its transcript
// having been rewritten. `files.down` is written down as the reader
// scrolls, so it is right whichever tab they are on when they leave: asking
// the DOM here instead meant a second writer, and it wrote the outgoing
// session's place over the one just restored for the new session.
const asIs = (value) => value;
const PLACE_FIELDS = [
  ["turns", "at", asIs], ["turns", "down", asIs], ["turns", "run", asIs],
  ["turns", "open", (value) => new Set(value)],
  ["turns", "shut", (value) => new Set(value)],
  ["files", "path", asIs], ["files", "at", asIs], ["files", "asText", asIs],
  ["files", "down", asIs], ["files", "dirs", (value) => new Map(value)],
  ["diffs", "open", (value) => new Map(value)], ["diffs", "of", asIs],
  ["diffs", "shut", (value) => new Set(value)],
  ["diffs", "more", (value) => new Map([...value].map(([key, runs]) => [key, runs.slice()]))],
  ["diffs", "loose", asIs],
];

function savePlace(id) {
  if (!id) return;
  const kept = { tab: state.tab };
  for (const [bag, field, copy] of PLACE_FIELDS) kept[bag + "." + field] = copy(state[bag][field]);
  state.visits.set(id, kept);
  // A session that has gone from the list will not be chosen again, so its
  // place is dead weight on a page that is meant to stay open for days.
  const live = new Set(state.sessions.map((one) => one.id));
  for (const kept of [...state.visits.keys()]) {
    if (kept !== id && !live.has(kept)) state.visits.delete(kept);
  }
}

// Put back onto a state that has just been blanked, so every field is one
// the blank already has. A session never visited has nothing here and keeps
// the blank.
function usePlace(id) {
  const kept = state.visits.get(id);
  if (!kept) return null;
  for (const [bag, field, copy] of PLACE_FIELDS) state[bag][field] = copy(kept[bag + "." + field]);
  return kept;
}

// A `/clear` ends the session being watched and starts another, with a new
// id and a new transcript, in the same pane. The page stayed on the one that
// had ended, and a reload then opened on some other row: the reader read it
// as the transcript breaking. So it follows -- once, when the daemon links
// the two while this page is open. A link already there when the page opens
// was not made under the reader's eyes, and one they have followed is one
// they may go back from to read the old conversation.
function followClear(first) {
  for (const s of state.sessions) {
    if (!s.cleared_into || state.cleared.has(s.id)) continue;
    if (first) { state.cleared.add(s.id); continue; }
    if (!state.sessions.some((one) => one.id === s.cleared_into)) continue;
    state.cleared.add(s.id);
    if (s.id === state.chosen) choose(s.cleared_into);
  }
}

// An answered question stays until its `PostToolUse`, and then its id is
// no longer needed: one no session still asks is forgotten, so the set holds
// what is on screen and nothing that has gone.
function forgetAnswered() {
  const asked = new Set(state.sessions.map((s) => s.asking && s.asking.id));
  for (const id of state.answered) if (!asked.has(id)) state.answered.delete(id);
}

function choose(id) {
  // Choosing a session leaves the feed, the one on screen too (#376).
  if (state.feed) {
    closeFeed();
    if (state.chosen === id) { showTab(state.tab); markSeen(); return; }
  }
  if (state.chosen === id) return;
  if (state.chosen) {
    state.before = state.chosen;
    try { sessionStorage.setItem("wostuast-before", state.before); }
    catch (error) { /* a tab that keeps nothing still goes back until a reload */ }
  }
  savePlace(state.chosen);
  state.chosen = id;
  state.keptUnread = null;        // a mark made while looking holds till now
  // The address names the session on screen, so a reload comes back to it.
  // Without it a reload chose the first row, which after a `/clear` is the
  // new session, and the conversation the reader was on seemed to be gone.
  // `replaceState` makes no `hashchange` and no entry in the history. An
  // address that already names this session is left alone: it may be a link
  // to one reply, and the reply is what a reload of a link should land on.
  try {
    const held = placeInHash();
    if (!held || held.id !== id) {
      history.replaceState(null, "", "#" + encodeURIComponent(id));
    }
  } catch (error) {
    // A page the browser will not let rewrite its address still works.
  }
  // One assignment each, which is what the two bags are for: the transcript
  // and the worktree of the last session are not this one's, and a field
  // added to either must not need a line here to be forgotten from.
  state.turns = blankTurns();
  state.files = blankFiles();
  state.diffs = blankDiff();
  state.diff = null;
  recallReview(id);
  state.reviewFiles = new Map();
  state.writing = null;
  drawReviewCount();
  drawDiffCount();          // the last session's counts are not this one's
  const back = usePlace(id);
  drawSessions();
  // The tab is part of where you were, so coming back to a session ends the
  // way every tab change ends -- `showTab` draws the header, loads the tab
  // and resubscribes, which was this function's own tail.
  showTab(back && TABS[back.tab] ? back.tab : state.tab);
  markSeen();
}

// `b`: back to the session chosen before this one, and pressed again, back
// to this one (#354) -- two agents on related work are read in turns, and
// the list moves under you when a session changes state, so the other one is
// never in the same place twice. A `/clear` since is followed into the
// session it started, as the page follows one. A session forgotten, or one
// the filter hides, is not gone to: the page says why instead.
function goBack() {
  let id = state.before;
  for (let hops = 0; id && hops < 10; hops++) {
    const s = state.sessions.find((one) => one.id === id);
    if (!s || !s.cleared_into) break;
    id = s.cleared_into;
  }
  if (!id || id === state.chosen) {
    note("no session was chosen before this one");
  } else if (!state.sessions.some((one) => one.id === id)) {
    note("the session before this one is no longer in the list");
  } else if (!shownSessions().some((one) => one.id === id) && !childIds().has(id)) {
    note("the session before this one is hidden by the filter");
  } else {
    choose(id);
  }
}

// A tab that reads the worktree asks again while it is on screen. The
// transcript is pushed over SSE and needs none of this. A hidden page asks
// nothing at all: the timer is not set, and `visibilitychange` starts it again.
function repoll() {
  clearTimeout(state.poll);
  state.poll = 0;
  const wait = TABS[state.tab].poll;
  if (!wait || !state.chosen || document.visibilityState !== "visible") return;
  state.poll = setTimeout(load, wait);
}

async function ask(id, what, query, raw) {
  try {
    const answer = await fetch(apiUrl(id, what, query));
    return raw ? await answer.text() : await answer.json();
  } catch (error) {
    return null;                            // the daemon went away; try later
  }
}

async function load() {
  // A timer belongs to the tab that set it. Only `repoll` cleared it, once a
  // load was over: on a slow link the Files tab's two-second poll fired into
  // the Transcript tab while its fetch was still out, and fetched the whole
  // transcript again, 856 KB of it. So it goes first, and a load that ends
  // after the reader has moved to another tab sets none for that tab.
  clearTimeout(state.poll);
  state.poll = 0;
  if (!state.chosen) { draw(); return; }
  const tab = state.tab;
  try {
    await TABS[tab].load();
  } finally {
    if (state.tab === tab) repoll();
  }
}

// `seq` is a place in one reading, not an identity. A transcript rewritten
// under its own name counts from nought again, so everything the reader
// chose by `seq` then points at a different block: the tool results they had
// expanded, the rounds they had folded shut, and the row the map marks. They
// are forgotten together, in one place, because there are three of them and
// a fourth would be added to two of them.
//
// This is why `run` is one of the things a session keeps: coming back to a
// session whose transcript has not been rewritten must keep your place, and
// `usePlace` putting the choices back without the reading they belong to
// would make every return look like a rewrite.
function forgetPlaces() {
  state.turns.open = new Set();
  state.turns.shut = new Set();
  state.turns.at = null;
  state.turns.goTo = null;
}

//: How long a transcript fetch that failed waits before it asks again. The
//: tab polls nothing -- the transcript is pushed -- so nothing else would.
const TRANSCRIPT_RETRY = 2000;

async function loadTranscript() {
  const want = state.chosen;
  // One retry waiting at a time: every tab switch into a failing fetch
  // started a loop of its own, and when the daemon came back each of them
  // asked for the whole transcript at once.
  clearTimeout(state.transcriptRetry);
  // What is pushed while this is on its way. The daemon takes the snapshot
  // under its lock and writes the answer after letting go, so a tick can push
  // the next block first -- and the push is small, and wins. Putting the older
  // snapshot in place wholesale lost that block for good: the next one landed
  // after a hole, and a text block is never pushed again.
  //
  // The list is also this fetch's ticket. **Only the newest fetch lands**:
  // two were out at once after a quick Transcript-Session-Transcript, the
  // pushes went into the second one's list, and the first, answering last,
  // put its older snapshot back without them.
  const early = [];
  state.turns.early = early;
  // What is held, when the pushes have kept it whole: the daemon answers
  // `same` and no blocks when nothing moved. Coming back to this tab took the
  // whole transcript every time, five seconds on a slow link, for blocks the
  // page already had. Only `whole` may say so: pushes alone are pieces -- a
  // session chosen from another tab collects them before any fetch, and a
  // push of a new reading starts over from nothing -- and their version
  // would pass for the lot.
  const turns = state.turns;
  const body = await ask(want, "transcript",
                         turns.whole ? `?have=${turns.run}.${turns.version}` : "");
  if (state.chosen !== want) return;        // the reader moved on while we waited
  if (state.turns.early !== early) return;  // a newer fetch is out, or landed
  state.turns.early = null;
  if (!body || (body.error && !body.blocks)) {
    // A failed fetch is not an empty transcript. It was drawn as one, the
    // reader's places were forgotten, and nothing asked again. What is held
    // is drawn, and with nothing held the tab says it could not read it.
    state.turns.failed = true;
    state.turns.landed = true;
    draw();
    state.transcriptRetry = setTimeout(() => {
      if (state.chosen === want && state.tab === "transcript") loadTranscript();
    }, TRANSCRIPT_RETRY);
    return;
  }
  state.turns.failed = false;
  // `same` is what was held, and the pushes that landed since are in it too.
  const blocks = body.same ? state.turns.blocks : body.blocks || [];
  const run = body.run !== undefined ? body.run : -1;
  let version = body.version || 0;
  // A push from another reading means this snapshot is older than the file:
  // the transcript was rewritten while the answer was on its way. Put in
  // place, it showed a reading the file no longer held.
  if (early.some((pushed) => pushed.run !== run)) {
    loadTranscript();
    return;
  }
  for (const pushed of early) {
    for (const block of pushed.blocks || []) blocks[block.seq] = block;
    version = Math.max(version, pushed.version || 0);
  }
  state.turns.blocks = blocks;
  // Only a reading replacing another one. `-1` is "none held yet", which is
  // every first load -- and `goTo` is set from the address bar before this
  // runs, so forgetting there would throw away the link the page opened on.
  if (state.turns.run !== -1 && run !== state.turns.run) forgetPlaces();
  state.turns.run = run;
  state.turns.version = version;
  state.turns.whole = true;
  state.turns.landed = true;
  draw();
  // The stream opened while this was on its way, and said what it holds.
  const told = state.turns.told;
  state.turns.told = null;
  if (told && (told.run !== run || told.version > version)) loadTranscript();
}

// Every worktree's names, kept by its top (`worktree_path`: git's answer,
// or where the session started until git has said) and not by session. They are the
// one big thing the Files tab sends -- 53,000 names are about half a megabyte
// packed -- and a session choice blanked them, so every switch between two
// sessions, or back to one, fetched the lot again: seconds each on an ssh
// tunnel. The names are the worktree's, not the session's, so a session in
// a worktree already read asks with its tag and gets none back.
function keepListing(root) {
  if (!root) return;
  const held = state.files;
  state.listings.set(root, {
    tag: held.tag, names: held.names, known: held.known,
    skipped: held.skipped, tree: held.tree, places: held.places,
  });
}

function adoptListing() {
  const s = current();
  const held = s && s.worktree_path ? state.listings.get(s.worktree_path) : null;
  if (!held) return;
  Object.assign(state.files, held);
}

async function loadFiles() {
  const want = state.chosen;
  // Nothing held for this session yet: what this page has of its worktree.
  if (!state.files.tag) adoptListing();
  // Both are asked for on every poll. The listing used to come every other
  // one, because it carried every name in the repository each time; now it
  // carries them only when they have moved, so asking often is nearly free
  // and the changed-file dot turns up in about two seconds instead of six.
  const body = await ask(want, "files",
                         "?have=" + encodeURIComponent(state.files.tag));
  if (!body || state.chosen !== want) return;
  // A listing git failed on is short or empty, and taken as fact it closed
  // the open file, lost its place and a comment half written on it. The
  // names held stand until git answers; only a listing that did not fail
  // may say a file has gone. With nothing held yet, what came is better
  // than nothing.
  const stands = body.failed && state.files.names.length > 0;
  if (!stands) state.files.tag = body.tag || "";
  state.files.changed = new Map(Object.entries(body.changed || {}));
  state.files.total = body.total || 0;
  state.files.cut = !!body.cut;
  state.files.failed = !!body.failed;
  state.files.ignoredMax = body.ignored_max || 0;
  // The tag is a hash of the names, so a directory that has grown past the
  // budget -- or shrunk back under it -- moves this and nothing else. The
  // tree is built from both, so it has to be rebuilt for either.
  const left = (body.skipped || []).join("\0");
  const moved = left !== [...state.files.skipped].join("\0");
  if (moved) state.files.skipped = new Set(body.skipped || []);
  // No `names` means the tag we sent still stands, so the ones we hold do too.
  // NUL separates them: it is the only character a file name cannot hold, and
  // an empty listing splits to one empty string rather than to none.
  const named = body.names !== undefined && !stands;
  if (named) {
    state.files.names = body.names ? body.names.split("\0") : [];
    state.files.known = new Set(state.files.names);   // built once, asked every poll
  }
  if (named || moved) {
    state.files.tree = buildTree(state.files.names, state.files.skipped);
    // Everything the reader can go to, files and the directories holding
    // them, built here for the same reason the tree is: fifty thousand names
    // are not worth walking once per keystroke to add the folders back.
    state.files.places = state.files.names.concat(
      [...state.files.tree.keys()].filter(Boolean));
    if (!body.failed) keepListing(current() && current().worktree_path);
  }
  state.files.marked = dirsWithChanges(state.files.changed);
  if (!state.files.known.has(state.files.path)
      && !(body.failed && state.files.path)) {
    // The first file the reader will see, from the one place that decides
    // what that order is. It runs when the open file has gone, not per poll.
    const first = listRows().find((row) => !row.dir);
    forgetFile(first ? first.path : null);
  }

  if (state.files.path) {
    // The file is asked for by name, and the name can change while the answer
    // is on its way: pick another file quickly and the first one's text landed
    // under the second one's name, so the tab showed one file's content
    // labelled as another. The session is not the only thing that can move.
    const wanted = state.files.path;
    // The version shown goes back, so a file nobody touched is answered
    // `same` and not sent again: up to 512 KB every two seconds (#292).
    const got = await askFile(want, wanted,
                              state.files.read ? state.files.stamp : "");
    if (state.chosen !== want || state.files.path !== wanted) return;
    // Only a file whose mtime moved is drawn again, so the tab keeps your
    // place in a file the agent has not touched.
    //
    // A `missing` answer is not the file's text. It is what the route says
    // when git did not list the name -- which a timed-out `ls-files` says
    // too -- and it was drawn as line 1 of the file, with a `+` that would
    // anchor a comment to the real line 1. What is shown stays; a file that
    // really went is taken away by the listing. **With nothing shown yet it
    // is said**: a refused first read drew the header over an empty body,
    // a file with nothing in it, for as long as the refusal lasted; and a
    // fetch that failed drew nothing, so the file before stood under the
    // name just picked.
    const body = got.file;
    state.files.trouble = got.why || "";
    if (body && !body.same
        && (!state.files.read || body.mtime !== state.files.mtime)) {
      state.files.read = true;
      state.files.text = body.text || "";
      state.files.binary = !!body.binary;
      state.files.shown = body.shown || "";
      state.files.oversize = !!body.oversize;
      state.files.lang = body.language || "";
      state.files.mtime = body.mtime || 0;
      state.files.size = body.size || 0;
      state.files.stamp = body.stamp || "";
    }
  }
  draw();
}

async function loadDiff() {
  const want = state.chosen;
  const of = state.diffs.of;
  const base = recallBase();
  const query = new URLSearchParams();
  if (of) query.set("of", of);
  if (base) query.set("base", base);
  // The tag of the answer held. Only while one is: every place that drops
  // the answer empties `diffTag`, so none of them can send a tag for a diff
  // the page no longer has. The tag is the one comparison: the whole text
  // was kept beside it to compare as well, megabytes for a large diff (#291).
  if (state.diffs.tag) query.set("have", state.diffs.tag);
  const raw = await ask(want, "diff",
                        query.toString() ? "?" + query.toString() : "", true);
  if (raw === null || state.chosen !== want || state.diffs.of !== of
      || recallBase() !== base) return;
  let body = null;
  try { body = JSON.parse(raw); } catch (error) { return; }
  // The diff held still stands: nothing to take in and nothing new to draw,
  // but an untracked file not yet read is still asked for below.
  const stands = body && body.same && !!state.diffs.tag && body.tag === state.diffs.tag;
  if (body && !stands) {
    // A session that has gone answers with an error, not a report. Drawing
    // that as if it were one is how the tab used to go blank and stay blank.
    if (!body.sections) return;
    // git did not answer about a picked commit: the diff held stands, and
    // the pick with it, until it does.
    if (body.failed && of && !body.sections.length) { draw(); return; }
    // The commit picked is not on the branch any more. What came back is
    // everything, so that is what is shown, and the pane says why.
    if (body.gone && body.gone === of && !body.failed) {
      state.diffs.of = "";
      state.diffs.gone = true;
    }
    state.diffs.tag = body.tag || "";
    state.diff = body;
    forgetChanged(body);
  }
  draw();
  // An untracked file picked and not read: coming back to the session puts
  // the pick back and not the text, and a read that failed is tried again.
  if (state.diffs.loose && !state.diffs.found && state.diffs.asking !== state.diffs.loose) {
    readLoose(state.diffs.loose);
  }
}

// Every block carries its place in the transcript, so a block that arrives
// twice lands in the same slot. Appending whatever arrived showed the whole
// history a second time after a reconnect, and could double a block that the
// first fetch and the first push both carried.
function mergeBlocks(blocks) {
  const moved = [];
  for (const block of blocks) {
    state.turns.blocks[block.seq] = block;
    moved.push(block.seq);
  }
  return moved;
}

function streamUrl() {
  return "/api/events" +
    (state.chosen ? "?watch=" + encodeURIComponent(state.chosen) : "");
}

function resubscribe() {
  const where = streamUrl();
  if (state.stream && state.streamUrl === where) return;
  if (state.stream) state.stream.close();
  state.streamUrl = where;
  const stream = new EventSource(where);
  state.stream = stream;

  stream.addEventListener("sessions", (message) => {
    document.body.classList.remove("offline");
    const body = JSON.parse(message.data);
    state.skew = body.now - Date.now() / 1000;
    // A link in the address bar chooses a session before this list exists,
    // and until it arrives `current()` is null and every tab draws its empty
    // state. This is the moment that session becomes a real one.
    const waiting = !!state.chosen && !current();
    const first = !state.sessions.length;
    // Every row when a stream opens, then only what changed (#431).
    state.sessions = body.sessions || mergeSessions(state.sessions, body);
    if (typeof body.saved === "number") state.savedCount = body.saved;
    forgetAnswered();
    followClear(first);
    if (!current() && state.sessions.length) {
      // Pick the first one for the reader. It has to go through choose(), or
      // the stream stays on watch="" and this session, the one actually on
      // screen, never receives a transcript update.
      const first = (topSessions()[0] || state.sessions[0]).id;
      state.chosen = null;
      choose(first);
    } else if (waiting && current()) {
      draw();
    }
    drawSessions();
    drawHeader();
    markSeen();
    state.live = "live";
    paintLive();
  });

  // `settings.json` changed: in this page's menu, another page's, or by hand.
  stream.addEventListener("settings", (message) => {
    takeSettings(JSON.parse(message.data));
  });

  stream.addEventListener("transcript", (message) => {
    const body = JSON.parse(message.data);
    if (body.id !== state.chosen) return;
    // A stream opens by saying which reading the daemon holds, and its
    // `version`. What was read while no stream was open -- between a fetch's
    // snapshot and this stream joining, while a dropped one reconnected, or
    // into a stream the browser had closed -- was sent to nobody. A count of
    // blocks would not do: a tool result is written into its call's block.
    if (body.opening) {
      // Pushes went to nobody. What is held is pieces now, whatever tab is
      // up: a later push would raise `version` and make them look whole.
      // Only a fetch that lands says `whole` again.
      const behind = body.run !== state.turns.run
                     || body.version > state.turns.version;
      if (behind) state.turns.whole = false;
      if (state.tab !== "transcript") return;   // fetched when it is shown
      if (state.turns.early) { state.turns.told = body; return; }
      if (behind) loadTranscript();
      return;
    }
    if (state.turns.early) state.turns.early.push(body);
    state.turns.version = Math.max(state.turns.version, body.version || 0);
    // A transcript can be rewritten under its own name, and then `seq` counts
    // from nought again. Patching by index would write the new blocks over the
    // head of the old ones and leave the old tail hanging below, so a new
    // reading replaces what is held rather than being merged into it.
    if (body.run !== undefined && body.run !== state.turns.run) {
      // The same `-1` guard `loadTranscript` carries, and for a sharper
      // reason: the first push can land before the first fetch has returned,
      // and then `run` is still -1 with nothing held. Replacing the blocks
      // there is right; forgetting the reader's place is not, and it threw
      // away a link the page had opened on whenever the machine was busy
      // enough to reverse those two.
      const held = state.turns.run !== -1;
      state.turns.run = body.run;
      // By `seq`, never packed from nought. A push carries only the blocks
      // that changed; with nothing held (a fetch still on its way, or one
      // that failed) block 3 was put at index 0 as though it were the whole.
      state.turns.blocks = [];
      state.turns.whole = false;
      mergeBlocks(body.blocks || []);
      state.turns.nodes = [];
      if (held) forgetPlaces();
      draw();
      return;
    }
    patchTranscript(mergeBlocks(body.blocks || []));
  });

  stream.onopen = () => { document.body.classList.remove("offline"); };

  stream.onerror = () => {
    document.body.classList.add("offline");
    state.live = "reconnecting";
    paintLive();
  };
}

// --- keys --------------------------------------------------------------------

// Few keys, on purpose. `j` `k` walked the list, `n` went to the next
// session that needs you, `r` opened the review and `t` showed thinking;
// the reader used none of them, and `3` is the review already. A key nobody
// presses is a line in `?` that hides the ones they do.

// How the focus got where it is: Tab moves it by keyboard, a pointer by
// hand. Read by the keys below, to leave Enter to a button a keyboard
// reached. Capture, so this is known before anything acts on the press.
let focusedByKey = false;
document.addEventListener("pointerdown", () => { focusedByKey = false; }, true);
document.addEventListener("keydown", (press) => {
  if (press.key === "Tab") focusedByKey = true;
}, true);

document.addEventListener("keydown", (press) => {
  const help = $("help");
  if (press.key === "Escape") {
    // A view is left by Escape too, as its title says (#392) -- unless the
    // Escape closed something else first, or the filter box took it.
    const open = !!document.querySelector("dialog[open]")
      || !$("setpop").hidden || !$("modelpop").hidden;
    for (const box of document.querySelectorAll("dialog")) {
      if (box.open) box.close();
    }
    showSettings(false);     // not a dialog, and it closes the same way
    showModels(false);
    if (!open && state.feed && press.target !== $("pick")) leaveFeed();
    return;
  }
  if (press.metaKey || press.ctrlKey || press.altKey) return;
  const tag = (press.target.tagName || "").toLowerCase();
  // A `select` is typing too: a letter picks the option that starts with it,
  // and the Diff tab's commit picker is one.
  if (tag === "input" || tag === "textarea" || tag === "select") return;
  // A control reached with the keyboard keeps its own Enter: that is how a
  // keyboard presses a button, and jumping instead left nothing on the page
  // that Enter could press. After a click the focus sits on the button too,
  // and there Enter still jumps, as it always has. `:focus-visible` cannot
  // tell the two apart here: a key pressed on a clicked button turns it on
  // before this handler runs.
  if (press.key === "Enter" && focusedByKey
      && press.target.closest && press.target.closest("button, a, summary")) {
    return;
  }
  switch (press.key) {
    case "/":
      $("find").focus();
      break;
    case "f": $("pick").focus(); break;
    case "e": {
      const row = document.querySelector(".row.chosen");
      if (!row) return;
      press.preventDefault();          // no browser may type it into the box
      renameRow(row);
      break;
    }
    case "Enter": jumpToPane(); break;
    case "s":
      if ($("sendbar").hidden) return;
      $("say").focus();
      break;
    case "c": nextTheme(); break;
    case "b": goBack(); break;
    case "z": if (state.chosen) toggleSnooze(state.chosen); break;
    case "u": if (state.chosen) toggleUnread(state.chosen); break;
    case "?": help.open ? help.close() : help.showModal(); break;
    // The Commands view (#411): it was the fourth tab, and its key stays.
    case "4": toggleCommands(); break;
    default: {
      // A tab per number key, in the order the tabs are drawn. The list is
      // the one in `TAB_KEYS`, so a new tab is an entry there and nothing
      // else: the keys used to be spelled out here and stopped at four, and
      // the fifth tab shipped with no key at all.
      const at = "123456789".indexOf(press.key);
      if (at < 0 || at >= TAB_KEYS.length) return;
      showTab(TAB_KEYS[at]);
    }
  }
  // A key that did something leaves no ring on a button the pointer
  // pressed. A click leaves the focus on its button, and a key pressed after
  // it turns `:focus-visible` on -- so clicking the Review tab and pressing
  // 1 drew the browser's dark ring round Review, the tab just left. A
  // button reached by keyboard keeps its ring: that is where the reader is.
  const held = document.activeElement;
  if (!focusedByKey && held && held.matches("button")) held.blur();
  press.preventDefault();
});

// keep the ages honest without asking the daemon anything
setInterval(tickAges, 1000);

// A hidden page polls nothing. Looking at it again starts the timer.
document.addEventListener("visibilitychange", repoll);
document.addEventListener("visibilitychange", markSeen);
$("feedlink").addEventListener("click", () => {
  if (state.feed === "unread") { if (state.chosen) choose(state.chosen); } else openFeed("unread");
});
askSaved();        // which answers are saved, for their "saved"
$("searchlink").addEventListener("click", () => {
  if (state.feed === "search") { if (state.chosen) choose(state.chosen); } else openFeed("search");
