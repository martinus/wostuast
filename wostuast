// The box is cleared only once the daemon says the text went in. Clearing it
// first and then failing loses what the user typed, and they typed it at a
// terminal they cannot see.
async function sendTyped() {
  const box = $("say");
  const text = box.value;
  const id = state.chosen;
  if (!id || !text.trim() || sending.has(id)) return;
  sending.add(id);
  // Out of the box the moment it goes, and back in front of whatever was
  // typed since if it did not. Clearing on the answer took the words typed
  // while the send was on its way, which had gone nowhere; and a box still
  // holding the sent text, edited meanwhile, sent it a second time.
