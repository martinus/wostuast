// "auto", "light" or "dark": the words the menu shows.

const THEME_ORDER = ["system", "light", "dark"];

// The browser's own light or dark, asked of one query. The head script asks
// it once more for itself, because it runs before this one exists.
const LIGHT = window.matchMedia("(prefers-color-scheme: light)");

function systemTheme() {
  return LIGHT.matches ? "light" : "dark";
}

function themeChoice() {
  return document.documentElement.dataset.themeChoice || "system";
}

// The colours only. Whoever changed them paints the menu, once.
function showTheme(choice) {
  document.documentElement.dataset.themeChoice = choice;
  document.documentElement.dataset.theme = choice === "system" ? systemTheme() : choice;
