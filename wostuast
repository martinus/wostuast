// The jump happens in another window, often on another screen, so the page
// says it went: the button ticks and the slot names the session. It said
// nothing at all, and a jump that worked looked like a key that did nothing.
async function jumpToPane() {
  if (!state.chosen) return;
  const session = current();
  const answer = await tell(state.chosen, "jump");
  said(answer);
  if (answer && !answer.error) {
    flashOutcome($("jump"), "terminal", JUMP_TITLE, true, "jumped");
    note("jumped to " + (session ? rowName(session) : "its pane"));
  }
}

// The box is cleared the moment the text goes, and a refusal puts the text
// back in front of whatever was typed since, so a failure loses nothing the
// reader typed at a terminal they cannot see. An empty box is therefore the
// send starting, not the send landing: `sending` is what says it is still on
// its way.
// --- completing a slash command ---------------------------------------------

// A `/` at the start of the send box, or after a space in it (#368), opens
// a list of the commands this session has: its skills and command files, yours, and the commands its
// transcripts say were run, which is the only place the built-in ones are
// written (`Commands` in the daemon). The list is asked for each time it
// opens, so a skill written a minute ago is in it, and then narrowed here as
// letters are typed. `dismissed` is an Escape: the list stays shut until the
// word it was for is gone, or sent. `moved` is an arrow key pressed since
// the list was drawn: the reader chose a row (`slashKey`).
const slash = { list: null, shown: [], at: 0, asked: 0, dismissed: false,
                moved: false };

// Where each command comes from: a short word for the `/` list, and a long
// one for the Commands tab's group headings (#367), in the order the groups
// are drawn. One table, so a new origin is not drawn in one and lost in the
// other.
const CAME = {
  project: ["this project", "this project"],
  yours: ["yours", "yours, in every project"],
  plugin: ["plugins", "from your plugins"],
  used: ["used before", "built in, or no longer on disk"],
};

// The command word the caret stands in: where its `/` is, what stands
// between the `/` and the caret, and whether it is the first word. null when
// there is none.
//
// Not only the first word (#368). Measured on Claude Code 2.1.288, a
// `/deploy` in the middle of a prompt is not run there, but Claude Code
// tells the model "the user's message contains /deploy, which is the name of
// a skill" and to call the Skill tool if asked to run it -- for a skill and
// for a command file alike. A built-in such as `/clear` is no skill, so in
// the middle it does nothing: `drawSlash` leaves those out there.
//
// The `/` must start the box or follow white space: `src/main.py` and
// `and/or` are not commands.
function slashSpot(box) {
  const end = box.selectionStart;
  if (end !== box.selectionEnd) return null;
  const text = box.value;
  let from = end;
  while (from > 0 && !/\s/.test(text[from - 1])) from -= 1;
  if (text[from] !== "/" || from === end) return null;
  return { from, word: text.slice(from + 1, end), first: !text.slice(0, from).trim() };
}

function closeSlash() {
  slash.list = null;
  slash.shown = [];
  $("slash").hidden = true;
}

async function followSlash() {
  const box = $("say");
  if (!slashSpot(box)) {
    slash.dismissed = false;
    closeSlash();
    return;
  }
  if (slash.dismissed) return;
  if (!slash.list) {
    const id = state.chosen;
    const asked = ++slash.asked;
    const answer = id ? await ask(id, "commands") : null;
    // A later keystroke asked again, or the reader moved on: theirs wins.
    // A box left while the answer was out is moved on from too, or the list
    // opened over the transcript with nothing to type into.
    if (asked !== slash.asked || id !== state.chosen
        || document.activeElement !== box) return;
    slash.list = answer && Array.isArray(answer.commands) ? answer.commands : [];
  }
  drawSlash(slashSpot(box));       // again: the box may have moved meanwhile
}

// The commands whose name holds the letters typed, best first. With nothing
// typed yet, the daemon's order: the most used first.
function drawSlash(spot) {
  const pop = $("slash");
  if (!spot || !slash.list || slash.dismissed) { closeSlash(); return; }
  const query = spot.word.toLowerCase();
  // In the middle of a message only what has a file works: Claude Code
  // names a skill or a command file to the model, and nothing else.
  const list = spot.first ? slash.list : slash.list.filter((one) => one.file);
  const scored = [];
  for (const one of list) {
    const hit = query ? fuzzy(one.name, query) : { score: 0, at: [] };
    if (hit) scored.push({ one, hit });
  }
  // Stable, so equal scores keep the daemon's order.
  scored.sort((a, b) => b.hit.score - a.hit.score || b.one.uses - a.one.uses);
  slash.shown = scored.map((each) => each.one);
  slash.at = 0;
  slash.moved = false;
  pop.textContent = "";
  scored.forEach(({ one, hit }, index) => {
    const row = put(pop, "button", null);
    row.tabIndex = -1;
    row.setAttribute("role", "option");
    putName(row, "/" + one.name, hit.at.map((at) => at + 1));
    if (one.hint) put(row, "span", "hint", one.hint);
    if (one.about) put(row, "span", "about", one.about);
    put(row, "span", "came", (CAME[one.came] || [""])[0]);
    // Pressed, not clicked: a click moves the focus out of the box first.
    row.addEventListener("mousedown", (press) => {
      press.preventDefault();
      takeSlash(one);
    });
    row.addEventListener("mousemove", () => markSlash(index));
  });
  pop.hidden = !scored.length;
  markSlash(0);
}

function markSlash(index) {
  const rows = $("slash").children;
  if (!rows.length) return;
  slash.at = (index + rows.length) % rows.length;
  for (let i = 0; i < rows.length; i += 1) {
    rows[i].classList.toggle("chosen", i === slash.at);
  }
  rows[slash.at].scrollIntoView({ block: "nearest" });
}

// The command goes in place of the word, with a space after it for what it
// is given. What was typed after the word stays.
// The command goes in place of the word, wherever in the message it stands.
// Only an open list comes here, and a list is open only over a `/word`.
function takeSlash(one) {
  const box = $("say");
  putCommand(box, slashSpot(box).from, one.name);
  closeSlash();
}

// `/name ` into the box at `from`: in place of a `/word` standing there, or
// before what is there, with a space after it and the caret after that.
// The `/` list and the Commands tab's "use" both come here, so they keep
// the same text round the command: "use" had its own rule, and joined two
// lines into one.
function putCommand(box, from, name) {
  const before = box.value.slice(0, from);
  let rest = box.value.slice(from);
  if (rest.startsWith("/")) rest = rest.replace(/^\S*/, "");
  const head = before + "/" + name + (/^\s/.test(rest) ? "" : " ");
  box.value = head + rest;
  box.setSelectionRange(head.length, head.length);
  fitSay(box);
  box.focus();
}

// Whether Enter takes the chosen row rather than send. Tab always takes;
// Enter only when the reader chose: an arrow pressed, or the word typed so
// far is the start of the name. A scattered match is a guess -- `/doctor`,
// never run and so not listed, took `/docs-to-review` and the next Enter
// sent the wrong command -- and a word that is the whole name is done.
function enterTakes() {
  const spot = slashSpot($("say"));
  const name = slash.shown[slash.at].name.toLowerCase();
  const typed = (spot ? spot.word : "").toLowerCase();
  return slash.moved || (name.startsWith(typed) && name !== typed);
}

// The list's own keys, before the box's. True when the key was the list's.
function slashKey(press) {
  if ($("slash").hidden) return false;
  const enter = press.key === "Enter" && !press.shiftKey && !press.altKey
    && !press.ctrlKey && !press.metaKey && !composing(press);
  if (press.key === "ArrowDown" || press.key === "ArrowUp") {
    markSlash(slash.at + (press.key === "ArrowDown" ? 1 : -1));
    slash.moved = true;
  } else if (press.key === "Escape") {
    slash.dismissed = true;
    closeSlash();
  } else if ((press.key === "Tab" && !press.shiftKey) || (enter && enterTakes())) {
    takeSlash(slash.shown[slash.at]);
  } else {
    return false;
  }
  press.preventDefault();
  return true;
}

async function sendTyped() {
  const box = $("say");
  const text = box.value;
  const id = state.chosen;
  if (!id || !text.trim() || !startSending(id)) return;
  // The box empties without an input event, and an Escape held for the
  // word just sent would keep the next `/` from opening anything.
  slash.dismissed = false;
  closeSlash();
  // Out of the box the moment it goes, and back in front of whatever was
  // typed since if it did not. Clearing on the answer took the words typed
  // while the send was on its way, which had gone nowhere; and a box still
  // holding the sent text, edited meanwhile, sent it a second time.
  box.value = "";
  fitSay();                    // back to one line, whatever it had grown to
  let answer;
  try {
    answer = await tell(id, "send", { text });
  } finally {
    doneSending(id);
  }
  said(answer);
  if (!answer || !answer.done) {
    box.value = text + box.value;
    fitSay();
  }
}

$("sendbar").addEventListener("submit", (press) => {
  press.preventDefault();
  sendTyped();
});

// The box is one line until it needs more, and then it is as tall as what is
// in it — up to the height the stylesheet allows, after which it scrolls.
// Height has to go back to nothing first, or a box that has grown can never
// shrink again: scrollHeight would only ever report the height it already has.
// It leaves the border out, and every box is `border-box`, so the 2 px of
// border are added back or the last line scrolls. The review's two boxes and
// the reason for a No are sized here too. An empty box is as tall as its
// placeholder: Chromium counts the placeholder in `scrollHeight`.
function fitSay(box = $("say")) {
  // A box nobody can see measures nothing, and would be sized to 2 px. The
  // reason for a No stands in no form, so its form cannot be asked.
  if (!box.getClientRects().length) return;
  box.style.height = "auto";
  box.style.height = (box.scrollHeight + 2) + "px";
  if (box === $("say")) sizeSay(box);
}

// How tall the send box must be before there is room above the send button
// for its size: the button's 32 px, a gap, and the two rows of the size.
// Three lines of text make the box 68 px.
const SAY_ROOM = 66;

// How much is in the send box: its lines and its bytes, above the send
// button, once the box is tall enough to leave room there (issue 332). A
// box scrolled to the end of a long log shows its last screenful and
// nothing of how long it is. Bytes, as the daemon counts what it may send.
// Here because every change of the box -- a key, a paste, a send that
// empties it, a refusal that puts the text back -- comes through `fitSay`.
function sizeSay(box) {
  const out = $("saysize");
  const text = box.value;
  out.hidden = !text || box.offsetHeight < SAY_ROOM;
  if (out.hidden) return;
  const lines = lineCount(text);
  out.replaceChildren();
  put(out, "span", null, roughly(lines) + (lines === 1 ? " line" : " lines"));
  put(out, "span", null, sizeOf(new TextEncoder().encode(text).length));
}

$("say").addEventListener("input", () => { fitSay(); followSlash(); });
$("say").addEventListener("blur", closeSlash);
$("say").addEventListener("keydown", (press) => {
  if (slashKey(press)) return;
  if (press.key === "Escape") {
    $("say").blur();
    return;
  }
  // Enter sends. Shift and Enter is how you write a second line, which is
  // what every chat box does and what a prompt with a plan in it needs.
  // Ctrl+Enter sends too, as it does in every other box on this page. The
  // Enter that ends a composition picks a word and sends nothing.
  if (press.key === "Enter" && !press.shiftKey && !press.altKey
      && !composing(press)) {
    press.preventDefault();
    sendTyped();
  }
});
drawBell();
