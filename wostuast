  file: "M3.5 1.5h4.7L11.5 5v8.4h-8zM8 1.7V5h3.3",
  // Who spoke, on the transcript's map: the reader, and the agent. A folder
  // and a page said "a round holds replies", which is the shape of the list
  // and not what a row is. Both closed, for the reason `dirOpen` is.
  person: "M4.6 4.3a2.4 2.4 0 1 0 4.8 0a2.4 2.4 0 1 0-4.8 0z"
          + "M2.2 12.8c.4-2.7 2.4-4.3 4.8-4.3s4.4 1.6 4.8 4.3z",
  robot: "M3.8 4.6h6.4a1.8 1.8 0 0 1 1.8 1.8v4.2a1.8 1.8 0 0 1-1.8 1.8H3.8"
         + "a1.8 1.8 0 0 1-1.8-1.8V6.4a1.8 1.8 0 0 1 1.8-1.8z"
         + "M7 4.6V2.6M5.2 7.6v1.2M8.8 7.6v1.2M5.6 10.2h2.8",
  // What folds a round, pointing right; `aria-expanded` turns it down. It
  // is the second target on a round's row, and a shape of its own, so the
