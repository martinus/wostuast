# --- log: a plain text log, so a broken hook leaves a trace ------------------


def log(message: str) -> None:
    """Append one line to the log file. Never raise."""
    try:
        path = log_path()
        private_dir(path.parent)
        rotate(path, LOG_MAX_BYTES, path.with_name(path.name + ".1"))
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        with open_private(path) as handle:
            handle.write(f"{stamp} {message}\n")
    except Exception:
        pass


def write_atomic(path: Path, text: str, private: bool = False,
                 mode: int | None = None, sync: bool = False) -> None:
    """Write the whole file or none of it, so a reader never sees half a file.

    The temporary name carries this process's pid and the writing thread. A
    fixed name would be shared by two writers, and one could rename the
    other's half-written file into place — or unlink it from under the other,
    which is how a `POST /name` beside another one raised `FileNotFoundError`
    into a browser's request. The status line runs on every redraw, so two
    processes is normal, and the daemon answers every browser in a thread of
    its own.

    `mode` keeps a file's own permissions: a new file takes the umask, which
    for `settings.json` meant 0600 came back 0644. **The temporary is made
    0600 and widened after**, never made at the umask and narrowed after:
    written first and chmodded second, it stood at 0644 holding the whole of
    `settings.json`, API keys and all, in a directory that is not private --
    and stayed that way if the process died in between. `open_private` is
    the same rule for an append. `sync` puts the bytes and
    then the rename on the disk, which costs a wait — the status line writes on
    every redraw, so it is asked for rather than given.
    """
    if private:
        private_dir(path.parent)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    import threading

    temporary = path.with_name(
        f"{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    try:
        # A stale temporary of this name, left by a writer that died, keeps
        # its own mode through `O_TRUNC`; gone first, the mode below holds.
        temporary.unlink(missing_ok=True)
        narrow = private or mode is not None
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                               0o600 if narrow else 0o666),
                       "w", encoding="utf-8") as handle:
            handle.write(text)
        if narrow:
            # Exact, whatever the umask took away at creation.
            temporary.chmod(0o600 if private else mode)
        if sync:
            with open(temporary, "rb") as handle:
                os.fsync(handle.fileno())
        temporary.replace(path)
        if sync:
            # The rename is on the disk only once the directory is. Without
            # this, a power loss right here can leave the file empty — and
            # `settings.json` is the one file Claude Code will not start
            # without. Not every filesystem allows the open; the write has
            # landed either way, so a refusal is not an error.
            try:
                folder = os.open(path.parent, os.O_RDONLY)
            except OSError:
                return
            try:
                os.fsync(folder)
            except OSError:
                pass
            finally:
                os.close(folder)
    finally:
        try:
            temporary.unlink()
        except OSError:
            pass


def rotate(path: Path, limit: int, backup: Path) -> None:
    """Move the file aside when it grows past the limit. Never raise."""
    try:
        if path.exists() and path.stat().st_size > limit:
            path.replace(backup)
    except OSError:
        pass


# --- event log: append only, one JSON object per line ------------------------


def still_the_file(handle: Any, target: Path) -> bool:
    """Is the handle we are holding still the file at that name?

    A `flock` is on an inode, not on a name. Between opening a file and
    getting its lock, another process can rename it away — and then the lock
    we were waiting for is a lock on something that is no longer the log.
    """
    try:
        ours = os.fstat(handle.fileno())
        there = os.stat(target)
    except OSError:
        return False
    return file_key(ours) == file_key(there)


def append_event(record: dict[str, Any], stamp: bool = False) -> None:
    """Append one event. The caller has already added pane and pid.

    `stamp` is for the hook: `ts` is written *after* the lock is held, so
    the order of the lines and the order of `ts` agree. The hook used to
    stamp first and lock second, and two hooks of one session race for the
    lock -- a batch of parallel tools, a `Notification` timer -- so the one
    that stamped later could write first: 30 rounds of four real hooks at
    once gave one line in 120 out of order. The rest of the line is made
    before the lock and the stamp is put on its end, so the lock is held for
    a write and never for a `json.dumps` of a megabyte of tool output. Every
    other writer -- the daemon's `Declined`, a test -- gives its own `ts`.

    Two hooks can reach the size limit at the same moment, and the lock alone
    does not order them: it is taken on the inode, so a hook that opened the
    log before another rotated it holds the *archive*, sees a file over the
    limit, and renames the fresh log on top of the archive — every event ever
    recorded, gone. Measured, before `still_the_file` was here to stop it. A
    hook that finds it is holding the wrong inode simply opens again.

    Surrogates are replaced rather than raising. `json.dumps` emits a lone
    surrogate happily and a UTF-8 encoder refuses it, so one in a tool response
    lost the whole event — and a `SessionStart` lost that way costs the session
    its cwd, pane and pid for good. (Naming the escape here in the usual way
    would put a real lone surrogate in this docstring, and Python 3.13 cannot
    write that into a bytecode cache. It broke CI on 3.13 alone.)
    """
    target = events_path()
    private_dir(target.parent)
    if stamp:
        record = {key: value for key, value in record.items() if key != "ts"}
    raw = json.dumps(record, ensure_ascii=False, default=str)
    body = raw.encode("utf-8", "replace").decode("utf-8")

    def line() -> str:
        """The line to write, stamped now if it is to be: call it under the lock."""
        if not stamp:
            return body + "\n"
        joint = ", " if record else ""
        return body[:-1] + joint + '"ts": ' + json.dumps(time.time()) + "}\n"

    for _ in range(3):        # a rotation under us; the next open finds it
        with open_private(target) as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            if not still_the_file(handle, target):
                continue      # someone rotated while we waited; open the new one
            if (os.fstat(handle.fileno()).st_size > EVENTS_MAX_BYTES
                    and archive_log(target)):
                # The handle still points at the file we just renamed. Open the
                # fresh one, so this event lands there rather than in the
                # archive. It is created 0600, like every file we make. Only
                # when the rename happened: a second handle on the same file
                # waits on our own lock for ever, because a `flock` belongs
                # to the open file and not to the process.
                with open_private(target) as fresh:
                    fcntl.flock(fresh.fileno(), fcntl.LOCK_EX)
                    fresh.write(line())
                return
            handle.write(line())
            handle.flush()
            return


def archive_log(target: Path) -> bool:
    """Move the live log to the next archive number, and never over one.
    True when it moved; False when the log is still where it was, and the
    event is written there.

    The caller holds the log's lock, which is what keeps two hooks from
    archiving the same file. The name is still worked out from a listing and
    then used, and `os.replace` would silently put the log on top of anything
    that landed on that name in between -- the scar `still_the_file` was
    written for, when a rename over the one archive lost every event ever
    recorded. `os.link` refuses a name that is taken, so a taken name costs
    one more try and nothing else. A filesystem with no hard links is left
    to `os.replace` on a name that was free when it was listed.

    No listing, no rotation: the next number is not known, and a number
    tried from 1 up fills a gap with the newest file. The log grows a
    little past the limit and the next hook rotates it. An `unlink` that
    fails leaves one file under two names, and it is still the live log;
    the readers read it once (`EventFollower.new_lines`, `log_handles`).
    """
    archives = archived_events_paths()
    if archives is None:
        return False
    number = archive_number(archives[-1]) + 1 if archives else 1
    for _ in range(1000):
        archive = target.with_name(f"events.{number}.jsonl")
        try:
            os.link(target, archive)
        except FileExistsError:
            number += 1
            continue
        except OSError:
            if archive.exists():
                number += 1
                continue
            os.replace(target, archive)
            return True
        try:
            os.unlink(target)
        except TimeoutError:
            raise
        except OSError as error:
            log(f"the log is now named twice, as {archive.name} too: {error}")
            return False
        return True
    return False


def log_handles(recent: bool = False) -> Iterator[Any]:
    """Every file of the event log, open to read, oldest first, each once.

    The archives come first because they hold the older events. Reading only
    the current file would lose the SessionStart of every session that began
    before the last rotation, and with it their cwd, pane and pid.

    The live file is opened *before* the archives are listed, as in
    `EventFollower.new_lines`. Listed first, a rotation in between left the
    newest archive out: it was not in the listing, and the live name was
    already the new file. Opened first, a rotation in between makes the
    file held the newest archive, and it is read once, through the handle,
    last. **Each file is read once, by its device and inode**: a rotation
    stopped between its `os.link` and its `os.unlink` leaves one file
    under two names, and the next rotation gives it a third, and every read
    of the log read all of it twice. A file gone between the listing and
    the open is skipped. A listing that fails raises: a history read
    without its archives looks whole and is not.
    """
    try:
        live = open(events_path(), "rb")
    except FileNotFoundError:
        live = None
    try:
        archives = archived_events_paths()
        if archives is None:
            raise OSError(f"cannot list the event log's archives in {state_dir()}")
        seen = {file_key(os.fstat(live.fileno()))} if live is not None else set()
        for path in archives:
            try:
                handle = open(path, "rb")
            except FileNotFoundError:
                continue
            with handle:
                info = os.fstat(handle.fileno())
                key = file_key(info)
                if key in seen or (recent and folded_long_ago(info)):
                    continue
                seen.add(key)
                yield handle
        if live is not None:
            yield live
    finally:
        if live is not None:
            live.close()


def folded_long_ago(info: os.stat_result, now: float | None = None) -> bool:
    """Whether an archive was last written before `HISTORY_FOLDED`, and so
    is left out of a fold (#430). By the file's time: an archive is the
    live file renamed, and is not written again, so its time is its last
    event's, and nothing in it need be read to know."""
    return info.st_mtime < (time.time() if now is None else now) - HISTORY_FOLDED


def measure_log() -> tuple[int, int, int]:
    """How many lines the log holds, in how many files, of how many bytes."""
    lines = files = size = 0
    for handle in log_handles():
        files += 1
        size += os.fstat(handle.fileno()).st_size
        lines += sum(chunk.count(b"\n") for chunk in iter(lambda: handle.read(1 << 20), b""))
    return lines, files, size


def read_events() -> Iterator[dict[str, Any]]:
    """Read the log a fold needs, oldest file first, each file once: every
    archive but those written before `HISTORY_FOLDED` (#430), as the
    daemon's follower reads it, so `ls` and the page agree."""
    for handle in log_handles(recent=True):
        yield from json_objects(handle)


def json_objects(lines: Iterable[bytes]) -> Iterator[dict[str, Any]]:
    """Turn lines into the JSON objects among them, and skip the rest.

    `json.loads` takes bytes and decodes them itself, in C, which is quicker
    than decoding the file first. Broken UTF-8 raises UnicodeDecodeError, and
    that is a ValueError, so one clause covers a torn line and a bad byte
    alike. Every reader of a JSON-lines file goes through here.
    """
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            yield record


# --- following files: read what is new, keep a half-written last line --------


@dataclass
class Tail:
    """Reads the new lines of a file that grows, and nothing twice.

    It remembers how far it has read and holds back a last line that has no
    newline yet, because a writer can be caught mid-line. It also remembers
    which file it was reading, by device and inode, so a file replaced under
    the same name starts again from the beginning instead of seeking past the
    end of a smaller one and going quiet for ever.
    """

    path: Path
    offset: int = 0
    partial: bytes = b""
    key: tuple[int, int] = (0, 0)
    #: True when the last read started over rather than carried on. A caller
    #: that accumulates what it reads has to hear about that: a transcript
    #: reader that only appends will draw the whole file twice. The event log
    #: never lets its tail start over on a file it can still read on
    #: (`EventFollower.new_lines`), because nothing there drops a repeat.
    restarted: bool = False
    #: True when the last read reached the end of the file, or found no file.
    #: False when `open`, `fstat` or `read` failed on the way. An archive is
    #: finished with only once this is True.
    whole: bool = False
    #: Every byte this tail has read, restarts included. It is what the start
    #: of `serve` reports, and a file read twice was parsed twice.
    consumed: int = 0

    def read_new(self) -> list[bytes]:
        """Every new line, as one list, for a caller that keeps them anyway."""
        return list(self.lines())

    def lines(self, handle: Any = None) -> Iterator[bytes]:
        """Every new line, read `TAIL_CHUNK` at a time.

        A piece holding no newline gives no line, and that is not the end:
        a line longer than a piece is carried in `partial` until one ends it.
        The end is the size the file had when this started, so a file that
        grows while it is read cannot keep the reader here -- what arrives
        later is the next call's. The file is asked about through the handle
        it is read from, so a file renamed between the two is never read
        with the other one's offset.

        A caller may hand in a handle it opened itself, and the lines then
        come from that file whatever the name holds by now: the follower
        opens the live log before it lists the archives.
        """
        self.restarted = False
        self.whole = False
        if handle is None:
            try:
                handle = open(self.path, "rb")
            except FileNotFoundError:
                self.whole = True        # no file is nothing left to read
                return
            except OSError:
                return
        with handle:
            try:
                info = os.fstat(handle.fileno())
            except OSError:
                return
            key = (info.st_dev, info.st_ino)
            if key != self.key:
                started = self.key != (0, 0)     # not the first look at this name
                self.key, self.offset, self.partial = key, 0, b""
                self.restarted = started
            elif info.st_size < self.offset:  # rewritten shorter, under the same name
                self.offset, self.partial = 0, b""
                self.restarted = True
            end = info.st_size
            handle.seek(self.offset)
            while self.offset < end:
                try:
                    data = handle.read(min(TAIL_CHUNK, end - self.offset))
                except OSError:
                    return
                if not data:
                    break                # it shrank while read: no more
                self.offset += len(data)
                self.consumed += len(data)
                head, newline, rest = (self.partial + data).rpartition(b"\n")
                self.partial = rest
                if newline:
                    for line in head.split(b"\n"):
                        if line.strip():
                            yield line
            self.whole = True


class EventFollower:
    """Follows the event log: every archive, then the live file.

    The hook rotates the log, not the daemon, so the live file can become an
    archive under the follower at any moment, and a daemon can start after
    any number of rotations. Each pass lists the archives -- one `listdir` --
    and reads the ones it has not finished, oldest first, then the live file.

    An archive is not written again once the live name has left it, so one
    read to its end is the last. The live file that has just become an
    archive is recognised by its inode and its tail is handed over with its
    place in it: a tail that only knew names read all 20 MB again on every
    rotation.

    **Every line is read once, and in the order of the log**, because
    `Store.apply` folds every event it is given and drops none by its time
    (it used to, and dropped real events: see there). A repeat would set a
    session back to what it was then, and an archive read after the live
    file that replaced it would do the same. `new_lines` says how both are
    kept out.
    """

    def __init__(self) -> None:
        self.live = Tail(events_path())
        self.archives: dict[Path, Tail] = {}
        self.finished: set[Path] = set()
        #: The files read to their end, by device and inode. One file can
        #: have two archive names (`new_lines` says how), and the second is
        #: finished without a read.
        self.done_files: set[tuple[int, int]] = set()
        #: How many names were finished that way, so `files_read` counts
        #: files and not names.
        self.second_names = 0
        #: How many passes in a row each archive gave nothing on.
        self.failed: dict[Path, int] = {}
        #: What has been read, for the start of `serve` to say: the events,
        #: and the bytes of every archive already finished with.
        self.events = 0
        self.finished_bytes = 0
        #: The archives left out for their age (#430), for the start to say.
        self.left_out = 0

    def archive_tail(self, path: Path, key: tuple[int, int] | None) -> Tail:
        """The tail for an archive: the live one, if this is the live file."""
        if key is not None and key == self.live.key:
            handed, self.live = self.live, Tail(events_path())
            handed.path = path
            return handed
        return Tail(path)

    def new_lines(self) -> Iterator[bytes]:
        """Every line not read yet, each once, oldest first.

        The live file is opened *before* the archives are listed. A rotation
        links the live file to its archive name before it unlinks the live
        name, and a new live file is made only after that, so every archive
        older than the file this handle holds had its name before the handle
        was opened, and the listing names it. When every archive listed is
        finished, nothing older than the live file is unread, and the handle
        is read. When one is not, the handle is closed, the archives are
        read, and the loop looks again, because the log may have rotated
        meanwhile: at the start the fold reads a year of archives, which
        takes seconds.

        The listing used to be taken once, at the start of a pass. A
        rotation during the pass took the live tail to the new file from
        its top, and the next pass read the new archive from its top: its
        first part twice, and all of it after newer events. `Store.apply`
        then dropped every one of them it saw as old -- an open question
        with no bar, a prompt, where the session started.

        **A listing that fails reads nothing this pass**, not even the live
        file (`archived_events_paths` gives None). Read as "no archives", it
        let the live tail start on a new file while the archive of the old
        one waited unread, and that archive then came from its top, after
        the newer events.

        **Each file is read once, by its device and inode, whatever it is
        called.** A rotation stopped between its `os.link` and its
        `os.unlink` -- the hook's deadline, a crash -- leaves the live file
        under two names, and the next rotation gives it a third. Read by
        name, the running follower read it from the top once it saw the
        archive, and every start read it twice over. So the newest archives
        that are the file the live handle holds are not read as archives:
        it is still the live file, and it is read once, through the handle.
        And an archive whose file was read to its end under another name is
        finished without a read.

        An archive that cannot be read (`Tail.whole` is False) stops the
        pass, so nothing after it comes first, and is tried again on the
        next one. After `ARCHIVE_TRIES` passes in a row that read none of
        it, it is given up. It used to be marked finished at once, and
        skipped until the daemon started again.
        """
        while True:
            try:
                live = open(self.live.path, "rb")
            except OSError:
                live = None
            listed = archived_events_paths()
            holding = None
            if live is not None:
                try:
                    holding = file_key(os.fstat(live.fileno()))
                except OSError:
                    listed = None           # not known what it holds: wait
            if listed is None:
                if live is not None:
                    live.close()
                return
            pending: list[tuple[Path, tuple[int, int] | None]] = []
            now = time.time()
            for path in listed:
                if path in self.finished:
                    continue
                try:
                    info = path.stat()
                    key: tuple[int, int] | None = file_key(info)
                except OSError:
                    key = None            # the read that follows says why
                    info = None
                # One last written before `HISTORY_FOLDED` is left out, and
                # never begun (#430): every start read all of them, and grew
                # with the whole history. Never one already begun, and never
                # the file the live tail holds, which was written just now.
                if (info is not None and path not in self.archives
                        and key != self.live.key and folded_long_ago(info, now)):
                    self.finished.add(path)
                    self.left_out += 1
                    continue
                pending.append((path, key))
            while pending and holding is not None and pending[-1][1] == holding:
                pending.pop()
            if not pending:
                break
            if live is not None:
                live.close()
            for path, key in pending:
                if key is not None and key in self.done_files:
                    self.finished.add(path)   # its first name, just read
                    self.second_names += 1
                    continue
                tail = self.archives.get(path)
                if tail is None:
                    tail = self.archives[path] = self.archive_tail(path, key)
                before = tail.consumed
                yield from tail.lines()
                if not tail.whole:
                    if tail.consumed > before:
                        self.failed.pop(path, None)   # it moved: not a failure
                        return
                    tries = self.failed[path] = self.failed.get(path, 0) + 1
                    if tries < ARCHIVE_TRIES:
                        return
                    log(f"an archive could not be read {tries} times, so it"
                        f" is left out until the next start: {path.name}")
                # Read to its end, and nothing will be added to it: the tail
                # is done with, and only how much it read is kept.
                self.finished.add(path)
                done = tail.key if tail.key != (0, 0) else key
                if done is not None:
                    self.done_files.add(done)
                del self.archives[path]
                self.failed.pop(path, None)
                self.finished_bytes += tail.consumed
        if live is not None:
            yield from self.live.lines(live)

    def new_events(self) -> Iterator[dict[str, Any]]:
        for event in json_objects(self.new_lines()):
            self.events += 1
            yield event

    def files_read(self) -> tuple[int, int]:
        """How many files have been read from, and how many bytes."""
        size = (self.finished_bytes + self.live.consumed
                + sum(tail.consumed for tail in self.archives.values()))
        count = (len(self.finished) - self.second_names - self.left_out
                 + len(self.archives) + (1 if self.live.consumed else 0))
        return count, size


