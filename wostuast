@dataclass
class GitFacts:
    """What git says about the directory an agent stands in."""

    repo: str = ""
    branch: str = ""
    ahead: int = 0
    behind: int = 0
    dirty: bool = False
    touched_files: int = 0
    #: The top of the worktree. The page keys what belongs to a checkout on
    #: it -- the Diff tab's base -- because `cwd` moves with every `cd`.
    root: str = ""
    #: Where the repository is fetched from, for the row's hover: `origin`,
    #: or the first remote there is. Any user and password taken out.
    remote: str = ""
    #: git did not answer about a directory that is a repository. Empty facts
    #: read as a clean repository with no branch, which is a real state and
    #: not this one — and they used to be remembered as the answer.
    failed: bool = False
    #: What reading the facts raised, when it raised: `failed` is set too.
    #: For the log only (`git_facts_or_failed`).
    raised: str = ""
    #: What git has started and not finished in this worktree: "rebasing
    #: 2/3", "merging", … or "" (`worktree_doing`, #357).
    doing: str = ""
    #: How many files git holds in conflict: the unmerged lines of `status`.
    conflicts: int = 0


@dataclass
class Status:
    """The latest status line payload of a session, written by `wostuast status`."""

    ts: float = 0.0
    name: str = ""
    model: str = ""
    context_pct: float | None = None
    #: What this session has spent, in dollars. Claude Code works it out on
    #: the client at list price and says so: it may differ from the bill, and
    #: it goes back to nought on `/clear`. The page carries that caveat rather
    #: than dropping the number, because an estimate you can see beats a bill
    #: you cannot. `None` is "the status line did not say", which is not 0.
    cost_usd: float | None = None
    agent: str = ""
    #: The model's full id, `model.id` of the status line: "claude-opus-5-5"
    #: where `model` is its display name, "Opus 5.5". An alias names only the
    #: newest of a family, so an older one is reached by this (`row`).
    model_id: str = ""
    #: How hard the model thinks: `effort.level` of the status line --
    #: "low", "medium", "high", "xhigh" or "max", measured on 2.1.287. ""
    #: when the payload has none, as for Haiku, which has no effort at all.
    effort: str = ""


@dataclass
class Subagent:
    """One subagent the Agent tool started inside a session (#422).

    It is no session of its own: measured on 2.1.289, `SubagentStart`, its
    tool calls and `SubagentStop` all come under the session that started
    it, each with the subagent's `agent_id` and `agent_type`. It can run on
    after that session's turn has ended.
    """

    #: Its `agent_type`: "general-purpose", "Explore", a plugin's agent.
    kind: str = ""
    #: The `description` its Agent call gave, which no `SubagentStart` carries.
    what: str = ""
    #: Its last tool call, as `tool_summary` says it.
    doing: str = ""
    started: float = 0.0
    #: When it ended, or 0 while it runs.
    ended: float = 0.0


@dataclass
class Session:
    """One Claude Code session, built from its events."""

    session_id: str
    cwd: str = ""
    #: Where this session started. `cwd` is the directory the agent is
    #: standing in, and Claude Code moves it the moment the agent changes
    #: directory -- so a row that said `repo/dir` renamed itself to
    #: `repo/src` mid-turn, and the one fact you cannot read anywhere else on
    #: the page moved under you. Stamped by `SessionStart`, because a resumed
    #: session really does start somewhere else, and otherwise only while
    #: nothing is known yet. Read through `place`, never on its own.
    home: str = ""
    pane: str = ""
    pid: int = 0
    transcript_path: str = ""
    state: str = "done"
    #: The moment this session last became what it is, which is what the list
    #: is ordered by. Moved in one place -- `Store.apply`, and `settle` for
    #: the two states nothing reports -- because a handler assigns the same
    #: state over and over and only a change is a change.
    state_since: float = 0.0
    last_ts: float = 0.0
    last_event: str = ""
    last_prompt: str = ""
    #: The first prompt that was not a command, on one line: the name Claude
    #: Code gives a session before it has a title (#351). See `title`.
    first_prompt: str = ""
    #: The model's full id as `SessionStart` names it, for a session with no
    #: status line: see `model_id`.
    started_model: str = ""
    #: The last prompt as an alert shows it, and the prompt it was made
    #: from: see `shown_prompt`.
    prompt_shown: tuple[str, str] = ("", "")
    last_tool: str = ""
    reason: str = ""
    attention_since: float = 0.0
    # True once this session has sent a PermissionRequest. That event is
    # the same news as a permission Notification, up to twelve seconds
    # earlier, so once it arrives the Notification is only ever stale.
    asks_first: bool = False
    #: What the open permission dialog is about, as `tool_summary` says it.
    #: Empty when no dialog is open, or when the event did not name a tool.
    asked_about: str = ""
    #: The tool calls that have started and not yet reported back, by
    #: `tool_use_id`, each as `tool_summary` says it. A permission dialog
    #: carries no id, and this is how its call is found. Bounded by
    #: `CALLS_HELD`, because a call whose result never comes would otherwise
    #: stay here for the life of the session.
    calls: dict[str, str] = field(default_factory=dict)
    #: The permission dialog on screen, as the page shows it: `read_permission`.
    #: Cleared wherever the attention is.
    permission: dict[str, Any] | None = None
    #: The question the agent is waiting on, when it is waiting on one. See
    #: `read_ask`. It is cleared wherever the attention is, and precisely by
    #: its own `tool_use_id` when the answer lands.
    asking: dict[str, Any] | None = None
    end_reason: str = ""
    #: How this session started: `startup`, `resume`, `clear`, `compact`.
    #: Kept for `link_clear`, which needs it whichever of the two events of
    #: a `/clear` is folded second.
    start_source: str = ""
    #: The two halves of a `/clear`. It ends this session and starts another
    #: with a new id and a new transcript, in the same pane and the same
    #: Claude process, so the reader watching this one was left on a session
    #: that had just ended. `link_clear` joins them; the page follows
    #: `cleared_into`.
    cleared_into: str = ""
    cleared_from: str = ""
    #: The session whose agent started this one: a `claude -p` it ran from
    #: its Bash tool (#422). Such a session is no row of its own; the page
    #: draws it as a line under that one. See `Store.parent_of`.
    started_by: str = ""
    #: The pid `started_by` was looked up for, so it is looked up once.
    started_pid: int = 0
    #: Its first event: how long a child has run, on its parent's row.
    started_at: float = 0.0
    #: The subagents the Agent tool started in this session, by `agent_id`,
    #: oldest first: those still running, and the last of those that ended,
    #: up to `SUBAGENTS_HELD`. `agents_ran` counts every one that ended.
    subagents: dict[str, Subagent] = field(default_factory=dict)
    agents_ran: int = 0
    #: What each Agent call that has not started its subagent yet asked
    #: for, oldest first. `SubagentStart` carries no description, and the
    #: subagents start in the order of the calls.
    agent_asks: list[str] = field(default_factory=list)
    git: GitFacts = field(default_factory=GitFacts)
    status: Status = field(default_factory=Status)

    #: A name the reader gave this session on the page. It wins over the one
    #: Claude Code sent, which is the name the session started with.
    mine: str = ""
    #: The `attention_since` the reader snoozed this session at, or 0: see
    #: `snoozed`.
    snoozed_at: float = 0.0
    #: When its last turn ended: a `Stop`, or a `StopFailure` (#373).
    ended_at: float = 0.0
    #: What the agent said last, as the `Stop` hook hands it over in
    #: `last_assistant_message` (measured on 2.1.288,
    #: `tests/fixtures/stop_answer.jsonl`): for the "All unreads" feed
    #: (#376). Not on the row, which goes out on every change: the page asks
    #: for it (`Serving.last`) when the feed opens.
    last_answer: str = ""
    #: The moment the reader asked to be reminded of it, or 0 (#375). The
    #: page decides when that has come, by its own clock: a row must not
    #: change by itself, so "due" is never a field.
    remind_at: float = 0.0
    #: When the reader last had it on screen (`Store.see`), or -1 when they
    #: marked it unread. See `unread`.
    seen_at: float = 0.0

    @property
    def unread(self) -> bool:
        """A turn ended since the reader last had this session on screen,
        or they marked it unread: "I looked, but I am not done with it"
        (#373). Not a state: the session is ready, or waits, or works, as it
        was, and this is a mark on it, as a snooze is."""
        return self.seen_at < 0 or self.ended_at > self.seen_at

    @property
    def label(self) -> str:
        """What to call this session: its name, and where it is standing.

        Claude Code titles a session from its first prompt, so most sessions
        have a name whether or not anyone ran `/rename`. The name alone reads
        well but loses the worktree, which is the thing you need when several
        agents are running, so both are shown. A session with no name is just
        its place.
        """
        place = self.place
        name = self.title
        if not name:
            return place
        return f"{clip(name, 40)} · {place}"

    @property
    def place(self) -> str:
        """Where this session is, in two levels, and it does not move.

        `home` and not `cwd`: see the field. One spelling, because the row,
        the label and the list's tiebreaker all ask the same question and a
        second spelling is how one of them starts answering it differently.
        """
        return path_label(self.home or self.cwd, self.git.repo)

    @property
    def snoozed(self) -> bool:
        """Whether the reader said "it waits, but not now" (#355). It holds
        while the session still waits on what it waited on then: the moment
        that wait began is the one it was snoozed at. An answer, a turn that
        ends, a new question -- any change -- ends it, so there is no timer
        to set and no setting for one.

        Not `settled`: a second question with no turn between leaves the
        session in the one state, so `settled` did not move and the snooze
        held over a question the reader never saw. `attention_since` moves
        with every new question, and not with a late `Notification` about
        the same wait."""
        return (self.state == "needs_you" and self.snoozed_at > 0
                and self.snoozed_at == self.attention_since)

    @property
    def title(self) -> str:
        """The session's name, in Claude Code's own order (#351): the one the
        reader gave on the page while it is the newer one (`Store.page_name`),
        then Claude Code's, then the first prompt. "" when there is none, and
        the row shows its place.

        Claude Code's is the status line's `session_name`, which is
        `customTitle ?? aiTitle` -- what `/rename` set, else the title it
        wrote itself from the start of the session -- read from 2.1.288,
        where the name it shows is `agentName || customTitle || aiTitle ||
        summary || first prompt || id`. `/rename` writes `agentName` as well,
        with the same name, so the two differ only for a named agent, which
        has no status line of its own here. Before the first title, Claude
        Code shows the first prompt, and so does this.
        """
        return self.mine or self.status.name or self.first_prompt

    @property
    def dialog(self) -> dict[str, Any] | None:
        """The permission dialog on screen: the permission, while the row is
        amber. One spelling, because the row, the verbs that type and the
        watch for a No given in the terminal all ask it, and five copies of
        the test were how the page and the daemon came to disagree (#287)."""
        return self.permission if self.state == "needs_you" else None

    @property
    def since(self) -> float:
        """The moment a row's age counts from: the wait, or the last event."""
        return self.attention_since if self.state == "needs_you" else self.last_ts

    @property
    def settled(self) -> float:
        """The moment this session last became what it is. The list's order.

        Not `since`, which for a working session is the last event and so
        moves every few seconds: two busy agents would swap places while you
        read them. This one moves when a turn begins, ends, or stops on a
        question -- the same moments the row changes band, so the list moves
        once instead of twice.
        """
        return self.state_since or self.last_ts


def path_label(cwd: str, repo: str = "") -> str:
    """`repo/dirname` for a worktree, plain `dirname` when both are the same."""
    if not cwd:
        return "?"
    name = os.path.basename(cwd.rstrip("/")) or cwd
    if repo and repo != name:
        return f"{repo}/{name}"
    return name


#: What a one-line summary of a command hides, and keeps the name of. The
#: row's last line is a command as the agent ran it, and a screen is shared,
#: screenshotted and read over a shoulder: `curl -u me:token` stood on the
#: row whole. Each pattern keeps the part that says what was there (group
#: 1) and hides the rest. It catches the shapes it knows, and no more: a
#: secret in a shape not listed here still shows.
#:
#: **A star before a part that can fail tries every length it can take.**
#: `[\w.-]*token[\w.-]*=` tried every split of a long word: 1,600
#: characters of `a.token.` took a second, 8,000 two minutes, on the one
#: thread that folds every event, and again on every start, because the log
#: is never thrown away. A scheme's `[a-z0-9+.-]*` before `://` took 1.3 s
#: over 20 KB of `a.`. So those stars have a bound, and `clip_hidden` gives
#: these patterns only the part of a text a summary can show.
SECRET_SHAPES = [
    # A user, and a password, in a URL: `https://me:token@host`.
    (re.compile(r"(?i)\b([a-z][a-z0-9+.-]{0,31}://)[^/\s@\"']+@"), r"\1***@"),
    # curl's and wget's user: only with a colon in it, so `sort -u file` and
    # `git add -u` are left as they are.
    (re.compile(r"(\s(?:-u|--user|--proxy-user)(?:\s+|=)[\"']?)[^\s\"':]+:[^\s\"']+"),
     r"\1***"),
    # A header that is a credential, whatever it holds.
    (re.compile(r"(?i)\b((?:proxy-)?authorization|cookie|x-api-key|api-key|"
                r"x-auth-token|private-token)(\s*:\s*)[^\"'\n]+"), r"\1\2***"),
    # Not `token` as a word: `grep -rn token include/` is a search.
    (re.compile(r"(?i)\b(bearer|basic)(\s+)[A-Za-z0-9._~+/=-]{8,}"), r"\1\2***"),
    # `TOKEN=…`, `?api_key=…`, `--password=…`: a name that says secret. A
    # quoted value may end at the end of the text: `clip_hidden` can cut
    # inside the quotes, and a value with no closing quote then matched
    # nothing and stood on the row (#254). A quote that is not closed is
    # hidden to the end, cut or not.
    (re.compile(r"(?i)\b([\w.-]{0,64}(?:token|secret|passw(?:or)?d|pwd|api[_-]?key|"
                r"access[_-]?key|auth)[\w.-]{0,64}\s*=\s*)"
                r"(\"[^\"]*(?:\"|\Z)|'[^']*(?:'|\Z)|[^\s&\"']+)"),
     r"\1***", "="),
    (re.compile(r"(?i)(--?(?:password|passwd|token|secret|api-?key)\s+)(\S+)"), r"\1***"),
    # Tokens that say what they are by their shape alone.
    (re.compile(r"\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}"
                r"|\bsk-[A-Za-z0-9_-]{20,}|\bxox[abprs]-[A-Za-z0-9-]{10,}"
                r"|\bAKIA[0-9A-Z]{16}\b|\bglpat-[A-Za-z0-9_-]{20,}"), "***"),
]


def hide_secrets(text: str) -> str:
    """A command with the credentials in it hidden, for a one-line summary.

    A shape may name a character it cannot match without, and is skipped
    when the text has none. The `TOKEN=` shape tries a keyword at each of
    64 places after every word boundary: bounded, but 20 KB of `a.` still
    cost it 0.21 s of CPU on a CI runner, and a test with a budget of
    0.2 s failed on it. `"=" in text` runs in C and says the same no.
    """
    for shape, keep, *needs in SECRET_SHAPES:
        if needs and needs[0] not in text:
            continue
        text = shape.sub(keep, text)
    return text


#: How far past the cut a summary still looks for a secret, in the
#: characters `clip` keeps. A URL's `@` or a name's `=` can stand after the
#: cut, and the part before it on the row; a JSON Web Token as a URL's
#: password is several hundred characters.
SECRET_REACH = 1000


def clip_hidden(text: str, width: int) -> str:
    """`clip`, with the secrets hidden first, in only what it can show.

    Hidden before the cut: a secret cut in half no longer looks like one,
    and its first half would stand on the row. But only in the first
    `width` + `SECRET_REACH` characters `clip` would keep: the patterns
    cost time in the length of the text, a command can be a heredoc of a
    megabyte, and nothing after that can reach the row. A text shorter
    than that is hidden whole, exactly as before.
    """
    limit = width + SECRET_REACH
    kept = 0
    for word in re.finditer(r"\S+", text):
        if kept + word.end() - word.start() >= limit:
            text = text[: word.start() + limit - kept]
            break
        kept += word.end() - word.start() + 1       # and the one space
    return clip(hide_secrets(text), width)


def plan_of(tool_name: str, tool_input: Any) -> str:
    """The plan an `ExitPlanMode` call asks to start on, or "".

    The tool's own schema takes no plan: the model writes it to a file and
    calls the tool with `{}`. Claude Code then puts the file's text in
    `tool_input.plan`, with `planFilePath`, in the hooks and in the
    transcript alike (measured on 2.1.288, `tests/fixtures/plan_*.jsonl`).
    """
    if tool_name != "ExitPlanMode" or not isinstance(tool_input, dict):
        return ""
    plan = tool_input.get("plan")
    return plan if isinstance(plan, str) and plan.strip() else ""


def tool_target(tool_name: str, tool_input: Any, cwd: str = "") -> str:
    """What a call worked on: the path, the command, or the pattern.

    This is the general question. `tool_summary` is this with the tool's name
    in front, which is why the two cannot disagree.
    """
    data = tool_input if isinstance(tool_input, dict) else {}

    def short_path(value: Any) -> str:
        text = str(value or "")
        base = cwd.rstrip("/")
        return text[len(base) + 1 :] if base and text.startswith(base + "/") else text

    if tool_name in ("Read", "Write", "Edit", "MultiEdit", "NotebookEdit"):
        return short_path(
            data.get("file_path") or data.get("notebook_path") or data.get("path")
        )
    if tool_name == "Bash":
        return clip_hidden(str(data.get("command") or ""), 60)
    if tool_name in ("Grep", "Glob"):
        return clip(str(data.get("pattern") or ""), 60)
    if tool_name == "Task":
        return clip(str(data.get("description") or ""), 60)
    if tool_name == "ExitPlanMode":
        # The plan's first line, its title: the catch-all below made the row
        # and the card read `{"plan": "# Fix the race…`.
        plan = plan_of(tool_name, data)
        first = next((line for line in plan.splitlines() if line.strip()), "")
        return clip(first.lstrip("#").strip(), 60)
    if tool_name == "AskUserQuestion":
        # The headers, which is what the dialog puts over each question. The
        # catch-all below clipped the JSON at 80 characters, so the one row
        # that exists to say what the agent wants read
        # `{"questions": [{"question": "Approve the pla…`.
        asked = data.get("questions")
        if not isinstance(asked, list):
            return ""
        heads = [str(one.get("header") or one.get("question") or "")
                 for one in asked if isinstance(one, dict)]
        return clip(", ".join(one for one in heads if one), 60)
    if not data:
        return ""
    return clip_hidden(json.dumps(data, ensure_ascii=False, default=str), 80)


#: The most of one question, and of one ask, that is kept. A question is
#: written to be read on a terminal, so these are generous; the cap is here
#: because this goes into every row, to every browser, on every push.
ASK_TEXT_MAX = 2000
ASK_MAX = 8

#: Claude Code keeps a preview longer than this without looking at it, and
#: still draws the question beside a box for it.
PREVIEW_UNREAD = 2000


def preview_kind(preview: Any) -> str | None:
    """What Claude Code draws for one option's `preview`, by its own rules
    (`pU` and `b2` in its bundle, 2.1.281).

    - "" -- nothing: the option has no preview, or only blanks;
    - "full" -- the text, in a box beside the options;
    - "withheld" -- the box, with a sentence in place of the text, because
      the text is longer than `PREVIEW_UNREAD`.

    None when the answer hangs on how wide an invisible character is -- an
    escape, a format character, U+FFFD, which it drops. Nothing here can
    measure that the way a terminal does, so it is not guessed.
    """
    import unicodedata      # here, not at the top: the hook never asks
    if preview is None:
        return ""
    if not isinstance(preview, str):
        return None
    # Its length is JavaScript's, which counts an emoji twice.
    if len(preview.encode("utf-16-le", "surrogatepass")) // 2 > PREVIEW_UNREAD:
        return "withheld"
    if not preview.strip():
        return ""
    if (all(ch.isprintable() or ch in "\t\n\r" for ch in preview)
            and any(ch != "\ufffd" and unicodedata.category(ch)[0] not in "CMZ"
                    for ch in preview)):
        return "full"
    return None


def shows_preview(options: list[Any]) -> bool | None:
    """Whether Claude Code draws a single-choice question beside a preview.

    It does when any option carries a preview it draws (`preview_kind`), and
    that question takes other keys: a digit only moves the cursor there, and
    Enter answers. Measured against 2.1.281 in tmux. A screen reader turns
    the layout off, which nothing in the payload says.

    None when one option's preview cannot be told. The keys would be a guess
    then, and the question is left to the terminal.
    """
    kinds = [preview_kind(choice.get("preview") if isinstance(choice, dict)
                          else None) for choice in options]
    if None in kinds:
        return None
    return any(kinds)


def read_ask(event: dict[str, Any]) -> dict[str, Any] | None:
    """The question an agent is waiting on, in the shape the page draws.

    `AskUserQuestion` is a tool, so the whole of it arrives in `tool_input`
    on `PreToolUse` -- every question, every option, every description --
    and again on `PermissionRequest` 90 milliseconds later. The event log
    keeps the payload whole, as it keeps every payload. This is the other
    half of that rule: what goes into a row, and so to every browser on
    every push, is only what is drawn, named field by field. A field we did
    not read cannot reach the page and cannot surprise it.

    None when the event is not an ask, or holds no question anybody could
    answer. The page shows nothing then, which is what it did before.
    """
    if str(event.get("tool_name") or "") != "AskUserQuestion":
        return None
    data = event.get("tool_input")
    asked = data.get("questions") if isinstance(data, dict) else None
    if not isinstance(asked, list):
        return None
    questions: list[dict[str, Any]] = []
    # Whether what is kept is the whole of what was asked. Answering presses
    # keys by position -- the third question's second option -- so a question
    # or an option left out here would move every key after it. When
    # anything was left out, the page shows the question and does not offer
    # to answer it.
    whole = len(asked) <= ASK_MAX
    for one in asked[:ASK_MAX]:
        if not isinstance(one, dict):
            whole = False
            continue
        given = one.get("options") or []
        if not isinstance(given, list):
            whole = False           # a number or an object is no list of options
            continue
        whole = whole and len(given) <= ASK_MAX
        many = bool(one.get("multiSelect"))
        options = []
        for choice in given[:ASK_MAX]:
            if not isinstance(choice, dict):
                whole = False
                continue
            # A multiple-choice question is never drawn beside a preview,
            # so its previews are not sent: the page shows what the dialog
            # shows. The text is not `clip`ped, which folds the lines of a
            # code box into one; a "full" one is short enough already.
            kind = "" if many else preview_kind(choice.get("preview"))
            options.append({
                "label": clip(str(choice.get("label") or ""), ASK_TEXT_MAX),
                "description": clip(str(choice.get("description") or ""),
                                    ASK_TEXT_MAX),
                "preview": choice["preview"] if kind == "full" else "",
                "withheld": kind == "withheld",
            })
        if not options:
            whole = False
            continue        # nothing to pick, so nothing to draw
        preview = False if many else shows_preview(given)
        whole = whole and preview is not None
        questions.append({
            "question": clip(str(one.get("question") or ""), ASK_TEXT_MAX),
            "header": clip(str(one.get("header") or ""), 80),
            "many": many,
            "preview": bool(preview),
            "options": options,
        })
    if not questions:
        return None
    # `PreToolUse` carries this and `PermissionRequest` does not, which is why
    # the ask is read from the first of the two: it is what says, exactly,
    # that this question and not another one has been answered.
    return {"id": str(event.get("tool_use_id") or ""), "questions": questions,
            "answerable": whole}


def ask_keys(ask: dict[str, Any], picks: Any) -> tuple[list[str], str]:
    """The keys that answer `ask` with `picks`, or why they cannot.

    `picks` is one list of option numbers per question, counted from one, as
    the page sends them. The keys are what Claude Code's own dialog takes,
    measured against 2.1.281 in tmux:

    - a single-choice question takes its digit, and the digit alone answers
      it and moves on -- an Enter after it lands on the next question;
    - a single-choice question drawn beside a preview (`shows_preview`)
      takes its digit, which only moves the cursor there, and then Enter,
      which answers it and moves on;
    - a multiple-choice question takes one digit per option, each ticking
      that option, and then Tab, which moves on;
    - after the last question stands a review with "Submit answers" under
      the cursor, and Enter sends. One single-choice question has no
      review: its digit is the whole answer, and an Enter there would land
      on the agent's prompt.

    The page draws the same keys before they are pressed (`askKeys`), and
    `test_the_page_says_the_keys_the_daemon_presses` holds the two together.
    """
    questions = ask.get("questions") or []
    if not ask.get("answerable") or not questions:
        return [], "answer this one in the terminal"
    if not isinstance(picks, list) or len(picks) != len(questions):
        return [], "every question needs an answer"
    keys: list[str] = []
    for one, chosen in zip(questions, picks):
        if (not isinstance(chosen, list) or not chosen
                or not all(type(number) is int for number in chosen)
                or len(set(chosen)) != len(chosen)):
            return [], "every question needs an answer"
        # A digit is the only way to an option, so there are nine at most.
        if not all(1 <= number <= min(len(one["options"]), 9)
                   for number in chosen):
            return [], "that is not one of the options"
        if one.get("many"):
            keys += [str(number) for number in sorted(chosen)] + ["Tab"]
        elif len(chosen) == 1:
            keys.append(str(chosen[0]))
            if one.get("preview"):
                keys.append("Enter")
        else:
            return [], "that question takes one answer"
    if len(questions) > 1 or questions[0].get("many"):
        keys.append("Enter")
    return keys, ""


def tool_summary(tool_name: str, tool_input: Any, cwd: str = "") -> str:
    """One short line for a tool call: the tool, then what it worked on."""
    return f"{tool_name or 'tool'} {tool_target(tool_name, tool_input, cwd)}".strip()


def clip(text: str, width: int) -> str:
    """Cut text to width and mark the cut."""
    text = " ".join(text.split())
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


class Store:
    """Every session, and the rows the page shows. The one piece of state.

    The daemon keeps one and a single thread writes it; readers take `rows`,
    which is replaced whole and never edited in place, so they need no lock and
    can never see half of an update.
    """

    def __init__(self) -> None:
        self.sessions: dict[str, Session] = {}
        self.follower = EventFollower()
        self.rows: list[dict[str, Any]] = []
        self.git_read: dict[str, float] = {}
        self.git_wanted: set[str] = set()
        #: The directories whose git facts raised, logged once each.
        self.git_raised: set[str] = set()
        self.status_seen: dict[str, float] = {}
        self.liveness_checked = 0.0
        #: Where the log's clock stood at the last look for quiet sessions.
        self.forgot_at = 0.0
        import threading

        # The names the reader gave. Written by whichever thread took the
        # rename and read by the one that folds, so it is replaced whole
        # rather than edited — the same trick `rows` plays, for the same
        # reason: a reader never sees half a change.
        #
        # A writer does need the lock, though. Two `POST /name` requests run
        # at once in one process, and both built the new map from the same
        # snapshot: one name was lost, and memory and the file disagreed
        # about which, so a restart silently swapped them.
        self.names: dict[str, str] = read_names()
        #: For a name the page typed as `/rename`: Claude Code's name just
        #: before it. A name not in here is the page's alone. See
        #: `page_name`. Replaced whole with `names`, under `naming`.
        self.over: dict[str, str] = read_names_over()
        self.naming = threading.Lock()
        #: The snoozes, by session: the moment each was snoozed at (#355).
        #: Replaced whole under `naming`, as the names are, and for the same
        #: reason: two POSTs at once built from one snapshot lose one.
        self.snoozes: dict[str, float] = read_snoozed()
        #: When the reader last had each session on screen, and the floor
        #: for a session not in it (#373). Replaced whole under `naming`,
        #: as the snoozes are.
        self.seen_floor, self.seen = read_seen()
        #: The reminders, by session (#375). Replaced whole under `naming`.
        self.reminders: dict[str, float] = read_reminders()
        #: The turns saved for later, newest first (#377). Replaced whole
        #: under `naming`. Kept for a session that has gone from the list
        #: too: a saved turn is what the reader wanted to keep.
        self.saved: list[dict[str, Any]] = read_saved()

    def get(self, session_id: str) -> Session:
        session = self.sessions.get(session_id)
        if session is None:
            session = Session(session_id=session_id)
            self.sessions[session_id] = session
        return session

    def apply(self, event: dict[str, Any]) -> Session | None:
        """Fold one event into its session. Returns the session it changed."""
        session_id = str(event.get("session_id") or "")
        if not session_id:
            return None
        session = self.get(session_id)
        name = str(event.get("hook_event_name") or "")
        ts = to_float(event.get("ts"))

        # Every event is folded, in the order of the log, and none is dropped
        # for its time. The follower reads each line once, oldest first
        # (`EventFollower.new_lines`), so there is no repeat to skip. This
        # used to drop an event older than its session had seen, for an
        # archive read again, and it dropped real ones: two hooks of one
        # session race for the lock, and a log written before `append_event`
        # stamped under it holds lines out of `ts` order -- a lost
        # `PermissionRequest` is a row that never goes amber. And a clock
        # stepped back by NTP or a VM resume dropped every event of every
        # session until real time caught up.
        if ts > session.last_ts:
            session.last_ts = ts
        if ts and not session.started_at:
            session.started_at = ts
        for key in ("cwd", "transcript_path"):
            value = event.get(key)
            if value:
                setattr(session, key, str(value))
        # A session starts once, and every event after that carries wherever
        # the agent has walked to since. `SessionStart` is the one event that
        # means "this is where I am starting", and a resume really does start
        # a session in another directory, so it is the one that may move this.
        # **Not a compaction's**: an auto compaction sends `SessionStart`
        # (`source=compact`) in the middle of a turn, with the directory the
        # agent has walked to, and the row renamed itself from `richpalm` to
        # `src` while the agent worked.
        starts = name == "SessionStart" and event.get("source") != "compact"
        if session.cwd and (not session.home or starts):
            session.home = session.cwd
        # A hook writes both keys on every event, and an empty one is news:
        # it says "not in tmux" or "no process found" *now*. A session that
        # ran in pane %5, ended, and was resumed in a plain terminal kept %5
        # when only a pane that was there counted -- and the page typed into
        # whatever %5 held by then, a shell or another agent. A kept pid made
        # `mark_dead` bury the resumed session as killed. The daemon's own
        # records (`Declined`) carry neither key, and change neither.
        if "pane" in event:
            pane = str(event.get("pane") or "")
            session.pane = pane if PANE_PATTERN.match(pane) else ""
        if "pid" in event:
            session.pid = to_int(event.get("pid"))
        # The agent that ran this one, by its process (#422). Every event
        # that carries the key decides: a `claude -p` resumed later at a
        # terminal is nobody's child, and its events say 0 -- kept, it was
        # hidden under its old parent while it waited for the reader. A pid
        # is looked up once: a Remote Control worker's is `claude rc`'s,
        # which has no session, and every event of it scanned them all.
        if "started_by" in event:
            by = to_int(event.get("started_by"))
            if by <= 0:
                session.started_by, session.started_pid = "", 0
            elif by != session.started_pid:
                session.started_pid = by
                session.started_by = self.parent_of(session, by)
        handler = _HANDLERS.get(name)
        was = session.state
        if handler is not None:
            handler(session, event, ts)
        elif name:
            session.last_event = name
        # After the handler: a subagent's tool call is summed up there once.
        note_subagent(session, event, name, ts)
        # Only a change. Every handler assigns a state whether or not it is a
        # new one -- `_on_pre_tool` writes "working" on every tool call -- and
        # moving this each time would put the list back to sorting by the last
        # event, which is what it must not do.
        #
        # And once, for a session nothing has stamped yet: `SessionStart` is
        # done to done, so `settled` fell back to the last event, and an idle
        # notification moved a row that had not changed at all.
        if session.state != was or not session.state_since:
            session.state_since = ts or session.last_ts

        if session.cwd and touched_the_tree(name, event):
            self.git_wanted.add(session.cwd)
        if name in ("SessionStart", "SessionEnd"):
            self.link_clear(session)
        return session

    def parent_of(self, child: Session, pid: int) -> str:
        """The session whose agent is process `pid`, which ran `child` from
        its Bash tool (#422), or "".

        Nothing in a `claude -p`'s payload names the agent that ran it: its
        `CLAUDE_CODE_SESSION_ID` and `CLAUDE_PID` are its own, measured on
        2.1.289. The process tree does (`claude_from`, in the hook): above
        it stand the tool's shell and then that agent. A pid is no identity
        on its own -- the numbers come round again, and a `/clear` keeps
        its process -- so it is the session of that pid still running, the
        last heard from. A child's child goes under the same row: the page
        draws children as lines, and a line has none of its own.
        """
        best: Session | None = None
        for other in self.sessions.values():
            if other is child or other.pid != pid or other.state in GONE_STATES:
                continue
            if best is None or other.last_ts > best.last_ts:
                best = other
        if best is None:
            return ""
        return best.started_by or best.session_id

    def link_clear(self, session: Session) -> None:
        """Join the session a `/clear` ended to the one it started.

        Claude Code ends the old session (`reason: clear`) and starts a new
        one (`source: clear`) with a new id, a tenth of a second apart,
        measured on 2.1.282. Nothing in either event names the other, so they
        are matched by what they share: the Claude process, and the pane
        where there is no pid (macOS). The two hooks are separate processes,
        so either event may be folded first, and this is asked on both.

        The reader's name for the session goes with it: they named the
        conversation in that pane, not an id Claude Code swapped under them.
        Moved, not copied, so the old row in History falls back to where it
        was. On a restart the log folds again and finds the name already
        moved, so it moves nothing twice.
        """
        if session.end_reason == "clear" and not session.cleared_into:
            old, new = session, self._cleared_partner(session, "new")
        elif session.start_source == "clear" and not session.cleared_from:
            old, new = self._cleared_partner(session, "old"), session
        else:
            return
        if old is None or new is None:
            return
        old.cleared_into = new.session_id
        new.cleared_from = old.session_id
        with self.naming:
            if old.session_id not in self.names or new.session_id in self.names:
                return
            names, over = dict(self.names), dict(self.over)
            names[new.session_id] = names.pop(old.session_id)
            # The new session has no `/rename` of its own: Claude Code does
            # not carry it over. So the name is the page's alone there.
            over.pop(old.session_id, None)
            over.pop(new.session_id, None)
            write_names(names, over)
            self.names, self.over = names, over

    def _cleared_partner(self, session: Session, want: str) -> Session | None:
        """The other half of a `/clear`: same process or pane, moments apart."""
        best = None
        for other in self.sessions.values():
            if other is session:
                continue
            if want == "new":
                fits = other.start_source == "clear" and not other.cleared_from
            else:
                fits = other.end_reason == "clear" and not other.cleared_into
            same = (session.pid and other.pid == session.pid) or (
                not session.pid and session.pane and other.pane == session.pane)
            if not (fits and same and abs(other.last_ts - session.last_ts) <= CLEAR_GAP):
                continue
            if best is None or other.last_ts > best.last_ts:
                best = other
        return best

    def fold(self, events: Iterable[dict[str, Any]]) -> None:
        """Fold events in, forgetting sessions a week quiet as the log goes by.

        The log is never thrown away, so the first read is every session there
        ever was. `visible()` forgets the quiet ones, but only after the fold:
        measured on a year-shaped log, 1,873 sessions at about 80 KB each sat
        in memory until then, and the number only grows. So the fold looks as
        it goes -- by the time the log has reached, never the clock, because
        `visible()` is the one that knows what now is. A session is judged by
        its last event and never its first, so one that started a year ago
        and is still going keeps where it started.

        The log's clock is whatever the machine said when a hook ran, so it is
        never taken past the real one: an event stamped a year ahead would
        otherwise forget every session there is, on every start. The fold
        never forgets more than `visible()` would.
        """
        for event in events:
            # One event that raises costs itself and nothing else. The
            # follower has already counted the whole piece of the log as
            # read, so an exception leaving here threw away every event after
            # it in that piece -- up to a megabyte of sessions, for good, and
            # again on every start.
            try:
                session = self.apply(event)
            except Exception as error:
                log(f"an event could not be folded: {error!r}")
                continue
            if session is not None and session.last_ts - self.forgot_at > FORGET_EVERY:
                self.forgot_at = session.last_ts
                self.forget_quiet(min(session.last_ts, time.time()))

    def follow(self) -> None:
        """Fold whatever has been appended since the last look."""
        self.fold(self.follower.new_events())

    def visible(self, now: float) -> list[Session]:
        """The sessions worth showing. A session too old to show is forgotten,
        not merely hidden: the daemon runs for days and everything hung off a
        session id, transcript readers included, would be kept with it."""
        self.forget_quiet(now)
        return list(self.sessions.values())

    def forget_quiet(self, now: float) -> None:
        """Forget every session that has said nothing for `SESSION_MAX_AGE`."""
        for session_id, session in list(self.sessions.items()):
            if now - session.last_ts > SESSION_MAX_AGE:
                del self.sessions[session_id]

    def refresh(
        self, now: float | None = None, alive: Callable[[int], bool] | None = None
    ) -> bool:
        """Bring everything up to date and rebuild the rows.

        Returns True when the rows changed, which is also the daemon's answer
        to "is there anything to tell the browsers about?".
        """
        moment = now if now is not None else time.time()
        self.follow()
        sessions = self.settle(moment, alive)
        self.reload_git(sessions, moment)
        rows = [row(session) for session in sort_sessions(sessions)]
        changed = rows != self.rows
        self.rows = rows
        return changed

    def settle(
        self, moment: float, alive: Callable[[int], bool] | None = None
    ) -> list[Session]:
        """The sessions worth showing, with their cheap facts brought up to date.

        `build_sessions` calls this too, so "which sessions are shown, and how
        fresh they are" is written down once. A new Store has never checked
        liveness, so the first call always does.
        """
        sessions = self.visible(moment)
        if moment - self.liveness_checked >= LIVENESS_INTERVAL:
            self.liveness_checked = moment
            for session in sessions:
                mark_dead(session, alive, moment)
        for session in sessions:
            self.reload_status(session)
            session.mine = self.page_name(session)
            session.snoozed_at = self.snoozes.get(session.session_id, 0.0)
            session.seen_at = self.seen.get(session.session_id, self.seen_floor)
            session.remind_at = self.reminders.get(session.session_id, 0.0)
        return sessions

    def page_name(self, session: Session) -> str:
        """The name the reader gave this session on the page, while it is
        the one to show, else "" (#351). It reads and never writes:
        `settle` runs it, and so do `ls` and `wait` in processes of their
        own, whose copy of the names is not the daemon's.

        A name the page typed as `/rename` is shown only until Claude
        Code's name moves from what it was just before (`over`): then the
        status line carries ours, or a later `/rename` from the terminal,
        and either is the name. Until then it bridges the wait, which is
        long: at an idle prompt Claude Code does not run the status line
        again after a `/rename`, only at the next turn (measured, 2.1.288).

        A name nothing could be typed for -- no tmux, the session over, a
        dialog up -- is the page's alone, and it stands until the reader
        changes it. "Last wins" against a `/rename` in the terminal was
        tried and cannot be told: the status line says what the name is,
        not when it was set, and with the stale status above a rename made
        before the page's looked like one made after it.
        """
        sid = session.session_id
        name = self.names.get(sid, "")
        if not name or sid not in self.over:
            return name
        return name if session.status.name == self.over[sid] else ""

    def reload_git(self, sessions: Sequence[Session], moment: float) -> None:
        """Read git for the directories that asked, and for any we have never
        read. Both are held to one run per directory per GIT_MIN_INTERVAL,
        because git status on a large worktree is not cheap."""
        # Only for a session that is shown. Every tree-touching event puts its
        # directory on `git_wanted`, and after a fold of the whole history the
        # first refresh ran git on every worktree touched in a year, deleted
        # ones included. A directory nobody shows is dropped from the list.
        shown = {s.cwd for s in sessions if s.cwd}
        never_read = {d for d in shown if d not in self.git_read}
        asked = (self.git_wanted & shown) | never_read
        ready = {
            directory
            for directory in asked
            if moment - self.git_read.get(directory, 0.0) >= GIT_MIN_INTERVAL
        }
        # Keep the ones still inside the cool-down. Clearing them all dropped
        # the request instead of deferring it, so a write that landed just
        # after a git run left the row stale for good.
        self.git_wanted = asked - ready
        wanted = sorted(ready)
        if not wanted:
            return
        facts = git_facts_many(wanted)
        # The cool-down applies either way, so a worktree whose `status`
        # always passes its timeout is not asked every tick. But a failure is
        # neither written over what we knew nor left standing as the answer:
        # it goes back on the list, and is asked again when the cool-down is
        # up. It used to be recorded as read and assigned over the good facts,
        # so an idle session kept "no branch, clean" until a tool call.
        self.git_read.update(dict.fromkeys(facts, moment))
        self.git_wanted |= {
            directory for directory, one in facts.items() if one.failed}
        for directory, one in facts.items():
            if one.raised and directory not in self.git_raised:
                self.git_raised.add(directory)
                log(f"git facts raised for {directory}: {one.raised}")
        for session in sessions:
            one = facts.get(session.cwd)
            if one is not None and not one.failed:
                session.git = one

    def snooze(self, session_id: str, on: bool) -> bool:
        """Snooze a session that needs you, or wake it. Returns whether it is
        snoozed now. A snooze that no longer holds -- its session moved on --
        is dropped from the file on the next write, so it does not grow."""
        session = self.sessions.get(session_id)
        with self.naming:
            snoozes = {key: at for key, at in self.snoozes.items()
                       if (one := self.sessions.get(key)) is not None
                       and one.snoozed_at == at and one.snoozed}
            if on and session is not None and session.state == "needs_you":
                snoozes[session_id] = session.attention_since
            else:
                snoozes.pop(session_id, None)
            write_snoozed(snoozes)
            self.snoozes = snoozes
        if session is not None:
            session.snoozed_at = self.snoozes.get(session_id, 0.0)
        return session is not None and session.snoozed

    def save(self, entry: dict[str, Any], on: bool) -> list[dict[str, Any]]:
        """Save a turn, or take it off the list (#377). A turn is the same
        turn when its session and its moment are: `seq` is a place in one
        reading of the transcript, and a resumed session counts again."""
        with self.naming:
            saved = [one for one in self.saved
                     if (one["id"], one["ts"]) != (entry["id"], entry["ts"])]
            if on:
                saved.insert(0, entry)
            saved = saved[:SAVED_MAX]
            write_saved(saved)
            self.saved = saved
        return self.saved

    def remind(self, session_id: str, at: float) -> float:
        """Remind the reader of this session at `at`, or forget its
        reminder when `at` is 0 (#375). Returns the moment kept. A session
        no longer known is dropped from the file on the write."""
        session = self.sessions.get(session_id)
        with self.naming:
            reminders = {key: when for key, when in self.reminders.items()
                         if key in self.sessions}
            if session is not None and at > 0:
                reminders[session_id] = at
            else:
                reminders.pop(session_id, None)
            write_reminders(reminders)
            self.reminders = reminders
        if session is None:
            return 0.0
        session.remind_at = self.reminders.get(session_id, 0.0)
        return session.remind_at

    def see(self, session_id: str, read: bool) -> bool:
        """The reader had this session on screen, or marked it unread
        (#373). Returns whether it is unread now. A session no longer known
        is dropped from the file on the write, so it does not grow.

        Seen at now, or at the turn's end when that is later: a clock the
        hook read a moment ahead of this one must not leave the turn the
        reader is looking at unread."""
        session = self.sessions.get(session_id)
        with self.naming:
            seen = {key: at for key, at in self.seen.items() if key in self.sessions}
            if session is not None:
                seen[session_id] = (max(time.time(), session.ended_at)
                                    if read else -1.0)
            write_seen(self.seen_floor, seen)
            self.seen = seen
        if session is None:
            return False
        session.seen_at = self.seen.get(session_id, self.seen_floor)
        return session.unread

    def rename(self, session_id: str, name: str,
               over: str | None = None) -> str:
        """Give a session a name, or take the name away when it is empty.
        `over` is Claude Code's name just before the page typed this one as
        `/rename`; None for a name that is the page's alone (`page_name`).

        Returns what the name now is. The map is replaced rather than edited
        so that the thread folding events never reads a half-written one.
        A typed name Claude Code has taken since is dropped from the file
        here, the one writer, so the file does not keep what nobody shows.
        """
        clean = clean_name(name)
        session = self.sessions.get(session_id)
        with self.naming:
            names, kept = dict(self.names), dict(self.over)
            for key, was in self.over.items():
                one = self.sessions.get(key)
                if one is not None and one.status.name != was:
                    names.pop(key, None)
                    kept.pop(key, None)
            kept.pop(session_id, None)
            if clean:
                names[session_id] = clean
                if over is not None:
                    kept[session_id] = over
            else:
                names.pop(session_id, None)
            write_names(names, kept)
            self.names, self.over = names, kept
        if session is not None:
            session.mine = clean
        return clean

    def reload_status(self, session: Session) -> None:
        """Read the status file again, but only when it has been written."""
        try:
            mtime = status_path(session.session_id).stat().st_mtime
        except OSError:
            return
        if self.status_seen.get(session.session_id) == mtime:
            return
        self.status_seen[session.session_id] = mtime
        session.status = read_status(session.session_id)


def touched_the_tree(event_name: str, event: dict[str, Any]) -> bool:
    """True when this event suggests the working tree may have changed."""
    if event_name in ("Stop", "StopFailure"):
        return True
    if event_name in ("PostToolUse", "PostToolUseFailure"):
        return str(event.get("tool_name") or "") in WRITING_TOOLS
    return False


def cannot_type(session: Session, no: bool = False) -> str:
    """Why nothing may be typed into this session now, or "" when it may.

    The one test `answer`, `decline` and `send` make, after `in_tmux`; the
    page's `whyNotTyped` makes the same one from the row, so a control is
    off where this would refuse it. Each verb wrote it out for itself, and
    a guard added to one was missing from the next (#254, #287).

    A session that is over has moved its pane on to whatever runs there
    now. A dialog that is up has its cursor on "1. Yes", so the Enter after
    a message, or an answer's digit, would approve it; `no` is a No, which
    is meant for that dialog.
    """
    if session.state in GONE_STATES:
        return "this session is over"
    if not no and session.dialog:
        return "a permission dialog is open in the terminal: answer it there first"
    return ""


def typed(text: str) -> str:
    """What `tmux_send` would type of this text: the controls taken out.

    A text with nothing else in it is nothing to send, and the routes ask
    this rather than what arrived: a paste of controls was refused as "tmux
    did not answer", although tmux was never asked.
    """
    return CONTROL_CHARS.sub("", text)


def typing_trouble(text: str, what: str) -> str:
    """Why this text is too long to type, or "". Bytes, because that is what
    everything on the way counts: see `SEND_MAX`. Handed what `typed` keeps,
    because that is what is pasted: a log full of colour codes is smaller
    once they are out."""
    size = len(text.encode("utf-8", "replace"))
    if size > SEND_MAX:
        return (f"{what} is {size} bytes, and the most that can be typed is"
                f" {SEND_MAX}")
    return ""


#: How much of the last prompt the page is sent for an alert that says a
#: session has finished: the start of what was asked, not the whole of it.
PROMPT_SHOWN = 120


def shown_prompt(session: Session) -> str:
    """The last prompt as an alert shows it: cut, and its secrets hidden.

    An alert can stand on a locked screen, so what it says goes through
    `clip_hidden`, as a command on the row does. That costs 170 µs, measured
    on 500 characters: on every row of every tick it was the dearest thing
    in the row, and at the time of the prompt every prompt of a long log
    paid it again when the daemon starts. So it is worked out when a row is
    built and the prompt has changed since, and kept with the prompt it was
    made from.
    """
    made_from, shown = session.prompt_shown
    if made_from != session.last_prompt:
        shown = clip_hidden(session.last_prompt, PROMPT_SHOWN)
        session.prompt_shown = (session.last_prompt, shown)
    return shown


#: What a model id may look like to reach the page: the page types it into
#: a terminal as `/model <id>` (issue 338), so it is held to a shape, as a
#: command's name is (`COMMAND_SHAPE`). "claude-opus-5-5", and a context
#: suffix such as "[1m]".
MODEL_SHAPE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:\[\]-]{0,79}")


def model_id(session: Session) -> str:
    """The full id of the model a session runs, or "" when there is none or
    it is not one. The status line's when it has spoken, since `/model`
    changes it mid-session; else the one it started with."""
    found = session.status.model_id or session.started_model
    return found if MODEL_SHAPE.fullmatch(found) else ""


def resume_command(session: Session) -> str:
    """The command that brings back a session that is over, for the reader
    to copy and run (#352), or "" when there is none to give.

    `claude --resume <id>` finds a session only in the project of the folder
    it is started in -- measured on 2.1.288: in the folder the session
    started in it opened the conversation, anywhere else it asked whether to
    trust that folder and found nothing. So it starts with `cd` to `home`,
    and not to `cwd`, which moves with every `cd` the agent made. A
    transcript under another config folder than `~/.claude` (a second
    account) needs `CLAUDE_CONFIG_DIR` in front: it is the folder above
    `projects/`. Every part came out of an event and the reader will run
    the line, so each is quoted, and a folder or an id with a control
    character in it gets no command at all.

    Starting the agent is a non-goal; handing the reader the command is
    not. Nothing here types into a terminal.
    """
    import shlex

    folder = session.home or session.cwd
    if not folder or not re.fullmatch(r"[\w-]+", session.session_id or ""):
        return ""
    # `CONTROL_CHARS` keeps a tab and a newline, being for text typed into a
    # terminal; in a folder of a one-line command either one is a trap.
    if CONTROL_CHARS.search(folder) or "\n" in folder or "\t" in folder:
        return ""
    prefix = ""
    transcript = Path(session.transcript_path) if session.transcript_path else None
    if transcript is not None and transcript.parent.parent.name == "projects":
        config = transcript.parent.parent.parent
        if config != Path.home() / ".claude" and not re.search(r"[\x00-\x1f]", str(config)) \
                and not CONTROL_CHARS.search(str(config)):
            prefix = f"CLAUDE_CONFIG_DIR={shlex.quote(str(config))} "
    return (f"cd {shlex.quote(folder)} && {prefix}claude --resume"
            f" {shlex.quote(session.session_id)}")


def row(session: Session) -> dict[str, Any]:
    """One session as the page wants it: flat, small, and ready to compare.

    It is built by hand rather than from the dataclass, so that adding a field
    to `Session` never quietly sends something to the browser. Rows are
    compared with `!=` to decide what to push, so everything in here must be a
    plain value, and nothing in here may depend on the current time: a row that
    ages by itself would look changed every second and the page would be sent
    the whole list for ever. `since` is a moment, and the page counts from it.
    """
    facts = session.git
    return {
        "id": session.session_id,
        "label": session.label,
        # A session's name on the row until the reader gives it one, and
        # part of what the find box searches.
        "place": session.place,
        # The worktree's own folder, for the row's second line. The top of
        # the worktree once git has said where that is, so a session started
        # in `src` is still in `richpalm`; until then, where it started.
        "worktree": os.path.basename(
            (facts.root or session.home or session.cwd).rstrip("/")),
        "worktree_path": facts.root or session.home or session.cwd,
        "remote": facts.remote,
        "state": session.state,
        "state_word": STATE_WORDS.get(session.state, session.state),
        "cwd": session.cwd,
        "pane": session.pane,
        "repo": facts.repo,
        "branch": facts.branch,
        "root": facts.root,
        "ahead": facts.ahead,
        "behind": facts.behind,
        "dirty": facts.dirty,
        "touched_files": facts.touched_files,
        "doing": facts.doing,
        "conflicts": facts.conflicts,
        "reason": session.reason,
        # The question the agent is waiting on, so the page can draw it over
        # whatever tab you are reading. It is here and not on a route of its
        # own because it must arrive with the amber, not a fetch later.
        "asking": session.asking,
        # The permission dialog, for the same reason: whole, so the reader
        # can read what they are declining. Only while the row is amber.
        "permission": session.dialog,
        "last_event": session.last_event,
        # What it was last asked, for the alert that says it has finished.
        "prompt": shown_prompt(session),
        "since": round(session.since, 3),
        # For a session that is over, the line that brings it back.
        "resume": resume_command(session) if session.state in GONE_STATES else "",
        "snoozed": session.snoozed,
        # A turn ended since the reader last had it on screen (#373).
        "unread": session.unread,
        # When that was, for the "new" line in the transcript (#374). It
        # moves only when the reader looks, so it never makes a row differ
        # by itself.
        "seen_at": round(session.seen_at, 3),
        # When to bring it back (#375): a moment, and the page decides.
        "remind_at": round(session.remind_at, 3),
        # When its last turn ended, for the order of the feed (#376).
        "ended_at": round(session.ended_at, 3),
        "name": session.title,
        # Whether that name is one the reader set here. The page shows the
        # box with it in, rather than making them type it again to change it.
        "mine": bool(session.mine),
        "model": session.status.model,
        "effort": session.status.effort,
        "model_id": model_id(session),
        "context_pct": session.status.context_pct,
        # What the session has spent. It moves only when a status line
        # lands, so it never makes a row differ by itself -- which is the
        # rule this dict is built by.
        "cost_usd": session.status.cost_usd,
        # The session a `/clear` turned this one into. The page follows it
        # when the link appears while the reader is watching this one.
        "cleared_into": session.cleared_into,
        # The agent that ran this one, and the subagents this one runs
        # (#422): the page draws both as lines under the parent's row.
        "started_by": session.started_by,
        "started_at": round(session.started_at, 3),
        "subagents": [
            {"id": key, "kind": one.kind, "what": one.what, "doing": one.doing,
             "started": round(one.started, 3), "ended": round(one.ended, 3)}
            for key, one in session.subagents.items()
        ],
        "agents_ran": session.agents_ran,
    }


def _clear_attention(session: Session) -> None:
    """Forget that the agent was waiting. Every caller sets the state itself.

    The open question goes with it. A question you can still answer on a row
    that is no longer waiting is the same bug as a stale permission line, and
    this one has buttons on it.
    """
    session.attention_since = 0.0
    session.reason = ""
    session.asked_about = ""
    session.asking = None
    session.permission = None


def _on_session_start(session: Session, event: dict[str, Any], ts: float) -> None:
    # A session that has just started is waiting at its prompt, which is what
    # "ready" means. It used to say "starting" and settle to this after five
    # minutes — a word that was true for a moment and wrong for a day, because
    # `SessionStart` is often the only event a session ever sends.
    #
    # Every handler that sets a state clears the attention with it. This one
    # did not, so a session killed at its permission dialog and then resumed
    # came back reading "ready" with "permission: Bash rm -rf ~" under it, and
    # a wait that had started before the agent died. `source=compact` reaches
    # here mid-session and left the same.
    #
    # **Except that a compaction does not end a turn.** An auto compaction
    # fires this with `source=compact` in the middle of one, and the agent
    # goes on: "done" moved the row to ready, told the page the agent had
    # finished, and put the row under "ready" while the agent worked on.
    # A `/compact` typed at the prompt finds the session ready already.
    source = str(event.get("source") or "")
    working = source == "compact" and session.state == "working"
    _clear_attention(session)
    session.state = "working" if working else "done"
    session.end_reason = ""
    # A resume starts the session again, and a `/clear` after it is a new
    # one: session A, cleared into B and then resumed, kept `cleared_into`
    # B, and `link_clear` joins only a session that has none -- so a second
    # `/clear` joined A to nothing, and the page did not follow it to C.
    if source not in ("clear", "compact"):
        session.cleared_into = ""
    session.start_source = source
    session.started_model = str(event.get("model") or "")
    session.last_event = f"started ({source})" if source else "started"


def _on_prompt(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    session.calls.clear()          # a new turn: see `_on_stop`
    session.state = "working"
    # Cut it here, once. Keeping the whole of a pasted prompt would put it in
    # every row, to be compared every tick and sent to the browser every time.
    # The paste tags come off first, as the transcript takes them off: the
    # hook hands over the prompt as Claude Code wrote it, and a pasted prompt
    # read `prompt: <pasted_content id="3400"> I got...` on the row.
    prompt = unwrap_pastes(str(event.get("prompt") or ""))
    session.last_prompt = clip(prompt, PROMPT_WIDTH)
    session.last_event = f"prompt: {session.last_prompt}"
    if not session.first_prompt and not prompt.lstrip().startswith("/"):
        session.first_prompt = clip(" ".join(typed(prompt).split()), NAME_MAX)


def _on_pre_tool(session: Session, event: dict[str, Any], ts: float) -> None:
    """A call starting, or a result arriving. Both mean the agent is running.

    Whether either answers the open permission question depends on which it
    is, and that is the whole of this:

    **A call starting says the agent moved on**, so the question was answered
    — allowed, or denied, which fires no hook of its own and leaves this as
    the only sign. Nothing new starts while a dialog is up; that is what the
    dialog does.

    **A call finishing says only that that call finished.** Claude Code runs
    two tools at once now and then — measured over 233 calls on a real
    machine, one started while another was still open — and both `PreToolUse`
    events come before the dialog, so the other call can report back while it
    is still on screen. Clearing on that turned the row green while the agent
    sat blocked. That is the one thing this program exists to say, said
    backwards.

    `PermissionRequest` carries no `tool_use_id`, so a result cannot be paired
    to it exactly. It carries `tool_name` and `tool_input`, which is what
    `tool_summary` is made of, and that separates two Bash calls — which is
    what the measured overlap was. Two runs of the *same* command at the same
    moment still cannot be told apart. Nothing in the payload can.
    """
    starting = str(event.get("hook_event_name") or "") == "PreToolUse"
    # A result carries the very input its call did, and the call's summary
    # is kept by its id: made again for every result, hiding the secrets in
    # it was a fifth of a start's fold (#430).
    call = str(event.get("tool_use_id") or "")
    summary = (None if starting or not call else session.calls.get(call)) or tool_summary(
        str(event.get("tool_name") or ""), event.get("tool_input"), session.cwd
    )
    # The ask, and whether its dialog is up yet. Another call of the same
    # batch can start or finish in the ninety milliseconds between the ask's
    # own `PreToolUse` and its `PermissionRequest`; the clear below took the
    # question with it, and the row went amber over no bar to answer it.
    ask = session.asking
    shown = bool(session.asked_about)
    if starting or not session.asked_about or session.asked_about == summary:
        # The state goes with the attention. A row that stays amber because
        # the dialog is still up must not also say it is working.
        _clear_attention(session)
        session.state = "working"
    # What happened is still the latest thing that happened, either way.
    session.last_tool = summary
    session.last_event = session.last_tool
    if starting and call:
        session.calls[call] = summary
        while len(session.calls) > CALLS_HELD:
            session.calls.pop(next(iter(session.calls)))
    elif call:
        session.calls.pop(call, None)
    if starting:
        # After the clear above, or the ask would be wiped by its own call
        # starting. It is None for every tool but this one -- and another
        # call starting before the ask's dialog is up is the same batch, not
        # the agent moving on past it.
        mine = read_ask(event)
        session.asking = mine if mine is not None or shown else ask
    elif ask and str(event.get("tool_use_id") or "") == ask["id"]:
        # This exact question was answered. Not "a call finished": two calls
        # really do overlap, and the other one finishing is not an answer.
        session.asking = None
    else:
        session.asking = ask


def _on_tool_failed(session: Session, event: dict[str, Any], ts: float) -> None:
    """The tool ran and failed, or was interrupted or timed out.

    It does not cover a denied permission. Saying No to the dialog fires no
    hook at all, which was measured against a real session: the log ends at the
    `Notification` and nothing follows it. So wostuast cannot see a denial, and
    a session that was denied keeps the waiting state it already had. That is
    not wrong, because the agent really is waiting for you to say what to do
    instead; only the reason it shows is older than it looks.
    """
    name = str(event.get("tool_name") or "")
    summary = tool_summary(name, event.get("tool_input"), session.cwd) if name else "tool"
    # A call finishing, so the same pairing `_on_pre_tool` does: a failure of
    # the other call is not an answer to the question this one is asking --
    # nor to the ask whose dialog is not up yet, which the clear would take.
    ask = session.asking
    session.calls.pop(str(event.get("tool_use_id") or ""), None)
    if not session.asked_about or session.asked_about == summary:
        _clear_attention(session)
        session.state = "working"
        if ask and str(event.get("tool_use_id") or "") != ask["id"]:
            session.asking = ask
    if event.get("is_interrupt"):
        session.last_event = f"{summary} interrupted"
    else:
        session.last_event = f"{summary} failed"


def _on_permission_request(session: Session, event: dict[str, Any], ts: float) -> None:
    """The permission dialog is on screen. This is the moment you are needed.

    `Notification` says the same thing, but only after you have been idle for
    six seconds, and it is checked on a six second timer, so it arrives up to
    twelve seconds late. For a tool whose first job is answering "who needs
    me?", that is too slow. This event fires as the dialog appears.
    """
    session.asks_first = True
    session.state = "needs_you"
    session.attention_since = ts
    name = str(event.get("tool_name") or "")
    summary = tool_summary(name, event.get("tool_input"), session.cwd) if name else ""
    session.asked_about = summary
    if name == "AskUserQuestion":
        # Not a permission. It is a question with answers written out, and a
        # row saying "permission" for it sent you looking for a dialog that
        # asks something else. The question itself is on the page.
        asked = tool_target(name, event.get("tool_input"), session.cwd)
        session.reason = f"asks: {asked}" if asked else "asks a question"
    else:
        session.reason = f"permission: {summary}" if summary else "permission"
        session.permission = read_permission(event, session.calls, summary, ts)


def read_permission(event: dict[str, Any], calls: dict[str, str], summary: str,
                    ts: float) -> dict[str, Any]:
    """The permission request as the page shows it, for the reader to decline.

    **Every field of the input, whole**: the row said `permission: Bash cmake
    --build build -j` clipped to one line, and a request is judged on all of
    it -- the whole command, the whole of an edit. Past `PERMISSION_SHOWN`
    the fields are withheld and the page points at the pane.

    `key` names this one dialog, so a decline meant for it is refused once
    another has taken its place. `call` is its `tool_use_id`, found among the
    calls started and not finished by the summary `_on_pre_tool` keeps --
    `PermissionRequest` carries none -- and left empty when two open calls
    read the same, because then which one this is cannot be known. Without
    it a decline still presses Escape, but will not type a reason: only the
    call's own result in the transcript proves the dialog has closed.
    """
    data = event.get("tool_input")
    data = data if isinstance(data, dict) else {}
    tool = str(event.get("tool_name") or "")
    # A plan is read in the transcript, drawn as Markdown, whole (#372).
    # Here it was its source in a `pre`, and a plan past `PERMISSION_SHOWN`
    # was not shown at all; the panel points at it instead.
    plan = bool(plan_of(tool, data))
    fields = [] if plan else [
        [str(key), value if isinstance(value, str)
         else json.dumps(value, indent=2, ensure_ascii=False)]
        for key, value in data.items()]
    withheld = sum(len(key) + len(text) for key, text in fields) > PERMISSION_SHOWN
    matches = [one for one, said in calls.items() if said == summary]
    return {"key": f"{ts:.6f}", "tool": tool,
            "call": matches[0] if len(matches) == 1 else "",
            "fields": [] if withheld else fields, "withheld": withheld,
            "plan": plan}


def _on_declined(session: Session, event: dict[str, Any], ts: float) -> None:
    """wostuast's own record, not a hook: a permission was declined, from
    the page or -- `where` is "terminal" -- in the pane itself.

    Saying No fires no hook, so the row stayed amber over an agent already
    back at its prompt. The daemon writes this only once the transcript
    holds the call's result -- the proof that the dialog closed -- and only
    for the dialog it was asked about: another that has come up since keeps
    its row amber.
    """
    shown = session.permission
    if not shown or shown.get("key") != str(event.get("key") or ""):
        return
    session.calls.pop(str(shown.get("call") or ""), None)
    _clear_attention(session)
    session.state = "done"
    session.last_event = ("declined in the terminal" if event.get("where") == "terminal"
                          else "declined from the page")


def _on_notification(session: Session, event: dict[str, Any], ts: float) -> None:
    """What a notification means, and the two it is not allowed to mean.

    An idle prompt is not "needs you". The agent finished its turn and sits at
    its prompt, which `Stop` already said. Nothing here blocks it, so nothing
    you do clears it either, and a row that turned amber on this stayed amber
    for the rest of the day. It keeps the state it has and says why it is
    quiet.

    A permission notification is the same news as `PermissionRequest`, up to
    twelve seconds later. On a session that sends that event the notification
    can only be stale: by now the dialog is either still up, and the row
    already says so, or it was answered while this was on its way, and
    honouring it would raise the alarm again for a question that is gone.
    """
    kind = str(event.get("notification_type") or "")
    message = str(event.get("message") or "")
    if not kind:
        # Older Claude Code versions send no type, so the message is all there
        # is. Recognise the two that mean something and call the rest what
        # they are: anything else used to be taken for a permission prompt,
        # and `auth_success` — "Logged in as …" — turned the row amber with a
        # reason nothing could clear. No tool call and no prompt follows an
        # auth notification, so it sat there until someone typed.
        spoken = message.lower()
        if "waiting for your input" in spoken:
            kind = "idle_prompt"
        elif "needs your permission" in spoken:
            kind = "permission_prompt"
        else:
            kind = "other"
    if kind == "idle_prompt":
        # An open dialog is the better reason, and it outranks this one.
        if session.state != "needs_you":
            session.reason = "waiting for input"
        session.last_event = message or "waiting for input"
        return
    if kind == "permission_prompt" and session.asks_first:
        # Stale: the same news up to twelve seconds late, about a dialog that
        # is either still up — and the row says so — or already answered. Not
        # the state, and not the text either: it used to leave a permission
        # question as the only line under a row reading "ready".
        return
    session.last_event = message or kind
    if kind not in ATTENTION_NOTIFICATIONS:
        return
    if session.state != "needs_you":
        # Already waiting, so this is the same wait. Moving the clock made a
        # row that had waited a minute say it had waited none.
        session.attention_since = ts
    session.state = "needs_you"
    if session.last_tool:
        session.reason = f"permission: {session.last_tool}"
    else:
        session.reason = message or "permission"


def _on_stop(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    # A call declined in the terminal never reports back. Left here, it and
    # a later call reading the same would be two matches, and that call's
    # dialog would get no id. Nothing is open once a turn is over.
    session.calls.clear()
    session.state = "done"
    session.last_event = "stopped"
    session.ended_at = ts
    said = event.get("last_assistant_message")
    session.last_answer = said if isinstance(said, str) else ""


#: What each `error` of a `StopFailure` means, for when Claude Code sends no
#: words of its own. The names are Claude Code's, read off 2.1.285.
STOP_FAILURES = {
    "authentication_failed": "not logged in",
    "oauth_org_not_allowed": "organisation not allowed",
    "account_on_hold": "account on hold",
    "verification_required": "verification needed",
    "billing_error": "billing problem",
    "rate_limit": "usage limit reached",
    "overloaded": "the API is overloaded",
    "invalid_request": "the API refused the request",
    "model_not_found": "model not found",
    "server_error": "the API failed",
    "unknown": "an API error",
    "max_output_tokens": "the reply was too long",
    "cloud_credential_error": "cloud credentials",
}


def _on_stop_failure(session: Session, event: dict[str, Any], ts: float) -> None:
    """A turn an API error ended: a spend limit, a login, an overload.

    Claude Code fires this *instead of* `Stop`, so without it the row read
    "working" over an agent that had stopped, until the next prompt. The
    agent cannot go on until the reader does something -- raises a limit,
    logs in, or says go on -- which is what amber means. The reason is
    Claude Code's own sentence, which it also writes into the transcript:
    `last_assistant_message`, measured on 2.1.285. `error` is the fallback.
    """
    _clear_attention(session)
    session.calls.clear()
    error = str(event.get("error") or "unknown")
    said = str(event.get("last_assistant_message") or event.get("error_details")
               or "")
    words = clip(said.strip().split("\n")[0], 200)
    session.state = "needs_you"
    session.attention_since = ts
    session.reason = "stopped: " + (words or STOP_FAILURES.get(error, error))
    session.last_event = f"stopped by an API error ({error})"
    session.ended_at = ts
    # Its last words are Claude Code's sentence about the error: the turn
    # before's answer, kept, read as this turn's in the feed (#376).
    said = event.get("last_assistant_message")
    session.last_answer = said if isinstance(said, str) else ""


def _on_subagent_start(session: Session, event: dict[str, Any], ts: float) -> None:
    agent = str(event.get("agent_type") or "subagent")
    session.last_event = f"{agent} started"


def _on_subagent_stop(session: Session, event: dict[str, Any], ts: float) -> None:
    agent = str(event.get("agent_type") or "subagent")
    session.last_event = f"{agent} finished"


def note_subagent(session: Session, event: dict[str, Any], name: str, ts: float) -> None:
    """Keep what the Agent tool's subagents are doing, for the lines the
    page draws under the session's row (#422).

    Every event of a subagent carries its `agent_id`, so one that missed
    its `SubagentStart` -- hooks installed before it was one of ours -- is
    found by its first tool call. Its description comes from the Agent call
    that started it: the oldest one still waiting, then the call's result,
    which names the `agentId` when the subagent runs in the background.
    """
    tool = str(event.get("tool_name") or "")
    agent = str(event.get("agent_id") or "")
    if not agent:
        if tool in AGENT_TOOLS and name == "PreToolUse":
            given = event.get("tool_input")
            what = given.get("description") if isinstance(given, dict) else ""
            session.agent_asks = (session.agent_asks
                                  + [clip(str(what or ""), 120)])[-SUBAGENTS_HELD:]
        elif tool in AGENT_TOOLS and name == "PostToolUseFailure":
            # A call that failed started no subagent: its description must
            # not name the next one, and every one after it.
            session.agent_asks = session.agent_asks[1:]
        elif name in ("UserPromptSubmit", "Stop", "StopFailure"):
            # A call declined in its dialog fires no hook at all, so a turn
            # boundary is where what it asked for is let go: its subagent
            # started at once, or never.
            session.agent_asks = []
        elif tool in AGENT_TOOLS and name == "PostToolUse":
            said = event.get("tool_response")
            if isinstance(said, dict) and isinstance(said.get("description"), str):
                one = session.subagents.get(str(said.get("agentId") or ""))
                if one is not None:
                    one.what = clip(said["description"], 120)
        elif name == "SessionEnd":
            end_subagents(session, ts)
        return
    one = session.subagents.get(agent)
    if one is None:
        one = Subagent(started=ts)
        if session.agent_asks:
            one.what, session.agent_asks = session.agent_asks[0], session.agent_asks[1:]
        session.subagents[agent] = one
        while len(session.subagents) > SUBAGENTS_HELD:
            ended = [key for key, held in session.subagents.items() if held.ended]
            del session.subagents[ended[0] if ended else next(iter(session.subagents))]
    one.kind = str(event.get("agent_type") or one.kind)
    if name == "SubagentStop":
        if not one.ended:
            one.ended = ts or session.last_ts
            session.agents_ran += 1
    elif name in ("PreToolUse", "PostToolUse") and tool:
        one.doing = session.last_tool        # `_on_pre_tool` made it
    elif name == "PostToolUseFailure" and tool:
        one.doing = tool_summary(tool, event.get("tool_input"), session.cwd)


def end_subagents(session: Session, moment: float) -> None:
    """A session that is over has no subagent running: one that was gone
    before its `SubagentStop` would otherwise run on the page for ever."""
    for one in session.subagents.values():
        if not one.ended:
            one.ended = moment
            session.agents_ran += 1


def _on_pre_compact(session: Session, event: dict[str, Any], ts: float) -> None:
    trigger = str(event.get("trigger") or "")
    session.last_event = f"context compacted ({trigger})" if trigger else "context compacted"


def _on_session_end(session: Session, event: dict[str, Any], ts: float) -> None:
    _clear_attention(session)
    session.state = "ended"
    session.end_reason = str(event.get("reason") or "")
    session.last_event = f"ended ({session.end_reason})" if session.end_reason else "ended"


_HANDLERS: dict[str, Callable[[Session, dict[str, Any], float], None]] = {
    "SessionStart": _on_session_start,
    "UserPromptSubmit": _on_prompt,
    "PreToolUse": _on_pre_tool,
    "PostToolUse": _on_pre_tool,
    "PostToolUseFailure": _on_tool_failed,
    "PermissionRequest": _on_permission_request,
    "Declined": _on_declined,
    "Notification": _on_notification,
    "Stop": _on_stop,
    "StopFailure": _on_stop_failure,
    "SubagentStart": _on_subagent_start,
    "SubagentStop": _on_subagent_stop,
    "PreCompact": _on_pre_compact,
    "SessionEnd": _on_session_end,
}


def to_float(value: Any) -> float:
    """A number, or nought for anything that is not a finite one.

    `float` takes "nan" and "inf", and `json.loads` makes them out of `NaN`
    and `1e999`. `json.dumps` then writes `NaN` and `Infinity`, which are not
    JSON, and the page's `JSON.parse` threw on every sessions push (#235).
    """
    import math

    try:
        number = float(value)
    except (TypeError, ValueError, OverflowError):
        return 0.0
    return number if math.isfinite(number) else 0.0


def opt_float(value: Any) -> float | None:
    """A number that may be absent. Missing stays missing, it does not become 0."""
    return None if value is None else to_float(value)


def to_int(value: Any) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


#: What the Claude Code process is called. `claude` is the usual name; a
#: development checkout runs under node, so its command line is checked too.
AGENT_NAMES = ("claude", "node", "bun", "deno")


def process_name(pid: int) -> str:
    """The command name of a process. Reads /proc; never runs a subprocess."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def process_args(pid: int) -> str:
    """The command line of a process, with its NUL separators turned to spaces."""
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
            "utf-8", "replace")
    except OSError:
        return ""


def parent_pid(pid: int) -> int:
    """The parent of a process, or 0. The name in /proc/<pid>/stat is wrapped in
    brackets and may hold spaces, so the fields are read after the last one."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return 0
    fields = stat.rpartition(")")[2].split()
    return to_int(fields[1]) if len(fields) > 1 else 0


def looks_like_claude(pid: int) -> bool:
    """Whether this process is Claude Code: by its name, by its command line
    under a runtime, or by where its executable lives.

    Claude Code's installer keeps each version as a file named after it,
    `~/.local/share/claude/versions/2.1.287`, behind the link `claude`. What
    runs through the link is called `claude`. What Claude Code starts from
    its real path -- a Remote Control worker, from `process.execPath` -- is
    called `2.1.287`: `agent_pid` passed over it to `claude rc` above it,
    whose stdin is the pane's terminal, and the worker kept the pane
    (`reads_terminal`). `/proc/<pid>/exe` names the file, whatever the
    process is called; a version replaced by an update reads "… (deleted)",
    which changes the name and not the folder.
    """
    name = process_name(pid)
    if name == "claude":
        return True
    if name in AGENT_NAMES and "claude" in process_args(pid):
        return True
    try:
        folder = Path(os.readlink(f"/proc/{pid}/exe")).parent
    except OSError:
        return False
    return folder.name == "versions" and folder.parent.name == "claude"


def agent_pid() -> int:
    """The Claude Code process that fired this hook, or 0 when we cannot tell.

    Claude Code runs a command hook through a shell, so our own parent is that
    shell and it dies as soon as we do. Taking it for the agent made every
    session show as killed seconds after it started. Walking up finds the
    process that owns the session instead.

    Where there is no /proc, this returns 0 and the session is simply never
    reported as killed. Saying nothing beats saying something wrong.
    """
    return claude_from(os.getppid())


def claude_from(pid: int) -> int:
    """The first Claude Code process from `pid` up, `pid` itself first, or 0.

    `agent_pid` starts at the hook's shell. Started above the agent, it
    finds the agent that ran it (#422): measured on 2.1.289, a `claude -p`
    from the Bash tool stands under the tool's `bash`, and that under the
    agent whose hooks name it as their `pid`.
    """
    for _ in range(12):
        if pid <= 1:
            return 0
        if looks_like_claude(pid):
            return pid
        pid = parent_pid(pid)
    return 0


def reads_terminal(pid: int) -> bool:
    """Whether this agent reads its keys from a terminal: False only when we
    can tell it does not.

    A pane is where keys go, and `TMUX_PANE` is inherited by everything
    started inside it. A session that `claude remote-control` (`claude rc`)
    starts runs `claude --print --sdk-url …` with a pipe for its stdin, and
    takes the pane of the terminal `claude rc` runs in: a send went into
    the rc screen, and was gone. A `claude -p` that an agent runs from its
    Bash tool takes the agent's pane, and a send to it went into the other
    agent's prompt. Measured on 2.1.287: an interactive session's stdin was
    `/dev/pts/1`, a `claude -p`'s a `pipe:[…]`.

    Where nothing can be read -- no pid, no /proc, another user -- the
    answer is yes, as it was before anybody asked: saying nothing beats
    saying something wrong.
    """
    if pid <= 0:
        return True
    try:
        stdin = os.readlink(f"/proc/{pid}/fd/0")
    except OSError:
        return True
    return stdin.startswith(("/dev/pts/", "/dev/tty"))


def pid_alive(pid: int) -> bool:
    """True when that agent is still running.

    A pid on its own is not an identity. The numbers wrap, and a session that
    ended in the morning had its pid taken by something else by the evening, so
    `kill -0` said yes and the row sat there all day saying "done" for an agent
    that was gone. The process has to still look like the one we recorded.

    This only runs for a session that has a pid, and `agent_pid` returns one
    only where it could read /proc — so `looks_like_claude` can be trusted to
    answer here rather than to be silent.
    """
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False          # not ours, so not the agent we recorded
    except OSError:
        return False
    return looks_like_claude(pid)


def mark_dead(
    session: Session, alive: Callable[[int], bool] | None = None,
    now: float | None = None,
) -> None:
    """A session whose process is gone is dead, even without a SessionEnd.

    `alive` defaults to None, not to pid_alive, so that tests can replace the
    module's pid_alive. A default bound at import would not see the change.

    A session with no pid cannot be checked at all, so it is taken for gone
    once it has been quiet for QUIET_MAX. Without that it stayed in the list
    as though it were running until the log forgot it, a week later.
    """
    check = alive or pid_alive
    if session.state == "ended":
        return
    moment = time.time() if now is None else now
    if session.pid:
        if not check(session.pid):
            _bury(session, moment, "process gone")
        return
    if session.last_ts and moment - session.last_ts > QUIET_MAX:
        _bury(session, moment, "no sign of it")


def _bury(session: Session, moment: float, why: str) -> None:
    """Dead, and stamped with when. Nothing reports this state, so it is the
    one place outside `Store.apply` that `state_since` has to move.

    And it clears the attention, like every other change of state. It did
    not, so an agent that died on its question kept the question, with its
    buttons, and the answer's keys went into whatever the pane held next --
    a shell, or a new agent, where `2 1 Enter` submits "21"."""
    if session.state != "dead":
        session.state_since = moment
        _clear_attention(session)
    session.state = "dead"
    end_subagents(session, moment)
    if not session.end_reason:
        session.end_reason = why


def build_sessions(
    events: Sequence[dict[str, Any]] | Iterator[dict[str, Any]] | None = None,
    now: float | None = None,
    alive: Callable[[int], bool] | None = None,
) -> list[Session]:
    """Replay the whole log once, for a command that runs and exits.

    The daemon does not use this: it keeps a Store and folds only what is new.
    Both go through the same Store, so "which sessions are shown, and in what
    order" is written down once.

    Git facts cost a subprocess, so they are left to add_git_facts, which only
    the commands that show them call.
    """
    store = Store()
    store.fold(events if events is not None else read_events())
    moment = now if now is not None else time.time()
    return sort_sessions(store.settle(moment, alive))


def sort_sessions(sessions: list[Session]) -> list[Session]:
    """Newest first, with the ended and the dead last.

    `settled` is the moment a session last became what it is, and it is the
    right number precisely because it is not the last event: sorting a
    working session by its last hook event would have two busy agents
    swapping places every few seconds while you read them. It moves when a
    turn begins, ends, or stops on a question -- which is when the row
    changes band anyway, so the list moves once rather than twice.

    This replaces sorting by worktree. That was chosen when the alternative
    was sorting by *state*, which put every row somewhere new on every tool
    call; a name does not move, so it did not churn. But a name is also not
    what anyone is looking for in a list of twenty: the session you touched
    last is, and it was somewhere in the middle under `a`.

    Sorting on `label` is still wrong, for the reason it always was: the name
    arrives from the status line a second after the session starts, and
    `/rename` changes it later. The worktree is the tiebreaker only.

    A session nobody can talk to any more still sinks to the bottom: it is
    dimmed, it is often the larger half of a long list, and it is never what
    you came to look at.
    """
    return sorted(
        sessions,
        key=lambda s: (
            s.state in GONE_STATES,
            -s.settled,
            s.place.lower(),
            s.session_id,
        ),
    )


# --- transcript: the session's own jsonl, turned into blocks -----------------


@dataclass
class Block:
    """One thing the Transcript tab shows, in the order it happened."""

    seq: int = -1               # its place in the transcript, and its identity
    #: prompt, text, tool, divider, note, shell, plan. A `plan` is an
    #: `ExitPlanMode` call: `text` is the plan, as Markdown. A `note` is a
    #: `user` record the harness wrote -- a task finishing, another session's
    #: message -- so it is shown but never as something the reader typed. A
    #: `shell` is a command the reader ran with `!`: `text` is the command
    #: and `result` what it printed.
    kind: str = "text"
    ts: float = 0.0
    text: str = ""              # prompt and assistant text, as Markdown
    tool: str = ""              # the tool's name
    target: str = ""            # the path, command or pattern it worked on
    added: int = 0              # lines an edit added
    removed: int = 0            # lines an edit removed
    result: str = ""            # the tool's output, shown when expanded
    #: What an edit changed, as hunks in the Diff tab's shape: a `header`
    #: with the file's line numbers at that moment, and `lines` of `kind`
    #: and `text`. `patch_more` counts the lines left out (`PATCH_SHOWN`).
    patch: list[dict[str, Any]] = field(default_factory=list)
    patch_more: int = 0
    failed: bool = False
    tool_use_id: str = ""
    #: Whether this call's result has been read. A result can be empty -- a
    #: `touch` prints nothing -- so `result` cannot say it; this is what a
    #: decline waits on (`Daemon.call_answered`).
    answered: bool = False


#: The tags Claude Code wraps its own `user` records in. A real sample, from
#: a real transcript -- typing `/reload-plugins` arrives as these:
#:
#:     <command-name>/reload-plugins</command-name>
#:     <command-message>reload-plugins</command-message>
#:     <command-args></command-args>
#:     <local-command-stdout>(no content)</local-command-stdout>
#:
#: and a resumed conversation opens with a `<local-command-caveat>`. One thing
#: the reader did, in four records, none of which they typed.
MACHINE_TAG = re.compile(
    r"<(command-name|command-message|command-args|local-command-stdout"
    r"|local-command-caveat|system-reminder)>.*?</\1>", re.S)
#: A command the reader ran with `!` in Claude Code. Measured on 2.1.282:
#: two `user` records, neither `isMeta`, so both were drawn as prompts, tags
#: and all. The first is `<bash-input>git up</bash-input>`, as typed. The
#: second is `<bash-stdout>...</bash-stdout><bash-stderr>...</bash-stderr>`,
#: with `<`, `>` and `&` written as HTML entities and quotes left alone --
#: and stderr, in that run, inside stdout. `tests/fixtures/bash_mode.jsonl`.
BASH_INPUT = re.compile(r"\s*<bash-input>(.*?)</bash-input>\s*", re.S)
BASH_OUTPUT = re.compile(r"\s*<bash-stdout>(.*?)</bash-stdout>\s*"
                         r"(?:<bash-stderr>(.*?)</bash-stderr>\s*)?", re.S)
#: What a slash command answered, written as the record after the command's.
#: Measured on 2.1.283: `/model opus` answers "Set model to `Opus 5.5`...",
#: a `/model` closed without a pick "Kept model as ...", and `/context`
#: draws a grid of symbols in colour codes. A reader who typed the command
#: from the page's send box had no other way to see what it did.
#: `tests/fixtures/local_command.jsonl`.
LOCAL_OUTPUT = re.compile(
    r"\s*<local-command-stdout>(.*?)</local-command-stdout>\s*", re.S)
#: What a command writes for "nothing to say".
NO_OUTPUT = "(no content)"
#: Colour and cursor codes, which a terminal acts on and a page would show as
#: `[38;5;244m`: CSI sequences, OSC sequences, and the two-byte kind.
ESCAPE_CODES = re.compile(
    r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-_]")
COMMAND_NAME = re.compile(r"<command-name>\s*(.*?)\s*</command-name>", re.S)
COMMAND_ARGS = re.compile(r"<command-args>\s*(.*?)\s*</command-args>", re.S)
TASK_NOTE = re.compile(r"^<task-notification>\s*(.*?)\s*</task-notification>$",
                       re.S)

#: Claude Code's own wrapper round a message that arrived while the agent was
#: working -- which is every message this page sends to a busy agent, so it is
#: the shape a reader of this program meets most.
#:
#: A header names it, a footer explains it to the agent, and the words the
#: person typed are in between. Both lines went into the transcript as though
#: they had been typed, so a message sent from here came back wearing a
#: paragraph about how Claude Code queues messages.
#:
#: Read off a real transcript, header and footer verbatim. The footer is
#: matched by its first sentence only: it is the part that names what the
#: wrapper is, and matching all of it would turn a reworded tail into a
#: header on the page again.
QUEUED = re.compile(
    r"\A\s*The user sent a new message while you were working:\s*\n"
    r"(.*?)\n\s*This is how Claude Code surfaces messages the user sends"
    r" mid-turn\b.*\Z", re.S)

#: A `user` record the harness wrote and not the reader. It is shown, because
#: it is real news, but never as a prompt: nobody typed it.
NOTED = ("<task-notification>", "Another Claude session sent a message:")

#: A task notification is a block of fields, measured on 2.1.276 to 2.1.283:
#: `task-id`, `tool-use-id`, `output-file`, `status`, `summary`, and at times
#: `note`, `result` and a `usage` of three numbers. The page took the outer
#: tag off and drew the rest raw -- 272 notes of tags on one machine, found
#: by `wostuast shapes`. What a reader wants is the summary, and the result
#: when there is one. `tests/fixtures/notes.jsonl`.
TASK_FIELD = re.compile(r"<(status|summary|result)>\s*(.*?)\s*</\1>", re.S)
#: Another session's message: a header line in a `user` record (none in a
#: queued one), the words inside the tag, and after it a paragraph Claude
#: Code writes to the agent about who sent it. Only the words are news.
AGENT_MESSAGE = re.compile(
    r"\A\s*(?:Another Claude session sent a message:\s*)?"
    r"<agent-message\b[^>]*>\s*(.*?)\s*</agent-message>", re.S)


def task_note(inner: str) -> str:
    """What a task notification says: its summary, and its result."""
    fields = dict(TASK_FIELD.findall(inner))
    head = fields.get("summary") or fields.get("status") or ""
    if not head:
        return inner              # a shape nobody has measured: as it came
    result = fields.get("result")
    return f"{head}\n\n{result}" if result else head

#: What Claude Code writes as a `user` record when Escape stops a turn --
#: "for tool use" when it stopped a call or declined its dialog, measured on
#: 2.1.282. Drawn as a prompt, it wore the reader's rail and the map named a
#: round after it, once for every decline from the page. Only the whole
#: record, exactly: a prompt that quotes it is still a prompt.
INTERRUPTED = re.compile(r"\[Request interrupted by user( for tool use)?\]")


def strip_reminder(text: str) -> str:
    """The inside of a `<system-reminder>`, when that is the whole record.

    The wrapper round a queued message is written inside one, and a reminder
    that holds nothing else is machine text either way -- so taking the tags
    off changes nothing about what is shown and lets one pattern read both
    shapes. A reminder beside other text is left alone here; `MACHINE_TAG`
    takes that one out in the usual way.
    """
    body = text.strip()
    if body.startswith("<system-reminder>") and body.endswith("</system-reminder>"):
        return body[len("<system-reminder>"):-len("</system-reminder>")].strip()
    return body


#: How Claude Code marks text that was pasted rather than typed. Measured
#: from 2.1.281's own source: the id is four lowercase hex digits, the same
#: on both tags, and each tag ends its line.
PASTE_OPEN = '<pasted_content id="'
PASTE_ID = re.compile(r"[0-9a-f]{4}")


def unwrap_pastes(text: str) -> str:
    """The prompt as it was meant, with Claude Code's paste tags taken off.

    Claude Code may keep a paste apart from what was typed and write it into
    the record as `<pasted_content id="1da8">`, the text, then
    `</pasted_content id="1da8">`, after the typed text and two newlines. It
    takes them off again when it shows the prompt; this page did not, so a
    review sent from here came back as a block of tags led by two empty
    lines. Every review is a paste, because it has newlines in it.

    The rules are Claude Code's own (`Pct` in its bundle), so this reads a
    record the way its own screen does: a tag with an id that is not four
    hex digits, or with no closing tag, is left as text, and up to two
    newlines either side of a paste belong to the wrapper.
    """
    if PASTE_OPEN not in text:
        return text
    pieces: list[str] = []
    done = 0            # where the text not yet taken starts
    look = 0            # where to look for the next opening tag
    while True:
        at = text.find(PASTE_OPEN, look)
        if at == -1:
            break
        name = at + len(PASTE_OPEN)
        paste_id = text[name:name + 4]
        if not PASTE_ID.fullmatch(paste_id) or not text.startswith('">\n', name + 4):
            look = name
            continue
        body = name + 4 + 3
        closer = f'</pasted_content id="{paste_id}">'
        end = text.find("\n" + closer, body - 1)
        if end == -1:
            break
        before = at
        for _ in range(2):
            if before > done and text[before - 1] == "\n":
                before -= 1
        pieces.append(text[done:before])
        pieces.append(text[body:end])
        done = end + 1 + len(closer)
        for _ in range(2):
            if text[done:done + 1] == "\n":
                done += 1
        look = done
    pieces.append(text[done:])
    # A paste stands apart from what was typed around it, as a paragraph of
    # its own -- Claude Code's screen draws it that way, and run together
    # with the typed words it would read as one sentence.
    joined = ""
    for piece in pieces:
        if not piece:
            continue
        if joined and not joined.endswith("\n") and not piece.startswith("\n"):
            joined += "\n\n"
        joined += piece
    return joined


def read_user_text(text: str) -> tuple[str, str]:
    """What a `user` record really is: a prompt, a note, or nothing to show.

    Claude Code writes `user` records of its own, and they were drawn as
    though the reader had typed them -- four rows of tags for one
    `/reload-plugins`, and `(no content)` as a prompt.

    A record is only read as a command when there is nothing else on it. A
    prompt really can hold `<command-name>` in it: somebody asking about this
    very feature types one, and that is a prompt.

    A message sent to a busy agent comes back wrapped in a header and a
    footer, and inside a `<system-reminder>`. The words are the reader's own,
    so the wrapper comes off and the prompt is drawn like any other --
    **before** the reminder is stripped, or the message would go with it.

    Pasted text comes off its tags first of all (`unwrap_pastes`): a paste
    can be all of a prompt, or sit inside a queued one.
    """
    text = unwrap_pastes(text)
    inside = QUEUED.search(strip_reminder(text))
    if inside:
        return "prompt", inside.group(1).strip()
    rest = MACHINE_TAG.sub("", text).strip()
    named = COMMAND_NAME.search(text)
    if named and not rest:
        # One line saying what was run. What it answered comes in the next
        # record, and `command_output` puts it into this block.
        args = COMMAND_ARGS.search(text)
        said = args.group(1).strip() if args else ""
        return "command", (named.group(1) + (" " + said if said else "")).strip()
    if not rest:
        return "", ""                      # plumbing, and nothing else
    stopped = INTERRUPTED.fullmatch(rest)
    if stopped:
        return "note", ("Interrupted during a tool call." if stopped.group(1)
                        else "Interrupted.")
    sent = AGENT_MESSAGE.match(rest)
    if sent:
        return "note", "From another session:\n\n" + sent.group(1)
    if rest.startswith(NOTED):
        note = TASK_NOTE.match(rest)
        return "note", (task_note(note.group(1)) if note else rest)
    return "prompt", text


def parse_timestamp(value: Any) -> float:
    """The transcript stamps lines in ISO 8601 with a Z. Turn it into seconds."""
    text = str(value or "")
    if not text:
        return 0.0
    try:
        from datetime import datetime

        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


def edit_counts(tool_input: Any) -> tuple[int, int]:
    """How many lines an edit adds and removes, counted from its strings."""
    data = tool_input if isinstance(tool_input, dict) else {}
    edits = data.get("edits")
    if isinstance(edits, list):
        added = removed = 0
        for one in edits:
            more, fewer = edit_counts(one)
            added += more
            removed += fewer
        return added, removed

    def lines(key: str) -> int:
        text = data.get(key)
        return len(str(text).splitlines()) if text else 0

    if "new_string" in data or "old_string" in data:
        return lines("new_string"), lines("old_string")
    if "new_source" in data or "old_source" in data:   # NotebookEdit
        return lines("new_source"), lines("old_source")
    if "content" in data:
        return lines("content"), 0
    return 0, 0


PATCH_KINDS = {" ": "context", "-": "removed", "+": "added"}


def read_patch(made: Any) -> tuple[list[dict[str, Any]], int, int, int]:
    """What an Edit or a Write changed, out of the record that answers it.

    Claude Code writes `toolUseResult` beside the result: for an edit, the
    old and new strings, the whole old file, `structuredPatch` -- hunks with
    the file's line numbers at that moment, each line led by a space, `-`
    or `+` -- and a git diff of the whole file. A new file (`type: create`)
    has no patch, and its text is the change. Only the hunks are kept, and
    only `PATCH_SHOWN` lines of them: the rest is the size of the file, on
    every edit of a session, and every block goes to the page. Measured on
    2.1.278, `tests/fixtures/edits.jsonl`.

    It also counts what was added and removed, over every line and not only
    the ones kept. Counted from the edit's strings instead, an Edit said
    "+3 −2" for one line added, because the strings carry the lines round
    the change as well.
    """
    if not isinstance(made, dict):
        return [], 0, 0, 0
    hunks: list[dict[str, Any]] = []
    left = PATCH_SHOWN
    more = added = removed = 0

    def keep(header: str, lines: list[tuple[str, str]]) -> None:
        nonlocal left, more, added, removed
        if not lines:
            return
        added += sum(1 for kind, _ in lines if kind == "added")
        removed += sum(1 for kind, _ in lines if kind == "removed")
        shown = lines[:max(left, 0)]
        more += len(lines) - len(shown)
        left -= len(shown)
        if shown:
            hunks.append({"header": header,
                          "lines": [{"kind": k, "text": t} for k, t in shown]})

    patch = made.get("structuredPatch")
    if isinstance(patch, list) and patch:
        for hunk in patch:
            if not isinstance(hunk, dict) or not isinstance(hunk.get("lines"), list):
                continue
            header = (f"@@ -{hunk.get('oldStart', 0)},{hunk.get('oldLines', 0)}"
                      f" +{hunk.get('newStart', 0)},{hunk.get('newLines', 0)} @@")
            # A line that is not led by one of the three -- git's "\ No
            # newline at end of file" -- is not a line of the file.
            keep(header, [(PATCH_KINDS[line[0]], line[1:])
                          for line in hunk["lines"]
                          if isinstance(line, str) and line[:1] in PATCH_KINDS])
    elif made.get("type") == "create" and isinstance(made.get("content"), str):
        # Split on `\n` only: a line of a file can hold U+2028 or a form
        # feed, and `splitlines` would cut it in two -- the diff scar.
        text = made["content"]
        lines = text.split("\n")
        if lines and lines[-1] == "":
            lines.pop()
        keep(f"@@ -0,0 +1,{len(lines)} @@", [("added", line) for line in lines])
    return hunks, more, added, removed


def result_text(content: Any) -> str:
    """A tool result is usually a string, and sometimes a list of blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for piece in content:
            if isinstance(piece, dict) and piece.get("type") == "text":
                parts.append(str(piece.get("text") or ""))
            elif isinstance(piece, str):
                parts.append(piece)
        return "\n".join(parts)
    if content is None:
        return ""
    return json.dumps(content, ensure_ascii=False, default=str)


class Transcript:
    """Reads a session's transcript into blocks, and follows it as it grows.

    A tool result arrives after its call, in a later line, so the blocks are
    kept by `tool_use_id` and the result is attached when it turns up. That is
    also why parsing is incremental: the same block is edited in place rather
    than the file being read again.
    """

    def __init__(self, path: str, cwd: str = "", run: int = 0) -> None:
        self.tail = Tail(Path(path))
        self.cwd = cwd
        self.blocks: list[Block] = []
        self.by_tool_use: dict[str, Block] = {}
        #: A command whose answer has just been read. The `isMeta` record
        #: straight after it is the same answer for the agent: `user_block`.
        self.echo_of: Block | None = None
        #: Which reading of this session's transcript these blocks belong to.
        #: `seq` is only a position in one reading, so the page needs to know
        #: when it is looking at a different one.
        self.run = run
        #: How many reads have changed something, in this reading. A block's
        #: count is not enough: a tool result is written into the block of
        #: its call, so the count stays where it was and a result read while
        #: no stream was open would never be asked for. Every push and every
        #: answer carries this, and a stream opens on it.
        self.version = 0
        #: The last run the watchers were told about. A transcript rewritten
        #: to nothing changes no block, so there is nothing to push — and the
        #: page would go on showing a conversation the file no longer holds.
        self.run_sent = -1
        #: When something last asked for this reader (`Daemon.transcript`),
        #: on the monotonic clock. `forget_gone` drops one idle that long.
        self.used = time.monotonic()

    def read_new(self) -> list[Block]:
        """Parse whatever has been appended. Returns every block that changed.

        A transcript can be rewritten under its own name — a `/clear`, a
        resume, any atomic rewrite — and then `Tail` starts over. What was
        held has to go with it: appending the re-read file to the blocks
        already there drew the whole transcript twice, and after a truncate
        the page went on showing text the file no longer held.
        """
        lines = self.tail.read_new()
        if self.tail.restarted:
            self.blocks.clear()
            self.by_tool_use.clear()
            self.run += 1
        touched: list[Block] = []
        for record in json_objects(lines):
            touched += self.add(record)
        return touched

    def keep(self, block: Block) -> Block:
        """Give a block its number and put it at the end."""
        block.seq = len(self.blocks)
        self.blocks.append(block)
        return block

    def add(self, record: dict[str, Any]) -> list[Block]:
        """One line of the transcript, folded into the blocks.

        A compaction is written as two records: a `system` one that marks the
        boundary, and a `user` one carrying the summary. Measured on 31
        transcripts across three machines, `summary` — which this used to be
        the only marker for — is not written at all any more; the branch stays
        for an older Claude Code that does write it.
        """
        kind = str(record.get("type") or "")
        if kind == "summary":
            # An older build. What it meant there was never settled — the
            # payload schema says a session that was compacted *or* resumed —
            # and no build in use writes one, so there is nothing to measure.
            return [self.keep(Block(kind="divider", text="context compacted"))]
        if kind == "system":
            subtype = str(record.get("subtype") or "")
            if subtype == "local_command":
                # The same command and answer as a `user` record, in another
                # shape: 2.1.283 writes `/model` closed without a pick and
                # `/context` this way, with the text in `content`.
                content = record.get("content")
                if not isinstance(content, str) or not content.strip():
                    return []
                block = self.user_block(
                    content, parse_timestamp(record.get("timestamp")), False)
                return [block] if block else []
            if subtype != "compact_boundary":
                return []
            return [self.keep(Block(kind="divider", text="context compacted"))]
        if kind == "attachment":
            return self.add_queued(record)
        if kind not in ("user", "assistant"):
            return []
        if record.get("isCompactSummary"):
            # The summary Claude Code writes to carry the conversation across
            # a compaction. It is a `user` record, so it was drawn as a
            # prompt — thirteen thousand characters of machine text sitting
            # in the transcript as though the reader had typed them. The
            # divider above says what happened; this is not a prompt.
            return []

        message = record.get("message")
        if not isinstance(message, dict):
            return []
        ts = parse_timestamp(record.get("timestamp"))
        content = message.get("content")

        if isinstance(content, str):
            if not content.strip():
                return []
            if kind == "user":
                block = self.user_block(content, ts, bool(record.get("isMeta")))
                return [block] if block else []
            return [self.keep(Block(kind="text", ts=ts, text=content))]
        if not isinstance(content, list):
            return []

        touched: list[Block] = []
        # What an edit changed is on the record, not on its result, so it
        # answers the one result a record carries and no other.
        answers = [piece for piece in content
                   if isinstance(piece, dict) and piece.get("type") == "tool_result"]
        made = record.get("toolUseResult") if len(answers) == 1 else None
        for piece in content:
            if not isinstance(piece, dict):
                continue
            block = self.add_piece(kind, piece, ts, bool(record.get("isMeta")), made)
            if block is not None:
                touched.append(block)
        return touched

    def user_block(self, text: str, ts: float, theirs: bool) -> Block | None:
        """Words in a `user` record, read for what they are, and kept.

        `theirs` is words nobody typed: an `isMeta` record, which is Claude
        Code speaking -- a Stop hook's answer, a whole skill's body,
        "Continue from where you left off." -- or another session's message.
        Each wore the reader's rail and opened a round on the map named after
        it. Shown, because it is what happened; never as a prompt.
        """
        # Only a record that is the tag and nothing else: a person asking
        # about bash mode can type `<bash-input>` into a prompt.
        command = BASH_INPUT.fullmatch(text)
        if command:
            return self.keep(Block(kind="shell", ts=ts, text=command.group(1).strip()))
        printed = BASH_OUTPUT.fullmatch(text)
        if printed:
            return self.shell_output(printed, ts)
        answered = LOCAL_OUTPUT.fullmatch(text)
        if answered:
            return self.command_output(answered.group(1), ts)
        mine, text = read_user_text(text)
        if not mine:
            return None
        if theirs and self.echo_of is not None:
            # What a command answered, again, for the agent: `/context`
            # writes its numbers as Markdown in an `isMeta` record straight
            # after its answer, and the page drew them twice. Only straight
            # after, and once: `/init` sends its prompt as an `isMeta`
            # record with no answer before it, and that one is shown.
            echoed = self.echo_of is (self.blocks[-1] if self.blocks else None)
            self.echo_of = None
            if echoed:
                return None
        if theirs and mine in ("prompt", "command"):
            mine = "note"
        return self.keep(Block(kind=mine, ts=ts, text=text))

    def shell_output(self, printed: re.Match[str], ts: float) -> Block:
        """What a `!` command printed, into the block of the command.

        It comes as the record after the command's, and a command and what
        it printed are one thing to read, as a terminal shows them. With no
        command before it -- a transcript read from the middle -- it stands
        alone. Claude Code wrote `<`, `>` and `&` as entities, `&` too, so
        `html.unescape` gives back exactly what was printed.
        """
        import html

        said = "\n".join(html.unescape(part).rstrip("\n")
                         for part in printed.groups() if part and part.strip())
        block = self.blocks[-1] if self.blocks else None
        if block is None or block.kind != "shell" or block.answered:
            block = self.keep(Block(kind="shell", ts=ts))
        block.result = said
        block.answered = True
        return block

    def command_output(self, said: str, ts: float) -> Block | None:
        """What a slash command answered, into the block of the command.

        The shape of `shell_output`: a command and its answer are one thing
        to read. The colour codes come off, and so does every other control
        character, because a page shows them as litter. "(no content)" is
        Claude Code saying there is nothing to say: it closes the command's
        block and draws nothing. An answer with no command before it -- a
        transcript read from the middle -- stands alone.
        """
        said = CONTROL_CHARS.sub("", ESCAPE_CODES.sub("", said))
        said = "\n".join(line.rstrip() for line in said.strip("\n").splitlines())
        nothing = not said.strip() or said.strip() == NO_OUTPUT
        block = self.blocks[-1] if self.blocks else None
        if block is None or block.kind != "command" or block.answered:
            if nothing:
                return None
            block = self.keep(Block(kind="command", ts=ts))
        block.result = "" if nothing else said
        block.answered = True
        self.echo_of = None if nothing else block
        return block

    def add_queued(self, record: dict[str, Any]) -> list[Block]:
        """A message that arrived while the agent was working.

        2.1.276 to 2.1.281 write it as an `attachment` of type
        `queued_command`, and no `user` record follows -- read on a real
        machine, where eighteen queued prompts were nowhere else. It is the
        message this page sends to a busy agent, so leaving it out showed the
        agent answering words that were not on the page. The reader's own
        (`origin` human, or none) is a prompt; another session's, and a
        background task's news, are notes. Every other attachment is the
        harness talking to the agent, and stays out.
        """
        attachment = record.get("attachment")
        if (not isinstance(attachment, dict)
                or attachment.get("type") != "queued_command"):
            return []
        said = attachment.get("prompt")
        if isinstance(said, list):
            said = "\n".join(str(one.get("text") or "") for one in said
                              if isinstance(one, dict) and one.get("type") == "text")
        if not isinstance(said, str) or not said.strip():
            return []
        origin = attachment.get("origin")
        theirs = (attachment.get("commandMode") != "prompt"
                  or bool(attachment.get("isMeta"))
                  or (isinstance(origin, dict)
                      and origin.get("kind") not in (None, "human")))
        ts = parse_timestamp(attachment.get("timestamp") or record.get("timestamp"))
        block = self.user_block(said, ts, theirs)
        return [block] if block else []

    def add_piece(self, role: str, piece: dict[str, Any], ts: float,
                  theirs: bool = False, made: Any = None) -> Block | None:
        kind = str(piece.get("type") or "")
        if kind == "text":
            text = str(piece.get("text") or "")
            if not text.strip():
                return None
            if role == "user":
                # The same reading as a record whose content is one string:
                # Claude Code writes both shapes.
                return self.user_block(text, ts, theirs)
            else:
                block = Block(kind="text", ts=ts, text=text)
        elif kind == "thinking":
            # Never shown. Claude Code keeps the text of most thoughts out of
            # the transcript -- 4,274 of 4,785 blocks on one machine were a
            # signature and nothing else -- so a switch to show them showed
            # nothing most of the time, and read as broken. The reader chose
            # to drop them, and the key that showed them.
            return None
        elif kind == "tool_use":
            name = str(piece.get("name") or "")
            tool_input = piece.get("input")
            # Section 4.6 asks for counts on an edit. A Write is one whole file
            # and its line count says nothing useful, so it does not get them
            # here -- until its result brings the patch, which counts what
            # really moved (`read_patch`), for an Edit too.
            added, removed = edit_counts(tool_input) if name in COUNTED_TOOLS else (0, 0)
            plan = plan_of(name, tool_input)
            if plan:
                # The plan a plan-mode agent asks to start on, read as the
                # document it is (#372). As a tool row it was its JSON, cut
                # at 80 characters. It keeps the call's id: a No on the page
                # waits for this call's result like any other's.
                block = Block(kind="plan", ts=ts, tool=name, text=plan,
                              tool_use_id=str(piece.get("id") or ""))
            else:
                block = Block(kind="tool", ts=ts, tool=name,
                              target=tool_target(name, tool_input, self.cwd),
                              added=added, removed=removed,
                              tool_use_id=str(piece.get("id") or ""))
            if block.tool_use_id:
                self.by_tool_use[block.tool_use_id] = block
        elif kind == "tool_result":
            held = self.by_tool_use.get(str(piece.get("tool_use_id") or ""))
            if held is None:
                return None
            held.answered = True
            held.result = result_text(piece.get("content"))
            held.failed = bool(piece.get("is_error"))
            if held.tool in PATCHED_TOOLS and not held.failed:
                patch, more, added, removed = read_patch(made)
                if patch:
                    # The counts of the change itself, which a Write has
                    # too, now: a new file's lines, or what a rewrite moved.
                    held.patch, held.patch_more = patch, more
                    held.added, held.removed = added, removed
            return held          # an existing block changed; it is not a new one
        else:
            return None
        return self.keep(block)


# --- git facts: what git says about the agent's directory --------------------


def run(args: Sequence[str], cwd: str | None = None, timeout: float = RUN_TIMEOUT,
        ok: Sequence[int] = (0,), stdin: bytes | None = None) -> str | None:
    """Run a command and return its stdout, unchanged. None on any failure.

    `stdin` is what the command reads; without it, the command has the
    daemon's own, as it always had. `tmux load-buffer -` takes the text of a
    send that way (see `tmux_send`).

    `ok` is the exit statuses that are an answer. Only 0 by default. A caller
    that knows a command says "no" with another status names it: `git
    merge-base` exits 1 when two commits have no commit in common, and 128
    when it fails. None cannot tell those two apart.

    It does not strip, and it does not translate: read as bytes and decoded
    here. `text=True` reads with universal newlines, which turned a lone CR
    inside a line of a diff into a line break before `parse_diff` saw it --
    every line after it counted one too high, and the Files tab, which reads
    the bytes, disagreed. The form-feed scar, by another road.

    git runs with `GIT_OPTIONAL_LOCKS=0`. Without it, `status` and `diff`
    take `.git/index.lock` to write a refreshed index back. The daemon only
    reads, and it runs git just after an agent's tool call -- exactly when
    the agent runs its own `git add`, which then failed on the lock. And a
    git that passes its timeout is killed with SIGKILL, which it cannot
    catch, so it left the lock behind: every `git add` and `git commit`
    failed until somebody deleted the file by hand. Here, and not as a flag
    on each call, so a new git call cannot forget it.
    """
    import subprocess

    command = list(args)
    env = None
    if command and os.path.basename(str(command[0])) == "git":
        env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}
    try:
        done = subprocess.run(
            command,
            cwd=cwd or None,
            env=env,
            input=stdin,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if done.returncode not in ok:
        return None
    # A diff may hold bytes that are not UTF-8.
    return done.stdout.decode("utf-8", "replace")


def parse_status_branch(header: str) -> tuple[str, int, int]:
    """Read the `## ` line of `git status --branch`: branch, ahead, behind.

    It looks like `## main...origin/main [ahead 2, behind 1]`. The upstream and
    the counts are left out when there are none. A fresh repository says
    `## No commits yet on main`, and a detached HEAD says `## HEAD (no
    branch)` — which is not a branch name, and went on the row as if it were.
    """
    text = header[3:] if header.startswith("## ") else header
    ahead = behind = 0
    if "[" in text:
        text, _, counts = text.partition(" [")
        for word, value in re.findall(r"(ahead|behind) (\d+)", counts):
            if word == "ahead":
                ahead = int(value)
            else:
                behind = int(value)
    text = text.partition("...")[0]
    if text.strip() == "HEAD (no branch)":
        return "", ahead, behind
    branch = text.rpartition(" ")[2] if text.startswith("No commits yet on ") else text
    return branch.strip(), ahead, behind


#: The most of a remote's URL the row's hover shows. Longer is not a URL
#: anybody reads, and the secret patterns cost time in its length.
REMOTE_SHOWN = 500

#: The largest config file `remote_url` reads. A real one is a few
#: kilobytes. It is read on the tick thread, and an agent can write any
#: line into it; a larger file gives no remote rather than a slow tick.
CONFIG_MAX = 1 << 20


def remote_url(git_dir: str) -> str:
    """Where the repository is fetched from, read from its config file.

    Read and not asked: `git config` would be a third git run for every
    worktree on every poll, for a line that almost never changes, and the
    git directory `git_facts` already has is where the file is. Only
    `<git_dir>/config` is read. It used to try `<git_dir>/.git/config` as
    well, and `git_facts` gave it the top of the worktree when only
    `--show-toplevel` answered, so a tracked file named `config` there was
    read as the repository's config.

    The file is read the way git reads it (`config_entries`). What git
    would add -- `include`, `insteadOf` -- is not followed; this is a
    hover, and a hover that shows the file's own line is still true.
    `origin` is taken, or else the first remote with a URL. For a remote
    with several `url` lines the first is taken: git fetches from that one.

    A URL can carry a user and a token (`https://me:ghp_x@host/r.git`), and
    it is going to a page, so the part before the `@` of a URL is taken
    out. The `git@host:path` shape holds no secret and is left as it is.
    The result then goes through `hide_secrets` as well, a second guard for
    a shape the first one does not see -- through `clip_hidden`, so a
    remote of a megabyte, which an agent can write, costs the tick thread
    no more than one of a line.

    It never raises. A file it cannot read, or one git would refuse, gives
    "": that is also what the row shows for a repository with no remote.
    """
    import urllib.parse

    base = git_dir.strip().rstrip("/")
    if not base:
        return ""
    where = os.path.join(base, "config")
    # A plain file only: a FIFO of that name would hold the tick thread.
    try:
        if not os.path.isfile(where):
            return ""
        with open(where, "rb") as handle:
            data = handle.read(CONFIG_MAX + 1)
    except (OSError, ValueError):
        return ""
    if len(data) > CONFIG_MAX:
        return ""
    entries = config_entries(data.decode("utf-8", "replace"))
    if entries is None:
        return ""
    urls: dict[str, str] = {}
    for key, value in entries:
        section, _, rest = key.partition(".")
        name, _, last = rest.rpartition(".")
        if section == "remote" and last == "url" and name and value is not None:
            urls.setdefault(name, value)
    if not urls:
        return ""
    url = urls.get("origin", next(iter(urls.values()))).strip()
    if "://" in url:
        try:
            parts = urllib.parse.urlsplit(url)
            host = parts.netloc.rpartition("@")[2]
            url = urllib.parse.urlunsplit(parts._replace(netloc=host))
        except ValueError:
            return ""
    return clip_hidden(url, REMOTE_SHOWN)


#: What git counts as white space in a config file (its own `isspace`):
#: not the vertical tab or the form feed, which C's `isspace` takes.
CONFIG_SPACE = " \t\r\n"
#: Space and comments between entries, in one step.
CONFIG_GAP = re.compile(r"(?:[ \t\r\n]+|[#;][^\n]*)+")
#: A key: a letter, then letters, digits and `-`.
CONFIG_KEY = re.compile(r"[A-Za-z][A-Za-z0-9-]*")
#: A section's name in `[name]` or `[name "sub"]`; a `.` in it is the old
#: `[name.sub]` form.
CONFIG_SECTION = re.compile(r"[A-Za-z0-9.-]*")
#: A run of characters with no meaning of their own inside a value.
CONFIG_PLAIN = re.compile(r'[^\n\\"#; \t\r]+')
#: What a backslash in a value may stand before. git refuses the file for
#: any other.
CONFIG_ESCAPES = {"n": "\n", "t": "\t", "b": "\b", "\\": "\\", '"': '"'}


def config_entries(text: str) -> list[tuple[str, str | None]] | None:
    """Each `key = value` of a git config file, in order, or None.

    The key is git's full name: the section and the key in lower case, the
    subsection as it is written -- `remote.Origin.url` for
    `[Remote "Origin"] URL = x`. A key with no `=` is git's "true", and its
    value is None. None for the whole file is what git would refuse, and
    git then reads nothing from it either.

    The rules are git's own (`config.c`, `git_parse_source`): `#` and `;`
    start a comment, a `[section]` can have a key after it on the same
    line, a key starts with a letter. `configparser` is not this, and a
    file git reads without complaint made it raise: a key with no `=`, then
    a line indented further, is read as a continuation of a value that is
    None -- `AttributeError` before Python 3.13, which escaped `remote_url`
    and stopped every row. It also kept a `\\` that continues a value onto
    the next line, so a password in a URL split that way went to the page.
    """
    text = text.replace("\r\n", "\n")
    if text.startswith("﻿"):
        text = text[1:]
    text += "\n"
    size = len(text)
    entries: list[tuple[str, str | None]] = []
    section = ""
    at = 0
    while True:
        gap = CONFIG_GAP.match(text, at)
        if gap:
            at = gap.end()
        if at >= size:
            return entries
        if text[at] == "[":
            found = config_section(text, at + 1)
            if found is None:
                return None
            section, at = found
            continue
        key = CONFIG_KEY.match(text, at)
        if not key:
            return None
        at = key.end()
        while text[at] in " \t":
            at += 1
        word = key.group().lower()
        name = f"{section}.{word}" if section else word
        if text[at] == "\n":
            entries.append((name, None))
            at += 1
            continue
        if text[at] != "=":
            return None
        found_value = config_value(text, at + 1)
        if found_value is None:
            return None
        value, at = found_value
        entries.append((name, value))


def config_section(text: str, at: int) -> tuple[str, int] | None:
    """The section a `[` starts, and where its header ends, or None.

    `[name]` and `[name.sub]` are in lower case whole. `[name "sub"]`
    keeps the subsection as written, with `\\` taking the next character
    as it is. A header that ends on its own line is refused, as git does.
    """
    name = CONFIG_SECTION.match(text, at)
    base = name.group().lower()
    at = name.end()
    if text[at] == "]":
        return (base, at + 1) if base else None
    if text[at] not in CONFIG_SPACE:
        return None
    while text[at] in CONFIG_SPACE:
        if text[at] == "\n":
            return None
        at += 1
    if text[at] != '"':
        return None
    at += 1
    sub: list[str] = []
    while True:
        char = text[at]
        if char == "\n":
            return None
        if char == '"':
            break
        if char == "\\":
            at += 1
            char = text[at]
            if char == "\n":
                return None
        sub.append(char)
        at += 1
    if text[at + 1] != "]":
        return None
    return f"{base}.{''.join(sub)}", at + 2


def config_value(text: str, at: int) -> tuple[str, int] | None:
    """The value that starts at `at`, after the `=`, and where its line
    ends; None for one git refuses.

    As git reads it (`parse_value`): space before the value and after it
    is dropped, a double quote opens and closes a quoted part and is not
    part of the value, `#` and `;` outside quotes start a comment, a
    backslash takes `\\\\`, `\\"`, `\\n`, `\\t` and `\\b`, and a backslash at
    the end of a line joins the next line on. A quote still open at the end
    of the line, and any other backslash, make git refuse the file.
    `text` ends in a newline, which `config_entries` makes sure of.
    """
    parts: list[str] = []
    size = 0
    trim = 0
    quoted = False
    end = len(text)
    while True:
        char = text[at] if at < end else "\n"
        if char == "\n":
            if quoted:
                return None
            value = "".join(parts)
            return (value[:trim] if trim else value), at + 1
        if char in " \t\r" and not quoted:
            if not trim:
                trim = size
            if size:
                parts.append(char)
                size += 1
            at += 1
            continue
        if char in "#;" and not quoted:
            at = text.find("\n", at)
            continue
        trim = 0
        if char == "\\":
            after = text[at + 1] if at + 1 < end else "\n"
            at += 2
            if after == "\n":
                continue
            escaped = CONFIG_ESCAPES.get(after)
            if escaped is None:
                return None
            parts.append(escaped)
            size += 1
            continue
        if char == '"':
            quoted = not quoted
            at += 1
            continue
        plain = CONFIG_PLAIN.match(text, at)
        if plain:
            parts.append(plain.group())
            size += plain.end() - at
            at = plain.end()
        else:
            # `#`, `;`, a space, a tab or a carriage return inside quotes.
            parts.append(char)
            size += 1
            at += 1


def repo_name(git_dir: str) -> str:
    """The name of the repository that owns a git directory.

    `--git-common-dir` points at the repository itself, which is named in one
    of three ways: `<repo>/.git` for a plain clone, `<repo>/.bare` or another
    dotted name for the bare layout worktrees are usually built on, and
    `<repo>.git` for a bare clone. A hidden name means the repository is the
    directory above; otherwise the name is the directory's own, without `.git`.
    """
    path = git_dir.strip().rstrip("/")
    if not path:
        return ""
    name = os.path.basename(path)
    if name.startswith("."):
        return os.path.basename(os.path.dirname(path))
    return re.sub(r"\.git$", "", name)


#: The two letters of `git status --porcelain` that say a file is in
#: conflict ("unmerged"), from git's own documentation of the format.
UNMERGED = frozenset({"DD", "AU", "UD", "UA", "DU", "AA", "UU"})


def own_git_dir(root: str) -> str:
    """The git folder of this worktree, not of the repository: a linked
    worktree keeps `rebase-merge/` and `MERGE_HEAD` in a folder of its own,
    which `<root>/.git` names in a line `gitdir: …` -- the main worktree's
    `.git` is that folder itself. Read from the file, so it costs no git
    call. "" when it cannot be read."""
    if not root:
        return ""
    dot = os.path.join(root, ".git")
    if os.path.isdir(dot):
        return dot
    try:
        with open(dot, encoding="utf-8", errors="replace") as handle:
            line = handle.read(4096).strip()
    except OSError:
        return ""
    if not line.startswith("gitdir:"):
        return ""
    found = line[len("gitdir:"):].strip()
    return found if os.path.isabs(found) else os.path.normpath(os.path.join(root, found))


def worktree_doing(git_dir: str) -> tuple[str, str]:
    """What git has started in this worktree and not finished, and the
    branch a rebase is rebasing: ("rebasing 2/3", "side"), or ("", "").

    Read off the files git leaves, as measured on git 2.43 (#357): a rebase
    keeps `rebase-merge/` with `msgnum` and `end`, or, with `--apply`,
    `rebase-apply/` with `rebasing`, `next` and `last` -- and `git am` the
    same folder with `applying`. A merge leaves `MERGE_HEAD`, a cherry-pick
    `CHERRY_PICK_HEAD`, a revert `REVERT_HEAD`, a bisect `BISECT_LOG`. During
    a rebase `status` says `HEAD (no branch)`, and the row lost its whole
    second line; `head-name` names the branch being rebased. Only reads:
    a file that cannot be read is no state, never an error on the row.
    """
    if not git_dir:
        return "", ""

    def read(*parts: str) -> str:
        try:
            with open(os.path.join(git_dir, *parts), encoding="utf-8",
                      errors="replace") as handle:
                return handle.read(256).strip()
        except OSError:
            return ""

    def there(name: str) -> bool:
        return os.path.exists(os.path.join(git_dir, name))

    def branch_of(folder: str) -> str:
        head = read(folder, "head-name")
        return head[len("refs/heads/"):] if head.startswith("refs/heads/") else ""

    def step(done: str, of: str) -> str:
        return f" {done}/{of}" if done.isdigit() and of.isdigit() else ""

    if there("rebase-merge"):
        return ("rebasing" + step(read("rebase-merge", "msgnum"),
                                  read("rebase-merge", "end")),
                branch_of("rebase-merge"))
    if there("rebase-apply"):
        counted_step = step(read("rebase-apply", "next"), read("rebase-apply", "last"))
        if there(os.path.join("rebase-apply", "applying")):
            return "applying patches" + counted_step, ""
        return "rebasing" + counted_step, branch_of("rebase-apply")
    for name, word in (("MERGE_HEAD", "merging"), ("CHERRY_PICK_HEAD", "cherry-picking"),
                       ("REVERT_HEAD", "reverting"), ("BISECT_LOG", "bisecting")):
        if there(name):
            return word, ""
    return "", ""


def git_facts(cwd: str, runner: Callable[..., str | None] = run) -> GitFacts:
    """Read the repository name, branch, ahead, behind and dirty state.

    Two git runs, not four: one gives both directories, the other gives the
    branch, the counts and the changed files at once. A git error gives empty
    facts, because a directory need not be a repository at all — except when
    the first call worked and the second did not, which can only be a failure,
    and `failed` says so. The two are otherwise the same answer: `status`
    fails outside a repository just as it does on a stalled disk.
    """
    facts = GitFacts()
    if not cwd or not os.path.isdir(cwd):
        return facts

    def git(*args: str) -> str | None:
        # Only the newline git ends with. `strip()` also took the space off a
        # worktree whose path ends in one, and that path does not exist.
        out = runner(["git", "-C", cwd, *args])
        return None if out is None else out.rstrip("\n")

    # --git-common-dir points at the main repository, so a worktree keeps its
    # repository's name. --path-format needs git 2.31, and an older git does
    # not fail on it: `rev-parse` prints a flag it does not know back and
    # exits 0. That line became the repository's name, and every row read
    # `--path-format=absolute/<dir>`. So a line starting with `-` is dropped
    # -- a path git prints is absolute or starts with `.` -- and a common
    # directory that came back relative is made absolute against `cwd`.
    paths = git("rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel")
    if paths is None:
        paths = git("rev-parse", "--show-toplevel")
    found = [line for line in (paths or "").split("\n")
             if line and not line.startswith("-")]
    if found:
        common = found[0]
        if not os.path.isabs(common):
            common = os.path.realpath(os.path.join(cwd, common))
        facts.repo = repo_name(common)
        facts.root = found[-1]
        # With one line, only `--show-toplevel` answered, and that is the
        # top of the worktree, not a git directory: its `config` can be a
        # file of the project. The git directory is then `.git` under it.
        git_dir = common if len(found) > 1 else os.path.join(common, ".git")
        facts.remote = remote_url(git_dir)

    status = git("status", "--porcelain", "--branch")
    if not found:
        # Neither `rev-parse` answered. Outside a repository that is the
        # answer; on a stalled machine it is not one, and taken for one it
        # wrote empty facts over known ones and was not asked again. `status`
        # answering says this is a repository, so then it is a failure too.
        facts.failed = status is not None or not git_answers(runner)
        return facts
    if status is None:
        # `--show-toplevel` answered, so this is a repository and git was
        # asked about it and did not answer. The call has a two second
        # timeout, and `status` on a very large worktree can pass it.
        facts.failed = True
        return facts
    lines = status.splitlines()
    if lines and lines[0].startswith("## "):
        facts.branch, facts.ahead, facts.behind = parse_status_branch(lines[0])
        lines = lines[1:]
    changed = [line for line in lines if line.strip()]
    facts.touched_files = len(changed)
    facts.dirty = bool(changed)
    facts.conflicts = sum(1 for line in changed if line[:2] in UNMERGED)
    facts.doing, rebasing = worktree_doing(own_git_dir(facts.root))
    facts.branch = facts.branch or rebasing
    return facts


def git_facts_many(directories: Sequence[str]) -> dict[str, GitFacts]:
    """Read several directories at once. git waits on disk, so ten worktrees
    cost about as long as one. It reads and returns; it assigns nothing, so
    only the thread that called it ever writes to a session.

    It never raises. One directory whose facts raised took the whole batch
    with it out of `pool.map`: `refresh` raised before it replaced the
    rows, on every tick, so no row changed for any session while that one
    was known, and `ls` ended in a traceback. A directory that raises now
    has failed, which `reload_git` asks again after the cool-down.
    """
    from concurrent.futures import ThreadPoolExecutor

    wanted = sorted({directory for directory in directories if directory})
    if not wanted:
        return {}
    with ThreadPoolExecutor(max_workers=min(8, len(wanted))) as pool:
        return dict(zip(wanted, pool.map(git_facts_or_failed, wanted)))


def git_facts_or_failed(directory: str) -> GitFacts:
    """`git_facts`, with anything it raises turned into a failure that
    says what it raised. The caller logs it: the `Store` once a directory,
    because a failure is asked again after every cool-down."""
    try:
        return git_facts(directory)
    except Exception as error:
        return GitFacts(failed=True, raised=repr(error))


def add_git_facts(sessions: Sequence[Session]) -> None:
    """Fill in git facts for every session. It never raises, because
    `git_facts_many` does not: `ls` ended in a traceback when one
    directory's facts raised."""
    facts = git_facts_many([session.cwd for session in sessions])
    for one in {one.raised for one in facts.values() if one.raised}:
        log(f"git facts raised: {one}")
    for session in sessions:
        session.git = facts.get(session.cwd, GitFacts())


# --- files and diffs: what the worktree holds --------------------------------

#: These come first in the Files tab, in this order. They say what the work is.
PINNED_FILES = ("PLAN.md", "CLAUDE.md", "README.md")

#: A file longer than this is cut.
FILE_MAX_BYTES = 512 * 1024

#: What the page may show as it is, and the type each one is served with.
#: Decided by the end of the name and by nothing else -- this list is the
#: whole of what `raw` will serve, so nothing here may be a document.
#:
#: SVG is not on it and will not be. It is text, so it already reads as code
#: on the Files tab; and serving one from this origin would put a page of the
#: agent's own writing on the origin that holds the token, with a script in it
#: able to read both.
SHOWN_AS = {
    ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif",
    ".bmp": "image/bmp", ".ico": "image/vnd.microsoft.icon",
    ".mp4": "video/mp4", ".webm": "video/webm", ".ogv": "video/ogg",
    ".mov": "video/quicktime",
    ".mp3": "audio/mpeg", ".wav": "audio/wav", ".ogg": "audio/ogg",
    ".flac": "audio/flac", ".m4a": "audio/mp4",
}

#: Bigger than this and the page is told to say so rather than being handed
#: it. The daemon reads a file whole, and a worktree can hold a gigabyte of
#: video.
SHOWN_MAX_BYTES = 25 * 1024 * 1024


def shown_as(wanted: str) -> str:
    """The type this name is served with, or empty for one we do not serve."""
    return SHOWN_AS.get(Path(wanted).suffix.lower(), "")

#: A ceiling on the whole listing, not on what the page searches. Sending the
#: first five thousand of 52,799 names made `libcorrelation` find 16 files and
#: miss more than a thousand, because the thousand were never sent. Past this
#: many the tab says it cannot answer rather than answering a fraction.
FILES_MAX = 200_000

#: What one wholly-ignored directory is worth, in names.
#:
#: git collapses such a directory into a single entry and walks no further,
#: which is what keeps `node_modules` from costing a quarter of a million
#: names. wostuast dropped that entry, so a generated directory -- the one
#: ignored place a reader does want to read -- had no way in at all.
#:
#: Walking it ourselves means keeping git's promise ourselves. A directory
#: whose contents do not fit in this many names is left out whole and named
#: instead, and the walk stops as soon as it knows that, so a build root of a
#: hundred thousand objects costs this many reads and not a hundred thousand.
#: The rule is recursive, which is what makes it useful: `_build_root_c2` is
#: left out, and the plan and the notes beside it are listed, because what is
#: left of the directory then fits.
#:
#: 2,000 because a generated directory somebody reads -- a plan, some notes, a
#: report -- is tens of files. `node_modules` and a build root are thousands,
#: and neither is a place to browse.
IGNORED_MAX = 2000

#: How long a listing nobody has asked about is kept. It holds every name in
#: a repository, so it does not sit there for the life of the daemon.
LISTING_KEPT = 300.0

#: How long a transcript reader nobody watches, and no dialog needs, is kept
#: after it was last asked for (`Daemon.forget_gone`). Long enough for the
#: page's fetch and the stream that follows it; a reader holds every block.
READER_IDLE = 60.0

#: How long a listing is served before git is asked again. The Files tab polls
#: every two seconds, a worktree may have several browsers on it, and a walk of
#: fifty thousand files costs about a second — so without this the daemon would
#: spend most of its time listing the same repository over and over.
LIST_FRESH = 3.0

#: Listing a repository is the one git call that does not fit in RUN_TIMEOUT.
#: `ls-files` and `status` over fifty thousand files take longer than two
#: seconds, and the timeout came back as an empty worktree. A shared timeout
#: is a shared limit, and these calls are not the same size as the others.
LIST_TIMEOUT = 20.0

#: A NUL byte in the first of a file says it is not text. Every editor guesses
#: this way, and every editor is sometimes wrong; being wrong here shows a
#: "binary file" note instead of a screen of control characters.
BINARY_SNIFF = 8000

#: A diff longer than this is cut. No page can show more, and parsing the rest
#: would cost more than it is worth.
DIFF_MAX_BYTES = 2 * 1024 * 1024

#: git diff takes longer than git status on a large repository. It runs in a
#: request thread, never in the tick, so waiting here holds up nothing else.
DIFF_TIMEOUT = 8.0

#: What `tmux_send` takes out of anything on its way to a terminal: everything
#: below a space except tab and newline, the delete character, and the C1
#: block above it. C1 holds NEL (U+0085) and CSI (U+009B), controls a terminal
#: may act on and an agent may write; U+2028 and U+2029 are line breaks that
#: `"\n" in text` does not see, so they would have gone out unpasted. The rule
#: is "nothing below a space reaches a terminal", and these are below one.
#:
#: **And every lone surrogate.** JSON can carry one, and `subprocess` hands
#: an argument to tmux with `surrogateescape`, so the pair U+DCC2 U+DC9B
#: left as the bytes c2 9b -- which is U+009B, CSI -- measured in a real
#: pane. A high one made the encode fail and the send with it. No character
#: a person typed is one. The pattern is a raw string, so the source holds
#: the escape and `re` reads it: in a plain string it would be the character
#: itself, which Python 3.13 will not put in a bytecode cache.
CONTROL_CHARS = re.compile(
    r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029\ud800-\udfff]")

#: The header a POST carries its token in. A cross-origin request cannot add a
#: header of its own without asking us first, and we never say yes — so a page
#: that has not read ours cannot even reach the code that checks it.
TOKEN_HEADER = "X-Wostuast-Token"

#: Where the token goes into the page, replaced as the page is served.
TOKEN_MARK = "__WOSTUAST_TOKEN__"

#: Where the running copy's version goes, beside the name at the top of the
#: session list.
VERSION_MARK = "__WOSTUAST_VERSION__"

#: Where the reader's settings go into the page, so the first paint already
#: has their colours. The marks are put in in one pass (`route_get`).
SETTINGS_MARK = '"__WOSTUAST_SETTINGS__"'

#: How Claude Code answers a call whose dialog was told No, as the call's
#: result in the transcript. Measured on 2.1.282; the tool_result goes on
#: "The tool use was rejected (eg. if it was a file edit, …)".
REJECTED = "The user doesn't want to proceed with this tool use"

#: The most a POST body may be. It holds a send of `SEND_MAX` bytes as JSON:
#: a newline or a tab is two bytes there, and a control character six
#: (`\u001b`), which a log with colours is full of -- `tmux_send` takes them
#: out, but they come in the body first. Six times `SEND_MAX`, and room for
#: the rest of the body. Only a request that passed `allowed` is read at
#: all (`route_post`), so a site in the reader's browser cannot make the
#: daemon read this much.
POST_MAX = 8 * 1024 * 1024

#: Which answers are packed with gzip: text, never a picture or a video,
#: which are packed already. Measured on 53,000 made-up file names, 2.4 MB:
#: level 1 took 20 ms for 548 KB, level 6 79 ms for 397 KB, level 9 242 ms
#: for 380 KB. At 200 KiB/s the 150 KB between 1 and 6 is most of a second,
#: and the 79 ms is paid once, on the first visit to the Files tab.
PACKED_KINDS = ("application/json", "text/")
PACK_LEVEL = 6
#: Below this an answer goes as it is: the header and the packing cost more
#: than they save.
PACK_MIN = 1024

#: The most text one `send` may type, **in bytes**. Longer is refused rather
#: than cut: what arrives in the terminal must be what the user wrote, or
#: nothing.
#:
#: tmux sets no number any more: `tmux_send` hands the text to `load-buffer`
#: on stdin, not as an argument, and a command line was what tmux 3.4 cut
#: off at 16,341 bytes (`send-keys -l`). So the number is what the agent
#: takes. Measured with Claude Code 2.1.287 in tmux 3.4, against a fake
#: Messages API that recorded each request: 17 KB, 136 KB and 1.36 MB of
#: log lines each arrived as the one user turn, every byte, the largest in
#: 1.2 s from the paste to the request. The cap is 1 MiB, under that: a
#: long log is a few hundred KB, and a megabyte is some 300,000 tokens,
#: more than most models take, so more would be refused by the API instead.
#:
#: Bytes and not characters, because a byte is what everything on the way
#: counts, and a cap on `len()` lets three times as much through in Japanese.
SEND_MAX = 1024 * 1024

#: How much of a permission request the page is sent, counted over every
#: field of its input. A `Write` carries a whole file, and a row goes to
#: every browser on every push; past this the page says the request is too
#: long to show and points at the pane, where the whole of it is.
PERMISSION_SHOWN = 8000

#: How long a decline waits to see its dialog close, in the transcript,
#: before it will type the reason. Measured against 2.1.282: the rejection
#: is written a few milliseconds after the Escape.
DECLINE_WAIT = 3.0

#: How many untracked files the Diff tab names. git diff shows none of them,
#: so the tab says they are there rather than leaving a hole.
UNTRACKED_SHOWN = 50

@dataclass
class FileEntry:
    """One file the Files tab offers."""

    path: str = ""          # relative to the worktree root
    mtime: float = 0.0      # only read for a changed file; 0 for the rest
    changed: bool = False   # git says this one differs from the last commit


@dataclass
class Worktree:
    """A worktree's root, and the files in it."""

    root: str = ""
    files: list[FileEntry] = field(default_factory=list)
    total: int = 0          # before the list was cut to FILES_MAX
    cut: bool = False       # the worktree holds more names than FILES_MAX
    failed: bool = False    # git did not answer; "no files" would lie
    #: Ignored directories too big to list, so the tree can say so where they
    #: stand. A folder with nothing in it and no reason given reads as a bug.
    skipped: list[str] = field(default_factory=list)


@dataclass
class FileText:
    """One file's content, as the page gets it."""

    text: str = ""
    mtime: float = 0.0
    #: Bytes on disk, which is not what `len(text)` says once it is decoded
    #: or cut at `FILE_MAX_BYTES`. The stat that reads the mtime has it.
    size: int = 0
    binary: bool = False
    #: The type this file is shown as, when the page may show it as it is --
    #: `image/png`, `video/mp4`, and so on. Empty for everything else. The
    #: list lives here, beside the route that has to enforce it, and the page
    #: reads the answer: two lists in two languages would drift, and a
    #: mismatch is silent either way round.
    shown: str = ""
    #: On that list, but past `SHOWN_MAX_BYTES`. The page then says how big it
    #: is rather than asking for a file it would be refused.
    oversize: bool = False
    # What `file` made of it, when the name and the first line said nothing.
    # The page decides what to do with it; see `languageOf`.
    language: str = ""
    #: The version of the file this is: its mtime in nanoseconds and its
    #: size. The page sends it back, and a file still the same is answered
    #: `same` before it is read (#292).
    stamp: str = ""
    same: bool = False


def walk_ignored(root: str, top: str,
                 budget: int) -> tuple[list[str], list[str]]:
    """What is inside a wholly-ignored directory, and what was left out.

    `git ls-files --directory` hands over one entry for such a directory and
    does not look inside it. That is the right trade for `node_modules` and
    the wrong one for `.oa-implement`, which an agent writes into and a
    reader wants to read, so the walk is ours to do -- and so is the promise
    that it stays cheap.

    A directory is listed only when what it holds fits in `budget`, counting
    what is under it and not counting a folder already left out. Nothing is
    half-listed: a directory either comes back whole or comes back as its own
    name in `skipped`, which is the thing the tree draws. So a build root of
    a hundred thousand objects is one row, the files beside it are listed,
    and finding that out costs `budget` reads rather than a hundred thousand.

    A link to a directory is neither followed nor listed. Following it is a
    way round the budget and a way into a loop, and listing it would offer a
    name that is not a file; what is behind it is listed where it really
    lives, if git offers that place at all. A link to a file is a file.

    The budget is passed rather than read, so a test can set it to three
    files instead of building two thousand of them.
    """
    def below(here: str) -> tuple[list[str] | None, list[str]]:
        """This directory's files, or None when it does not fit."""
        names: list[str] = []
        skipped: list[str] = []
        try:
            with os.scandir(os.path.join(root, here)) as reading:
                for entry in reading:
                    where = f"{here}/{entry.name}"
                    if entry.is_dir(follow_symlinks=False):
                        found, left = below(where)
                        if found is None:
                            skipped.append(where)
                        else:
                            names.extend(found)
                            skipped.extend(left)
                    elif entry.is_dir():
                        continue    # a link to a directory: neither of those
                    else:
                        names.append(where)
                    if len(names) > budget:
                        # What was left out inside a directory that is itself
                        # left out is not news: the reader is told about the
                        # one row they can see.
                        return None, []
        except OSError:
            return [], []       # gone between git and us, or not ours to read
        return names, skipped

    top = top.rstrip("/")
    names, skipped = below(top)
    # The whole of it does not fit, so the whole of it is the one name the
    # reader is given -- a folder they can see, with nothing pretending to be
    # inside it.
    return ([], [top]) if names is None else (names, skipped)


def in_order(names: set[str]) -> list[str]:
    """The order the names are sent in: PLAN.md, CLAUDE.md and README.md
    first, because they say what the work is, then the rest by name.

    This order depends only on which files exist, and that is the point. The
    page holds these names between polls and asks for them again only when the
    tag they came with has moved. An order that also depended on which files
    had changed would move every time an agent saved anything, which is every
    few seconds, and the whole list — 1.7 MB of it in a large repository —
    would come down the wire again each time.

    Where a changed file sits in the list the reader sees is the page's
    business. It gets the changed names and their times, which is tens of
    entries, and lifts them to the top itself.

    One sort, then three names lifted. Sorting and then sorting again by a key
    function looks wasteful and is not: over fifty thousand files the second
    sort is nearly free, because the list is already in order, while building
    fifty thousand key tuples to do it costs twice what the whole job should.
    Measured: 45 ms that way, 89 ms with the first sort dropped, 35 ms like
    this.
    """
    head = [name for name in PINNED_FILES if name in names]
    return head + [name for name in sorted(names)
                   if name not in PINNED_FILES]


def worktree_root(cwd: str, runner: Callable[..., str | None] = run) -> str | None:
    """The top of the worktree this directory sits in, "" if it is not in
    one, and None when git did not answer.

    Everything else works from here, never from the agent's own directory.
    git reports a diff with paths relative to the root whatever directory it
    was run in, so a session standing in a subdirectory would otherwise get a
    file list and a diff that do not agree with each other.

    The None is asked here, once, rather than at every door that reads an
    empty answer: four doors each asked `git_answers` after it, and the ones
    that forgot read a stalled git as a worktree with nothing in it.
    """
    if not cwd or not os.path.isdir(cwd):
        return ""
    top = runner(["git", "-C", cwd, "rev-parse", "--show-toplevel"])
    if not top:
        return "" if git_answers(runner) else None
    # Only the newline. `strip()` took the space off `/x/proj `, and the tab
    # then read nothing -- or, when `/x/proj` also existed, another repository.
    return top.rstrip("\n")


def git_answers(runner: Callable[..., str | None] = run) -> bool:
    """Whether git is answering at all.

    `run` gives None for a command that failed and for one that could not be
    run, so `rev-parse --show-toplevel` coming back empty means either "this
    is not a repository" — which is an answer — or "git did not answer",
    which is not. Nothing in the output tells them apart.

    `git --version` does: it cannot fail inside a working git, and it stalls
    on the same stalled machine. It is asked only when another call has
    already come back with nothing, so a repository never pays for it.
    """
    return runner(["git", "--version"]) is not None


def changed_files(
    cwd: str, runner: Callable[..., str | None] = run
) -> set[str] | None:
    """The files git says differ from the last commit, untracked ones included.
    None when git did not answer."""
    told = status_names(cwd, runner)
    return None if told is None else told[0]


def status_names(
    cwd: str, runner: Callable[..., str | None] = run
) -> tuple[set[str], set[str]] | None:
    """What `git status` says: every changed name, untracked ones included,
    and the untracked ones alone. None when git did not answer.

    `-z` gives one NUL-terminated record per file: two status letters, a
    space, then the name. A rename or a copy is followed by one more record
    holding the old name on its own, with no status in front of it — so which
    record is which has to be counted, not guessed at from its length. Both
    names are kept: the agent touched both ends of a rename. An untracked
    file is `??`, and its name is the one `ls-files --others
    --exclude-standard` gives, a nested repository's `sub/` included.
    """
    out = runner(["git", "-C", cwd, "status", "--porcelain", "-z",
                  "--untracked-files=all"], timeout=LIST_TIMEOUT)
    if out is None:
        return None
    names: set[str] = set()
    untracked: set[str] = set()
    bare = False
    for record in out.split("\0"):
        if not record:
            continue
        if bare:
            names.add(record)           # the old name of the rename before it
            bare = False
            continue
        if len(record) > 3:
            names.add(record[3:])
            if record.startswith("?? "):
                untracked.add(record[3:])
        bare = "R" in record[:2] or "C" in record[:2]
    return names, untracked


def git_names(
    cwd: str, args: Sequence[str], runner: Callable[..., str | None] = run
) -> list[str] | None:
    """The names one `git ls-files` prints, or None when git did not answer.

    `-z` separates the names with a NUL, which is the only separator a file
    name cannot hold. The listing gets LIST_TIMEOUT: it is the one git call
    whose cost grows with the size of the repository.
    """
    out = runner(["git", "-C", cwd, "ls-files", "-z", *args],
                 timeout=LIST_TIMEOUT)
    if out is None:
        return None
    return [name for name in out.split("\0") if name]


def worktree_files(cwd: str, runner: Callable[..., str | None] = run,
                   root: str = "") -> Worktree:
    """Every file in a worktree, in the order the tab shows them.

    Three listings. What git tracks, the untracked files .gitignore does not
    cover, and the ignored files. `--directory` collapses a directory whose
    whole contents are ignored into one entry ending in a slash, so
    `node_modules` costs one name instead of a quarter of a million. Those
    entries are dropped here; naming a directory you cannot open helps nobody,
    and opening one is the tree's job. An ignored file that sits among tracked
    files — a generated header, `compile_commands.json` — is listed like any
    other, and that is the ignored file people look for.

    A listing git did not answer sets `failed`. The names it did answer are
    still returned: a short list with a warning beats no list at all. What
    must never happen is a failure that reads as an empty worktree, which is
    what a two second timeout over fifty thousand files used to look like.

    Only a changed file is stat'ed. A repository holds tens of thousands of
    files and tens of changed ones, and the modification time is only read to
    sort those few — asking the disk about every file, every poll, would cost
    far more than the answer is worth.
    """
    from concurrent.futures import ThreadPoolExecutor

    tree = Worktree()
    found = root or worktree_root(cwd, runner)
    if not found:
        # "No files" and "git did not answer" look the same here and mean
        # opposite things. Every other git call in this function sets
        # `failed`; this was the one door left open, and the page drew the
        # plain empty state over a worktree it simply could not read.
        tree.failed = found is None
        return tree
    tree.root = found
    # Three calls, at once: each walks the worktree, and one after another
    # they cost 138 ms on fifty thousand files where the slowest alone is 56.
    # The untracked names come from `status`, which prints every one of them
    # as a `??` record: an `ls-files --others --exclude-standard` beside it
    # walked the whole worktree again for the same names.
    with ThreadPoolExecutor(max_workers=3) as pool:
        tracked = pool.submit(git_names, tree.root, [], runner)
        ignored = pool.submit(git_names, tree.root,
                              ["--others", "--ignored", "--exclude-standard",
                               "--directory"], runner)
        status = pool.submit(status_names, tree.root, runner)
    told = status.result()
    parts = [tracked.result(), None if told is None else sorted(told[1]),
             ignored.result()]
    touched = None if told is None else told[0]
    tree.failed = touched is None or any(part is None for part in parts)
    names: set[str] = set()
    for part in parts:
        if part is not None:
            names.update(name for name in part if not name.endswith("/"))
    # The entries git collapsed. Each is a directory it declined to look
    # inside, and one of them is where the agent's own work is kept.
    skipped: list[str] = []
    for name in parts[2] or []:
        if name.endswith("/"):
            found, left = walk_ignored(tree.root, name, IGNORED_MAX)
            names.update(found)
            skipped.extend(left)
    tree.skipped = sorted(skipped)
    touched = touched or set()
    for name in in_order(names):
        entry = FileEntry(path=name, changed=name in touched)
        if entry.changed:
            try:
                entry.mtime = os.stat(os.path.join(tree.root, name)).st_mtime
            except OSError:
                continue    # listed but since deleted, or a link with no target
        tree.files.append(entry)
    tree.total = len(tree.files)
    if tree.total > FILES_MAX:
        del tree.files[FILES_MAX:]
        tree.cut = True
    return tree


def wire_json(data: Any) -> str:
    """Anything the daemon sends the page, as JSON: one spelling for the
    answers, the pushes and the stream's opening, which had three (#289).
    Not ASCII: a transcript in another script would be six bytes a letter on
    the stream, which is not compressed. So what writes it to the socket
    goes through `wire_bytes`.

    A dataclass goes out as its fields, read where they stand: `asdict`
    copied every one of the thousands of lines of a large diff before it
    was written, 343 ms of a 715 ms poll (#291).
    """
    return json.dumps(data, ensure_ascii=False, default=plain)


def plain(value: Any) -> Any:
    """What `json.dumps` writes for a value it does not know: a dataclass's
    fields, and anything else as text."""
    import dataclasses

    if dataclasses.is_dataclass(value) and not isinstance(value, type):
        return vars(value)
    return str(value)


def wire_bytes(text: str) -> bytes:
    """`wire_json`'s text as the bytes that go out. "replace", because a lone
    surrogate is reachable: Claude Code cuts a string between the halves of
    an emoji and writes the escape, and `json.loads` makes it a real one. A
    strict encode refused the whole answer, so one such line took a
    session's transcript down for good -- and in the open stream it raised a
    ValueError nothing caught, and `guarded` wrote an HTTP 500 into it.
    `page_json` is the other road out: it stands inside the page's
    `<script>`, so it is ASCII and needs no such care."""
    return text.encode("utf-8", "replace")


def answer_tag(text: str) -> str:
    """A short name for one answer, given it as `wire_json` wrote it."""
    import hashlib

    return hashlib.sha1(wire_bytes(text)).hexdigest()[:16]


def listing_tag(names: str) -> str:
    """A short name for one set of file names, given them already joined.

    The browser sends back the tag it already holds, and an answer that still
    has that tag carries no names at all. Names change when a file is added or
    removed, which is rare; which files have changed moves every few seconds,
    and that part is short.
    """
    import hashlib

    return hashlib.sha1(names.encode("utf-8", "replace")).hexdigest()[:16]


@dataclass
class Listing:
    """One worktree's file list, kept between requests."""

    tree: Worktree = field(default_factory=Worktree)
    tag: str = ""
    read_at: float = 0.0
    # Built with the listing, not per request. The names weigh 1.7 MB in a
    # large repository and joining them costs 6 ms, which a poll that is only
    # asking "have they moved?" should not pay.
    names: str = ""
    changed: dict[str, float] = field(default_factory=dict)


class Files:
    """The listings the daemon holds, one per worktree root.

    Asking git costs about a third of a second over fifty thousand files, the
    Files tab asks again every couple of seconds, and several browsers may be
    watching the same worktree. So one answer is kept and shared. A stale one
    is handed over at once and read again behind it, so only a worktree nobody
    has asked about yet makes anyone wait.

    The daemon owns one of these and never warms it in the tick. It does no
    file work until a browser asks, which is what keeps a worktree nobody is
    looking at free.
    """

    def __init__(self) -> None:
        import threading

        self.held: dict[str, Listing] = {}
        self.roots: dict[str, str] = {}     # a session's directory to its top
        self.langs: dict[str, str] = {}     # a file's bytes to what `file` said
        self.gates: dict[str, Any] = {}
        self.lock = threading.Lock()

    def root_of(self, cwd: str, runner: Callable[..., str | None]) -> str | None:
        """Where this directory's worktree starts, asked once.

        `git rev-parse` is cheap but it is still a process, and this ran on
        every poll of every browser for an answer that does not move.

        Only an answer is kept. git can fail for a moment — the call has a two
        second timeout, and a busy machine or a network filesystem can pass
        it — and an empty answer kept for ever meant one such moment left the
        worktree unreadable until the daemon was restarted. The same rule the
        listings keep: a git call that failed is not an answer.
        """
        with self.lock:
            known = self.roots.get(cwd)
        if known:
            return known
        found = worktree_root(cwd, runner)
        if found:
            with self.lock:
                self.roots[cwd] = found
        return found

    def language_of(
        self, target: Path, mtime: float, size: int,
        runner: Callable[..., str | None],
    ) -> str:
        """What `file` made of this one, asked once per version of it.

        The answer depends on the file's bytes and on nothing else, so asking
        again two seconds later is asking a question already answered. The
        open file is read on every poll of every browser, and this was the
        third process each of those paid for.

        The key carries the mtime and the size, which is the same cheap proxy
        for "the bytes changed" the rest of this program uses. An empty answer
        is kept as well, and that is most of the saving: `file` says
        `text/plain` for a suffix-less Python module, which is deliberately
        not in `BY_MIME`, so the common answer is no answer.
        """
        key = f"{target}\n{mtime}\n{size}"
        with self.lock:
            known = self.langs.get(key)
        if known is not None:
            return known
        found = sniff_language(target, runner)
        if found is None:
            # It did not answer. Asking again next poll costs a process; not
            # asking leaves the file grey until someone edits it.
            return ""
        with self.lock:
            # A reader moving through a worktree would otherwise keep every
            # file it opened. Nothing here is worth a second question, so the
            # oldest simply go.
            if len(self.langs) >= LANGS_KEPT:
                for old in list(self.langs)[:LANGS_KEPT // 2]:
                    self.langs.pop(old, None)
            self.langs[key] = found
        return found

    def gate(self, root: str) -> Any:
        """One lock per worktree, so two readers of one root do not both ask
        git while readers of other roots wait for neither."""
        import threading

        with self.lock:
            gate = self.gates.get(root)
            if gate is None:
                self.gates[root] = gate = threading.Lock()
            return gate

    def of(self, cwd: str, runner: Callable[..., str | None] = run) -> Listing:
        """The listing for the worktree this directory sits in."""
        root = self.root_of(cwd, runner)
        if not root:
            return Listing(tree=Worktree(failed=root is None))
        gate = self.gate(root)
        # What is held is asked for under the short lock, never the gate:
        # the gate is held for the whole of a re-read behind, up to four git
        # calls at `LIST_TIMEOUT`, and the poll after the one that started it
        # waited 4.4 s for a listing it already had.
        with self.lock:
            held = self.held.get(root)
        if held is None:
            with gate:                           # nothing to show; this waits
                held = self.held.get(root)       # unless a reader got it first
                if held is None:
                    return self.read(root, runner)
        if time.time() - held.read_at > LIST_FRESH:
            self.behind(root, runner, gate)      # something to show already
        return held

    def read(self, root: str, runner: Callable[..., str | None]) -> Listing:
        """Ask git. The caller holds this root's gate."""
        tree = worktree_files(root, runner, root=root)
        # NUL is the separator git uses, and the only one a file name cannot
        # hold.
        names = "\0".join(one.path for one in tree.files)
        fresh = Listing(
            tree=tree, names=names, tag=listing_tag(names),
            changed={one.path: one.mtime for one in tree.files if one.changed},
            read_at=time.time())
        with self.lock:
            self.held[root] = fresh
        return fresh

    def behind(self, root: str, runner: Callable[..., str | None],
               gate: Any) -> None:
        """Read it again in a thread of its own. The gate is what says one
        reader at a time, so nothing else has to say it."""
        import threading

        if not gate.acquire(blocking=False):
            return                      # someone is already reading this root

        def again() -> None:
            try:
                held = self.held.get(root)
                if held is None or time.time() - held.read_at > LIST_FRESH:
                    self.read(root, runner)
            except Exception as error:   # a bad read must not stop the daemon
                log(f"listing {root} failed: {error!r}")
            finally:
                gate.release()

        try:
            threading.Thread(target=again, daemon=True).start()
        except RuntimeError:            # no thread to be had; try again later
            gate.release()

    def forget(self, older_than: float) -> None:
        """Drop the listings nobody has asked for in a while. A listing holds
        every name in a repository, so they are not kept for ever."""
        cutoff = time.time() - older_than
        with self.lock:
            for root in list(self.held):
                if self.held[root].read_at < cutoff:
                    del self.held[root]
        # Only the names go. A gate is a lock and a root is a short string,
        # both bounded by how many worktrees this daemon has ever been asked
        # about, and dropping a gate a background reader still holds would
        # hand the next caller a different lock from the one in use.


def untracked_files(
    cwd: str, runner: Callable[..., str | None] = run
) -> list[str] | None:
    """The files git neither tracks nor ignores, in name order.

    `-z` separates the names with a NUL, which is the only separator a file
    name cannot hold. None when git did not answer: it used to come back as
    an empty list, and the Diff tab said nothing was untracked.
    """
    names = git_names(cwd, ["--others", "--exclude-standard"], runner)
    return None if names is None else sorted(names)


def is_listed(cwd: str, wanted: str, runner: Callable[..., str | None] = run) -> bool:
    """True when git offers this exact name: tracked, untracked, or ignored.
    It is the same question the listing answers, asked about one name so that
    reading a file does not cost a walk of the whole repository. An ignored
    file inside an ignored directory answers yes here although the listing
    collapses that directory to one entry; the guard decides what is safe to
    open, not what is worth showing.

    git reads what follows `--` as a pathspec, never as an option, and
    `:(literal)` in front of it turns off every other meaning a pathspec can
    carry. Without it a real file called `report[1].csv` is read as a
    character class and never found, while `*.py` matches files it was not
    asked about. With it the name means itself and nothing else, and the
    answer still has to come back spelled exactly as it was asked for.
    A pathspec that climbs out of the worktree makes git fail.
    """
    if not wanted:
        return False
    asked = ["--", ":(literal)" + wanted]
    out = runner(["git", "-C", cwd, "ls-files", "-z", "--cached", "--others",
                  "--exclude-standard", *asked])
    if wanted in (out or "").split("\0"):
        return True
    # The Files tab lists ignored files, so reading one has to be allowed.
    # It is the same question with the same three parts, asked second because
    # most files are not ignored and this walk is the more expensive one.
    out = runner(["git", "-C", cwd, "ls-files", "-z", "--others", "--ignored",
                  "--exclude-standard", *asked])
    return wanted in (out or "").split("\0")


#: What `file --mime-type` answers, and the highlighter's name for it.
#:
#: `text/x-c` is not here on purpose. libmagic uses it for anything C-shaped,
#: and it calls Rust and Go C source — measured, both of them. A file with no
#: suffix that is really C is rare; painting Rust as C is a confident lie, and
#: no paint beats a wrong one. The rest were checked against real files.
BY_MIME = {
    "text/x-script.python": "python",
    "text/x-python": "python",
    "text/x-shellscript": "bash",
    "text/x-perl": "perl",
    "text/x-ruby": "ruby",
    "text/x-php": "php",
    "text/x-lua": "lua",
    "text/x-awk": "awk",
    "text/x-c++": "cpp",
    "text/x-java": "java",
    "application/json": "json",
    "text/xml": "xml",
    "application/xml": "xml",
}


def sniff_language(
    path: Path, runner: Callable[..., str | None] = run
) -> str | None:
    """What `file` makes of a file whose name gives nothing away.

    Only asked when the name and the shebang both came up empty, so it costs a
    subprocess once, when a file is opened. `file` is the third and last
    command this program runs, after git and tmux, and a machine without it
    simply gets no answer — the page paints nothing, which is what it did
    before this existed.

    `None` is "it did not answer", and `""` is "it answered, and the answer is
    not one we paint". They look the same on the page and are not the same
    thing to remember: the first is worth asking again, the second never is.
    """
    answer = runner(["file", "-b", "--mime-type", "--", str(path)])
    if not answer:
        return None
    return BY_MIME.get(answer.strip().lower(), "")


def worktree_target(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None,
) -> Path | None:
    """The file a name from the page points at, or None.

    The name comes from the page, so it is input, not fact. It has to be a
    name git itself offers, and the file it points at has to stay inside the
    worktree once every link is followed. Those two checks together cover
    `..`, an absolute path and a symbolic link out of the tree, without having
    to guess at each of them. .claude/topics/safety.md: "A path out of the page is input
    too".

    Both readers come through here, so neither can be given one check and not
    the other.

    `held` is the daemon's `Files`, which remembers where the worktree starts
    — the one answer here that does not change between polls. **`is_listed` is
    not remembered** — it is the check that git still offers this name, and a
    cached yes would mean a file could still be read after it was taken out of
    the tree.

    **Nothing inside a `.git` is read**, although it is inside the worktree.
    git lists a tracked link such as `notes.md -> ../.git/config` and never
    what it points at, so both checks passed, and the Files tab showed the
    config -- with the token of a remote URL in it, which `remote_url` keeps
    off the page. Any part of the real path named `.git`, in any case: a
    filesystem that ignores case opens `.GIT/config` as `.git/config`.
    """
    root = held.root_of(cwd, runner) if held else worktree_root(cwd, runner)
    if not root or not is_listed(root, wanted, runner):
        return None
    target = inside(root, Path(root) / wanted)
    if target is None:
        return None
    try:
        parts = target.relative_to(Path(root).resolve()).parts
    except (OSError, ValueError):
        return None
    if any(part.lower() == ".git" for part in parts):
        return None
    return target


def read_worktree_bytes(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None,
) -> tuple[bytes, str] | None:
    """One file's own bytes and the type it is served with, or None.

    Only a name on `SHOWN_AS` — a picture, a video, a sound. The type comes
    from the end of the name and from nothing else, so the daemon never serves
    a document from its own origin, whatever a file holds.
    """
    kind = shown_as(wanted)
    if not kind:
        return None
    target = worktree_target(cwd, wanted, runner, held)
    if target is None:
        return None
    try:
        if not target.is_file() or target.stat().st_size > SHOWN_MAX_BYTES:
            return None
        return target.read_bytes(), kind
    except OSError:
        return None


def read_worktree_file(
    cwd: str, wanted: str, runner: Callable[..., str | None] = run,
    held: "Files | None" = None, have: str = "",
) -> FileText | None:
    """One file's content, or None.

    `held` also remembers what `file` made of a name that gives nothing away;
    the checks on the name itself are `worktree_target`'s.

    `have` is the `stamp` of the version the page shows. When the file still
    has it, the answer is `same` and nothing is read: the Files tab asks
    every two seconds, and sent up to 512 KB each time for a file nobody had
    touched -- a third of an ssh link. **Only after `worktree_target`**,
    which asks `is_listed` every time and never remembers it.
    """
    target = worktree_target(cwd, wanted, runner, held)
    if target is None:
        return None
    try:
        if not target.is_file():
            return None
        info = target.stat()
        stamp = f"{info.st_mtime_ns}.{info.st_size}"
        if have and have == stamp:
            return FileText(mtime=info.st_mtime, size=info.st_size,
                            stamp=stamp, same=True)
        found = FileText(mtime=info.st_mtime, size=info.st_size, stamp=stamp)
        found.shown = shown_as(wanted)
        if found.shown:
            # A picture, a video or a sound. Its text is not text, and the
            # page asks for its bytes on the other route -- so reading half a
            # megabyte off it here, every two seconds for as long as it is on
            # screen, would be for nothing.
            found.binary = True
            found.oversize = info.st_size > SHOWN_MAX_BYTES
            return found
        # One byte past the cap is enough to know the file runs past it.
        # Reading it whole first put a tracked video in memory every poll.
        with target.open("rb") as handle:
            raw = handle.read(FILE_MAX_BYTES + 1)
    except OSError:
        return None
    if b"\0" in raw[:BINARY_SNIFF]:
        found.binary = True
        return found
    found.text = raw[:FILE_MAX_BYTES].decode("utf-8", "replace")
    if len(raw) > FILE_MAX_BYTES:
        found.text += "\n\n… the rest of this file is not shown.\n"
    # Only when nothing cheaper can answer. A shebang is the page's to read,
    # and it is the common shape for a file with no suffix, so asking `file`
    # about one is a subprocess for an answer already in hand.
    if not Path(wanted).suffix and not raw.startswith(b"#!"):
        found.language = (
            held.language_of(target, found.mtime, len(raw), runner) if held
            else (sniff_language(target, runner) or ""))
    return found


@dataclass
class DiffLine:
    """One line of a hunk."""

    kind: str = "context"       # context, added or removed
    text: str = ""


@dataclass
class Hunk:
    """One `@@` block of a file's diff."""

    header: str = ""
    lines: list[DiffLine] = field(default_factory=list)


@dataclass
class DiffFile:
    """What happened to one file."""

    path: str = ""
    old_path: str = ""
    status: str = ""            # name_change fills it in when the file is done
    added: int = 0
    removed: int = 0
    binary: bool = False
    hunks: list[Hunk] = field(default_factory=list)
    #: What the file was and what it is, for a type change only (`status`
    #: "typechange"): "file", "link" or "submodule". See `join_type_change`.
    old_kind: str = ""
    new_kind: str = ""


@dataclass
class DiffSection:
    """One half of the Diff tab: the branch's work, or what is not committed."""

    name: str = ""
    title: str = ""
    #: One line saying exactly what this section is a diff of, in words rather
    #: than in git's. The titles used to be `origin/main...HEAD` and "not
    #: committed yet", which is precise and only readable if you already know
    #: what three dots mean -- so nobody could tell whether the tab was showing
    #: the last commit, the branch, the worktree, or some of each.
    about: str = ""
    files: list[DiffFile] = field(default_factory=list)
    #: The new side is a commit rather than the files on disk, so a comment's
    #: line has to be carried through to where it stands in the file now.
    at_commit: bool = False


@dataclass
class Commit:
    """One commit the Diff tab can show on its own."""

    sha: str = ""
    short: str = ""
    subject: str = ""
    author: str = ""
    when: float = 0.0
    #: The first parent, and empty for a root commit. A merge is shown
    #: against its first parent: that is what the merge brought in.
    parent: str = ""
    merge: bool = False


@dataclass
class DiffReport:
    """Everything the Diff tab shows for one worktree."""

    base: str = ""
    #: The base with no pick, and the names the reader can pick from, best
    #: first. See `pick_base`.
    base_auto: str = ""
    bases: list[str] = field(default_factory=list)
    sections: list[DiffSection] = field(default_factory=list)
    untracked: list[str] = field(default_factory=list)
    cut: bool = False
    failed: bool = False    # git did not answer; "nothing changed" would lie
    #: HEAD and the base have no commit in common, so there is no committed
    #: half: an orphan branch, or a shallow clone that does not reach back to
    #: where the branch began. git said so; it is not a failure.
    unrelated: bool = False
    #: What the reader can pick, newest first. The branch's own commits, or
    #: when it has none -- a session working on the default branch itself --
    #: the last few commits of HEAD, and then `recent` says so.
    commits: list[Commit] = field(default_factory=list)
    recent: bool = False
    #: What is shown: "" for everything, "uncommitted", or one commit's sha.
    of: str = ""
    #: A commit the page asked for that is not on the list any more. An agent
    #: that amends or rebases takes the commit away under the reader, and the
    #: tab then shows everything and says why, rather than nothing.
    gone: str = ""
    #: From the commit shown to the files on disk, for the files it touched.
    #: A comment belongs to a line of the file as it is now, and this is the
    #: map there -- what the uncommitted section is for the committed one.
    since: list[DiffFile] = field(default_factory=list)
    #: The commit message under its subject, for the commit shown. Asked
    #: for that one commit only: a hundred bodies on every poll would be
    #: sent for the one the reader is looking at.
    body: str = ""


#: What git writes after a backslash inside a quoted path. Anything else it
#: escapes as `\\ooo`, one octal byte at a time.
QUOTE_ESCAPES = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r",
                 "t": "\t", "v": "\v", '"': '"', "\\": "\\"}


def unquote_path(text: str) -> str:
    """Undo git's C-style quoting of a path, if it is quoted.

    `core.quotePath=false` only stops the quoting of bytes above 0x80. A path
    holding a quote, a backslash or a control character is quoted whatever
    that setting says, and then the whole thing, `a/` prefix and all, sits
    inside the quotes. Left alone, `we"ird.txt` came out of a diff as
    `"b/we\\"ird.txt"` — a name the Files tab never produces, so the same line
    had two different anchors in the two tabs and a plain edit was reported as
    a rename.
    """
    if len(text) < 2 or not text.startswith('"') or not text.endswith('"'):
        return text
    body = text[1:-1]
    out = bytearray()
    at = 0
    while at < len(body):
        if body[at] != "\\":
            out += body[at].encode("utf-8")
            at += 1
            continue
        at += 1
        if at >= len(body):
            break
        mark = body[at]
        digits = body[at:at + 3]
        # Three octal digits and nothing else. `int(s, 8)` reads "1_2" as ten
        # and takes leading spaces, neither of which git ever wrote.
        if len(digits) == 3 and all(one in "01234567" for one in digits):
            out.append(int(digits, 8))
            at += 3
            continue
        out += QUOTE_ESCAPES.get(mark, mark).encode("utf-8")
        at += 1
    # `run` reads git the same way, so a byte that is not UTF-8 looks the same
    # here as it does in a file listing.
    return out.decode("utf-8", "replace")


def diff_header_paths(line: str) -> tuple[str, str]:
    """The old and new path out of a `diff --git a/old b/new` line.

    A file name holding ` b/` makes this line ambiguous, which is why git also
    writes `---` and `+++` lines. Those are read when they come; this is what
    a file with no content change, such as a plain rename, is left with.

    Either side may be quoted, and a quoted side starts with `"b/` rather than
    `b/`, so that is looked for first.
    """
    rest = line[len("diff --git "):]
    # Not a rename, so both sides are one name, and the line splits in the
    # middle. The search for ` b/` below found the last one, and a folder
    # named `Plan b` put it inside the name: a binary or a mode change, which
    # has no `---`/`+++` to put it right, came out as a rename to `logo.png`.
    half = len(rest) // 2
    if len(rest) % 2 and rest[half] == " ":
        old, new = rest[:half], rest[half + 1:]
        if (old.lstrip('"')[:2], new.lstrip('"')[:2]) == ("a/", "b/") and \
                diff_side(old) == diff_side(new):
            return diff_side(old), diff_side(new)
    at = rest.rfind(' "b/')
    if at == -1:
        at = rest.rfind(" b/")
    if at == -1:
        return "", rest
    return diff_side(rest[:at]), diff_side(rest[at + 1:])


def diff_side(text: str) -> str:
    """The path out of a `--- a/path` or `+++ b/path` line. /dev/null is none."""
    if text == "/dev/null":
        return ""
    text = unquote_path(text)
    return text[2:] if text[:2] in ("a/", "b/") else text


#: The line counts of a hunk's header, `@@ -1,4 +1,5 @@`. A count left out is 1.
HUNK_COUNTS = re.compile(r"@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@")


def parse_diff(text: str) -> list[DiffFile]:
    """Turn `git diff` output into files, hunks and lines.

    Which lines are headers depends on where they are. Inside a hunk the first
    character is the only thing that matters, because the line after it is a
    line of the file: removing `-- a comment` writes `--- a comment`, which
    read as a header renamed the file to "a comment" and swallowed the rest of
    the hunk. Only `diff --git` and `@@` can start something new, and neither
    can be mistaken for content — content always carries its own first
    character in front.

    Only what the page shows is read. The index line, the mode lines and
    `\\ No newline at end of file` are passed over -- except `new file mode`
    and `deleted file mode`, which are all that says a file with no lines,
    empty or binary, came or went.

    Split on `\\n` and nothing else. `str.splitlines()` also breaks on a form
    feed, a vertical tab, `\\x1c`-`\\x1e` and `\\u0085`, and git does not escape
    any of those inside diff content — it only quotes paths. One form feed in
    a source line made every line after it in the hunk count one too high, so
    the Diff tab showed wrong numbers, the Files tab disagreed with it, and a
    review comment anchored to a line nobody commented on.
    """
    files: list[DiffFile] = []
    current: DiffFile | None = None
    hunk: Hunk | None = None
    left = [-1, -1]          # old and new lines the hunk still has to come
    # The mode of a file that went and of one that came, by the entry's
    # place in `files`: what `join_type_change` needs to see a type change.
    gone: dict[int, str] = {}
    came: dict[int, str] = {}
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()       # the newline that ends the last line, not a line
    for line in lines:
        if line.startswith("diff --git "):
            old, new = diff_header_paths(line)
            current = DiffFile(path=new, old_path=old)
            hunk = None
            files.append(current)
        elif current is None:
            continue        # a preamble git only writes for a combined diff
        elif line.startswith("@@"):
            hunk = Hunk(header=line)
            current.hunks.append(hunk)
            # The hunk ends when the lines its header counts have come. A
            # line after that is not a line of the file: `diff.submodule=log`
            # writes `  > message` lines with no header of their own, and each
            # one was read as context, so a file of ten lines had an eleventh.
            # A header that does not read is never ended early.
            counts = HUNK_COUNTS.match(line)
            left = ([int(counts.group(1) or 1), int(counts.group(2) or 1)]
                    if counts else [-1, -1])
        elif hunk is not None:
            if line.startswith("+"):
                current.added += 1
                hunk.lines.append(DiffLine("added", line[1:]))
                left[1] -= 1
            elif line.startswith("-"):
                current.removed += 1
                hunk.lines.append(DiffLine("removed", line[1:]))
                left[0] -= 1
            elif line.startswith(" ") or not line:
                hunk.lines.append(DiffLine("context", line[1:]))
                left[0] -= 1
                left[1] -= 1
            # anything else is `\\ No newline at end of file`
            if left[0] == 0 and left[1] == 0:
                hunk = None
        elif line.startswith("--- "):
            # git ends a name holding a space with a TAB here, for GNU patch.
            # Kept, the Diff tab's `foo bar.txt\t` was not the Files tab's
            # `foo bar.txt`: one line, two anchors. A name that really ends
            # in a tab is quoted, so this one is always git's.
            current.old_path = diff_side(line[4:].removesuffix("\t"))
        elif line.startswith("+++ "):
            # Empty means the file is gone.
            current.path = diff_side(line[4:].removesuffix("\t"))
        elif line.startswith("new file mode "):
            # An empty or a binary file has no `---`/`+++` to say it is new,
            # and the `diff --git` line names it twice: it read as modified.
            current.old_path = ""
            came[len(files) - 1] = line[len("new file mode "):].strip()
        elif line.startswith("deleted file mode "):
            current.path = ""       # `name_change` puts the name back
            gone[len(files) - 1] = line[len("deleted file mode "):].strip()
        elif line.startswith("rename from "):
            current.old_path = unquote_path(line[len("rename from "):])
        elif line.startswith("rename to "):
            current.path = unquote_path(line[len("rename to "):])
        elif line.startswith("Binary files ") or line.startswith("GIT binary patch"):
            current.binary = True
    for one in files:
        name_change(one)
    return join_type_change(files, gone, came)


#: What a git mode says a path is. Every other mode is a file: 100644 and
#: 100755 only differ by the execute bit, which git shows as a mode change.
MODE_KINDS = {"120000": "link", "160000": "submodule"}


def join_type_change(files: list[DiffFile], gone: dict[int, str],
                     came: dict[int, str]) -> list[DiffFile]:
    """One entry for a path whose type changed, not two.

    git writes a file that became a link -- or a link that became a file, or
    a submodule either way -- as two diffs of the same path: one that deletes
    it, with `deleted file mode 100644`, and one that adds it, with `new file
    mode 120000`. Two entries with one path shared one `data-key` in the
    list, so both rows were marked together and a click on either went to
    the second block; `whole_file_diff` found the first; and a comment on the
    file stood on both blocks, because the anchor is the path.

    The two halves are next to each other, and git writes nothing else that
    way without `-B`, which `git_diff` does not pass. The kinds must differ
    too, so nothing else is ever joined. The joined entry has one hunk, the
    old lines removed and then the new lines added, `@@ -1,N +1,M @@`, as a
    file rewritten whole is drawn: the old side is numbered from 1 and the
    new side from 1, so a `+` stands on the new lines with the numbers the
    file has on disk, and a removed line gets none, as everywhere.
    """
    joined: list[DiffFile] = []
    at = 0
    while at < len(files):
        one = files[at]
        after = files[at + 1] if at + 1 < len(files) else None
        was = MODE_KINDS.get(gone.get(at, ""), "file")
        now = MODE_KINDS.get(came.get(at + 1, ""), "file")
        if (after is None or one.status != "deleted" or after.status != "added"
                or at not in gone or at + 1 not in came
                or one.path != after.path or was == now):
            joined.append(one)
            at += 1
            continue
        lines = [line for hunk in one.hunks + after.hunks for line in hunk.lines]
        old = sum(1 for line in lines if line.kind == "removed")
        new = sum(1 for line in lines if line.kind == "added")
        # A side with no lines is `0,0`, as git writes an empty one.
        header = (f"@@ -{'1' if old else '0'},{old}"
                  f" +{'1' if new else '0'},{new} @@")
        joined.append(DiffFile(
            path=one.path, old_path=one.path, status="typechange",
            added=one.added + after.added, removed=one.removed + after.removed,
            # A binary half has no lines; the other half's are still shown.
            binary=(one.binary or after.binary) and not lines,
            hunks=[Hunk(header=header, lines=lines)] if lines else [],
            old_kind=was, new_kind=now))
        at += 2
    return joined


def name_change(one: DiffFile) -> None:
    """Say what happened to a file, from the paths the diff gave it."""
    if not one.old_path:
        one.status = "added"
    elif not one.path:
        one.status = "deleted"
        one.path = one.old_path
    elif one.old_path != one.path:
        one.status = "renamed"
    else:
        one.status = "modified"


#: How many branches the Diff tab's base picker offers, best first.
BASES_OFFERED = 50

#: The names a base is looked for under when git cannot rank them.
BASE_NAMES = ("origin/main", "origin/master", "main", "master")


@dataclass
class BaseChoice:
    """What a branch's own work is measured against, and what else it could be."""

    name: str = ""
    ref: str = ""             # `name` in full, which is what git is given
    failed: bool = False      # git did not answer; "no base" would lie
    detected: str = ""        # the base with nothing picked
    offered: list[str] = field(default_factory=list)
    head: str = ""            # HEAD's sha, "" when git did not say
    tip: str = ""             # the base's own sha, from the same listing


def pick_base(cwd: str, runner: Callable[..., str | None] = run,
              wanted: str = "", ranks: dict[Any, Any] | None = None) -> BaseChoice:
    """The commit a branch's own work is measured against.

    **The branch it was cut from, found by counting.** A backport is cut
    from a release branch and goes back into it, so measured against
    `origin/HEAD` it showed every commit the release lacks. Every branch is
    counted against HEAD (`%(ahead-behind:HEAD)`, git 2.41) and ranked: the
    fewest of HEAD's commits it lacks, then `origin/HEAD` and the usual
    names, then the fewest it has that HEAD lacks -- so a colleague's branch
    cut at the same point is not named over the default branch.

    **A branch that holds all of HEAD is never the base**, the default one
    aside: a child branch, a backup, a detached HEAD's own branch, a copy
    pushed under another name, local `main` ahead of `origin/main`. There is
    nowhere for the work to go there, and each won the ranking with nothing
    to show. The default branch stays, because an agent working on it with
    everything pushed is measured against it, and shown its recent commits.
    The branch's own copy on a remote is left out by name.

    **The ranking is kept** in `ranks`, the daemon's, under HEAD and a
    listing of every ref with its commit: the listing is cheap and the count
    walks history, which on a large repository took most of two seconds on
    every poll. A pick (`wanted`, from the page) is checked against the
    listing, never against the ranking, so a ranking git could not finish
    never drops it; and it is used only when git listed that exact name.

    `origin/HEAD` is only ever a name to prefer, never taken on its word: a
    remote that renamed its default branch leaves it naming a branch that is
    gone. A git that cannot rank falls back to the usual names, and so does
    one that could not say which branch HEAD is.
    """
    choice = BaseChoice()
    listing = runner(["git", "-C", cwd, "for-each-ref",
                      "--format=%(refname)%09%(refname:short)%09%(objectname)",
                      "refs/remotes/", "refs/heads/"])
    if listing is None:
        choice.failed = True
        return choice
    refs: dict[str, str] = {}
    shas: dict[str, str] = {}
    for line in listing.splitlines():
        full, _, rest = line.partition("\t")
        name, _, sha = rest.partition("\t")
        if name and not full.endswith("/HEAD"):
            refs[name] = full
            shas[name] = sha.strip()
    head = (runner(["git", "-C", cwd, "symbolic-ref", "--quiet", "--short",
                    "refs/remotes/origin/HEAD"]) or "").strip()
    head = head if head in refs else ""
    named = runner(["git", "-C", cwd, "symbolic-ref", "--quiet", "--short",
                    "HEAD"])
    # None is a detached HEAD, and a git that timed out too. Only the second
    # loses the branch's own name, which is what keeps its copy on a remote
    # out: that copy lacks only the commits not pushed yet, so it ranked
    # first, and one unpushed commit read as the whole of the branch's work.
    # `--abbrev-ref` says `HEAD` for a detached one and fails only when git
    # does -- asked only then, so a branch never pays for it.
    lost = False
    if named is None:
        again = runner(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"])
        if again is None:
            lost = True
        elif again.strip() != "HEAD":
            named = again
    current = (named or "").strip()
    prefer = ([head] if head else []) + [one for one in BASE_NAMES if one != head]
    default = next((one for one in prefer if one in refs), "")
    at = (runner(["git", "-C", cwd, "rev-parse", "--verify", "--quiet", "HEAD"])
          or "").strip()
    key = (cwd, at, current, hash(listing))
    # One read: the request threads share `ranks`, and a `clear()` between
    # `key in ranks` and `ranks[key]` raised KeyError, which answered 500.
    counts = ranks.get(key) if ranks is not None else None
    if counts is None:
        counted = runner(["git", "-C", cwd, "for-each-ref",
                          "--format=%(refname:short)%09%(ahead-behind:HEAD)",
                          "refs/remotes/", "refs/heads/"],
                         timeout=DIFF_TIMEOUT) if at else None
        if counted is not None:
            counts = {}
            for line in counted.splitlines():
                name, _, both = line.partition("\t")
                numbers = both.split()
                if len(numbers) == 2 and numbers[0].isdigit() and numbers[1].isdigit():
                    counts[name] = (int(numbers[0]), int(numbers[1]))
        # A count git failed on is not kept. Kept, one timeout named the
        # fallback base -- `main` for a branch cut from `release` -- until
        # HEAD or a ref moved.
        if ranks is not None and counts is not None:
            if len(ranks) > 64:
                ranks.clear()
            ranks[key] = counts
    if counts and not lost:
        ranked: list[tuple[int, int, int, str]] = []
        for name, full in refs.items():
            if name not in counts:
                continue
            ahead, behind = counts[name]
            branch = (full.split("/", 3)[3] if full.startswith("refs/remotes/")
                      and full.count("/") >= 3 else name)
            if name != default and (behind == 0 or (current and branch == current)):
                continue
            place = prefer.index(name) if name in prefer else len(prefer)
            ranked.append((behind, place, ahead, name))
        ranked.sort()
        names = [one[3] for one in ranked]
    else:
        names = [one for one in prefer if one in refs]
    choice.detected = names[0] if names else ""
    choice.offered = names[:BASES_OFFERED]
    if wanted and wanted in refs:
        choice.name = wanted
        if wanted not in choice.offered:
            choice.offered.append(wanted)     # picked, so it is on the list
    else:
        choice.name = choice.detected
    # git is given the full name, never the short one. A branch may be named
    # `--output=x`: git takes `update-ref refs/heads/--output=x`, the short
    # name reached the argv of `git diff` as an option, and git wrote the
    # diff into a file of that name. A full name starts with `refs/`.
    choice.ref = refs.get(choice.name, "")
    choice.head, choice.tip = at, shas.get(choice.name, "")
    return choice


def git_diff(
    cwd: str, args: Sequence[str], runner: Callable[..., str | None] = run
) -> tuple[str | None, bool]:
    """Run one diff. Returns its text, and whether it had to be cut short.

    None is not the same as "": git failed, timed out, or was killed. An empty
    diff says nothing changed, and saying that when we do not know is worse
    than saying nothing — it is the answer a reader would act on.

    Every part of the output that `parse_diff` reads is pinned here, because
    a reader's config changes it. `diff.mnemonicPrefix` wrote `c/` and `w/`,
    so every file read as a rename; `diff.noprefix` wrote no prefix, so a
    file under a folder named `b/` lost that folder. `diff.renames=copies`
    made a copy read as a rename. `diff.submodule=log` wrote a submodule's
    log into the file before it. A `textconv` in `.gitattributes` gave the
    lines of the converted text, not the lines the Files tab reads.

    `diff.autoRefreshIndex=false` because `git diff` writes a refreshed
    index back under `.git/index.lock` whatever `GIT_OPTIONAL_LOCKS` says
    (measured, git 2.43), when a file's stat moved and its bytes did not.
    That is the lock `run` keeps `status` off, and the agent's `git add`
    needs it. The diff is the same without the refresh.
    """
    out = runner(
        ["git", "-C", cwd, "-c", "core.quotePath=false",
         "-c", "diff.autoRefreshIndex=false",
         "diff", "--no-color", "--no-ext-diff", "--no-textconv",
         "--src-prefix=a/", "--dst-prefix=b/", "-M", "--submodule=short",
         *args],
        timeout=DIFF_TIMEOUT,
    )
    if out is None:
        return None, False
    # In bytes, and back to the last newline. `run` hands back text, so the
    # cap used to count code points and let a CJK diff through at about four
    # times the size — while `FILE_MAX_BYTES` measures real bytes, so the two
    # caps disagreed about what they meant. And a cut that landed inside a
    # `diff --git` line parsed as a file that does not exist, reported as a
    # rename, at the bottom of the tab: `cut` says something was dropped, not
    # that the last entry is fiction.
    if len(out) * 4 <= DIFF_MAX_BYTES:     # too small to be over, whatever is in it
        return out, False
    raw = out.encode("utf-8")
    if len(raw) <= DIFF_MAX_BYTES:
        return out, False
    whole = raw[:DIFF_MAX_BYTES].rpartition(b"\n")[0]
    return (whole + b"\n" if whole else b"").decode("utf-8", "replace"), True


#: How many commits the Diff tab offers. A branch longer than this is read
#: from the top: the newest work is the work being asked about.
COMMITS_SHOWN = 100

#: With no commit of its own on the branch, this many of HEAD's last ones.
COMMITS_RECENT = 30

#: Lines of context around a change. git's own default, passed explicitly so a
#: reader's `diff.context` cannot change what the page counts on.
DIFF_CONTEXT = 3

#: Context for a file shown whole: more lines than any file here has, so
#: git's answer holds every line of the file between the changes.
WHOLE_CONTEXT = 1_000_000

#: The most of a commit message's body the Diff tab is sent. A body is prose
#: somebody wrote; one longer than this is a pasted log, and the page is not
#: the place to read it.
COMMIT_BODY_MAX = 20_000

#: Between the fields of one commit, and after each commit, in `git log`.
#: Neither can be in a name or a subject a person typed.
LOG_FIELD = "\x1f"
LOG_END = "\x1e"


def read_commits(text: str) -> list[Commit]:
    """`git log` in the format `branch_commits` asks for, as commits."""
    found: list[Commit] = []
    for record in text.split(LOG_END):
        parts = record.lstrip("\n").split(LOG_FIELD, 5)
        if len(parts) != 6 or not parts[0]:
            continue
        sha, short, when, author, parents, subject = parts
        try:
            stamp = float(when)
        except ValueError:
            stamp = 0.0
        above = parents.split()
        found.append(Commit(sha=sha, short=short, subject=subject,
                            author=author, when=stamp,
                            parent=above[0] if above else "",
                            merge=len(above) > 1))
    return found


def branch_commits(
    root: str, base: str, runner: Callable[..., str | None] = run
) -> tuple[list[Commit] | None, bool]:
    """The commits a reader can pick, and whether they are HEAD's last ones.

    `base..HEAD` with two dots: the commits HEAD has and the base has not,
    which is the same work the committed section shows with three. A session
    working on the default branch has none, and there the last few commits of
    HEAD are what it did. None when git did not answer.

    `base` is a full ref name (`BaseChoice.ref`), so it cannot be read as an
    option. The `--` after the revisions says no file is meant: without it,
    a file named `HEAD` at the top of the worktree made git refuse the
    argument as ambiguous, and the whole Diff tab failed on every poll.
    """
    shape = LOG_FIELD.join(("%H", "%h", "%at", "%an", "%P", "%s")) + LOG_END
    ask = ["git", "-C", root, "log", "--no-color", "--no-show-signature",
           "--format=" + shape]
    if base:
        out = runner([*ask, "-n", str(COMMITS_SHOWN), base + "..HEAD", "--"])
        if out is None:
            return None, False
        if out.strip():
            return read_commits(out), False
    out = runner([*ask, "-n", str(COMMITS_RECENT), "HEAD", "--"])
    return (None if out is None else read_commits(out)), True


def has_head(root: str, runner: Callable[..., str | None] = run) -> bool:
    """Whether the repository has a commit yet. `git init` leaves it without
    one, and everything asked of `HEAD` fails until the first commit."""
    return runner(["git", "-C", root, "rev-parse", "--verify", "--quiet",
                   "HEAD"]) is not None


def no_common_commit(root: str, ref: str,
                     runner: Callable[..., str | None] = run) -> bool:
    """Whether HEAD and `ref` have no commit in common.

    `git diff ref...HEAD` fails with "no merge base" on an orphan branch,
    such as `gh-pages`, and in a shallow clone whose history stops before the
    branch began. That is an answer. Taken as a failure, the tab said "git
    did not answer" on every poll, for ever. `merge-base` exits 1 for "none",
    and prints nothing; any other failure is still None. Asked only after
    the diff failed, so a branch with a base never pays for it.
    """
    return runner(["git", "-C", root, "merge-base", ref, "HEAD"],
                  ok=(0, 1)) == ""


def empty_tree(root: str, runner: Callable[..., str | None] = run) -> str:
    """The tree with nothing in it, which a root commit is measured against.

    Asked, not written down: a repository using SHA-256 names it differently.
    """
    out = runner(["git", "-C", root, "hash-object", "-t", "tree", "/dev/null"])
    return (out or "").strip()


def worktree_diff(cwd: str, runner: Callable[..., str | None] = run,
                  of: str = "", base: str = "",
                  ranks: dict[Any, Any] | None = None,
                  held: dict[Any, Any] | None = None,
                  root: str | None = None) -> DiffReport:
    """What this worktree has changed, in two parts, or one commit of it.

    Committed: `git diff <base>...HEAD`, the branch's own work. The three dots
    leave out whatever landed on the base after the branch started, so what is
    shown is what this agent did. Uncommitted: `git diff HEAD`, what it changed
    and has not committed. git shows no untracked file in either, so their
    names are listed on their own.

    `of` narrows it: "uncommitted" is the second part alone, and a sha is that
    one commit against its first parent. A sha is used only when it is one
    `branch_commits` listed -- it came from the page, and the page is input.

    **What the branch committed is kept in `held`**, the daemon's, under the
    base's sha and HEAD's: the tab asks every five seconds, and on a branch
    of 2,500 files the log, `git diff <base>...HEAD` and its parse cost
    about 300 ms of every poll for an answer that moves only when one of
    the two does (#291). Only an answer git gave whole is kept, as `ranks`
    keeps only a count git gave. `root` is the worktree's top when the
    caller knows it already (`Files.root_of`).
    """
    report = DiffReport()
    root = root or worktree_root(cwd, runner)
    if not root:
        # Not a repository, or git did not answer. Unasked, a timeout read
        # as "nothing changed".
        report.failed = root is None
        return report

    def ask(*args: str) -> tuple[str | None, bool]:
        # Three lines of context, said rather than assumed: the page reads
        # fewer than three after the last change as the end of the file, and
        # a reader's `diff.context` would otherwise move that line. The `--`
        # says the arguments are revisions: a file named `HEAD` made git
        # refuse `HEAD` as ambiguous, and the tab failed on every poll.
        return git_diff(root, [*args, f"-U{DIFF_CONTEXT}", "--"], runner)

    def section(name: str, title: str, about: str, *args: str,
                answer: tuple[str | None, bool] | None = None,
                parsed: list[DiffFile] | None = None) -> list[DiffFile]:
        if parsed is None:
            text, cut = answer or ask(*args)
            report.cut = report.cut or cut
            report.failed = report.failed or text is None
            files = parse_diff(text or "")
        else:
            files = parsed
        report.sections.append(
            DiffSection(name=name, title=title, about=about, files=files,
                        at_commit=name != "uncommitted"))
        return files

    choice = pick_base(root, runner, base, ranks)
    report.base, lost = choice.name, choice.failed
    report.base_auto, report.bases = choice.detected, choice.offered
    key = ((root, choice.ref, choice.tip, choice.head)
           if held is not None and choice.ref and choice.tip and choice.head
           and not lost else None)
    kept = held.get(key) if held is not None and key else None
    if kept is not None:
        commits, report.recent = kept["commits"], kept["recent"]
    else:
        commits, report.recent = branch_commits(root, choice.ref, runner)
        if key and held is not None and commits is not None:
            if len(held) > 64:
                held.clear()
            held[key] = kept = {"commits": commits, "recent": report.recent}
    # A repository with no commit yet has no HEAD, so the log fails: git
    # answering "there is none", not failing to answer. Asked only on the
    # failure path, so a repository with commits never pays for it.
    unborn = commits is None and not has_head(root, runner) and git_answers(runner)
    if unborn:
        commits = []
    report.failed = lost or commits is None
    report.commits = commits or []
    if of and of != "uncommitted":
        if commits is None:
            # git did not answer, so nothing is known about the commit --
            # least of all that it is gone. Taken for gone, the pane said it
            # was "probably amended or rebased away" and dropped the pick.
            return report
        one = next((each for each in report.commits if each.sha == of), None)
        if one is None:
            report.gone = of
        else:
            report.of = of
            parent = one.parent or empty_tree(root, runner)
            if not parent:
                report.failed = True
                return report
            body = runner(["git", "-C", root, "show", "-s", "--no-color",
                           "--no-show-signature", "--format=%b", one.sha, "--"])
            report.failed = report.failed or body is None
            report.body = (body or "").strip()[:COMMIT_BODY_MAX]
            files = section(
                "commit", one.subject or one.short,
                f"what {'merge' if one.merge else 'commit'} {one.short}"
                f" by {one.author} changed"
                + (", against its first parent" if one.merge else ""),
                parent, one.sha)
            # Only the files this commit touched, so the map costs what the
            # commit costs and not what every later commit does.
            paths = [":(literal)" + each.path for each in files
                     if each.path and each.status != "deleted"]
            if paths:
                text, _ = git_diff(root, [one.sha, "--", *paths], runner)
                report.failed = report.failed or text is None
                report.since = parse_diff(text or "")
            return report
    if of == "uncommitted":
        report.of = of
    elif choice.ref and not unborn:
        about = (f"every commit this branch has that {report.base} has not"
                 f" \u2014 and nothing that landed on {report.base} since")
        if kept is not None and "committed" in kept:
            files, cut, report.unrelated = kept["committed"]
            report.cut = report.cut or cut
            if not report.unrelated:
                section("committed", "committed on this branch", about,
                        parsed=files)
        else:
            answer = ask(choice.ref + "...HEAD")
            # No commit in common is git's answer, and the half is left out:
            # the page says why. Anything else that failed is still a failure.
            files = []
            if answer[0] is None and no_common_commit(root, choice.ref, runner):
                report.unrelated = True
            else:
                files = section("committed", "committed on this branch", about,
                                answer=answer)
            if kept is not None and key and held is not None and (
                    report.unrelated or answer[0] is not None):
                held[key] = dict(kept, committed=(files, answer[1],
                                                  report.unrelated))
    # With no commit, against the empty tree: the staged files are in the
    # index, so they are not untracked, and `HEAD` is not there to diff to.
    section("uncommitted", "not committed yet",
            "what the files on disk hold that the last commit does not"
            if not unborn else "every file git has been given, as there is"
            " no commit yet",
            empty_tree(root, runner) if unborn else "HEAD")
    loose = untracked_files(root, runner)
    report.failed = report.failed or loose is None
    report.untracked = (loose or [])[:UNTRACKED_SHOWN]
    return report


@dataclass
class WholeFile:
    """One file of one half of the Diff tab, with every line of it.

    What the page shows between two changes when the reader asks for more.
    It is the same diff with all of the file as context, so it has the lines
    of the same side the half shows -- HEAD for the branch's work, a commit
    for one commit, the disk for what is not committed -- and no second way
    to read a file at a revision is needed.
    """

    file: DiffFile | None = None
    cut: bool = False
    failed: bool = False


def whole_file_diff(cwd: str, section: str, path: str, old_path: str = "",
                    of: str = "",
                    runner: Callable[..., str | None] = run,
                    base: str = "",
                    ranks: dict[Any, Any] | None = None) -> WholeFile:
    """One file's diff in one section, with the whole file as context.

    `section`, `path` and `of` come from the page. The section picks the
    arguments from a fixed list; a commit is used only when `branch_commits`
    lists it, as in `worktree_diff`; and the paths go to git as literal
    pathspecs after `--`, so a name is only ever a name inside the
    repository, never an option and never a pattern.
    """
    found = WholeFile()
    if not path:
        return found
    root = worktree_root(cwd, runner)
    if not root:
        found.failed = root is None
        return found
    # The full name, as `worktree_diff` gives git: a short one can start
    # with `-` and be read as an option.
    choice = (pick_base(root, runner, base, ranks)
              if section in ("committed", "commit") else BaseChoice())
    base, lost = choice.ref, choice.failed
    if lost:
        found.failed = True
        return found
    if section == "uncommitted":
        # Before the first commit there is no HEAD, and `worktree_diff`
        # showed this half against the empty tree.
        spec = ["HEAD" if has_head(root, runner) else empty_tree(root, runner)]
    elif section == "committed" and base:
        spec = [base + "...HEAD"]
    elif section == "commit":
        commits, _ = branch_commits(root, base, runner)
        one = next((each for each in commits or [] if each.sha == of), None)
        if one is None:
            found.failed = commits is None
            return found
        parent = one.parent or empty_tree(root, runner)
        if not parent:
            found.failed = True
            return found
        spec = [parent, one.sha]
    else:
        return found
    # Both names of a renamed file, or git sees one added and nothing else.
    names = [path] + ([old_path] if old_path and old_path != path else [])
    text, found.cut = git_diff(
        root, [*spec, f"-U{WHOLE_CONTEXT}", "--",
               *(":(literal)" + name for name in names)], runner)
    if text is None:
        found.failed = True
        return found
    found.file = next((each for each in parse_diff(text)
                       if each.path == path), None)
    return found


# --- status: the status line payload, which carries name and context ---------


def status_from_payload(payload: dict[str, Any], now: float | None = None) -> Status:
    """Pick the few fields wostuast shows out of the status line JSON."""
    def nested(key: str) -> dict[str, Any]:
        value = payload.get(key)
        return value if isinstance(value, dict) else {}

    # Named field by field, like `read_ask`: a status payload is large and
    # growing, and a field nobody has read must not reach the page.
    return Status(
        ts=now if now is not None else time.time(),
        name=str(payload.get("session_name") or ""),
        model=str(nested("model").get("display_name") or ""),
        context_pct=opt_float(nested("context_window").get("used_percentage")),
        cost_usd=opt_float(nested("cost").get("total_cost_usd")),
        agent=str(nested("agent").get("name") or ""),
        effort=str(nested("effort").get("level") or ""),
        model_id=str(nested("model").get("id") or ""),
    )


def write_status(session_id: str, status: Status) -> None:
    """Overwrite the status file of a session. It holds the latest value only."""
    if not session_id:
        return
    write_atomic(status_path(session_id), json.dumps(asdict(status)), private=True)


#: How long a name may be. Longer than `label` shows, so nothing is lost by
#: being clipped on screen, and short enough that the file cannot be used as a
#: place to keep something else. The rename box on the page has the same
#: number as its `maxLength`; `test_a_row_is_renamed_where_it_stands` holds them.
NAME_MAX = 120


#: A pattern longer than this is refused. It is not a safety property --
#: nothing bounds what a regular expression costs -- but a pattern that long
#: is a mistake, and refusing it is cheaper than explaining the slowness.
LINK_PATTERN_MAX = 200

#: The most a link's url may be. A url template longer than this is a
#: mistake, and the file is written whole on every change.
LINK_URL_MAX = 2000

def risky_pattern(pattern: str) -> bool:
    """A quantifier inside a group that is itself quantified: `(a+)+`.

    This is the shape that backtracks catastrophically, and it is the one
    shape worth spotting. It is a heuristic and says so: nothing here can
    prove a regular expression is quick, and the page is what pays.
    """
    for at, char in enumerate(pattern):
        if char != "(":
            continue
        depth, close = 0, -1
        for here in range(at, len(pattern)):
            if pattern[here] == "\\":
                continue
            if pattern[here] == "(":
                depth += 1
            elif pattern[here] == ")":
                depth -= 1
                if depth == 0:
                    close = here
                    break
        if close < 0 or close + 1 >= len(pattern):
            continue
        body = pattern[at + 1:close]
        if pattern[close + 1] in "*+{" and any(one in body for one in "*+{"):
            return True
    return False


def link_trouble(one: Any) -> str:
    """What is wrong with one autolink entry, or empty when nothing is.

    The page is handed only the entries that pass, so a broken one is a line
    in `doctor` rather than a link that quietly does nothing.
    """
    if not isinstance(one, dict):
        return "not an object with `match` and `url`"
    if set(one) - {"match", "url"}:
        return "a link is only `match` and `url`"
    match = one.get("match")
    url = one.get("url")
    if not isinstance(match, str) or not match:
        return "`match` is missing or not text"
    if not isinstance(url, str) or not url:
        return "`url` is missing or not text"
    if len(match) > LINK_PATTERN_MAX:
        return f"`match` is longer than {LINK_PATTERN_MAX} characters"
    if len(url) > LINK_URL_MAX:
        return f"`url` is longer than {LINK_URL_MAX} characters"
    if not url.startswith(("http://", "https://")):
        return "`url` does not start with http:// or https://"
    try:
        re.compile(match)
    except re.error as trouble:
        return f"`match` is not a regular expression: {trouble}"
    if risky_pattern(match):
        return ("`match` has a quantifier inside a quantified group, which can"
                " be slow enough to freeze the page")
    return ""


def trouble_field(why: str) -> str:
    """Which box of the menu's row a link's trouble is about. The messages
    are ours, so they name the key; the menu paints that box red."""
    return "url" if "`url`" in why else "match"


#: What each setting may be, in the words the menu uses, so the file reads
#: like the menu. A value outside these is left out and said, and the page
#: then uses its default -- the same rule as a bad link.
SETTING_WORDS: dict[str, tuple[Any, ...]] = {
    "colours": ("auto", "light", "dark"),
    "tab_width": (2, 4, 8),
    "long_lines": ("scroll", "wrap"),
    "diff_columns": ("one", "two"),
}

#: The most links the file may hold. Each is a pattern run over every block
#: the page draws, so a list this long is a mistake, not a use.
LINKS_KEPT = 100

#: Every key that is ours, judged by `config_trouble`. Any other key in the
#: file is kept and left alone.
SETTING_KEYS = {*SETTING_WORDS, "alerts", "links"}


def config_trouble(key: str, value: Any) -> str:
    """What is wrong with one setting's value, or empty when nothing is.

    One checker for the file and for a POST, so the page cannot write what
    the file would refuse to read back.
    """
    if key in SETTING_WORDS:
        allowed = SETTING_WORDS[key]
        if value not in allowed:
            return f"`{key}` is one of {', '.join(json.dumps(one) for one in allowed)}"
        return ""
    if key == "alerts":
        if (not isinstance(value, dict) or set(value) - {"needs", "done"}
                or not all(isinstance(one, bool) for one in value.values())):
            return '`alerts` is {"needs": true or false, "done": true or false}'
        return ""
    if key == "links":
        if not isinstance(value, list):
            return "`links` is a list of links"
        if len(value) > LINKS_KEPT:
            return f"`links` holds at most {LINKS_KEPT} links"
        return ""
    return f"`{key}` is not a setting"


def read_config() -> tuple[dict[str, Any] | None, str]:
    """The file as written, or None and why it cannot be used. A missing
    file is no settings. One reader for `load_config` and `save_config`, so
    the two cannot disagree about what an unreadable file is."""
    path = config_path()
    if not path.exists():
        return {}, ""
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        return None, f"cannot read {path}: {error}"
    except ValueError as error:
        return None, (f"{path} is not valid JSON: {error}."
                      " A backslash in a pattern has to be doubled: `\\\\d`,"
                      " not `\\d`.")
    if not isinstance(payload, dict):
        return None, f"{path} is not an object of settings"
    return payload, ""


def load_config() -> tuple[dict[str, Any], list[dict[str, str]], list[str]]:
    """The usable settings, every link as written, and what is wrong.

    A missing file is not trouble: it is the defaults, and most people never
    change one. Anything else that stops a setting being used is, and the
    caller says it out loud -- "no links" and "your file is broken" looked
    the same once, nothing on the page either way, and the only way to find
    out was `doctor`, which you had no reason to run.

    The links come back *as written*, each with its own `trouble`, so the
    menu can show a bad one in red rather than drop it from sight; only the
    ones with no trouble are made into links.

    `\\d` is the one people write, and it is not a JSON escape: JSON allows
    `\\" \\\\ \\/ \\b \\f \\n \\r \\t` and `\\uXXXX` and nothing else, so a
    pattern typed by hand needs its backslash doubled. The menu does that
    for you. The file is never repaired: guessing is a worse surprise than
    the message.
    """
    payload, why = read_config()
    if payload is None:
        return {}, [], [why]
    path = config_path()
    good: dict[str, Any] = {}
    links: list[dict[str, str]] = []
    trouble: list[str] = []
    for key, value in payload.items():
        if key not in SETTING_KEYS:
            continue                 # kept in the file, and not ours to judge
        why = config_trouble(key, value)
        if why:
            trouble.append(f"{path}: {why}")
        elif key == "links":
            for at, one in enumerate(value):
                why = link_trouble(one)
                if isinstance(one, dict):
                    links.append({"match": str(one.get("match") or ""),
                                  "url": str(one.get("url") or ""),
                                  "trouble": why,
                                  "field": trouble_field(why) if why else ""})
                if why:
                    trouble.append(f"link {at + 1} in {path}: {why}")
        else:
            good[key] = value
    return good, links, trouble


def config_payload() -> dict[str, Any]:
    """What the page is handed: the settings, the links, the trouble, and
    where the file is, with the home directory as `~` so it fits the menu."""
    good, links, trouble = load_config()
    return dict(good, links=links, trouble=trouble, path=tilde(config_path()))


def page_json(data: Any) -> str:
    """JSON that may stand inside a `<script>` of the page.

    The links are the reader's text, and a `</script>` in one would end the
    script there and start reading HTML. `<`, `>` and `&` are written as
    their `\\u` escapes, which mean the same in JSON and in JavaScript, so
    nothing in the data can close the element it stands in. **ASCII only**:
    a `\\ud800` in the file is a lone surrogate once read, and the page is
    encoded strictly, so one such link answered the page with a 500.
    """
    text = json.dumps(data)
    return (text.replace("<", "\\u003c").replace(">", "\\u003e")
            .replace("&", "\\u0026"))


def config_stamp() -> tuple[int, int] | None:
    """What changes when the file does, for the daemon's tick: a stat, not a
    read, because it runs every second."""
    try:
        held = config_path().stat()
    except OSError:
        return None
    return held.st_mtime_ns, held.st_size


def save_config(change: dict[str, Any]) -> tuple[str, list[dict[str, Any]]]:
    """Write a change into the file. Empty when it was written, else why not;
    and the links that were left out, by where they stood in the change.

    Every key is checked before anything is written, and one bad key writes
    nothing. **A link that cannot be used is left out and named, and the
    rest are kept**: the menu shows the one in red, "not saved", and a
    mistake in one pattern must not cost the reader the other nine. The
    check is `link_trouble`, here and only here -- the page has no copy of
    `risky_pattern` to drift from it.

    **A file that cannot be read is never written over.** It is the reader's
    file and they may be halfway through an edit; replacing it with a
    default would take their work. **A key that is not ours stays**, as a
    hook event keeps its fields: a newer wostuast may have written it.
    """
    if not change:
        return "there is nothing to change", []
    for key, value in change.items():
        why = config_trouble(key, value)
        if why:
            return why, []
    refused: list[dict[str, Any]] = []
    if "links" in change:
        kept = []
        for at, one in enumerate(change["links"]):
            why = link_trouble(one)
            if why:
                refused.append({"at": at, "trouble": why,
                                "field": trouble_field(why)})
            else:
                kept.append(one)
        change = dict(change, links=kept)
    held, why = read_config()
    if held is None:
        return f"{why} -- so it is left alone", []
    held.update(change)
    write_atomic(config_path(),
                 json.dumps(held, indent=2, ensure_ascii=False) + "\n",
                 private=True)
    return "", refused


def clean_name(text: str) -> str:
    """A name as it is kept and typed: one line, no controls, `NAME_MAX` at
    most. It goes into a pane after `/rename`, so a newline in it would be
    an Enter there."""
    # Not a backslash at its end: Claude Code reads a backslash and then
    # Enter as a new line, so `/rename foo\` stayed in the prompt box,
    # unsent, and the reader's next message was taken as the rest of the
    # name (measured, 2.1.288). The cut to `NAME_MAX` can leave one too.
    return " ".join(typed(text).split())[:NAME_MAX].rstrip("\\ ")


def read_name_entries() -> dict[str, tuple[str, str | None]]:
    """Every name the reader has given, with Claude Code's name just before
    the page typed it as `/rename`, or None for a name that is the page's
    alone (`Store.page_name`). That one is kept as a bare string, as every
    name was before #351, so an older wostuast still reads it."""
    try:
        payload = json.loads(names_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    found: dict[str, tuple[str, str | None]] = {}
    for key, value in payload.items():
        name, over = value, None
        if isinstance(value, dict):
            name, over = value.get("name"), value.get("over")
            over = over[:NAME_MAX] if isinstance(over, str) else None
        if isinstance(key, str) and isinstance(name, str) and name.strip():
            found[key] = (name[:NAME_MAX], over)
    return found


def read_snoozed() -> dict[str, float]:
    """Every snooze kept, or none. A value that is not a number is left out:
    the file is ours, but nothing read from a disk is trusted blindly."""
    try:
        payload = json.loads(snoozed_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    return {str(key): float(value) for key, value in payload.items()
            if isinstance(key, str) and isinstance(value, (int, float))
            and not isinstance(value, bool)}


def write_snoozed(snoozes: dict[str, float]) -> None:
    write_atomic(snoozed_path(), json.dumps(snoozes), private=True)


#: The most turns kept saved (#377), and the most of each one's words
#: kept with it: enough to know it again in the list, not a copy of it --
#: the words stay in the transcript, and "open" goes there.
SAVED_MAX = 500
SAVED_PREVIEW = 300
#: Who said a saved turn: an answer (None, or "claude", kept as nothing),
#: the reader's prompt, their `!` or slash command, or the harness (#424).
SAVED_WHO = (None, "claude", "me", "shell", "system")


def saved_entry(raw: Any) -> dict[str, Any] | None:
    """One saved turn, checked: a session id, a place, a moment, and the
    start of its words. None for anything else; nothing read from a disk
    or a POST is trusted blindly. A prompt the reader typed carries
    `who: "me"` (#403), a `!` or slash command with its output `"shell"`,
    and a message of the harness `"system"` (#424); an answer carries
    nothing, so every entry saved before prompts could be is an answer, as
    it was."""
    if not isinstance(raw, dict):
        return None
    sid, seq, ts = raw.get("id"), raw.get("seq"), raw.get("ts")
    text, at, who = raw.get("text", ""), raw.get("at", 0.0), raw.get("who")
    number = lambda value: isinstance(value, (int, float)) and not isinstance(value, bool)
    if (not isinstance(sid, str) or not sid or not isinstance(seq, int)
            or isinstance(seq, bool) or seq < 0 or not number(ts)
            or not isinstance(text, str) or not number(at)
            or who not in SAVED_WHO):
        return None
    entry = {"id": sid, "seq": seq, "ts": float(ts), "text": text[:SAVED_PREVIEW],
             "at": float(at)}
    if who and who != "claude":
        entry["who"] = who
    return entry


def read_saved() -> list[dict[str, Any]]:
    """Every saved turn, newest first, or none."""
    try:
        payload = json.loads(saved_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    if not isinstance(payload, list):
        return []
    return [one for one in map(saved_entry, payload) if one is not None][:SAVED_MAX]


def write_saved(saved: list[dict[str, Any]]) -> None:
    write_atomic(saved_path(), json.dumps(saved), private=True)


#: Search (#379): the most results, the longest query, and how much of the
#: words round a hit each result carries.
SEARCH_MAX = 100
SEARCH_QUERY_MAX = 200
SEARCH_AROUND = 120
#: The filters a query may carry, as Slack's search has them.
SEARCH_FILTERS = ("in", "from", "before", "after", "is")


def parse_search(query: str) -> tuple[list[str], dict[str, str]]:
    """The words of a query, lower case, and its filters: `in:name`,
    `from:me` or `from:claude`, `before:2026-10-01`, `after:…`,
    `is:unread`. A word with a colon that is no filter is a word."""
    words: list[str] = []
    filters: dict[str, str] = {}
    for part in query[:SEARCH_QUERY_MAX].split():
        key, colon, value = part.partition(":")
        if colon and key.lower() in SEARCH_FILTERS and value:
            filters[key.lower()] = value.lower()
        else:
            words.append(part.lower())
    return words, filters


def search_day(text: str, end: bool = False) -> float | None:
    """The start of a day written `2026-10-01`, or of the next one, in the
    machine's own time zone, which is the reader's. None for anything else."""
    try:
        day = time.mktime(time.strptime(text, "%Y-%m-%d"))
    except (ValueError, OverflowError):
        return None
    return day + 86400 if end else day


def search_log(query: str, sessions: dict[str, Session]) -> list[dict[str, Any]]:
    """What the reader typed and what the agents answered, from the event
    log, newest first (#379): `UserPromptSubmit`'s `prompt` and the last
    words of each turn, `Stop`'s `last_assistant_message`. No transcript is
    read: they are many and long, the log is one place, and it is never
    thrown away (its archives are read too).

    A plain scan, with no index: a line that cannot hold every word is
    passed over before it is parsed, so most of the log is read as bytes
    and never as JSON. A word that is not ASCII is looked for only after
    the parse, because the log may write it as an escape."""
    words, filters = parse_search(query)
    if not words and not filters:
        return []
    # A filter that cannot be read is said, not dropped: dropped, a query
    # of `before:yesterday` alone answered with the newest of everything.
    after = before = None
    for key, end in (("after", False), ("before", True)):
        if key in filters:
            day = search_day(filters[key], end=False)
            if day is None:
                raise ValueError(f"{key}: is a day, written 2026-10-01")
            after, before = (day, before) if key == "after" else (after, day)
    if filters.get("from", "me") not in ("me", "claude"):
        raise ValueError("from: is me or claude")
    if filters.get("is", "unread") != "unread":
        raise ValueError("is: is unread")
    who = filters.get("from")
    within = filters.get("in")
    # Asked of the raw line only where the line holds the word as typed:
    # JSON writes a quote, a backslash and anything not ASCII as escapes.
    plain = [word for word in words
             if word.isascii() and '"' not in word and "\\" not in word]
    kept: deque[dict[str, Any]] = deque(maxlen=SEARCH_MAX)
    for path in (archived_events_paths() or []) + [events_path()]:
        try:
            handle = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for line in handle:
                low = line.lower()
                if any(word not in low for word in plain):
                    continue
                if '"userpromptsubmit"' not in low and '"stop' not in low:
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(event, dict):
                    continue
                name = event.get("hook_event_name")
                if name == "UserPromptSubmit":
                    said, by = event.get("prompt"), "me"
                elif name in ("Stop", "StopFailure"):
                    said, by = event.get("last_assistant_message"), "claude"
                else:
                    continue
                if not isinstance(said, str) or not said.strip():
                    continue
                if who and not by.startswith(who):
                    continue
                ts = event.get("ts")
                ts = float(ts) if isinstance(ts, (int, float)) else 0.0
                if (after is not None and ts < after) or (before is not None and ts >= before):
                    continue
                sid = str(event.get("session_id") or "")
                session = sessions.get(sid)
                if within and not (session and within in
                                   f"{session.title} {session.place}".lower()):
                    continue
                if filters.get("is") == "unread" and not (session and session.unread):
                    continue
                text = said.lower()
                if any(word not in text for word in words):
                    continue
                # Found in the words as written: lower case can be longer
                # ("İ" is two), and a place in it cuts the original wrong.
                hit = re.search(re.escape(words[0]), said, re.I) if words else None
                at = hit.start() if hit else 0
                start = max(0, at - SEARCH_AROUND)
                piece = " ".join(said[start:at + SEARCH_AROUND].split())
                kept.append({"id": sid, "ts": ts, "who": by,
                             "text": ("… " if start else "") + piece
                             + (" …" if at + SEARCH_AROUND < len(said) else "")})
    return sorted(kept, key=lambda one: -one["ts"])


def read_reminders() -> dict[str, float]:
    """Every reminder kept, or none: the same shape as the snoozes, and
    read as carefully."""
    try:
        payload = json.loads(reminders_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(payload, dict):
        return {}
    return {str(key): float(value) for key, value in payload.items()
            if isinstance(key, str) and isinstance(value, (int, float))
            and not isinstance(value, bool) and value > 0}


def write_reminders(reminders: dict[str, float]) -> None:
    write_atomic(reminders_path(), json.dumps(reminders), private=True)


def read_seen() -> tuple[float, dict[str, float]]:
    """The floor and the moment each session was last seen, or now and none.

    The floor is when the file was first written. With no file there is no
    floor yet, and now stands in for it: else every session that ended a
    turn before this feature was there would come up unread at once. A value
    that is not a number is left out, as `read_snoozed` leaves one out.
    """
    now = time.time()
    try:
        payload = json.loads(seen_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return now, {}
    if not isinstance(payload, dict):
        return now, {}
    number = lambda value: isinstance(value, (int, float)) and not isinstance(value, bool)
    floor = payload.get("floor")
    seen = payload.get("seen")
    return (float(floor) if number(floor) else now,
            {str(key): float(value) for key, value in seen.items()
             if isinstance(key, str) and number(value)}
            if isinstance(seen, dict) else {})


def write_seen(floor: float, seen: dict[str, float]) -> None:
    write_atomic(seen_path(), json.dumps({"floor": floor, "seen": seen}),
                 private=True)


def read_names() -> dict[str, str]:
    """Every name the reader has given, or an empty map."""
    return {key: name for key, (name, _) in read_name_entries().items()}


def read_names_over() -> dict[str, str]:
    """Claude Code's name just before the page typed each, for the names
    it typed."""
    return {key: over for key, (_, over) in read_name_entries().items()
            if over is not None}


def write_names(names: dict[str, str], over: dict[str, str] | None = None) -> None:
    """Keep them. The file is ours and nobody else reads it, so it is one map
    rather than a file per session: there is no hook writing it in parallel."""
    over = over or {}
    write_atomic(names_path(), json.dumps(
        {key: {"name": name, "over": over[key]} if key in over else name
         for key, name in names.items()}), private=True)


def read_status(session_id: str) -> Status:
    """Read the status file of a session. A missing file gives an empty status."""
    try:
        payload = json.loads(status_path(session_id).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return Status()
    if not isinstance(payload, dict):
        return Status()
    return Status(
        ts=to_float(payload.get("ts")),
        name=str(payload.get("name") or ""),
        model=str(payload.get("model") or ""),
        context_pct=opt_float(payload.get("context_pct")),
        cost_usd=opt_float(payload.get("cost_usd")),
        agent=str(payload.get("agent") or ""),
        effort=str(payload.get("effort") or ""),
        model_id=str(payload.get("model_id") or ""),
    )


def inside(root: Path | str, path: Path | str) -> Path | None:
    """The resolved path, if it really sits inside the resolved root.

    Resolving first is the whole point: it follows every symbolic link and
    flattens every `..`, so one comparison answers a question that a pattern
    over the raw text can only guess at. Both callers share it so it cannot drift.
    """
    # A link loop (`a -> b`, `b -> a`, both tracked) is not inside anything:
    # the read answered 500 before. `resolve` raises RuntimeError on one up
    # to Python 3.12. On 3.13 it raises nothing and hands back the path as
    # far as it got, which is still a link -- and a path resolved to its end
    # never is one. So both are asked, and CI's 3.13 job showed why.
    try:
        top = Path(root).resolve()
        target = Path(path).resolve()
        looped = target.is_symlink()
    except (OSError, RuntimeError):
        return None
    if looped:
        return None
    return target if target.is_relative_to(top) else None


def safe_transcript(path: str) -> Path | None:
    """A transcript we are willing to open, or None.

    The path arrives in an event, so it is input, not fact. Anything able to
    write the log could otherwise name any file on the machine and the daemon
    would serve it. A transcript lives under the Claude config directory and
    ends in .jsonl; nothing else is opened.
    """
    if not path:
        return None
    target = inside(settings_path().parent, path)
    return target if target is not None and target.suffix == ".jsonl" else None


def safe_name(session_id: str) -> str:
    """A session id is a UUID, but never trust it as a file name."""
    return re.sub(r"[^A-Za-z0-9_.-]", "_", session_id)[:128] or "unknown"


def money(dollars: float) -> str:
    """What a session has spent, short enough for a status line.

    Cents below ten dollars, because that is where the difference between one
    prompt and the next shows; whole dollars above it, because by then the
    cents are noise. It is Claude Code's own estimate at list price either
    way -- see `Status.cost_usd`.
    """
    return f"${dollars:.2f}" if dollars < 10 else f"${dollars:.0f}"


def status_line(status: Status, cwd: str) -> str:
    """The one line wostuast prints as the status line."""
    parts = [status.name or path_label(cwd)]
    if status.agent:
        parts.append(status.agent)
    if status.model:
        parts.append(status.model)
    if status.context_pct is not None:
        parts.append(f"{status.context_pct:.0f}% ctx")
    if status.cost_usd is not None:
        parts.append(money(status.cost_usd))
    return " · ".join(parts)


def drop_old_status(now: float | None = None) -> None:
    """Remove status files of sessions that are long gone."""
    moment = now if now is not None else time.time()
    try:
        for entry in status_dir().glob("*.json"):
            if moment - entry.stat().st_mtime > SESSION_MAX_AGE:
                entry.unlink()
    except OSError:
        pass


# --- settings.json: add and remove our hooks without touching anything else --


def detect_indent(text: str) -> int | str:
    """Guess the indentation of a JSON file so we write it back the same way."""
    match = re.search(r"\n([ \t]+)\S", text)
    if not match:
        return 2
    lead = match.group(1)
    return "\t" if lead.startswith("\t") else len(lead)


def hook_entry(command: str) -> dict[str, Any]:
    return {"type": "command", "command": command}


def words_of(command: str) -> list[str]:
    """Split a command the way a shell would, and fall back to plain spaces."""
    words = shell_words(command)
    return command.split() if words is None else words


#: A command in the parts a shell reads differently: a single-quoted part, a
#: double-quoted part, one escaped character, and the rest. A quote that is
#: not closed runs to the end, and `shlex` then refuses the whole line.
QUOTED_PARTS = re.compile(r"""'[^']*'?|"(?:[^"\\]|\\.)*"?|\\.?|[^'"\\]+""", re.S)

#: What a backslash and the character after it become inside double quotes,
#: where `shlex` and a POSIX shell do not agree. `shlex` already reads `\"`
#: and `\\` as a shell does, and every other pair stays as it is.
DOUBLE_QUOTED = {"$": "$", "`": "`", "\n": ""}


def shell_words(command: str) -> list[str] | None:
    """Split a command the way a shell would, or None when a shell could not.

    `shlex` does that, except inside double quotes. There a POSIX shell
    drops the backslash before `$`, `` ` ``, `"`, `\\` and a newline, and
    `shlex` drops it before `"` and `\\` only. So `--then "echo \\$HOME"`
    came back from `then_of` as `echo \\$HOME`, and after `uninstall` the
    status line printed that text (#254). The rest comes off here first, in
    the double-quoted parts only (`DOUBLE_QUOTED`). A single-quoted part,
    which is what `install` writes, is not changed.
    """
    import shlex

    def posix(part: re.Match[str]) -> str:
        text = part.group()
        if not text.startswith('"'):
            return text
        # Pair by pair from the left, so `\\$` is an escaped backslash
        # and then a `$`, as a shell reads it.
        return re.sub(r"\\(.)", lambda pair: DOUBLE_QUOTED.get(
            pair.group(1), pair.group()), text, flags=re.S)

    try:
        return shlex.split(QUOTED_PARTS.sub(posix, command))
    except ValueError:
        return None


def is_ours(command: Any, verb: str) -> bool:
    """True when this command runs our program with this verb.

    It matches the shape, not the exact string: `wostuast status`,
    `~/.local/bin/wostuast status` and `wostuast status --then '...'` are all
    ours. Anything after the verb is ours too, which is what stops `install`
    offering to wrap a line it wrote itself: run twice, it used to suggest
    `wostuast status --then 'wostuast status --then ...'`. For `hook`, the
    hook file `install` writes (`hook_path`) is ours as well, alone.
    """
    if not isinstance(command, str):
        return False
    words = words_of(command)
    if verb == "hook" and is_hook_file(command):
        return True
    if verb == "status" and is_status_file(command):
        return True
    return len(words) >= 2 and words[1] == verb and os.path.basename(words[0]) == "wostuast"


def is_status_file(command: Any) -> bool:
    """True when this command runs the status file: `.../wostuast/status.py`,
    alone or with `--then '<theirs>'` after it."""
    if not isinstance(command, str):
        return False
    words = words_of(command)
    return (len(words) >= 1 and os.path.basename(words[0]) == "status.py"
            and os.path.basename(os.path.dirname(words[0])) == "wostuast")


def is_hook_file(command: Any) -> bool:
    """True when this command is the hook file: `.../wostuast/hook.py`, alone."""
    if not isinstance(command, str):
        return False
    words = words_of(command)
    return (len(words) == 1 and os.path.basename(words[0]) == "hook.py"
            and os.path.basename(os.path.dirname(words[0])) == "wostuast")


def has_verb(group: Any, verb: str) -> bool:
    """True when this matcher group already runs our program with this verb."""
    if not isinstance(group, dict):
        return False
    return any(
        isinstance(entry, dict) and is_ours(entry.get("command"), verb)
        for entry in group.get("hooks") or []
    )


def runs_hook_file(group: Any) -> bool:
    """True when this matcher group runs the hook file `install` writes."""
    if not isinstance(group, dict):
        return False
    return any(
        isinstance(entry, dict) and is_hook_file(entry.get("command"))
        for entry in group.get("hooks") or []
    )


def add_hooks(settings: dict[str, Any], command: str) -> list[str]:
    """Add our hook entries. Returns one line per change."""
    changes: list[str] = []
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("settings.json has a 'hooks' key that is not an object")
    for event in HOOK_EVENTS:
        groups = hooks.setdefault(event, [])
        if not isinstance(groups, list):
            raise ValueError(f"settings.json has a '{event}' key that is not a list")
        # An install from before the hook file ran the whole program on
        # every event (#271). Its entries become the hook file, in place, so
        # the user's order of hooks stays as it was. Only that way round: a
        # checkout registered on purpose is not moved to another checkout.
        if is_hook_file(command):
            for group in groups:
                for entry in (group.get("hooks") or []) if isinstance(group, dict) else []:
                    if (isinstance(entry, dict) and is_ours(entry.get("command"), "hook")
                            and not is_hook_file(entry.get("command"))):
                        entry["command"] = command
                        changes.append(f"moved hook {event} to {command}")
        if any(has_verb(group, "hook") for group in groups):
            continue
        group: dict[str, Any] = {"hooks": [hook_entry(command)]}
        if event in MATCHER_EVENTS:
            group = {"matcher": "*", **group}
        groups.append(group)
        changes.append(f"added hook {event}")
    return changes


def remove_hooks(settings: dict[str, Any]) -> list[str]:
    """Remove only the entries that run our program.

    A key we took nothing out of is left exactly as it was, empty list and all.
    A key we emptied is removed, so a machine that had no hooks before install
    has none after uninstall. The one case those two rules cannot tell apart is
    a key the user left empty that we then added to: it ends up removed rather
    than empty. Claude Code reads both as "no hooks for this event", so nothing
    is lost, and no entry of the user's is ever touched.
    """
    changes: list[str] = []
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return changes
    for event in list(hooks.keys()):
        groups = hooks.get(event)
        if not isinstance(groups, list):
            continue
        kept_groups = []
        removed_here = False
        for group in groups:
            entries = group.get("hooks") if isinstance(group, dict) else None
            if not isinstance(entries, list):
                kept_groups.append(group)
                continue
            kept = [
                entry
                for entry in entries
                if not (isinstance(entry, dict) and is_ours(entry.get("command"), "hook"))
            ]
            if len(kept) == len(entries):
                kept_groups.append(group)   # untouched, empty list and all
                continue
            changes.append(f"removed hook {event}")
            removed_here = True
            if kept:
                group["hooks"] = kept
                kept_groups.append(group)
            # A group we emptied goes: a machine with no hooks before install
            # has none after uninstall.
        # Only rewrite a key we actually took something out of. An empty list
        # the user put there is theirs, and deleting it would be a silent edit.
        if not removed_here:
            continue
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if changes and not hooks:
        settings.pop("hooks", None)
    return changes


def add_status_line(settings: dict[str, Any], command: str) -> list[str]:
    """Register our status line, but never overwrite one the user already has."""
    current = settings.get("statusLine")
    if isinstance(current, dict) and is_ours(current.get("command"), "status"):
        if is_status_file(current["command"]):
            return []
        # `wostuast status`, from before the status file: it runs the whole
        # program on every redraw. The user's own line after `--then` comes
        # with it, and every other key of the entry stays.
        if shell_words(current["command"]) is None:
            return []
        import shlex

        theirs = then_of(current["command"])
        current["command"] = command + (
            f" --then {shlex.quote(theirs)}" if theirs else "")
        return ["moved status line"]
    if current:
        yours = current.get("command") if isinstance(current, dict) else ""
        if not isinstance(yours, str) or not yours:
            return ["kept your status line; wostuast could not read it to suggest a line"]
        import shlex

        return [
            "kept your status line, because Claude Code allows only one.",
            "  To have both, change statusLine.command in your settings to:",
            f"    {command} --then {shlex.quote(yours)}",
            "  wostuast then reads the session name and context percent and runs",
            "  your line, so the terminal shows exactly what it shows today.",
            "  Without this, sessions have no name and no context percent.",
        ]
    settings["statusLine"] = {"type": "command", "command": command}
    return ["added status line"]


def then_of(command: str) -> str | None:
    """The user's own status line inside `wostuast status --then '<theirs>'`.

    A shell unquotes the line before argparse sees `--then`, so it is read
    here the same way: split like a shell, then take the word after `--then`,
    or after `--then=`, or after a short form argparse also takes (`--th`).
    The last one wins, as in argparse. None when there is none.
    """
    words = shell_words(command)
    if words is None:
        return None
    # The status file takes `--then` straight after its name; the program
    # took it after the word `status`.
    return then_in(words[1:] if is_status_file(command) else words[2:])


def then_in(words: list[str]) -> str | None:
    """The value of `--then` among these words, read as argparse reads it:
    `--then X`, `--then=X`, or a short form (`--th`). The last one wins.
    The status file reads its own argv with this, without argparse."""
    found = None
    rest = iter(words)
    for word in rest:
        name, equals, value = word.partition("=")
        if len(name) < 3 or not "--then".startswith(name):
            continue
        found = value if equals else next(rest, None)
    return found


def remove_status_line(settings: dict[str, Any]) -> list[str]:
    """Remove the status line only when it is ours, and give back the user's.

    `install` tells a user who has a status line to change it to
    `wostuast status --then '<theirs>'`. That line is ours, and deleting the
    whole entry took their own command with it (#234). So `<theirs>` goes back
    as the command, and every other key of the entry stays as it was. A line
    that a shell cannot split is left alone: it is not ours to guess at.
    """
    current = settings.get("statusLine")
    if not (isinstance(current, dict) and is_ours(current.get("command"), "status")):
        return []
    command = current["command"]
    if shell_words(command) is None:
        return ["left your status line: wostuast could not read it"]
    theirs = then_of(command)
    # A line wrapped twice (install's advice followed twice) is unwrapped
    # to the user's own, never to a line that runs a program being removed.
    while theirs and is_ours(theirs, "status") and shell_words(theirs) is not None:
        theirs = then_of(theirs)
    if not theirs:
        del settings["statusLine"]
        return ["removed status line"]
    current["command"] = theirs
    return [f"put your own status line back: {theirs}"]


def load_settings(path: Path) -> tuple[dict[str, Any], int | str, bool]:
    """Read settings.json. Returns the data, its indentation and its last newline."""
    if not path.exists():
        return {}, 2, True
    text = path.read_text(encoding="utf-8")
    if not text.strip():
        return {}, 2, True
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("it holds no JSON object")
    return data, detect_indent(text), text.endswith("\n")


def unreadable(path: Path, error: Exception) -> str:
    """Why Claude Code's settings file cannot be used, in a line.

    The path as a person writes it, and for broken JSON only where: the
    parser's own words ("Expecting property name enclosed in double quotes:
    line 1 column 2 (char 1)") ran past the edge of the terminal and said
    the place twice (#275).
    """
    if isinstance(error, json.JSONDecodeError):
        why = f"not valid JSON at line {error.lineno}, column {error.colno}"
    elif isinstance(error, OSError):
        why = error.strerror or str(error)
    else:
        why = str(error)
    return f"cannot read {tilde(path)}: {why}"


def save_settings(path: Path, data: dict[str, Any], indent: int | str, newline: bool) -> None:
    """Write the user's settings back, as their own file.

    Their permissions are kept. This file can hold API keys and environment
    values, and `install` promises to touch nothing but our own hooks — it
    used to hand a 0600 file back at 0644.
    """
    import stat

    text = json.dumps(data, indent=indent, ensure_ascii=False)
    # A link is written through, not over. Dotfile managers keep this file as
    # a link into a repository, and the rename landed on the link itself: it
    # came back a plain file, and the repository never had the hooks.
    path = path.resolve()
    try:
        mode: int | None = stat.S_IMODE(path.stat().st_mode)
    except OSError:
        mode = None            # no settings file yet; the umask decides
    write_atomic(path, text + "\n" if newline else text, mode=mode, sync=True)


# --- output helpers ----------------------------------------------------------


def counted(n: int, one: str, many: str) -> str:
    """A count and its noun, "1 file" and "1,204 events": the page's
    `counted`, in the other language. The start and `doctor` spelled it
    four times (#298)."""
    return f"{n:,} {one if n == 1 else many}"


def size_label(size: int) -> str:
    """Bytes the way a person reads them. The page's `sizeOf` says the same,
    with a gigabyte added: a log that is never thrown away reaches one."""
    if size < 1024:
        return f"{size} B"
    if size < 1024 * 1024:
        return f"{round(size / 1024)} KB"
    if size < 1024 ** 3:
        return f"{size / 1024 / 1024:.1f} MB"
    return f"{size / 1024 ** 3:.1f} GB"


def use_color() -> bool:
    """Colour only a real terminal, and never when NO_COLOR is set."""
    return not os.environ.get("NO_COLOR") and sys.stdout.isatty()


RESET = "\033[0m"


def paint(text: str, state: str, color: bool) -> str:
    if not color:
        return text
    return f"{STATE_COLORS.get(state, '')}{text}{RESET}"


def ago(seconds: float) -> str:
    """A short age: `40s`, `4min`, `2h 15min`, `2d 6h`.

    Two units once the first one is coarse. `2d` covers anything from two
    days to just short of three, which is not an answer to "when did this
    last do something"; `40s` needs no second unit at all. The second is left
    off when it is nought, so `2d` still means exactly two days.
    """
    seconds = int(max(0.0, seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}min"
    if seconds < 86400:
        return _two(seconds // 3600, "h", seconds % 3600 // 60, "min")
    return _two(seconds // 86400, "d", seconds % 86400 // 3600, "h")


def _two(big: int, big_unit: str, small: int, small_unit: str) -> str:
    return f"{big}{big_unit} {small}{small_unit}" if small else f"{big}{big_unit}"


def changes_column(facts: GitFacts) -> str:
    parts = []
    if facts.ahead:
        parts.append(f"↑{facts.ahead}")
    if facts.behind:
        parts.append(f"↓{facts.behind}")
    if facts.dirty:
        parts.append(f"●{facts.touched_files}")
    elif facts.branch:
        parts.append("✓")
    return " ".join(parts)


def table(rows: Sequence[tuple[str, Sequence[str]]], color: bool) -> str:
    """Left-align every column. The last one is not padded. Each row says its
    own state, which gives it its colour; an empty state means no colour.

    Control characters come out of the cells here, which is why this is the
    one place a row is turned into a line. The last column holds a
    `Notification` message or a summary of a tool input — text an agent wrote,
    and a hostile file or a prompt injection can steer it. One of those set
    the terminal's title and turned the rest of the output red, and the column
    widths went wrong besides, because `len` counts an escape sequence. The
    page is careful about exactly this text, and so is `tmux_send`.
    """
    if not rows:
        return ""
    rows = [(state, [CONTROL_CHARS.sub("", cell) for cell in cells])
            for state, cells in rows]
    widths = [0] * len(rows[0][1])
    for _, cells in rows:
        for index, cell in enumerate(cells[:-1]):
            widths[index] = max(widths[index], len(cell))
    lines = []
    for state, cells in rows:
        padded = [cell.ljust(widths[index]) for index, cell in enumerate(cells[:-1])]
        line = "  ".join([*padded, cells[-1]]).rstrip()
        lines.append(paint(line, state, color) if state else line)
    return "\n".join(lines)


# --- tmux: the verbs, and nothing else ----------------------------------------

# wostuast reads; the user types. These are the only commands it runs: jump,
# send, interrupt, and the keys that answer a question.
#
# `runner` is looked up when the verb is called, not when it is defined. A
# default of `run` is bound once, at import, and then no test of the route
# above these can put a fake tmux in its place — which is the only way to
# test the verbs without a terminal to type into.


def tmux_jump(pane: str, runner: Callable[..., str | None] | None = None,
              focus: str | None = None) -> bool:
    """Put the cursor in that pane: its window first, then the pane itself."""
    if not pane:
        return False
    runner = runner or run
    moved = runner(["tmux", "select-window", "-t", pane]) is not None
    runner(["tmux", "select-pane", "-t", pane])
    # Raising the terminal window is the window manager's job and every desk
    # does it differently, so the command is the user's own to set. It is
    # their environment, run the way they would write it.
    wanted = os.environ.get("WOSTUAST_FOCUS", "") if focus is None else focus
    if wanted:
        runner(["sh", "-c", wanted])
    return moved


def tmux_interrupt(pane: str,
                   runner: Callable[..., str | None] | None = None) -> bool:
    """Stop what an agent is doing, without ending it.

    **Escape, never Ctrl-C.** Claude Code's own documentation: Escape stops
    the current response or tool call mid-turn and "Claude keeps the work done
    so far"; Ctrl-C "interrupts a running operation" but "if nothing is
    running, the first press clears the prompt input and a second press exits
    Claude Code". A turn can end between deciding to stop a session and the
    key landing, so Ctrl-C is a race whose losing side is a session that
    quit. Escape on an idle prompt does nothing.

    **Pasted, as the one byte Escape is, never pressed with `send-keys`**
    (#331): under `synchronize-panes` a key goes to every pane of the window
    and a paste only to its target, so an Escape meant for one agent stopped
    every agent beside it. Measured on Claude Code 2.1.287: a pasted ESC
    closes a permission dialog with the same "Interrupted · What should
    Claude do instead?" as `send-keys Escape`. Without `-p`: inside paste
    markers it would be text. It does not go through `tmux_send`, which
    strips every byte below a space on purpose. Measured: `send-keys C-c`
    puts 0x03 into a raw-mode app as a keystroke it reads, not as a signal.
    Nothing here signals a process.

    **`-S` where the tmux has it**: tmux 3.7 runs a paste through `vis(3)`
    unless `-S` says not to, and the Escape arrived as the two characters
    `^[` -- typed into the dialog, which stayed up. tmux 3.4 refuses `-S`
    ("unknown flag"), and then the paste goes again without it, which
    there is exact. Measured on both; a digit, Tab and Enter pass `vis(3)`
    unchanged, and so does every byte `tmux_send` lets through.

    And out of copy mode first, as `tmux_send` does: the Escape reaches
    the program there, but the reader looking at the pane went on seeing
    the old scrolled view, not the dialog closing.
    """
    if not pane:
        return False
    runner = runner or run
    runner(["tmux", "send-keys", "-X", "-t", pane, "cancel"])
    escape = KEY_BYTES["Escape"]
    return (tmux_paste(pane, escape, False, runner, ("-S",))
            or tmux_paste(pane, escape, False, runner))


#: Between two keys of an answer. Claude Code reads a key as a key only when
#: it arrives on its own: `2` and `4` in one read are not two ticks, they are
#: nothing, measured -- and the dialog then moved on with the ticks missing.
#: One tmux command per key keeps them apart; the pause keeps them apart
#: while the agent is busy drawing, which is when two writes merge.
KEY_GAP = 0.15

#: Everything `tmux_keys` will press: a digit, Tab, Enter.
ANSWER_KEYS = frozenset([*"123456789", "Tab", "Enter"])

#: The bytes a key is, pasted rather than pressed: a digit is itself. What
#: `send-keys` sent for each, read out of a raw pane.
KEY_BYTES = {"Tab": b"\t", "Enter": b"\r", "Escape": b"\x1b"}


def tmux_keys(pane: str, keys: Sequence[str],
              runner: Callable[..., str | None] | None = None) -> int:
    """Press keys into a pane one at a time. Returns how many landed.

    Only what `ANSWER_KEYS` names is pressed. This answers a question in the
    agent's own dialog (see `ask_keys`); it is not a way to type text, which
    is `tmux_send`, and it never presses anything it was not built from.

    **Each key is a paste of its bytes** (`KEY_BYTES`, `tmux_paste`), one
    paste a key and `KEY_GAP` apart, without `-p`: under `synchronize-panes`
    `send-keys` pressed them in every pane of the window, and a digit and an
    Enter on another agent's prompt can answer or approve something there
    (#331). Measured on Claude Code 2.1.287: a pasted "2" answered a single
    choice with its second option, and "1", "3", Tab, Enter a multiple
    choice with the first and third, as `send-keys` did.
    """
    if not pane or not keys or not all(key in ANSWER_KEYS for key in keys):
        return 0
    runner = runner or run
    # Out of copy mode first, as `tmux_send` does: the reader looking at
    # the pane should see the dialog answered, not the old scrolled view.
    runner(["tmux", "send-keys", "-X", "-t", pane, "cancel"])
    for at, key in enumerate(keys):
        if at:
            time.sleep(KEY_GAP)
        if not tmux_paste(pane, KEY_BYTES.get(key, key.encode()), False, runner):
            return at
    return len(keys)


def tmux_paste(pane: str, data: bytes, bracket: bool,
               runner: Callable[..., str | None],
               flags: Sequence[str] = ()) -> bool:
    """Paste bytes into one pane through a buffer of our own. True when they
    went in.

    `load-buffer -b <name> -` reads them on stdin, and `paste-buffer -d -r -b
    <name> -t <pane>` writes them into the pane and deletes the buffer.
    Buffers belong to the whole tmux server, so the name is ours and never
    used twice, and a named buffer is never the "most recent" one a reader's
    own paste key takes. **`-r` is required**: without it tmux turns every
    newline into a carriage return, which is Enter -- measured in a raw
    pane. `bracket` is `-p`: see `tmux_send`.

    A paste that fails leaves its buffer: tmux 3.4 keeps it, `-d` or not,
    when the pane is gone -- measured. So it is deleted then, and after a
    failed load too, since one that ran out of time may have filled it.
    """
    import secrets

    name = f"wostuast-{os.getpid()}-{secrets.token_hex(8)}"
    given = ["-p", *flags] if bracket else list(flags)
    if (runner(["tmux", "load-buffer", "-b", name, "-"], stdin=data) is not None
            and runner(["tmux", "paste-buffer", *given, "-d", "-r", "-b", name,
                        "-t", pane]) is not None):
        return True
    runner(["tmux", "delete-buffer", "-b", name])
    return False


def tmux_send(pane: str, text: str,
              runner: Callable[..., str | None] | None = None) -> bool:
    """Type text into a pane, then press Enter.

    **Pasted from a buffer, never typed with `send-keys -l`** (#328).
    `send-keys` took the text as an argument, and tmux 3.4 refuses a command
    over 16,341 bytes: a long log could not be sent at all. `tmux_paste`
    hands it to tmux on stdin, which has no such limit. Empty text is
    refused, because a bare Enter into an agent's prompt is a keystroke
    nobody asked for. Four steps, each a scar or a measurement:

    1. **`send-keys -X cancel`, which leaves copy mode.** A pane scrolled
       back with the mouse wheel is in copy mode, and there a paste reaches
       the program without the paste markers, and the Enter is eaten by the
       mode. A real bash ran the first line of two and the page said done.
       It fails when the pane is in no mode, which is the usual answer.
    2. **The text, as one bracketed paste: `-p`, one line too.** A newline
       typed into a terminal *is* Enter: a real shell ran the first line of
       two. The markers say "this arrived as a paste, do not act on it yet".
       **A long line needs them as much**: 100 KB on one line with no
       markers reached Claude Code 2.1.287 in pieces, read as several pastes
       with the Enter inside the last one, so nothing was submitted. With
       `-p` the same went in five times of five, and logs of 310 KB and
       930 KB each byte. `-p` adds them only for a program that asked, as
       Claude Code and a modern shell do; one that did not cannot read
       them. Markers of our own went on many lines only, and always.
    3. **Enter, as a pasted carriage return, not `send-keys Enter`.** Under
       `synchronize-panes` a key goes to every pane of the window, and a
       paste only to its target -- measured -- so the other panes got a
       bare Enter, which runs whatever was on their prompt. Without `-p`,
       or the return would be inside a paste and only a new line.
    4. Nothing else. stdin is not a command line, so nothing is escaped: a
       `;` at the end is a `;`, where `send-keys` lost it.

    Control characters are taken out first, and this is the one place that has
    to happen. A paste ends at `ESC [ 2 0 1 ~`, so text carrying those bytes
    would close the paste early and everything after it would arrive as
    keystrokes — with a newline among them, as Enter. The page composes a
    review out of lines an agent wrote, so that text is not only what a person
    typed, and an escape byte is invisible in a preview. Tab and newline stay;
    they are what a pasted message is made of.
    """
    text = typed(text)
    if not pane or not text.strip():
        return False
    runner = runner or run
    runner(["tmux", "send-keys", "-X", "-t", pane, "cancel"])
    return (tmux_paste(pane, text.encode("utf-8"), True, runner)
            and tmux_paste(pane, b"\r", False, runner))


# --- slash commands: what the send box can complete ---------------------------

#: How much of a skill or command file is read: the frontmatter is at the top,
#: and the body -- a whole skill's instructions -- is never needed.
FRONT_MAX = 8192
#: The most of one command's file the Commands tab is sent (#367). A skill
#: is a page or two; one larger than this is cut, and says so.
COMMAND_TEXT_MAX = 256 * 1024
#: A description is a line in a list, not the skill's documentation.
ABOUT_MAX = 160
#: What Claude Code accepts as a command's name, and so all this takes from a
#: file. A name is drawn with `textContent`, but it is also what the box gets
#: when a suggestion is taken, and from there it is typed into a terminal.
COMMAND_SHAPE = re.compile(r"[A-Za-z0-9][A-Za-z0-9:._-]{0,63}")


def claude_dir() -> Path:
    """Claude Code's own directory: `CLAUDE_CONFIG_DIR`, or `~/.claude`."""
    return settings_path().parent


def front_end(lines: list[str]) -> int | None:
    """Where the frontmatter's closing `---` is among these lines, or None
    when there is no frontmatter or it never closes. `front_matter` and
    `after_front` both ask, so they agree about where it ends: one split on
    "\n" and the other on every line ending, and a file with CR endings had
    its keys read and then its frontmatter drawn as Markdown rules."""
    if not lines or lines[0].strip() != "---":
        return None
    for at, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return at
    return None


def front_matter(text: str) -> dict[str, str]:
    """The `key: value` lines between the first two `---` lines.

    Not YAML: the standard library has no reader for it, and the three keys
    wanted here are one line each. A folded or literal value (`>` or `|`)
    takes the indented lines under it, joined with spaces, which is what a
    long description is written as. Quotes round a value come off.
    """
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    end = front_end(lines)
    found: dict[str, str] = {}
    key = ""
    for line in lines[1:len(lines) if end is None else end]:
        if key and line[:1] in (" ", "\t"):
            found[key] = (found[key] + " " + line.strip()).strip()
            continue
        key = ""
        name, colon, value = line.partition(":")
        if not colon or not name.strip() or name[:1] in (" ", "\t", "#"):
            continue
        value = value.strip()
        if value in (">", "|", ">-", "|-", ""):
            key = name.strip()
            found[key] = ""
            continue
        if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        found[name.strip()] = value
    return found


@dataclass
class Command:
    """One thing the send box can complete. `came` is where it came from:
    `project`, `yours`, `plugin`, or `used` for one only seen in a
    transcript."""

    name: str
    about: str = ""
    hint: str = ""
    came: str = ""
    uses: int = 0
    #: The file it was read from, or "" for one only seen in a transcript.
    #: The page is sent it to show where a command lives, never asked for
    #: it back: `Serving.command` takes a name (#367).
    file: str = ""


def real_md(path: str | Path) -> Path | None:
    """The file a command's path names, when it is a regular file whose own
    name ends in `.md`, else None (#367).

    An agent in a worktree can write a link named `x.md` into its
    `.claude/commands` that points at a key, or a FIFO named `SKILL.md`
    that would hold a request thread for ever. Asked where the list is made
    (`read_command`), so such a file is in neither the send box's list nor
    the Commands tab's, and again where its text is read (`command_text`),
    because the link can be swapped in between. Not "inside `.claude`":
    your own commands folder may be a link into a dotfiles repository."""
    try:
        real = Path(path).resolve(strict=True)
    except (OSError, RuntimeError):
        return None
    return real if real.is_file() and real.suffix.lower() == ".md" else None


def read_command(path: Path, came: str, name: str) -> Command | None:
    """A skill's `SKILL.md` or a command's `.md`, read as far as its
    frontmatter. None for a file that is not a real `.md` (`real_md`) or
    cannot be read, a name that is not a command's, and a skill that says
    it is not one (`user-invocable`)."""
    real = real_md(path)
    if real is None:
        return None
    try:
        with open(real, "rb") as handle:
            text = handle.read(FRONT_MAX).decode("utf-8", "replace")
    except OSError:
        return None
    front = front_matter(text)
    if front.get("user-invocable", "").lower() == "false":
        return None
    name = front.get("name") or name
    if not COMMAND_SHAPE.fullmatch(name):
        return None
    return Command(name=name, about=clip(front.get("description", ""), ABOUT_MAX),
                   hint=clip(front.get("argument-hint", ""), ABOUT_MAX), came=came,
                   file=str(path))


def after_front(text: str) -> str:
    """The text after its frontmatter: what a skill or a command says, which
    the Commands tab draws as Markdown. The frontmatter's keys are shown
    beside it already, and as Markdown its `---` lines were rules."""
    lines = text.splitlines(keepends=True)
    end = front_end(lines)
    return text if end is None else "".join(lines[end + 1:]).lstrip("\r\n")


def command_text(one: Command) -> tuple[str, bool] | None:
    """What a listed command's file says, and whether it was cut, or None
    when it cannot be read now (#367). Checked again with `real_md`: the
    file may have been swapped for a link since it was listed."""
    real = real_md(one.file) if one.file else None
    if real is None:
        return None
    try:
        with open(real, "rb") as handle:
            raw = handle.read(COMMAND_TEXT_MAX + 1)
    except OSError:
        return None
    cut = len(raw) > COMMAND_TEXT_MAX
    return after_front(raw[:COMMAND_TEXT_MAX].decode("utf-8", "replace")), cut


def command_files(base: Path, came: str) -> Iterator[Command]:
    """The skills and the command files under one `.claude` directory.

    A command file in a subdirectory is left out: how its name is formed is
    not known from a real machine, and a name guessed wrong is a command
    that is not there."""
    try:
        skills = sorted((base / "skills").iterdir())
    except OSError:
        skills = []
    for folder in skills:
        if folder.is_dir():
            found = read_command(folder / "SKILL.md", came, folder.name)
            if found:
                yield found
    try:
        files = sorted((base / "commands").glob("*.md"))
    except OSError:
        files = []
    for file in files:
        if file.is_file():
            found = read_command(file, came, file.stem)
            if found:
                yield found


def enabled_plugins(top: Path | None) -> dict[str, bool]:
    """Which plugins Claude Code has on, `plugin@marketplace` to True or
    False: the settings' `enabledPlugins`, yours, then the project's shared
    ones, then its local ones, the nearer saying last (#413). `claude
    plugin disable --scope project` wrote `false` into the project's
    `settings.json`, measured on 2.1.289."""
    files = [settings_path()]
    if top is not None:
        files += [top / ".claude" / "settings.json", top / ".claude" / "settings.local.json"]
    on: dict[str, bool] = {}
    for file in files:
        try:
            said = json.loads(file.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        found = said.get("enabledPlugins") if isinstance(said, dict) else None
        if isinstance(found, dict):
            on.update({key: value is True for key, value in found.items()
                       if isinstance(key, str)})
    return on


def plugin_dirs(cwd: str, root: str) -> list[tuple[str, Path]]:
    """Each plugin that is on for a session standing in `cwd`, as its name
    and the folder its `commands` and `skills` are in (#413).

    Measured on 2.1.289 by installing one into a home of its own:
    `plugins/installed_plugins.json` (version 2) maps `plugin@marketplace`
    to its installs, each with a `scope` and an `installPath` under
    `plugins/cache/<marketplace>/<plugin>/<version>`, and one installed for
    a project only carries that project's `projectPath`. Only a folder
    under `plugins` is read: the file is Claude Code's, but a path in it is
    a path a reader of the page did not choose."""
    base = claude_dir() / "plugins"
    try:
        listed = json.loads((base / "installed_plugins.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    plugins = listed.get("plugins") if isinstance(listed, dict) else None
    if not isinstance(plugins, dict):
        return []
    here = root or cwd
    top = Path(here).resolve() if here else None
    on = enabled_plugins(top)
    found: list[tuple[str, Path]] = []
    for key, installs in plugins.items():
        if not isinstance(key, str) or not on.get(key) or not isinstance(installs, list):
            continue
        for one in installs:
            if not isinstance(one, dict) or not isinstance(one.get("installPath"), str):
                continue
            if one.get("scope") != "user":
                project = one.get("projectPath")
                if (not isinstance(project, str) or top is None
                        or Path(project).resolve() != top):
                    continue
            folder = inside(base, one["installPath"])
            if folder is not None:
                found.append((key.split("@")[0], folder))
                break
    return found


def project_dirs(cwd: str, root: str) -> list[Path]:
    """The session's directory and each parent up to the worktree's top,
    nearest first. Only the directory itself when it is in no worktree."""
    if not cwd:
        return []
    here = Path(cwd)
    if not root:
        return [here]
    # git hands back the real path, and a session can stand in a link to it
    # (`/tmp` is `/private/tmp` on a Mac): compared as given, the walk would
    # never reach the top.
    here, top = here.resolve(), Path(root).resolve()
    out = [here]
    while here != top and here.parent != here:
        here = here.parent
        out.append(here)
    return out if here == top else [Path(cwd)]


def command_used(record: dict[str, Any]) -> str:
    """The name of the command a transcript record says was run, or "".

    The same reading the transcript does (`read_user_text`), so a prompt that
    only mentions `<command-name>` is not counted as a use of it."""
    kind = record.get("type")
    if kind == "system" and record.get("subtype") == "local_command":
        text = record.get("content")
    elif kind == "user" and not record.get("isMeta"):
        message = record.get("message")
        text = message.get("content") if isinstance(message, dict) else None
    else:
        return ""
    if not isinstance(text, str):
        return ""
    what, said = read_user_text(text)
    if what != "command" or not said.startswith("/"):
        return ""
    name = said[1:].split()[0] if said[1:].split() else ""
    return name if COMMAND_SHAPE.fullmatch(name) else ""


class Commands:
    """What the send box can complete, per session, and how often each was used.

    Built-in commands -- `/clear`, `/compact` -- live inside Claude Code and
    no file lists them, so they come from the transcripts: every command run
    is written there as `<command-name>`. A copied list of built-ins would go
    stale with each release of Claude Code.

    The transcripts are read on from where the last read stopped (`Tail`),
    so asking again costs only what was written since. Only lines that hold
    `<command-name>` are parsed. A request thread asks, and two at once
    would move a tail twice, so one lock.
    """

    def __init__(self) -> None:
        self.tails: dict[Path, Tail] = {}
        self.counts: dict[Path, Counter[str]] = {}
        import threading       # here, not at the top: the hook never asks
        self.lock = threading.Lock()

    def used(self, paths: Iterable[Path]) -> Counter[str]:
        """How often each command was run, over these transcripts."""
        total: Counter[str] = Counter()
        with self.lock:
            for path in paths:
                tail = self.tails.setdefault(path, Tail(path))
                counts = self.counts.setdefault(path, Counter())
                # Streamed, and filtered as it streams: `read_new` built a
                # list of every line of every transcript of the week, on
                # the first `/` after a start, to keep a few of them (#294).
                # `restarted` is known once the generator has begun.
                found: Counter[str] = Counter()
                for record in json_objects(
                        line for line in tail.lines()
                        if b"<command-name>" in line):
                    name = command_used(record)
                    if name:
                        found[name] += 1
                if tail.restarted:
                    counts.clear()
                counts.update(found)
                total.update(counts)
        return total

    def defined(self, cwd: str, root: str) -> Iterator[Command]:
        """The skills and command files a session standing in `cwd` can see,
        nearest first: the project's from `cwd` up to `root`, then yours.
        No transcript is read, so finding one by its name costs only the
        files (`Serving.command`), not the lock `used` holds."""
        for where in project_dirs(cwd, root):
            yield from command_files(where / ".claude", "project")
        yield from command_files(claude_dir(), "yours")
        # A plugin's command runs as `/plugin:name`, a skill's too: typed
        # as `/greet`, a plugin's skill ran as `/demo:greet` (#413).
        for plugin, folder in plugin_dirs(cwd, root):
            for one in command_files(folder, "plugin"):
                named = plugin + ":" + one.name
                if COMMAND_SHAPE.fullmatch(named):
                    one.name = named
                    yield one

    def of(self, cwd: str, root: str, transcripts: Iterable[Path]) -> list[Command]:
        """Every command for a session standing in `cwd`: the project's,
        nearest directory first, then yours, then the ones only used. Most
        used first; a name defined twice is kept where it is nearest."""
        found: dict[str, Command] = {}
        for one in self.defined(cwd, root):
            found.setdefault(one.name, one)
        for name, uses in self.used(transcripts).items():
            found.setdefault(name, Command(name=name, came="used")).uses = uses
        return sorted(found.values(), key=lambda one: (-one.uses, one.name))


# --- the daemon: one page, a little JSON, and a stream of changes ------------


class Client:
    """One browser tab listening to the event stream."""

    def __init__(self, watching: str = "") -> None:
        import queue

        self.queue: Any = queue.Queue(maxsize=CLIENT_BACKLOG)
        self.full, self.empty = queue.Full, queue.Empty
        self.watching = watching
        #: Set when a message could not be kept. `stream` then closes.
        self.lost = False

    def put(self, message: str) -> None:
        """Queue a message. A client too slow to take it is closed, never
        given a gap.

        It used to drop the oldest message and go on. A transcript push is
        only the blocks that changed, so the page lost a block, took the
        newer pushes, and held a `version` past it: a fetch was answered
        `same` and a reconnect's opening was not ahead, so nothing asked for
        it again (#235). Closed at the first message it cannot keep, the
        page holds only what came before it, and the reconnect's opening
        is ahead of that, so the page fetches the whole transcript again.
        """
        if self.lost:
            return
        try:
            self.queue.put_nowait(message)
        except self.full:
            self.lost = True
            try:
                while True:
                    self.queue.get_nowait()
            except self.empty:
                pass
            try:
                self.queue.put_nowait("")    # wakes a `stream` waiting on it
            except self.full:
                pass


class Hub:
    """The browsers that are listening. Separate from the Store, because a tab
    closing has nothing to do with what the agents are doing."""

    def __init__(self) -> None:
        import threading

        self.clients: set[Client] = set()
        self.lock = threading.Lock()

    def add(self, watching: str = "") -> Client:
        client = Client(watching)
        with self.lock:
            self.clients.add(client)
        return client

    def drop(self, client: Client) -> None:
        with self.lock:
            self.clients.discard(client)

    def watchers(self) -> set[str]:
        with self.lock:
            return {c.watching for c in self.clients if c.watching}

    def send(self, kind: str, data: Any, session_id: str = "") -> None:
        """Send to every client, or only to those watching one session."""
        message = f"event: {kind}\ndata: {wire_json(data)}\n\n"
        with self.lock:
            targets = [
                client
                for client in self.clients
                if not session_id or client.watching == session_id
            ]
        for client in targets:
            client.put(message)


class Daemon:
    """The Store, the browsers, and the one thread that writes to the Store."""

    def __init__(self) -> None:
        import threading

        import secrets

        self.store = Store()
        self.hub = Hub()
        self.files = Files()
        self.commands = Commands()
        #: `pick_base`'s ranking of every branch, by worktree, HEAD and the
        #: refs as they stand. Counting walks history, and the Diff tab polls.
        self.ranks: dict[Any, Any] = {}
        #: What a branch committed, under its base's sha and HEAD's
        #: (`worktree_diff`): the Review tab's poll asked git for it again
        #: every five seconds.
        self.diffs: dict[Any, Any] = {}
        # Any site can send this daemon a POST; only a page that has read this
        # token can send one that acts. It is made here and printed into the
        # page, and it lives as long as the daemon does.
        self.token = secrets.token_urlsafe(32)
        #: The only user this daemon answers. 127.0.0.1 is open to every
        #: account on the machine, and the token is in the page any of them
        #: can fetch. `Serving.handle` compares each connection against it.
        self.uid = os.getuid()
        self.version = own_version()
        #: One writer of `settings.json` at a time. A POST runs in its own
        #: thread, and two at once read the same file and each wrote back
        #: its own change, so one was lost -- the `POST /name` scar.
        self.config_lock = threading.Lock()
        #: The file as the browsers last heard of it. A change from anywhere
        #: -- another browser, or a hand in an editor -- goes out on the next
        #: tick (`tell_config`).
        self.config_seen = config_stamp()
        self.transcripts: dict[str, Transcript] = {}
        #: The rows as the last push left them, by id, and their order: what
        #: `sessions_change` compares with (#431).
        self.told: dict[str, dict[str, Any]] = {}
        self.told_order: list[str] = []
        #: The run of a reader `forget_gone` dropped, by session, so the next
        #: reader of that session counts on from it. An int each, not blocks.
        self.runs: dict[str, int] = {}
        #: Sessions a decline is being pressed into. It waits up to
        #: `DECLINE_WAIT` between its Escape and its reason, and a second one
        #: -- another tab -- would press a second Escape into what came next.
        self.declining: set[str] = set()
        #: Sessions something is being typed into: a send, an answer or a No
        #: (`claim`). The page's `sending` guard is per browser tab, and two
        #: tabs -- or a tab and a script -- ran two HTTP threads at once: the
        #: pane got "first", "second", Enter, Enter, one prompt of both.
        self.typing: set[str] = set()
        #: The pane each of those holds. Two sessions can stand in one pane --
        #: `claude -p` run from an agent's Bash tool inherits `TMUX_PANE` --
        #: and a send to each at once interleaved their pastes and Enters into
        #: one prompt, 20 times of 20 (#331). So a pane is taken as well.
        self.typing_panes: dict[str, str] = {}
        self.lock = threading.Lock()
        self.stopping = threading.Event()
        self.started = time.time()

    def session(self, session_id: str) -> Session | None:
        return self.store.sessions.get(session_id)

    def claim(self, session_id: str, no: bool = False, pane: str = "") -> str:
        """Take a session for one thing typed into it: "" when taken, else why not.

        Refused, never queued: the second one was asked for before the first
        landed, and what it would type into is not what its sender saw. `no`
        marks a decline, which `declined_in_terminal` and `send` look for.
        `release` gives the session back, always in a `finally`.

        `pane` is the one the verb will type into, read once by its caller:
        read here again, a `SessionStart` between the two reads would have
        the verb type into a pane nobody holds.
        """
        with self.lock:
            if session_id in self.declining:
                return "a No is already on its way to this session"
            if session_id in self.typing:
                return ("something is already being typed into this session;"
                        " wait for it to land")
            if pane and pane in self.typing_panes.values():
                return ("something is already being typed into this pane, for"
                        " another session in it; wait for it to land")
            self.typing.add(session_id)
            if pane:
                self.typing_panes[session_id] = pane
            if no:
                self.declining.add(session_id)
        return ""

    @contextlib.contextmanager
    def holding(self, session_id: str, pane: str,
                no: bool = False) -> Iterator[str]:
        """`claim` for the length of a `with`: "" when the session and its
        pane are taken, else why not. It gives back only what it took, and
        always."""
        busy = self.claim(session_id, no=no, pane=pane)
        try:
            yield busy
        finally:
            if not busy:
                self.release(session_id)

    def release(self, session_id: str) -> None:
        """Give back what `claim` took. Only its holder may hold `declining`."""
        with self.lock:
            self.typing.discard(session_id)
            self.typing_panes.pop(session_id, None)
            self.declining.discard(session_id)

    def transcript(self, session_id: str) -> Transcript | None:
        """The transcript reader for a session, made on first use."""
        session = self.session(session_id)
        if session is None:
            return None
        path = safe_transcript(session.transcript_path)
        if path is None:
            return None
        held = self.transcripts.get(session_id)
        if held is None or held.tail.path != path:
            # A session resumed from another directory writes under another
            # name, so this is a different reading of the same session and
            # `seq` starts again. Say so, or the page patches the new blocks
            # over the head of the old ones and leaves the old tail below.
            # A reader `forget_gone` dropped counts on from its run too: a
            # new one at run 0 could match a `have` the page still holds.
            last = held.run if held else self.runs.get(session_id, -1)
            held = Transcript(str(path), session.cwd, run=last + 1)
            self.transcripts[session_id] = held
        held.used = time.monotonic()
        return held

    def read_transcript(
        self, session_id: str
    ) -> tuple[list[Block], int, int] | None:
        """Read whatever is new, tell the watchers, and hand back every block.

        Both the tick and a request for the tab come through here, under one
        lock. Two threads calling `read_new` at once moved the byte offset
        twice, which then looked like a shrinking file and re-read the whole
        transcript from the top. Reading in a request and not telling the
        watchers lost those blocks for every other tab.
        """
        with self.lock:
            reader = self.transcript(session_id)
            if reader is None:
                return None
            changed = reader.read_new()
            if changed:
                reader.version += 1
            blocks = list(reader.blocks)
            run = reader.run
            fresh = run != reader.run_sent   # a reading nobody has been told of
            reader.run_sent = run
            # Told under the lock, so the pushes leave in the order they were
            # read. Outside it, a request thread could read and push block 2
            # while the tick still held block 1, and the page, which patches
            # by index, never drew block 1 at all. `send` only queues, so
            # nothing here waits on a socket.
            if changed or fresh:
                self.hub.send("transcript",
                              {"id": session_id, "run": run,
                               "version": reader.version,
                               "blocks": blocks_json(changed)},
                              session_id=session_id)
            return blocks, run, reader.version

    def transcript_held(self, session_id: str) -> tuple[int, int] | None:
        """Which reading of a session's transcript the daemon holds, and its
        `version` -- read under the lock, nothing new read.

        A stream opens on this. A tick between a fetch's snapshot and the
        stream joining the hub sends to nobody, and so does one while a
        dropped stream reconnects, or one sent to a stream the browser has
        closed and the hub has not yet noticed. Told a version it does not
        hold, the page asks for the whole again.
        """
        with self.lock:
            reader = self.transcripts.get(session_id)
            return None if reader is None else (reader.run, reader.version)

    def call_answered(self, session_id: str, call: str) -> bool:
        """Whether the transcript holds this call's result, read just now.

        A permission dialog is on screen until its call is answered, and the
        answer -- run, failed, or rejected -- is written to the transcript as
        the call's result. So this is the one proof, short of looking at the
        pane, that the dialog has closed.
        """
        return self.call_result(session_id, call) is not None

    def call_result(self, session_id: str, call: str) -> str | None:
        """The result the transcript holds for a call, read just now, or None
        while it has none. An empty string is a result: `touch` prints
        nothing, and its dialog has closed all the same."""
        if not call or self.read_transcript(session_id) is None:
            return None
        with self.lock:
            reader = self.transcripts.get(session_id)
            held = reader.by_tool_use.get(call) if reader is not None else None
            return held.result if held is not None and held.answered else None

    def declined_in_terminal(self) -> bool:
        """Write `Declined` for a dialog told No in the terminal.

        Saying No fires no hook, so the row stayed amber, over an agent back
        at its prompt, until the next prompt was typed -- the page's own No
        had the daemon watch for it, and a No in the terminal had nobody. The
        proof is the same: the transcript holds the call's result, and it is
        the rejection. A Yes is left alone, because its `PostToolUse` says
        so, and a No the page is pressing is left to the page, which writes
        its own record and says where it came from. True when one was written.
        """
        wrote = False
        for session in list(self.store.sessions.values()):
            shown = session.dialog
            call = str((shown or {}).get("call") or "")
            if not call or session.session_id in self.declining:
                continue
            said = self.call_result(session.session_id, call)
            if said is None or not said.lstrip().startswith(REJECTED):
                continue
            append_event({"session_id": session.session_id,
                          "hook_event_name": "Declined", "ts": time.time(),
                          "key": shown["key"], "tool_use_id": call,
                          "where": "terminal"})
            wrote = True
        return wrote

    def sessions_change(self) -> dict[str, Any]:
        """What changed in the rows since the last push (#431): the rows that
        are new or differ, and the order of the ids whenever it moved --
        which a row that went always moves, so it says that too. Every change sent every row -- 111 KB a push at 100 sessions,
        about once a second while agents work -- and the page filled them
        all again.

        **Safe because a stream never has a gap**: a push it cannot keep
        closes it (`Client.put`), and a stream opens with every row
        (`sessions_payload`). A push says "these rows now read so", so the
        pushes queued behind an opening, applied in order on top of it, end
        on the newest rows even when the opening is newer than some of
        them. Only the tick sends this, and only the tick writes `told`.
        """
        rows = self.store.rows
        order = [one["id"] for one in rows]
        told = self.told
        change: dict[str, Any] = {
            "now": time.time(),
            "changed": [one for one in rows if told.get(one["id"]) != one],
            "saved": len(self.store.saved)}
        if order != self.told_order:
            change["order"] = order
        self.told = {one["id"]: one for one in rows}
        self.told_order = order
        return change

    def sessions_payload(self) -> dict[str, Any]:
        # How many turns are saved, for the sidebar's link (#377): the list
        # itself is asked for when it opens.
        return {"now": time.time(), "sessions": self.store.rows,
                "saved": len(self.store.saved)}

    def tick(self) -> None:
        """One pass: fold new events, then tell the browsers what changed."""
        moved = self.store.refresh()
        # Read again for the `Declined` record `declined_in_terminal` may have
        # just written, so the row goes out no longer amber on this tick. Its own
        # statement: `moved or self.store.refresh()` short-circuits, and on a
        # tick that had already changed something the read never ran.
        if self.declined_in_terminal():
            moved = self.store.refresh() or moved
        if moved:
            self.hub.send("sessions", self.sessions_change())
        self.tell_config()
        for session_id in self.hub.watchers():
            self.read_transcript(session_id)
        self.forget_gone()
        self.files.forget(LISTING_KEPT)

    def tell_config(self, force: bool = False) -> None:
        """Send the settings to every browser when the file has changed.

        Every open page is one reader's screen, so a change in one tab is a
        change in all of them, and a file edited by hand reaches the page
        without a reload. A stat a tick, never a read, until it changes.
        **Sent under the lock**, so the pushes go out in the order the file
        was written: the push is the one way the settings reach a page that
        is open, and so one line, in order.
        """
        with self.config_lock:
            now = config_stamp()
            if now == self.config_seen and not force:
                return
            self.config_seen = now
            self.hub.send("settings", config_payload())

    def forget_gone(self) -> None:
        """Drop the readers nobody needs.

        A reader holds every block of a transcript, the tool results whole.
        It was dropped only when its session left the `Store`, up to
        `SESSION_MAX_AGE` -- a week -- and `declined_in_terminal` makes one
        for every session that shows a dialog, watched or not: nearly every
        session, so the daemon held a week of transcripts (#294). Now a
        reader goes once no browser watches its session, no dialog is up,
        and nothing has asked for it for `READER_IDLE`: the page fetches
        before it subscribes, and a reader dropped in between would only be
        read again. The run is kept (`runs`), so the next reader of that
        session counts on from it.
        """
        watched = self.hub.watchers()
        now = time.monotonic()
        with self.lock:
            for session_id, reader in list(self.transcripts.items()):
                session = self.store.sessions.get(session_id)
                if session is None:
                    del self.transcripts[session_id]
                    self.runs.pop(session_id, None)
                elif (session_id not in watched and not session.dialog
                      and now - reader.used > READER_IDLE):
                    self.runs[session_id] = reader.run
                    del self.transcripts[session_id]

    def catch_up(self) -> str:
        """Fold the whole history once, and say what that took.

        This is the one read that grows with the log, because no archive is
        ever thrown away, so the start of `serve` is where the reader learns
        what it costs. It is the same fold the first tick would have done;
        the tick then finds nothing it has not seen.
        """
        started = time.monotonic()
        try:
            self.store.follow()
        except Exception as error:  # a bad first read must not stop the daemon
            log(f"reading the event log failed: {error!r}")
        took = time.monotonic() - started
        follower = self.store.follower
        files, size = follower.files_read()
        spent = f"{took * 1000:.0f} ms" if took < 1 else f"{took:.1f} s"
        older = (f", and left out {counted(follower.left_out, 'archive', 'archives')}"
                 f" older than {HISTORY_FOLDED // 86400} days" if follower.left_out else "")
        return (f"read {counted(follower.events, 'event', 'events')}"
                f" from {counted(files, 'file', 'files')}"
                f" ({size_label(size)}) in {spent}{older}")

    def run(self) -> None:
        while not self.stopping.is_set():
            try:
                self.tick()
            except Exception as error:  # a bad tick must not stop the daemon
                log(f"tick failed: {error!r}")
            self.stopping.wait(TICK)


def blocks_json(blocks: Sequence[Block]) -> list[dict[str, Any]]:
    """Blocks as the page wants them. Results are cut: the page shows a line."""
    return [dict(block.__dict__, result=clip_lines(block.result, 40))
            for block in blocks]


def clip_lines(text: str, limit: int) -> str:
    """Keep the first lines of a tool result, and say how many were dropped."""
    if not text:
        return ""
    lines = text.splitlines()
    if len(lines) <= limit:
        return text
    rest = len(lines) - limit
    return "\n".join(lines[:limit]) + f"\n… {rest} more line{'s' if rest > 1 else ''}"


def table_address(host: str, port: int, six: bool = False) -> str:
    """An IPv4 address and a port as `/proc/net/tcp` writes them.

    The kernel prints each 32-bit word of the address as a number in the
    machine's own byte order, so 127.0.0.1 is `0100007F` on x86. With `six`
    it is the IPv4-mapped IPv6 address, as `/proc/net/tcp6` writes it.
    """
    raw = bytes(int(part) for part in host.split("."))
    if six:
        raw = bytes(10) + b"\xff\xff" + raw
    words = "".join(f"{int.from_bytes(raw[at:at + 4], sys.byteorder):08X}"
                    for at in range(0, len(raw), 4))
    return f"{words}:{port:04X}"


def socket_owner(table: str, local: tuple[str, int],
                 remote: tuple[str, int]) -> int | None:
    """The uid of the socket from `local` to `remote`, read off the text of
    `/proc/net/tcp` or `/proc/net/tcp6`. None when no socket that a process
    holds has both.

    Both ends must match, so another connection is never taken for this one.
    A line with no inode (`NO_INODE`) is skipped: no process holds that
    socket, so it cannot read an answer, and the kernel writes uid 0 on it,
    which is root's and was let in. Another user sent a request and closed
    the socket before the daemon looked, and the request was served (#254).
    The table can hold tens of thousands of lines, so it is searched, not
    split: `find` runs in C, and only a line that holds both ends is split.
    The needle is the two addresses with a space either side, and no other
    field of a line has that shape, so a line it finds is a line whose
    second and third fields are these two ends.
    """
    for six in (False, True):
        near, far = table_address(*local, six), table_address(*remote, six)
        needle = f" {near} {far} "
        at = table.find(needle)
        while at != -1:
            start = table.rfind("\n", 0, at) + 1
            end = table.find("\n", at)
            fields = table[start:end if end != -1 else len(table)].split()
            if len(fields) > 9 and fields[9] != NO_INODE:
                try:
                    return int(fields[7])
                except ValueError:
                    return None
            at = table.find(needle, at + 1)
    return None


def read_table(path: str) -> str | None:
    """The text of one TCP table, or None when this machine has no such file.

    Any other failure is raised: a table that is there and cannot be read is
    not the same as a machine without one, and the caller refuses on it.
    """
    try:
        with open(path, encoding="ascii", errors="replace") as table:
            return table.read()
    except FileNotFoundError:
        return None


def another_user(peer: tuple[str, int], ours: tuple[str, int], uid: int,
                 read: Callable[[str], str | None] | None = None,
                 tables: Sequence[str] = TCP_TABLES) -> bool:
    """Whether the other end of a connection belongs to another user.

    `peer` is the address the connection came from and `ours` the one it
    came to, so the other end's socket is the line from `peer` to `ours`.
    Three answers, and the order matters:

    - No table at all, or tables with no lines in them: false, as before
      this check existed. macOS has no `/proc`. A real table always lists
      our own listening socket, so an empty one is not a real table, and
      nobody else can make ours empty.
    - The line is there: true unless its uid is ours or root's
      (`ROOT_UID`, for the WSL2 relay).
    - The table is there and the line is not: true. The other end is open
      for as long as this connection is, so a missing line is not normal.
      The kernel can skip a line when the table changes during the read,
      so it is read again first, `PEER_READS` times in all.

    `read_table` is looked up when called, not taken as a default, so a
    test can put a table that fails in its place.
    """
    read = read or read_table
    for _ in range(PEER_READS):
        listed = False
        for path in tables:
            text = read(path)
            if text is None:
                continue
            listed = listed or text.count("\n") > 1
            owner = socket_owner(text, peer, ours)
            if owner is not None:
                # Root too: WSL2's relay from a Windows browser runs as
                # root, and root can read everything here anyway.
                return owner not in (uid, ROOT_UID)
        if not listed:
            return False
    return True


#: What a connection from another user gets, on every route. It says why, so
#: a reader whose own browser runs as another account can tell what happened.
STRANGER = "wostuast answers only the user who runs it"


class Serving:
    """Every route the daemon answers, and none of the HTTP plumbing.

    It subclasses nothing, so it lives out here at one indent rather than
    three hundred lines deep inside `make_server`. The plumbing is mixed in
    there, where `http.server` is imported: a bare interpreter starts in
    10.8 ms and one that has imported `http.server` in 49.5 ms, and the hook
    pays for every import on every tool call. Deferring that import is what
    matters; nesting the routes was only how it was first written.

    `make_server` puts the daemon on the subclass it builds, so each server
    has its own.
    """

    daemon: Daemon           # set on the subclass, in `make_server`

    #: Whether this connection comes from another user. `handle` sets it once
    #: per connection; until then it is true, so a request that got past
    #: `handle` somehow is refused rather than served.
    stranger = True

    def handle(self) -> None:
        """Look up who is at the other end, once for the whole connection.

        127.0.0.1 is open to every account on the machine, and `GET /` hands
        out the page with the token in it. So the Host, Origin and token
        checks keep other *sites* out, and only this keeps other *users*
        out. It runs here, in the connection's own thread, and not in the
        server's accept loop: a table of 64,000 lines takes about 80 ms to
        read, and the accept loop would make every other browser wait.

        A failure is a refusal. An exception here is something nobody
        expected, and running out of files is one another user can cause.
        """
        try:
            self.stranger = another_user(self.client_address[:2],
                                         self.connection.getsockname()[:2],
                                         self.daemon.uid)
        except Exception as error:
            log(f"could not tell which user connected: {error!r}")
            self.stranger = True
        super().handle()  # type: ignore[misc]  # BaseHTTPRequestHandler's

    def log_message(self, fmt: str, *args: Any) -> None:
        pass  # the access log goes nowhere; our own log has what matters

    def reply(self, code: int, body: bytes, kind: str,
              cache: str = "no-store") -> None:
        # Text is packed, and only text. The page reaches this daemon through
        # an ssh tunnel as often as not, and on a slow one the first visit
        # to the Files tab carried 3.3 MB of file names -- twenty seconds at
        # 200 KiB/s, where packed it is about a twentieth. A picture or a
        # video from `raw` is packed already, and is never text.
        packable = kind.startswith(PACKED_KINDS)
        packed = packable and len(body) > PACK_MIN and self.takes_gzip()
        if packed:
            # Imported here, not at the top: the hook runs this file on every
            # tool call and pays for every import it makes.
            import gzip
            body = gzip.compress(body, PACK_LEVEL)
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        if packable:
            # A cache between here and the browser must not hand a packed
            # answer to a client that cannot unpack it.
            self.send_header("Vary", "Accept-Encoding")
        if packed:
            self.send_header("Content-Encoding", "gzip")
        # `raw` serves a worktree file, and the type it is given comes from
        # the end of its name. A browser that sniffed the bytes instead could
        # read a file called `a.png` as something else entirely, on the origin
        # that holds the token.
        self.send_header("X-Content-Type-Options", "nosniff")
        # No page of ours inside another page. Framed by another origin, this
        # page is still our origin, with our token, so every check a POST
        # passes it passes -- and an invisible frame over a decoy turned two
        # clicks into an Escape in an agent's pane. The token and the Origin
        # check stop another site's requests; only this stops its clicks.
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "frame-ancestors 'none'")
        # No Access-Control-Allow-Origin, ever. Another site may send a
        # request here, but without this header it cannot read the answer.
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(body)

    def takes_gzip(self) -> bool:
        """True when the request says gzip is welcome, and not with `q=0`.

        A header it cannot read is a no: an unpacked answer always works. So
        is a request whose headers were never read, which a refusal can be.
        """
        headers = getattr(self, "headers", None)
        said = headers.get("Accept-Encoding", "") if headers else ""
        for part in (said or "").split(","):
            name, _, params = part.partition(";")
            if name.strip().lower() not in ("gzip", "*"):
                continue
            weight = params.replace(" ", "").lower()
            if not weight.startswith("q="):
                return True
            try:
                return float(weight[2:]) > 0
            except ValueError:
                return False
        return False

    def reply_json(self, data: Any, code: int = 200) -> None:
        self.reply(code, wire_bytes(wire_json(data)),
                   "application/json; charset=utf-8")

    def ours(self) -> bool:
        """True when this request really is for the loopback address.

        Binding to 127.0.0.1 keeps other machines out, and sending no
        Access-Control-Allow-Origin keeps another site from reading the
        answer. Neither stops a site pointing its own name at 127.0.0.1:
        the browser then treats us as that site's own origin and lets it
        read everything. The Host header is what gives that away.

        A request with no Host at all is refused. The empty string used to be
        in this list for a bare HTTP/1.0 client, which meant the check could
        be skipped by leaving the header out. Every browser sends it.
        """
        sent = self.headers.get("Host")
        if not sent:
            return False
        host = sent.rsplit(":", 1)[0].strip("[]")
        return host in ("localhost", "127.0.0.1", "::1")

    def origin_ours(self) -> bool:
        """The Origin, when a browser sent one, is a page of ours.

        A same-origin `fetch` sends none at all, which is why no Origin is
        allowed through. It fails closed on a header it cannot read:
        `Origin: http://[::1` is a `ValueError` out of `urlparse`, and that
        used to leave the thread with no status line sent and a traceback in
        the terminal running `serve`.
        """
        from urllib.parse import urlparse

        origin = (self.headers.get("Origin") or "").strip()
        if not origin:
            return True
        try:
            where = urlparse(origin).hostname
        except ValueError:
            return False
        return where in ("localhost", "127.0.0.1", "::1")

    def allowed(self) -> bool:
        """Whether a POST may act on the terminal.

        Two things beyond the Host header. The Origin, which a browser
        sets on a cross-origin POST and which has to be ours when it is
        there at all. And the token this daemon made at start and printed
        into the page, in a header of its own. A cross-origin `fetch` may
        send a plain POST with no questions asked, and the effect here is
        `tmux send-keys` into a live terminal, so neither check is spare.

        The token header fails closed too: one byte above 0x7f in it is a
        `TypeError` out of `compare_digest`, because headers arrive as
        latin-1.
        """
        import hmac

        if not self.origin_ours():
            return False
        sent = self.headers.get(TOKEN_HEADER) or ""
        if not sent.isascii():
            return False
        return hmac.compare_digest(sent, self.daemon.token)

    def stale_page(self) -> bool:
        """Whether a refused POST is a page from an earlier `serve`.

        The token is made fresh in `Daemon.__init__` and printed into the
        page, so restarting `serve` leaves every open page holding one this
        daemon has never heard of. The stream is a GET and reconnects, so
        the sidebar goes on moving and the page looks perfectly alive while
        every send, every jump and every answered question is refused -- in
        every session at once, because the token belongs to the daemon and
        not to a session. It cost a reader an afternoon, and `doctor` could
        not have told them: the page is the only thing that knows.

        This is only ever the *wording* of a refusal. `allowed()` has
        already said no and nothing here changes that. It is true when the
        request came from a page of ours and carried a token that is simply
        not this one; a cross-origin caller fails `origin_ours` and is told
        nothing it did not already know.
        """
        sent = self.headers.get(TOKEN_HEADER) or ""
        return bool(sent) and sent.isascii() and self.origin_ours()

    def asked(self) -> dict[str, Any]:
        """The JSON a POST carried, or an empty one.

        `too_big` is set beside it, because an empty body and a body that
        was refused for its size are not the same answer and the routes see
        only the empty one: `send` read it as "there is nothing to send".

        It is read before anything is checked, because a body left in the
        socket makes the next request on that connection nonsense. A body
        too large to read is not read — so that connection is closed instead
        of being kept alive: the refusal used to leave 70 KB of the caller's
        choosing in the socket, and the daemon answered the `GET` written in
        the middle of it. Three responses on one connection, the second one
        framed by whoever sent the first.
        """
        # Cleared first, not merely set below: with keep-alive one handler
        # object serves every request on a connection, so a flag left standing
        # would answer for the next one.
        self.too_big = False
        self.unread = False
        length = self.body_length()
        if length is None:
            # A body whose end is not known is never read, so it would be
            # read as the next request, the same as a body too large (#235).
            # `unread` tells the route it was never looked at.
            self.close_connection = True
            self.unread = True
            return {}
        if length > POST_MAX:
            self.close_connection = True
            # Said out loud, because the routes see only the empty body this
            # returns: `send` read it as "there is nothing to send", which is
            # the opposite of what happened.
            self.too_big = True
            return {}
        if length <= 0:
            return {}
        try:
            body = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}
        return body if isinstance(body, dict) else {}

    def body_length(self) -> int | None:
        """The length of the body, or None when its end cannot be known.

        `http.server` reads no chunked body, so a `Transfer-Encoding` makes
        the end unknown. So does a `Content-Length` that is not a plain
        number, or two of them that do not agree: `int()` takes " -5", "+5"
        and "5_0", and another reader of the same bytes may not. No header
        at all is a body of nought.

        **Nor a number of more than 18 digits.** `int()` refuses a text of
        more than 4,300 digits with a `ValueError`, and `guarded` answered
        500 and kept the connection: the bytes after the headers were read
        as the next request (#254). 18 digits is more than any body, and
        `int()` takes it always.
        """
        if self.headers.get("Transfer-Encoding") is not None:
            return None
        given = {value.strip() for value in
                 self.headers.get_all("Content-Length") or []}
        if not given:
            return 0
        if len(given) > 1:
            return None
        text = given.pop()
        if not (text.isascii() and text.isdigit()) or len(text) > 18:
            return None
        return int(text)

    def guarded(self, route: Callable[[], None]) -> None:
        """Run a request with nothing outside the guard.

        The checks used to sit in front of the `try`, where a header they
        could not parse killed the thread with no status line sent and a
        traceback into the terminal running `serve`. They fail closed on
        their own now; this is what catches whatever nobody thought of.
        """
        try:
            # Before anything else, the body too: nothing another user sends
            # is read, and the connection closes after this answer. Inside
            # the `try`, so this check fails closed like the others.
            if self.stranger:
                self.close_connection = True
                self.reply_json({"error": STRANGER}, 403)
                return
            route()
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as error:
            log(f"request {self.path} failed: {error!r}")
            # Closed: a request that failed half way may have left its body
            # in the socket, and that would be read as the next request.
            self.close_connection = True
            try:
                self.reply_json({"error": "something went wrong"}, 500)
            except OSError:
                pass

    def do_POST(self) -> None:  # noqa: N802 - the name http.server requires
        self.guarded(self.route_post)

    def route_post(self) -> None:
        from urllib.parse import urlparse

        # Who asks is known from the headers and the socket, so a request
        # that may not act is refused before its body is read: a site in the
        # reader's browser could otherwise make the daemon read and parse
        # `POST_MAX` bytes, which is megabytes since a send may be a long
        # log. The body stays in the socket, so the connection closes.
        if not self.ours():
            self.close_connection = True
            self.reply_json({"error": "wostuast answers on localhost only"},
                            403)
            return
        if not self.allowed():
            self.close_connection = True
            if self.stale_page():
                self.reply_json(
                    {"error": "wostuast was restarted, so this page is out of"
                              " date. Reload it.", "stale": True}, 403)
            else:
                self.reply_json({"error": "that did not come from this page"},
                                403)
            return
        body = self.asked()
        if self.unread:
            # The route would see `{}` and take it for an empty body: `name`
            # read it as "take the name away".
            self.reply_json({"error": "wostuast reads a body only when a"
                                      " Content-Length gives its size"}, 400)
            return
        parts = urlparse(self.path).path.strip("/").split("/")
        if parts == ["api", "settings"]:
            self.settings(body)
        elif len(parts) == 4 and parts[:2] == ["api", "session"] and parts[2]:
            found = POST_VERBS.get(parts[3])
            if found is None:
                self.reply_json({"error": "no such thing"}, 404)
            elif self.too_big:
                # `asked()` hands over `{}` for a body it did not read, and
                # each verb reads `{}` as an answer: `name` as "take the
                # name away" (#235), `answer` as a question no longer
                # waiting (#254). Refused here, before any verb sees it.
                self.refuse(parts[2], 413,
                            f"that {found[1]} is too large to accept")
            else:
                self.dispatch(found[0], found[2], parts[2], body)
        else:
            self.reply_json({"error": "no such thing"}, 404)

    def refuse(self, session_id: str, code: int, why: str) -> None:
        """A verb's refusal. It always says why: `said` clears the live slot
        for an answer that carries no `error`, and the reader then asked for
        something, did not get it, and read nothing at all."""
        self.reply_json({"id": session_id, "error": why}, code)

    def settings(self, body: dict[str, Any]) -> None:
        """Keep a change the settings menu made, in `settings.json`.

        It writes a file of the reader's and touches no terminal, but it
        arrives like the verbs and is checked like them: the token, this
        machine, this user. Every page hears of the change from the push,
        this one included, and the answer carries it too.
        """
        if self.too_big:
            # `asked()` hands over `{}` for a body it did not read, which
            # would be a change of nothing that answered "done".
            self.reply_json({"error": "that change is too large to accept"},
                            413)
            return
        with self.daemon.config_lock:
            try:
                why, refused = save_config(body)
            except OSError as error:
                why, refused = f"cannot write {config_path()}: {error}", []
        if why:
            self.reply_json({"error": why}, 400)
            return
        self.daemon.tell_config(force=True)
        # Only what the push cannot say. The settings themselves come by the
        # push, so the page has one line of them, in order: an answer that
        # carried them came on another connection, and could land before
        # an older push and be undone by it.
        self.reply_json({"refused": refused, "done": True})

    def in_tmux(self, session_id: str) -> Session | None:
        """The session, when it is one the verbs can reach at all."""
        session = self.known(session_id)
        if session is None:
            return None
        if not session.pane:
            self.refuse(session_id, 409, "this session is not in tmux")
            return None
        return session

    def jump(self, session_id: str, session: Session,
             body: dict[str, Any]) -> None:
        # Like `send` below: an answer carrying no `error` clears the live
        # slot, so a jump into a pane tmux has since closed failed with
        # nothing at all on the page.
        if not tmux_jump(session.pane):
            self.reply_json({"id": session_id,
                             "error": "tmux would not go to that pane"}, 502)
            return
        self.reply_json({"id": session_id, "done": True})

    def name(self, session_id: str, session: Session,
             body: dict[str, Any]) -> None:
        """Name a session, or take its name away with an empty one.

        It needs no pane: a session that has ended can still be named, which
        is the point of naming one at all. Where the session can be typed
        into, it is renamed in Claude Code too, with `/rename` (#351), so
        the two show one name; where it cannot, the name is the page's
        alone, and the answer says why (`kept_here`).
        """
        asked = body.get("name")
        clean = clean_name(asked if isinstance(asked, str) else "")
        # Read before the keys go: the status line may carry the new name
        # a moment after, and the typed name stands until it moves from
        # this one (`page_name`).
        before = session.status.name
        why = self.type_rename(session_id, session, clean) if clean else ""
        given = self.daemon.store.rename(session_id, clean,
                                         None if why else before)
        # Nothing is pushed from here. A rename is not an event, but the rows
        # are built from the names on every pass, so the next one differs and
        # goes out on its own. The answer carries the name so the page can
        # show it without waiting for that.
        self.reply_json({"id": session_id, "name": given, "done": True,
                         "kept_here": why})

    def type_rename(self, session_id: str, session: Session, name: str) -> str:
        """Type `/rename <name>` and Enter into the session's pane: "" when it
        went in, else why not.

        Measured on 2.1.288 (`tests/claude_pane.py`): at the prompt it writes
        a `custom-title` record and starts no turn; while a turn runs it is
        done at once, in the middle of the turn, which goes on. So a working
        session is typed into, as a send is. Not one that needs you: a
        dialog's cursor is on "1. Yes", and an MCP form has no `permission`
        that `cannot_type` could see. The rename waits for nothing -- a
        keystroke nobody is watching is how a spend limit typed into a
        terminal on its own -- so the page's name is kept, and it says so.
        A draft in the prompt box is the one thing this cannot see: the
        command goes after it, as every send does.
        """
        if not session.pane:
            return "this session is not in tmux"
        why = cannot_type(session)
        # `asking` too: an `AskUserQuestion` is on screen from its
        # `PreToolUse`, a moment before the `PermissionRequest` turns the
        # row amber.
        if not why and (session.state == "needs_you" or session.asking):
            why = "it waits on you in the terminal"
        if why:
            return why
        pane = session.pane
        with self.daemon.holding(session_id, pane) as busy:
            if busy:
                return busy
            if not tmux_send(pane, f"/rename {name}"):
                return "tmux did not answer"
        return ""

    def snooze(self, session_id: str, session: Session,
               body: dict[str, Any]) -> None:
        """Snooze a session that needs you, or wake it (#355). It writes a
        file of ours and touches no terminal, as `name` does."""
        if body.get("snooze") and session.state != "needs_you":
            self.reply_json({"id": session_id, "error":
                             "only a session that needs you can be snoozed"}, 409)
            return
        snoozed = self.daemon.store.snooze(session_id, bool(body.get("snooze")))
        self.reply_json({"id": session_id, "snoozed": snoozed, "done": True})

    def save(self, session_id: str, session: Session | None,
             body: dict[str, Any]) -> None:
        """Save a turn of this session for later, or take it off the list
        (#377). A file of ours, and no terminal. Taking one off needs no
        session: the list keeps the turns of sessions the daemon has
        forgotten, and their "done" was a 404 that nothing could clear."""
        if body.get("save") and self.known(session_id) is None:
            return
        entry = saved_entry({"id": session_id, "seq": body.get("seq"),
                             "ts": body.get("ts"), "text": body.get("text", ""),
                             "who": body.get("who"), "at": time.time()})
        if entry is None:
            self.refuse(session_id, 400, "a saved turn is a place, a moment and its words")
            return
        saved = self.daemon.store.save(entry, bool(body.get("save")))
        self.reply_json({"id": session_id, "saved": saved, "done": True})

    def remind(self, session_id: str, session: Session,
               body: dict[str, Any]) -> None:
        """Bring a session back at a moment, or forget its reminder (#375).
        A file of ours, and no terminal. The moment is a number, 0 or in
        the next `REMIND_MOST` seconds: anything else is refused, not
        clipped, so a page that sent milliseconds says so."""
        at = body.get("at")
        now = time.time()
        if (not isinstance(at, (int, float)) or isinstance(at, bool)
                or not (at == 0 or now < at <= now + REMIND_MOST)):
            self.refuse(session_id, 400, "a reminder is 0 or a moment in the next 31 days")
            return
        kept = self.daemon.store.remind(session_id, float(at))
        self.reply_json({"id": session_id, "remind_at": kept, "done": True})

    def seen(self, session_id: str, session: Session,
             body: dict[str, Any]) -> None:
        """The reader had this session on screen, or marked it unread
        (#373). A file of ours, and no terminal, as `snooze`."""
        unread = self.daemon.store.see(session_id, bool(body.get("seen")))
        self.reply_json({"id": session_id, "unread": unread, "done": True})

    def answer(self, session_id: str, session: Session,
               body: dict[str, Any]) -> None:
        """Answer the question the agent is waiting on, in its own dialog.

        The page sends which options were picked, never keys: the keys are
        worked out here, from the question this daemon holds (`ask_keys`),
        and they are digits, Tab and Enter and nothing else. A pick for a
        question that has since been answered, or replaced by another, is
        refused -- its numbers would land on a question nobody read.
        """
        # Over: the agent that asked is gone, and the keys would land in
        # whatever runs there now (`_bury` clears the question too; this is
        # the half that holds whatever a row still carries). A dialog up as
        # well: one batch of calls can hold both, and the keys are digits
        # and Enter, so they could say Yes to it (#254).
        why = cannot_type(session)
        if why:
            self.refuse(session_id, 409, why)
            return
        ask = session.asking
        # An ask with no id could be matched by anything that sends none.
        if not ask or not ask["id"] or body.get("ask") != ask["id"]:
            self.refuse(session_id, 409, "that question is no longer waiting")
            return
        keys, why = ask_keys(ask, body.get("picks"))
        if why:
            self.refuse(session_id, 400, why)
            return
        # A second submit, or a send, while these keys go in one at a time
        # `KEY_GAP` apart, mixed its keys with them in the pane.
        pane = session.pane
        with self.daemon.holding(session_id, pane) as busy:
            if busy:
                self.refuse(session_id, 409, busy)
                return
            landed = tmux_keys(pane, keys)
        if landed < len(keys):
            # Some keys may have landed: say so, rather than "nothing went
            # in", which would send the reader back to answer twice.
            self.refuse(session_id, 502, f"tmux took {landed} of {len(keys)}"
                                         " keys; look at the question in the"
                                         " terminal")
            return
        self.reply_json({"id": session_id, "done": True, "keys": keys})

    def decline(self, session_id: str, session: Session,
                body: dict[str, Any]) -> None:
        """Say No to the permission dialog on screen, and maybe why.

        **No is Escape, and nothing else is pressed until the dialog is seen
        to close.** Measured against 2.1.282: Escape declines every dialog,
        where the number of "No" is 4 on a command and 3 on a file. The
        reason is a prompt typed after it -- the agent gets Claude Code's own
        "the user doesn't want to proceed", then these words. But the cursor
        starts on "1. Yes" and a digit picks an option, so the reason typed
        into a dialog that is still up can approve the very thing declined:
        an Escape read in one burst with the letters after it is an Alt key,
        not an Escape, and a busy Claude Code reads a burst. So the reason
        waits for the call's own result in the transcript
        (`Daemon.call_answered`), and is not typed without it.

        **Approving is not here, and must never be.** A dialog carries no id,
        so the page cannot prove which one a click answers; a wrong No is
        undone by saying what to do, a wrong Yes is not.
        """
        why = cannot_type(session, no=True)
        if why:
            self.refuse(session_id, 409, why)
            return
        shown = session.dialog
        if not shown or body.get("key") != shown["key"]:
            self.refuse(session_id, 409,
                        "that permission request is no longer waiting")
            return
        reason = body.get("reason")
        reason = reason if isinstance(reason, str) else ""
        if not typed(reason).strip():
            reason = ""
        why = typing_trouble(typed(reason), "that reason")
        if why:
            self.refuse(session_id, 400, why)
            return
        call = str(shown.get("call") or "")
        # Answered in the terminal and finished, and the row is amber only
        # because no hook says Yes: an Escape now would stop whatever the
        # agent went on to do. **An approved call still running cannot be
        # told from a dialog still up** -- its result comes when it ends --
        # so there the Escape stops it, and the page says so before the
        # press. That is the cost of No from here, and it is a stop, which
        # keeps the work done so far.
        if self.daemon.call_answered(session_id, call):
            self.refuse(session_id, 409,
                        "that request was answered in the terminal already")
            return
        pane = session.pane
        with self.daemon.holding(session_id, pane, no=True) as busy:
            if busy:
                self.refuse(session_id, 409, busy)
                return
            self.press_decline(session_id, pane, shown, call, reason)

    def press_decline(self, session_id: str, pane: str, shown: dict[str, Any],
                      call: str, reason: str) -> None:
        """Escape, the wait for the proof, and the reason: `decline`'s keys."""
        if not tmux_interrupt(pane):
            self.reply_json({"id": session_id,
                             "error": "tmux would not take the Escape, so"
                                      " nothing was declined"}, 502)
            return
        seen = False
        if call:
            deadline = time.monotonic() + DECLINE_WAIT
            while not seen and time.monotonic() < deadline:
                time.sleep(0.1)
                seen = self.daemon.call_answered(session_id, call)
        if seen:
            append_event({"session_id": session_id, "hook_event_name": "Declined",
                          "ts": time.time(), "key": shown["key"],
                          "tool_use_id": call})
        if not seen:
            # "Declined" would be a claim nothing proved: the Escape may have
            # landed on something else, and the row stays amber.
            unsent = (" Your reason was not typed: look at the pane, then send"
                      " it from the send box.") if reason else " Look at the pane."
            self.reply_json({"id": session_id, "done": True, "seen": False,
                             "error": "Escape went in, but the dialog was not"
                                      " seen to close." + unsent})
            return
        if not reason:
            self.reply_json({"id": session_id, "done": True, "seen": True})
            return
        if not tmux_send(pane, reason):
            self.reply_json({"id": session_id, "done": True, "seen": True,
                             "error": "Declined. tmux did not take the reason:"
                                      " look at the pane before sending it"
                                      " again."}, 502)
            return
        self.reply_json({"id": session_id, "done": True, "seen": True,
                         "sent": True})

    def send(self, session_id: str, session: Session,
             body: dict[str, Any]) -> None:
        text = body.get("text")
        text = text if isinstance(text, str) else ""
        why = ("there is nothing to send" if not typed(text).strip()
               else typing_trouble(typed(text), "that"))
        if why:
            self.refuse(session_id, 400, why)
            return
        # A dialog that is up has its cursor on "1. Yes": the Enter after the
        # text says Yes, and a text that starts with a digit picks that
        # option. `decline` waits for proof that the dialog closed before it
        # types; a send has no such proof, so it waits for the row.
        why = cannot_type(session)
        if why:
            self.refuse(session_id, 409, why)
            return
        pane = session.pane
        with self.daemon.holding(session_id, pane) as busy:
            if busy:
                self.refuse(session_id, 409, busy)
                return
            self.press_send(session_id, pane, text)

    def press_send(self, session_id: str, pane: str, text: str) -> None:
        """`send`'s keys, and the answer that says how they went."""
        # "It did not work" and nothing else on the page is how this arrives
        # for a reader: `done: false` carries no `error`, so `said` clears the
        # slot and writes nothing into it. A refusal from tmux is something
        # you asked for and did not get, and it has to say so.
        #
        # And it must not say more than it knows. `tmux_send` runs two
        # commands: the text, then Enter. If the second one failed the text is
        # already sitting on the agent's prompt, and "nothing went in" would
        # send the reader back to type it a second time -- so the message says
        # to look, which is the only thing that settles it.
        if not tmux_send(pane, text):
            self.reply_json({"id": session_id,
                             "error": "tmux did not answer. Look at the pane"
                                      " before sending again: the text may be"
                                      " on the prompt, unsent."}, 502)
            return
        self.reply_json({"id": session_id, "done": True})

    def do_GET(self) -> None:  # noqa: N802 - the name http.server requires
        self.guarded(self.route_get)

    def route_get(self) -> None:
        from urllib.parse import parse_qs, urlparse

        # A GET's body is never read, so a connection that carried one is
        # closed after the answer: kept open, the body was read as the next
        # request, and one GET got two answers (#235).
        if self.body_length() != 0:
            self.close_connection = True
        if not self.ours():
            self.reply_json({"error": "wostuast answers on localhost only"}, 403)
            return
        url = urlparse(self.path)
        path = url.path
        # The first of each, once: every verb read `query.get(x, [""])[0]`,
        # and one wrote itself a helper so as not to.
        query = {name: values[0] for name, values in parse_qs(url.query).items()}
        parts = path.strip("/").split("/")
        if path == "/":
            marks = {TOKEN_MARK: self.daemon.token,
                     VERSION_MARK: self.daemon.version,
                     SETTINGS_MARK: page_json(config_payload())}
            # One pass, so no mark is looked for in what another put in: the
            # settings are the reader's text, and a link holding the token's
            # mark would have had the token written into it.
            page = re.sub("|".join(map(re.escape, marks)),
                          lambda hit: marks[hit[0]], PAGE)
            self.reply(200, page.encode("utf-8"), "text/html; charset=utf-8")
        elif path == "/api/sessions":
            self.reply_json(self.daemon.sessions_payload())
        elif path == "/api/search":
            # Every session's prompts and last answers (#379): a scan of the
            # log, asked for as the reader types, never pushed.
            try:
                found = search_log(query.get("q", ""), self.daemon.store.sessions)
            except ValueError as error:
                self.reply_json({"results": [], "error": str(error)})
            else:
                self.reply_json({"results": found})
        elif path == "/api/saved":
            # Every saved turn, of every session (#377): asked for when the
            # list opens, not pushed.
            self.reply_json({"saved": self.daemon.store.saved})
        elif path == "/api/events":
            self.stream(query.get("watch", ""))
        elif len(parts) == 4 and parts[:2] == ["api", "session"] and parts[2]:
            found = GET_VERBS.get(parts[3])
            if found is None:
                self.reply_json({"error": "no such thing"}, 404)
            else:
                self.dispatch(found[0], found[1], parts[2], query)
        else:
            self.reply_json({"error": "no such thing"}, 404)

    def known(self, session_id: str) -> Session | None:
        """The session, or None with a 404 already sent."""
        session = self.daemon.session(session_id)
        if session is None:
            self.refuse(session_id, 404, "no such session")
        return session

    def dispatch(self, verb: Any, needs: str, session_id: str,
                 given: dict[str, Any]) -> None:
        """Find the session a verb needs, once, and hand it over.

        `needs` is "known" for any session, "in_tmux" for one with a pane
        the verb can type into, and "" for a verb that says itself what an
        unknown session gets (the transcript's `missing`). Every verb began
        with the same lookup, and the 404 of one carried no `id` while the
        409 of the other did.
        """
        session: Session | None = None
        if needs:
            session = self.in_tmux(session_id) if needs == "in_tmux" \
                else self.known(session_id)
            if session is None:
                return
        verb(self, session_id, session, given)

    def transcript(self, session_id: str, session: Session | None,
                   query: dict[str, str]) -> None:
        found = self.daemon.read_transcript(session_id)
        if found is None:
            self.reply_json({"id": session_id, "blocks": [],
                             "missing": "no transcript for this session"})
            return
        blocks, run, version = found
        # The page says which reading it holds, and how far. Coming back to
        # the Transcript tab fetched the whole of it every time, 856 KB for
        # four hundred rounds, while the pushes had kept the page up to date
        # all along. A reading still the same is answered with no blocks.
        if query.get("have", "") == f"{run}.{version}":
            self.reply_json({"id": session_id, "run": run, "version": version,
                             "same": True})
            return
        self.reply_json({"id": session_id, "run": run, "version": version,
                         "blocks": blocks_json(blocks)})

    def last(self, session_id: str, session: Session,
             query: dict[str, str]) -> None:
        """What the agent said last, for the "All unreads" feed (#376).
        Cut at `LAST_MAX`: the feed shows the start of each and opens the
        session for the rest, and a very long answer would go whole down an
        ssh tunnel for a glance."""
        text = session.last_answer
        cut = len(text) > LAST_MAX
        self.reply_json({"id": session_id, "text": text[:LAST_MAX] if cut else text,
                         "cut": cut, "at": session.ended_at})

    def commands(self, session_id: str, session: Session,
                 query: dict[str, str]) -> None:
        """What the send box can complete for this session.

        Asked for when the list opens, not pushed with the session: the
        list is a few kilobytes, and a row goes out on every change.
        Every session's transcript counts towards what was used, because a
        command used in one project is as likely in the next.
        """
        seen = [safe_transcript(one.transcript_path)
                for one in list(self.daemon.store.sessions.values())]
        found = self.daemon.commands.of(session.cwd, self.command_root(session),
                                        [path for path in seen if path])
        self.reply_json({"id": session_id,
                         "commands": [asdict(one) for one in found]})

    def command_root(self, session: Session) -> str:
        """Where the session's worktree starts, from the answer the Files
        tab keeps: asked of git on every poll, it was a process each time."""
        return self.daemon.files.root_of(session.cwd, run) or ""

    def command(self, session_id: str, session: Session,
                query: dict[str, str]) -> None:
        """One command's text, for the Commands tab (#367).

        Asked for by its name, never by a path: the page names one from
        the list it was sent, and only a file this session's list holds is
        read. `~/.claude` is outside every worktree, so the Files tab's
        route could not read it, and a path from the page is input
        (topics/safety). Found among the definitions alone
        (`Commands.defined`), nearest first as the list has them; a
        built-in has no file and is not asked for. The rest of what the
        tab shows -- the hint, the file, the uses -- is the list's."""
        name = query.get("name", "")
        one = next((each for each in self.daemon.commands.defined(
            session.cwd, self.command_root(session)) if each.name == name), None)
        read = command_text(one) if one else None
        if read is None:
            self.reply_json({"id": session_id, "error": "no such command"}, 404)
            return
        self.reply_json({"id": session_id, "name": name,
                         "text": read[0], "cut": read[1]})

    def files(self, session_id: str, session: Session,
              query: dict[str, str]) -> None:
        held = self.daemon.files.of(session.cwd)
        tree = held.tree
        body = {
            "id": session_id, "root": tree.root, "total": tree.total,
            "cut": tree.cut, "failed": tree.failed, "tag": held.tag,
            # The ignored directories too big to walk, and the number that
            # decided it. Both every time: they are a few dozen bytes, and
            # they are not in the tag, which is a hash of the names.
            "skipped": tree.skipped, "ignored_max": IGNORED_MAX,
            # Name to modification time, for the few files that moved. The
            # page needs the time to put the newest change first.
            "changed": held.changed,
        }
        # The browser sends back the tag it already holds. Names change
        # when a file is added or removed, which is rare; which files have
        # changed moves every few seconds. So a poll costs a few hundred
        # bytes instead of the 1.7 MB that fifty thousand names weigh.
        if not held.tag or query.get("have", "") != held.tag:
            body["names"] = held.names
        self.reply_json(body)

    def file(self, session_id: str, session: Session,
             query: dict[str, str]) -> None:
        wanted = query.get("path", "")
        found = read_worktree_file(session.cwd, wanted,
                                   held=self.daemon.files,
                                   have=query.get("have", ""))
        if found is None:
            self.reply_json({"id": session_id, "path": wanted,
                             "missing": "that file is not in this worktree"}, 404)
            return
        if found.same:
            self.reply_json({"id": session_id, "path": wanted, "same": True,
                             "stamp": found.stamp})
            return
        self.reply_json(dict(vars(found), id=session_id, path=wanted))

    def raw(self, session_id: str, session: Session,
            query: dict[str, str]) -> None:
        """One file of the worktree as its own bytes, for the page to show.

        The same checks every read makes, and one this route needs and the
        others do not: the type is decided by the end of the name, from a
        fixed list, and nothing on that list is a document. A file served as
        `text/html` from here would be a page an agent wrote, on the origin
        that holds the token, able to read both.
        """
        wanted = query.get("path", "")
        found = read_worktree_bytes(session.cwd, wanted,
                                    held=self.daemon.files)
        if found is None:
            self.reply_json({"error": "not a file this page shows"}, 404)
            return
        raw, kind = found
        # Not the `no-store` every other answer carries. The address holds the
        # file's mtime, so a file the agent has written is a different address
        # -- and without this the browser fetched the whole thing again on
        # every tab switch, which is what the mtime was put there to avoid.
        self.reply(200, raw, kind, cache="private, max-age=300")

    def diff(self, session_id: str, session: Session,
             query: dict[str, str]) -> None:
        # What to show is the page's to ask and git's to answer: a sha that
        # `branch_commits` did not list is never handed to git.
        of = query.get("of", "")
        # The base the reader picked, used only if git lists that name.
        base = query.get("base", "")
        report = worktree_diff(session.cwd, of=of, base=base,
                               ranks=self.daemon.ranks, held=self.daemon.diffs,
                               root=self.daemon.files.root_of(session.cwd, run))
        # The tab asks every five seconds, and the answer is the whole diff:
        # on a slow link the one transfer that never stopped. The page sends
        # back the tag of the answer it holds, and one that still stands is
        # answered with no diff. A hash of the answer itself, so everything
        # the page draws from it is in the tag -- a field left out of a tag
        # built by hand would change on the screen of nobody.
        # Written once: the tag is a hash of these bytes, and the answer is
        # these bytes with the tag set in before the closing brace. Built as a
        # dict and written twice, it cost two passes over the whole diff.
        text = wire_json(dict(vars(report), id=session_id))
        tag = answer_tag(text)
        if query.get("have", "") == tag:
            self.reply_json({"id": session_id, "tag": tag, "same": True})
            return
        self.reply(200, wire_bytes(text[:-1] + f', "tag": "{tag}"}}'),
                   "application/json; charset=utf-8")

    def whole(self, session_id: str, session: Session,
              query: dict[str, str]) -> None:
        """One file of the Diff tab with every line of it, for showing the
        lines between two changes. See `whole_file_diff`."""

        found = whole_file_diff(session.cwd, query.get("section", ""),
                                query.get("path", ""), query.get("old", ""),
                                query.get("of", ""), base=query.get("base", ""),
                                ranks=self.daemon.ranks)
        self.reply_json(dict(asdict(found), id=session_id))

    def stream(self, watching: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        client = self.daemon.hub.add(watching)
        try:
            first = wire_json(self.daemon.sessions_payload())
            # After joining the hub, so a block read after this is pushed to
            # this stream and one read before it is counted here. **Decided
            # before anything is written, and written in one go**: the socket
            # is not buffered, so a reader that saw `sessions` could make a
            # change -- a tick that starts reading the transcript -- before
            # this asked, and then got an opening it would not have got a
            # moment earlier, in front of the block it was waiting for.
            held = self.daemon.transcript_held(watching) if watching else None
            opening = ""
            if held is not None:
                told = wire_json({"id": watching, "run": held[0],
                                  "version": held[1], "opening": True})
                opening = f"event: transcript\ndata: {told}\n\n"
            self.wfile.write(
                wire_bytes(f"event: sessions\ndata: {first}\n\n" + opening))
            self.wfile.flush()
            while not self.daemon.stopping.is_set():
                try:
                    message = client.queue.get(timeout=15.0)
                except client.empty:
                    message = ": still here\n\n"  # a comment keeps it open
                if client.lost:
                    # A message was not kept, so nothing after it may go
                    # out (`Client.put`). The browser opens a new stream.
                    self.close_connection = True
                    break
                self.wfile.write(wire_bytes(message))
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            self.daemon.hub.drop(client)


# The verbs a session route can end in.
#: Each with the session it needs (`Serving.dispatch`).
#: The most of a last answer the feed is sent (#376): the feed folds an
#: answer past `FOLD_LINES` lines anyway, and opens the session for more.
LAST_MAX = 20_000

GET_VERBS: dict[str, tuple[Any, str]] = {
    "last": (Serving.last, "known"),
    "commands": (Serving.commands, "known"),
    "command": (Serving.command, "known"),
    "transcript": (Serving.transcript, ""),
    "files": (Serving.files, "known"),
    "file": (Serving.file, "known"),
    "raw": (Serving.raw, "known"),
    "diff": (Serving.diff, "known"),
    "whole": (Serving.whole, "known"),
}

# Four of these reach a terminal -- jump, send, answer and decline, which is
# an Escape and then a send -- and they are the reason every POST carries a
# token. There will never be another tmux verb without asking first
# (CLAUDE.md, **Shape**). `name` is not one: it writes a file of ours and
# touches no terminal, but it arrives the same way and is checked the same
# way.
#: Each with what its body is called, for the refusal of a body too large
#: to read (`route_post`).
POST_VERBS: dict[str, tuple[Any, str, str]] = {
    "jump": (Serving.jump, "request", "in_tmux"),
    "send": (Serving.send, "message", "in_tmux"),
    "answer": (Serving.answer, "answer", "in_tmux"),
    "decline": (Serving.decline, "reason", "in_tmux"),
    # It needs no pane: a session that has ended can still be named, which
    # is the point of naming one at all. Where there is one it types
    # `/rename` (#351), through the same lock as a send.
    "name": (Serving.name, "name", "known"),
    # A file of ours as well, and no terminal (#355).
    "snooze": (Serving.snooze, "snooze", "known"),
    # And so is what the reader has read (#373).
    "seen": (Serving.seen, "seen", "known"),
    # And a reminder (#375).
    "remind": (Serving.remind, "reminder", "known"),
    # And a turn saved for later (#377).
    "save": (Serving.save, "saved turn", ""),
}

#: The furthest a reminder may be set, in seconds: 31 days. The page offers
#: a day up to 30 days ahead (#406); this bounds what a POST may write. A
#: week was too short for "Monday at 08:00" on a Monday morning.
REMIND_MOST = 31 * 24 * 3600


def make_server(daemon: Daemon, port: int) -> Any:
    """Build the HTTP server. Every route is in `Serving`; what is here is the
    plumbing, and the import that must stay late."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(Serving, BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        # A `Content-Length` announced and never sent used to hold a thread
        # for ever. The event stream writes at least every fifteen seconds,
        # so it is never the one that runs out.
        timeout = 30
        server_version = "wostuast"
        daemon = None        # this server's own, set right below

    Handler.daemon = daemon
    server = ThreadingHTTPServer((BIND_HOST, port), Handler)
    server.daemon_threads = True
    return server


# --- commands ----------------------------------------------------------------


def give_up_after(seconds: int) -> None:
    """Set a deadline for this process. Passing it raises, nothing more waits.

    The hook and the status line both read stdin, which blocks until the writer
    closes it, and both take a file lock, which a network filesystem can stall.
    Neither may hold Claude Code, so the whole call runs under one deadline
    instead of guarding each wait. Where there is no SIGALRM, there is no
    deadline, and the call behaves as it did before.
    """
    import signal

    def out_of_time(number: int, frame: Any) -> None:
        raise TimeoutError(f"gave up after {seconds} s")

    try:
        signal.signal(signal.SIGALRM, out_of_time)
        signal.alarm(seconds)
    except (AttributeError, OSError, ValueError):
        pass


def stand_down() -> None:
    """Cancel the deadline set by give_up_after."""
    import signal

    try:
        signal.alarm(0)
    except (AttributeError, OSError, ValueError):
        pass


def read_stdin_json() -> dict[str, Any]:
    """Read one JSON object from stdin. Anything else reads as empty."""
    raw = sys.stdin.read()
    payload = json.loads(raw) if raw.strip() else {}
    return payload if isinstance(payload, dict) else {}


def cmd_hook(args: argparse.Namespace) -> int:
    """Read the hook JSON from stdin and append one line. Always exit 0.

    It prints nothing, and that silence is load-bearing. Claude Code reads a
    hook's stdout as the hook's answer. For PreToolUse that answer can allow or
    deny a tool, and PermissionRequest, which we register so that a waiting
    agent turns amber at once, takes a decision to allow or deny outright.
    Printing nothing means "no opinion", and the dialog behaves as if we were
    not here.

    So: never print in this function, and never print in anything it calls.
    wostuast must have no opinion, because approving without seeing the pane is
    how directories get deleted. Exit 0 whatever happens, and say anything
    worth saying in the log file.
    """
    # The outer `try` is for an alarm that fires after `log` returns and
    # before `stand_down` cancels it: outside every `try`, that was a
    # traceback on stderr and exit 1 (#235). An alarm fires once, so nothing
    # is armed by the time the outer `except` runs.
    try:
        try:
            give_up_after(HOOK_TIMEOUT)
            record = read_stdin_json()
            record["pid"] = agent_pid()
            # The pane it inherited is not its own when the agent reads no
            # terminal: an rc session, a `claude -p` (`reads_terminal`).
            reads = reads_terminal(record["pid"])
            record["pane"] = os.environ.get("TMUX_PANE", "") if reads else ""
            # And such an agent may have been run by another one, from its
            # Bash tool: the page draws it under that one's row (#422).
            # Only then, so an agent at a terminal pays nothing for it.
            # Its own `try`: a process name above that is not UTF-8 raised
            # in `read_text`, and the event was lost, not only the link.
            try:
                record["started_by"] = (0 if reads
                                        else claude_from(parent_pid(record["pid"])))
            except Exception:
                record["started_by"] = 0
            record["shell_pid"] = os.getppid()
            append_event(record, stamp=True)    # `ts`, under the log's lock
            stand_down()
        except BaseException as error:  # a hook must never block Claude Code
            # A deadline stays armed over the logging. `log` opens and writes
            # a file, and the failure being logged may be that the filesystem
            # is not answering — cancelling the alarm first and then writing
            # is how a hook holds Claude Code for ever, which is the one thing
            # it may not do. Armed again, and not merely left: an alarm fires
            # once, so when the failure *is* the timeout, nothing was armed.
            give_up_after(LOG_TIMEOUT)
            try:
                log(f"hook failed: {error!r}")
            finally:
                stand_down()
    except BaseException:
        pass
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    """Read the status line JSON from stdin, keep it, and print one line.

    Claude Code allows one status line command, and the payload arrives on
    stdin, which can only be read once. So a user who already has a status line
    cannot simply add ours next to it. `--then` is the way to have both: we
    read the payload, keep what we need, and hand the same text to their
    command, whose output is what the terminal shows.
    """
    raw = ""
    payload: dict[str, Any] = {}
    try:
        try:
            give_up_after(HOOK_TIMEOUT)
            raw = sys.stdin.read()
            payload = json.loads(raw) if raw.strip() else {}
            if not isinstance(payload, dict):
                payload = {}
            status = status_from_payload(payload)
            write_status(str(payload.get("session_id") or ""), status)
            stand_down()
        except BaseException as error:
            # The same as the hook's: a fresh deadline over the logging, which
            # the failure may be about. Cancelling first left none at all.
            payload = {}
            give_up_after(LOG_TIMEOUT)
            try:
                log(f"status failed: {error!r}")
            finally:
                stand_down()
    except BaseException:
        # The hook's outer `try`, for an alarm between `log` and `stand_down`.
        payload = {}

    then = getattr(args, "then", None)
    if then:
        print(run_status_line(then, raw), end="")
        return 0
    print(status_line(status_from_payload(payload), str(payload.get("cwd") or "")))
    return 0


def run_status_line(command: str, payload: str) -> str:
    """Run the status line the user already had, and give back what it printed.

    It runs through a shell because that is how Claude Code runs it, and it is
    the user's own command either way. A command that hangs or fails prints
    nothing rather than holding up the terminal.
    """
    import subprocess

    try:
        done = subprocess.run(
            command, shell=True, input=payload, capture_output=True,
            text=True, errors="replace", timeout=HOOK_TIMEOUT, check=False,
        )
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        log(f"the status line {command!r} failed: {error!r}")
        return ""
    return done.stdout


#: The version of the shape `session_json` and `ls --json` print. It goes up
#: only when a field is renamed or removed, which breaks a reader's script;
#: a field added is not a new version (#353).
JSON_VERSION = 1


def session_json(session: Session) -> dict[str, Any]:
    """One session as a script reads it: `ls --json` and `wait --json` (#353).

    Not `row`: that is the page's, and changes whenever the page does. This
    one is a promise, written in `README.md` and held field by field by
    `test_ls_json_keeps_its_shape`, so a field is added here and never
    renamed. Times are moments in seconds since the epoch, never "3min",
    which a script would have to parse back.
    """
    facts = session.git
    return {
        "id": session.session_id,
        "name": session.title,
        "place": session.place,
        "worktree_path": facts.root or session.home or session.cwd,
        "cwd": session.cwd,
        "state": session.state,
        "state_word": STATE_WORDS.get(session.state, session.state),
        # The moment it became what it is: `now - settled` is how long.
        "settled": round(session.settled, 3),
        "last_ts": round(session.last_ts, 3),
        "branch": facts.branch,
        "ahead": facts.ahead,
        "behind": facts.behind,
        "dirty": facts.dirty,
        "touched_files": facts.touched_files,
        "doing": facts.doing,
        "conflicts": facts.conflicts,
        "pane": session.pane,
        "pid": session.pid,
        "reason": session.reason,
        "last_event": session.last_event,
        "model": session.status.model,
        "cleared_into": session.cleared_into,
        "snoozed": session.snoozed,
    }


def print_json(sessions: Sequence[Session]) -> None:
    """The sessions as one JSON object on stdout: the version, the moment it
    was read, and the sessions in the order of the page."""
    print(json.dumps({"version": JSON_VERSION, "now": round(time.time(), 3),
                      "sessions": [session_json(one) for one in sessions]},
                     ensure_ascii=False))


def cmd_ls(args: argparse.Namespace) -> int:
    """Print one row per session, in the order of the sidebar."""
    as_json = bool(getattr(args, "json", False))
    drop_old_status()
    try:
        sessions = build_sessions()
    except OSError as error:        # a history read in part would look whole
        print(f"cannot read the event log: {error}", file=sys.stderr)
        return 1
    if as_json:
        add_git_facts(sessions)
        print_json(sort_sessions(sessions))
        return 0
    if not sessions:
        print("no sessions yet.")
        print("start a Claude Code session in tmux; run `wostuast doctor` to check the setup.")
        return 0
    # Sort again: the label a row sorts by is only complete once git has spoken.
    add_git_facts(sessions)
    sessions = sort_sessions(sessions)
    now = time.time()
    color = use_color()

    rows: list[tuple[str, list[str]]] = [
        ("", ["STATE", "SESSION", "BRANCH", "CHANGES", "PANE", "AGE", "LAST"])
    ]
    for session in sessions:
        rows.append(
            (
                session.state,
                [
                    STATE_WORDS.get(session.state, session.state),
                    session.label,
                    session.git.branch or "-",
                    changes_column(session.git) or "-",
                    session.pane or "-",
                    ago(now - session.since),
                    clip(session.reason or session.last_event, 60),
                ],
            )
        )
    print(table(rows, color))

    counts = Counter(session.state for session in sessions)
    summary = " · ".join(
        f"{counts[state]} {STATE_WORDS[state]}" for state in STATE_WORDS if counts.get(state)
    )
    print()
    print(summary)
    return 0


def which_tmux() -> bool:
    import shutil

    return shutil.which("tmux") is not None


#: What the transcript reader turns into something on the page. Anything
#: else it leaves out, which is right for the lists below and wrong for any
#: shape nobody has looked at yet.
READ_RECORDS = {"user", "assistant", "summary", "attachment/queued_command",
                "system/compact_boundary", "system/local_command"}
READ_PIECES = {"text", "thinking", "tool_use", "tool_result"}
#: Records the reader leaves out on purpose: bookkeeping, and the harness
#: talking to the agent. Read on real transcripts of 2.1.276 to 2.1.283.
#: `queue-operation` carries a queued message, which arrives again as the
#: `queued_command` attachment the reader does read. When `shapes` lists a
#: new name as not read, look at a real record before putting it here: the
#: queued message was an attachment of exactly that kind, missed for weeks.
SILENT_RECORDS = {
    "last-prompt", "atis-latch", "mode", "queue-operation", "cost-state",
    "file-history-snapshot", "custom-title", "agent-name", "permission-mode",
    "system/stop_hook_summary", "system/turn_duration", "system/informational",
    "attachment/total_tokens_reminder", "attachment/task_reminder",
    "attachment/deferred_tools_record", "attachment/deferred_tools_delta",
    "attachment/skill_listing", "attachment/prompt_snapshot",
    "attachment/silent_turn_reminder", "attachment/environment",
    "attachment/instructions", "attachment/mcp_instructions_delta",
    "attachment/date", "attachment/remote_session_change",
    "attachment/model", "attachment/session_context",
    "attachment/agent_listing_delta", "attachment/edited_text_file",
    "attachment/auto_mode", "attachment/compact_file_reference",
    "attachment/file", "attachment/credential_org",
    "attachment/command_permissions", "attachment/invoked_skills",
    "attachment/task_status", "attachment/thinking_drop",
}
#: A tag Claude Code wraps its own text in: lowercase, with a hyphen or an
#: underscore -- `bash-input`, `pasted_content`, `system-reminder`. HTML a
#: person types has neither, so a prompt about a `<div>` is not reported.
MACHINE_TAG_NAME = re.compile(r"</?([a-z][a-z0-9]*[-_][a-z0-9_-]*)[\s>]")
#: How far back `shapes` reads by default.
SHAPES_DAYS = 7


@dataclass
class Shapes:
    """What `transcript_shapes` found: names and counts, never text."""

    transcripts: int = 0
    records: int = 0
    versions: dict[str, int] = field(default_factory=dict)
    not_read: dict[str, int] = field(default_factory=dict)
    tags: dict[str, int] = field(default_factory=dict)


def record_shape(record: dict[str, Any]) -> str:
    """A record's kind as one name: `type`, or `type/subtype`."""
    kind = str(record.get("type") or "?")
    if kind == "attachment":
        inner = record.get("attachment")
        sub = inner.get("type") if isinstance(inner, dict) else ""
    else:
        sub = record.get("subtype") or ""
    return f"{kind}/{sub}" if sub else kind


def transcript_shapes(paths: Iterable[Path]) -> Shapes:
    """Read transcripts the way the page does, and count what it cannot show.

    Every recent bug report of one kind -- `!git up`, `/clear`, `/model`,
    paste tags on the row -- was Claude Code writing a shape the page did not
    know, and each time the reader found it first, as tags on the screen.
    This asks the page's own reader (`Transcript.add`) and lists two things:
    records and pieces it leaves out that are not on the lists above, and
    Claude Code's own tags left in what it shows as a prompt, a note or a
    command. Only names and counts leave here, so the output can go into a
    public report as it is.
    """
    found = Shapes()
    for path in paths:
        reader = Transcript(str(path))
        found.transcripts += 1
        try:
            # On "\n" only, as `Tail` reads: `splitlines` also breaks on
            # U+2028 and the file separators, which JSON strings may hold,
            # and cut 17 good records in half on the first machine it read.
            lines = path.read_text(encoding="utf-8", errors="replace").split("\n")
        except OSError:
            continue
        for line in lines:
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except ValueError:
                record = None
            if not isinstance(record, dict):
                _count(found.not_read, "(not a JSON object)")
                continue
            found.records += 1
            _count(found.versions, str(record.get("version") or "(none)"))
            shape = record_shape(record)
            if shape not in READ_RECORDS and record.get("type") not in READ_RECORDS:
                if shape not in SILENT_RECORDS:
                    _count(found.not_read, shape)
                continue
            message = record.get("message")
            content = message.get("content") if isinstance(message, dict) else None
            if isinstance(content, list):
                for piece in content:
                    kind = piece.get("type") if isinstance(piece, dict) else None
                    if kind not in READ_PIECES:
                        _count(found.not_read, f"{record.get('type')} piece: {kind}")
            try:
                blocks = reader.add(record)
            except Exception:
                _count(found.not_read, f"{shape} (the reader failed on it)")
                continue
            for block in blocks:
                if block.kind not in ("prompt", "note", "command", "shell"):
                    continue
                shown = f"{block.text}\n{block.result}"
                for name in set(MACHINE_TAG_NAME.findall(shown)):
                    # Only a tag that is closed too: Claude Code's come in
                    # pairs, and a `<uint32_t>` in C++ or a `<commit-hash>`
                    # placeholder in a skill's text does not.
                    if f"</{name}>" not in shown:
                        continue
                    # And in a prompt, only one that opens it: Claude Code's
                    # wrapper is the first thing in the record, and a person
                    # quoting one -- a bug report about this page -- writes
                    # their own words first.
                    if block.kind == "prompt" and not shown.lstrip().startswith(f"<{name}"):
                        continue
                    _count(found.tags, f"<{name}> in a {block.kind}")
    return found


def _count(counts: dict[str, int], name: str) -> None:
    counts[name] = counts.get(name, 0) + 1


def recent_transcripts(days: float, now: float | None = None) -> list[Path]:
    """Every transcript under Claude Code's projects written in the last days."""
    since = (now if now is not None else time.time()) - days * 86400
    folder = settings_path().parent / "projects"
    found = []
    for path in folder.glob("*/*.jsonl"):
        try:
            if path.stat().st_mtime >= since:
                found.append(path)
        except OSError:
            continue
    return sorted(found)


@dataclass
class Installed:
    """One thing wostuast put on the disk, for `files` and `report` (#321)."""

    group: str
    path: Path
    what: str
    count: int = 0          # files behind it: archives, one status file a session
    size: int = 0
    there: bool = False


#: The groups, in the order they are listed, and what `uninstall` does to each.
INSTALLED_GROUPS = {
    "Program": "uninstall keeps it",
    "Run by Claude Code": "uninstall removes these",
    "Claude Code's settings": "uninstall takes out only the entries wostuast added",
    "History": "uninstall keeps it: it is yours",
    "Your settings": "uninstall keeps it",
}


def installed_files() -> list[Installed]:
    """Every file and folder wostuast writes, grouped, with what it is for.

    One list for `wostuast files` and the report, so the two cannot drift.
    A new file on the disk belongs here, and in the README's Files table.
    """
    archives = archived_events_paths() or []
    rows = [
        Installed("Program", install_path(),
                  "the program: the page, the daemon and every command"),
        Installed("Run by Claude Code", hook_path(),
                  "the hook: one line in the event log for every event"),
        Installed("Run by Claude Code", status_program_path(),
                  "the status line: each session's name, model, context and cost"),
        Installed("Claude Code's settings", settings_path(),
                  "Claude Code's own file; wostuast adds its hooks and its status line"),
        Installed("History", events_path(), "every hook event, one JSON line each"),
        Installed("History", events_path().with_name("events.N.jsonl"),
                  "older events, moved out of the way at 20 MB; never deleted"),
        Installed("History", log_path(), "what went wrong, if anything"),
        Installed("History", status_dir(),
                  "the latest status line of each session, one file each"),
        Installed("History", names_path(), "the names you gave sessions on the page"),
        Installed("History", snoozed_path(),
                  "the sessions you snoozed on the page, until each moves on"),
        Installed("History", saved_path(),
                  "the turns you saved on the page, and the start of each"),
        Installed("History", reminders_path(),
                  "the reminders you set on the page, until each is read"),
        Installed("History", seen_path(),
                  "when you last read each session on the page, for its unread mark"),
        Installed("History", daemon_lock_path(),
                  "held while wostuast serves the page; says where"),
        Installed("Your settings", config_path(),
                  "what the settings menu sets, and your ticket links"),
    ]
    if links_path().exists():
        rows.append(Installed("Your settings", links_path(),
                              "no longer read: add the links in the menu, then delete it"))
    for row in rows:
        if row.path.name == "events.N.jsonl":
            parts = archives
        elif row.path == log_path():
            parts = [row.path, row.path.with_name(row.path.name + ".1")]
        elif row.path == status_dir():
            try:
                parts = list(row.path.glob("*.json"))
            except OSError:
                parts = []
        else:
            parts = [row.path]
        for part in parts:
            try:
                row.size += part.stat().st_size
                row.count += 1
            except OSError:
                pass
        row.there = row.count > 0
    return rows


def cmd_files(args: argparse.Namespace) -> int:
    """List every file wostuast wrote, grouped, with what each is for."""
    rows = installed_files()
    width = max(len(tilde(row.path)) for row in rows)
    out = ["wostuast files"]
    for group, fate in INSTALLED_GROUPS.items():
        mine = [row for row in rows if row.group == group]
        if not mine:
            continue
        out += ["", f"{group} ({fate})"]
        for row in mine:
            size = size_label(row.size) if row.there else "-"
            many = f", {counted(row.count, 'file', 'files')}" if row.count > 1 else ""
            gone = "" if row.there else " (not there)"
            out.append(f"  {tilde(row.path):<{width}}  {size:>8}  {row.what}{many}{gone}")
    print("\n".join(out))
    return 0


#: Payload fields whose value is a kind, not the reader's text: what the
#: report may count. A value is counted only when it looks like a name.
REPORT_KINDS = {
    "SessionStart": ("source",),
    "SessionEnd": ("reason",),
    "PreCompact": ("trigger",),
    "Notification": ("notification_type",),
    "PostToolUseFailure": ("error_type",),
}
REPORT_NAME = re.compile(r"[A-Za-z0-9_.:-]{1,64}")
#: What the transcript section's labels may hold: "attachment/new_thing",
#: "<task-id> in a note", "user piece: image".
REPORT_LABEL = re.compile(r"[A-Za-z0-9_.:<>/ -]{1,64}")


def named(value: Any) -> str:
    """The value when it is a name, never the reader's text: "(other)"."""
    return value if isinstance(value, str) and REPORT_NAME.fullmatch(value) else "(other)"


def labelled(value: Any) -> str:
    """A label of the transcript section, held to the same promise."""
    return value if isinstance(value, str) and REPORT_LABEL.fullmatch(value) else "(other)"


def tool_named(value: Any) -> str:
    """A tool's name; an MCP tool without its server. The reader names the
    server, and the name is often a company's or a project's."""
    name = named(value)
    parts = name.split("__")
    if name.startswith("mcp__") and len(parts) >= 3:
        return "mcp__\u2026__" + parts[-1]
    return name


def exception_named(line: str) -> str:
    """The builtin exception a line of the log names, or "(other)". Only a
    builtin: a capitalised word ending in "Error" was a folder's name in
    "listing /home/m/AcmeError/src failed: OSError(5)"."""
    import builtins

    for word in reversed(re.findall(r"\b([A-Z][A-Za-z]+)\(", line)):
        found = getattr(builtins, word, None)
        if isinstance(found, type) and issubclass(found, BaseException):
            return word
    return "(other)"


def recent_events(days: float, now: float | None = None) -> Iterator[dict[str, Any]]:
    """The events of the last `days`, oldest file first. An archive whose
    last write is older than that holds none, and is not read."""
    cutoff = (now if now is not None else time.time()) - days * 86400
    for path in (archived_events_paths() or []) + [events_path()]:
        try:
            if path.stat().st_mtime < cutoff:
                continue
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for line in handle:
                try:
                    event = json.loads(line)
                except (ValueError, RecursionError):
                    continue
                if isinstance(event, dict) and to_float(event.get("ts")) >= cutoff:
                    yield event


def program_cost(path: Path, payload: str, runs: int = 5) -> float | None:
    """The median milliseconds the hook or the status file takes, run as
    Claude Code runs it, into a state directory of its own. None when it
    is not installed or did not run."""
    import statistics
    import subprocess
    import tempfile

    if not os.access(path, os.X_OK):
        return None
    took: list[float] = []
    with tempfile.TemporaryDirectory() as home:
        env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": home,
               "WOSTUAST_STATE": str(Path(home) / "state")}
        for _ in range(runs):
            began = time.perf_counter()
            try:
                done = subprocess.run([str(path)], input=payload, text=True,
                                      capture_output=True, env=env, timeout=10)
            except (OSError, subprocess.SubprocessError):
                return None
            if done.returncode != 0:
                return None
            took.append((time.perf_counter() - began) * 1000)
    return statistics.median(took)


def report_table(head: Sequence[str], rows: Iterable[Sequence[Any]]) -> list[str]:
    """A Markdown table. A `|` in a cell would end it, so it is escaped."""
    def cell(value: Any) -> str:
        return " ".join(str(value).split()).replace("|", "\\|")

    out = ["| " + " | ".join(head) + " |", "|" + " --- |" * len(head)]
    out += ["| " + " | ".join(cell(one) for one in row) + " |" for row in rows]
    return out


def counts_of(found: Counter[str]) -> str:
    """"startup (3), resume (1)", most first."""
    return ", ".join(f"{name} ({n})" for name, n in found.most_common())


def private_paths() -> Callable[[str], str]:
    """What hides the paths in a line of the report: wostuast's own folders
    by name when they are not under home -- `XDG_STATE_HOME` can put the log
    anywhere, and that path can carry a user name -- and home as `~`."""
    home = str(Path.home())
    homed = home not in ("", "/")
    folders = [(state_dir(), "<state dir>"), (config_path().parent, "<config dir>"),
               (settings_path().parent, "<claude dir>"), (install_path().parent, "<bin dir>"),
               (hook_path().parent, "<share dir>")]
    swaps = [(str(path), label) for path, label in folders
             if not (homed and str(path).startswith(home + os.sep))]
    try:
        # A checkout's path names its project: "run `~/work/acme/wostuast install`".
        swaps.append((str(Path(__file__).resolve()), "<this copy>"))
    except NameError:
        pass
    if homed:
        swaps.append((home, "~"))
    # Longest first, home among them: a folder that holds home, `/home`,
    # replaced first left "<claude dir>/alice/...".
    swaps.sort(key=lambda one: -len(one[0]))

    def private(text: str) -> str:
        for path, label in swaps:
            text = text.replace(path, label)
        # What is left: any other absolute path, and anything quoted, which
        # is how a regular expression's error repeats the reader's pattern.
        text = re.sub(r"(?<![\w~>.])/[^\s,;:'\"`)]+", "<path>", text)
        return re.sub(r"'[^']*'|\"[^\"]*\"", "'\u2026'", text)

    return private


def build_report(days: float, now: float | None = None,
                 measure: bool = True) -> str:
    """Everything an agent needs to improve wostuast for this machine, as
    Markdown: names, counts, sizes and timings, never the reader's text
    (#323). It replaces `shapes`, whose transcript section it keeps."""
    import platform

    private = private_paths()

    out = [
        "# wostuast report",
        "",
        "This report describes one installation of wostuast"
        " (https://github.com/martinus/wostuast), a single Python file that"
        " watches Claude Code agents running in tmux: hooks append every event"
        " to a log, and a daemon serves a page that shows who needs the reader,"
        " what each agent said, and what it changed. `ARCHITECTURE.md` in that"
        " repository explains every part named here.",
        "",
        "It holds names, counts, sizes and timings only: never a prompt, a"
        " reply, a command, a file's content or a path outside the home"
        " folder's own layout. Use it to find a setup problem, Claude Code"
        " behaviour wostuast does not read yet (an event, a payload field, a"
        " transcript record), and what wostuast costs on this machine.",
        "",
        f"Made {time.strftime('%Y-%m-%d %H:%M')}; events and transcripts of the"
        f" last {days:g} days.",
    ]

    shapes = transcript_shapes(recent_transcripts(days, now))
    tmux = (run(["tmux", "-V"]) or "").strip() or "not found"
    git = (run(["git", "--version"]) or "").strip() or "not found"
    out += ["", "## Versions", ""]
    out += report_table(("What", "Version"), [
        ("wostuast", own_version() or "unknown"),
        ("Python", sys.version.split()[0]),
        ("Platform", f"{platform.system()} {platform.release()} ({platform.machine()})"),
        ("tmux", tmux),
        ("git", git),
        ("Claude Code, in transcripts",
         counts_of(Counter({named(v): n for v, n in shapes.versions.items()})) or "none seen"),
    ])

    out += ["", "## Setup", "", "What `wostuast doctor` checks.", ""]
    out += report_table(("Result", "Check"),
                        [(verdict, private(text)) for verdict, text in doctor_checks()])

    out += ["", "## Files", "", "What `wostuast files` lists.", ""]
    out += report_table(
        ("Group", "Path", "Size", "Files", "What it is for"),
        [(row.group, private(str(row.path)),
          size_label(row.size) if row.there else "not there",
          row.count, row.what) for row in installed_files()])

    events: Counter[str] = Counter()
    fields: dict[str, Counter[str]] = {}
    kinds: dict[str, Counter[str]] = {}
    tools: Counter[str] = Counter()
    sessions: set[str] = set()
    for event in recent_events(days, now):
        name = named(event.get("hook_event_name"))
        events[name] += 1
        fields.setdefault(name, Counter()).update(named(key) for key in event)
        sessions.add(str(event.get("session_id") or ""))
        if event.get("tool_name") is not None and name in ("PreToolUse", "PermissionRequest"):
            tools[tool_named(event.get("tool_name"))] += 1
        for field_name in REPORT_KINDS.get(name, ()):
            if field_name in event:
                kinds.setdefault(f"{name}.{field_name}", Counter())[
                    named(event[field_name])] += 1
    known = set(HOOK_EVENTS) | {"Declined"}
    out += ["", f"## Hook events, last {days:g} days", ""]
    if not events:
        out.append("No events in that time.")
    else:
        out.append(f"{sum(events.values())} events from"
                   f" {counted(len(sessions), 'session', 'sessions')}. An event"
                   " wostuast does not handle is marked **new**: it is kept in the"
                   " log, and nothing reads it yet.")
        out.append("")
        out += report_table(("Event", "Count", "Handled"), [
            (name, n, "yes" if name in known else "**new**")
            for name, n in events.most_common()])
        out += ["", "### Payload fields", "",
                "Every top-level field each event carried, with how often."
                " `ts`, `pane`, `pid` and `shell_pid` are added by the hook;"
                " `tests/fixtures/README.md` lists the fields wostuast reads.", ""]
        out += report_table(("Event", "Fields"), [
            (name, counts_of(fields[name])) for name, _ in events.most_common()])
        if kinds:
            out += ["", "### Kinds", "",
                    "Fields whose value names a kind; `(other)` is a value that"
                    " was not a plain name and is not shown.", ""]
            out += report_table(("Field", "Values"),
                                [(key, counts_of(found)) for key, found in sorted(kinds.items())])
        if tools:
            out += ["", "### Tools", "", "Tool calls that started or asked for permission.", ""]
            out += report_table(("Tool", "Calls"), tools.most_common())

    out += ["", f"## Transcripts, last {days:g} days", "",
            f"{shapes.records} records in {counted(shapes.transcripts, 'transcript', 'transcripts')}."]
    if shapes.not_read:
        out += ["", "Records and pieces the page does not show:", ""]
        out += report_table(("Record or piece", "Count"),
                            [(labelled(name), n) for name, n in
                             sorted(shapes.not_read.items(), key=lambda one: -one[1])])
    if shapes.tags:
        out += ["", "Claude Code's tags that still reach the page as text:", ""]
        out += report_table(("Tag", "Count"),
                            [(labelled(name), n) for name, n in
                             sorted(shapes.tags.items(), key=lambda one: -one[1])])
    if not shapes.not_read and not shapes.tags:
        out += ["", "Nothing the page does not know."]

    errors: Counter[str] = Counter()
    last: dict[str, str] = {}
    for path in (log_path().with_name(log_path().name + ".1"), log_path()):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            kind = exception_named(line)
            errors[kind] += 1
            # The day, when the line starts with one: a line a newline in a
            # logged path began gave its first ten letters instead.
            if re.match(r"\d{4}-\d{2}-\d{2}", line):
                last[kind] = line[:10]
    out += ["", "## Errors", "",
            "What `wostuast.log` holds, by the exception it names; the messages"
            " are left out, because they can hold paths and commands.", ""]
    if errors:
        out += report_table(("Exception", "Lines", "Last day"),
                            [(kind, n, last.get(kind, "-")) for kind, n in errors.most_common()])
    else:
        out.append("None.")

    out += ["", "## Cost", ""]
    if measure:
        hook = program_cost(hook_path(), json.dumps(
            {"session_id": "wostuast-report", "hook_event_name": "Notification"}))
        status = program_cost(status_program_path(),
                              json.dumps({"session_id": "wostuast-report"}))
        out.append("The installed hook and status file, each run five times as"
                   " Claude Code runs them, into a state directory of their own.")
        out.append("")
        out += report_table(("Program", "Median"), [
            ("hook.py, one event", f"{hook:.0f} ms" if hook is not None else "did not run"),
            ("status.py, one redraw", f"{status:.0f} ms" if status is not None else "did not run"),
        ])
    else:
        out.append("Not measured.")
    return "\n".join(out) + "\n"


def cmd_report(args: argparse.Namespace) -> int:
    """Print the report: Markdown for an agent, names and counts only."""
    print(build_report(getattr(args, "days", SHAPES_DAYS)), end="")
    return 0


#: How often `wait` looks at the log again. It reads only what was appended
#: (`EventFollower`), so this is a cheap look, not a read of the history.
WAIT_STEP = 0.5


def wait_states(text: str) -> frozenset[str]:
    """The states a `--until` names: a state as the log says it
    (`needs_you`), as `ls` prints it (`needs you`, `ready`, `killed`), or
    `over`, which is both ways a session ends."""
    import argparse

    key = text.strip().lower().replace("-", "_").replace(" ", "_")
    if key == "over":
        return frozenset(GONE_STATES)
    for state, word in STATE_WORDS.items():
        if key in (state, word.replace(" ", "_")):
            return frozenset({state})
    words = ", ".join([*STATE_WORDS, "over"])
    raise argparse.ArgumentTypeError(f"{text!r} is not a state: use {words}")


def pick_session(sessions: Sequence[Session], text: str) -> tuple[Session | None, str]:
    """The session `text` names, or why there is none: its id, the start of
    its id, its name, or its place -- the first of these that any session
    fits. Two that fit the same way is no answer, and the message names
    both, so the reader can say which."""
    tests = (
        lambda s: s.session_id == text,
        lambda s: s.session_id.startswith(text),
        lambda s: s.title == text,
        lambda s: s.place == text,
    )
    for fits in tests:
        found = [one for one in sessions if fits(one)]
        if len(found) == 1:
            return found[0], ""
        if found:
            named = "; ".join(f"{one.session_id[:8]} {one.label}" for one in found[:5])
            return None, (f"{text!r} fits {counted(len(found), 'session', 'sessions')}:"
                          f" {named}. Say which, by the start of its id.")
    return None, f"no session is called {text!r}: `wostuast ls` lists them"


def cmd_wait(args: argparse.Namespace) -> int:
    """Return when a session reaches a state, or any session does (#356).

    It only reads: the log, as the daemon does, so no daemon has to run.
    A `/clear` ends a session and goes on in a new one in the same pane;
    the wait goes with it, as the page does (`cleared_into`). Exit 0 when
    the state is reached, 1 for a session that is unknown or has ended in
    another state, 124 at `--timeout`, as `timeout(1)` says it.
    """
    wanted = frozenset().union(*args.until)
    store = Store()
    deadline = None if args.timeout is None else time.monotonic() + args.timeout
    pinned = ""
    try:
        while True:
            store.follow()
            sessions = sort_sessions(store.settle(time.time()))
            hit: Session | None = None
            if args.session:
                if not pinned:
                    found, trouble = pick_session(sessions, args.session)
                    if found is None:
                        print(trouble, file=sys.stderr)
                        return 1
                    pinned = found.session_id
                session = store.sessions.get(pinned)
                while session is not None and session.cleared_into \
                        and session.state not in wanted:
                    pinned = session.cleared_into
                    session = store.sessions.get(pinned)
                if session is None:
                    print(f"session {pinned[:8]} is no longer in the log",
                          file=sys.stderr)
                    return 1
                if session.state in wanted:
                    hit = session
                elif session.state in GONE_STATES:
                    print(f"{session.label} {STATE_WORDS[session.state]}"
                          f" without becoming {'/'.join(sorted(wanted))}",
                          file=sys.stderr)
                    return 1
            else:
                hit = next((one for one in sessions if one.state in wanted), None)
            if hit is not None:
                if args.json:
                    add_git_facts([hit])
                    print_json([hit])
                else:
                    print(f"{hit.session_id[:8]} {hit.label}:"
                          f" {STATE_WORDS.get(hit.state, hit.state)}")
                return 0
            if deadline is not None and time.monotonic() >= deadline:
                print("timed out", file=sys.stderr)
                return 124
            time.sleep(WAIT_STEP)
    except KeyboardInterrupt:
        return 130


def cmd_doctor(args: argparse.Namespace) -> int:
    """Check the setup and say what is wrong."""
    checks = doctor_checks()
    problems = sum(1 for verdict, _ in checks if verdict == "FAIL")
    print("wostuast doctor")
    print("\n".join(f"  {verdict:<4}  {text}" for verdict, text in checks))
    print()
    print("all good." if problems == 0 else f"{problems} problem(s) to fix.")
    return 1 if problems else 0


def doctor_checks() -> list[tuple[str, str]]:
    """Every check `doctor` makes, as ("ok" | "FAIL" | "note", what it found).
    `report` hands an agent the same rows (#323)."""
    lines: list[tuple[str, str]] = []

    def report(ok: bool, good: str, bad: str, fatal: bool = True) -> None:
        if ok:
            lines.append(("ok", good))
        else:
            lines.append(("FAIL" if fatal else "note", bad))

    report(sys.version_info >= (3, 10), f"python {sys.version.split()[0]}",
           f"python {sys.version.split()[0]} is older than 3.10")

    directory = state_dir()
    trouble = state_dir_trouble()
    report(not trouble, f"state directory {directory}",
           f"cannot write {directory}: {trouble}")

    events = events_path()
    try:
        count, held, size = measure_log()
        report(events.exists(),
               f"event log {events} with {count} events"
               f" in {counted(held, 'file', 'files')} ({size_label(size)})",
               f"no events yet at {events}; run a Claude Code session", fatal=False)
    except OSError as error:
        report(False, "", f"cannot read the event log: {error}", fatal=False)

    path = settings_path()
    settings: dict[str, Any] = {}
    try:
        settings, _, _ = load_settings(path)
    except (OSError, ValueError) as error:
        report(False, "", unreadable(path, error))
    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}
    # Only the hook file counts. An entry from before it names `wostuast
    # hook`, which is gone (#322): it records nothing, so it is missing.
    missing = [
        event
        for event in HOOK_EVENTS
        if not any(runs_hook_file(group) for group in (hooks.get(event) or []))
    ]
    report(not missing, f"all {len(HOOK_EVENTS)} hooks registered in {path}",
           f"hooks missing in {path}: {', '.join(missing)}; run `wostuast install`")

    current = settings.get("statusLine")
    line = current.get("command") if isinstance(current, dict) else None
    mine = is_status_file(line)
    report(mine, "status line registered (session names and context)",
           "status line runs `wostuast status`, which is gone; run `wostuast install`"
           if is_ours(line, "status") else
           "status line not registered; without it sessions have no name and no context percent",
           fatal=False)

    report(which_tmux(), "tmux found",
           "tmux not found; jump and send stay hidden", fatal=False)

    # The settings, if there are any. A broken one is a note and not a
    # failure: the page reads perfectly well on its defaults, and the point
    # of saying so is that a link doing nothing gives no clue why.
    if config_path().exists():
        _, links, trouble = load_config()
        usable = sum(1 for one in links if not one["trouble"])
        report(not trouble,
               f"settings in {config_path()}, {usable} ticket link(s)",
               "; ".join(trouble), fatal=False)
    if links_path().exists():
        report(False, "",
               f"{links_path()} is no longer read; add the links in the page's"
               " settings menu, then delete the file", fatal=False)
    report(install_path().exists(), f"installed at {install_path()}",
           f"not installed at {install_path()}; run `wostuast install`", fatal=False)
    behind = install_behind()
    report(not behind, "the installed copy is this version", behind)
    return lines


def own_version(path: Path | None = None) -> str:
    """Which copy of this file is running, or of the program at `path`: the
    day it was last written, and the first seven hex digits of the SHA-256
    of its bytes. `--version` prints it (#344).

    There is no version number to keep up to date, on purpose -- a number
    somebody has to remember to raise is one that is wrong half the time.
    The bytes are what `install_behind` compares, so two copies that say the
    same here are the same program. A copy `install` fetched carries the day
    of its commit (`fetch_newest`), not the day it was fetched. The day is
    UTC's, as a commit's is: in local time, a commit at 23:00 UTC read as
    the next day east of London, and one copy had two versions. "" when the
    file cannot be read.
    """
    import hashlib

    try:
        here = path or Path(__file__).resolve()
        data = here.read_bytes()
        day = time.strftime("%Y-%m-%d", time.gmtime(here.stat().st_mtime))
    except (NameError, OSError):
        return ""
    return f"{day} \u00b7 {hashlib.sha256(data).hexdigest()[:7]}"


def hook_files_missing() -> list[str]:
    """The hook files Claude Code's settings run that cannot be run."""
    try:
        settings, _, _ = load_settings(settings_path())
    except (OSError, ValueError):
        return []
    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}
    named = {
        words_of(entry["command"])[0]
        for groups in hooks.values() if isinstance(groups, list)
        for group in groups if isinstance(group, dict)
        for entry in group.get("hooks") or []
        if isinstance(entry, dict) and is_hook_file(entry.get("command"))
    }
    line = settings.get("statusLine")
    if isinstance(line, dict) and is_status_file(line.get("command")):
        named.add(words_of(line["command"])[0])
    return sorted(path for path in named if not os.access(path, os.X_OK))


def install_behind(built: tuple[str, str] | None = None) -> str:
    """Why the installed copy is not this one, or "" when it is.

    `built` is the hook file and the status file this version writes, when
    the caller has made them already: `program_files` parses the whole
    program, and a start made them twice, once to write and once to compare.

    `install` copies this file to `install_path()`, and the hooks and the
    status line run that copy -- not the checkout `serve` was started from.
    A reader who pulled and restarted `serve` had a page that knew about the
    session's spend and a status line, run by the copy from the day before,
    that never wrote it down: the page showed no cost, and nothing said why.
    Nothing is wrong when there is no copy to compare, when this *is* the
    copy, or when the two hold the same bytes.
    """
    here = Path(__file__).resolve() if "__file__" in globals() else None
    target = install_path()
    if here is None:
        return ""
    # A hook file the settings name and the disk does not hold is every
    # event lost, and the hooks still look registered: `is_ours` knows the
    # command by its shape. Before the file, the command was the program,
    # and "installed at" caught it.
    gone = hook_files_missing()
    if gone:
        return (f"the hooks run {', '.join(gone)}, which is not there or"
                f" cannot run, so nothing is recorded; run `{here} install`")
    # The hook file is made from the program, so it is behind when it is
    # not what this version makes -- an install of an older copy, or a hand
    # that edited it. Only when there is one: before it, the hooks ran the
    # program, and the check below covers that.
    # The status file the same way, only when there is one.
    try:
        for made, name, who in ((hook_path(), "hook", "hooks"),
                                (status_program_path(), "status line",
                                 "status line")):
            try:
                held = made.read_text(encoding="utf-8")
            except (OSError, ValueError):
                continue
            built = built or program_files(here.read_text(encoding="utf-8"))
            if held != built[0 if name == "hook" else 1]:
                return (f"{made} is not the {name} this version writes. The"
                        f" {who} run{'s' if who != 'hooks' else ''} it, so what"
                        f" this version records is not recorded; run"
                        f" `{here} install`")
    except (OSError, SyntaxError, ValueError):
        return ""
    try:
        if here == target.resolve():
            return ""
        if target.read_bytes() == here.read_bytes():
            return ""
    except OSError:
        return ""
    return (f"{target} is not this version ({here}). The hooks and the status"
            f" line run {target}, so what this version records is not"
            f" recorded; run `{here} install`")


def self_source() -> str:
    """Our own source code, so `install` can copy it. Downloads it if needed."""
    here = Path(__file__).resolve() if "__file__" in globals() else None
    if here and here.is_file():
        return here.read_text(encoding="utf-8")
    import urllib.request

    with urllib.request.urlopen(RAW_URL, timeout=30) as response:
        return response.read().decode("utf-8")


def newest_program(opener: Callable[[str], Any] | None = None) -> tuple[str, float]:
    """The program as the last commit on main that changed it left it, and
    that commit's time.

    Two requests: which commit (`COMMITS_URL`), then the file at its SHA
    (`RAW_AT`). The text must compile and start as the program does, so an
    error page or half a file is refused here and is never installed.
    Raises OSError, ValueError, KeyError, IndexError, TypeError or
    SyntaxError; `fetch_newest` says them in one line.
    """
    import datetime
    import urllib.request

    def fetch(url: str) -> bytes:
        if opener is not None:
            with opener(url) as response:
                return response.read()
        with urllib.request.urlopen(url, timeout=30) as response:
            return response.read()

    commit = json.loads(fetch(COMMITS_URL).decode("utf-8"))[0]
    sha = commit["sha"]
    # It goes into a URL: forty hex digits, or nothing is fetched.
    if not re.fullmatch(r"[0-9a-f]{40}", str(sha)):
        raise ValueError(f"not a commit: {clip(str(sha), 60)}")
    when = datetime.datetime.fromisoformat(
        str(commit["commit"]["committer"]["date"]).replace("Z", "+00:00"))
    text = fetch(RAW_AT.format(sha)).decode("utf-8")
    if not text.startswith("#!/usr/bin/env python3\n"):
        raise ValueError("what came back is not the program")
    compile(text, "wostuast", "exec")
    return text, when.timestamp()


def runs_installed() -> bool:
    """Whether this is the installed copy, or no file at all -- the one-line
    install runs the program from a string. Only these fetch the newest
    from GitHub: `./wostuast install` in a checkout installs the checkout,
    so a branch being tried is not replaced by main. **Neither is a link**:
    an installed copy that is a symlink to a checkout resolved to the
    checkout's own path, and `install` would have renamed main over it."""
    if "__file__" not in globals():
        return True
    try:
        target = install_path()
        return (not target.is_symlink()
                and Path(__file__).resolve() == target.resolve())
    except OSError:
        return False


def fetch_newest(target: Path,
                 newest: Callable[[], tuple[str, float]] | None = None
                 ) -> tuple[str, str]:
    """Bring the program at `target` to the newest on main (#345). Returns
    the line to print, and "changed", "same", or "" when the fetch failed.
    Changed, the new copy must run its own `install`, because the hook file
    is built from the program that builds it.

    The file takes the commit's time, so `own_version` says the day the
    program was made, not the day it was fetched -- and when the bytes are
    already the newest, the time alone is set. A fetch that fails says why
    in one line, and the install goes on with the copy it has: no network
    is no reason to leave the hooks unregistered.
    """
    try:
        text, when = (newest or newest_program)()
    except (OSError, ValueError, KeyError, IndexError, TypeError, SyntaxError) as error:
        reason = str(error).strip() or type(error).__name__
        return (f"could not check GitHub for a newer wostuast"
                f" ({clip(reason, 120)}); installing this one"), ""
    before = own_version(target) if target.exists() else ""
    changed = write_program(target, text)
    with contextlib.suppress(OSError):
        os.utime(target, (when, when))
    now = own_version(target)
    if not changed:
        return f"already the newest wostuast: {now}", "same"
    return (f"updated {tilde(target)}: {before} → {now}" if before
            else f"fetched the newest wostuast: {now}"), "changed"


#: What the hook file is made of: the definitions on the hook's path, by
