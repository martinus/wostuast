    sys.exit(cmd_status(StatusArgs))
'''


def hook_source(source: str) -> str:
    """The hook file for this version of the program, given its source."""
    return program_files(source)[0]


def status_source(source: str) -> str:
    """The status file for this version of the program, given its source."""
    return program_files(source)[1]


def program_files(source: str) -> tuple[str, str]:
    """The hook file and the status file for this version of the program,
    from one parse of its source: a parse is 63 ms, and a start makes both.

    Raises ValueError when a part is missing, so `install` stops rather than
    write a hook that would fail on every event -- and fail quietly, because
    a hook may say nothing (topics/safety, the first two bullets).
    """
    import ast

    lines = source.splitlines(keepends=True)
    parts: dict[str, str] = {}
    for node in ast.parse(source).body:
        if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
            name = node.name
        elif isinstance(node, ast.Assign) and len(node.targets) == 1 \
                and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
            name = node.target.id
        else:
            continue
        if name in HOOK_PARTS | STATUS_PARTS:
            # From the first decorator: `ast` puts a class at its `class`
            # line, and `Status` came out with no `@dataclass` above it.
            first = min([one.lineno for one in getattr(node, "decorator_list", [])]
                        + [node.lineno])
            parts[name] = "".join(lines[first - 1:node.end_lineno])
    made = []
    for wanted, head, tail, what in ((HOOK_PARTS, HOOK_HEAD, HOOK_TAIL, "hook"),
                                     (STATUS_PARTS, STATUS_HEAD, STATUS_TAIL,
                                      "status line")):
        missing = wanted - parts.keys()
        if missing:
            raise ValueError(f"the {what} needs {', '.join(sorted(missing))}")
        made.append(head + "\n\n".join(one for name, one in parts.items()
                                        if name in wanted) + tail)
    return made[0], made[1]


def write_program(target: Path, text: str) -> bool:
    """Write a file the hooks run, whole or not at all. True when it changed.

    It is registered on every event of every running session. Writing it in
    place would let a hook read half a file and die. Write beside it and
    rename, which is atomic; a hook that is already running keeps the old
    file open and finishes normally.
    """
    try:
        if target.read_text(encoding="utf-8") == text:
            return False
    except (OSError, ValueError):
        pass
    write_atomic(target, text, mode=0o755)
    return True


def bring_up_to_date() -> tuple[list[str], list[str], str, tuple[str, str] | None]:
    """Write what is behind this version: the program, the hook file, the
    status file, the hooks and the status line. Returns what changed, what
    to tell the reader, why it could not or "", and the two files it built,
    so that `install_behind` does not build them again.

    Nothing that is already right is written, Claude Code's `settings.json`
    least of all: a bare `wostuast` runs this on every start (#275), and a
    start with nothing to fix must leave the user's file alone, its time
    included. `install` and the start share it, so they cannot drift.
    """
    changes: list[str] = []
    target = install_path()
    source = self_source()
    try:
        built = program_files(source)
    except (SyntaxError, ValueError) as error:
        return [], [], f"cannot build the hook: {error}", None
    if write_program(target, source):
        changes.append(f"wrote {target}")
    for made, text in zip((hook_path(), status_program_path()), built):
        if write_program(made, text):
            changes.append(f"wrote {made}")

    path = settings_path()
    try:
        settings, indent, newline = load_settings(path)
    except (OSError, ValueError) as error:
        return changes, [], unreadable(path, error), built
    before = json.dumps(settings, sort_keys=True)
    try:
        changes += add_hooks(settings, hook_command(hook_path()))
        said = add_status_line(settings, status_command(status_program_path()))
    except ValueError as error:
        return changes, [], f"{path}: {error}", built
    # Added or moved is a change; the rest is advice about theirs.
    done = ("added status line", "moved status line")
    notes = [line for line in said if line not in done]
    changes += [line for line in said if line in done]
    if json.dumps(settings, sort_keys=True) != before:
        save_settings(path, settings, indent, newline)
    return changes, notes, "", built


def cmd_install(args: argparse.Namespace) -> int:
    """Copy wostuast to ~/.local/bin and register the hooks and the status line.

    The installed copy, and the one-line install, first fetch the newest
    from GitHub (`fetch_newest`), and run its own install when it differs.
    `--fetched` is that run: it never fetches again. Keep the flag's name,
    because an older copy is what passes it.
    """
    target = install_path()
    if not getattr(args, "fetched", False) and runs_installed():
        said, fetched = fetch_newest(target)
        print(said)
        # The one-line install has no file, so `bring_up_to_date` would
        # take raw `main` (`self_source`), which is cached and can be older
        # than what was just written: it hands over even when nothing changed.
        if fetched == "changed" or (fetched and "__file__" not in globals()):
            sys.stdout.flush()
            os.execv(sys.executable,
                     [sys.executable, str(target), "install", "--fetched"])
    changes, notes, trouble, _ = bring_up_to_date()
    if trouble:
        print(trouble, file=sys.stderr)
        return 1
    for line in (changes or ["nothing to change"]) + notes:
        print(line)
    if str(target.parent) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"note: {target.parent} is not on your PATH")
    print("restart your Claude Code sessions so they pick up the hooks.")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    """Remove our hooks and our status line. Leave the event log alone."""
    target = install_path()
    path = settings_path()
    try:
        settings, indent, newline = load_settings(path)
    except (OSError, ValueError) as error:
        print(unreadable(path, error), file=sys.stderr)
        return 1
    changes = remove_hooks(settings)
    changes += remove_status_line(settings)
    if changes:
        save_settings(path, settings, indent, newline)
    # The hook file is ours alone, written by `install` and run by nothing
    # once the hooks are gone. The program stays: it is what the reader
    # installed, and the message below says how to remove it.
    for made in (hook_path(), status_program_path()):
        try:
            made.unlink()
            changes.append(f"removed {made}")
        except OSError:
            pass
    try:
        hook_path().parent.rmdir()
    except OSError:
        pass
    for line in changes or ["nothing to change"]:
        print(line)
    print(f"the event log stays in {state_dir()}")
    if target.exists():
        print(f"remove the program yourself with: rm {target}")
    return 0


#: How each line of the start begins, and its colour: green for what is
#: right, yellow for what changed or is worth a look, grey for a passing
#: word, red for what stops it. The issue asked for a start where "one
#: immediately sees what is important" (#275).
MARKS = {"ok": ("✓", "\033[32m"), "changed": ("↻", "\033[33m"),
         "note": ("·", "\033[90m"), "warn": ("!", "\033[33m"),
         "fail": ("✗", "\033[31m"), "go": ("▶", "\033[1m")}


def mark(kind: str, text: str, color: bool) -> str:
    """One line of the start: two spaces, its mark, and the text."""
    sign, ink = MARKS[kind]
    if not color:
        return f"  {sign} {text}"
    return f"  {ink}{sign}{RESET} {text}"


def tilde(path: Path | str) -> str:
    """A path as a person writes it: under the home, with `~`."""
    text, home = str(path), str(Path.home()).rstrip("/")
    # A home of "/" or "" would make every path "~something".
    if not home:
        return text
    return "~" + text[len(home):] if text == home or text.startswith(home + "/") else text


def changed_parts(changes: list[str]) -> list[str]:
    """What `bring_up_to_date` changed, in a few words: a file by its path,
    and the hooks counted, not named one by one -- twelve lines of "added
    hook" said less than "12 hooks"."""
    parts = [tilde(line[len("wrote "):]) for line in changes if line.startswith("wrote ")]
    hooks = sum(1 for line in changes if line.startswith(("added hook", "moved hook")))
    if hooks:
        parts.append(counted(hooks, "hook", "hooks"))
    if "added status line" in changes or "moved status line" in changes:
        parts.append("status line")
    return parts


def cmd_serve(args: argparse.Namespace) -> int:
    """Check the setup, bring the hooks up to date, and serve the page.

    One command for all of it (#275): `serve`, `install` and `doctor` were
    three things to remember, and a hook left behind by an update recorded
    nothing while every check that would have said so went unrun. What is
    right gets one green line, what changed a yellow one, what stops it a
    red one; `doctor` is still there for the long form.
    """
    import shutil

    color = use_color()
    head = "wostuast"
    print(f"\033[1m{head}\033[0m · {own_version()}" if color
          else f"{head} · {own_version()}")

    tools = [f"python {sys.version.split()[0]}"]
    tools += [name for name in ("tmux", "git") if shutil.which(name)]
    print(mark("ok", " · ".join(tools), color))
    if not which_tmux():
        print(mark("warn", "tmux not found: jump and send stay hidden", color))

    directory = state_dir()
    trouble = state_dir_trouble()
    if trouble:
        print(mark("fail", f"cannot write {tilde(directory)}: {trouble}", color),
              file=sys.stderr)
        return 1

    held, holder = one_daemon()
    if held is None:
        print(mark("fail", holder, color), file=sys.stderr)
        return 1
    try:
        return serve_page(args, color, held)
    finally:
        os.close(held)


def one_daemon() -> tuple[int | None, str]:
    """Take the lock that says a daemon serves this state directory: the
    open descriptor, which holds it until it is closed or the process ends,
    or None and a line that says where the one that holds it is (#320).

    A second daemon on another port ran beside the first, and was nearly
    harmless: both appended a `Declined` for the same dialog, two renames at
    once could lose one, and "one send at a time" holds within one daemon,
    so two pages on two daemons could type into one pane together. The
    port alone cannot stop it, because `--port` picks another. A lock in
    the state directory can, and `flock` lets go when the process dies, so
    a crash leaves nothing behind that a start would have to clear. It is
    taken before the start writes anything, so a second start changes
    nothing at all.
    """
    path = daemon_lock_path()
    try:
        held = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError as error:
        return None, f"cannot open {tilde(path)}: {error.strerror or error}"
    try:
        fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        # Only this one means another process holds it. Any other error --
        # a file system with no locks -- said "already running" about a
        # daemon that did not exist.
        try:
            said = os.read(held, 512).decode("utf-8", "replace")
        except OSError:
            said = ""
        os.close(held)
        return None, holder_of(said)
    except OSError as error:
        os.close(held)
        return None, f"cannot lock {tilde(path)}: {error.strerror or error}"
    say_who(held, {"pid": os.getpid()})
    return held, ""


def say_who(held: int, who: dict[str, Any]) -> None:
    """Write what the lock says about the daemon that holds it."""
    try:
        os.ftruncate(held, 0)
        os.pwrite(held, (json.dumps(who) + "\n").encode("utf-8"), 0)
    except OSError as error:
        log(f"could not write {daemon_lock_path()}: {error!r}")


def holder_of(said: str) -> str:
    """The line a second start prints, from what the lock file says."""
    try:
        who = json.loads(said)
    except ValueError:
        who = {}
    if not isinstance(who, dict):
        who = {}
    pid = who.get("pid")
    url = who.get("url")
    line = "wostuast is already running"
    if isinstance(url, str) and url:
        line += f" at {url}"
    elif pid:
        line += ", and still starting"
    if isinstance(pid, int):
        line += f" (pid {pid})"
    return line + ": open that page, or stop it first"


def serve_page(args: argparse.Namespace, color: bool, held: int) -> int:
    """The rest of the start, with the daemon's lock held."""
    import threading

    changes, notes, trouble, built = bring_up_to_date()
    if trouble:
        print(mark("fail", trouble, color), file=sys.stderr)
        return 1
    if changes:
        print(mark("changed", "updated " + " \u00b7 ".join(changed_parts(changes)), color))
        print("    restart your Claude Code sessions to use them")
    else:
        print(mark("ok", f"{len(HOOK_EVENTS)} hooks → {tilde(hook_path())}", color))
    if notes:
        print(mark("warn", "your own status line runs, so sessions have no name"
                   " and no context; `wostuast install` says how to have both",
                   color))
    # Said here because the page says it only in a corner. A file you wrote
    # and got wrong must never look like a file you never wrote.
    for why in load_config()[2]:
        print(mark("warn", f"settings: {why}", color))
    behind = install_behind(built)
    if behind:
        print(mark("warn", behind, color))
    if not events_path().exists():
        print(mark("note", "no events yet: start a Claude Code session", color))

    port = args.port
    daemon = Daemon()
    try:
        server = make_server(daemon, port)
    except OSError as error:
        print(mark("fail", f"cannot listen on {BIND_HOST}:{port}: {error}", color),
              file=sys.stderr)
        print("    another program has that port; `--port` picks another.",
              file=sys.stderr)
        return 1

    # The port the socket has, not the one asked for: `--port 0` asks the
    # system for a free one, and printed `http://127.0.0.1:0/` (#235).
    port = server.server_address[1]
    where = f"http://{BIND_HOST}:{port}/"
    say_who(held, {"pid": os.getpid(), "url": where})
    print()
    print(mark("go", f"\033[1m{where}\033[0m      ctrl-c stops" if color
               else f"{where}      ctrl-c stops", color))
    # It listens on this machine only, on purpose; this is the way in from
    # another one, and a firewall port is not.
    print(f"    another computer: ssh -N -L {port}:{BIND_HOST}:{port}"
          f" {os.environ.get('USER', 'you')}@this-machine", flush=True)

    def watch() -> None:
        print(mark("note", daemon.catch_up(), color), flush=True)
        daemon.run()

    # The first pass folds the whole log and runs git for every worktree, which
    # on a busy machine takes a moment. It happens on the worker, so the page
    # is served straight away rather than after it -- and it starts after the
    # lines above, so what it says about the log comes out below them rather
    # than in the middle.
    worker = threading.Thread(target=watch, name="wostuast-refresh", daemon=True)
    worker.start()
    if args.open:
        open_browser(where)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        daemon.stopping.set()
        server.shutdown()
        server.server_close()
    return 0


def open_browser(where: str) -> None:
    """Open the page. A machine with no browser is not an error."""
    try:
        import webbrowser

        webbrowser.open(where)
    except Exception as error:
        log(f"could not open a browser: {error!r}")


# --- command line ------------------------------------------------------------


def port_number(text: str) -> int:
    """`--port`, checked where argparse can say what is wrong with it.

    A port out of range reached `bind`, whose `OverflowError` is not an
    `OSError`, so `serve` died with a traceback (#235). Nought is allowed:
    the system picks a free port, and `serve` prints the one it got.
    """
    import argparse

    try:
        number = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a number") from None
    if not 0 <= number <= 65535:
        raise argparse.ArgumentTypeError(
            f"{number} is not a port: use 1 to 65535, or 0 for any free one")
    return number


def build_parser() -> argparse.ArgumentParser:
    import argparse

    parser = argparse.ArgumentParser(
        prog="wostuast",
        description="See what your coding agents are doing. With no command:"
                    " check the setup, bring the hooks up to date, and serve"
                    " the page.",
    )
    # The day and the start of the SHA-256, as the page shows it: no number
    # anybody has to remember to raise (#344, `own_version`).
    parser.add_argument("--version", action="version",
                        version=f"wostuast {own_version() or 'unknown'}")
    # No command is the start: check, bring the hooks up to date, serve
    # (#275). So the two options of serving are the program's own.
    parser.add_argument("--port", type=port_number, default=DEFAULT_PORT,
                        help=f"the port to listen on (default {DEFAULT_PORT};"
                             " 0 picks a free one)")
    parser.add_argument("--open", action="store_true",
                        help="open the page in a browser")
    subparsers = parser.add_subparsers(dest="command", metavar="command")

    commands = [
        ("install", cmd_install, "copy to ~/.local/bin and register the hooks"),
        ("uninstall", cmd_uninstall, "remove the hooks; keep the event log"),
        ("ls", cmd_ls, "list the sessions"),
        ("wait", cmd_wait, "wait until a session reaches a state"),
        ("doctor", cmd_doctor, "check the setup"),
        ("files", cmd_files, "list every file wostuast wrote, and what it is for"),
        ("report", cmd_report,
         "a Markdown report for an agent to improve wostuast; names and counts only"),
    ]
    for name, handler, help_text in commands:
        sub = subparsers.add_parser(name, help=help_text, description=help_text)
        sub.set_defaults(handler=handler)
        if name in ("ls", "wait"):
            sub.add_argument("--json", action="store_true",
                             help="print JSON for a script (see README.md)")
        if name == "wait":
            sub.add_argument("session", nargs="?", default="",
                             help="its id, the start of its id, or its name;"
                                  " without one, any session")
            sub.add_argument("--until", type=wait_states, action="append",
                             required=True, metavar="STATE",
                             help="needs_you, working, done, ended, dead or"
                                  " over; give it more than once for any of them")
            sub.add_argument("--timeout", type=float, default=None,
                             metavar="SECONDS", help="give up after this long:"
                                                     " exit 124")
        if name == "install":
            # The run of a copy `install` just fetched (`cmd_install`).
            sub.add_argument("--fetched", action="store_true",
                             help=argparse.SUPPRESS)
        if name == "report":
            sub.add_argument("--days", type=float, default=SHAPES_DAYS,
                             help=f"how far back to read (default {SHAPES_DAYS})")
    return parser


#: Verbs that are gone, each said by name: argparse alone would answer
#: "invalid choice" and list commands, none of which is the answer.
GONE_VERBS = {
    # #275.
    "serve": "`wostuast serve` is now just `wostuast`: it checks the setup,"
             " brings the hooks up to date and serves the page."
             " --port and --open work as before.",
    # #323: `report` says what `shapes` said, and more.
    "shapes": "`wostuast shapes` is now part of `wostuast report`, which an"
              " agent can read: names and counts only, as before.",
    # #322: Claude Code runs the hook file and the status file that `install`
    # writes (#271, #286). Only an entry from before them still names these.
    "hook": "`wostuast hook` is gone: Claude Code runs the hook file now."
            " Start `wostuast` once to move this entry, then restart the session.",
    "status": "`wostuast status` is gone: Claude Code runs the status file now."
              " Start `wostuast` once to move this line, then restart the session.",
}


def main(argv: Sequence[str] | None = None) -> int:
    words = list(argv) if argv is not None else sys.argv[1:]
    if words[:1] and words[0] in GONE_VERBS:
        print(GONE_VERBS[words[0]], file=sys.stderr)
        # 1, never argparse's 2. An old hook entry calls `wostuast hook` until
        # its session restarts, and Claude Code reads 2 from a hook as "block":
        # the tool call refused, or the prompt thrown away. 1 is an error it
        # shows and goes on from.
        return 1
    parser = build_parser()
    args = parser.parse_args(words)
    handler = getattr(args, "handler", None)
    if handler is None:
        return cmd_serve(args)
    return handler(args)



