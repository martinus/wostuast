def give_up_after(seconds: int) -> None:
    """Set a deadline for this process. Passing it raises, nothing more waits.

    The hook and the status line both read stdin, which blocks until the writer
    closes it, and both take a file lock, which a network filesystem can stall.
    Neither may hold Claude Code, so the whole call runs under one deadline
    instead of guarding each wait. Where there is no SIGALRM, there is no
    deadline, and the call behaves as it did before.
    """
    import signal

    def out_of_time(number: int, frame: Any) -> None:
        raise TimeoutError(f"gave up after {seconds} s")

    try:
        signal.signal(signal.SIGALRM, out_of_time)
        signal.alarm(seconds)
    except (AttributeError, OSError, ValueError):
        pass


def stand_down() -> None:
    """Cancel the deadline set by give_up_after."""
    import signal

    try:
        signal.alarm(0)
    except (AttributeError, OSError, ValueError):
        pass


def read_stdin_json() -> dict[str, Any]:
    """Read one JSON object from stdin. Anything else reads as empty."""
    raw = sys.stdin.read()
    payload = json.loads(raw) if raw.strip() else {}
    return payload if isinstance(payload, dict) else {}


def cmd_hook(args: argparse.Namespace) -> int:
    """Read the hook JSON from stdin and append one line. Always exit 0.

    It prints nothing, and that silence is load-bearing. Claude Code reads a
    hook's stdout as the hook's answer. For PreToolUse that answer can allow or
    deny a tool, and PermissionRequest, which we register so that a waiting
    agent turns amber at once, takes a decision to allow or deny outright.
    Printing nothing means "no opinion", and the dialog behaves as if we were
    not here.

    So: never print in this function, and never print in anything it calls.
    wostuast must have no opinion, because approving without seeing the pane is
    how directories get deleted. Exit 0 whatever happens, and say anything
    worth saying in the log file.
    """
    try:
        give_up_after(HOOK_TIMEOUT)
        record = read_stdin_json()
        record["ts"] = time.time()
        record["pane"] = os.environ.get("TMUX_PANE", "")
        record["pid"] = agent_pid()
        record["shell_pid"] = os.getppid()
        append_event(record)
        stand_down()
    except BaseException as error:  # a hook must never block Claude Code
        # The deadline stays armed over the logging. `log` opens and writes a
        # file, and the failure being logged may be that the filesystem is not
        # answering — cancelling the alarm first and then writing is how a hook
        # holds Claude Code for ever, which is the one thing it may not do.
        try:
            log(f"hook failed: {error!r}")
        except BaseException:
            pass
        stand_down()
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    """Read the status line JSON from stdin, keep it, and print one line.

    Claude Code allows one status line command, and the payload arrives on
    stdin, which can only be read once. So a user who already has a status line
    cannot simply add ours next to it. `--then` is the way to have both: we
    read the payload, keep what we need, and hand the same text to their
    command, whose output is what the terminal shows.
    """
    raw = ""
    try:
        give_up_after(HOOK_TIMEOUT)
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            payload = {}
        status = status_from_payload(payload)
        write_status(str(payload.get("session_id") or ""), status)
        stand_down()
    except BaseException as error:
        stand_down()
        log(f"status failed: {error!r}")
        payload = {}

    then = getattr(args, "then", None)
    if then:
        print(run_status_line(then, raw), end="")
        return 0
    print(status_line(status_from_payload(payload), str(payload.get("cwd") or "")))
    return 0


def run_status_line(command: str, payload: str) -> str:
    """Run the status line the user already had, and give back what it printed.

    It runs through a shell because that is how Claude Code runs it, and it is
    the user's own command either way. A command that hangs or fails prints
    nothing rather than holding up the terminal.
    """
    import subprocess

    try:
        done = subprocess.run(
            command, shell=True, input=payload, capture_output=True,
            text=True, errors="replace", timeout=HOOK_TIMEOUT, check=False,
        )
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        log(f"the status line {command!r} failed: {error!r}")
        return ""
    return done.stdout


def cmd_ls(args: argparse.Namespace) -> int:
    """Print one row per session, in the order of the sidebar."""
    drop_old_status()
    sessions = build_sessions()
    if not sessions:
        print("no sessions yet.")
        print("start a Claude Code session in tmux; run `wostuast doctor` to check the setup.")
        return 0
    # Sort again: the label a row sorts by is only complete once git has spoken.
    add_git_facts(sessions)
    sessions = sort_sessions(sessions)
    now = time.time()
    color = use_color()

    rows: list[tuple[str, list[str]]] = [
        ("", ["STATE", "SESSION", "BRANCH", "CHANGES", "PANE", "AGE", "LAST"])
    ]
    for session in sessions:
        rows.append(
            (
                session.state,
                [
                    STATE_WORDS.get(session.state, session.state),
                    session.label,
                    session.git.branch or "-",
                    changes_column(session.git) or "-",
                    session.pane or "-",
                    ago(now - session.since),
                    clip(session.reason or session.last_event, 60),
                ],
            )
        )
    print(table(rows, color))

    counts = Counter(session.state for session in sessions)
    summary = " · ".join(
        f"{counts[state]} {STATE_WORDS[state]}" for state in STATE_WORDS if counts.get(state)
    )
    print()
    print(summary)
    return 0


def which_tmux() -> bool:
    import shutil

    return shutil.which("tmux") is not None


def cmd_doctor(args: argparse.Namespace) -> int:
    """Check the setup and say what is wrong."""
    problems = 0
    lines: list[str] = []

    def report(ok: bool, good: str, bad: str, fatal: bool = True) -> None:
        nonlocal problems
        if ok:
            lines.append(f"  ok    {good}")
        else:
            lines.append(f"  {'FAIL' if fatal else 'note'}  {bad}")
            if fatal:
                problems += 1

    report(sys.version_info >= (3, 10), f"python {sys.version.split()[0]}",
           f"python {sys.version.split()[0]} is older than 3.10")

    directory = state_dir()
    trouble = ""
    try:
        directory.mkdir(parents=True, exist_ok=True)
        probe = directory / ".probe"
        probe.write_text("", encoding="utf-8")
        probe.unlink()
    except OSError as error:
        trouble = str(error)
    report(not trouble, f"state directory {directory}",
           f"cannot write {directory}: {trouble}")

    events = events_path()
    count = count_events()
    report(events.exists(), f"event log {events} with {count} events",
           f"no events yet at {events}; run a Claude Code session", fatal=False)

    path = settings_path()
    settings: dict[str, Any] = {}
    try:
        settings, _, _ = load_settings(path)
    except (OSError, ValueError) as error:
        report(False, "", f"cannot read {path}: {error}")
    hooks = settings.get("hooks") if isinstance(settings.get("hooks"), dict) else {}
    missing = [
        event
        for event in HOOK_EVENTS
        if not any(has_verb(group, "hook") for group in (hooks.get(event) or []))
    ]
    report(not missing, f"all {len(HOOK_EVENTS)} hooks registered in {path}",
           f"hooks missing in {path}: {', '.join(missing)}; run `wostuast install`")

    current = settings.get("statusLine")
    mine = isinstance(current, dict) and is_ours(current.get("command"), "status")
    report(mine, "status line registered (session names and context)",
           "status line not registered; without it sessions have no name and no context percent",
           fatal=False)

    report(which_tmux(), "tmux found",
           "tmux not found; jump and send stay hidden", fatal=False)

    # The autolinks, if there are any. A broken one is a note and not a
    # failure: the transcript reads perfectly well without it, and the point
    # of saying so is that a link doing nothing gives no clue why.
    if links_path().exists():
        usable, trouble = load_links()
        report(not trouble,
               f"{len(usable)} autolink(s) in {links_path()}",
               "; ".join(trouble), fatal=False)
    report(install_path().exists(), f"installed at {install_path()}",
           f"not installed at {install_path()}; run `wostuast install`", fatal=False)

    print("wostuast doctor")
    print("\n".join(lines))
    print()
    print("all good." if problems == 0 else f"{problems} problem(s) to fix.")
    return 1 if problems else 0


def self_source() -> str:
    """Our own source code, so `install` can copy it. Downloads it if needed."""
    here = Path(__file__).resolve() if "__file__" in globals() else None
    if here and here.is_file():
        return here.read_text(encoding="utf-8")
    import urllib.request

    with urllib.request.urlopen(RAW_URL, timeout=30) as response:
        return response.read().decode("utf-8")


def cmd_install(args: argparse.Namespace) -> int:
    """Copy wostuast to ~/.local/bin and register the hooks and the status line."""
    changes: list[str] = []
    target = install_path()
    source = self_source()
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        current = target.read_text(encoding="utf-8")
    except (OSError, ValueError):
        current = ""
    if current != source:
        # This file is registered as a hook on nine events in every running
        # session. Writing it in place would let a hook read half a file and
        # die. Write beside it and rename, which is atomic; a hook that is
        # already running keeps the old file open and finishes normally.
        spare = target.with_name(f"{target.name}.{os.getpid()}.tmp")
        try:
            spare.write_text(source, encoding="utf-8")
            spare.chmod(0o755)
            spare.replace(target)
        finally:
            try:
                spare.unlink()
            except OSError:
                pass
        changes.append(f"wrote {target}")

    path = settings_path()
    try:
        settings, indent, newline = load_settings(path)
    except (OSError, ValueError) as error:
        print(f"cannot read {path}: {error}", file=sys.stderr)
        return 1
    try:
        changes += add_hooks(settings, hook_command(target))
        changes += add_status_line(settings, status_command(target))
    except ValueError as error:
        print(f"{path}: {error}", file=sys.stderr)
        return 1
    save_settings(path, settings, indent, newline)

    for line in changes or ["nothing to change"]:
        print(line)
    if str(target.parent) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"note: {target.parent} is not on your PATH")
    print("restart your Claude Code sessions so they pick up the hooks.")
    return 0


def cmd_uninstall(args: argparse.Namespace) -> int:
    """Remove our hooks and our status line. Leave the event log alone."""
    target = install_path()
    path = settings_path()
    try:
        settings, indent, newline = load_settings(path)
    except (OSError, ValueError) as error:
        print(f"cannot read {path}: {error}", file=sys.stderr)
        return 1
    changes = remove_hooks(settings)
    changes += remove_status_line(settings)
    if changes:
        save_settings(path, settings, indent, newline)
    for line in changes or ["nothing to change"]:
        print(line)
    print(f"the event log stays at {events_path()}")
    if target.exists():
        print(f"remove the program yourself with: rm {target}")
    return 0


def cmd_serve(args: argparse.Namespace) -> int:
    """Start the daemon and serve the page on 127.0.0.1."""
    import threading

    port = args.port
    daemon = Daemon()
    try:
        server = make_server(daemon, port)
    except OSError as error:
        print(f"cannot listen on {BIND_HOST}:{port}: {error}", file=sys.stderr)
        print("another wostuast may already be running.", file=sys.stderr)
        return 1

    where = f"http://{BIND_HOST}:{port}/"
    made = write_example_links()
    # Said here because the page cannot make you look at it and `doctor` is
    # something you had no reason to run. A file you wrote and got wrong must
    # never look like a file you never wrote.
    for why in load_links()[1]:
        print(f"links: {why}", file=sys.stderr)
    # The first pass folds the whole log and runs git for every worktree, which
    # on a busy machine takes a moment. It happens on the worker, so the page
    # is served straight away rather than after it.
    worker = threading.Thread(target=daemon.run, name="wostuast-refresh", daemon=True)
    worker.start()
    print(f"wostuast is watching at {where}")
    print("it listens on this machine only. To read it from another computer,")
    print(f"  run: ssh -N -L {port}:{BIND_HOST}:{port} {os.environ.get('USER', 'you')}@this-machine")
    print(f"  then open {where} there. Opening a firewall port will not work.")
    if made:
        print(f"wrote an example {links_path()}; edit it to link your tickets.")
    print("press ctrl-c to stop.")
    if args.open:
        open_browser(where)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()
    finally:
        daemon.stopping.set()
        server.shutdown()
        server.server_close()
    return 0


def open_browser(where: str) -> None:
    """Open the page. A machine with no browser is not an error."""
    try:
        import webbrowser

        webbrowser.open(where)
    except Exception as error:
        log(f"could not open a browser: {error!r}")


# --- command line ------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    import argparse

    parser = argparse.ArgumentParser(
        prog="wostuast",
        description="See what your coding agents are doing.",
    )
    parser.add_argument("--version", action="version", version=f"wostuast {VERSION}")
    subparsers = parser.add_subparsers(dest="command")

    commands = [
        ("install", cmd_install, "copy to ~/.local/bin and register the hooks"),
        ("uninstall", cmd_uninstall, "remove the hooks; keep the event log"),
        ("hook", cmd_hook, "the hook entry point; reads JSON from stdin"),
        ("status", cmd_status, "the status line entry point; reads JSON from stdin"),
        ("ls", cmd_ls, "list the sessions"),
        ("doctor", cmd_doctor, "check the setup"),
        ("serve", cmd_serve, "start the daemon and serve the page"),
    ]
    for name, handler, help_text in commands:
        sub = subparsers.add_parser(name, help=help_text, description=help_text)
        sub.set_defaults(handler=handler)
        if name == "status":
            sub.add_argument("--then", metavar="COMMAND",
                             help="run this status line too, and print its output")
        if name == "serve":
            sub.add_argument("--port", type=int, default=DEFAULT_PORT,
                             help=f"the port to listen on (default {DEFAULT_PORT})")
            sub.add_argument("--open", action="store_true",
                             help="open the page in a browser")
    return parser


#: The two verbs Claude Code calls itself. They skip argparse, because the hook
#: runs on every tool call and the status line runs on every redraw.
FAST_PATH = {"hook": cmd_hook, "status": cmd_status}


def main(argv: Sequence[str] | None = None) -> int:
    words = list(argv) if argv is not None else sys.argv[1:]
    if len(words) == 1 and words[0] in FAST_PATH:
        return FAST_PATH[words[0]](None)

    parser = build_parser()
    args = parser.parse_args(words)
    handler = getattr(args, "handler", None)
    if handler is None:
        parser.print_help()
        return 0
    return handler(args)



