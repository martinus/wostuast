`wostuast install` wrote this from the definitions of the same names in
wostuast, so a redraw compiles these and not the whole program. Do not edit
it: the next install writes it again, and `wostuast doctor` says when it is
not the one this version would write.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import sys
import time
from dataclasses import asdict, dataclass
from pathlib import Path

'''

STATUS_TAIL = '''


class StatusArgs:
